#!/usr/bin/env python3
"""Generate native constants from the shared progress-sync contract."""

import argparse
import json
import pathlib
import sys


ROOT = pathlib.Path(__file__).resolve().parents[1]
SOURCE = ROOT / "shared/progress-sync-contract.json"
ANDROID_OUTPUT = ROOT / "apps/android/app/src/main/java/com/jkdc/app/core/ProgressSyncContractData.kt"
IOS_OUTPUT = ROOT / "apps/ios/Core/ProgressSyncContractData.swift"
REQUIRED = {
    "version": int,
    "wireEpoch": str,
    "wireUnit": str,
    "localEpoch": str,
    "localUnit": str,
    "appleEpochOffsetSeconds": int,
    "earliestUnixMilliseconds": int,
    "futureSkewMilliseconds": int,
    "uploadBatchLimit": int,
    "downloadPageLimit": int,
}


def load_contract():
    contract = json.loads(SOURCE.read_text(encoding="utf-8"))
    for field, expected_type in REQUIRED.items():
        if type(contract.get(field)) is not expected_type:
            raise ValueError(f"{field} must be {expected_type.__name__}")
    if contract["version"] != 2:
        raise ValueError("version must be 2")
    if contract["wireEpoch"] != "unix" or contract["wireUnit"] != "milliseconds":
        raise ValueError("wire timestamps must use Unix milliseconds")
    if contract["localEpoch"] != "appleReference" or contract["localUnit"] != "seconds":
        raise ValueError("local timestamps must use Apple-reference seconds")
    if contract["appleEpochOffsetSeconds"] != 978307200:
        raise ValueError("Apple-reference epoch offset must be 978307200 seconds")
    if not 0 <= contract["futureSkewMilliseconds"] <= 9_007_199_254_740_991:
        raise ValueError("futureSkewMilliseconds must be a safe integer")
    if not 0 <= contract["earliestUnixMilliseconds"] <= 9_007_199_254_740_991:
        raise ValueError("earliestUnixMilliseconds must be a safe integer")
    for field in ("uploadBatchLimit", "downloadPageLimit"):
        if not 0 < contract[field] <= 9_007_199_254_740_991:
            raise ValueError(f"{field} must be a positive safe integer")
    return contract


def render_kotlin(contract):
    return """package com.jkdc.app.core

/** Generated by scripts/export_progress_sync.py; do not edit by hand. */
internal object ProgressSyncContractData {
    const val VERSION = %s
    const val APPLE_EPOCH_OFFSET_SECONDS = %s.0
    const val EARLIEST_UNIX_MILLISECONDS = %s.0
    const val FUTURE_SKEW_MILLISECONDS = %s.0
    const val UPLOAD_BATCH_LIMIT = %s
    const val DOWNLOAD_PAGE_LIMIT = %s
}
""" % (
        contract["version"], contract["appleEpochOffsetSeconds"],
        contract["earliestUnixMilliseconds"], contract["futureSkewMilliseconds"],
        contract["uploadBatchLimit"], contract["downloadPageLimit"],
    )


def render_swift(contract):
    return """// Generated by scripts/export_progress_sync.py; do not edit by hand.
enum ProgressSyncContractData {
    static let version = %s
    static let appleEpochOffsetSeconds = %s.0
    static let earliestUnixMilliseconds = %s.0
    static let futureSkewMilliseconds = %s.0
    static let uploadBatchLimit = %s
    static let downloadPageLimit = %s
}
""" % (
        contract["version"], contract["appleEpochOffsetSeconds"],
        contract["earliestUnixMilliseconds"], contract["futureSkewMilliseconds"],
        contract["uploadBatchLimit"], contract["downloadPageLimit"],
    )


def emit(path, content, check):
    if check:
        if not path.exists() or path.read_text(encoding="utf-8") != content:
            print(f"stale generated file: {path.relative_to(ROOT)}", file=sys.stderr)
            return False
        return True
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    return True


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true", help="fail if generated files are stale")
    args = parser.parse_args()
    try:
        contract = load_contract()
        valid = emit(ANDROID_OUTPUT, render_kotlin(contract), args.check)
        valid = emit(IOS_OUTPUT, render_swift(contract), args.check) and valid
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print(error, file=sys.stderr)
        return 1
    return 0 if valid else 1


if __name__ == "__main__":
    raise SystemExit(main())
