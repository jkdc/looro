package com.jkdc.app.ui

import androidx.compose.runtime.Composable
import androidx.compose.ui.res.stringResource
import com.jkdc.app.R

/** Engagement level titles — presentation only, never a language-proficiency claim. */
@Composable
fun levelTitle(level: Int): String = stringResource(when (level) {
    0 -> R.string.level_title_0
    1 -> R.string.level_title_1
    2 -> R.string.level_title_2
    3 -> R.string.level_title_3
    4 -> R.string.level_title_4
    5 -> R.string.level_title_5
    6 -> R.string.level_title_6
    7 -> R.string.level_title_7
    8 -> R.string.level_title_8
    9 -> R.string.level_title_9
    else -> R.string.level_title_10
})
