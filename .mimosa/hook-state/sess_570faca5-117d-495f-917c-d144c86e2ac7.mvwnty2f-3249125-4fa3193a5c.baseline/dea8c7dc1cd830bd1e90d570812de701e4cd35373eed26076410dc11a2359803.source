    Lesson(id = "pt-foundations-u14-bilhete", title = "Uma passagem, por favor", goal = "Comprar passagens: Uma passagem para o centro, por favor. Quanto custa ?", intro = LessonIntro(explanation = listOf("No guichê: « Uma passagem para o centro, por favor ». Para duas pessoas: « Duas passagens ».", "Perguntar o preço: « Quanto custa ? ». A resposta: « Custa cinco reais ».", "Pedir com educação: « por favor » e « obrigado ». « Quero uma passagem » também funciona."), examples = listOf(ExampleLine(text = "Uma passagem para o centro, por favor.", meaning = "Pedir um bilhete."), ExampleLine(text = "Duas passagens para São Paulo.", meaning = "quantidade + passagem."), ExampleLine(text = "Quanto custa a passagem ?", meaning = "Perguntar o preço."), ExampleLine(text = "Custa cinco reais.", meaning = "custar + preço."), ExampleLine(text = "Quero uma passagem de volta.", meaning = "quero + pedido."))), expressions = listOf(TargetExpression(text = "uma passagem", meaning = "Un billete.", note = "Uma passagem para o centro."), TargetExpression(text = "para … , por favor", meaning = "Destino + educação.", note = "Para o centro, por favor."), TargetExpression(text = "Quanto custa ?", meaning = "Preguntar el precio.", note = "Quanto custa a passagem ?"), TargetExpression(text = "custa … reais", meaning = "El precio.", note = "Custa cinco reais."), TargetExpression(text = "quero duas passagens", meaning = "Pedido con cantidad.", note = "Quero duas passagens.")), situation = "Na estação, o Leo compra duas passagens para o centro no guichê.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "No guichê, peça a passagem para o centro, com educação.", expected = listOf("Uma passagem para o centro, por favor.", "uma passagem para o centro por favor"), focus = "por favor", watch = "Pedido educado."), PracticeQuestion(prompt = "Peça passagens para duas pessoas.", expected = listOf("Duas passagens, por favor.", "duas passagens por favor"), focus = "quantidade", watch