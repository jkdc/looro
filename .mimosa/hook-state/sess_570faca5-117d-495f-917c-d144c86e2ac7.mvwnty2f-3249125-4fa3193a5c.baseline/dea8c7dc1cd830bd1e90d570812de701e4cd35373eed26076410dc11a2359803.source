    val unit = CourseUnit(id = "it-foundations-u7", title = "Opinioni e sfumature", subtitle = "Se avessi…", level = "B2", themes = listOf(ConversationTheme("it-b2-ipotesi", "Piani impossibili", "Se avessi tempo", "sparkles", "Course", "Debatete cosa fareste con tempo infinito, poi un compromesso vero.", 0),
                ConversationTheme("it-b2-trattativa", "La trattativa", "E se chiudiamo a 50 ?", "handshake", "Course", "Negoziate un acquisto usato: offerta, condizioni, accordo.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u7-ipotetico", title = "Se avessi tempo…", goal = "Parlare dell'irreale: se + congiuntivo imperfetto, poi il condizionale.", intro = LessonIntro(explanation = listOf("L'ipotesi irrealistica: « Se avessi più tempo, viaggerei di più ». Se + congiuntivo imperfetto, poi condizionale (-rei).", "Mai « se + condizionale »: si dice « se avessi », non « se avrei ».", "Per consigliare con tatto: « Al posto tuo ci proverei », « Non è che non voglia; è che non potrei »."), examples = listOf(ExampleLine(text = "Se avessi più tempo, viaggerei di più.", meaning = "Irreale del presente."), ExampleLine(text = "Al posto tuo ci proverei.", meaning = "Consiglio con tatto."), ExampleLine(text = "Se potessi, cambierei lavoro.", meaning = "potere → potessi / potrei."), ExampleLine(text = "E se ci vedessimo giovedì ?", meaning = "Proposta morbida."), ExampleLine(text = "Non è che non voglia; è che non potrei.", meaning = "Sfumatura volere/potere."))), expressions = listOf(TargetExpression(text = "se + congiuntivo imp., …rei", meaning = "Ipotesi.", note = "Se avessi…, viaggerei."), TargetExpression(text = "avere → avessi", meaning = "Congiuntivo chiave.", note = "Se avessi tempo."), TargetExpression(text = "potere → potessi", meaning = "Congiuntivo chiave.", note = "Se potessi, lo farei."), TargetExpression(text = "al posto tuo, …rei", meaning = "Consiglio.", note = "…ci proverei."), TargetExpression(text = "e se + congiuntivo ?", meaning = "Proposta.", note = "E se provassimo ?")), situation = "Debatete piani impossibili: più tempo, un altro lavoro, un'altra città — poi un compromesso vero per questo mese.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "La tua ipotesi: se avessi più tempo, viaggerei di più.", expected = listOf("Se avessi piu tempo viaggerei di piu", "Se avessi più tempo, viaggerei di più"), focus = "se + congiuntivo", watch = "Congiuntivo imperfetto + condizionale."), PracticeQuestion(prompt = "Consiglio con tatto: al posto tuo ci proverei.", expected = listOf("Al posto tuo ci proverei"), focus = "al posto tuo", watch = "Al posto tuo + condizionale."), PracticeQuestion(prompt = "Di che se potessi, cambieresti lavoro.", expected = listOf("Se potessi cambierei lavoro", "Se potessi, cambierei lavoro"), focus = "potessi/potrei", watch = "Se potessi… cambierei."), PracticeQuestion(prompt = "Proponi: e se ci vedessimo giovedì ?", expected = listOf("E se ci vedessimo giovedi", "E se ci vedessimo giovedì ?", "E se ci vedessimo giovedì"), focus = "e se… ?", watch = "E se + congiuntivo imperfetto."), PracticeQuestion(prompt = "Sfuma: non è che non voglia; è che non potrei.", expected = listOf("Non e che non voglia e che non potrei", "Non è che non voglia; è che non potrei"), focus = "non è che", watch = "Contrasto volere/potere."))), exercises = listOf(Exercise(id = "it-foundations-u7-ipotetico-e1", kind = "choice", prompt = "Se ___ più tempo, viaggerei di più.", options = listOf("avessi", "avrei", "ho", "avevo"), answers = listOf("avessi"), explain = "Con « se » irrealistico: congiuntivo imperfetto."), Exercise(id = "it-foundations-u7-ipotetico-e2", kind = "gap", prompt = "Se potessi, ___ lavoro. (cambiare, condizionale)", options = listOf(), answers = listOf("cambierei"), explain = "Se potessi + condizionale: cambierei."), Exercise(id = "it-foundations-u7-ipotetico-e3", kind = "order", prompt = "Consiglio: al posto tuo ci proverei.", options = listOf(), answers = listOf("Al posto tuo ci proverei"), explain = "al posto tuo + condizionale."), Exercise(id = "it-foundations-u7-ipotetico-e4", kind = "written", prompt = "La tua ipotesi col lavoro (potere + cambiare).", options = listOf(), answers = listOf("se potessi cambierei lavoro", "se potessi, cambierei lavoro"), explain = "Se + congiuntivo + condizionale.")), skills = listOf("grammar:second-conditional", "function:express-opinion", "speaking:justify-opinion", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:past-simple-irregular", "grammar:connectors")),
    Lesson(id = "it-foundations-u7-registro", title = "Si dice che…", goal = "Riportare ciò che altri affermano: il si impersonale e il passivo.", intro = LessonIntro(explanation = listOf("L'impersonale: « Si dice che il quartiere cambi ». Non conta chi lo dice.", "Il passivo: « Il concerto è stato cancellato », « I biglietti sono esauriti ». Il linguaggio delle notizie.", "Il passivo alza il registro; il si lo tiene quotidiano."), examples = listOf(ExampleLine(text = "Si dice che il quartiere cambierà.", meaning = "Impersonale: voce di corridoio."), ExampleLine(text = "Il concerto è stato cancellato per la pioggia.", meaning = "Passivo + causa."), ExampleLine(text = "I biglietti sono esauriti.", meaning = "Passivo di stato."), ExampleLine(text = "Tutti i treni sono stati soppressi.", meaning = "Notizia ufficiale."), ExampleLine(text = "Secondo il comune, i lavori slitteranno.", meaning = "Fonte + futuro."))), expressions = listOf(TargetExpression(text = "si dice che…", meaning = "Voce.", note = "…il quartiere cambierà."), TargetExpression(text = "è stato + participio", meaning = "Passivo.", note = "è stato cancellato."), TargetExpression(text = "sono + participio", meaning = "Stato.", note = "sono esauriti."), TargetExpression(text = "secondo + fonte", meaning = "Citare.", note = "secondo il comune."), TargetExpression(text = "si prevede che…", meaning = "Ufficiale.", note = "…i lavori…")), situation = "Commentate le notizie del quartiere: cosa si dice, cosa è stato deciso e quale fonte credete meno.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Riporta la voce: si dice che il quartiere cambierà.", expected = listOf("Si dice che il quartiere cambiara", "Si dice che il quartiere cambierà"), focus = "si dice che", watch = "Impersonale, senza soggetto."), PracticeQuestion(prompt = "Notizia: il concerto è stato cancellato per la pioggia.", expected = listOf("Il concerto e stato cancellato per la pioggia", "Il concerto è stato cancellato per 