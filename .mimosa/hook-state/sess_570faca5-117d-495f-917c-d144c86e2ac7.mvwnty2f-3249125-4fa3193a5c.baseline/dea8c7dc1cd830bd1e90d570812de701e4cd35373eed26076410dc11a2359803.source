    Lesson(id = "en-foundations-shopping-food", title = "Food shopping", goal = "Shop for food with how much/how many and containers.", intro = LessonIntro(explanation = listOf("How many for countable: “How many apples?” How much for uncountable: “How much rice?”", "Containers: a bottle of water, a bag of rice, a box of eggs, a kilo of tomatoes.", "Quantifiers: some (afirmativo), any (negativo/pregunta), a lot of (mucho)."), examples = listOf(ExampleLine(text = "How many apples do you need?", meaning = "Countable: many."), ExampleLine(text = "How much rice do you want?", meaning = "Uncountable: much."), ExampleLine(text = "I need a bottle of water.", meaning = "Container + of."), ExampleLine(text = "We need a kilo of tomatoes.", meaning = "kilo of + plural."), ExampleLine(text = "Is there any bread left?", meaning = "any in questions."))), expressions = listOf(TargetExpression(text = "How many + plural", meaning = "Countable.", note = "How many eggs?"), TargetExpression(text = "How much + uncountable", meaning = "Incountable.", note = "How much milk?"), TargetExpression(text = "a bottle/bag/box of …", meaning = "Containers.", note = "a bottle of oil."), TargetExpression(text = "a kilo/half a kilo of …", meaning = "Weight.", note = "a kilo of tomatoes."), TargetExpression(text = "some / any", meaning = "some afirm, any neg/preg.", note = "I need some sugar.")), situation = "You shop for a dinner party: ask how many guests, how much rice to buy and what containers you need.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ask about the number of guests.", expected = listOf("How many guests are coming?"), focus = "how many", watch = "Countable: how many."), PracticeQuestion(prompt = "Ask about the amount of rice.", expected = listOf("How much rice do we need?"), focus = "how much", watch = "Uncountable: how much."), PracticeQuestion(prompt = "Say you need a bottle of oil and a kilo of rice.", expected = listOf("I need a bottle of oil and a kilo of rice."), focus = "containers", watch = "bottle of, kilo of."), PracticeQuestion(prompt = "Say you don't need any more bread.", expected = listOf("We don't need any more bread."), focus = "any more", watch = "any in negatives."), PracticeQuestion(prompt = "Di que necesitas un cartón de leche.", expected = listOf("I need a carton of milk."), focus = "carton of", watch = "carton = briq."))), exercises = listOf(Exercise(id = "en-foundations-shopping-food-e1", kind = "choice", prompt = "___ ___ sugar do you need?", options = listOf("How much", "How many", "How long", "How often"), answers = listOf("How much"), explain = "sugar is uncountable."), Exercise(id = "en-foundations-shopping-food-e2", kind = "gap", prompt = "How ___ eggs are in the fridge? (contable)", options = listOf(), answers = listOf("many"), explain = "eggs are countable: how many."), Exercise(id = "en-foundations-shopping-food-e3", kind = "order", prompt = "Say what you need. (a bottle of water)", options = listOf(), answers = listOf("I need a bottle of water"), explain = "I need + container."), Exercise(id = "en-foundations-shopping-food-e4", kind = "written", prompt = "Ask about the number of tomatoes.", options = listOf(), answers = listOf("how many tomatoes do we need", "how many tomatoes"), explain = "How many + plural.")), skills = listOf("grammar:quantities", "grammar:some-any", "vocab:food", "function:go-shopping"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:some-any")),
    Lesson(id = "en-foundations-shopping-paying", title = "Paying", goal = "Pay in shops: ask for the price, use a card or cash, ask for a receipt.", intro = LessonIntro(explanation = listOf("At the till: “That's twelve fifty.” You pay by card (“Can I pay by card?”) or cash (“Here you are”).", "The cashier asks: “Cash or card?” “Do you need a bag?” “Would you like a receipt?”", "Change and receipts: “Here's your change.” “Would you like a receipt?”"), examples = listOf(ExampleLine(text = "That's twelve fifty, please.", meaning = "The cashier says the total."), ExampleLine(text = "Can I pay by card?", meaning = "Ask about payment method."), ExampleLine(text = "Here you are.", meaning = "Hand over money/card."), ExampleLine(text = "Do you need a bag?", meaning = "The cashier asks."), ExampleLine(text = "Could I have a receipt, please?", meaning = "Ask for proof."))), expressions = listOf(TargetExpression(text = "Can I pay by card/cash?", meaning = "Payment method.", note = "Both work."), TargetExpression(text = "Here you are.", meaning = "Hand over money.", note = "Fixed phrase."), TargetExpression(text = "Do you need a bag?", meaning = "Cashier asks.", note = "Yes please / No thanks."), TargetExpression(text = "receipt", meaning = "Proof of purchase.", note = "ri-siit."), TargetExpression(text = "Keep the change.", meaning = "Let the cashier keep it.", note = "Generous tip.")), situation = "You pay at a small shop: ask if they take cards, pay, ask for a receipt and a bag, and thank the cashier.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ask if they accept cards.", expected = listOf("Can I pay by card?"), focus = "payment", watch = "Can I pay by card? = ¿puedo pagar con tarjeta?"), PracticeQuestion(prompt = "Hand over the money.", expected = listOf("Here you are."), focus = "hand over", watch = "Fixed phrase: here you are."), PracticeQuestion(prompt = "Ask for a bag. (yes)", expected = listOf("Yes, could I have a bag, please?"), focus = "bag", watch = "Could I have = más educado."), PracticeQuestion(prompt = "Say keep the change.", expected = listOf("Keep the change."), focus = "generous", watch = "Se dice al dejar propina o cambio."), PracticeQuestion(prompt = "Ask about a discount.", expected = listOf("Is there a discount?"), focus = "discount", watch = "discount = descuento."))), exercises = listOf(Exercise(id = "en-foundations-shopping-paying-e1", kind = "choice", prompt = "___ I pay by card?", options = listOf("Can", "Do", "Am", "Have"), answers = listOf("Can"), explain = "Can I pay by card? — fixed."), Exercise(id = "en-foundations-shopping-paying-e2", kind = "gap", prompt = "Here ___ ___. (entregar el dinero)", options = listOf(), answers = listOf("you are"), explain = "Here you are — fixed phrase."), Exercise(id = "en-foundations-shopping-paying-e3", kind = "order", prompt = "Pedir un recibo.", options = listOf(), answers = listOf("Could I have a receipt please"), explain = "Could I have + thing + please."), Exercise(id = "en-foundations-shopping-paying-e4", kind = "written", prompt = "Pregunta si puedes pagar con tarjeta.", options = listOf(), answers = listOf("can i pay by card", "can i pay with card"), explain = "Can I pay by card?")), skills = listOf("function:go-shopping", "grammar:present-questions", "vocab:shopping", "function:make-requests"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-questions"))))
}

object EnFoundationsHome {
    val unit = CourseUnit(id = "en-foundations-home", title = "My home", subtitle = "Rooms, things, comfort", level = "A1", themes = listOf(ConversationTheme("new-flat", "The new flat", "Rooms and furniture", "sofa", "Course", "You describe your new flat: rooms, furniture and what's missing.", 0),
                ConversationTheme("home-problems", "Home problems", "Something's broken", "wrench", "Course", "Things break in your flat: describe the problem and ask for help.", 1)), lessons = listOf(    Lesson(id = "en-foundations-home-rooms", title = "Rooms & furniture", goal = "Name the rooms in a home and the furniture in each one.", intro = LessonIntro(explanation = listOf("Rooms: living room, bedroom, kitchen, bathroom, hall. Furniture: bed, sofa, table, chair, wardrobe, fridge.", "There is/There are for what exists: “There's a sofa in the living room.” “There are two chairs.”", "Prepositions: in, on, under, next to, behind. “The cat is under the bed.”"), examples = listOf(ExampleLine(text = "There's a sofa in the living room.", meaning = "there's + a + furniture."), ExampleLine(text = "There are two chairs at the table.", meaning = "there are + plural."), ExampleLine(text = "The bed is next to the window.", meaning = "next to + place."), ExampleLine(text = "My favourite room is the kitchen.", meaning = "favourite + room."), ExampleLine(text = "Is there a bathroom upstairs?", meaning = "Ask about rooms."))), expressions = listOf(TargetExpression(text = "living room / bedroom / kitchen", meaning = "Rooms.", note = "Each has its furniture."), TargetExpression(text = "There's a … in the …", meaning = "One thing.", note = "There's a bed in the bedroom."), TargetExpression(text = "There are … in the …", meaning = "Many things.", note = "There are two chairs."), TargetExpression(text = "next to / behind / under", meaning = "Prepositions.", note = "The cat is under the bed."), TargetExpression(text = "My favourite room is …", meaning = "Personalise.", note = "…the kitchen.")), situation = "You describe your new flat to a friend: rooms, furniture and your favourite corner.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Name two rooms in your flat.", expected = listOf("There's a <room> and a <room>."), focus = "there's", watch = "There's a bedroom and a kitchen."), PracticeQuestion(prompt = "Say what furniture is in the living room.", expected = listOf("There's a <furniture> in the living room."), focus = "there's + furniture", watch = "There's a sofa and a table."), PracticeQuestion(prompt = "Say where the bed is. (next to the window)", expected = listOf("The bed is next to the window."), focus = "next to", watch = "next TO the window."), PracticeQuestion(prompt = "Ask if there is a bathroom.", expected = listOf("Is there a bathroom?"), focus = "question", watch = "Is there a…?"), PracticeQuestion(prompt = "Say your favourite room.", expected = listOf("My favourite room is the <room>."), focus = "favourite", watch = "favourite + room."))), exercises = listOf(Exercise(id = "en-foundations-home-rooms-e1", kind = "choice", prompt = "___ a sofa in the living room.", options = listOf("There's", "They're", "It's", "There are"), answers = listOf("There's"), explain = "Singular: There's a sofa."), Exercise(id = "en-foundations-home-rooms-e2", kind = "gap", prompt = "There ___ two bathrooms. (plural)", options = listOf(), answers = listOf("are"), explain = "There are + plural."), Exercise(id = "en-foundations-home-rooms-e3", kind = "order", prompt = "Ask about a bathroom.", options = listOf(), answers = listOf("Is there a bathroom upstairs"), explain = "Is there + a + room?"), Exercise(id = "en-foundations-home-rooms-e4", kind = "written", prompt = "Name your favourite room.", options = listOf(), answers = listOf("my favourite room is the <room>"), explain = "My favourite room is X.")), skills = listOf("vocab:home", "grammar:there-is-are", "grammar:prepositions-place", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:there-is-are")),
    Lesson(id = "en-foundations-home-problems", title = "Home problems", goal = "Describe problems at home: something's broken, not working, or missing.", intro = LessonIntro(explanation = listOf("Broken things: “The washing machine is broken.” “The light doesn't work.” “The tap is leaking.”", "Ask for help: “Can you fix it?” “Who do I call?” — fix = repair.", "Emergency vs nuisance: “The heating is broken!” (urgent) vs “The doorbell doesn't work.” (annoying)"), examples = listOf(ExampleLine(text = "The washing machine is broken.", meaning = "broken = roto."), ExampleLine(text = "The light doesn't work.", meaning = "doesn't work = no funciona."), ExampleLine(text = "The tap is leaking.", meaning = "leaking = goteando."), ExampleLine(text = "Can you fix it?", meaning = "Ask for repair."), ExampleLine(text = "It's been like this for a week.", meaning = "Duration of the problem."))), expressions = listOf(TargetExpression(text = "… is broken", meaning = "Not working at all.", note = "The TV is broken."), TargetExpression(text = "… doesn't work", meaning = "Not functioning.", note = "The doorbell doesn't work."), TargetExpression(text = "… is leaking", meaning = "Losing liquid.", note = "The tap is leaking."), TargetExpression(text = "Can you fix …?", meaning = "Ask for repair.", note = "fix = reparar."), TargetExpression(text = "It's been like this for …", meaning = "Duration.", note = "for three days.")), situation = "Three things break in your flat on the same day: the boiler, a window and the doorbell. Explain each problem and ask for help.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Say the boiler is broken.", expected = listOf("The boiler is broken."), focus = "broken", watch = "broken = roto, no funciona."), PracticeQuestion(prompt = "Say the tap is leaking.", expected = listOf("The tap is leaking."), focus = "leaking", watch = "leak = gotear."), PracticeQuestion(prompt = "Say the doorbell doesn't work.", expected = listOf("The doorbell doesn't work."), focus = "doesn't work", watch = "doesn't + base verb."), PracticeQuestion(prompt = "Say how long the problem has been going on. (3 days)", expected = listOf("It's been like this for three days."), focus = "duration", watch = "for + period."), PracticeQuestion(prompt = "Ask for help urgently.", expected = listOf("Can you send someone today, please?"), focus = "urgent request", watch = "send someone = mandar a alguien."))), exercises = listOf(Exercise(id = "en-foundations-home-problems-e1", kind = "choice", prompt = "The washing machine is ___. It doesn't work.", options = listOf("broken", "working", "new", "clean"), answers = listOf("broken"), explain = "broken = roto, no funciona."), Exercise(id = "en-foundations-home-problems-e2", kind = "gap", prompt = "The ___ is leaking. (grifo)", options = listOf(), answers = listOf("tap", "faucet"), explain = "tap = grifo."), Exercise(id = "en-foundations-home-problems-e3", kind = "order", prompt = "Pedir que lo arreglen.", options = listOf(), answers = listOf("Can you fix it please"), explain = "Can you fix + object."), Exercise(id = "en-foundations-home-problems-e4", kind = "written", prompt = "Di cuánto tiempo lleva el problema. (3 días)", options = listOf(), answers = listOf("its been like this for three days", "for three days"), explain = "for + period.")), skills = listOf("vocab:home", "grammar:present-simple", "grammar:present-continuous", "function:solve-problems"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-continuous"))))
}

object EnFoundationsU5 {
    val unit = CourseUnit(id = "en-foundations-u5", title = "Food & likes", subtitle = "Eat, drink, enjoy", level = "A2", themes = listOf(ConversationTheme("sunday-market", "The Sunday market", "Baskets and barrows", "cart", "Course", "You meet at the Sunday food market: count what's in the baskets, ask what's missing and choose what to cook.", 0),
                ConversationTheme("restaurant", "Dinner out", "A table for two", "fork.knife", "Course", "You book and enjoy a dinner out: order dishes, say what you love and hate, and ask for the bill.", 1)), lessons = listOf(    Lesson(id = "en-foundations-u5-some-any", title = "Some / any & countables", goal = "Talk about food quantities: what you have, what you need and how much.", intro = LessonIntro(explanation = listOf("Countable things have a plural: one apple, two apples. Uncountable things have no plural: water, rice, milk, bread.", "Use some in affirmative sentences (“We've got some rice”) and any in questions and negatives (“Have we got any milk?” “There isn't any bread.”).", "To count uncountables, add a container: a bottle of water, a kilo of rice, a loaf of bread."), examples = listOf(ExampleLine(text = "We need some onions.", meaning = "Affirmative some."), ExampleLine(text = "Do we have any eggs?", meaning = "Question any."), ExampleLine(text = "There isn't any sugar.", meaning = "Negative any."), ExampleLine(text = "Can I have a bottle of water?", meaning = "Counting water."), ExampleLine(text = "How much rice do we need?", meaning = "much for uncountables."), ExampleLine(text = "How many tomatoes are left?", meaning = "many for countables."))), expressions = listOf(TargetExpression(text = "some + plural/uncountable", meaning = "An unstated amount.", note = "some apples, some water"), TargetExpression(text = "any in questions/negatives", meaning = "Do we have any…? We don't have any…", note = "any eggs, any time"), TargetExpression(text = "a bottle/kilo/loaf of …", meaning = "Count the uncountable.", note = "two bottles of milk"), TargetExpression(text = "How much …?", meaning = "Uncountables.", note = "How much butter is left?"), TargetExpression(text = "How many …?", meaning = "Countables.", note = "How many peppers do we need?"), TargetExpression(text = "a little / a few", meaning = "Small amounts: a little + uncountable, a few + plural.", note = "a little salt, a few olives")), situation = "You cook together from what's in the fridge: list what you have, find out what's missing and write the shopping list.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Let's cook paella! What have we got?", expected = listOf("We've got some <ingredients>.", "We've got rice and some tomatoes."), focus = "some in affirmatives", watch = "“We've got any rice” — affirmative takes some."), PracticeQuestion(prompt = "Do we have any saffron?", expected = listOf("Yes, we have some.", "No, we don't have any."), focus = "any in questions", watch = "“Do we have some…?” — questions prefer any."), PracticeQuestion(prompt = "How much rice do we need?", expected = listOf("About half a kilo.", "Two cups."), focus = "much with uncountables", watch = "“How many rice?” — rice is uncountable: how much."), PracticeQuestion(prompt = "And how many people are coming?", expected = listOf("Six people.", "There are six of us."), focus = "many with countables", watch = "“How much people?” — people is countable here: how many."), PracticeQuestion(prompt = "We need milk. Can you get some?", expected = listOf("Sure. A litre?", "Yes, a bottle."), focus = "responding to a request", watch = "“Yes, I get milk” — confirm the amount: “A litre?”"), PracticeQuestion(prompt = "We only need a little salt and a few olives.", expected = listOf("Got it: a little salt, a few olives."), focus = "a little vs a few", watch = "Countable? a few. Uncountable? a little."))), exercises = listOf(Exercise(id = "en-foundations-u5-some-any-e1", kind = "choice", prompt = "We haven't got ___ milk.", options = listOf("any", "some", "a", "many"), answers = listOf("any"), explain = "Negatives take any."), Exercise(id = "en-foundations-u5-some-any-e2", kind = "gap", prompt = "Can I have ___ water, please?", options = listOf(), answers = listOf("some"), explain = "Requests take some, even as questions."), Exercise(id = "en-foundations-u5-some-any-e3", kind = "order", prompt = "Say you need sugar for the cake.", options = listOf(), answers = listOf("I need some sugar for the cake"), explain = "Affirmatives take some."), Exercise(id = "en-foundations-u5-some-any-e4", kind = "written", prompt = "Say you need some bread.", options = listOf(), answers = listOf("I need some bread", "I need to buy some bread"), explain = "some + uncountable: some bread, some water.")), skills = listOf("grammar:some-any", "grammar:countable-uncountable", "vocab:food", "function:go-shopping"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:plurals")),
    Lesson(id = "en-foundations-u5-likes", title = "Like / love / hate + -ing", goal = "Talk about what you love, like and hate doing.", intro = LessonIntro(explanation = listOf("After like, love, hate and don't like, the next verb takes -ing: “I love cooking.” “She hates waiting.”", "Questions use do: “Do you like dancing?” Short answers: “Yes, I do.”", "To soften, add really or quite: “I really love singing.” “I don't really like getting up early.”"), examples = listOf(ExampleLine(text = "I love reading.", meaning = "love + -ing."), ExampleLine(text = "She likes walking to work.", meaning = "like + -ing."), ExampleLine(text = "He hates getting up early.", meaning = "hate + -ing."), ExampleLine(text = "Do you like dancing?", meaning = "Question with do."), ExampleLine(text = "I don't like waiting.", meaning = "Negative + -ing."), ExampleLine(text = "We really love travelling.", meaning = "Softener really."))), expressions = listOf(TargetExpression(text = "I love + -ing", meaning = "Strong like.", note = "I love swimming."), TargetExpression(text = "I like + -ing", meaning = "Mild like.", note = "I like cycling on Sundays."), TargetExpression(text = "I hate + -ing", meaning = "Strong dislike.", note = "I hate queueing."), TargetExpression(text = "I don't mind + -ing", meaning = "It's OK, neutral.", note = "I don't mind cooking."), TargetExpression(text = "Do you like + -ing?", meaning = "Ask about tastes.", note = "Do you like hiking?"), TargetExpression(text = "really / quite", meaning = "Turn the volume up or down.", note = "I quite like it.")), situation = "You plan a free Sunday together: propose activities and react with love, like, don't mind or hate until you agree on a plan.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "What do you love doing at weekends?", expected = listOf("I love <verb>ing."), focus = "love + -ing", watch = "“I love to swim” — with love, -ing is the everyday choice."), PracticeQuestion(prompt = "Do you like cooking?", expected = listOf("Yes, I do.", "No, I don't. I hate cooking."), focus = "like questions", watch = "“Do you like cook?” — verb+ing after like."), PracticeQuestion(prompt = "What's something you hate doing?", expected = listOf("I hate <verb>ing."), focus = "hate + -ing", watch = "“I hate get up” — “hate getting up”."), PracticeQuestion(prompt = "Do you mind waiting?", expected = listOf("No, I don't mind waiting.", "Yes, I hate waiting."), focus = "don't mind", watch = "“I don't mind wait” — keep -ing."), PracticeQuestion(prompt = "How much do you like films — a bit or a lot?", expected = listOf("I really like films.", "I quite like them."), focus = "softeners", watch = "“I like very much films” — “I really like films”."), PracticeQuestion(prompt = "Your friend loves dancing but you don't. What do you say?", expected = listOf("I don't really like dancing.", "I don't like dancing, but thanks!"), focus = "polite dislike", watch = "Soften with really: “I don't really like…”."))), exercises = listOf(Exercise(id = "en-foundations-u5-likes-e1", kind = "choice", prompt = "I love ___ to music.", options = listOf("listening", "listen", "listens", "to listening"), answers = listOf("listening"), explain = "Like/love/hate + verb-ing."), Exercise(id = "en-foundations-u5-likes-e2", kind = "gap", prompt = "She hates ___ up early. (get)", options = listOf(), answers = listOf("getting"), explain = "Short verb + consonant doubles: get → getting."), Exercise(id = "en-foundations-u5-likes-e3", kind = "order", prompt = "Ask if the person enjoys cooking.", options = listOf(), answers = listOf("Do you like cooking"), explain = "Do you like + -ing?"), Exercise(id = "en-foundations-u5-likes-e4", kind = "written", prompt = "Say one thing you love doing.", options = listOf(), answers = listOf("I love <verbing>", "I love <verb>ing"), explain = "I love + activity with -ing.")), skills = listOf("grammar:gerunds-infinitives", "vocab:hobbies", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "en-foundations-u5-cafe", title = "Ordering at a café", goal = "Order food and drink, ask for things and pay, in real café English.", intro = LessonIntro(explanation = listOf("The magic order phrase is “I'd like …” (I would like) — polite and universal. “Can I have …, please?” works everywhere too.", "The server asks: “Anything else?” Answer: “That's all, thanks.” Pay with: “The bill, please.”", "Choices come fast: “Large or small?” “For here or to go?” Answer with a full mini-sentence: “Small, to go, please.”"), examples = listOf(ExampleLine(text = "I'd like a cappuccino, please.", meaning = "The polite order."), ExampleLine(text = "Can I have a glass of water?", meaning = "Alternative order."), ExampleLine(text = "Anything else?", meaning = "The server asks for more."), ExampleLine(text = "That's all, thanks.", meaning = "Close the order."), ExampleLine(text = "For here or to go?", meaning = "The classic choice."), ExampleLine(text = "Can I have the bill, please?", meaning = "Ask to pay."))), expressions = listOf(TargetExpression(text = "I'd like …, please.", meaning = "Polite order — would like.", note = "I'd like the soup."), TargetExpression(text = "Can I have …, please?", meaning = "Order or ask for anything.", note = "Can I have a spoon?"), TargetExpression(text = "Anything else?", meaning = "Server asks for more.", note = "Answer: “No, that's all”."), TargetExpression(text = "For here or to go?", meaning = "Eat in or take away.", note = "To go, please."), TargetExpression(text = "The bill, please.", meaning = "Ask to pay.", note = "Also: “Could we pay, please?”"), TargetExpression(text = "Keep the change.", meaning = "Generous close.", note = "Small tip, big smile.")), situation = "A busy café at breakfast time: order for you and the learner, handle the server's questions and settle the bill.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Good morning! What can I get you?", expected = listOf("I'd like a <drink>, please.", "Can I have a <drink>, please?"), focus = "opening an order", watch = "“I want a coffee” — understandable, but “I'd like” is politer."), PracticeQuestion(prompt = "Anything else?", expected = listOf("That's all, thanks.", "Yes, also a <item>, please."), focus = "closing the order", watch = "“Nothing more” — natural is “That's all, thanks”."), PracticeQuestion(prompt = "For here or to go?", expected = listOf("For here, please.", "To go, please."), focus = "the classic choice", watch = "Answer the part they asked: here/to go."), PracticeQuestion(prompt = "Large or small?", expected = listOf("Large, please.", "Small is fine."), focus = "size answers", watch = "“I take large” — “Large, please” is the café norm."), PracticeQuestion(prompt = "Here you are — anything else for you two?", expected = listOf("Yes — the bill, please.", "No, thanks. Keep the change."), focus = "paying phrases", watch = "“Give me the bill” — “The bill, please” is polite."), PracticeQuestion(prompt = "How was everything?", expected = listOf("Delicious, thank you!", "Very good, thanks."), focus = "polite close", watch = "One warm sentence closes the visit."))), exercises = listOf(Exercise(id = "en-foundations-u5-cafe-e1", kind = "choice", prompt = "___ like a coffee, please.", options = listOf("I'd", "I", "Me", "Mine"), answers = listOf("I'd"), explain = "I'd like = polite want."), Exercise(id = "en-foundations-u5-cafe-e2", kind = "gap", prompt = "Can I have the ___ , please? (la cuenta)", options = listOf(), answers = listOf("bill"), explain = "The bill (UK) / the check (US)."), Exercise(id = "en-foundations-u5-cafe-e3", kind = "order", prompt = "Ask for the menu politely.", options = listOf(), answers = listOf("Can I have the menu, please"), explain = "Can I have … , please? works everywhere."), Exercise(id = "en-foundations-u5-cafe-e4", kind = "written", prompt = "Order a tea politely.", options = listOf(), answers = listOf("Can I have a tea, please", "I'd like a tea, please", "Can I have a tea"), explain = "Can I have / I’d like + drink + please.")), skills = listOf("function:order-food", "vocab:food", "grammar:countable-uncountable", "speaking:short-answer"), canDo = listOf("order-food"), prerequisites = listOf("grammar:some-any"))))
}

object EnFoundationsU6 {
    val unit = CourseUnit(id = "en-foundations-u6", title = "The past begins", subtitle = "Tell what happened", level = "A2", themes = listOf(ConversationTheme("weekend", "The weekend", "What happened", "sun.max", "Course", "Monday catch-up: tell each other what you really did at the weekend, moment by moment.", 0),
                ConversationTheme("last-trip", "A trip to remember", "Tell the story", "airplane", "Course", "You swap stories of a memorable trip: where you were, what you did and how it ended.", 1)), lessons = listOf(    Lesson(id = "en-foundations-u6-was-were", title = "Was / were", goal = "Describe people, places and feelings in the past with was and were.", intro = LessonIntro(explanation = listOf("Was and were are the past of to be. I/he/she/it → was. You/we/they → were. “I was at home.” “They were at the beach.”", "Negatives: wasn't, weren't. Questions flip: “Was it good?” “Where were you?”", "Anchor the story in time: yesterday, last night, last week, in 2020, this morning."), examples = listOf(ExampleLine(text = "I was tired yesterday.", meaning = "was with I."), ExampleLine(text = "The film was great.", meaning = "was with it."), ExampleLine(text = "We were at Ana's party.", meaning = "were with we."), ExampleLine(text = "The streets weren't empty.", meaning = "Plural negative."), ExampleLine(text = "Was the weather good?", meaning = "Past question."), ExampleLine(text = "Where were you last night?", meaning = "Question word + were."))), expressions = listOf(TargetExpression(text = "I was / he was …", meaning = "Past of be, singular.", note = "She was delighted."), TargetExpression(text = "you were / they were", meaning = "Past of be, plural.", note = "They were neighbours."), TargetExpression(text = "wasn't / weren't", meaning = "Past negatives.", note = "It wasn't my fault."), TargetExpression(text = "Was it …? / Were you …?", meaning = "Past yes/no questions.", note = "Was it far?"), TargetExpression(text = "yesterday / last night / last week", meaning = "Anchor the story in time.", note = "last weekend"), TargetExpression(text = "It was amazing / awful.", meaning = "Give your verdict of the past.", note = "The concert? It was amazing.")), situation = "You bump into a friend who missed the neighbourhood party on Saturday: recount who was there, how it was and what wasn't good.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Where were you on Saturday?", expected = listOf("I was <place>.", "I was at home."), focus = "were with you", watch = "“I were at home” — with I use was."), PracticeQuestion(prompt = "Was the party fun?", expected = listOf("Yes, it was.", "No, it wasn't."), focus = "was short answers", watch = "“Yes, was fun” — keep it: “Yes, it was”."), PracticeQuestion(prompt = "Were there many people?", expected = listOf("Yes, there were lots.", "No, there weren't many."), focus = "were + there", watch = "“There was many” — plural: “there were”."), PracticeQuestion(prompt = "How was the music?", expected = listOf("It was great.", "It was terrible!"), focus = "verdict with was", watch = "“It were good” — it takes was."), PracticeQuestion(prompt = "I was so tired on Sunday. And you?", expected = listOf("I was tired too.", "I wasn't tired — I was full of energy."), focus = "wasn't", watch = "“I not tired” — past negative: “I wasn't tired”."), PracticeQuestion(prompt = "Who was there from your class?", expected = listOf("<Name> was there.", "Nobody was there."), focus = "who + was", watch = "“Who were there” — who takes was here."))), exercises = listOf(Exercise(id = "en-foundations-u6-was-were-e1", kind = "choice", prompt = "We ___ at home yesterday.", options = listOf("were", "was", "are", "did"), answers = listOf("were"), explain = "With we/you/they: were."), Exercise(id = "en-foundations-u6-was-were-e2", kind = "gap", prompt = "The film ___ great.", options = listOf(), answers = listOf("was"), explain = "Singular things: was."), Exercise(id = "en-foundations-u6-was-were-e3", kind = "order", prompt = "Ask about last night.", options = listOf(), answers = listOf("Where were you last night"), explain = "were + you for the past."), Exercise(id = "en-foundations-u6-was-were-e4", kind = "written", prompt = "Describe el tiempo el fin de semana pasado.", options = listOf(), answers = listOf("The weather was good at the weekend", "It was sunny at the weekend", "The weather was nice at the weekend"), explain = "was + adjective for past descriptions.")), skills = listOf("grammar:past-was-were", "vocab:feelings", "function:describe-past-events", "pron:r"), canDo = listOf("describe-past-events"), prerequisites = listOf("grammar:verb-be")),
    Lesson(id = "en-foundations-u6-past", title = "Past simple: -ed", goal = "Tell what you and others did, with regular past forms and didn't.", intro = LessonIntro(explanation = listOf("For finished actions, regular verbs add -ed: work → worked, play → played, watch → watched. The same form works for every person.", "Questions and negatives use did + plain verb: “Did you walk?” “I didn't walk.” After did, no -ed: not “Did you walked?”", "Spelling: love → loved (no e), study → studied (y→ied), stop → stopped (double p)."), examples = listOf(ExampleLine(text = "I worked late yesterday.", meaning = "-ed, all persons."), ExampleLine(text = "She played tennis on Saturday.", meaning = "Same -ed with she."), ExampleLine(text = "Did you watch the match?", meaning = "did + plain verb."), ExampleLine(text = "We didn't stay long.", meaning = "didn't + plain verb."), ExampleLine(text = "They studied all night.", meaning = "y → ied."), ExampleLine(text = "It stopped suddenly.", meaning = "Double consonant."))), expressions = listOf(TargetExpression(text = "verb + -ed", meaning = "Regular past, every person.", note = "I called you twice."), TargetExpression(text = "Did you …?", meaning = "Past question, plain verb.", note = "Did you enjoy it?"), TargetExpression(text = "I didn't …", meaning = "Past negative, plain verb.", note = "I didn't sleep well."), TargetExpression(text = "Yes, I did. / No, I didn't.", meaning = "Short answers.", note = "Repeat did."), TargetExpression(text = "y → ied", meaning = "study → studied, try → tried.", note = "We tried the new café."), TargetExpression(text = "yesterday evening / last Friday", meaning = "Past time anchors.", note = "last Friday night")), situation = "You compare diaries from a chaotic Tuesday: what you did, what you didn't do, and what the other did first.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "What did you do yesterday evening?", expected = listOf("I <verb>ed …", "I watched TV and cooked dinner."), focus = "did + past answer", watch = "“I watch TV” — past answer needs -ed: “I watched”."), PracticeQuestion(prompt = "Did you sleep well?", expected = listOf("Yes, I did.", "No, I didn't."), focus = "did short answers", watch = "The short answer repeats did: “Yes, I did”."), PracticeQuestion(prompt = "Did you walk to work?", expected = listOf("No, I didn't. I cycled.", "Yes, I did."), focus = "didn't + plain verb", watch = "“I didn't walked” — after didn't, plain verb."), PracticeQuestion(prompt = "What time did you finish work?", expected = listOf("I finished at <time>.", "I didn't finish until <time>."), focus = "past + time", watch = "“What time did you finished?” — after did, plain finish."), PracticeQuestion(prompt = "Did you study English last week?", expected = listOf("Yes, I did. I studied on …", "No, I didn't study."), focus = "y→ied spelling", watch = "“I studyed” — study → studied."), PracticeQuestion(prompt = "Your colleague — did she call you?", expected = listOf("Yes, she did.", "No, she didn't call."), focus = "third person past", watch = "“Did she called” — after did, plain call."))), exercises = listOf(Exercise(id = "en-foundations-u6-past-e1", kind = "choice", prompt = "I ___ TV last night.", options = listOf("watched", "watch", "watching", "am watch"), answers = listOf("watched"), explain = "Regular past: watch → watched."), Exercise(id = "en-foundations-u6-past-e2", kind = "gap", prompt = "She didn't ___ the email. (receive)", options = listOf(), answers = listOf("receive"), explain = "After didn't the verb stays in base form."), Exercise(id = "en-foundations-u6-past-e3", kind = "order", prompt = "Say they got here late yesterday.", options = listOf(), answers = listOf("They arrived late yesterday"), explain = "arrive → arrived; no did when the past is on the verb."), Exercise(id = "en-foundations-u6-past-e4", kind = "written", prompt = "Say you worked on Saturday.", options = listOf(), answers = listOf("I worked on Saturday", "On Saturday I worked"), explain = "work → worked.")), skills = listOf("grammar:past-simple-regular", "grammar:past-simple-irregular", "function:describe-past-events", "pron:past-ed"), canDo = listOf("describe-past-events"), prerequisites = listOf("grammar:past-was-were")),
    Lesson(id = "en-foundations-u6-weekend", title = "Your weekend (repaso)", goal = "Tell the story of your weekend in order — past be, past verbs, time anchors — and ask about someone else's.", intro = LessonIntro(explanation = listOf("A weekend story has three parts: where you were (was/were), what you did (past -ed), and how it was (was + opinion).", "Order it with time anchors: on Saturday morning, then, in the evening, later, finally.", "Keep the conversation alive: ask back with “What about you?” or “Did you …?”"), examples = listOf(ExampleLine(text = "On Friday I was at home — I was exhausted.", meaning = "Part 1: where + how."), ExampleLine(text = "On Saturday I visited my parents.", meaning = "Part 2: past action."), ExampleLine(text = "We walked in the park and talked for hours.", meaning = "Two past verbs, one story."), ExampleLine(text = "In the evening I watched a film.", meaning = "Time anchor + past."), ExampleLine(text = "It was a really good weekend.", meaning = "Part 3: the verdict."), ExampleLine(text = "What about you? What did you do?", meaning = "Ask it back."))), expressions = listOf(TargetExpression(text = "On Saturday morning, …", meaning = "Open the story with a time.", note = "…I played padel."), TargetExpression(text = "First …, then …, later …", meaning = "Sequence the actions.", note = "Then we had lunch."), TargetExpression(text = "I visited / called / watched …", meaning = "Regular past actions.", note = "I called my brother."), TargetExpression(text = "It was really + adjective", meaning = "Give your verdict.", note = "It was really relaxing."), TargetExpression(text = "What about you?", meaning = "Return the question.", note = "The conversation keeps flowing."), TargetExpression(text = "That sounds + adjective", meaning = "React to the other's story.", note = "That sounds fun!")), situation = "Monday coffee with a friend: take turns telling your weekends, react, and ask at least two questions back.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "So — how was your weekend?", expected = listOf("It was <adjective>. On Saturday I …", "Really good, thanks!"), focus = "verdict + story opener", watch = "Start with the verdict, then the story."), PracticeQuestion(prompt = "What did you do on Saturday?", expected = listOf("I <verb>ed … First …, then …"), focus = "past actions in order", watch = "Use -ed for regular verbs and an order word."), PracticeQuestion(prompt = "Were you with friends or alone?", expected = listOf("I was with <people>.", "I was on my own."), focus = "was/were recap", watch = "“I was with” — was works with I."), PracticeQuestion(prompt = "That sounds nice! Did you eat out?", expected = listOf("Yes, we did — we tried a new place.", "No, we didn't. We cooked at home."), focus = "did questions about the story", watch = "“Yes, we eat out” — past short answer: “Yes, we did”."), PracticeQuestion(prompt = "What about Sunday?", expected = listOf("On Sunday I …", "Sunday was quieter — I …"), focus = "extending the story", watch = "Another time anchor, another scene."), PracticeQuestion(prompt = "OK, your turn — ask me about my weekend.", expected = listOf("What did you do?", "How was your weekend?"), focus = "asking back", watch = "A conversation needs a return serve: ask one question."))), exercises = listOf(Exercise(id = "en-foundations-u6-weekend-e1", kind = "choice", prompt = "___ you have a good weekend?", options = listOf("Did", "Was", "Were", "Do"), answers = listOf("Did"), explain = "have is a normal verb: questions need Did."), Exercise(id = "en-foundations-u6-weekend-e2", kind = "gap", prompt = "We ___ so tired on Sunday.", options = listOf(), answers = listOf("were"), explain = "Past be with we: were."), Exercise(id = "en-foundations-u6-weekend-e3", kind = "order", prompt = "Start your Saturday story.", options = listOf(), answers = listOf("On Saturday I met my friends"), explain = "Time anchor first: On Saturday …"), Exercise(id = "en-foundations-u6-weekend-e4", kind = "written", prompt = "Tell one thing you did last weekend.", options = listOf(), answers = listOf("I <verbed> last weekend", "Last weekend I <verbed>", "On Saturday I <verbed>"), explain = "Past verb + time anchor.")), skills = listOf("grammar:past-simple-irregular", "grammar:time-expressions", "function:tell-a-story", "speaking:tell-past-story"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-regular"))))
}

object EnFoundationsCompare {
    val unit = CourseUnit(id = "en-foundations-compare", title = "Comparing & choosing", subtitle = "Which one is better?", level = "A2", themes = listOf(ConversationTheme("two-flats", "Two flats, one choice", "Compare and decide", "house", "Course", "You visit two flats to rent. Compare rooms, price, light and noise — then choose one together.", 0),
                ConversationTheme("gift-debate", "The gift debate", "The best present", "gift", "Course", "You are choosing a birthday present for a friend. Compare ideas and agree on the best one.", 1)), lessons = listOf(    Lesson(id = "en-foundations-compare-comparatives", title = "Comparatives", goal = "Compare two things with -er/more … than.", intro = LessonIntro(explanation = listOf("Short adjectives take -er: cheap → cheaper, big → bigger, busy → busier. Long adjectives take more: more expensive, more comfortable.", "The comparison word is than: “This flat is cheaper than that one.” “The kitchen is bigger than the bedroom.”", "Irregulars: good → better, bad → worse, far → further."), examples = listOf(ExampleLine(text = "This café is cheaper than that one.", meaning = "cheap → cheaper."), ExampleLine(text = "Trains are more comfortable than buses.", meaning = "Long adjective → more."), ExampleLine(text = "My flat is bigger than yours.", meaning = "big → bigger (double the g)."), ExampleLine(text = "Today is busier than yesterday.", meaning = "busy → busier (y → i)."), ExampleLine(text = "This book is better than the film.", meaning = "Irregular: better."), ExampleLine(text = "Is the market cheaper than the supermarket?", meaning = "Question with comparatives."))), expressions = listOf(TargetExpression(text = "… -er than …", meaning = "Compare short adjectives.", note = "cheaper, older, faster."), TargetExpression(text = "more … than …", meaning = "Compare long adjectives.", note = "more modern, more quiet? → noisier!"), TargetExpression(text = "better / worse than", meaning = "The two irregulars you need most.", note = "Never “more good”."), TargetExpression(text = "much … -er / much more …", meaning = "Make the difference big.", note = "much cheaper = mucho más barato."), TargetExpression(text = "Which one do you prefer?", meaning = "Ask for a choice.", note = "I prefer the small one."), TargetExpression(text = "… than I expected.", meaning = "Compare with an expectation.", note = "nicer than I expected.")), situation = "You and a friend compare two cafés near work: price, size, coffee, noise — and choose where to go today.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Compare two flats: the second one is modern, the first isn't. (sentence)", expected = listOf("The second flat is more modern than the first."), focus = "more + long adjective", watch = "“moderner” doesn't exist — long adjectives take more."), PracticeQuestion(prompt = "The bus takes 40 minutes, the train takes 25. Compare them.", expected = listOf("The train is faster than the bus.", "The bus is slower than the train."), focus = "-er than", watch = "Keep than in the sentence: “faster than”."), PracticeQuestion(prompt = "Which is correct: “more good” or “better”?", expected = listOf("better"), focus = "irregular comparative", watch = "good → better, bad → worse — always irregular."), PracticeQuestion(prompt = "The rent is 800; you expected 600. React.", expected = listOf("It's more expensive than I expected.", "The rent is higher than I expected."), focus = "than I expected", watch = "higher for prices, more expensive also works."), PracticeQuestion(prompt = "Ask which café your friend prefers.", expected = listOf("Which one do you prefer?", "Which café do you prefer?"), focus = "asking for a choice", watch = "prefer + noun: “I prefer this one”."), PracticeQuestion(prompt = "Say the coffee here is much cheaper than at the other place.", expected = listOf("The coffee here is much cheaper than at the other place.", "It's much cheaper here."), focus = "much + comparative", watch = "much makes it strong: “much cheaper”, never “very cheaper”."))), exercises = listOf(Exercise(id = "en-foundations-compare-comparatives-e1", kind = "choice", prompt = "This hotel is ___ than the last one.", options = listOf("more comfortable", "comfortabler", "most comfortable", "comfortable"), answers = listOf("more comfortable"), explain = "Long adjectives take more: more comfortable."), Exercise(id = "en-foundations-compare-comparatives-e2", kind = "gap", prompt = "My city is ___ (big) than yours.", options = listOf(), answers = listOf("bigger"), explain = "big → bigger: double the g."), Exercise(id = "en-foundations-compare-comparatives-e3", kind = "order", prompt = "Say the train is faster.", options = listOf(), answers = listOf("The train is faster than the bus"), explain = "comparative + than."), Exercise(id = "en-foundations-compare-comparatives-e4", kind = "written", prompt = "Fix the mistake: “This film is more good than the book.”", options = listOf(), answers = listOf("this film is better than the book"), explain = "good → better — the irregular wins.")), skills = listOf("grammar:comparatives", "grammar:articles", "function:express-opinion", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:articles", "grammar:verb-be")),
    Lesson(id = "en-foundations-compare-superlatives", title = "Superlatives", goal = "Say which one is the most / the -est in a group.", intro = LessonIntro(explanation = listOf("Short adjectives: the + -est: the cheapest, the biggest, the busiest. Long adjectives: the most + adjective: the most beautiful.", "Superlatives live with in or of: “the cheapest café in town”, “the best day of the year”.", "Irregulars: good → the best, bad → the worst."), examples = listOf(ExampleLine(text = "It's the cheapest café in town.", meaning = "the + -est + in + place."), ExampleLine(text = "That's the most beautiful street here.", meaning = "the most + long adjective."), ExampleLine(text = "August is the busiest month.", meaning = "busy → the busiest."), ExampleLine(text = "This is the best pizza in the city!", meaning = "Irregular: the best."), ExampleLine(text = "Monday was the worst day of the week.", meaning = "the worst + of + group."), ExampleLine(text = "It's the oldest building in the neighbourhood.", meaning = "old → the oldest."))), expressions = listOf(TargetExpression(text = "the … -est in/of …", meaning = "Top of a short-adjective group.", note = "the oldest in the family."), TargetExpression(text = "the most … in/of …", meaning = "Top of a long-adjective group.", note = "the most famous in Spain."), TargetExpression(text = "the best / the worst", meaning = "The two irregular tops.", note = "the best day ever."), TargetExpression(text = "my favourite …", meaning = "Your personal top one.", note = "my favourite café in town."), TargetExpression(text = "What's the best … ?", meaning = "Ask for a recommendation.", note = "What's the best way to get there?"), TargetExpression(text = "one of the … -est", meaning = "Near the top, not the very top.", note = "one of the oldest bars in Madrid.")), situation = "A tourist asks you about your town: recommend the best café, the most beautiful square and the worst time to visit.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Recommend the cheapest restaurant you know.", expected = listOf("<Name> is the cheapest restaurant in town.", "The cheapest restaurant is <Name>."), focus = "the + -est", watch = "Superlatives need the: “the cheapest”, never just “cheapest”."), PracticeQuestion(prompt = "Describe a very famous place in your country. (long adjective)", expected = listOf("It's one of the most famous places in <country>."), focus = "the most + long adjective", watch = "“the famousest” doesn't exist — the most famous."), PracticeQuestion(prompt = "Which is correct: “the best” or “the most good”?", expected = listOf("the best"), focus = "irregular superlative", watch = "good → the best, bad → the worst."), PracticeQuestion(prompt = "Ask for the best way to get to the airport.", expected = listOf("What's the best way to get to the airport?"), focus = "asking for a recommendation", watch = "Fixed question: “What's the best way to …?”"), PracticeQuestion(prompt = "Say your favourite day of the week and why.", expected = listOf("My favourite day is <day> because …"), focus = "favourite + because", watch = "favourite already means “the one I like most”."), PracticeQuestion(prompt = "Complete: “This is one of ___ (old) bars in the city.”", expected = listOf("one of the oldest bars in the city"), focus = "one of the -est", watch = "one of + the + superlative + plural noun."))), exercises = listOf(Exercise(id = "en-foundations-compare-superlatives-e1", kind = "choice", prompt = "This is ___ café in the neighbourhood.", options = listOf("the most popular", "the popularest", "more popular", "popular"), answers = listOf("the most popular"), explain = "Long adjectives: the most + adjective."), Exercise(id = "en-foundations-compare-superlatives-e2", kind = "gap", prompt = "August is ___ (busy) month here.", options = listOf(), answers = listOf("the busiest"), explain = "busy → the busiest."), Exercise(id = "en-foundations-compare-superlatives-e3", kind = "order", prompt = "Recommend the best pizza.", options = listOf(), answers = listOf("This is the best pizza in the city"), explain = "the best + noun + in + place."), Exercise(id = "en-foundations-compare-superlatives-e4", kind = "written", prompt = "Fix: “It's most old building in town.”", options = listOf(), answers = listOf("it's the oldest building in town"), explain = "old → the oldest, and superlatives need the.")), skills = listOf("grammar:superlatives", "grammar:comparatives", "function:express-opinion", "vocab:town"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:comparatives")),
    Lesson(id = "en-foundations-compare-object-pronouns", title = "Object pronouns", goal = "Use me, you, him, her, it, us and them after verbs and prepositions.", intro = LessonIntro(explanation = listOf("After a verb, use the object pronoun: “Can you help me?” “I saw her yesterday.” “Call them later.”", "After prepositions too: “with me”, “for him”, “without them”, “between us”.", "it stays it; you stays you. Subject does the action, object receives it: “She loves him.”"), examples = listOf(ExampleLine(text = "Can you help me?", meaning = "object after a verb."), ExampleLine(text = "I saw them at the market.", meaning = "them = they."), ExampleLine(text = "This gift is for her.", meaning = "object after a preposition."), ExampleLine(text = "Come with us!", meaning = "us = we as object."), ExampleLine(text = "I'll call him tomorrow.", meaning = "him = he as object."), ExampleLine(text = "She works with me.", meaning = "me = I as object."))), expressions = listOf(TargetExpression(text = "verb + me/him/her/them/us", meaning = "The receiver of the action.", note = "Call me. Help us."), TargetExpression(text = "preposition + object pronoun", meaning = "with me, for him, to her.", note = "Never “with I”."), TargetExpression(text = "Let me …", meaning = "Offer or ask permission.", note = "Let me help you."), TargetExpression(text = "between us", meaning = "A secret or shared thing.", note = "Between you and me — never “between you and I”."), TargetExpression(text = "I don't understand it.", meaning = "it for things and ideas.", note = "it = this/that idea."), TargetExpression(text = "See you / See them later", meaning = "Goodbyes with objects.", note = "you stays the same.")), situation = "You are helping a new colleague settle in: offer help, introduce people, and explain who does what with whom.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Offer help to your new colleague.", expected = listOf("Let me help you.", "Can I help you?"), focus = "object pronouns", watch = "“Let me to help” — let takes the bare verb."), PracticeQuestion(prompt = "Say you saw Anna and Tom at the cinema. (them)", expected = listOf("I saw them at the cinema."), focus = "them", watch = "“I saw they” — subject vs object: they saw, saw them."), PracticeQuestion(prompt = "Your friend is carrying bags. Offer to carry one. (it)", expected = listOf("Let me carry it.", "Can I carry it for you?"), focus = "it", watch = "it replaces the thing: the bag → it."), PracticeQuestion(prompt = "Say this secret is between you and your friend. (between …)", expected = listOf("It's between you and me."), focus = "between you and me", watch = "Never “between you and I” — after a preposition use me."), PracticeQuestion(prompt = "Say you will call your parents tonight. (them)", expected = listOf("I'll call them tonight.", "I'm going to call them tonight."), focus = "them", watch = "“call to them” — no to: “call them”."), PracticeQuestion(prompt = "Say this chair is for your guest. (her)", expected = listOf("This chair is for her."), focus = "for + her", watch = "“for she” — prepositions take object pronouns."))), exercises = listOf(Exercise(id = "en-foundations-compare-object-pronouns-e1", kind = "choice", prompt = "Can you help ___? I can't lift this.", options = listOf("me", "I", "my", "mine"), answers = listOf("me"), explain = "After the verb, object pronoun: help me."), Exercise(id = "en-foundations-compare-object-pronouns-e2", kind = "gap", prompt = "This present is for ___. (Anna)", options = listOf(), answers = listOf("her"), explain = "Anna → her after a preposition."), Exercise(id = "en-foundations-compare-object-pronouns-e3", kind = "order", prompt = "Ask a friend to come along.", options = listOf(), answers = listOf("Come with us"), explain = "preposition + us."), Exercise(id = "en-foundations-compare-object-pronouns-e4", kind = "written", prompt = "Fix: “She loves he.”", options = listOf(), answers = listOf("she loves him"), explain = "he is the subject; the object is him.")), skills = listOf("grammar:object-pronouns", "grammar:subject-pronouns", "function:make-requests"), prerequisites = listOf("grammar:subject-pronouns"))))
}

object EnFoundationsPlans {
    val unit = CourseUnit(id = "en-foundations-plans", title = "Plans & advice", subtitle = "What's next", level = "A2", themes = listOf(ConversationTheme("weekend-trip", "The weekend trip", "What are you going to do?", "map", "Course", "You are planning a weekend trip together: say your plans, compare ideas and agree on a route.", 0),
                ConversationTheme("new-job-jitters", "The new job", "Rules and advice", "briefcase", "Course", "A friend starts a new job tomorrow. Talk about the rules (must, have to) and give friendly advice (should).", 1)), lessons = listOf(    Lesson(id = "en-foundations-plans-going-to", title = "Going to: plans", goal = "Talk about future plans and intentions with am/is/are going to.", intro = LessonIntro(explanation = listOf("Plans use be + going to + verb: “I'm going to visit my family. She's going to study tonight. We're going to move house.”", "Questions flip be: “Are you going to come?” Negatives add not: “I'm not going to work on Saturday.”", "going to is about intention — a plan already in your head. Time markers: tonight, tomorrow, next week, this weekend."), examples = listOf(ExampleLine(text = "I'm going to learn to cook.", meaning = "An intention."), ExampleLine(text = "She's going to start a new job.", meaning = "Her plan for the future."), ExampleLine(text = "We're going to travel in June.", meaning = "A plan with a date."), ExampleLine(text = "Are you going to watch the match?", meaning = "Ask about a plan."), ExampleLine(text = "I'm not going to pay for that!", meaning = "A refused plan."), ExampleLine(text = "It's going to rain tonight.", meaning = "A prediction with evidence — the clouds!"))), expressions = listOf(TargetExpression(text = "I'm going to + verb", meaning = "Your plan.", note = "I'm going to start running."), TargetExpression(text = "Are you going to …?", meaning = "Ask about plans.", note = "Are you going to join us?"), TargetExpression(text = "I'm not going to …", meaning = "A plan you refuse.", note = "I'm not going to stay late."), TargetExpression(text = "What are you going to do …?", meaning = "The classic plan question.", note = "… this weekend?"), TargetExpression(text = "It's going to …", meaning = "Prediction with evidence.", note = "Look at those clouds!"), TargetExpression(text = "next week / this weekend / tonight", meaning = "Anchor the plan in time.", note = "going to + time marker.")), situation = "You and a friend plan a free Saturday: say what you're going to do, ask about their plans and find something to do together.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ask your friend about their plans for the weekend.", expected = listOf("What are you going to do at the weekend?", "What are you going to do this weekend?"), focus = "the plan question", watch = "“What you going to do?” — the are is obligatory in careful English."), PracticeQuestion(prompt = "Say one plan you have for next month.", expected = listOf("I'm going to <verb> next month.", "Next month I'm going to <verb>."), focus = "I'm going to", watch = "“I going to travel” — be comes first: “I'm going to”."), PracticeQuestion(prompt = "The sky is very grey. What do you say? (rain)", expected = listOf("It's going to rain."), focus = "prediction with evidence", watch = "Present evidence → going to: “It's going to rain”."), PracticeQuestion(prompt = "Refuse politely: your friends want to stay out until 2am.", expected = listOf("I'm not going to stay out that late.", "I'm not going to stay until two."), focus = "negative plan", watch = "“I not going” — “I'm not going to”."), PracticeQuestion(prompt = "Ask if she is going to join the gym with you.", expected = listOf("Are you going to join the gym with me?"), focus = "are + going to", watch = "Questions flip be: “Are you going to…?”"), PracticeQuestion(prompt = "Say your plans after this course. (two sentences)", expected = listOf("I'm going to <activity> and I'm going to <activity>."), focus = "chaining plans", watch = "and joins two plans: “I'm going to practise and travel”."))), exercises = listOf(Exercise(id = "en-foundations-plans-going-to-e1", kind = "choice", prompt = "They ___ going to move to Lisbon.", options = listOf("are", "is", "do", "will"), answers = listOf("are"), explain = "With they: are going to."), Exercise(id = "en-foundations-plans-going-to-e2", kind = "gap", prompt = "I ___ ___ ___ study tonight. (3 words: intention of I)", options = listOf(), answers = listOf("am going to", "'m going to"), explain = "I am going to + verb."), Exercise(id = "en-foundations-plans-going-to-e3", kind = "order", prompt = "Ask about their evening plans.", options = listOf(), answers = listOf("What are you going to do tonight"), explain = "Question word + are + you + going to."), Exercise(id = "en-foundations-plans-going-to-e4", kind = "written", prompt = "Fix: “She going to start a course.”", options = listOf(), answers = listOf("she's going to start a course", "she is going to start a course"), explain = "She's going to — be is obligatory.")), skills = listOf("grammar:going-to", "function:make-future-plans", "speaking:describe-routine"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:verb-be")),
    Lesson(id = "en-foundations-plans-past-irregular", title = "Irregular past verbs", goal = "Tell past stories with the most common irregular verbs.", intro = LessonIntro(explanation = listOf("Many common verbs are irregular: go → went, see → saw, make → made, take → took, come → came, get → got.", "Negatives and questions return to the base form with did: “I didn't go. Did you see it?” The past lives only in the positive.", "Learn them in pairs: buy → bought, eat → ate, drink → drank, write → wrote, drive → drove, sleep → slept."), examples = listOf(ExampleLine(text = "We went to the coast last summer.", meaning = "go → went."), ExampleLine(text = "I saw your brother yesterday.", meaning = "see → saw."), ExampleLine(text = "She made a cake for my birthday.", meaning = "make → made."), ExampleLine(text = "I didn't take the umbrella.", meaning = "didn't + base form."), ExampleLine(text = "Did you eat anything?", meaning = "did + base form in questions."), ExampleLine(text = "He came home late and went to bed.", meaning = "Two irregulars in one story."))), expressions = listOf(TargetExpression(text = "go → went", meaning = "The most common of all.", note = "We went home early."), TargetExpression(text = "see → saw / take → took", meaning = "Everyday irregulars.", note = "I saw it, I took it."), TargetExpression(text = "make → made / come → came", meaning = "Story verbs.", note = "She made dinner; he came late."), TargetExpression(text = "didn't + base form", meaning = "Past negative.", note = "I didn't sleep well — not “didn't slept”."), TargetExpression(text = "Did you …?", meaning = "Past question.", note = "Did you get my message?"), TargetExpression(text = "yesterday / last night / ago", meaning = "Anchor the story.", note = "two weeks ago.")), situation = "You tell a friend about a disastrous day trip: what went wrong, what you saw, what you lost — all in the past.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Say where you went last weekend. (past, place)", expected = listOf("I went to <place> last weekend."), focus = "went", watch = "“I goed / I wented” — the irregular is went."), PracticeQuestion(prompt = "Say you didn't sleep well last night.", expected = listOf("I didn't sleep well last night."), focus = "didn't + base", watch = "“didn't slept” — after didn't, the verb is bare: sleep."), PracticeQuestion(prompt = "Ask if your friend saw the news yesterday.", expected = listOf("Did you see the news yesterday?"), focus = "did + see", watch = "“Did you saw” — after did, base form: see."), PracticeQuestion(prompt = "Tell one thing you made this week. (make)", expected = listOf("I made <thing> this week."), focus = "made", watch = "make → made, no -ed."), PracticeQuestion(prompt = "Say you came home late yesterday.", expected = listOf("I came home late yesterday."), focus = "came", watch = "come → came: “I come home late” is present."), PracticeQuestion(prompt = "Tell a mini story: where you went, what you saw, what you bought.", expected = listOf("I went to <place>, saw <thing> and bought <thing>."), focus = "three irregulars", watch = "One past story, three irregular verbs: went, saw, bought."))), exercises = listOf(Exercise(id = "en-foundations-plans-past-irregular-e1", kind = "choice", prompt = "Yesterday we ___ to the market.", options = listOf("went", "goed", "go", "gone"), answers = listOf("went"), explain = "go → went."), Exercise(id = "en-foundations-plans-past-irregular-e2", kind = "gap", prompt = "I ___ your keys on the table. (see, yesterday)", options = listOf(), answers = listOf("saw"), explain = "see → saw."), Exercise(id = "en-foundations-plans-past-irregular-e3", kind = "order", prompt = "Ask about their dinner.", options = listOf(), answers = listOf("Did you eat anything"), explain = "Did + you + base verb."), Exercise(id = "en-foundations-plans-past-irregular-e4", kind = "written", prompt = "Fix: “I didn't took the bus.”", options = listOf(), answers = listOf("i didn't take the bus"), explain = "After didn't: take, never took.")), skills = listOf("grammar:past-simple-irregular", "function:describe-past-events", "function:tell-a-story"), canDo = listOf("describe-past-events"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "en-foundations-plans-modals", title = "Advice & obligation", goal = "Give advice with should and talk about rules with must and have to.", intro = LessonIntro(explanation = listOf("should = good idea, advice: “You should rest. You shouldn't work tonight.” It never takes -s or to.", "must = obligation from the speaker; have to = obligation from outside (rules, timetables): “I must finish this.” “I have to wear a uniform.”", "Questions: “Should I call him?” “Do you have to work on Sundays?” Negatives: “You shouldn't smoke.” “I don't have to get up early.”"), examples = listOf(ExampleLine(text = "You should drink more water.", meaning = "Friendly advice."), ExampleLine(text = "You shouldn't eat so late.", meaning = "Negative advice."), ExampleLine(text = "I must finish this today.", meaning = "The speaker's own obligation."), ExampleLine(text = "She has to wear a uniform.", meaning = "An outside rule."), ExampleLine(text = "Do we have to book a table?", meaning = "Ask about a rule."), ExampleLine(text = "You don't have to come.", meaning = "No obligation — it's optional."))), expressions = listOf(TargetExpression(text = "You should + verb", meaning = "Advice.", note = "You should try it."), TargetExpression(text = "You shouldn't + verb", meaning = "Advice against.", note = "You shouldn't worry."), TargetExpression(text = "I must + verb", meaning = "Strong personal obligation.", note = "I must go now."), TargetExpression(text = "have to + verb", meaning = "Outside rules.", note = "I have to work on Saturdays."), TargetExpression(text = "don't have to", meaning = "No obligation — free choice.", note = "≠ mustn't! don't have to = optional."), TargetExpression(text = "Should I …?", meaning = "Ask for advice.", note = "Should I bring anything?")), situation = "A friend starts a new job tomorrow: give advice (should), tell them the rules of your office (have to) and say what is optional (don't have to).", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Your friend has an interview tomorrow. Give one piece of advice.", expected = listOf("You should sleep early.", "You should arrive early.", "You should prepare some questions."), focus = "should + verb", watch = "“You should to prepare” — no to after should."), PracticeQuestion(prompt = "Say one rule at your work. (have to)", expected = listOf("I have to <rule>.", "We have to <rule>."), focus = "have to", watch = "“I have to working” — have to + base verb."), PracticeQuestion(prompt = "Advise your friend NOT to check the phone all night.", expected = listOf("You shouldn't check your phone all night."), focus = "shouldn't", watch = "“You don't should” — the negative is shouldn't."), PracticeQuestion(prompt = "Say Sunday work is optional at your job.", expected = listOf("I don't have to work on Sundays.", "We don't have to work on Sundays."), focus = "don't have to", watch = "don't have to = optional; mustn't = prohibited!"), PracticeQuestion(prompt = "Ask if you need to bring anything to the party. (should)", expected = listOf("Should I bring anything?"), focus = "should question", watch = "“Do I should bring?” — should asks directly: “Should I…?”"), PracticeQuestion(prompt = "The doctor says it's necessary: take the medicine every day. (must)", expected = listOf("I must take the medicine every day.", "You must take the medicine every day."), focus = "must", watch = "must + base verb, no -s, no to."))), exercises = listOf(Exercise(id = "en-foundations-plans-modals-e1", kind = "choice", prompt = "You look tired. You ___ go to bed early.", options = listOf("should", "should to", "are should", "will should"), answers = listOf("should"), explain = "should + base verb — advice."), Exercise(id = "en-foundations-plans-modals-e2", kind = "gap", prompt = "At our office we have ___ wear a badge.", options = listOf(), answers = listOf("to"), explain = "have to + base verb for outside rules."), Exercise(id = "en-foundations-plans-modals-e3", kind = "order", prompt = "Tell your friend the visit is optional.", options = listOf(), answers = listOf("You don't have to come"), explain = "don't have to = no obligation."), Exercise(id = "en-foundations-plans-modals-e4", kind = "written", prompt = "Fix: “You shoulds rest.”", options = listOf(), answers = listOf("you should rest"), explain = "Modal verbs never take -s.")), skills = listOf("grammar:modal-should", "grammar:modal-must-have-to", "function:solve-problems", "vocab:work"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple"))))
}

object EnFoundationsStay {
    val unit = CourseUnit(id = "en-foundations-stay", title = "Staying somewhere", subtitle = "How much, how many, a room", level = "A2", themes = listOf(ConversationTheme("guest-room", "The guest room", "How much space?", "bed.double", "Course", "Family is visiting. Count the beds, the towels and the problems — is there enough room for everyone?", 0),
                ConversationTheme("booking-call", "The booking call", "A room for two nights", "phone", "Course", "You book accommodation by phone: dates, price, breakfast — and one special request.", 1)), lessons = listOf(    Lesson(id = "en-foundations-stay-quantifiers", title = "How much / how many", goal = "Ask about countable and uncountable things with how much and how many.", intro = LessonIntro(explanation = listOf("Countable things (bottles, rooms, tickets) take many: “How many rooms do you need?” Uncountable stuff (water, money, time) takes much: “How much water do you need?”", "In everyday questions, much alone sounds formal: “How much money?” is fine, but people say “How much is it?” — the full countable question needs many.", "Answers use a lot of / some / a few (countable) / a little (uncountable): “We need a few chairs and a little luck.”"), examples = listOf(ExampleLine(text = "How many guests are coming?", meaning = "Countable: guests."), ExampleLine(text = "How much milk is in the fridge?", meaning = "Uncountable: milk."), ExampleLine(text = "How much does it cost?", meaning = "Price always takes much."), ExampleLine(text = "We need a few more chairs.", meaning = "a few + countable."), ExampleLine(text = "There's a little time left.", meaning = "a little + uncountable."), ExampleLine(text = "A lot of people are coming.", meaning = "a lot of works with both."))), expressions = listOf(TargetExpression(text = "How many + plural?", meaning = "Count the things.", note = "How many nights?"), TargetExpression(text = "How much + uncountable?", meaning = "Measure the stuff.", note = "How much luggage?"), TargetExpression(text = "How much is/are …?", meaning = "Ask any price.", note = "How much are the towels?"), TargetExpression(text = "a few + plural", meaning = "A small number.", note = "a few days = algunos días."), TargetExpression(text = "a little + uncountable", meaning = "A small amount.", note = "a little sugar."), TargetExpression(text = "a lot of + both", meaning = "A big amount, always right.", note = "a lot of rooms, a lot of water.")), situation = "Family arrives on Friday: count the beds, towels and chairs, check the milk and sugar for coffee, and decide what to buy.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ask about the number of guests.", expected = listOf("How many guests are coming?"), focus = "how many", watch = "“How much guests” — people are countable: how many."), PracticeQuestion(prompt = "Ask about the amount of milk in the fridge.", expected = listOf("How much milk is there?", "How much milk is in the fridge?"), focus = "how much", watch = "milk is uncountable: how much, never how many."), PracticeQuestion(prompt = "Ask the price of the towels.", expected = listOf("How much are the towels?"), focus = "price", watch = "Price always takes much, even with plural things."), PracticeQuestion(prompt = "Say you need a small number of chairs. (a few)", expected = listOf("We need a few more chairs.", "I need a few chairs."), focus = "a few", watch = "a few + plural: “a few chairs”, never “a little chairs”."), PracticeQuestion(prompt = "Say there is a small amount of time left.", expected = listOf("There's a little time left.", "There is a little time left."), focus = "a little", watch = "a little + uncountable: time, money, luck."), PracticeQuestion(prompt = "Safe answer for both: many rooms, much water.", expected = listOf("We need a lot of rooms and a lot of water."), focus = "a lot of", watch = "When unsure, a lot of works with countable and uncountable."))), exercises = listOf(Exercise(id = "en-foundations-stay-quantifiers-e1", kind = "choice", prompt = "___ many nights are you staying?", options = listOf("How", "What", "How much", "Which"), answers = listOf("How"), explain = "nights are countable: How many."), Exercise(id = "en-foundations-stay-quantifiers-e2", kind = "gap", prompt = "There's ___ ___ sugar left. (small amount, uncountable)", options = listOf(), answers = listOf("a little"), explain = "a little + uncountable."), Exercise(id = "en-foundations-stay-quantifiers-e3", kind = "order", prompt = "Ask about the price of the room.", options = listOf(), answers = listOf("How much is the room"), explain = "Price: How much is…?"), Exercise(id = "en-foundations-stay-quantifiers-e4", kind = "written", prompt = "Fix: “How much rooms do you need?”", options = listOf(), answers = listOf("how many rooms do you need"), explain = "rooms are countable: how many.")), skills = listOf("grammar:quantities", "grammar:countable-uncountable", "grammar:some-any", "vocab:home"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:some-any", "grammar:countable-uncountable")),
    Lesson(id = "en-foundations-stay-accommodation", title = "A room for two nights", goal = "Book accommodation: dates, price, breakfast and one special request.", intro = LessonIntro(explanation = listOf("Booking by phone has a shape: “I'd like to book a room, please.” → dates → “How much is it per night?” → “Does it include breakfast?”", "Room words: a single room (one bed), a double room (big bed), twins (two beds). Say the nights: “from Friday to Sunday — two nights.”", "Special requests stay polite: “Would it be possible to have a quiet room?” The answer you want: “No problem.”"), examples = listOf(ExampleLine(text = "I'd like to book a double room, please.", meaning = "The opening line."), ExampleLine(text = "From Friday to Sunday — two nights.", meaning = "The dates."), ExampleLine(text = "How much is it per night?", meaning = "Price per night."), ExampleLine(text = "Does it include breakfast?", meaning = "The classic question."), ExampleLine(text = "Is there Wi-Fi in the rooms?", meaning = "Check the extras."), ExampleLine(text = "Would it be possible to have a quiet room?", meaning = "The polite special request."))), expressions = listOf(TargetExpression(text = "I'd like to book …", meaning = "Open any booking.", note = "I'd like to = polite want."), TargetExpression(text = "a single / double / twin room", meaning = "Room types.", note = "twin = two separate beds."), TargetExpression(text = "from … to …, … nights", meaning = "Say the dates.", note = "from Friday to Sunday."), TargetExpression(text = "per night", meaning = "Price unit.", note = "€60 per night."), TargetExpression(text = "Does it include breakfast?", meaning = "What's included.", note = "include = venir con."), TargetExpression(text = "Would it be possible to …?", meaning = "Special request.", note = "The politest way to ask.")), situation = "You call a small hotel for a weekend: book a double room, ask the price, check breakfast and Wi-Fi, and request a quiet room at the back.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Open the call: you want a double room.", expected = listOf("I'd like to book a double room, please."), focus = "the opening", watch = "“I want to book a room” works; “I'd like to” sounds friendlier."), PracticeQuestion(prompt = "Say the dates: Friday to Sunday.", expected = listOf("From Friday to Sunday — two nights."), focus = "dates", watch = "Say the number of nights so the price is clear."), PracticeQuestion(prompt = "Ask the price per night.", expected = listOf("How much is it per night?"), focus = "per night", watch = "“for a night” also works; per night is the standard."), PracticeQuestion(prompt = "Ask if breakfast comes with the room.", expected = listOf("Does it include breakfast?", "Is breakfast included?"), focus = "what's included", watch = "Both forms are common — pick one and keep it."), PracticeQuestion(prompt = "Ask about Wi-Fi in the rooms.", expected = listOf("Is there Wi-Fi in the rooms?"), focus = "the extras", watch = "Wi-Fi is uncountable: Is there, not Are there."), PracticeQuestion(prompt = "Make a special request: a quiet room.", expected = listOf("Would it be possible to have a quiet room?"), focus = "special requests", watch = "Would it be possible beats “give me a quiet room”."))), exercises = listOf(Exercise(id = "en-foundations-stay-accommodation-e1", kind = "choice", prompt = "I'd like ___ book a twin room.", options = listOf("to", "for", "that", "book"), answers = listOf("to"), explain = "I'd like to + verb: I'd like to book."), Exercise(id = "en-foundations-stay-accommodation-e2", kind = "gap", prompt = "How much is it ___ night?", options = listOf(), answers = listOf("per", "for"), explain = "per night / for a night — price units."), Exercise(id = "en-foundations-stay-accommodation-e3", kind = "order", prompt = "Ask about breakfast.", options = listOf(), answers = listOf("Does it include breakfast"), explain = "Does + it + include."), Exercise(id = "en-foundations-stay-accommodation-e4", kind = "written", prompt = "Make the special request politely: a room on a high floor.", options = listOf(), answers = listOf("would it be possible to have a room on a high floor", "could i have a room on a high floor please"), explain = "Would it be possible to have…?")), skills = listOf("vocab:travel", "function:solve-problems", "grammar:quantities", "vocab:social-expressions"), canDo = listOf("solve-everyday-problems", "use-transport"), prerequisites = listOf("grammar:quantities")),
    Lesson(id = "en-foundations-stay-messages", title = "Sending messages", goal = "Write short informal messages: plans, apologies and quick questions.", intro = LessonIntro(explanation = listOf("Messages drop the formal bits: “Running late — 10 mins!” No “Dear”, no full sentences every time. But clarity stays: who, what, when.", "Useful message chunks: “On my way!” “Are we still on for…?” “Can we move it to…?” “Sorry, something came up.”", "Emoji-free writing still matters: punctuation carries tone. “Fine.” sounds angry; “Fine :)” sounds fine."), examples = listOf(ExampleLine(text = "On my way! 5 mins.", meaning = "The classic delay message."), ExampleLine(text = "Are we still on for Saturday?", meaning = "Confirm a plan."), ExampleLine(text = "Can we move dinner to 9?", meaning = "Change of plan."), ExampleLine(text = "Sorry, something came up at work.", meaning = "The polite cancellation."), ExampleLine(text = "Let me know when you're free.", meaning = "Open-ended plan."), ExampleLine(text = "Got it, thanks!", meaning = "Close the thread."))), expressions = listOf(TargetExpression(text = "On my way!", meaning = "You have left.", note = "Short for I'm on my way."), TargetExpression(text = "Are we still on for …?", meaning = "Confirm the plan.", note = "on for + day/time."), TargetExpression(text = "Can we move it to …?", meaning = "Propose a new time.", note = "move it to + time."), TargetExpression(text = "Something came up.", meaning = "Something happened.", note = "The universal excuse."), TargetExpression(text = "Let me know when …", meaning = "Leave the ball with them.", note = "…you're free / you arrive."), TargetExpression(text = "Got it, thanks!", meaning = "Acknowledge and close.", note = "got it = understood.")), situation = "A dinner with friends is in chaos: confirm who's coming, move the time, apologise for a late change and close the chat kindly.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "You left home. Send the classic message.", expected = listOf("On my way!", "I'm on my way!"), focus = "on my way", watch = "“I'm arriving” sounds like a flight announcement — “On my way!” is the chunk."), PracticeQuestion(prompt = "Check if Saturday dinner is still happening.", expected = listOf("Are we still on for Saturday?"), focus = "still on", watch = "“Are we still …?” + on for + the plan."), PracticeQuestion(prompt = "Propose moving dinner to nine.", expected = listOf("Can we move dinner to 9?", "Can we move it to nine?"), focus = "moving plans", watch = "move it to + time — not “move it at nine”."), PracticeQuestion(prompt = "Cancel politely: work happened.", expected = listOf("Sorry, something came up at work.", "Sorry — something came up."), focus = "polite cancellation", watch = "something came up explains without details."), PracticeQuestion(prompt = "Leave the decision to your friend.", expected = listOf("Let me know when you're free."), focus = "open-ended", watch = "let me know + when + present: when you're free."), PracticeQuestion(prompt = "Close the conversation after the plan is set.", expected = listOf("Got it, thanks!", "Perfect, see you then!"), focus = "closing", watch = "Every message thread needs a friendly full stop."))), exercises = listOf(Exercise(id = "en-foundations-stay-messages-e1", kind = "choice", prompt = "___ we still on for tonight?", options = listOf("Are", "Is", "Do", "Will"), answers = listOf("Are"), explain = "we + are: Are we still on for…?"), Exercise(id = "en-foundations-stay-messages-e2", kind = "gap", prompt = "Sorry, something ___ ___ at work. (happened, 2 words)", options = listOf(), answers = listOf("came up"), explain = "something came up = surgió algo."), Exercise(id = "en-foundations-stay-messages-e3", kind = "order", prompt = "Propose a new time. (dinner / can / move / we / to nine)", options = listOf(), answers = listOf("Can we move dinner to nine"), explain = "Can we move + plan + to + time."), Exercise(id = "en-foundations-stay-messages-e4", kind = "written", prompt = "Close the thread after agreeing on a plan.", options = listOf(), answers = listOf("got it thanks", "perfect see you then", "great see you then"), explain = "Any friendly closing works.")), skills = listOf("writing:message", "vocab:social-expressions", "grammar:present-continuous", "function:make-suggestions"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:present-continuous"))))
}

object EnFoundationsHealth {
    val unit = CourseUnit(id = "en-foundations-health", title = "Health & habits", subtitle = "Feeling your best", level = "A2", themes = listOf(ConversationTheme("doctor-visit", "At the doctor's", "Describe the pain", "stethoscope", "Course", "You don't feel well and describe your symptoms to a doctor who asks precise questions.", 0),
                ConversationTheme("habit-reset", "The habit reset", "Advice for better weeks", "figure.run", "Course", "You and a friend compare tired weeks and give each other friendly advice with should.", 1)), lessons = listOf(    Lesson(id = "en-foundations-health-symptoms", title = "Describing symptoms", goal = "Explain what hurts and for how long at the doctor's.", intro = LessonIntro(explanation = listOf("Symptoms use have got: “I've got a headache / a sore throat / a temperature.” Pain uses hurt: “My back hurts.”", "Duration with for + present perfect: “I've had this cold for three days.” The doctor asks: “How long have you had it?”", "Severity helps the doctor: “It's a sharp pain.” “It's worse when I move.”"), examples = listOf(ExampleLine(text = "I've got a headache and a temperature.", meaning = "Two symptoms."), ExampleLine(text = "My back hurts when I move.", meaning = "Pain + trigger."), ExampleLine(text = "I've had this cold for three days.", meaning = "Duration with for."), ExampleLine(text = "How long have you had it?", meaning = "The doctor's question."), ExampleLine(text = "It's worse in the morning.", meaning = "When it hurts more."), ExampleLine(text = "I feel dizzy when I stand up.", meaning = "Another symptom."), ExampleLine(text = "I have a pain in my lower back.", meaning = "a pain in + body part."))), expressions = listOf(TargetExpression(text = "I've got a headache / a cold", meaning = "have got + illness.", note = "a + illness: a cold."), TargetExpression(text = "My … hurts", meaning = "Point at the pain.", note = "My throat hurts."), TargetExpression(text = "I've had … for + time", meaning = "Say how long.", note = "for three days."), TargetExpression(text = "How long have you had it?", meaning = "Answer: for + time.", note = "The standard question."), TargetExpression(text = "It's worse when …", meaning = "When it hurts more.", note = "…when I breathe."), TargetExpression(text = "I feel dizzy / sick", meaning = "Other feelings.", note = "dizzy = mareado.")), situation = "At the doctor's: describe three symptoms, say how long you've had them, and answer the doctor's follow-up questions precisely.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Say your main symptom: a sore throat.", expected = listOf("I've got a sore throat."), focus = "have got", watch = "a sore throat — the article matters."), PracticeQuestion(prompt = "Say your back hurts at night.", expected = listOf("My back hurts at night."), focus = "hurt", watch = "hurts for one body part: my back hurts."), PracticeQuestion(prompt = "Say you've had the cold for a week.", expected = listOf("I've had this cold for a week."), focus = "for + time", watch = "“I have this cold since Monday” — use have had + for."), PracticeQuestion(prompt = "Answer the doctor: three days.", expected = listOf("For three days.", "I've had it for three days."), focus = "duration", watch = "for + period: for three days."), PracticeQuestion(prompt = "Say your temperature is high.", expected = listOf("I've got a temperature.", "I have a temperature."), focus = "temperature", watch = "a temperature — con artículo, siempre."))), exercises = listOf(Exercise(id = "en-foundations-health-symptoms-e1", kind = "choice", prompt = "I've ___ a headache since Monday.", options = listOf("had", "have", "got has", "having"), answers = listOf("had"), explain = "have got / have had for symptoms."), Exercise(id = "en-foundations-health-symptoms-e2", kind = "gap", prompt = "My ___ ___ when I walk. (pain in the foot)", options = listOf(), answers = listOf("foot hurts", "feet hurt"), explain = "body part + hurts."), Exercise(id = "en-foundations-health-symptoms-e3", kind = "order", prompt = "Ask the patient about duration.", options = listOf(), answers = listOf("How long have you had it"), explain = "How long + have + you + had."), Exercise(id = "en-foundations-health-symptoms-e4", kind = "written", prompt = "Diga cuánto tiempo lleva con el síntoma.", options = listOf(), answers = listOf("i've had it for two weeks", "for two weeks", "two weeks"), explain = "for + period.")), skills = listOf("vocab:health", "grammar:have-got", "grammar:present-perfect", "function:talk-about-health"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-perfect")),
    Lesson(id = "en-foundations-health-advice", title = "Friendly advice", goal = "Give and respond to advice about health and habits with should.", intro = LessonIntro(explanation = listOf("Advice with should: “You should sleep more.” “You shouldn't check your phone in bed.” Never should to.", "Soften advice with maybe and try: “Maybe you should try going to bed earlier.” try + -ing for experiments.", "Accept or decline: “You're right, I'll try.” “I know, I know… it's hard!” Advice between friends is a dance."), examples = listOf(ExampleLine(text = "You should sleep more.", meaning = "The basic advice."), ExampleLine(text = "You shouldn't drink coffee at night.", meaning = "Advice against."), ExampleLine(text = "Maybe you should try walking home.", meaning = "Softer advice."), ExampleLine(text = "You're right, I'll try.", meaning = "Accepting."), ExampleLine(text = "I know, I know… it's hard!", meaning = "Declining honestly."), ExampleLine(text = "Drink some water and see.", meaning = "Simple instructions."), ExampleLine(text = "You should see a doctor if it lasts a week.", meaning = "Advice with a limit."))), expressions = listOf(TargetExpression(text = "You should + verb", meaning = "Friendly advice.", note = "You should rest."), TargetExpression(text = "You shouldn't + verb", meaning = "Advice against.", note = "You shouldn't skip breakfast."), TargetExpression(text = "Maybe you should try + -ing", meaning = "Softer advice.", note = "…try going to bed earlier."), TargetExpression(text = "You're right.", meaning = "Accept advice.", note = "Then: I'll try."), TargetExpression(text = "I'll try.", meaning = "Promise an attempt.", note = "try, not try to definitely."), TargetExpression(text = "See if it helps.", meaning = "Close the advice.", note = "see if + clause.")), situation = "A friend has been tired for weeks: hear the symptoms, give three pieces of advice with should and one with try + -ing, and agree on a first step.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Give advice about screens at night. (shouldn't)", expected = listOf("You shouldn't use screens at night."), focus = "shouldn't", watch = "shouldn't + base verb: no to."), PracticeQuestion(prompt = "Give softer advice: walking after lunch. (try)", expected = listOf("Maybe you should try walking after lunch."), focus = "try + -ing", watch = "try + -ing for the experiment."), PracticeQuestion(prompt = "Accept the advice.", expected = listOf("You're right, I'll try."), focus = "accepting", watch = "I'll try — promise an attempt."), PracticeQuestion(prompt = "Close the advice with a check.", expected = listOf("See if it helps."), focus = "closing", watch = "see if it helps = a ver si funciona."), PracticeQuestion(prompt = "Advise seeing a doctor if the pain continues.", expected = listOf("You should see a doctor if the pain continues.", "You should see a doctor."), focus = "see a doctor", watch = "see a doctor = visitar al médico; watch no."))), exercises = listOf(Exercise(id = "en-foundations-health-advice-e1", kind = "choice", prompt = "You look tired. You ___ go to bed early.", options = listOf("should", "should to", "are should", "will should"), answers = listOf("should"), explain = "should + base verb."), Exercise(id = "en-foundations-health-advice-e2", kind = "gap", prompt = "Maybe you should try ___ before ten. (sleep)", options = listOf(), answers = listOf("sleeping", "to sleep"), explain = "try + -ing for the experiment."), Exercise(id = "en-foundations-health-advice-e3", kind = "order", prompt = "Advise against coffee at night.", options = listOf(), answers = listOf("You shouldn't drink coffee at night"), explain = "shouldn't + base verb."), Exercise(id = "en-foundations-health-advice-e4", kind = "written", prompt = "Accept advice and promise an attempt.", options = listOf(), answers = listOf("you're right i'll try", "youre right i will try"), explain = "You're right, I'll try.")), skills = listOf("grammar:modal-should", "grammar:gerunds-infinitives", "vocab:health", "function:talk-about-health"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:modal-should")),
    Lesson(id = "en-foundations-health-habits", title = "Habits: then and now", goal = "Compare old and new habits with used to and now, and say what changed.", intro = LessonIntro(explanation = listOf("Old habits with used to: “I used to sleep eight hours.” New ones with now + present: “Now I sleep five.” The contrast tells the story.", "Frequency still works: “I hardly ever exercise now.” hardly ever = almost never — softer than never.", "Be honest about difficulty: “It's harder than I thought.” than + the comparison."), examples = listOf(ExampleLine(text = "I used to sleep eight hours.", meaning = "The old habit."), ExampleLine(text = "Now I sleep five.", meaning = "The present reality."), ExampleLine(text = "I hardly ever exercise now.", meaning = "almost never."), ExampleLine(text = "It's harder than I thought.", meaning = "than + comparison."), ExampleLine(text = "I've started walking to work.", meaning = "A new habit: start + -ing."), ExampleLine(text = "My weekends used to be active. Now they're for the sofa.", meaning = "Contrast con humor."))), expressions = listOf(TargetExpression(text = "used to + verb", meaning = "The old you.", note = "I used to run every day."), TargetExpression(text = "now + present", meaning = "The current you.", note = "Now I barely move."), TargetExpression(text = "hardly ever", meaning = "Almost never.", note = "Softer than never."), TargetExpression(text = "… than I thought", meaning = "Reality check.", note = "harder, easier, better."), TargetExpression(text = "I've started + -ing", meaning = "A new habit.", note = "I've started cycling."), TargetExpression(text = "every other day", meaning = "Frequency phrase.", note = "Lunes, miércoles, viernes…")), situation = "You compare your student life with your working life: sleep, exercise, food — used to for the past, now for the present, and one new habit you've started.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Say an old exercise habit. (run every day)", expected = listOf("I used to run every day."), focus = "used to", watch = "used to + base verb."), PracticeQuestion(prompt = "Say the present: no time now.", expected = listOf("Now I don't have time."), focus = "now", watch = "now + present simple."), PracticeQuestion(prompt = "Say you almost never cook these days.", expected = listOf("I hardly ever cook these days."), focus = "hardly ever", watch = "hardly ever = casi nunca."), PracticeQuestion(prompt = "Say one new habit you've started. (walking to work)", expected = listOf("I've started walking to work."), focus = "start + -ing", watch = "I've started + -ing: the new habit."), PracticeQuestion(prompt = "Say your weekends used to be active.", expected = listOf("My weekends used to be active."), focus = "used to", watch = "used to + verbo base."))), exercises = listOf(Exercise(id = "en-foundations-health-habits-e1", kind = "choice", prompt = "I ___ to run every day when I was a student.", options = listOf("used", "use", "was use", "am used"), answers = listOf("used"), explain = "Past habit: used to + verb."), Exercise(id = "en-foundations-health-habits-e2", kind = "gap", prompt = "I ___ ___ ever cook these days. (casi nunca)", options = listOf(), answers = listOf("hardly ever"), explain = "hardly ever = almost never."), Exercise(id = "en-foundations-health-habits-e3", kind = "order", prompt = "Say your new habit. (started / I've / walking / to work)", options = listOf(), answers = listOf("I've started walking to work"), explain = "I've started + -ing."), Exercise(id = "en-foundations-health-habits-e4", kind = "written", prompt = "Compare: sleep eight hours before, five now.", options = listOf(), answers = listOf("i used to sleep eight hours now i sleep five"), explain = "used to … now …")), skills = listOf("grammar:used-to", "grammar:frequency-adverbs", "grammar:present-perfect", "vocab:health"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:past-simple-irregular"))))
}

object EnFoundationsExperiences {
    val unit = CourseUnit(id = "en-foundations-experiences", title = "Experiences & stories", subtitle = "Have you ever…?", level = "B1", themes = listOf(ConversationTheme("travel-bucket-list", "The bucket list", "Have you ever…?", "airplane", "Course", "You compare life experiences: places you have and haven't been, things you have and haven't tried.", 0),
                ConversationTheme("story-night", "Story night", "What was happening?", "moon.stars", "Course", "You tell a story with background: what was happening when something unexpected occurred.", 1)), lessons = listOf(    Lesson(id = "en-foundations-experiences-present-perfect", title = "Present perfect: experiences", goal = "Talk about life experiences with have/has + past participle, without saying when.", intro = LessonIntro(explanation = listOf("Experiences without a time use have/has + past participle: “I've visited Rome. She's never tried sushi. Have you been to Japan?”", "The moment you say WHEN, switch to past simple: “I've been to Rome. I went there in 2019.”", "Participates are irregular often: be → been, see → seen, go → gone/been, eat → eaten, do → done."), examples = listOf(ExampleLine(text = "I've never been to Asia.", meaning = "A life experience (not yet!)."), ExampleLine(text = "Have you ever tried paella?", meaning = "ever = in your life."), ExampleLine(text = "She's seen that film three times.", meaning = "Repeated experience."), ExampleLine(text = "We've just finished dinner.", meaning = "just = a moment ago."), ExampleLine(text = "I've already packed, but I haven't printed the tickets.", meaning = "already / not yet."), ExampleLine(text = "I went to Rome in 2019.", meaning = "WHEN given → past simple."))), expressions = listOf(TargetExpression(text = "I've (never/ever/already) …", meaning = "Experience, no date.", note = "I've never driven a van."), TargetExpression(text = "Have you ever …?", meaning = "The classic experience question.", note = "Reply: Yes, I have / No, I haven't."), TargetExpression(text = "I've just …", meaning = "Very recent.", note = "I've just arrived."), TargetExpression(text = "… twice / three times", meaning = "Count the experience.", note = "I've read it twice."), TargetExpression(text = "gone to vs been to", meaning = "gone = still there; been = visited and returned.", note = "She's gone to Rome (not back yet)."), TargetExpression(text = "When? → past simple", meaning = "The golden switch rule.", note = "I've been to Peru. I went in 2018.")), situation = "You meet a traveller at a hostel: swap life experiences with Have you ever…? and ask follow-up questions with past simple when they give a when.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ask a traveller if they have ever visited Japan.", expected = listOf("Have you ever been to Japan?", "Have you ever visited Japan?"), focus = "Have you ever…?", watch = "“Did you ever visit…?” is possible in AmE, but “Have you ever…?” is the safest form."), PracticeQuestion(prompt = "Answer negatively: you have never tried surfing.", expected = listOf("I've never tried surfing.", "I have never tried surfing."), focus = "never + participle", watch = "“I've never tried to surf” changes meaning slightly; keep “tried surfing”."), PracticeQuestion(prompt = "Say you visited Rome in 2019 (mention the year).", expected = listOf("I went to Rome in 2019."), focus = "when → past simple", watch = "“I've gone to Rome in 2019” — a finished time forbids the present perfect."), PracticeQuestion(prompt = "Your friend is not here — she went to the airport. Say it two ways.", expected = listOf("She's gone to the airport.", "She has gone to the airport."), focus = "gone to", watch = "“She's been to the airport” means she went and came back."), PracticeQuestion(prompt = "Say you have seen that film three times.", expected = listOf("I've seen that film three times.", "I have seen that film three times."), focus = "counting experiences", watch = "“I saw it three times” needs a past anchor; without one, prefer the present perfect."), PracticeQuestion(prompt = "Ask a follow-up when someone says “I've been to Iceland”.", expected = listOf("When did you go?", "What did you see there?", "How was it?"), focus = "switching to past", watch = "The follow-up asks about the trip → past simple."))), exercises = listOf(Exercise(id = "en-foundations-experiences-present-perfect-e1", kind = "choice", prompt = "___ you ever eaten octopus?", options = listOf("Have", "Did", "Are", "Do"), answers = listOf("Have"), explain = "Experience question: Have you ever…?"), Exercise(id = "en-foundations-experiences-present-perfect-e2", kind = "gap", prompt = "She's ___ (see) that exhibition twice.", options = listOf(), answers = listOf("seen"), explain = "see → seen with have/has."), Exercise(id = "en-foundations-experiences-present-perfect-e3", kind = "order", prompt = "Say it is very recent.", options = listOf(), answers = listOf("I've just arrived"), explain = "have + just + participle."), Exercise(id = "en-foundations-experiences-present-perfect-e4", kind = "written", prompt = "Fix: “I've visited Peru in 2018.”", options = listOf(), answers = listOf("i visited peru in 2018"), explain = "With a finished time (in 2018), use past simple.")), skills = listOf("grammar:present-perfect", "grammar:past-simple-irregular", "function:describe-past-events", "listening:inference"), canDo = listOf("describe-past-events"), prerequisites = listOf("grammar:past-simple-regular", "grammar:object-pronouns")),
    Lesson(id = "en-foundations-experiences-past-continuous", title = "Past continuous: background", goal = "Set the scene of a past story with was/were + -ing, and interrupt it with past simple.", intro = LessonIntro(explanation = listOf("Background actions use was/were + -ing: “It was raining. People were running. I was cooking.”", "The classic structure: past continuous (background) + when/until + past simple (event): “I was cooking when the lights went out.”", "Two parallel background actions use while: “While she was sleeping, he was reading.”"), examples = listOf(ExampleLine(text = "The sun was setting and the birds were singing.", meaning = "Scene painting."), ExampleLine(text = "I was cooking when the phone rang.", meaning = "Background + interruption."), ExampleLine(text = "They were waiting for the bus when it started to rain.", meaning = "Longer action + event."), ExampleLine(text = "While we were driving, it snowed.", meaning = "while + two past tenses."), ExampleLine(text = "What were you doing at midnight?", meaning = "Question about a past moment."), ExampleLine(text = "I wasn't listening, sorry.", meaning = "Negative background."))), expressions = listOf(TargetExpression(text = "was/were + -ing", meaning = "The background of the story.", note = "It was getting dark."), TargetExpression(text = "… when + past simple", meaning = "The event that interrupts.", note = "…when he appeared."), TargetExpression(text = "while + was/were -ing", meaning = "Two things at once.", note = "While I was waiting, I read."), TargetExpression(text = "What were you doing…?", meaning = "Ask about a past moment.", note = "…at eight last night?"), TargetExpression(text = "Suddenly, …", meaning = "Move from background to event.", note = "Suddenly, the door opened."), TargetExpression(text = "It was a normal evening when…", meaning = "The classic story opener.", note = "…everything changed.")), situation = "You and a friend swap short stories: set the scene with past continuous, then deliver the surprise event with past simple.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Set the scene: the rain / fall, and people / run for shelter.", expected = listOf("The rain was falling and people were running for shelter."), focus = "was/were + -ing", watch = "“The rain fell” is an event — the background is “was falling”."), PracticeQuestion(prompt = "Add the interruption: you were cooking / lights went out.", expected = listOf("I was cooking when the lights went out."), focus = "when + past simple", watch = "The short event takes past simple: “went out”, not “was going out”."), PracticeQuestion(prompt = "Ask what your friend was doing at ten last night.", expected = listOf("What were you doing at ten last night?"), focus = "were + -ing question", watch = "“What did you do at ten?” asks for an answer list; “were doing” asks about the moment."), PracticeQuestion(prompt = "Say two parallel actions: you drove / your partner read the map.", expected = listOf("While I was driving, my partner was reading the map."), focus = "while + continuous", watch = "Both long actions take the continuous after while."), PracticeQuestion(prompt = "Open a story: normal evening / everything changed.", expected = listOf("It was a normal evening when everything changed."), focus = "story opener", watch = "Background first (was), event second (changed)."), PracticeQuestion(prompt = "Negative background: you weren't listening when she told you.", expected = listOf("I wasn't listening when she told me."), focus = "wasn't + -ing", watch = "“I didn't listening” — negatives of the continuous use wasn't/weren't."))), exercises = listOf(Exercise(id = "en-foundations-experiences-past-continuous-e1", kind = "choice", prompt = "I ___ dinner when the doorbell rang.", options = listOf("was cooking", "cooked", "am cooking", "have cooked"), answers = listOf("was cooking"), explain = "Background action: was + -ing."), Exercise(id = "en-foundations-experiences-past-continuous-e2", kind = "gap", prompt = "While they ___ ___ (wait), the bus arrived.", options = listOf(), answers = listOf("were waiting"), explain = "Plural background: were + -ing."), Exercise(id = "en-foundations-experiences-past-continuous-e3", kind = "order", prompt = "Ask about a past moment. (you / at midnight / what / were / doing)", options = listOf(), answers = listOf("What were you doing at midnight"), explain = "Question word + were + you + -ing."), Exercise(id = "en-foundations-experiences-past-continuous-e4", kind = "written", prompt = "Fix: “While I cooked, she was watching TV.”", options = listOf(), answers = listOf("while i was cooking she was watching tv"), explain = "Both parallel long actions take the continuous: was cooking.")), skills = listOf("grammar:past-continuous", "grammar:past-simple-regular", "function:tell-a-story", "speaking:tell-past-story"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-was-were", "grammar:present-continuous")),
    Lesson(id = "en-foundations-experiences-used-to", title = "Used to: past habits", goal = "Compare the past with now using used to / didn't use to.", intro = LessonIntro(explanation = listOf("Past habits that stopped use used to + verb: “I used to play outside every day. She used to live in Berlin.”", "Negative: didn't use to: “We didn't use to have a car.” Question: “Did you use to…?” Note: no -d in the negative/question.", "For states still true, prefer present simple; for single past events, past simple. used to is for repeated past routines that ended."), examples = listOf(ExampleLine(text = "I used to hate coffee. Now I love it.", meaning = "Past habit, changed."), ExampleLine(text = "There used to be a cinema here.", meaning = "Past state that ended."), ExampleLine(text = "We didn't use to lock the door.", meaning = "Past absence of a habit."), ExampleLine(text = "Did people use to write letters?", meaning = "Question form."), ExampleLine(text = "He didn't use to cook — now he's a chef!", meaning = "Big change."), ExampleLine(text = "I used to walk to school.", meaning = "Routine when you were young."))), expressions = listOf(TargetExpression(text = "used to + verb", meaning = "A past habit that stopped.", note = "I used to smoke."), TargetExpression(text = "didn't use to + verb", meaning = "Something you didn't do before.", note = "No -d after use here."), TargetExpression(text = "Did you use to …?", meaning = "Ask about old habits.", note = "Did you use to play an instrument?"), TargetExpression(text = "… but now …", meaning = "The contrast sentence.", note = "I used to walk, but now I cycle."), TargetExpression(text = "There used to be …", meaning = "Past places and things.", note = "There used to be a lake here."), TargetExpression(text = "be used to + -ing", meaning = "Different! = estar acostumbrado a.", note = "I'm used to getting up early.")), situation = "You look at old photos with a friend: compare childhood habits with life now using used to, didn't use to and but now.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Say one childhood habit you have stopped.", expected = listOf("I used to <habit>."), focus = "used to", watch = "“I used to played” — used to + base verb."), PracticeQuestion(prompt = "Say something about your town that no longer exists. (There used to…)", expected = listOf("There used to be <place>.", "There used to be a market here."), focus = "There used to be", watch = "“There used to have” is wrong — use be for places/things."), PracticeQuestion(prompt = "Say you didn't like vegetables before.", expected = listOf("I didn't use to like vegetables.", "I used to not like vegetables."), focus = "didn't use to", watch = "Careful spelling: didn't use to (no -d)."), PracticeQuestion(prompt = "Ask a friend about an old habit. (instrument / sport)", expected = listOf("Did you use to play an instrument?", "Did you use to do any sport?"), focus = "Did you use to…?", watch = "“Did you used to…?” — in questions, use to loses the -d."), PracticeQuestion(prompt = "Contrast: past walk to school, now cycle.", expected = listOf("I used to walk to school, but now I cycle."), focus = "but now", watch = "The contrast word now makes the change explicit."), PracticeQuestion(prompt = "Say you are accustomed to early mornings. (be used to)", expected = listOf("I'm used to getting up early."), focus = "be used to + -ing", watch = "Different structure: be used to + -ing = estar acostumbrado."))), exercises = listOf(Exercise(id = "en-foundations-experiences-used-to-e1", kind = "choice", prompt = "She ___ live in Berlin when she was young.", options = listOf("used to", "use to", "was used to", "would been"), answers = listOf("used to"), explain = "Past habit: used to + verb."), Exercise(id = "en-foundations-experiences-used-to-e2", kind = "gap", prompt = "We ___ ___ ___ have a car. (negative, 3 words)", options = listOf(), answers = listOf("didn't use to", "did not use to"), explain = "didn't use to — no -d."), Exercise(id = "en-foundations-experiences-used-to-e3", kind = "order", prompt = "Ask about old habits. (you / use / play / did / to / an instrument)", options = listOf(), answers = listOf("Did you use to play an instrument"), explain = "Did + you + use to + base verb."), Exercise(id = "en-foundations-experiences-used-to-e4", kind = "written", prompt = "Fix: “I'm used to get up early.”", options = listOf(), answers = listOf("i'm used to getting up early", "i am used to getting up early"), explain = "be used to + -ing: getting.")), skills = listOf("grammar:used-to", "grammar:past-simple-irregular", "function:tell-a-story", "vocab:daily-routine"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-irregular")),
    Lesson(id = "en-foundations-experiences-story-writing", title = "Writing your story", goal = "Turn an experience into a short written story with a beginning, a turn and an ending.", intro = LessonIntro(explanation = listOf("Written stories breathe: short sentences for tension, long ones for scenery. Start in the middle: “The lock wouldn't turn.”", "Spine: opening moment → the turn (when/until/suddenly) → the ending feeling. Three paragraphs, 80-120 words.", "Show, don't label: not “it was a bad day” but “my keys, my phone and my umbrella were all on the kitchen table — together, at home, where I wasn't.”"), examples = listOf(ExampleLine(text = "The lock wouldn't turn.", meaning = "Open in the middle of the trouble."), ExampleLine(text = "It started fine: sun, coffee, an early train.", meaning = "A calm before."), ExampleLine(text = "Until the announcement, everything was normal.", meaning = "until signals the turn."), ExampleLine(text = "Suddenly, the platform emptied.", meaning = "sudden movement, short sentence."), ExampleLine(text = "By the time I got home, I'd laughed about it twice.", meaning = "Ending with distance."), ExampleLine(text = "Some days you're the tourist, even in your own city.", meaning = "A closing thought."))), expressions = listOf(TargetExpression(text = "Open in the middle", meaning = "First line = trouble or action.", note = "Skip the weather report."), TargetExpression(text = "until / when + the turn", meaning = "Move the plot.", note = "Until the doors closed…"), TargetExpression(text = "Suddenly, + short sentence", meaning = "Pace change.", note = "Short = tense."), TargetExpression(text = "By the time …, …", meaning = "Close with distance.", note = "By the time + past, past perfect feels natural."), TargetExpression(text = "a closing thought", meaning = "One reflective line.", note = "Some days you win, some days you learn."), TargetExpression(text = "80-120 words", meaning = "The short-story sweet spot.", note = "Every sentence earns its place.")), situation = "You write a 100-word story for the class blog: a travel day that went wrong — opening in the middle, one turn, one closing thought.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Open your story in the middle of the trouble. (the lock)", expected = listOf("The lock wouldn't turn."), focus = "the opening", watch = "“Last summer I travelled…” is a report, not a story."), PracticeQuestion(prompt = "Set the calm before: sun, coffee, an early train.", expected = listOf("It started fine: sun, coffee, an early train."), focus = "the calm", watch = "A calm first line makes the turn hit harder."), PracticeQuestion(prompt = "Signal the turn: the announcement changed everything. (until)", expected = listOf("Until the announcement, everything was normal."), focus = "until", watch = "until + noun/clause marks the exact turn."), PracticeQuestion(prompt = "Add pace: the platform emptied suddenly. (short sentence)", expected = listOf("Suddenly, the platform emptied."), focus = "suddenly", watch = "One-word openers (Suddenly, Luckily) control pace."), PracticeQuestion(prompt = "Close with distance and humour.", expected = listOf("By the time I got home, I'd laughed about it twice."), focus = "the ending", watch = "Distance turns disaster into story."), PracticeQuestion(prompt = "Add a one-line reflection to close.", expected = listOf("Some days you're the tourist, even in your own city."), focus = "the thought", watch = "One line, not a moral lecture."))), exercises = listOf(Exercise(id = "en-foundations-experiences-story-writing-e1", kind = "choice", prompt = "Which opening starts IN the trouble?", options = listOf("The lock wouldn't turn.", "Last summer I travelled a lot.", "It was a sunny day in June.", "I want to tell you about trains."), answers = listOf("The lock wouldn't turn."), explain = "In medias res: start inside the problem."), Exercise(id = "en-foundations-experiences-story-writing-e2", kind = "gap", prompt = "___ the doors closed, we realised the mistake.", options = listOf(), answers = listOf("when", "until"), explain = "when/until mark the turn."), Exercise(id = "en-foundations-experiences-story-writing-e3", kind = "order", prompt = "Add pace to the escape.", options = listOf(), answers = listOf("Suddenly the platform emptied"), explain = "Suddenly + short clause."), Exercise(id = "en-foundations-experiences-story-writing-e4", kind = "written", prompt = "Write a one-line closing thought for a travel disaster story.", options = listOf(), answers = listOf("some days you're the tourist even in your own city", "some days you win some days you learn", "at least i have a story now"), explain = "Reflective, light, one line.")), skills = listOf("writing:story", "grammar:connectors", "grammar:past-continuous", "function:tell-a-story", "speaking:tell-past-story"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-continuous"))))
}

object EnFoundationsConnections {
    val unit = CourseUnit(id = "en-foundations-connections", title = "Opinions & connections", subtitle = "If, which, however", level = "B1", themes = listOf(ConversationTheme("plan-b", "Plan B", "If it rains…", "cloud.bolt", "Course", "Your outdoor plan is at risk. Negotiate conditionals: if this happens, we'll do that.", 0),
                ConversationTheme("movie-debate", "The film debate", "Which one? However…", "film", "Course", "You review a film together: describe scenes with relative clauses and connect opinions with however and although.", 1)), lessons = listOf(    Lesson(id = "en-foundations-connections-first-conditional", title = "First conditional", goal = "Talk about real future possibilities with if + present, will + verb.", intro = LessonIntro(explanation = listOf("Real future conditions: “If it rains, we'll stay in.” The if-clause uses present simple; the result uses will.", "Order can flip, but the comma disappears: “We'll stay in if it rains.” Never will inside the if-clause.", "Variations: “If it rains, we might stay in / we can stay in / let's stay in.”"), examples = listOf(ExampleLine(text = "If it rains, we'll stay home.", meaning = "The basic pattern."), ExampleLine(text = "We'll be late if the bus doesn't come.", meaning = "Result first, no comma."), ExampleLine(text = "If you help me, I'll help you.", meaning = "An exchange."), ExampleLine(text = "If they don't hurry, they'll miss the train.", meaning = "Negative in the if-clause."), ExampleLine(text = "If I see him, I might tell him.", meaning = "might = less certain."), ExampleLine(text = "What will you do if it snows?", meaning = "The question form."))), expressions = listOf(TargetExpression(text = "If + present, will + verb", meaning = "Real future possibility.", note = "If it rains, we'll stay in."), TargetExpression(text = "… if + present", meaning = "Result first, no comma.", note = "I'll call you if I'm late."), TargetExpression(text = "If not, … / Otherwise, …", meaning = "The other branch.", note = "Otherwise we'll drive."), TargetExpression(text = "might / can + verb", meaning = "Softer results.", note = "If it's cheap, we might buy it."), TargetExpression(text = "What will happen if …?", meaning = "Ask about consequences.", note = "…if the flight is cancelled?"), TargetExpression(text = "as long as / unless", meaning = "Condition cousins.", note = "unless = if not.")), situation = "You plan an outdoor birthday with a friend: set conditions for every possible problem (rain, no bus, cold) and what you'll do in each case.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "It may rain. Say what you will do. (stay in)", expected = listOf("If it rains, we'll stay in.", "If it rains, I'll stay in."), focus = "if + present, will", watch = "“If it will rain” — never will in the if-clause."), PracticeQuestion(prompt = "The bus may not come. Predict lateness.", expected = listOf("If the bus doesn't come, we'll be late.", "We'll be late if the bus doesn't come."), focus = "negative condition", watch = "“If the bus won't come” — present simple after if."), PracticeQuestion(prompt = "Offer an exchange of help.", expected = listOf("If you help me, I'll help you."), focus = "exchange", watch = "Both halves stay simple: present + will."), PracticeQuestion(prompt = "Ask about a cancelled flight. (what / you / do)", expected = listOf("What will you do if the flight is cancelled?"), focus = "the conditional question", watch = "will goes in the result question, not after if."), PracticeQuestion(prompt = "Soften the result: if it's cheap, maybe buy it.", expected = listOf("If it's cheap, I might buy it.", "If it's cheap, we might buy it."), focus = "might", watch = "might + base verb: “might to buy” is wrong."), PracticeQuestion(prompt = "Say the alternative: no picnic → restaurant.", expected = listOf("If we can't have a picnic, we'll go to a restaurant.", "Otherwise, we'll go to a restaurant."), focus = "otherwise", watch = "Otherwise connects to the previous sentence's failure."))), exercises = listOf(Exercise(id = "en-foundations-connections-first-conditional-e1", kind = "choice", prompt = "If it ___ tomorrow, we'll cancel the trip.", options = listOf("rains", "will rain", "rained", "is going to rain"), answers = listOf("rains"), explain = "The if-clause takes present simple."), Exercise(id = "en-foundations-connections-first-conditional-e2", kind = "gap", prompt = "I'll call you if I ___ late. (be)", options = listOf(), answers = listOf("am", "'m"), explain = "Present simple after if: if I am late."), Exercise(id = "en-foundations-connections-first-conditional-e3", kind = "order", prompt = "Ask about a snow plan.", options = listOf(), answers = listOf("What will you do if it snows"), explain = "Question word + will + you + do + if + present."), Exercise(id = "en-foundations-connections-first-conditional-e4", kind = "written", prompt = "Fix: “If it will rain, we stay in.”", options = listOf(), answers = listOf("if it rains we'll stay in", "if it rains we will stay in"), explain = "Present after if, will in the result.")), skills = listOf("grammar:first-conditional", "grammar:future-forms", "function:make-future-plans", "function:solve-problems"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:present-simple", "grammar:going-to")),
    Lesson(id = "en-foundations-connections-relative-clauses", title = "Relative clauses", goal = "Join ideas with who, which, that and where.", intro = LessonIntro(explanation = listOf("who joins people, which joins things, that joins both (informal): “The woman who lives upstairs is a doctor.” “The book which won the prize…”", "where joins places: “That's the café where we met.”", "Shortened clauses: “The man standing there” (= who is standing). No double subject: “the book which won” not “the book which it won”."), examples = listOf(ExampleLine(text = "The woman who lives upstairs is a doctor.", meaning = "who + person."), ExampleLine(text = "It's a film which changed cinema.", meaning = "which + thing."), ExampleLine(text = "The song that she wrote became famous.", meaning = "that for people too (informal)."), ExampleLine(text = "That's the café where we first met.", meaning = "where + place."), ExampleLine(text = "The train (that) we caught was late.", meaning = "that can disappear as object."), ExampleLine(text = "The guy standing by the door is my cousin.", meaning = "Shortened: who is standing."))), expressions = listOf(TargetExpression(text = "the person who …", meaning = "Identify people.", note = "The person who called left a message."), TargetExpression(text = "the thing which/that …", meaning = "Identify things.", note = "The app which tracks habits."), TargetExpression(text = "the place where …", meaning = "Identify places.", note = "the street where I grew up."), TargetExpression(text = "(that) … as object", meaning = "The joining word can vanish.", note = "the film (that) we saw."), TargetExpression(text = "…, which …", meaning = "Comment on the whole sentence.", note = "He was late, which annoyed everyone."), TargetExpression(text = "all / something + that", meaning = "Fixed pairs.", note = "All that matters is…")), situation = "You describe your neighbourhood to a visitor: the people who live there, the shops which are worth it and the corner where everything happens.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Describe your best friend. (person who…)", expected = listOf("My best friend is the person who knows me best.", "She's someone who always listens."), focus = "who", watch = "People take who (or that), never which."), PracticeQuestion(prompt = "Describe an app you like. (app which…)", expected = listOf("It's an app which helps me study.", "It's an app that tracks my habits."), focus = "which/that", watch = "Things take which or that — both are fine here."), PracticeQuestion(prompt = "Talk about the place you grew up. (where)", expected = listOf("The town where I grew up is small.", "I grew up in a village where everyone knew everyone."), focus = "where", watch = "where replaces “in which”: “the town where I grew up”."), PracticeQuestion(prompt = "Join: “The train was late. We caught it.”", expected = listOf("The train (that) we caught was late."), focus = "dropping that", watch = "When the joiner is the object, that can disappear."), PracticeQuestion(prompt = "Comment on a whole fact: “He resigned, … surprised everyone.”", expected = listOf("He resigned, which surprised everyone."), focus = ", which", watch = "Comma + which comments on the whole idea — never “, what surprised”."), PracticeQuestion(prompt = "Fix: “The book which it won the prize is long.”", expected = listOf("the book which won the prize is long"), focus = "no double subject", watch = "which replaces it — never both."))), exercises = listOf(Exercise(id = "en-foundations-connections-relative-clauses-e1", kind = "choice", prompt = "The woman ___ lives upstairs is a doctor.", options = listOf("who", "which", "where", "what"), answers = listOf("who"), explain = "People take who."), Exercise(id = "en-foundations-connections-relative-clauses-e2", kind = "gap", prompt = "That's the café ___ we first met.", options = listOf(), answers = listOf("where"), explain = "Places take where."), Exercise(id = "en-foundations-connections-relative-clauses-e3", kind = "order", prompt = "Identify the film.", options = listOf(), answers = listOf("It's a film which changed cinema"), explain = "which/that + verb."), Exercise(id = "en-foundations-connections-relative-clauses-e4", kind = "written", prompt = "Join: “He resigned. It annoyed everyone.” (use which)", options = listOf(), answers = listOf("he resigned which annoyed everyone"), explain = "He resigned, which annoyed everyone.")), skills = listOf("grammar:relative-clauses", "grammar:object-pronouns", "function:describe-people", "vocab:town"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:object-pronouns")),
    Lesson(id = "en-foundations-connections-connectors", title = "Connectors: although, however, so", goal = "Link ideas with contrast (although, however) and result (so, because).", intro = LessonIntro(explanation = listOf("Contrast: although + clause (“Although it was late, we went out”) and however + comma (“It was late. However, we went out.”).", "Result: so joins cause → effect (“It was late, so we took a taxi”). Reason: because joins effect → cause (“We took a taxi because it was late”).", "Punctuation: however needs a full stop or semicolon before it; although and because live inside the clause."), examples = listOf(ExampleLine(text = "Although it was expensive, we bought it.", meaning = "Contrast first."), ExampleLine(text = "We bought it. However, we regret it now.", meaning = "However starts a new sentence."), ExampleLine(text = "It was raining, so we stayed in.", meaning = "Cause → result."), ExampleLine(text = "We stayed in because it was raining.", meaning = "Result → reason."), ExampleLine(text = "The film was long; nevertheless, we enjoyed it.", meaning = "A formal contrast."), ExampleLine(text = "Therefore, the plan changed.", meaning = "Formal result."))), expressions = listOf(TargetExpression(text = "Although + clause, …", meaning = "Contrast inside one sentence.", note = "Although he's young, he leads the team."), TargetExpression(text = "… . However, …", meaning = "Contrast between sentences.", note = "It works. However, it's slow."), TargetExpression(text = "… , so + result", meaning = "Cause then result.", note = "It was full, so we left."), TargetExpression(text = "… because + reason", meaning = "Result then reason.", note = "I left because it was full."), TargetExpression(text = "Even though", meaning = "Stronger although.", note = "Even though I knew, I forgot."), TargetExpression(text = "despite + noun/-ing", meaning = "Contrast without a clause.", note = "Despite the rain, we walked.")), situation = "You and a colleague review a project: what worked, what failed, and why — connecting every point with so, because, although and however.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Contrast in one sentence: it was expensive / we bought it. (although)", expected = listOf("Although it was expensive, we bought it."), focus = "although", watch = "although + full clause with a verb, not a noun."), PracticeQuestion(prompt = "Contrast across two sentences: the plan works / it's slow. (however)", expected = listOf("The plan works. However, it's slow.", "The plan works; however, it's slow."), focus = "however", watch = "however needs a stop before it: full stop or semicolon."), PracticeQuestion(prompt = "Cause and result: the shop was full / we left. (so)", expected = listOf("The shop was full, so we left."), focus = "so", watch = "so joins cause → result with just a comma."), PracticeQuestion(prompt = "Same idea with because.", expected = listOf("We left because the shop was full."), focus = "because", watch = "because introduces the reason: result + because + reason."), PracticeQuestion(prompt = "Stronger contrast: you knew / you forgot. (even though)", expected = listOf("Even though I knew, I forgot."), focus = "even though", watch = "Same grammar as although, stronger feeling."), PracticeQuestion(prompt = "Contrast with a noun: the rain / we walked. (despite)", expected = listOf("Despite the rain, we walked.", "We walked despite the rain."), focus = "despite + noun", watch = "despite takes a noun or -ing, never a full clause."))), exercises = listOf(Exercise(id = "en-foundations-connections-connectors-e1", kind = "choice", prompt = "___ it was late, we went out.", options = listOf("Although", "However", "So", "Because"), answers = listOf("Although"), explain = "although + clause expresses contrast."), Exercise(id = "en-foundations-connections-connectors-e2", kind = "gap", prompt = "It was raining, ___ we stayed in. (result)", options = listOf(), answers = listOf("so"), explain = "so introduces the result."), Exercise(id = "en-foundations-connections-connectors-e3", kind = "order", prompt = "Give the reason for leaving.", options = listOf(), answers = listOf("We left because it was full"), explain = "result + because + reason."), Exercise(id = "en-foundations-connections-connectors-e4", kind = "written", prompt = "Fix: “The plan works, however it's slow.” (punctuation)", options = listOf(), answers = listOf("the plan works however it's slow", "the plan works however it is slow"), explain = "However needs a stronger break: “The plan works. However, it's slow.”")), skills = listOf("grammar:connectors", "function:express-opinion", "speaking:justify-opinion", "writing:argument"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "en-foundations-connections-suggestions", title = "Making suggestions", goal = "Propose plans with Why don't we, How about and Let's — and accept or decline kindly.", intro = LessonIntro(explanation = listOf("Three openers, three grammars: Why don't we + verb (“Why don't we order pizza?”), How about + -ing (“How about watching a film?”), Let's + verb (“Let's stay in.”).", "Accept: “Sounds good!” “Good idea!” Decline kindly with a reason and a counter-offer: “I'm beat, honestly. Rain check?”", "Ask back with Shall we…? and What about…?: “Shall we meet at eight? What about the new place?”"), examples = listOf(ExampleLine(text = "Why don't we order pizza?", meaning = "why don't we + base verb."), ExampleLine(text = "How about trying the new ramen place?", meaning = "how about + -ing."), ExampleLine(text = "Let's stay in tonight.", meaning = "let's + base verb."), ExampleLine(text = "Sounds good — I'm in!", meaning = "Accepting."), ExampleLine(text = "I'm beat, honestly. Rain check?", meaning = "Declining kindly."), ExampleLine(text = "Shall we say eight, then?", meaning = "Closing the plan."))), expressions = listOf(TargetExpression(text = "Why don't we + verb", meaning = "Suggestion as a question.", note = "Never “Why we don't”."), TargetExpression(text = "How about + -ing", meaning = "Suggestion with a gerund.", note = "How about going…?"), TargetExpression(text = "Let's + verb", meaning = "Direct suggestion for both.", note = "Let's not argue."), TargetExpression(text = "Sounds good / I'm in!", meaning = "Accept.", note = "sounds + adjective, no subject."), TargetExpression(text = "Rain check?", meaning = "Not today, but soon.", note = "From ticket rain checks."), TargetExpression(text = "Shall we say …?", meaning = "Fix the detail.", note = "Time or place closer.")), situation = "Friday night, no plan: trade suggestions, accept one, decline another kindly and settle on a time and place.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Suggest ordering food in. (why don't we)", expected = listOf("Why don't we order in?"), focus = "why don't we", watch = "“Why we don't order” — the inversion lives in don't we."), PracticeQuestion(prompt = "Suggest watching a film. (how about)", expected = listOf("How about watching a film?"), focus = "how about + -ing", watch = "“How about to watch” — the gerund is obligatory."), PracticeQuestion(prompt = "Suggest staying in, directly.", expected = listOf("Let's stay in tonight."), focus = "let's", watch = "let's + base verb: “let's to stay” is wrong."), PracticeQuestion(prompt = "Accept a plan with enthusiasm.", expected = listOf("Sounds good — I'm in!", "Great idea, I'm in!"), focus = "accepting", watch = "“It sounds good” also works; “Sounds good” is the chatty form."), PracticeQuestion(prompt = "Decline tonight, but keep the plan alive.", expected = listOf("I'm beat, honestly. Rain check?", "Can't tonight — rain check?"), focus = "declining", watch = "A decline without a counter-offer ends the friendship chat."), PracticeQuestion(prompt = "Fix the time: eight.", expected = listOf("Shall we say eight, then?"), focus = "closing", watch = "shall we say + the detail."))), exercises = listOf(Exercise(id = "en-foundations-connections-suggestions-e1", kind = "choice", prompt = "How about ___ the new exhibition?", options = listOf("visiting", "to visit", "visit", "we visit"), answers = listOf("visiting"), explain = "How about + -ing."), Exercise(id = "en-foundations-connections-suggestions-e2", kind = "gap", prompt = "Why ___ we take a break? (suggestion)", options = listOf(), answers = listOf("don't"), explain = "Why don't we + base verb."), Exercise(id = "en-foundations-connections-suggestions-e3", kind = "order", prompt = "Suggest staying in.", options = listOf(), answers = listOf("Let's stay in tonight"), explain = "Let's + base verb."), Exercise(id = "en-foundations-connections-suggestions-e4", kind = "written", prompt = "Decline tonight kindly and keep it alive.", options = listOf(), answers = listOf("i'm beat rain check", "cant tonight rain check", "i can't tonight rain check"), explain = "Reason + rain check.")), skills = listOf("function:make-suggestions", "grammar:gerunds-infinitives", "grammar:connectors", "speaking:sustained-conversation"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:present-simple"))))
}

object EnFoundationsChange {
    val unit = CourseUnit(id = "en-foundations-change", title = "Changes", subtitle = "Will, rumours, phrasal verbs", level = "B1", themes = listOf(ConversationTheme("weather-pool", "The office pool", "What will happen?", "cloud.sun", "Course", "You and your colleagues bet on next week: weather, results, deadlines. Make predictions and defend them.", 0),
                ConversationTheme("rumour-mill", "The rumour mill", "Who said what?", "person.2.wave.2", "Course", "Office news travels fast: report what people said, and work out what is actually true.", 1)), lessons = listOf(    Lesson(id = "en-foundations-change-will", title = "Will: decisions & promises", goal = "Use will for spontaneous decisions, offers, promises and predictions without evidence.", intro = LessonIntro(explanation = listOf("Will is for the moment of speaking: “The phone's ringing — I'll get it!” The decision happens as you talk.", "It also covers promises and offers: “I'll always be there for you.” “I'll carry that for you.” And predictions without evidence: “You'll love this film.”", "Contrast with going to: going to = already decided before speaking (“I'm going to study tonight”); will = decided now (“OK, I'll study with you”).", "Negative: won't. Question: “Will you help me?” Never “will to help”."), examples = listOf(ExampleLine(text = "The phone's ringing — I'll get it!", meaning = "Decision at the moment of speaking."), ExampleLine(text = "I'll carry that for you.", meaning = "An offer."), ExampleLine(text = "I won't tell anyone, promise.", meaning = "A promise."), ExampleLine(text = "Don't worry, you'll pass.", meaning = "A prediction, no evidence given."), ExampleLine(text = "Shall I open the window? — Good idea, I'll close the door.", meaning = "Offers and instant decisions."), ExampleLine(text = "I'm going to study tonight. — Great, I'll join you.", meaning = "Plan vs decision now."))), expressions = listOf(TargetExpression(text = "I'll + verb", meaning = "Decision now, offer.", note = "I'll get the door."), TargetExpression(text = "I won't + verb", meaning = "Promise not to.", note = "I won't be late."), TargetExpression(text = "You'll love / it'll work", meaning = "Prediction without evidence.", note = "Contrast: it's going to rain (clouds!)."), TargetExpression(text = "Will you …?", meaning = "Request or prediction question.", note = "Will you help me?"), TargetExpression(text = "I think / probably + will", meaning = "Soften predictions.", note = "It'll probably rain."), TargetExpression(text = "vs going to", meaning = "Decided now vs decided before.", note = "Both futures, different moments.")), situation = "A friend's flat has a small crisis (broken lamp, hungry cat, empty fridge): make instant offers, promises and confident predictions as events unfold.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "The doorbell rings while you're both cooking. Offer to answer.", expected = listOf("I'll get it!", "I'll answer it!"), focus = "decision now", watch = "“I'm going to get it” sounds pre-planned — the ring is news."), PracticeQuestion(prompt = "Promise your friend you won't be late tomorrow.", expected = listOf("I won't be late.", "I promise I won't be late."), focus = "promise", watch = "“I won't to be” — won't + base verb."), PracticeQuestion(prompt = "No evidence yet: predict your friend will love the film.", expected = listOf("You'll love the film.", "You're going to love it? no — use will: You'll love it."), focus = "bare prediction", watch = "Without evidence, will is the natural choice."), PracticeQuestion(prompt = "Offer to carry the heavy boxes.", expected = listOf("I'll carry the boxes.", "I'll carry them for you."), focus = "offers", watch = "“I carry them” — English needs will for the offer."), PracticeQuestion(prompt = "Soften your prediction about tonight's traffic. (probably)", expected = listOf("It'll probably be terrible.", "Traffic will probably be bad."), focus = "probably + will", watch = "probably goes before will: “will probably be”."), PracticeQuestion(prompt = "Your friend says “I'm going to clean the kitchen”. Join in spontaneously.", expected = listOf("OK, I'll clean the bathroom!", "I'll help you then."), focus = "plan vs decision", watch = "Their plan = going to; your reaction = will."))), exercises = listOf(Exercise(id = "en-foundations-change-will-e1", kind = "choice", prompt = "The phone's ringing — I ___ answer it.", options = listOf("'ll", "going to", "am", "do"), answers = listOf("'ll"), explain = "A decision at the moment of speaking takes will."), Exercise(id = "en-foundations-change-will-e2", kind = "gap", prompt = "Don't worry, you ___ ___ fail. (negative promise)", options = listOf(), answers = listOf("will not", "won't"), explain = "won't + base verb."), Exercise(id = "en-foundations-change-will-e3", kind = "order", prompt = "Make a confident prediction.", options = listOf(), answers = listOf("You will love this film"), explain = "will + base verb, no evidence needed."), Exercise(id = "en-foundations-change-will-e4", kind = "written", prompt = "Your hands are full. Offer to be helped… no: offer help with the door.", options = listOf(), answers = listOf("i'll open the door", "i will open the door", "i'll get the door"), explain = "I'll + verb for instant offers.")), skills = listOf("grammar:future-forms", "function:make-future-plans", "function:describe-goals", "speaking:short-answer"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:verb-be", "grammar:going-to")),
    Lesson(id = "en-foundations-change-reported", title = "He said he was busy", goal = "Report what people said with said/thought + a tense shift back.", intro = LessonIntro(explanation = listOf("Direct: “I'm busy.” Reported: “He said he was busy.” The present shifts one step into the past.", "Common shifts: am/is → was, are → were, will → would, can → could, have → had. Past simple usually stays past simple.", "Questions drop their question form: “Where do you live?” → “She asked where I lived.” No do/did, no inversion."), examples = listOf(ExampleLine(text = "She said she was tired.", meaning = "“I am tired” → was."), ExampleLine(text = "They said they would call.", meaning = "“We will call” → would."), ExampleLine(text = "He told me he couldn't come.", meaning = "tell + person; say + (that)."), ExampleLine(text = "You said you liked my cooking!", meaning = "“I like” → liked."), ExampleLine(text = "She asked where I lived.", meaning = "Reported question, no did."), ExampleLine(text = "I thought you were leaving today.", meaning = "thought + shift."))), expressions = listOf(TargetExpression(text = "said (that) + shifted tense", meaning = "Report statements.", note = "He said (that) he was busy."), TargetExpression(text = "told me + shifted tense", meaning = "Report to a person.", note = "tell SOMEONE; never “said me”."), TargetExpression(text = "am/is → was", meaning = "The basic shift.", note = "“I'm here” → she said she was there."), TargetExpression(text = "will → would / can → could", meaning = "Modals step back too.", note = "“I'll help” → he'd help."), TargetExpression(text = "asked where/when/why + past", meaning = "Reported questions.", note = "No inversion, no do."), TargetExpression(text = "Rumour mode: People are saying…", meaning = "Report gossip loosely.", note = "…the office is closing. Really?")), situation = "You come back from a day off to a wall of office rumours: report who said what, and separate reliable reports from gossip.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Report: “I'm leaving the company.” (Tom, to you)", expected = listOf("Tom said he was leaving the company.", "Tom told me he was leaving the company."), focus = "is → was", watch = "“Tom said he is leaving” is possible in casual speech — the exam-safe form shifts to was."), PracticeQuestion(prompt = "Report: “We will announce it on Friday.” (the manager)", expected = listOf("The manager said they would announce it on Friday."), focus = "will → would", watch = "“said they will” — shift the modal too: would."), PracticeQuestion(prompt = "Report: “I can't find the file.” (Ana)", expected = listOf("Ana said she couldn't find the file.", "Ana told me she couldn't find the file."), focus = "can → could", watch = "Never “said me” — say (that) or told me."), PracticeQuestion(prompt = "Report the question: “Where do you work?”", expected = listOf("She asked where I worked."), focus = "reported question", watch = "No did, no inversion: “asked where did I work” is wrong."), PracticeQuestion(prompt = "Pass on gossip about the merger. (People are saying…)", expected = listOf("People are saying the merger is off.", "People are saying there's going to be a merger."), focus = "rumour mode", watch = "are saying keeps it vague and deniable."), PracticeQuestion(prompt = "Correct a rumour: “I thought you were leaving, but you're not.”", expected = listOf("I thought you were leaving, but you're still here.", "I thought you were leaving — obviously not!"), focus = "thought + shift", watch = "thought + was for the belief you had."))), exercises = listOf(Exercise(id = "en-foundations-change-reported-e1", kind = "choice", prompt = "She ___ she was tired.", options = listOf("said", "told", "says to", "spoke"), answers = listOf("said"), explain = "say (that) + clause; tell needs a person: told ME."), Exercise(id = "en-foundations-change-reported-e2", kind = "gap", prompt = "They said they ___ call later. (will → shift)", options = listOf(), answers = listOf("would", "'d"), explain = "will steps back to would."), Exercise(id = "en-foundations-change-reported-e3", kind = "order", prompt = "Report this question. (asked / I / where / she / lived)", options = listOf(), answers = listOf("She asked where I lived"), explain = "asked + question word + subject + past."), Exercise(id = "en-foundations-change-reported-e4", kind = "written", prompt = "Fix: “He said me he is busy.”", options = listOf(), answers = listOf("he told me he was busy", "he said he was busy"), explain = "said me doesn't exist; and is shifts to was.")), skills = listOf("grammar:reported-speech-basic", "grammar:past-simple-irregular", "function:tell-a-story", "vocab:work"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-irregular")),
    Lesson(id = "en-foundations-change-phrasals", title = "Phrasal verbs you already use", goal = "Master the ten everyday phrasal verbs that replace formal verbs in speech.", intro = LessonIntro(explanation = listOf("A phrasal verb = verb + particle with its own meaning: get up (leave the bed), give up (stop trying), look for (search). The particle changes everything.", "Separable or not: “turn it off” (separable — the pronoun goes in the middle, never at the end). “Look after the cat” (inseparable). Learn each verb's habit.", "Formal English often has a single-verb twin: find out = discover, put off = postpone. Speech prefers the phrasal; writing accepts both."), examples = listOf(ExampleLine(text = "I get up at six even on Sundays.", meaning = "leave the bed."), ExampleLine(text = "Don't give up now!", meaning = "stop trying."), ExampleLine(text = "I'm looking for my keys.", meaning = "searching."), ExampleLine(text = "Turn it off and back on again.", meaning = "Separable: turn the computer off."), ExampleLine(text = "Can you look after the cat this weekend?", meaning = "Inseparable: take care of."), ExampleLine(text = "I found out the truth yesterday.", meaning = "= discovered."))), expressions = listOf(TargetExpression(text = "get up", meaning = "Leave the bed.", note = "I got up late."), TargetExpression(text = "give up", meaning = "Stop trying.", note = "give up + -ing: give up smoking."), TargetExpression(text = "look for / look after", meaning = "Search / take care of.", note = "Different meanings, same verb."), TargetExpression(text = "turn on/off (separable)", meaning = "Pronoun in the middle.", note = "turn it on, never turn on it."), TargetExpression(text = "find out", meaning = "= discover.", note = "I'll find out and tell you."), TargetExpression(text = "put off = postpone", meaning = "Formal twin exists.", note = "They put off the meeting.")), situation = "A friend is moving house: phrasal verbs everywhere — get up early, pick up boxes, look after the dog, give up the sofa, turn off the lights.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Say what time you leave the bed on Mondays.", expected = listOf("I get up at <time> on Mondays."), focus = "get up", watch = "“I get me up” — no pronoun: I get up."), PracticeQuestion(prompt = "Encourage a friend who wants to quit the gym to continue.", expected = listOf("Don't give up!"), focus = "give up", watch = "give up alone works: no object needed."), PracticeQuestion(prompt = "Ask someone to take care of your dog this weekend.", expected = listOf("Can you look after my dog this weekend?"), focus = "look after", watch = "look after ≠ look for (search)."), PracticeQuestion(prompt = "The pronoun goes in the middle: the lights / turn off / them.", expected = listOf("Turn them off.", "Turn off the lights.", "Turn the lights off."), focus = "separable", watch = "“Turn off them” is wrong — pronouns sit inside."), PracticeQuestion(prompt = "Say you discovered the truth yesterday. (phrasal)", expected = listOf("I found out the truth yesterday."), focus = "find out", watch = "found out, not “found up” or “discovered out”."), PracticeQuestion(prompt = "Say the meeting was postponed. (phrasal)", expected = listOf("They put off the meeting.", "The meeting was put off."), focus = "put off", watch = "put off + thing; put the meeting off also works."))), exercises = listOf(Exercise(id = "en-foundations-change-phrasals-e1", kind = "choice", prompt = "Can you ___ ___ my plants while I'm away?", options = listOf("look after", "look for", "look up", "look at"), answers = listOf("look after"), explain = "look after = take care of; look for = search."), Exercise(id = "en-foundations-change-phrasals-e2", kind = "gap", prompt = "Turn ___ ___ before you leave. (the lights, pronoun)", options = listOf(), answers = listOf("them off", "it off"), explain = "Separable: the pronoun goes inside."), Exercise(id = "en-foundations-change-phrasals-e3", kind = "order", prompt = "Encourage your friend.", options = listOf(), answers = listOf("Don't give up now"), explain = "don't give up = keep trying."), Exercise(id = "en-foundations-change-phrasals-e4", kind = "written", prompt = "Phrasal twin: “They postponed the meeting.”", options = listOf(), answers = listOf("they put off the meeting", "they put the meeting off"), explain = "put off = postpone.")), skills = listOf("grammar:phrasal-verbs", "vocab:daily-routine", "function:talk-about-routines"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple"))))
}

object EnFoundationsTelling {
    val unit = CourseUnit(id = "en-foundations-telling", title = "Telling it well", subtitle = "Collocations, reactions, problems", level = "B1", themes = listOf(ConversationTheme("good-news-bad-news", "Good news, bad news", "React naturally", "arrow.up.arrow.down", "Course", "You swap news with a friend: some wonderful, some terrible — your reactions carry the conversation.", 0),
                ConversationTheme("the-broken-thing", "The broken thing", "Explain and fix", "wrench.and.screwdriver", "Course", "Something you rented is broken. Explain the problem clearly and agree on a solution.", 1)), lessons = listOf(    Lesson(id = "en-foundations-telling-collocations", title = "Collocations that carry you", goal = "Use the word pairs natives reach for: make a decision, have a break, pay attention.", intro = LessonIntro(explanation = listOf("Collocations are fixed friendships between words: make a decision (never do a decision), pay attention, take responsibility.", "Learn them as whole chunks: word-by-word assembly is how “do a mistake” happens — mistakes are made.", "When unsure, ask a native: “What's the usual verb here?” They hear the pair, not the rule."), examples = listOf(ExampleLine(text = "We need to make a decision today.", meaning = "make + decision."), ExampleLine(text = "Let's have a break.", meaning = "have + break/rest."), ExampleLine(text = "Pay attention to the deadline.", meaning = "pay + attention."), ExampleLine(text = "I made a mistake in the report.", meaning = "make + mistake."), ExampleLine(text = "She takes responsibility for the project.", meaning = "take + responsibility."))), expressions = listOf(TargetExpression(text = "make a decision / mistake", meaning = "The two makes.", note = "Never do a decision."), TargetExpression(text = "have a break / rest", meaning = "have + rest words.", note = "Let's have a break."), TargetExpression(text = "pay attention (to)", meaning = "Focus.", note = "…to the details."), TargetExpression(text = "take responsibility / a seat", meaning = "take pairs.", note = "take your time."), TargetExpression(text = "do someone a favour", meaning = "do + favour.", note = "Can you do me a favour?"), TargetExpression(text = "heavy traffic / light rain", meaning = "Adjective pairs.", note = "The traffic is heavy.")), situation = "You and a colleague polish an email together: swap the literal phrases for natural collocations — decision, break, mistake, favour — and feel it sound native.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Say it with the right verb: decide today. (make a decision)", expected = listOf("We need to make a decision today."), focus = "make a decision", watch = "Never “do a decision” — decision pairs with make."), PracticeQuestion(prompt = "Correct the classic error: “I did a mistake”.", expected = listOf("I made a mistake."), focus = "make a mistake", watch = "do → made: mistakes are made."), PracticeQuestion(prompt = "Ask a colleague for a favour.", expected = listOf("Can you do me a favour?"), focus = "do a favour", watch = "favours are done, mistakes are made."), PracticeQuestion(prompt = "Tell a restless team to pause.", expected = listOf("Let's have a break."), focus = "have a break", watch = "have a break / have a rest — both natural."), PracticeQuestion(prompt = "Describe the traffic at five o'clock.", expected = listOf("The traffic is really heavy."), focus = "heavy traffic", watch = "traffic is heavy or light — never “big traffic”."))), exercises = listOf(Exercise(id = "en-foundations-telling-collocations-e1", kind = "choice", prompt = "We need to ___ a decision before Friday.", options = listOf("make", "do", "have", "take"), answers = listOf("make"), explain = "make a decision — the fixed pair."), Exercise(id = "en-foundations-telling-collocations-e2", kind = "gap", prompt = "I ___ a mistake in the report. Sorry.", options = listOf(), answers = listOf("made"), explain = "make → made a mistake."), Exercise(id = "en-foundations-telling-collocations-e3", kind = "order", prompt = "Ask for a favour.", options = listOf(), answers = listOf("Can you do me a favour"), explain = "do someone a favour."), Exercise(id = "en-foundations-telling-collocations-e4", kind = "written", prompt = "Describe the traffic at rush hour.", options = listOf(), answers = listOf("the traffic is heavy", "traffic is really heavy"), explain = "heavy traffic.")), skills = listOf("vocab:collocations", "vocab:social-expressions", "grammar:present-simple", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "en-foundations-telling-reacting", title = "Reacting to news", goal = "Respond to good and bad news naturally — the reactions carry the conversation.", intro = LessonIntro(explanation = listOf("Good news reactions, in rising order: “Nice!” “That's great news!” “No way! That's amazing!”", "Bad news: “Oh no.” “I'm sorry to hear that.” “That's awful.” Then the follow-up question — reactions without questions are walls.", "The secret: react, then ask. “No way! When did that happen?” — the question proves you care."), examples = listOf(ExampleLine(text = "No way! That's amazing!", meaning = "Big good news."), ExampleLine(text = "That's great news, congratulations!", meaning = "Good news + congratulation."), ExampleLine(text = "Oh no, I'm sorry to hear that.", meaning = "Bad news."), ExampleLine(text = "That's awful — are you OK?", meaning = "Bad news + care."), ExampleLine(text = "Really? When did that happen?", meaning = "React + follow-up."))), expressions = listOf(TargetExpression(text = "No way!", meaning = "Surprise, good or bad.", note = "Strong but friendly."), TargetExpression(text = "That's great news!", meaning = "Good news reaction.", note = "news is singular!"), TargetExpression(text = "I'm sorry to hear that.", meaning = "Bad news reaction.", note = "Fixed phrase."), TargetExpression(text = "Congratulations!", meaning = "Achievements.", note = "congratulations on + thing."), TargetExpression(text = "React + question", meaning = "Keep it flowing.", note = "No way! When?")), situation = "A friend calls with a promotion; another cancels with a family emergency; a third has bought a boat. React to each — differently, and always with a question.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "React to big good news: your friend got promoted.", expected = listOf("No way! Congratulations!", "That's amazing — congratulations!"), focus = "big good news", watch = "congratulations on the promotion."), PracticeQuestion(prompt = "React to very bad news: your friend's dog died.", expected = listOf("Oh no, I'm so sorry.", "I'm so sorry to hear that."), focus = "bad news", watch = "Match the weight: “Nice!” would be terrible."), PracticeQuestion(prompt = "React and ask for details about a new job.", expected = listOf("That's great! When do you start?"), focus = "react + question", watch = "The follow-up keeps the conversation alive."), PracticeQuestion(prompt = "React to a surprise: your friend bought a boat.", expected = listOf("No way! You bought a boat?", "You're kidding!"), focus = "surprise", watch = "You're kidding! = no me lo creo."), PracticeQuestion(prompt = "Move from bad news to care.", expected = listOf("That's awful — are you OK?"), focus = "care question", watch = "Awful news gets a care question, not curiosity."))), exercises = listOf(Exercise(id = "en-foundations-telling-reacting-e1", kind = "choice", prompt = "That's wonderful ___!", options = listOf("news", "new", "a news", "newses"), answers = listOf("news"), explain = "news is uncountable: news is, never newses."), Exercise(id = "en-foundations-telling-reacting-e2", kind = "gap", prompt = "Congratulations ___ your promotion!", options = listOf(), answers = listOf("on"), explain = "congratulations on + thing."), Exercise(id = "en-foundations-telling-reacting-e3", kind = "order", prompt = "React to bad news.", options = listOf(), answers = listOf("Im sorry to hear that"), explain = "I'm sorry to hear that."), Exercise(id = "en-foundations-telling-reacting-e4", kind = "written", prompt = "React with surprise to a boat purchase.", options = listOf(), answers = listOf("no way", "youre kidding", "no way you bought a boat"), explain = "Any natural surprise.")), skills = listOf("vocab:social-expressions", "function:express-opinion", "speaking:sustained-conversation", "grammar:present-simple"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "en-foundations-telling-problems", title = "Explaining a problem", goal = "Structure a problem clearly: context, what happened, what you want.", intro = LessonIntro(explanation = listOf("The three-step structure: context (“I rented a car on Friday”), problem (“it broke down on the motorway”), request (“I'd like a refund or a replacement”).", "Stay factual, not emotional: “The engine stopped three times” beats “your car is terrible!”", "Signal the request: “So what I'd like is…” — the listener knows the explanation has landed somewhere."), examples = listOf(ExampleLine(text = "I rented a car from your airport office.", meaning = "Context first."), ExampleLine(text = "It broke down twice on Saturday.", meaning = "The problem, factually."), ExampleLine(text = "I'd like a replacement or a refund.", meaning = "The request."), ExampleLine(text = "This is the second time it's happened.", meaning = "History strengthens the case."), ExampleLine(text = "What can you do about it?", meaning = "Hand the problem over."))), expressions = listOf(TargetExpression(text = "Context first: …", meaning = "Set the scene.", note = "I bought it last week."), TargetExpression(text = "The problem is …", meaning = "Say it plainly.", note = "…it doesn't charge."), TargetExpression(text = "I'd like …", meaning = "State the request.", note = "I'd like a replacement."), TargetExpression(text = "This is the second time …", meaning = "Show the pattern.", note = "…it's happened."), TargetExpression(text = "What can you do about it?", meaning = "Pass the ball.", note = "Polite but firm.")), situation = "You call about a faulty rental: give context, describe the two failures factually, and ask for one of two clear solutions.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Give the context of your complaint. (rented Friday)", expected = listOf("I rented a car from your office on Friday."), focus = "context", watch = "Dates and places first — emotions later (or never)."), PracticeQuestion(prompt = "Describe the failure factually. (broke down twice)", expected = listOf("It broke down twice on Saturday."), focus = "factual", watch = "Twice is a fact; “terrible” is an opinion."), PracticeQuestion(prompt = "State your request clearly.", expected = listOf("I'd like a replacement or a refund."), focus = "the request", watch = "Two options make agreement easier."), PracticeQuestion(prompt = "Show it's a pattern. (second time)", expected = listOf("This is the second time it's happened."), focus = "the pattern", watch = "Second time strengthens the case."), PracticeQuestion(prompt = "Hand the problem to them.", expected = listOf("What can you do about it?"), focus = "pass the ball", watch = "The question puts them on the hook, politely."))), exercises = listOf(Exercise(id = "en-foundations-telling-problems-e1", kind = "choice", prompt = "I'd like ___ refund, please.", options = listOf("a", "an", "some", "the my"), answers = listOf("a"), explain = "a refund — consonant sound."), Exercise(id = "en-foundations-telling-problems-e2", kind = "gap", prompt = "The engine ___ ___ three times. (stop, past)", options = listOf(), answers = listOf("stopped"), explain = "stop → stopped."), Exercise(id = "en-foundations-telling-problems-e3", kind = "order", prompt = "State your request.", options = listOf(), answers = listOf("Id like a replacement or a refund"), explain = "I'd like + option or option."), Exercise(id = "en-foundations-telling-problems-e4", kind = "written", prompt = "Open a complaint: you bought a phone last week.", options = listOf(), answers = listOf("i bought a phone last week", "i bought this phone last week"), explain = "Context: what, when.")), skills = listOf("function:solve-problems", "grammar:past-simple-regular", "grammar:connectors", "vocab:social-expressions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:past-simple-regular"))))
}

object EnFoundationsDone {
    val unit = CourseUnit(id = "en-foundations-done", title = "Getting things done", subtitle = "Causatives, phrasal verbs, favours", level = "B1", themes = listOf(ConversationTheme("the-renovation", "The renovation", "Outsource it", "hammer", "Course", "Your flat needs work: painters, plumbers, a cleaner — you arrange for all of it and none of it is done by you. The causative is the language of a busy week.", 0),
                ConversationTheme("the-favour-list", "The favour list", "Ask and delegate", "checklist", "Course", "A mountain of small tasks stands between you and Friday: you chase, delegate and ask nicely until every line is crossed off.", 1)), lessons = listOf(    Lesson(id = "en-foundations-done-causative", title = "Have it done", goal = "Stop doing everything yourself: have something done and get someone to do it.", intro = LessonIntro(explanation = listOf("When someone does a service FOR you, use have + object + participle: \"I had the flat painted\" — you organised it; a painter held the brush.", "Get works the same way, one notch more informal: \"I got the car repaired yesterday\" — same meaning, friendlier tone.", "For people you persuade or allow, switch to get someone TO do, make someone do, let someone do: \"I got my brother to help\" / \"She made me redo it\" / \"He let me leave early\"."), examples = listOf(ExampleLine(text = "I had the walls painted last week.", meaning = "have + object + participle: a painter did it."), ExampleLine(text = "We're getting a new kitchen fitted.", meaning = "Arranged and in progress."), ExampleLine(text = "You should get that tooth looked at.", meaning = "get + object + participle: classic advice."), ExampleLine(text = "She had her bag stolen in Madrid.", meaning = "The causative also reports things done TO you."), ExampleLine(text = "I got my neighbour to look at the boiler.", meaning = "get + person + TO + verb: persuaded."))), expressions = listOf(TargetExpression(text = "have + object + participle", meaning = "The service causative.", note = "I had my hair cut."), TargetExpression(text = "get + object + participle", meaning = "The informal twin.", note = "I got the car fixed."), TargetExpression(text = "get someone to do something", meaning = "Persuade them.", note = "I got him to sign it."), TargetExpression(text = "make someone do something", meaning = "Force them — no to.", note = "She made me redo the report."), TargetExpression(text = "let someone do something", meaning = "Allow them — no to.", note = "He let me leave early.")), situation = "You narrate a gloriously lazy week: the painter painted, the mechanic repaired, the cleaner cleaned — and you take the credit for all of it in flawless causative English.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Say the painter painted your flat last week. (have)", expected = listOf("I had the flat painted last week."), focus = "have something done", watch = "have + object + participle — you never touched a brush."), PracticeQuestion(prompt = "Report the mechanic repaired your car yesterday. (get, informal)", expected = listOf("I got the car repaired yesterday.", "I got my car repaired yesterday."), focus = "get something done", watch = "get works like have here — one notch more informal."), PracticeQuestion(prompt = "Advise a friend about that painful tooth. (get)", expected = listOf("You should get that tooth looked at.", "Get that tooth looked at."), focus = "get + advice", watch = "get + object + participle is the natural advice frame."), PracticeQuestion(prompt = "Say you persuaded your brother to help you move.", expected = listOf("I got my brother to help me move.", "I got my brother to help."), focus = "get someone to", watch = "get + person + TO + verb: got my brother TO help."), PracticeQuestion(prompt = "Complain: someone stole your wallet on the metro. (have)", expected = listOf("I had my wallet stolen on the metro."), focus = "bad-news causative", watch = "have something done also reports things done TO you — no thief named."))), exercises = listOf(Exercise(id = "en-foundations-done-causative-e1", kind = "choice", prompt = "I ___ my hair cut every month.", options = listOf("have", "make", "let", "do"), answers = listOf("have"), explain = "have + object + participle: the barber does the cutting."), Exercise(id = "en-foundations-done-causative-e2", kind = "gap", prompt = "We ___ the roof repaired last spring. (have, past)", options = listOf(), answers = listOf("had"), explain = "Past of have: had the roof repaired — a roofer did it."), Exercise(id = "en-foundations-done-causative-e3", kind = "order", prompt = "Report the finished repair.", options = listOf(), answers = listOf("I got the car repaired yesterday"), explain = "get + object + participle: the informal service causative."), Exercise(id = "en-foundations-done-causative-e4", kind = "written", prompt = "Say your brother finally agreed to help you.", options = listOf(), answers = listOf("i got my brother to help", "i got my brother to help me", "i got my brother to help me move"), explain = "get someone to do something: persuaded, not forced.")), skills = listOf("grammar:causative-have", "vocab:work", "function:talk-about-work", "function:make-requests"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:past-simple-irregular")),
    Lesson(id = "en-foundations-done-phrasals", title = "Phrasal verbs at work", goal = "Run your tasks like a native: put off, set up, carry out, fill in, follow up.", intro = LessonIntro(explanation = listOf("Task phrasal verbs pair an action with its result: put off (delay), carry out (do as planned), set up (arrange), fill in (complete a form).", "The particle can move: \"put the meeting off\" and \"put off the meeting\" both work — but with a pronoun only one order survives: \"put it off\", never \"put off it\".", "A task isn't finished until someone chases it: \"I'll follow up on Friday\" — follow up means check back, politely."), examples = listOf(ExampleLine(text = "Let's put the meeting off until Monday.", meaning = "Delay it — Monday is safer."), ExampleLine(text = "I'll set up the call for Thursday.", meaning = "Arrange it."), ExampleLine(text = "The team carried out the plan perfectly.", meaning = "Did it exactly as intended."), ExampleLine(text = "Can you fill in this form and sign it?", meaning = "Complete it."), ExampleLine(text = "No reply yet — I'll follow up tomorrow.", meaning = "Chase it, politely."))), expressions = listOf(TargetExpression(text = "put off / put it off", meaning = "Delay — usually what we avoid.", note = "Don't put off the dentist."), TargetExpression(text = "set up / set it up", meaning = "Arrange.", note = "I'll set up a call."), TargetExpression(text = "carry out / carry it out", meaning = "Do as planned.", note = "They carried out the tests."), TargetExpression(text = "fill in / fill it in", meaning = "Complete a form.", note = "Fill in sections 1 and 2."), TargetExpression(text = "follow up on", meaning = "Chase politely.", note = "I'll follow up on Monday.")), situation = "Monday stand-up, six tasks on the board: delay one, arrange two, complete a form, carry out the plan — and promise to follow up on the rest before Friday.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Delay the meeting to Monday. (put off)", expected = listOf("Let's put the meeting off until Monday.", "I'll put the meeting off until Monday."), focus = "put off", watch = "With a pronoun only one order works: put IT off."), PracticeQuestion(prompt = "Arrange a call for Thursday. (set up)", expected = listOf("I'll set up the call for Thursday.", "I'll set up a call for Thursday."), focus = "set up", watch = "set up = arrange: the call exists once you set it up."), PracticeQuestion(prompt = "Say the team did the plan exactly as intended. (carry out)", expected = listOf("The team carried out the plan perfectly.", "The team carried out the plan."), focus = "carry out", watch = "carry out = perform to the letter: plans, tests, orders."), PracticeQuestion(prompt = "Ask someone to complete a form.", expected = listOf("Can you fill in this form?", "Could you fill in this form, please?"), focus = "fill in", watch = "fill in + the form: BrE prefers fill in; AmE prefers fill out."), PracticeQuestion(prompt = "Promise to chase the client's reply tomorrow. (follow up)", expected = listOf("I'll follow up tomorrow.", "I'll follow up with the client tomorrow."), focus = "follow up", watch = "follow up on/with = check back without nagging."))), exercises = listOf(Exercise(id = "en-foundations-done-phrasals-e1", kind = "choice", prompt = "We keep ___ the decision — just decide today.", options = listOf("putting off", "putting on", "carrying out", "setting up"), answers = listOf("putting off"), explain = "put off = delay: they keep delaying the decision."), Exercise(id = "en-foundations-done-phrasals-e2", kind = "gap", prompt = "I'll ___ up the meeting room for ten o'clock. (set)", options = listOf(), answers = listOf("set"), explain = "set up = arrange: chairs, screen, coffee."), Exercise(id = "en-foundations-done-phrasals-e3", kind = "order", prompt = "Say you'll arrange the Thursday call.", options = listOf(), answers = listOf("I will set up the call for Thursday"), explain = "set up + the arrangement: set up the call."), Exercise(id = "en-foundations-done-phrasals-e4", kind = "written", prompt = "Tell your boss you checked back with the client.", options = listOf(), answers = listOf("i followed up with the client", "i followed up on the client", "i followed up"), explain = "follow up with/on = chase politely.")), skills = listOf("grammar:phrasal-verbs", "vocab:work", "function:talk-about-work", "speaking:short-answer"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "en-foundations-done-requests", title = "Asking nicely", goal = "Get to yes without ordering people around: layered requests and polite permissions.", intro = LessonIntro(explanation = listOf("Softer request = longer request: \"Can you help?\" → \"Could you possibly help?\" → \"Do you think you could help?\" — each layer adds doubt, which reads as respect.", "\"Would you mind + -ing\" is the politest request in English: \"Would you mind opening the window?\" — and natives answer it with \"Not at all\", because the question asks about the mind, not the window.", "Permissions climb the same ladder: \"May I…?\" is formal, \"Is it OK if I…?\" is neutral, \"Do you mind if I…?\" is careful."), examples = listOf(ExampleLine(text = "Could you possibly send me the file today?", meaning = "possibly adds the doubt that softens it."), ExampleLine(text = "Would you mind taking over the call?", meaning = "mind + -ing: the polite classic."), ExampleLine(text = "Do you think you could cover for me on Friday?", meaning = "The polite heavy-lifter."), ExampleLine(text = "Is it OK if I leave a bit early today?", meaning = "Neutral permission."), ExampleLine(text = "Not at all — go ahead.", meaning = "The natural yes to a would-you-mind."))), expressions = listOf(TargetExpression(text = "Could you possibly …?", meaning = "Softer than can you.", note = "Could you possibly email me the invoice?"), TargetExpression(text = "Would you mind + -ing?", meaning = "The polite classic.", note = "Would you mind waiting outside?"), TargetExpression(text = "Do you think you could …?", meaning = "Loads of doubt = loads of respect.", note = "Do you think you could help me move?"), TargetExpression(text = "Is it OK if I …?", meaning = "Neutral permission.", note = "Is it OK if I open the window?"), TargetExpression(text = "Not at all.", meaning = "The yes to 'would you mind'.", note = "Not at all — go ahead.")), situation = "One overloaded afternoon: you ask a colleague to swap a shift, a stranger to watch your laptop and your boss to let you leave early — each request lands on its correct rung of the politeness ladder.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Politely ask a colleague to send you a file today.", expected = listOf("Could you possibly send me the file today?", "Could you possibly send the file today?"), focus = "could you possibly", watch = "possibly is the softener — could you alone sounds brisker."), PracticeQuestion(prompt = "Ask your flatmate to turn the music down — very politely. (mind)", expected = listOf("Would you mind turning the music down?"), focus = "would you mind + -ing", watch = "mind + -ing: turning, never mind turn."), PracticeQuestion(prompt = "Ask a coworker to cover your shift — extra politely.", expected = listOf("Do you think you could cover my shift?", "Do you think you could cover my shift on Friday?"), focus = "do you think you could", watch = "Maximum doubt, maximum politeness — perfect for big favours."), PracticeQuestion(prompt = "Ask your teacher for permission to leave early — neutral.", expected = listOf("Is it OK if I leave early?", "Is it OK if I leave early today?"), focus = "is it OK if", watch = "is it OK if + present simple: no will after if."), PracticeQuestion(prompt = "Someone asks: \"Would you mind waiting?\" Say yes — politely.", expected = listOf("Not at all.", "No, not at all.", "Not at all, no problem."), focus = "not at all", watch = "A bare yes means YES, I DO mind — the idiomatic yes is Not at all."))), exercises = listOf(Exercise(id = "en-foundations-done-requests-e1", kind = "choice", prompt = "Would you ___ closing the window? It's freezing.", options = listOf("mind", "like", "want", "let"), answers = listOf("mind"), explain = "would you mind + -ing: the politest request frame."), Exercise(id = "en-foundations-done-requests-e2", kind = "gap", prompt = "Could you ___ send me the report tonight? (possible)", options = listOf(), answers = listOf("possibly"), explain = "possibly softens could you into a polite request."), Exercise(id = "en-foundations-done-requests-e3", kind = "order", prompt = "Ask permission to open the window (neutral).", options = listOf(), answers = listOf("Is it OK if I open the window"), explain = "is it OK if + present: the neutral permission ask."), Exercise(id = "en-foundations-done-requests-e4", kind = "written", prompt = "Politely ask a visitor to wait a moment. (mind)", options = listOf(), answers = listOf("would you mind waiting", "would you mind waiting a moment"), explain = "would you mind + -ing: waiting, not wait.")), skills = listOf("function:make-requests", "grammar:gerunds-infinitives", "vocab:social-expressions", "speaking:short-answer"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:gerunds-infinitives"))))
}

object EnFoundationsProblems {
    val unit = CourseUnit(id = "en-foundations-problems", title = "Dealing with problems", subtitle = "Regret, what-ifs, solutions", level = "B1", themes = listOf(ConversationTheme("the-wrong-train", "The wrong train", "Regret and what-ifs", "tram", "Course", "You took the wrong train, missed the warm-up and arrived flustered: now you can say exactly what you wish you had done — and what you would do differently.", 0),
                ConversationTheme("the-shared-flat", "The shared flat", "Negotiate peace", "house", "Course", "Dishes pile up, bills run late, music plays loud: you and your flatmate negotiate a deal you can both actually keep.", 1)), lessons = listOf(    Lesson(id = "en-foundations-problems-wish", title = "I wish & If only", goal = "Say what you regret: I wish I had known, if only I hadn't sent it.", intro = LessonIntro(explanation = listOf("Regret about the present uses wish + past simple: \"I wish I had more time\" — I don't have it, and the past tense draws the gap.", "Regret about the past moves one step further back, wish + had + participle: \"I wish I had studied\" — too late now, and the sentence knows it.", "If only is wish with the volume up: \"If only I hadn't sent that email!\" — identical grammar, stronger feeling."), examples = listOf(ExampleLine(text = "I wish I had more time.", meaning = "Present regret: I don't have it."), ExampleLine(text = "I wish I knew her number.", meaning = "Present: I don't know it."), ExampleLine(text = "I wish I had left earlier.", meaning = "Past regret: I left late."), ExampleLine(text = "If only I hadn't said that.", meaning = "Loud regret about the past."), ExampleLine(text = "I wish it would stop raining.", meaning = "wish + would: you want a change."))), expressions = listOf(TargetExpression(text = "I wish + past simple", meaning = "Present regret.", note = "I wish I knew."), TargetExpression(text = "I wish + had + participle", meaning = "Past regret.", note = "I wish I had known."), TargetExpression(text = "If only …", meaning = "Wish, one notch louder.", note = "If only I had studied!"), TargetExpression(text = "I wish … wouldn't …", meaning = "Annoyance at other people.", note = "I wish he wouldn't interrupt."), TargetExpression(text = "I wish it would …", meaning = "Wanting a change.", note = "I wish it would stop raining.")), situation = "The morning after the wrong train: you list everything you wish you had checked, everything you wish you hadn't said, and one thing you wish would change by next week.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "You don't have a car. Say it with regret. (wish)", expected = listOf("I wish I had a car."), focus = "wish + past", watch = "wish + past simple for present gaps: I wish I HAD one."), PracticeQuestion(prompt = "You didn't study. Say it with regret. (wish)", expected = listOf("I wish I had studied.", "I wish I had studied more."), focus = "wish + had + participle", watch = "One step further back than the past: had + participle."), PracticeQuestion(prompt = "You sent an angry email. Blame yourself — loudly. (if only)", expected = listOf("If only I hadn't sent that email.", "If only I hadn't sent it."), focus = "if only + hadn't", watch = "if only + past perfect is wish at full volume."), PracticeQuestion(prompt = "Your brother interrupts every call. Complain about him. (wish … wouldn't)", expected = listOf("I wish he wouldn't interrupt me.", "I wish my brother wouldn't interrupt."), focus = "wish + wouldn't", watch = "wish + wouldn't targets other people's habits, not fate."), PracticeQuestion(prompt = "It rains every single day. Want a change. (wish)", expected = listOf("I wish it would stop raining.", "I wish it would stop raining soon."), focus = "wish + would", watch = "wish + would: the change you want from the world."))), exercises = listOf(Exercise(id = "en-foundations-problems-wish-e1", kind = "choice", prompt = "I wish I ___ more time.", options = listOf("had", "have", "would have", "will have"), answers = listOf("had"), explain = "wish + past simple: the gap between want and have."), Exercise(id = "en-foundations-problems-wish-e2", kind = "gap", prompt = "I wish I ___ known sooner. (regret about the past)", options = listOf(), answers = listOf("had"), explain = "wish + had + participle: the past-regret engine."), Exercise(id = "en-foundations-problems-wish-e3", kind = "order", prompt = "Say you regret not studying.", options = listOf(), answers = listOf("I wish I had studied"), explain = "wish + had + participle: past regret."), Exercise(id = "en-foundations-problems-wish-e4", kind = "written", prompt = "Strongly regret sending that angry email. (if only)", options = listOf(), answers = listOf("if only i hadnt sent that email", "if only i hadnt sent it", "if only i hadnt sent the email"), explain = "if only + hadn't + participle: loud past regret.")), skills = listOf("grammar:wish-clauses", "grammar:past-simple-irregular", "vocab:feelings", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:past-simple-irregular")),
    Lesson(id = "en-foundations-problems-hypothetical", title = "The what-if machine", goal = "Replay the past and imagine the present: second and third conditionals side by side.", intro = LessonIntro(explanation = listOf("Second conditional = unreal present: \"If I had a car, I would drive there\" — if + past, would + verb, for now and the future.", "Third conditional = the past replay: \"If I had checked the timetable, I wouldn't have missed the train\" — if + had + participle, would have + participle.", "The time word chooses the grammar: now → second, yesterday → third. Mixing is allowed across time: \"If I had saved then, I would be rich now\"."), examples = listOf(ExampleLine(text = "If I had a car, I would drive there.", meaning = "Unreal present."), ExampleLine(text = "If I were you, I would complain.", meaning = "were for everyone — the advice template."), ExampleLine(text = "If I had checked the timetable, I wouldn't have missed the train.", meaning = "Unreal past."), ExampleLine(text = "If we had left earlier, we would have caught it.", meaning = "The replay: same result, better start."), ExampleLine(text = "If I had saved then, I would be rich now.", meaning = "Mixed: past cause, present result."))), expressions = listOf(TargetExpression(text = "If + past, would + verb", meaning = "Unreal present.", note = "If I knew, I would say."), TargetExpression(text = "If I were you, I would …", meaning = "The advice template.", note = "If I were you, I'd apologise."), TargetExpression(text = "If + had + participle, would have + participle", meaning = "Unreal past.", note = "If I had known, I would have called."), TargetExpression(text = "I wouldn't have … if …", meaning = "The replay, reversed.", note = "I wouldn't have missed it if…"), TargetExpression(text = "… would be … now", meaning = "Past cause, present result.", note = "If I had slept, I would be fine now.")), situation = "You run the wrong-train disaster through the what-if machine twice: once as present advice (what you would do if it happened again) and once as a full past replay (what would have changed).", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "You don't have a car. Imagine you do: you drive there. (second conditional)", expected = listOf("If I had a car, I would drive there.", "If I had a car, I'd drive there."), focus = "second conditional", watch = "if + past, would + verb: unreal, not past in time."), PracticeQuestion(prompt = "Advise a friend to complain. (if I were you)", expected = listOf("If I were you, I would complain.", "If I were you, I'd complain."), focus = "if I were you", watch = "were for every subject: the fixed advice form."), PracticeQuestion(prompt = "You didn't check the timetable and missed the train. Replay it.", expected = listOf("If I had checked the timetable, I wouldn't have missed the train.", "If I had checked the timetable, I would not have missed the train."), focus = "third conditional", watch = "had + participle, would have + participle: the past gets a second draft."), PracticeQuestion(prompt = "You left late and missed it. Replay with an earlier start.", expected = listOf("If we had left earlier, we would have caught it.", "If we had left earlier, we would have caught the train."), focus = "past replay", watch = "Same frame: if we had left, we would have caught."), PracticeQuestion(prompt = "You didn't sleep — and now you're tired. Past cause, present result.", expected = listOf("If I had slept, I wouldn't be tired now.", "If I had slept, I would be fine now."), focus = "mixed conditional", watch = "If + had + participle (past), would + verb (now): mixed across time."))), exercises = listOf(Exercise(id = "en-foundations-problems-hypothetical-e1", kind = "choice", prompt = "If I ___ you, I would complain right now.", options = listOf("were", "was being", "would be", "am"), answers = listOf("were"), explain = "if I were you: were for everyone in the advice form."), Exercise(id = "en-foundations-problems-hypothetical-e2", kind = "gap", prompt = "If I had known, I ___ have called you.", options = listOf(), answers = listOf("would"), explain = "third conditional: would have + participle."), Exercise(id = "en-foundations-problems-hypothetical-e3", kind = "order", prompt = "Replay the past: earlier start, better ending.", options = listOf(), answers = listOf("If we had left earlier we would have caught it"), explain = "if + had + participle, would have + participle."), Exercise(id = "en-foundations-problems-hypothetical-e4", kind = "written", prompt = "Unreal present: you don't speak French. Say what would happen at the interview. (get the job)", options = listOf(), answers = listOf("if i spoke french i would get the job", "if i spoke french i would get it"), explain = "if + past, would + verb: the second conditional.")), skills = listOf("grammar:third-conditional", "grammar:second-conditional", "function:solve-problems", "speaking:justify-opinion"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:second-conditional", "grammar:past-simple-irregular")),
    Lesson(id = "en-foundations-problems-negotiating", title = "Meeting in the middle", goal = "Turn a standoff into a deal: propose, condition, concede, confirm.", intro = LessonIntro(explanation = listOf("Propose with questions, not orders: \"What if I covered Saturday?\" / \"How about splitting the bills?\" — a proposal disguised as a question is easier to accept.", "Condition your offers so nobody loses face: \"If you took the bills, I'd handle the cooking\" — the past tense keeps the trade hypothetical.", "Close the deal out loud: \"So we agree: I cook, you clean.\" A deal nobody repeats is a deal that evaporates by Thursday."), examples = listOf(ExampleLine(text = "What if I covered your shift on Saturday?", meaning = "The proposal-as-question."), ExampleLine(text = "How about splitting the bills fifty-fifty?", meaning = "how about + -ing: lighter touch."), ExampleLine(text = "If you took the bins out, I'd do the cooking.", meaning = "The conditional trade."), ExampleLine(text = "I see your point, but weekends are tight for me.", meaning = "Concede, then hold your line."), ExampleLine(text = "So we agree: I cook, you clean.", meaning = "Lock it in out loud."))), expressions = listOf(TargetExpression(text = "What if I …?", meaning = "The proposal.", note = "What if I went first?"), TargetExpression(text = "How about + -ing?", meaning = "The lighter offer.", note = "How about splitting it?"), TargetExpression(text = "If you … , I'd …", meaning = "The trade.", note = "If you drove, I'd pay for petrol."), TargetExpression(text = "I see your point, but …", meaning = "Concede and hold.", note = "…but Fridays are impossible."), TargetExpression(text = "So we agree: …", meaning = "Lock it in.", note = "So we agree: fifty-fifty.")), situation = "Flat summit, three items on the table — dishes, bills, music: you open with a proposal, trade a conditional offer, concede one point gracefully and close with a deal you both repeat.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Offer to cover your flatmate's Saturday shift. (what if)", expected = listOf("What if I covered your shift on Saturday?", "What if I cover your shift on Saturday?"), focus = "what if + past", watch = "What if I covered…? — the past tense softens; it isn't past in time."), PracticeQuestion(prompt = "Propose splitting the bills — light touch. (how about)", expected = listOf("How about splitting the bills fifty-fifty?", "How about splitting the bills?"), focus = "how about + -ing", watch = "how about + -ing: splitting, never how about to split."), PracticeQuestion(prompt = "Trade: she takes the bills, you do the cooking. (if … would)", expected = listOf("If you took the bills, I'd do the cooking.", "If you took the bills, I would do the cooking."), focus = "conditional trade", watch = "if + past, would + verb: the offer stays hypothetical, so nobody loses face."), PracticeQuestion(prompt = "Accept half her argument — but hold your ground on weekends.", expected = listOf("I see your point, but weekends are tight for me.", "I see your point, but weekends don't work for me."), focus = "concede + but", watch = "I see your point buys goodwill; but holds the line."), PracticeQuestion(prompt = "Close the deal: you cook, she cleans.", expected = listOf("So we agree: I cook, you clean.", "So we agree — I cook, you clean."), focus = "confirm out loud", watch = "Deals survive when both people say them back."))), exercises = listOf(Exercise(id = "en-foundations-problems-negotiating-e1", kind = "choice", prompt = "___ about ordering pizza instead of cooking?", options = listOf("How", "Shall", "If", "Would"), answers = listOf("How"), explain = "how about + -ing: the light proposal."), Exercise(id = "en-foundations-problems-negotiating-e2", kind = "gap", prompt = "If you ___ the dishes, I'd take out the bins. (do, past)", options = listOf(), answers = listOf("did"), explain = "if + past simple keeps the trade hypothetical."), Exercise(id = "en-foundations-problems-negotiating-e3", kind = "order", prompt = "Concede, then hold your ground.", options = listOf(), answers = listOf("I see your point but weekends are tight"), explain = "I see your point, but + your limit."), Exercise(id = "en-foundations-problems-negotiating-e4", kind = "written", prompt = "Lock in the deal: you drive, she pays for petrol.", options = listOf(), answers = listOf("so we agree i drive you pay for petrol", "so we agree i drive and she pays for petrol"), explain = "so we agree: + the deal, repeated out loud.")), skills = listOf("function:negotiate", "grammar:second-conditional", "grammar:connectors", "speaking:negotiate", "vocab:social-expressions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors", "grammar:second-conditional"))))
}

object EnFoundationsViewpoints {
    val unit = CourseUnit(id = "en-foundations-viewpoints", title = "Viewpoints", subtitle = "Argue, report, imagine", level = "B2", themes = listOf(ConversationTheme("debate-club", "Debate night", "Take a side", "person.3", "Course", "You debate a topical question: state your position, imagine alternatives, report what the data says.", 0),
                ConversationTheme("negotiation-table", "The negotiation", "Find the middle", "scale.3d", "Course", "You negotiate a work arrangement: conditions, consequences and a deal both sides can accept.", 1)), lessons = listOf(    Lesson(id = "en-foundations-viewpoints-second-conditional", title = "Second conditional", goal = "Imagine unreal presents and alternatives with if + past, would + verb.", intro = LessonIntro(explanation = listOf("Unreal presents use if + past simple, would + verb: “If I had more time, I would learn the piano.” The time is now/forward — the past form only marks unreality.", "Questions: “What would you do if you lost your job?” I'd = I would.", "Softer advice uses would in the result: “If I were you, I'd negotiate.” Note the fixed phrase If I were you."), examples = listOf(ExampleLine(text = "If I won the lottery, I would travel for a year.", meaning = "An unreal present."), ExampleLine(text = "If I were you, I'd ask for a raise.", meaning = "Advice with were."), ExampleLine(text = "Would you move abroad if you got the chance?", meaning = "Question form."), ExampleLine(text = "I wouldn't say that if I weren't sure.", meaning = "Negative on both sides."), ExampleLine(text = "If we had a bigger budget, we could hire help.", meaning = "could = would be able to."), ExampleLine(text = "Compare: “If it rains, we'll stay” (real) vs “If it rained, we'd stay” (unlikely).", meaning = "First vs second conditional."))), expressions = listOf(TargetExpression(text = "If + past, would + verb", meaning = "Unreal present.", note = "If I had time, I would cook."), TargetExpression(text = "If I were you, I'd …", meaning = "The advice formula.", note = "were, not was, in formal English."), TargetExpression(text = "What would you do if …?", meaning = "The hypothetical question.", note = "Perfect for debates."), TargetExpression(text = "I'd never …", meaning = "A firm unreal negative.", note = "I'd never lie to a client."), TargetExpression(text = "could / might instead of would", meaning = "Ability or possibility in the result.", note = "If we left now, we could catch it."), TargetExpression(text = "Compare with first conditional", meaning = "Real vs imaginary.", note = "If I win… (possible) vs If I won… (fantasy).")), situation = "A debate table: what would you do with a year off, a sudden fortune, a job abroad? Defend your hypotheticals and challenge theirs.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Imagine you had a year off. What would you do?", expected = listOf("If I had a year off, I would <activity>.", "I'd <activity>."), focus = "if + past, would", watch = "“If I would have a year” — never would in the if-clause."), PracticeQuestion(prompt = "Give advice to a friend who earns too little. (If I were you…)", expected = listOf("If I were you, I'd ask for a raise.", "If I were you, I would look for another job."), focus = "If I were you", watch = "The fixed advice formula uses were."), PracticeQuestion(prompt = "Ask about your friend's hypothetical move abroad.", expected = listOf("Would you move abroad if you got the chance?"), focus = "would question", watch = "would in the result question; past in the if-clause."), PracticeQuestion(prompt = "Say what is possible, not certain: if we left now / catch the train.", expected = listOf("If we left now, we could catch the train."), focus = "could in the result", watch = "could replaces would for possibility."), PracticeQuestion(prompt = "Contrast real vs imaginary: rain tomorrow / money for a trip.", expected = listOf("If it rains tomorrow, we'll cancel. If I had money for a trip, I'd go today."), focus = "first vs second", watch = "Real future takes present+will; fantasy takes past+would."), PracticeQuestion(prompt = "Firm unreal negative: lie to a client.", expected = listOf("I'd never lie to a client.", "I would never lie to a client."), focus = "I'd never", watch = "would + never + base verb."))), exercises = listOf(Exercise(id = "en-foundations-viewpoints-second-conditional-e1", kind = "choice", prompt = "If I ___ more time, I would learn the piano.", options = listOf("had", "have", "would have", "will have"), answers = listOf("had"), explain = "Unreal present: if + past simple."), Exercise(id = "en-foundations-viewpoints-second-conditional-e2", kind = "gap", prompt = "If I were you, I ___ ask for a raise.", options = listOf(), answers = listOf("would", "'d"), explain = "would in the result: I'd ask."), Exercise(id = "en-foundations-viewpoints-second-conditional-e3", kind = "order", prompt = "Ask the hypothetical question. (move / would / if / you / abroad / the chance / you / got)", options = listOf(), answers = listOf("Would you move abroad if you got the chance"), explain = "would question + if + past."), Exercise(id = "en-foundations-viewpoints-second-conditional-e4", kind = "written", prompt = "Fix: “If I would have time, I would cook.”", options = listOf(), answers = listOf("if i had time i would cook"), explain = "The if-clause takes had, never would have.")), skills = listOf("grammar:second-conditional", "grammar:first-conditional", "function:express-opinion", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:past-simple-irregular", "grammar:first-conditional")),
    Lesson(id = "en-foundations-viewpoints-passive", title = "The passive: reporting", goal = "Report information with is/are/was/were + past participle when the doer is unknown or unimportant.", intro = LessonIntro(explanation = listOf("Passive = be + past participle: “The bridge was built in 1900.” “These shoes are made in Portugal.” The doer disappears or moves to a by-phrase.", "Use it when the doer is obvious, unknown or unimportant — the classic register of news, reports and instructions.", "Questions and negatives behave like be: “Was it built recently?” “It isn't sold here.”"), examples = listOf(ExampleLine(text = "The results will be published tomorrow.", meaning = "Future passive."), ExampleLine(text = "This bridge was built in 1900.", meaning = "Past passive."), ExampleLine(text = "These shoes are made in Portugal.", meaning = "Present passive."), ExampleLine(text = "The novel was written by a nurse.", meaning = "by + the important doer."), ExampleLine(text = "Payment must be made in advance.", meaning = "Modal + passive."), ExampleLine(text = "Was the email sent?", meaning = "Passive question."))), expressions = listOf(TargetExpression(text = "is/are + participle", meaning = "Present facts.", note = "The office is cleaned daily."), TargetExpression(text = "was/were + participle", meaning = "Past events.", note = "It was designed by Gaudí."), TargetExpression(text = "will be + participle", meaning = "Future plans.", note = "The report will be shared on Monday."), TargetExpression(text = "must be + participle", meaning = "Rules and instructions.", note = "Tickets must be validated."), TargetExpression(text = "by + doer", meaning = "Only when the doer matters.", note = "Hamlet was written by Shakespeare."), TargetExpression(text = "It is said that …", meaning = "Reporting without a source.", note = "It is said that the lake is bottomless.")), situation = "You present a short report about your town's history: what was built, what is produced there and what will be opened next year.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Report a past fact: they built the theatre in 1921. (passive)", expected = listOf("The theatre was built in 1921."), focus = "was + participle", watch = "“was build” — the participle is built."), PracticeQuestion(prompt = "State a present fact: they make these shoes in Portugal. (passive)", expected = listOf("These shoes are made in Portugal."), focus = "are + participle", watch = "“are make” — participle, not base form."), PracticeQuestion(prompt = "Announce a plan: they will publish the results tomorrow. (passive)", expected = listOf("The results will be published tomorrow."), focus = "will be + participle", watch = "“will published” — be comes first: will be published."), PracticeQuestion(prompt = "State a rule: you must validate tickets. (passive)", expected = listOf("Tickets must be validated."), focus = "must be", watch = "Modal + be + participle."), PracticeQuestion(prompt = "The doer matters here. Join: “Shakespeare wrote Hamlet.” Keep Shakespeare. (passive)", expected = listOf("Hamlet was written by Shakespeare."), focus = "by + doer", watch = "by appears only when the doer is important information."), PracticeQuestion(prompt = "Ask about a past event in passive form. (the email / send)", expected = listOf("Was the email sent?"), focus = "passive question", watch = "be moves to the front: Was it sent?"))), exercises = listOf(Exercise(id = "en-foundations-viewpoints-passive-e1", kind = "choice", prompt = "These computers ___ in Taiwan.", options = listOf("are made", "are making", "made", "is made"), answers = listOf("are made"), explain = "Plural present passive: are made."), Exercise(id = "en-foundations-viewpoints-passive-e2", kind = "gap", prompt = "The parcel ___ ___ delivered tomorrow. (will, passive)", options = listOf(), answers = listOf("will be"), explain = "will be + participle."), Exercise(id = "en-foundations-viewpoints-passive-e3", kind = "order", prompt = "Report the rule.", options = listOf(), answers = listOf("Tickets must be validated before boarding"), explain = "modal + be + participle."), Exercise(id = "en-foundations-viewpoints-passive-e4", kind = "written", prompt = "Fix: “The house was build in 1990.”", options = listOf(), answers = listOf("the house was built in 1990"), explain = "build → built: the participle.")), skills = listOf("grammar:passive-intro", "grammar:past-simple-regular", "function:talk-about-work", "writing:email"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:past-simple-regular", "grammar:verb-be")),
    Lesson(id = "en-foundations-viewpoints-negotiation", title = "Negotiating", goal = "Negotiate politely: propose conditions, concede ground and close a deal.", intro = LessonIntro(explanation = listOf("Proposals soften with could/would: “Could we possibly move the deadline?” “Would it help if I took the night shift?”", "Concede with a condition: “That works if…”, “As long as…, I'm happy to…”. Push back without conflict: “I see your point, however…”", "Close: “Shall we say…?”, “So we agree on…”, “I think we have a deal.”"), examples = listOf(ExampleLine(text = "Could we possibly start at ten?", meaning = "A softened proposal."), ExampleLine(text = "That works if the report arrives on Thursday.", meaning = "A conditional yes."), ExampleLine(text = "As long as I keep Fridays free, I'm happy to travel.", meaning = "As long as = condition."), ExampleLine(text = "I see your point; however, the budget is fixed.", meaning = "Pushback without conflict."), ExampleLine(text = "What if we split the difference?", meaning = "A middle-ground move."), ExampleLine(text = "Shall we say thirty percent?", meaning = "The closing formula."))), expressions = listOf(TargetExpression(text = "Could we possibly …?", meaning = "A polite proposal.", note = "possibly = extra soft."), TargetExpression(text = "That works if …", meaning = "Yes, with a condition.", note = "Condition first, then agreement."), TargetExpression(text = "as long as …", meaning = "Your red lines.", note = "As long as costs stay under X."), TargetExpression(text = "I see your point; however …", meaning = "Respectful disagreement.", note = "Acknowledge, then contrast."), TargetExpression(text = "What if we …?", meaning = "Offer a middle path.", note = "What if we split the costs?"), TargetExpression(text = "Shall we say …?", meaning = "Close the deal.", note = "Numbers finish negotiations.")), situation = "You negotiate a remote-work arrangement with your manager: propose, concede, push back once and close with a concrete deal.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Politely propose a later start time.", expected = listOf("Could we possibly start at ten?", "Would it be possible to start later?"), focus = "softened proposal", watch = "Bare commands sound abrupt in negotiation; use could/would."), PracticeQuestion(prompt = "Accept travelling, with one condition. (as long as)", expected = listOf("That works as long as I keep Fridays free.", "As long as costs are covered, I'm happy to travel."), focus = "as long as", watch = "as long as + present simple for your condition."), PracticeQuestion(prompt = "Disagree respectfully with a tight deadline.", expected = listOf("I see your point; however, the deadline is too tight.", "I understand, however we need two more days."), focus = "acknowledge + however", watch = "Acknowledge first — however lands softer after agreement words."), PracticeQuestion(prompt = "Offer a middle ground on price.", expected = listOf("What if we split the difference?", "What if we meet in the middle?"), focus = "what if", watch = "what if + present simple proposes the path."), PracticeQuestion(prompt = "Close the deal on a number. (thirty percent)", expected = listOf("Shall we say thirty percent?"), focus = "closing", watch = "shall we say + the final number."), PracticeQuestion(prompt = "State the deal you both reached.", expected = listOf("So we agree on: remote Mondays and a Thursday report.", "So we agree: I travel twice a month, you cover the costs."), focus = "summarising", watch = "Good negotiators summarise: “So we agree on…”."))), exercises = listOf(Exercise(id = "en-foundations-viewpoints-negotiation-e1", kind = "choice", prompt = "___ we possibly move the meeting to Thursday?", options = listOf("Could", "Must", "Will", "Should"), answers = listOf("Could"), explain = "Could we possibly…? is the softest proposal."), Exercise(id = "en-foundations-viewpoints-negotiation-e2", kind = "gap", prompt = "That works ___ ___ as the budget is approved. (2 words: condition)", options = listOf(), answers = listOf("as long", "so long"), explain = "as long as / so long as = siempre que."), Exercise(id = "en-foundations-viewpoints-negotiation-e3", kind = "order", prompt = "Respectfully disagree.", options = listOf(), answers = listOf("I see your point however the budget is fixed"), explain = "Acknowledge, then contrast."), Exercise(id = "en-foundations-viewpoints-negotiation-e4", kind = "written", prompt = "Close a deal at ten percent.", options = listOf(), answers = listOf("shall we say ten percent", "shall we say 10 percent", "shall we say 10%"), explain = "Shall we say + number closes it.")), skills = listOf("function:negotiate", "grammar:second-conditional", "grammar:connectors", "speaking:negotiate", "vocab:work"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors", "grammar:modal-should"))))
}

object EnFoundationsMedia {
    val unit = CourseUnit(id = "en-foundations-media", title = "Media & argument", subtitle = "News, claims, debate", level = "B2", themes = listOf(ConversationTheme("editorial-meeting", "The editorial meeting", "What's the story?", "newspaper", "Course", "You pitch a story: what happened, why now, why anyone should care — in ninety seconds.", 0),
                ConversationTheme("letters-page", "The letters page", "Claim and counter", "envelope", "Course", "You respond to an opinion piece: concede a point, then dismantle it politely.", 1)), lessons = listOf(    Lesson(id = "en-foundations-media-news-language", title = "The language of news", goal = "Read and report news: passive reporting, headline grammar and attribution.", intro = LessonIntro(explanation = listOf("Headlines drop words: “Bridge reopened after repairs” = The bridge has been reopened. Learn to expand them.", "Attribution protects reporters: “It is believed that…”, “according to sources”. Nobody said it; it is said.", "The passive rules news because events matter more than doers: “Measures were announced” — by whom, later, maybe."), examples = listOf(ExampleLine(text = "Bridge reopened after repairs.", meaning = "A headline: expand to a full sentence."), ExampleLine(text = "It is believed that costs will fall.", meaning = "Attribution without a source."), ExampleLine(text = "Measures were announced on Tuesday.", meaning = "Event-focused passive."), ExampleLine(text = "The minister is thought to favour delays.", meaning = "is thought to + verb."), ExampleLine(text = "According to the report, numbers fell.", meaning = "according to = the source."))), expressions = listOf(TargetExpression(text = "… was/were + participle", meaning = "The reporting backbone.", note = "The road was closed."), TargetExpression(text = "It is said/believed that …", meaning = "Source-free attribution.", note = "It is believed that…"), TargetExpression(text = "is thought to + verb", meaning = "Report others' claims.", note = "He is thought to have left."), TargetExpression(text = "according to …", meaning = "Name the source.", note = "according to the report."), TargetExpression(text = "are expected to + verb", meaning = "Predictions from others.", note = "Talks are expected to continue."), TargetExpression(text = "Headline → sentence", meaning = "Expand dropped words.", note = "“Man rescues cat” = A man has rescued a cat.")), situation = "You brief a colleague on this morning's news: expand three headlines into full sentences and attribute every claim you can't verify.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Expand the headline: “Bridge reopened”.", expected = listOf("The bridge has been reopened."), focus = "headline → sentence", watch = "Add the dropped words: has been + participle."), PracticeQuestion(prompt = "Report unverified costs. (it / believe)", expected = listOf("It is believed that costs will fall."), focus = "attribution", watch = "It is believed protects the speaker."), PracticeQuestion(prompt = "Attribute a number to its source. (report)", expected = listOf("According to the report, sales fell by 10%."), focus = "according to", watch = "according to names the source."), PracticeQuestion(prompt = "Report what people think about the minister. (thought / delay)", expected = listOf("The minister is thought to favour delays."), focus = "is thought to", watch = "is thought to have + participle for past acts."), PracticeQuestion(prompt = "Report expected talks.", expected = listOf("Talks are expected to continue."), focus = "are expected to", watch = "Passive prediction: nobody predicts, it is expected."))), exercises = listOf(Exercise(id = "en-foundations-media-news-language-e1", kind = "choice", prompt = "The road ___ closed since March.", options = listOf("has been", "is been", "was being", "had being"), answers = listOf("has been"), explain = "Present perfect passive: has been closed."), Exercise(id = "en-foundations-media-news-language-e2", kind = "gap", prompt = "It is ___ that costs will fall. (believe)", options = listOf(), answers = listOf("believed"), explain = "It is believed that…"), Exercise(id = "en-foundations-media-news-language-e3", kind = "order", prompt = "Expand the headline.", options = listOf(), answers = listOf("The bridge has been reopened after repairs"), explain = "has been + participle + detail."), Exercise(id = "en-foundations-media-news-language-e4", kind = "written", prompt = "Attribute the fall to the report.", options = listOf(), answers = listOf("according to the report sales fell", "sales fell according to the report"), explain = "according to + source.")), skills = listOf("grammar:passive-intro", "grammar:present-perfect", "grammar:relative-clauses", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "en-foundations-media-opinion-pieces", title = "Opinion pieces", goal = "Build a written argument: claim, support, concession, rebuttal.", intro = LessonIntro(explanation = listOf("The four-move structure: claim (“Remote work is here to stay”), support (evidence), concession (“Admittedly, not every job…”), rebuttal (“But the trend is clear”).", "Concession words buy credibility: admittedly, granted, while it's true that… — you look fair before you disagree.", "Endings circle back: “For all its flaws, the evidence points one way.” Repeat the claim, changed by everything before it."), examples = listOf(ExampleLine(text = "Remote work is here to stay.", meaning = "The claim — short and bare."), ExampleLine(text = "Studies show a 13% productivity rise.", meaning = "Support with numbers."), ExampleLine(text = "Admittedly, not every job can be remote.", meaning = "The concession."), ExampleLine(text = "But the trend is unmistakable.", meaning = "The rebuttal."), ExampleLine(text = "For all its flaws, the evidence points one way.", meaning = "The circular close."))), expressions = listOf(TargetExpression(text = "The claim: …", meaning = "State it bare.", note = "One sentence, no hedging yet."), TargetExpression(text = "Support: studies show / data suggests", meaning = "Bring evidence.", note = "Numbers beat adjectives."), TargetExpression(text = "Admittedly, … / Granted, …", meaning = "Concede fairly.", note = "Fairness buys trust."), TargetExpression(text = "But / However, …", meaning = "Rebut.", note = "But the core point stands."), TargetExpression(text = "For all its flaws, …", meaning = "Circle back.", note = "The claim, transformed.")), situation = "You draft a 120-word opinion piece on four-day weeks: claim, one piece of support, one fair concession, one rebuttal, one close.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "State your claim about four-day weeks. (here to stay)", expected = listOf("Four-day weeks are here to stay."), focus = "the claim", watch = "Short. Bare. Debatable."), PracticeQuestion(prompt = "Add one number as support.", expected = listOf("Trials report a 13% productivity rise."), focus = "support", watch = "A number does the arguing for you."), PracticeQuestion(prompt = "Concede fairly: not every job. (admittedly)", expected = listOf("Admittedly, not every job can be done remotely."), focus = "the concession", watch = "admittedly + the strongest counter-case."), PracticeQuestion(prompt = "Rebut the concession. (but / trend)", expected = listOf("But the trend is unmistakable."), focus = "the rebuttal", watch = "However also works — but is punchier."), PracticeQuestion(prompt = "Close by circling back.", expected = listOf("For all its flaws, the evidence points one way."), focus = "the close", watch = "The claim returns, stronger."))), exercises = listOf(Exercise(id = "en-foundations-media-opinion-pieces-e1", kind = "choice", prompt = "___ not every job can be remote, the trend is clear.", options = listOf("Admittedly", "Because", "So", "Unless"), answers = listOf("Admittedly"), explain = "admittedly concedes before rebutting."), Exercise(id = "en-foundations-media-opinion-pieces-e2", kind = "gap", prompt = "Studies ___ a 13% productivity rise. (show)", options = listOf(), answers = listOf("show"), explain = "studies show + number."), Exercise(id = "en-foundations-media-opinion-pieces-e3", kind = "order", prompt = "The circular close.", options = listOf(), answers = listOf("For all its flaws the evidence points one way"), explain = "for all its flaws + claim."), Exercise(id = "en-foundations-media-opinion-pieces-e4", kind = "written", prompt = "State your claim about four-day weeks.", options = listOf(), answers = listOf("four-day weeks are here to stay", "four day weeks are here to stay"), explain = "Short, bare, debatable.")), skills = listOf("writing:argument", "grammar:connectors", "function:express-opinion", "speaking:justify-opinion", "vocab:work"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:first-conditional"))))
}

object EnFoundationsInnovation {
    val unit = CourseUnit(id = "en-foundations-innovation", title = "Innovation & change", subtitle = "Ideas, reports, predictions", level = "B2", themes = listOf(ConversationTheme("the-pitch-night", "The pitch night", "Sell the idea", "lightbulb", "Course", "Start-up night: ninety seconds, three judges, one idea — you compress its whole history into a single clause and claim the credit precisely.", 0),
                ConversationTheme("the-forecast-desk", "The forecast desk", "Report and predict", "chart.line.uptrend.xyaxis", "Course", "The tech desk, 8:30: attribute every rumour, hedge every forecast and commit to nothing you cannot defend by lunchtime.", 1)), lessons = listOf(    Lesson(id = "en-foundations-innovation-relative-clauses", title = "Clauses that do the work", goal = "Pack a whole story into one clause: participle clauses, preposition + whom, non-defining asides.", intro = LessonIntro(explanation = listOf("Participle clauses compress: \"a company founded in a garage\" = that was founded; \"the engineer running the demo\" = who is running — fewer words, same story.", "Formal English attaches the preposition to a pronoun: \"the colleague with whom I built it\"; everyday English splits it: \"the colleague I built it with\" — both correct, different registers.", "Non-defining clauses comment between commas: \"Our first product, which failed in 2019, taught us everything\" — delete the clause and the sentence still stands."), examples = listOf(ExampleLine(text = "It's a company founded in a garage.", meaning = "founded = that was founded."), ExampleLine(text = "She's the engineer running the demo.", meaning = "running = who is running."), ExampleLine(text = "The investor with whom we signed left yesterday.", meaning = "Preposition + whom: formal register."), ExampleLine(text = "Our first product, which failed in 2019, taught us everything.", meaning = "The aside between commas."), ExampleLine(text = "The market it aims at is huge.", meaning = "Everyday split preposition."))), expressions = listOf(TargetExpression(text = "noun + founded/built/launched in …", meaning = "Compressed history.", note = "a start-up founded in 2020"), TargetExpression(text = "noun + running/leading …", meaning = "Compressed present.", note = "the team running the pilot"), TargetExpression(text = "with/at/to whom/which …", meaning = "Formal attachment.", note = "the partner with whom we signed"), TargetExpression(text = ", which …,", meaning = "The aside between commas.", note = "The idea, which seemed crazy, worked."), TargetExpression(text = "the … it aims at", meaning = "Everyday split.", note = "the niche it aims at")), situation = "Ninety seconds before the pitch: you rebuild your key sentence so the company's history, the team and the market each fit inside one tight clause.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Compress: a company that was founded in 2019.", expected = listOf("a company founded in 2019", "It's a company founded in 2019."), focus = "participle clause", watch = "founded = that was founded: one word fewer, same facts."), PracticeQuestion(prompt = "Compress: the engineer who is running the demo.", expected = listOf("the engineer running the demo", "She's the engineer running the demo."), focus = "present participle", watch = "-ing carries the present inside the clause."), PracticeQuestion(prompt = "Formal register: mention the investor you signed with.", expected = listOf("The investor with whom we signed left yesterday.", "the investor with whom we signed"), focus = "preposition + whom", watch = "Formal English keeps the preposition glued to whom."), PracticeQuestion(prompt = "Add the aside: the product failed in 2019 — and it taught you everything.", expected = listOf("Our first product, which failed in 2019, taught us everything."), focus = ", which …,", watch = "Non-defining: commas on both sides; the sentence stands without it."), PracticeQuestion(prompt = "Everyday style: name the market they aim at.", expected = listOf("The market they aim at is huge.", "The market it aims at is huge."), focus = "split preposition", watch = "Everyday English leaves the preposition at the end."))), exercises = listOf(Exercise(id = "en-foundations-innovation-relative-clauses-e1", kind = "choice", prompt = "The start-up ___ in a garage is now worth millions.", options = listOf("founded", "found", "founding", "was founded"), answers = listOf("founded"), explain = "Past participle clause: founded = that was founded."), Exercise(id = "en-foundations-innovation-relative-clauses-e2", kind = "gap", prompt = "She's the engineer ___ the demo right now. (run, -ing)", options = listOf(), answers = listOf("running"), explain = "Present participle: running = who is running."), Exercise(id = "en-foundations-innovation-relative-clauses-e3", kind = "order", prompt = "The formal aside about the failed first product.", options = listOf(), answers = listOf("Our first product which failed in 2019 taught us everything"), explain = "Non-defining clause: the aside that sits between commas."), Exercise(id = "en-foundations-innovation-relative-clauses-e4", kind = "written", prompt = "Formal register: name the partner you built it with.", options = listOf(), answers = listOf("the partner with whom i built it", "the colleague with whom i built it"), explain = "Preposition + whom: the formal attachment.")), skills = listOf("grammar:relative-clauses", "function:talk-about-work", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:relative-clauses")),
    Lesson(id = "en-foundations-innovation-reporting", title = "It is said that…", goal = "Report without sourcing: passive reporting frames for rumours, deals and resignations.", intro = LessonIntro(explanation = listOf("Two passive frames carry every rumour: \"It is said that the deal is close\" (the front door) and \"The deal is said to be close\" (the headline door) — same whisper, two windows.", "Past events shift inside the infinitive: \"She is thought to have turned down the offer\" — to have + participle holds the past.", "The passive keeps the reporter out: \"It has been reported that two firms will merge\" — nobody said it; it is reported. That distance is the point."), examples = listOf(ExampleLine(text = "It is said that the deal is close.", meaning = "Front-door frame."), ExampleLine(text = "The deal is said to be close.", meaning = "The same rumour, flipped to headline form."), ExampleLine(text = "It is believed that costs will fall.", meaning = "A belief with no believer."), ExampleLine(text = "She is thought to have turned down the offer.", meaning = "Past inside to have + participle."), ExampleLine(text = "It has been reported that two firms will merge.", meaning = "News-desk distance."))), expressions = listOf(TargetExpression(text = "It is said/believed that …", meaning = "Report without a source.", note = "It is said that…"), TargetExpression(text = "X is said to be …", meaning = "The rumour, flipped.", note = "The deal is said to be close."), TargetExpression(text = "X is thought to have + participle", meaning = "Flip a past claim.", note = "He is thought to have left."), TargetExpression(text = "It is reported that …", meaning = "News-desk distance.", note = "It is reported that…"), TargetExpression(text = "X is expected to + verb", meaning = "Someone's prediction, no someone.", note = "Prices are expected to rise.")), situation = "Morning tech desk, three rumours and one resignation: you reframe each claim twice — it is said that… for the intro, is said to be… for the headline.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Report: the deal is close — people say so. (front door)", expected = listOf("It is said that the deal is close."), focus = "it is said that", watch = "it is said that + full clause: no source, no blame."), PracticeQuestion(prompt = "Same rumour — flip it to headline form. (the deal)", expected = listOf("The deal is said to be close."), focus = "is said to be", watch = "X is said to be + the claim: the headline door."), PracticeQuestion(prompt = "Report the belief: costs will fall. (believe)", expected = listOf("It is believed that costs will fall."), focus = "it is believed", watch = "it is believed that: belief without a believer."), PracticeQuestion(prompt = "She turned down the offer — people think so. Flip it.", expected = listOf("She is thought to have turned down the offer."), focus = "is thought to have + participle", watch = "to have + participle: the past lives inside the infinitive."), PracticeQuestion(prompt = "Report the prediction: prices will rise. (expect)", expected = listOf("Prices are expected to rise."), focus = "are expected to", watch = "Nobody predicts; it is expected — the passive keeps hands clean."))), exercises = listOf(Exercise(id = "en-foundations-innovation-reporting-e1", kind = "choice", prompt = "It ___ said that the merger is off.", options = listOf("is", "has", "was being", "does"), answers = listOf("is"), explain = "it is said that: the present passive reporting frame."), Exercise(id = "en-foundations-innovation-reporting-e2", kind = "gap", prompt = "The CEO is ___ to have resigned. (report)", options = listOf(), answers = listOf("reported"), explain = "is reported to have + participle: past claim, flipped."), Exercise(id = "en-foundations-innovation-reporting-e3", kind = "order", prompt = "Flip the rumour to headline form.", options = listOf(), answers = listOf("The deal is said to be close"), explain = "X is said to be + the claim: the headline door."), Exercise(id = "en-foundations-innovation-reporting-e4", kind = "written", prompt = "Report the belief: the start-up will fail.", options = listOf(), answers = listOf("it is believed that the start-up will fail", "it is believed the start-up will fail"), explain = "it is believed that + the claim.")), skills = listOf("grammar:passive-reporting", "grammar:passive-intro", "vocab:work", "function:talk-about-work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:passive-intro")),
    Lesson(id = "en-foundations-innovation-speculation", title = "Likely, unlikely, bound to", goal = "Forecast with calibrated confidence: may well, is likely to, is bound to, can't be.", intro = LessonIntro(explanation = listOf("Rank your confidence: might well < may well < is likely to < is bound to — from \"possible\" to \"inevitable, given the evidence\".", "Modal + adverb slides the dial: \"could easily fail\", \"may well succeed\", \"can't possibly work\" — the adverb carries the attitude.", "Ruling things out has its own form: \"That can't be the launch date — the team only started last week\" — can't be means impossible, not merely doubtful."), examples = listOf(ExampleLine(text = "The app is likely to take off among students.", meaning = "likely to + verb: probable."), ExampleLine(text = "A buyout is unlikely before summer.", meaning = "unlikely: probable that it won't."), ExampleLine(text = "The deal may well collapse.", meaning = "may well: a solid possibility."), ExampleLine(text = "It's bound to happen — the tech already exists.", meaning = "bound to: inevitable."), ExampleLine(text = "That can't be the final figure.", meaning = "can't be: rule it out."))), expressions = listOf(TargetExpression(text = "be likely / unlikely to …", meaning = "The forecast dial.", note = "Prices are likely to rise."), TargetExpression(text = "may / might well + verb", meaning = "A solid possibility.", note = "It may well work."), TargetExpression(text = "be bound to + verb", meaning = "Inevitable, given the evidence.", note = "It's bound to sell."), TargetExpression(text = "can't be …", meaning = "Impossible — rule it out.", note = "That can't be right."), TargetExpression(text = "could easily + verb", meaning = "One nudge from happening.", note = "It could easily fail.")), situation = "Forecast meeting, three products on the docket: one is likely to fly, one is bound to stall, one you simply rule out — and every verdict carries its exact confidence level.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Forecast: the app takes off among students — probable. (likely)", expected = listOf("The app is likely to take off among students.", "The app is likely to take off."), focus = "be likely to", watch = "be + likely + to + verb: the workhorse forecast."), PracticeQuestion(prompt = "A buyout probably won't happen before summer. (unlikely)", expected = listOf("A buyout is unlikely before summer.", "A buyout is unlikely to happen before summer."), focus = "unlikely", watch = "unlikely before a noun phrase, or unlikely to + verb — both native."), PracticeQuestion(prompt = "Say the deal might genuinely collapse. (may well)", expected = listOf("The deal may well collapse."), focus = "may well", watch = "may well = a real possibility, stronger than might."), PracticeQuestion(prompt = "The tech already exists: call the launch inevitable. (bound to)", expected = listOf("It's bound to happen.", "The launch is bound to happen."), focus = "bound to", watch = "bound to = inevitable, given the evidence."), PracticeQuestion(prompt = "Rule out that launch date — the team only started last week. (can't)", expected = listOf("That can't be the launch date.", "That can't be the date."), focus = "can't be", watch = "can't be = impossible; might not be would only mean doubtful."))), exercises = listOf(Exercise(id = "en-foundations-innovation-speculation-e1", kind = "choice", prompt = "The start-up is ___ to succeed, but nothing is certain yet.", options = listOf("likely", "bound", "sure", "must"), answers = listOf("likely"), explain = "be likely to + verb: probable — which is why certainty is excluded."), Exercise(id = "en-foundations-innovation-speculation-e2", kind = "gap", prompt = "It ___ well fail — the prototype barely works. (possibility)", options = listOf(), answers = listOf("may", "might"), explain = "may/might well: a solid possibility."), Exercise(id = "en-foundations-innovation-speculation-e3", kind = "order", prompt = "Rule out that figure.", options = listOf(), answers = listOf("That cant be the final figure"), explain = "can't be = impossible, not merely doubtful."), Exercise(id = "en-foundations-innovation-speculation-e4", kind = "written", prompt = "Forecast the rise in prices: probable. (likely)", options = listOf(), answers = listOf("prices are likely to rise", "prices are likely to go up"), explain = "be likely to + verb: the calibrated forecast.")), skills = listOf("grammar:speculation", "grammar:modal-must-have-to", "function:express-opinion", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:modal-must-have-to"))))
}

object EnFoundationsNuance {
    val unit = CourseUnit(id = "en-foundations-nuance", title = "Nuance & register", subtitle = "Say it the better way", level = "C1", themes = listOf(ConversationTheme("formal-swap", "The register swap", "Same idea, different room", "arrow.triangle.swap", "Course", "You rephrase the same message for different audiences: a friend, a client, a complaint, a keynote.", 0),
                ConversationTheme("idiom-lab", "The idiom lab", "Sound natural", "text.bubble", "Course", "You upgrade literal sentences with natural chunks and idioms — carefully, one at a time.", 1)), lessons = listOf(    Lesson(id = "en-foundations-nuance-register", title = "Register: formal vs informal", goal = "Rephrase the same message for different audiences and levels of formality.", intro = LessonIntro(explanation = listOf("Informal leans on phrasal verbs and contractions: “We'll set up a call.” Formal prefers single verbs: “We will arrange a call.”", "Requests climb the ladder of politeness: “Send it” → “Can you send it?” → “Could you send it?” → “I would be grateful if you could send it.”", "Written formality also changes vocabulary: get → receive, help → assistance, but → however, kids → children."), examples = listOf(ExampleLine(text = "We'll set up a call tomorrow. (informal)", meaning = "Phrasal + contraction."), ExampleLine(text = "We will arrange a call tomorrow. (formal)", meaning = "Single verb, no contraction."), ExampleLine(text = "Can you send the invoice?", meaning = "Neutral request."), ExampleLine(text = "I would be grateful if you could send the invoice.", meaning = "Formal request."), ExampleLine(text = "Sorry, that doesn't work for me. (informal)", meaning = "Soft refusal."), ExampleLine(text = "Unfortunately, that arrangement is not feasible. (formal)", meaning = "Formal refusal."))), expressions = listOf(TargetExpression(text = "set up vs arrange", meaning = "Phrasal informal, single verb formal.", note = "Same meaning, different room."), TargetExpression(text = "I would be grateful if you could …", meaning = "The formal request.", note = "Emails, clients, institutions."), TargetExpression(text = "Unfortunately, … is not feasible.", meaning = "The formal no.", note = "feasible = possible/viable."), TargetExpression(text = "get → receive", meaning = "Upgrade everyday verbs.", note = "We received your message."), TargetExpression(text = "kids → children", meaning = "Register-sensitive nouns.", note = "Formal writing avoids kids."), TargetExpression(text = "Sorry about that → I apologise for the inconvenience.", meaning = "Apology ladder.", note = "Match the damage.")), situation = "One message, three rooms: say the same cancellation to a friend, then to a client, then in a formal complaint — and feel the register move.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Say informally that you'll organise a call.", expected = listOf("I'll set up a call.", "We'll set up a call."), focus = "informal register", watch = "Phrasal verbs + contractions are the informal markers."), PracticeQuestion(prompt = "Now say it formally. (arrange)", expected = listOf("We will arrange a call.", "I will arrange a call."), focus = "formal register", watch = "Single verb, no contraction."), PracticeQuestion(prompt = "Make this formal: “Can you send the report?”", expected = listOf("I would be grateful if you could send the report.", "Could you please send the report?"), focus = "request ladder", watch = "would be grateful is the top rung for email."), PracticeQuestion(prompt = "Refuse formally: the arrangement doesn't work.", expected = listOf("Unfortunately, that arrangement is not feasible.", "Unfortunately, we are unable to accept the arrangement."), focus = "formal refusal", watch = "Formal refusals start with unfortunately and avoid contractions."), PracticeQuestion(prompt = "Make this formal: “Sorry about the delay.”", expected = listOf("I apologise for the delay.", "Please accept my apologies for the delay."), focus = "apology ladder", watch = "Match formality to the damage."), PracticeQuestion(prompt = "Spot the register: “We received your message” vs “We got your message”.", expected = listOf("we received your message is formal", "we got your message is informal"), focus = "get vs receive", watch = "Same meaning; receive belongs to formal writing."))), exercises = listOf(Exercise(id = "en-foundations-nuance-register-e1", kind = "choice", prompt = "Which is the FORMAL request?", options = listOf("I would be grateful if you could reply.", "Can you reply?", "Reply please.", "Reply when you can!"), answers = listOf("I would be grateful if you could reply."), explain = "would be grateful marks formal register."), Exercise(id = "en-foundations-nuance-register-e2", kind = "gap", prompt = "Formal single verb: We will ___ a meeting. (phrasal: set up)", options = listOf(), answers = listOf("arrange", "organise", "organize"), explain = "set up → arrange/organise."), Exercise(id = "en-foundations-nuance-register-e3", kind = "order", prompt = "Formal apology.", options = listOf(), answers = listOf("I apologise for the inconvenience"), explain = "The formal apology formula."), Exercise(id = "en-foundations-nuance-register-e4", kind = "written", prompt = "Make it formal: “We got your email.”", options = listOf(), answers = listOf("we received your email", "we have received your email"), explain = "get → receive.")), skills = listOf("vocab:social-expressions", "function:negotiate", "writing:email", "function:talk-about-work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors", "grammar:modal-must-have-to")),
    Lesson(id = "en-foundations-nuance-chunks", title = "Natural chunks", goal = "Replace literal sentences with natural chunks and idioms — precisely, not decoratively.", intro = LessonIntro(explanation = listOf("Chunks are ready-made phrases native speakers reach for: “It depends.” “That makes sense.” “As far as I know…” “I'm not sure about that.”", "Idioms carry culture and risk: “It's a grey area” is safe and useful; rare or dated idioms can sound costume-y. One per conversation is plenty.", "Upgrading literal speech: “I don't decide yet” → “I'm still on the fence.” The chunk must match the meaning exactly."), examples = listOf(ExampleLine(text = "It depends on the weather.", meaning = "The universal answer chunk."), ExampleLine(text = "That makes sense.", meaning = "Accepting an explanation."), ExampleLine(text = "As far as I know, the flight is on time.", meaning = "Limited certainty."), ExampleLine(text = "I'm still on the fence.", meaning = "Undecided."), ExampleLine(text = "It's a bit of a grey area.", meaning = "Not clearly one thing or the other."), ExampleLine(text = "Let's play it by ear.", meaning = "Decide as things happen."))), expressions = listOf(TargetExpression(text = "It depends.", meaning = "Conditional answer.", note = "…on + factor: on the price."), TargetExpression(text = "That makes sense.", meaning = "Understanding confirmed.", note = "Never “it has sense”."), TargetExpression(text = "As far as I know, …", meaning = "Soften a claim.", note = "Knowledge may be incomplete."), TargetExpression(text = "I'm on the fence.", meaning = "No decision yet.", note = "Sitting between two options."), TargetExpression(text = "a grey area", meaning = "Unclear rules or meaning.", note = "The law here is a grey area."), TargetExpression(text = "play it by ear", meaning = "Improvise the plan.", note = "No fixed script.")), situation = "You coach a colleague before a difficult meeting: swap their literal lines for natural chunks — and decide which idioms to avoid.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Answer naturally when asked if remote work is better.", expected = listOf("It depends.", "It depends on the job."), focus = "it depends", watch = "“It depends of” — English takes on."), PracticeQuestion(prompt = "Confirm you understood the explanation.", expected = listOf("That makes sense."), focus = "makes sense", watch = "Never “it has sense” — the chunk is makes sense."), PracticeQuestion(prompt = "Soften a claim about tomorrow's schedule.", expected = listOf("As far as I know, it's free.", "As far as I know, the schedule hasn't changed."), focus = "limited certainty", watch = "The chunk admits your knowledge might be incomplete."), PracticeQuestion(prompt = "Say you haven't decided between the two offers.", expected = listOf("I'm still on the fence."), focus = "undecided", watch = "The fence sits between two options — that's the image."), PracticeQuestion(prompt = "Say the rule is unclear. (idiom)", expected = listOf("It's a bit of a grey area.", "It's a grey area."), focus = "grey area", watch = "grey (BrE) or gray (AmE) — both fine."), PracticeQuestion(prompt = "Say you'll decide as things happen. (idiom)", expected = listOf("Let's play it by ear.", "We'll play it by ear."), focus = "play it by ear", watch = "ear, not year — it comes from music."))), exercises = listOf(Exercise(id = "en-foundations-nuance-chunks-e1", kind = "choice", prompt = "Which chunk means “no decision yet”?", options = listOf("I'm on the fence.", "It's a grey area.", "It depends.", "That makes sense."), answers = listOf("I'm on the fence."), explain = "On the fence = between two options, undecided."), Exercise(id = "en-foundations-nuance-chunks-e2", kind = "gap", prompt = "That ___ sense — thanks for explaining.", options = listOf(), answers = listOf("makes"), explain = "makes sense, never has sense."), Exercise(id = "en-foundations-nuance-chunks-e3", kind = "order", prompt = "Soften your claim about the flight.", options = listOf(), answers = listOf("As far as I know the flight is on time"), explain = "as far as I know + the claim."), Exercise(id = "en-foundations-nuance-chunks-e4", kind = "written", prompt = "Fix: “It depends of the price.”", options = listOf(), answers = listOf("it depends on the price"), explain = "depend on + factor.")), skills = listOf("vocab:social-expressions", "function:express-opinion", "speaking:sustained-conversation", "writing:argument"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "en-foundations-nuance-hedging", title = "Hedging & precision", goal = "Fine-tune opinions: soften, intensify and qualify like a confident speaker.", intro = LessonIntro(explanation = listOf("Hedging protects accuracy: “tends to”, “to some extent”, “arguably”, “in most cases”. Strong claims need strong evidence — otherwise hedge.", "Intensifiers scale: slightly < rather < considerably < far. “Far more efficient” is stronger than “slightly more efficient”.", "Precision beats intensity: “a threefold increase” > “a lot more”. Numbers, examples and scope (“in this case”) make opinions defensible."), examples = listOf(ExampleLine(text = "This approach tends to work better.", meaning = "A hedged claim."), ExampleLine(text = "To some extent, I agree.", meaning = "Partial agreement."), ExampleLine(text = "Arguably, it's the best option on the table.", meaning = "Opinion with room."), ExampleLine(text = "The new version is far more stable.", meaning = "A strong, clear difference."), ExampleLine(text = "Costs fell by roughly a third.", meaning = "Precision with a number."), ExampleLine(text = "In this specific case, I'd wait.", meaning = "Scope limiting."))), expressions = listOf(TargetExpression(text = "tends to + verb", meaning = "General pattern, not law.", note = "Prices tend to rise in summer."), TargetExpression(text = "to some extent / to a degree", meaning = "Partial truth.", note = "Agreement with reservations."), TargetExpression(text = "arguably", meaning = "Defensible opinion.", note = "Arguably the best paella in town."), TargetExpression(text = "slightly / rather / considerably / far", meaning = "The intensity scale.", note = "far > considerably > rather > slightly."), TargetExpression(text = "by roughly a third", meaning = "Approximate precision.", note = "roughly, about, approximately."), TargetExpression(text = "in this specific case", meaning = "Limit the scope.", note = "No universal claims.")), situation = "You present an opinion to a skeptical audience: claim, hedge, quantify and limit scope — then defend it once challenged.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Hedge a claim about remote productivity.", expected = listOf("Remote work tends to increase productivity.", "It tends to work better for focused tasks."), focus = "tends to", watch = "tends to + base verb softens the pattern without killing it."), PracticeQuestion(prompt = "Agree, but only partly.", expected = listOf("To some extent, I agree.", "I agree to a degree."), focus = "partial agreement", watch = "The quantifier keeps the disagreement alive."), PracticeQuestion(prompt = "Give a defensible superlative opinion about a restaurant.", expected = listOf("Arguably, it's the best ramen in the city."), focus = "arguably", watch = "arguably signals: I can defend this."), PracticeQuestion(prompt = "Rank the intensifiers: slightly / far / rather. (weakest to strongest)", expected = listOf("slightly, rather, far"), focus = "intensity scale", watch = "slightly < rather < considerably < far."), PracticeQuestion(prompt = "Be precise about a cost drop: from 90 to 60. (roughly)", expected = listOf("Costs fell by roughly a third."), focus = "approximate numbers", watch = "roughly + fraction beats “a lot less”."), PracticeQuestion(prompt = "Limit your advice so it isn't universal.", expected = listOf("In this specific case, I'd wait.", "In this case, I'd wait before deciding."), focus = "scope", watch = "in this case protects the advice from other contexts."))), exercises = listOf(Exercise(id = "en-foundations-nuance-hedging-e1", kind = "choice", prompt = "Which claim is the most hedged?", options = listOf("It tends to work better.", "It always works.", "It works.", "It never fails."), answers = listOf("It tends to work better."), explain = "tends to is the hedged pattern claim."), Exercise(id = "en-foundations-nuance-hedging-e2", kind = "gap", prompt = "The new engine is ___ more efficient. (strongest intensifier)", options = listOf(), answers = listOf("far", "considerably"), explain = "far (or considerably) is stronger than slightly."), Exercise(id = "en-foundations-nuance-hedging-e3", kind = "order", prompt = "Give a partial agreement.", options = listOf(), answers = listOf("To some extent I agree"), explain = "to some extent + I agree."), Exercise(id = "en-foundations-nuance-hedging-e4", kind = "written", prompt = "Fix: “It depends of the context.”", options = listOf(), answers = listOf("it depends on the context"), explain = "depend on — the preposition is on.")), skills = listOf("grammar:connectors", "function:express-opinion", "speaking:justify-opinion", "writing:argument"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "en-foundations-nuance-academic", title = "The academic voice", goal = "State positions in academic and professional registers: impersonal, evidenced, measured.", intro = LessonIntro(explanation = listOf("The academic voice removes the “I”: “This paper argues that…”, “The data suggests…”, “It has been observed that…”. The claim carries the sentence, not the person.", "Evidence verbs scale certainty: demonstrate > suggest > indicate > appear to. Choose the verb that matches the strength of your data.", "Structure is visible: “First… Second… Taken together, these findings…” — the reader should always know where they are."), examples = listOf(ExampleLine(text = "This paper argues that hybrid models outperform either extreme.", meaning = "The thesis sentence."), ExampleLine(text = "The data suggests a modest effect.", meaning = "suggests = careful."), ExampleLine(text = "The results demonstrate a clear correlation.", meaning = "demonstrate = strong evidence."), ExampleLine(text = "It has been observed that remote teams innovate differently.", meaning = "Impersonal passive reporting."), ExampleLine(text = "Taken together, these findings point to a structural cause.", meaning = "Synthesis marker."), ExampleLine(text = "Further research is needed to confirm the effect.", meaning = "The classic closing hedge."))), expressions = listOf(TargetExpression(text = "This paper/chapter argues that …", meaning = "State the thesis.", note = "argue = defend a position."), TargetExpression(text = "The data suggests / demonstrates …", meaning = "Certainty scaled to evidence.", note = "Choose the honest verb."), TargetExpression(text = "It has been observed that …", meaning = "Impersonal reporting.", note = "Passive keeps the I out."), TargetExpression(text = "Taken together, …", meaning = "Synthesise several points.", note = "Ends the middle, opens the close."), TargetExpression(text = "Further research is needed …", meaning = "The honest limit.", note = "Every study ends here."), TargetExpression(text = "with respect to / regarding", meaning = "Formal topic shifts.", note = "Regarding costs, the picture differs.")), situation = "You present a controversial finding to a skeptical panel: thesis, evidence verbs that match your data, visible structure and an honest limit.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "State your thesis formally. (hybrid models outperform)", expected = listOf("This paper argues that hybrid models outperform either extreme."), focus = "thesis", watch = "argues that + full clause — the position, not the topic."), PracticeQuestion(prompt = "Your evidence is moderate. Choose the verb. (the data / a modest effect)", expected = listOf("The data suggests a modest effect."), focus = "scaled verbs", watch = "demonstrates would overclaim; suggests is honest."), PracticeQuestion(prompt = "Your evidence is strong. Choose the verb. (clear correlation)", expected = listOf("The results demonstrate a clear correlation."), focus = "scaled verbs", watch = "With strong data, demonstrates is the honest choice."), PracticeQuestion(prompt = "Report an observation without saying who observed it.", expected = listOf("It has been observed that remote teams innovate differently."), focus = "impersonal passive", watch = "It + has been + participle keeps the voice out."), PracticeQuestion(prompt = "Synthesise two findings into one conclusion.", expected = listOf("Taken together, these findings point to a structural cause."), focus = "synthesis", watch = "Taken together announces the synthesis."), PracticeQuestion(prompt = "Close with the honest limit of the study.", expected = listOf("Further research is needed to confirm the effect."), focus = "the limit", watch = "Every credible study admits its edge."))), exercises = listOf(Exercise(id = "en-foundations-nuance-academic-e1", kind = "choice", prompt = "The data ___ a modest effect. (moderate evidence)", options = listOf("suggests", "demonstrates", "proves", "ignores"), answers = listOf("suggests"), explain = "Moderate evidence takes suggests, not demonstrates."), Exercise(id = "en-foundations-nuance-academic-e2", kind = "gap", prompt = "It has ___ observed that remote teams innovate differently.", options = listOf(), answers = listOf("been"), explain = "Impersonal passive: has been + participle."), Exercise(id = "en-foundations-nuance-academic-e3", kind = "order", prompt = "State the thesis.", options = listOf(), answers = listOf("This paper argues that hybrid models outperform either extreme"), explain = "This paper argues that + claim."), Exercise(id = "en-foundations-nuance-academic-e4", kind = "written", prompt = "Close the study honestly.", options = listOf(), answers = listOf("further research is needed to confirm the effect", "further research is needed"), explain = "The classic honest close.")), skills = listOf("writing:argument", "grammar:passive-intro", "function:express-opinion", "function:talk-about-work", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:passive-intro", "grammar:connectors")),
    Lesson(id = "en-foundations-nuance-presenting", title = "Presenting with confidence", goal = "Signpost a talk, land key points and handle questions without losing your footing.", intro = LessonIntro(explanation = listOf("Signposts keep audiences aboard: “I'll start with…”, “That brings me to…”, “So, to sum up…”. Say where you are; nobody resents a map.", "Land key points with a pause and a restatement: “The one thing to remember is this.” Silence sells importance.", "Hard questions get a frame: “That's exactly the point — my answer is twofold.” Buying structure, not stalling."), examples = listOf(ExampleLine(text = "I'll start with why this matters.", meaning = "The opening signpost."), ExampleLine(text = "That brings me to the results.", meaning = "The transition."), ExampleLine(text = "The one thing to remember is this.", meaning = "Point-landing phrase."), ExampleLine(text = "So, to sum up: three findings, one conclusion.", meaning = "The summary signpost."), ExampleLine(text = "That's exactly the point — and my answer is twofold.", meaning = "Handling the hard question."))), expressions = listOf(TargetExpression(text = "I'll start with …", meaning = "Open the map.", note = "I'll start with the problem."), TargetExpression(text = "That brings me to …", meaning = "Transition.", note = "…to the second point."), TargetExpression(text = "The one thing to remember is …", meaning = "Land the point.", note = "Then pause. Let it sit."), TargetExpression(text = "So, to sum up …", meaning = "Signal the close.", note = "Repeat the three parts."), TargetExpression(text = "That's exactly the point.", meaning = "Own the hard question.", note = "Then answer in two parts."), TargetExpression(text = "I'm glad you asked that.", meaning = "Buy a second, kindly.", note = "Use sparingly — overdone it's a cliché.")), situation = "You present a small project to a skeptical room: signpost the three parts, land one key sentence and survive two tough questions.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Open your talk by announcing the first part.", expected = listOf("I'll start with why this matters.", "I'll start with the problem."), focus = "opening signpost", watch = "I'll start with + noun: “I'll start with to explain” is wrong."), PracticeQuestion(prompt = "Move from findings to recommendations.", expected = listOf("That brings me to my recommendations."), focus = "transition", watch = "brings me to + noun: the signpost is the map."), PracticeQuestion(prompt = "Land your single key message.", expected = listOf("The one thing to remember is this: focus beats time."), focus = "landing", watch = "Say it, then stop talking. The pause is the emphasis."), PracticeQuestion(prompt = "Signal you are closing.", expected = listOf("So, to sum up: three findings, one conclusion."), focus = "the close", watch = "to sum up + the structure you promised at the start."), PracticeQuestion(prompt = "Handle a hostile question confidently.", expected = listOf("That's exactly the point — and my answer is twofold."), focus = "hard questions", watch = "Own the question, then give structure: first… second…"))), exercises = listOf(Exercise(id = "en-foundations-nuance-presenting-e1", kind = "gap", prompt = "I'll ___ ___ why this matters. (2 words)", options = listOf(), answers = listOf("start with"), explain = "I'll start with + noun."), Exercise(id = "en-foundations-nuance-presenting-e2", kind = "gap", prompt = "That ___ me to my second point.", options = listOf(), answers = listOf("brings"), explain = "That brings me to…"), Exercise(id = "en-foundations-nuance-presenting-e3", kind = "order", prompt = "Signal the summary.", options = listOf(), answers = listOf("So to sum up three findings one conclusion"), explain = "So, to sum up: …"), Exercise(id = "en-foundations-nuance-presenting-e4", kind = "written", prompt = "Own a hostile question before answering.", options = listOf(), answers = listOf("thats exactly the point", "that is exactly the point"), explain = "That's exactly the point — then structure.")), skills = listOf("function:talk-about-work", "speaking:sustained-conversation", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors"))))
}

object EnCareU1 {
    val unit = CourseUnit(id = "en-care-u1", title = "Clear care", subtitle = "Appointments, symptoms, instructions", level = "B1", themes = listOf(ConversationTheme("appointment-scene", "The appointment", "Book and describe", "calendar.badge.clock", "Course", "You book a non-urgent appointment and describe symptoms over the phone.", 0),
                ConversationTheme("instructions-scene", "Clear instructions", "Twice a day after meals", "pills", "Course", "You explain medication instructions to a patient and check they understood — kindly, twice.", 1)), lessons = listOf(    Lesson(id = "en-care-u1-appointment", title = "Booking the appointment", goal = "Book a medical appointment and describe why you need it.", intro = LessonIntro(explanation = listOf("The booking flow: “I'd like to make an appointment.” → routine or urgent? → “It's not an emergency, but…”. Triage needs honesty.", "Describe the reason simply: “I've had back pain for two weeks.” Simple present perfect + for.", "Sensitive topics get a phrase: “It's a bit personal…” — receptionists have heard everything."), examples = listOf(ExampleLine(text = "I'd like to make an appointment.", meaning = "The opener."), ExampleLine(text = "It's not an emergency, but I do need to be seen.", meaning = "Honest triage."), ExampleLine(text = "I've had back pain for two weeks.", meaning = "Reason + duration."), ExampleLine(text = "Is there anything earlier?", meaning = "Ask for the waitlist."), ExampleLine(text = "What do I need to bring?", meaning = "The practical close."))), expressions = listOf(TargetExpression(text = "make an appointment", meaning = "The booking verb.", note = "make, never do."), TargetExpression(text = "routine vs urgent", meaning = "Triage honesty.", note = "It's not an emergency, but…"), TargetExpression(text = "I've had … for + time", meaning = "Reason + duration.", note = "for two weeks."), TargetExpression(text = "Is there anything earlier?", meaning = "Ask for cancellations.", note = "The waitlist question."), TargetExpression(text = "What do I need to bring?", meaning = "The practical close.", note = "ID, card, previous reports.")), situation = "Book a back-pain appointment: say it's not urgent but two weeks long, ask for anything earlier and check what to bring.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Open the booking.", expected = listOf("I'd like to make an appointment."), focus = "the opener", watch = "make an appointment — never do."), PracticeQuestion(prompt = "Be honest about urgency. (not emergency, two weeks)", expected = listOf("It's not an emergency, but I've had back pain for two weeks."), focus = "triage", watch = "Honesty gets you the right slot."), PracticeQuestion(prompt = "Ask for an earlier slot.", expected = listOf("Is there anything earlier?"), focus = "the waitlist", watch = "Cancellations happen — ask."), PracticeQuestion(prompt = "Check what to bring.", expected = listOf("What do I need to bring?"), focus = "practical close", watch = "need to + verb."), PracticeQuestion(prompt = "Say the visit is a bit personal before describing it.", expected = listOf("It's a bit personal.", "It's a bit personal, but…"), focus = "sensitive", watch = "The phrase buys kindness from the receptionist."))), exercises = listOf(Exercise(id = "en-care-u1-appointment-e1", kind = "choice", prompt = "I'd like to ___ an appointment.", options = listOf("make", "do", "take", "get"), answers = listOf("make"), explain = "make an appointment — the fixed pair."), Exercise(id = "en-care-u1-appointment-e2", kind = "gap", prompt = "I've had this pain ___ two weeks. (duration)", options = listOf(), answers = listOf("for"), explain = "for + period."), Exercise(id = "en-care-u1-appointment-e3", kind = "order", prompt = "Ask for an earlier slot.", options = listOf(), answers = listOf("Is there anything earlier"), explain = "Is there anything…?"), Exercise(id = "en-care-u1-appointment-e4", kind = "written", prompt = "Say it's not an emergency but you need to be seen.", options = listOf(), answers = listOf("its not an emergency but i do need to be seen", "its not an emergency"), explain = "Honest triage.")), skills = listOf("function:talk-about-health", "grammar:present-perfect", "grammar:have-got", "vocab:health"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-perfect")),
    Lesson(id = "en-care-u1-instructions", title = "Clear instructions", goal = "Explain medication and check the patient understood — kindly, twice.", intro = LessonIntro(explanation = listOf("Instruction pattern: “Take one tablet twice a day, after meals.” Frequency + timing + food rule, in that order.", "Check understanding without condescension: “Just so I know you've got it — how often will you take it?” Teach-back, not a quiz.", "Warn kindly: “You shouldn't drive while taking these.” should/shouldn't carries every warning."), examples = listOf(ExampleLine(text = "Take one tablet twice a day, after meals.", meaning = "The full instruction."), ExampleLine(text = "Don't take them on an empty stomach.", meaning = "The food rule."), ExampleLine(text = "Just so I know you've got it — how often?", meaning = "The teach-back."), ExampleLine(text = "You shouldn't drive while taking these.", meaning = "The kind warning."), ExampleLine(text = "Finish the whole course, even if you feel better.", meaning = "The compliance line."))), expressions = listOf(TargetExpression(text = "Take + number + frequency", meaning = "The dose.", note = "one tablet twice a day."), TargetExpression(text = "after / before / with meals", meaning = "The timing.", note = "after meals."), TargetExpression(text = "Don't take them + condition", meaning = "The food rule.", note = "on an empty stomach."), TargetExpression(text = "Just so I know you've got it …", meaning = "Teach-back opener.", note = "Then ask them to repeat."), TargetExpression(text = "You shouldn't + verb", meaning = "The kind warning.", note = "drive while taking these."), TargetExpression(text = "Finish the whole course", meaning = "Compliance.", note = "even if you feel better.")), situation = "Explain a new medication: dose, timing, food rule — then use teach-back to check understanding and add one kind warning.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Give the dose and frequency. (1 tablet, twice a day)", expected = listOf("Take one tablet twice a day."), focus = "dose", watch = "Number + frequency, in that order."), PracticeQuestion(prompt = "Add the timing rule. (after meals)", expected = listOf("Take them after meals."), focus = "timing", watch = "after/before/with meals."), PracticeQuestion(prompt = "Check understanding kindly.", expected = listOf("Just so I know you've got it — how often will you take them?"), focus = "teach-back", watch = "Ask them to repeat, without a quiz voice."), PracticeQuestion(prompt = "Give the kind warning. (no driving)", expected = listOf("You shouldn't drive while taking these."), focus = "the warning", watch = "shouldn't + base verb."), PracticeQuestion(prompt = "Give the food rule. (no alcohol)", expected = listOf("You shouldn't drink alcohol with this medication."), focus = "shouldn't", watch = "Warnings use shouldn't, not don't."))), exercises = listOf(Exercise(id = "en-care-u1-instructions-e1", kind = "choice", prompt = "Take one tablet ___ a day.", options = listOf("twice", "two times of", "two", "double"), answers = listOf("twice"), explain = "twice a day = dos veces al día."), Exercise(id = "en-care-u1-instructions-e2", kind = "gap", prompt = "Take them ___ meals. (después de)", options = listOf(), answers = listOf("after"), explain = "after meals."), Exercise(id = "en-care-u1-instructions-e3", kind = "order", prompt = "Give the kind warning.", options = listOf(), answers = listOf("You shouldnt drive while taking these"), explain = "shouldn't + base verb."), Exercise(id = "en-care-u1-instructions-e4", kind = "written", prompt = "The compliance line: finish the course.", options = listOf(), answers = listOf("finish the whole course even if you feel better", "finish the whole course"), explain = "even if you feel better.")), skills = listOf("function:talk-about-health", "grammar:modal-should", "grammar:quantities", "vocab:health"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:modal-should")),
    Lesson(id = "en-care-u1-reassuring", title = "Reassuring a worried patient", goal = "Calm a worried patient: acknowledge, explain simply, and give the next step.", intro = LessonIntro(explanation = listOf("Acknowledge the fear first: “I can see you're worried.” Solutions before empathy sound like dismissal.", "Explain simply: short sentences, everyday words, no jargon — “The scan will show us what's happening.”", "Always end with the next step: “The nurse will call you tomorrow with the results.” Uncertainty is the scarier diagnosis."), examples = listOf(ExampleLine(text = "I can see you're worried.", meaning = "Acknowledge first."), ExampleLine(text = "The scan will show us what's happening.", meaning = "Simple explanation."), ExampleLine(text = "It's routine, and you're in good hands.", meaning = "The calm frame."), ExampleLine(text = "The nurse will call you tomorrow with the results.", meaning = "The next step."), ExampleLine(text = "Any questions at all — I'm here.", meaning = "The open door."))), expressions = listOf(TargetExpression(text = "I can see you're …", meaning = "Name the feeling.", note = "worried, nervous, anxious."), TargetExpression(text = "short + everyday words", meaning = "Explain simply.", note = "No jargon to a worried mind."), TargetExpression(text = "It's routine …", meaning = "The calm frame.", note = "Routine for us, new for them."), TargetExpression(text = "The next step is …", meaning = "Kill the uncertainty.", note = "…the nurse calls tomorrow."), TargetExpression(text = "Any questions at all?", meaning = "The open door.", note = "Then wait for the real one.")), situation = "A patient is worried about a scan: name the feeling, explain the scan in one simple sentence, give the next step and open the door.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Name the patient's feeling.", expected = listOf("I can see you're worried."), focus = "acknowledge", watch = "Empathy first — solutions second."), PracticeQuestion(prompt = "Explain the scan simply.", expected = listOf("The scan will show us what's happening. It doesn't hurt at all."), focus = "simple", watch = "Short sentences, no jargon."), PracticeQuestion(prompt = "Give the calm frame.", expected = listOf("It's routine, and you're in good hands."), focus = "the frame", watch = "Routine for us, new for them."), PracticeQuestion(prompt = "Give the next step. (nurse calls tomorrow)", expected = listOf("The nurse will call you tomorrow with the results."), focus = "next step", watch = "Uncertainty is the scarier diagnosis."), PracticeQuestion(prompt = "Reassure about pain before the scan.", expected = listOf("It doesn't hurt at all."), focus = "reassure", watch = "Short, absolute, kind."))), exercises = listOf(Exercise(id = "en-care-u1-reassuring-e1", kind = "choice", prompt = "I can see you're ___. (worried)", options = listOf("worried", "worrying", "worry", "worry about"), answers = listOf("worried"), explain = "worried = how you feel; worrying = what causes it."), Exercise(id = "en-care-u1-reassuring-e2", kind = "gap", prompt = "It's ___ — you're in good hands. (de rutina)", options = listOf(), answers = listOf("routine"), explain = "routine = de rutina, normal."), Exercise(id = "en-care-u1-reassuring-e3", kind = "order", prompt = "Give the next step.", options = listOf(), answers = listOf("The nurse will call you tomorrow with the results"), explain = "The next step kills the uncertainty."), Exercise(id = "en-care-u1-reassuring-e4", kind = "written", prompt = "Open the door for questions.", options = listOf(), answers = listOf("any questions at all im here", "any questions im here"), explain = "Then wait for the real one.")), skills = listOf("function:talk-about-health", "grammar:present-continuous", "grammar:future-forms", "vocab:health", "speaking:sustained-conversation"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:future-forms"))))
}

object EnHospU1 {
    val unit = CourseUnit(id = "en-hosp-u1", title = "Guest services", subtitle = "Check-in, requests, complaints", level = "B1", themes = listOf(ConversationTheme("checkin-scene", "The check-in", "Names, nights, keys", "key.horizontal", "Course", "You check in a tired traveller: booking found, room explained, breakfast mentioned, keys handed.", 0),
                ConversationTheme("complaint-scene", "The complaint at midnight", "Fix it kindly", "moon.zzz", "Course", "A guest is upset about noise. Listen, apologise, act — and follow up before breakfast.", 1)), lessons = listOf(    Lesson(id = "en-hosp-u1-checkin", title = "The check-in", goal = "Check a guest in: find the booking, explain the room, set expectations.", intro = LessonIntro(explanation = listOf("The check-in script: “Good evening! Do you have a reservation?” → name → “A double room for two nights, is that right?”", "Explain the essentials: breakfast hours, Wi-Fi, checkout time. Tired guests remember none — say them slowly, twice.", "Hand over with the room number: “You're in room 204, second floor. Enjoy your stay!”"), examples = listOf(ExampleLine(text = "Good evening! Do you have a reservation?", meaning = "The opener."), ExampleLine(text = "A double room for two nights, is that right?", meaning = "Confirm the booking."), ExampleLine(text = "Breakfast is from seven to ten.", meaning = "The essential detail."), ExampleLine(text = "You're in room 204, second floor.", meaning = "The handover."), ExampleLine(text = "Enjoy your stay!", meaning = "The close."))), expressions = listOf(TargetExpression(text = "Do you have a reservation?", meaning = "The opener.", note = "reservation = booking."), TargetExpression(text = "…, is that right?", meaning = "Confirm details.", note = "name, room type, nights."), TargetExpression(text = "Breakfast is from … to …", meaning = "Essential detail.", note = "Slowly. Twice."), TargetExpression(text = "You're in room + number", meaning = "The handover.", note = "…on the second floor."), TargetExpression(text = "Enjoy your stay!", meaning = "The close.", note = "Every check-in ends here.")), situation = "Check in a tired traveller: find the booking under their name, confirm two nights, give breakfast hours and hand over the keys warmly.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Open the check-in.", expected = listOf("Good evening! Do you have a reservation?"), focus = "the opener", watch = "reservation = booking — same thing at a hotel."), PracticeQuestion(prompt = "Confirm the booking details. (double, two nights)", expected = listOf("A double room for two nights, is that right?"), focus = "confirm", watch = "Repeat the details back — errors die here."), PracticeQuestion(prompt = "Give breakfast hours. (7 to 10)", expected = listOf("Breakfast is from seven to ten, on the ground floor."), focus = "essential detail", watch = "Say it slowly. Tired guests forget."), PracticeQuestion(prompt = "Hand over the keys warmly.", expected = listOf("You're in room 204. Enjoy your stay!"), focus = "the handover", watch = "Room number + the close."), PracticeQuestion(prompt = "Mention the Wi-Fi. (free, all areas)", expected = listOf("Wi-Fi is free in all areas."), focus = "the extras", watch = "Free + place: in all areas."))), exercises = listOf(Exercise(id = "en-hosp-u1-checkin-e1", kind = "choice", prompt = "Do you have a ___? (reserva)", options = listOf("reservation", "reservate", "reserve", "reserving"), answers = listOf("reservation"), explain = "reservation = booking."), Exercise(id = "en-hosp-u1-checkin-e2", kind = "gap", prompt = "A double room ___ two nights, is that right?", options = listOf(), answers = listOf("for"), explain = "for + duration."), Exercise(id = "en-hosp-u1-checkin-e3", kind = "order", prompt = "Give breakfast hours.", options = listOf(), answers = listOf("Breakfast is from seven to ten"), explain = "from … to …"), Exercise(id = "en-hosp-u1-checkin-e4", kind = "written", prompt = "Hand over the keys warmly. (room 204)", options = listOf(), answers = listOf("youre in room 204 enjoy your stay", "room 204 enjoy your stay"), explain = "Room + the close.")), skills = listOf("function:make-requests", "grammar:present-simple", "grammar:quantities", "vocab:social-expressions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:quantities")),
    Lesson(id = "en-hosp-u1-complaints", title = "The midnight complaint", goal = "Handle a complaint: listen fully, apologise, act, follow up.", intro = LessonIntro(explanation = listOf("The service sequence: listen without interrupting → apologise once, sincerely → act immediately → follow up later.", "Apologise for the experience, not the fault: “I'm so sorry about the noise” works even if it wasn't your fault.", "Act visibly: “I'm moving you to the fourth floor right now.” Actions apologise louder than words."), examples = listOf(ExampleLine(text = "I'm so sorry about the noise.", meaning = "The sincere apology."), ExampleLine(text = "I completely understand.", meaning = "Validate the feeling."), ExampleLine(text = "I'm moving you to a quiet room right now.", meaning = "Act immediately."), ExampleLine(text = "I'll follow up in the morning.", meaning = "The promised follow-up."), ExampleLine(text = "Is there anything else I can do?", meaning = "The care question."))), expressions = listOf(TargetExpression(text = "I'm so sorry about …", meaning = "Apologise for the experience.", note = "Even if it's not your fault."), TargetExpression(text = "I completely understand.", meaning = "Validate first.", note = "Before any solution."), TargetExpression(text = "I'll + fix, right now", meaning = "Act visibly.", note = "Moving you now."), TargetExpression(text = "I'll follow up in the morning.", meaning = "The follow-up promise.", note = "And actually do it."), TargetExpression(text = "Is there anything else…?", meaning = "The care question.", note = "Then wait, and listen.")), situation = "A guest calls down at midnight about wedding noise upstairs: listen, apologise, move them, promise the follow-up and ask the care question.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Apologise for the noise.", expected = listOf("I'm so sorry about the noise."), focus = "the apology", watch = "For the experience, whatever the cause."), PracticeQuestion(prompt = "Validate the guest's feeling.", expected = listOf("I completely understand — it's unacceptable."), focus = "validate", watch = "Understand first, explain later (or never)."), PracticeQuestion(prompt = "Say the immediate action. (move to 4th floor)", expected = listOf("I'm moving you to the fourth floor right now."), focus = "act now", watch = "right now is the apology that works."), PracticeQuestion(prompt = "Promise the follow-up. (morning)", expected = listOf("I'll follow up in the morning."), focus = "follow-up", watch = "Promise it, then do it before breakfast."), PracticeQuestion(prompt = "Ask the care question.", expected = listOf("Is there anything else I can do?"), focus = "care", watch = "Then wait, and listen again."))), exercises = listOf(Exercise(id = "en-hosp-u1-complaints-e1", kind = "choice", prompt = "I'm so sorry ___ the noise.", options = listOf("about", "of", "that", "for what"), answers = listOf("about"), explain = "sorry about + thing."), Exercise(id = "en-hosp-u1-complaints-e2", kind = "gap", prompt = "I ___ understand — that's not acceptable.", options = listOf(), answers = listOf("completely", "totally"), explain = "completely understand."), Exercise(id = "en-hosp-u1-complaints-e3", kind = "order", prompt = "Promise the action.", options = listOf(), answers = listOf("Im moving you to a quiet room right now"), explain = "Act immediately."), Exercise(id = "en-hosp-u1-complaints-e4", kind = "written", prompt = "Ask the care question.", options = listOf(), answers = listOf("is there anything else i can do", "can i do anything else"), explain = "Then wait and listen.")), skills = listOf("function:solve-problems", "function:make-requests", "grammar:present-continuous", "vocab:social-expressions", "speaking:sustained-conversation"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-continuous")),
    Lesson(id = "en-hosp-u1-requests", title = "Special requests", goal = "Handle special requests: what's possible, what's not, and the kind alternative.", intro = LessonIntro(explanation = listOf("Requests come in every shape: late checkout, a quiet floor, an extra bed. First acknowledge: “Certainly, let me check.”", "Never a bare no: “I'm afraid we can't do early check-in, but we can store your bags.” The alternative is the service.", "Follow through visibly: “It's arranged — room 312, away from the lift.” Report back or the request didn't happen."), examples = listOf(ExampleLine(text = "Certainly, let me check.", meaning = "The acknowledging opener."), ExampleLine(text = "I'm afraid we can't do early check-in.", meaning = "The kind no."), ExampleLine(text = "But we can store your bags.", meaning = "The alternative."), ExampleLine(text = "It's arranged — room 312.", meaning = "The visible follow-through."), ExampleLine(text = "Anything else I can arrange?", meaning = "The service close."))), expressions = listOf(TargetExpression(text = "Certainly, let me check.", meaning = "Buy time kindly.", note = "Then actually check."), TargetExpression(text = "I'm afraid we can't …", meaning = "The kind no.", note = "afraid softens it."), TargetExpression(text = "but we CAN …", meaning = "The alternative.", note = "Say the CAN louder."), TargetExpression(text = "It's arranged.", meaning = "Report back.", note = "Room, time, detail."), TargetExpression(text = "Anything else I can arrange?", meaning = "The close.", note = "arrange = gestionar.")), situation = "A guest asks for late checkout, a high floor and a quiet room — one yes, one no with an alternative, and one to arrange.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Acknowledge before checking. (late checkout)", expected = listOf("Certainly, let me check for late checkout."), focus = "acknowledge", watch = "Certainly buys the wait kindly."), PracticeQuestion(prompt = "Say no kindly with an alternative. (early check-in / bags)", expected = listOf("I'm afraid we can't do early check-in, but we can store your bags."), focus = "no + alternative", watch = "The CAN in the alternative is the service."), PracticeQuestion(prompt = "Confirm the arrangement. (room 312)", expected = listOf("It's arranged — room 312, away from the lift."), focus = "report back", watch = "Detail proves it really happened."), PracticeQuestion(prompt = "Close with the service question.", expected = listOf("Anything else I can arrange for you?"), focus = "the close", watch = "arrange, not do — hotel register."), PracticeQuestion(prompt = "Acknowledge a request for a high floor.", expected = listOf("Certainly, let me check for a high floor."), focus = "acknowledge", watch = "Certainly first, check second."))), exercises = listOf(Exercise(id = "en-hosp-u1-requests-e1", kind = "choice", prompt = "___, let me check for late checkout.", options = listOf("Certainly", "Maybe", "Perhaps not", "Never"), answers = listOf("Certainly"), explain = "Certainly buys the wait kindly."), Exercise(id = "en-hosp-u1-requests-e2", kind = "gap", prompt = "I'm ___ we can't do early check-in.", options = listOf(), answers = listOf("afraid"), explain = "I'm afraid softens the no."), Exercise(id = "en-hosp-u1-requests-e3", kind = "order", prompt = "Report the arrangement.", options = listOf(), answers = listOf("Its arranged room 312 away from the lift"), explain = "Detail proves it happened."), Exercise(id = "en-hosp-u1-requests-e4", kind = "written", prompt = "Close with the service question.", options = listOf(), answers = listOf("anything else i can arrange", "anything else i can arrange for you"), explain = "arrange = hotel register.")), skills = listOf("function:make-requests", "function:solve-problems", "grammar:going-to", "vocab:social-expressions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple"))))
}

object EnTechU1 {
    val unit = CourseUnit(id = "en-tech-u1", title = "Shipping software", subtitle = "Standup, tickets, demos", level = "B1", themes = listOf(ConversationTheme("standup-scene", "The daily stand-up", "Yesterday, today, blocked", "clock.badge", "Course", "Ninety seconds each: what moved, what's next, what's stuck — and one honest blocker.", 0),
                ConversationTheme("demo-scene", "The demo", "Show, don't drown", "play.rectangle", "Course", "You demo a new feature to non-technical colleagues: what it does, why it matters, what's next.", 1)), lessons = listOf(    Lesson(id = "en-tech-u1-standup", title = "The stand-up", goal = "Report progress in three sentences: done, doing, blocked.", intro = LessonIntro(explanation = listOf("The stand-up spine: “Yesterday I finished X. Today I'm working on Y. I'm blocked on Z.” Past, present, blocker.", "Blockers name the thing and the person: “I'm blocked on the API — waiting on Marta's review.”", "Detail is for after: “Let's take that offline” = interesting, but not now."), examples = listOf(ExampleLine(text = "Yesterday I finished the login flow.", meaning = "Done: past simple."), ExampleLine(text = "Today I'm working on the API.", meaning = "Doing: continuous."), ExampleLine(text = "I'm blocked on Marta's review.", meaning = "The blocker + owner."), ExampleLine(text = "Let's take that offline.", meaning = "Not now, but noted."), ExampleLine(text = "No blockers from me.", meaning = "The clean report."))), expressions = listOf(TargetExpression(text = "finished X (yesterday)", meaning = "Done work.", note = "past simple."), TargetExpression(text = "I'm working on Y (today)", meaning = "Current work.", note = "present continuous."), TargetExpression(text = "I'm blocked on Z", meaning = "Name the blocker.", note = "on + the thing."), TargetExpression(text = "waiting on + person", meaning = "Who you need.", note = "waiting on Marta."), TargetExpression(text = "take it offline", meaning = "Park the detail.", note = "after the stand-up.")), situation = "Your three sentences: what you finished yesterday, what you're on today, and the one honest blocker — plus park one detail for later.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Report finished work. (the login flow)", expected = listOf("Yesterday I finished the login flow."), focus = "past simple", watch = "Finished yesterday: past simple."), PracticeQuestion(prompt = "Report today's work. (the API)", expected = listOf("Today I'm working on the API."), focus = "present continuous", watch = "Today + continuous: work in progress."), PracticeQuestion(prompt = "Name your blocker and its owner. (Marta's review)", expected = listOf("I'm blocked on Marta's review."), focus = "blocker + owner", watch = "Blocked ON the thing, waiting ON the person."), PracticeQuestion(prompt = "Park a detail politely.", expected = listOf("Let's take that offline."), focus = "offline", watch = "The phrase parks it without killing it."), PracticeQuestion(prompt = "The clean report: no blockers.", expected = listOf("No blockers from me."), focus = "clean", watch = "Saying it clearly keeps stand-ups short."))), exercises = listOf(Exercise(id = "en-tech-u1-standup-e1", kind = "choice", prompt = "Yesterday I ___ the login flow.", options = listOf("finished", "finish", "was finishing", "have finished"), answers = listOf("finished"), explain = "Yesterday: past simple."), Exercise(id = "en-tech-u1-standup-e2", kind = "gap", prompt = "Today I'm ___ on the API. (work)", options = listOf(), answers = listOf("working"), explain = "Today: present continuous."), Exercise(id = "en-tech-u1-standup-e3", kind = "order", prompt = "Name the blocker.", options = listOf(), answers = listOf("Im blocked on Martas review"), explain = "I'm blocked on + thing."), Exercise(id = "en-tech-u1-standup-e4", kind = "written", prompt = "Park a detail for after the meeting.", options = listOf(), answers = listOf("lets take that offline", "let's take that offline"), explain = "take it offline = later.")), skills = listOf("function:talk-about-work", "grammar:past-simple-regular", "grammar:present-continuous", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "en-tech-u1-demo", title = "The demo", goal = "Demo a feature to non-technical colleagues: what, why, what's next.", intro = LessonIntro(explanation = listOf("Demo grammar: “Here you can see…”, “Watch what happens when I…”, “And that's it — three clicks instead of twenty.”", "Translate the tech: not “the API caches responses” but “it opens instantly, even offline”. Benefits, not architecture.", "Own the bugs before they're found: “Export is still slow — that's next on the list.”"), examples = listOf(ExampleLine(text = "Here you can see the new dashboard.", meaning = "Point at the screen."), ExampleLine(text = "Watch what happens when I click save.", meaning = "The live moment."), ExampleLine(text = "Three clicks instead of twenty.", meaning = "The benefit, counted."), ExampleLine(text = "Export is still slow — that's next.", meaning = "Own the known bug."), ExampleLine(text = "That's the demo — questions welcome.", meaning = "The close."))), expressions = listOf(TargetExpression(text = "Here you can see …", meaning = "Show the screen.", note = "…the new dashboard."), TargetExpression(text = "Watch what happens when …", meaning = "The live moment.", note = "…I click save."), TargetExpression(text = "X instead of Y", meaning = "Count the win.", note = "Three clicks instead of twenty."), TargetExpression(text = "… — that's next on the list", meaning = "Own the flaw.", note = "Known bug, known plan."), TargetExpression(text = "Questions welcome.", meaning = "The open close.", note = "Then stop talking.")), situation = "Demo the new offline mode to the sales team: show the moment, count the benefit, own the known bug and invite questions.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Show the new screen.", expected = listOf("Here you can see the new offline mode."), focus = "here you can see", watch = "Point while you name it."), PracticeQuestion(prompt = "Create the live moment. (click sync)", expected = listOf("Watch what happens when I click sync."), focus = "watch what happens", watch = "Then click. The pause builds it."), PracticeQuestion(prompt = "Count the benefit. (3 clicks vs 20)", expected = listOf("Three clicks instead of twenty."), focus = "instead of", watch = "Numbers carry the benefit."), PracticeQuestion(prompt = "Own the known bug. (slow export)", expected = listOf("Export is still slow — that's next on the list."), focus = "own the bug", watch = "Say it before they find it."), PracticeQuestion(prompt = "Close and invite questions.", expected = listOf("That's the demo — questions welcome."), focus = "the open close", watch = "Then actually stop talking."))), exercises = listOf(Exercise(id = "en-tech-u1-demo-e1", kind = "choice", prompt = "Here you can ___ the new dashboard.", options = listOf("see", "watch", "look", "view"), answers = listOf("see"), explain = "Here you can see + thing."), Exercise(id = "en-tech-u1-demo-e2", kind = "gap", prompt = "___ what happens when I click sync.", options = listOf(), answers = listOf("watch"), explain = "Watch what happens when…"), Exercise(id = "en-tech-u1-demo-e3", kind = "order", prompt = "Count the benefit.", options = listOf(), answers = listOf("Three clicks instead of twenty"), explain = "X instead of Y."), Exercise(id = "en-tech-u1-demo-e4", kind = "written", prompt = "Own the slow export.", options = listOf(), answers = listOf("export is still slow thats next on the list", "its still slow thats next"), explain = "Known bug, known plan.")), skills = listOf("function:talk-about-work", "grammar:present-continuous", "grammar:comparatives", "vocab:work", "speaking:sustained-conversation"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:comparatives")),
    Lesson(id = "en-tech-u1-tickets", title = "Tickets & bugs", goal = "Write and explain a bug report: steps, expected, actual — and a severity.", intro = LessonIntro(explanation = listOf("A bug report is a story with evidence: “Steps: open the app offline. Expected: cached data. Actual: a blank screen.”", "Severity is a scale, not a shout: blocker > critical > major > minor. A blocker means nobody can work.", "Reproduce before you report: “It happens every time on Android, but not on iOS.” The pattern is the clue."), examples = listOf(ExampleLine(text = "Steps: open the app offline.", meaning = "How to reproduce."), ExampleLine(text = "Expected: cached data appears.", meaning = "What should happen."), ExampleLine(text = "Actual: a blank screen.", meaning = "What really happens."), ExampleLine(text = "It's a blocker — nobody can log in.", meaning = "The severity."), ExampleLine(text = "It happens every time on Android.", meaning = "The pattern."))), expressions = listOf(TargetExpression(text = "Steps to reproduce", meaning = "The recipe.", note = "Numbered, exact, short."), TargetExpression(text = "Expected vs actual", meaning = "The gap is the bug.", note = "Both, always."), TargetExpression(text = "blocker / critical / major / minor", meaning = "The severity scale.", note = "blocker stops the team."), TargetExpression(text = "every time / intermittently", meaning = "The pattern.", note = "intermittent = a veces."), TargetExpression(text = "I'll take a look today.", meaning = "The pickup.", note = "Own it or route it.")), situation = "A colleague reports the app eats typed notes offline: write the report as steps, expected, actual, mark the severity and pick it up.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Give the steps to reproduce. (open offline, type, close)", expected = listOf("Steps: open the app offline, type a note and close it."), focus = "steps", watch = "Numbered, exact, short."), PracticeQuestion(prompt = "Say expected vs actual. (note saved vs note lost)", expected = listOf("Expected: the note is saved. Actual: the note is lost."), focus = "the gap", watch = "Both halves — the gap is the bug."), PracticeQuestion(prompt = "Set the severity if nobody loses data. (major)", expected = listOf("It's a major, not a blocker — no data loss for most users."), focus = "severity", watch = "A blocker stops everyone; a major hurts some."), PracticeQuestion(prompt = "Pick it up.", expected = listOf("I'll take a look today."), focus = "pickup", watch = "Own it or route it to the owner."), PracticeQuestion(prompt = "Say how often the bug happens. (every time, Android)", expected = listOf("It happens every time on Android."), focus = "the pattern", watch = "The pattern is the clue to the cause."))), exercises = listOf(Exercise(id = "en-tech-u1-tickets-e1", kind = "choice", prompt = "Expected: the note is saved. ___: the note is lost.", options = listOf("Actual", "Usually", "Maybe", "Blocked"), answers = listOf("Actual"), explain = "Expected vs actual — the gap is the bug."), Exercise(id = "en-tech-u1-tickets-e2", kind = "gap", prompt = "Nobody can log in — it's a ___. (severidad máxima)", options = listOf(), answers = listOf("blocker"), explain = "A blocker stops the whole team."), Exercise(id = "en-tech-u1-tickets-e3", kind = "order", prompt = "Give the steps.", options = listOf(), answers = listOf("Open the app offline and type a note"), explain = "Numbered, exact, short."), Exercise(id = "en-tech-u1-tickets-e4", kind = "written", prompt = "Pick up the bug for today.", options = listOf(), answers = listOf("ill take a look today", "i will take a look today"), explain = "Own it or route it.")), skills = listOf("function:talk-about-work", "grammar:present-simple", "grammar:passive-intro", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-simple"))))
}

object EnWorkU1 {
    val unit = CourseUnit(id = "en-work-u1", title = "The working day", subtitle = "Meetings, emails, interviews", level = "B1", themes = listOf(ConversationTheme("monday-standup", "Monday stand-up", "Report your week", "clock", "Course", "You report progress in a stand-up: what you did, what you're doing, what's blocked.", 0),
                ConversationTheme("interview-roleplay", "The interview rehearsal", "Sell your experience", "person.badge.key", "Course", "A job interview rehearsal: present yourself, describe projects and answer the hard questions.", 1)), lessons = listOf(    Lesson(id = "en-work-u1-meetings", title = "In meetings", goal = "Report progress, ask for clarification and disagree politely in a meeting.", intro = LessonIntro(explanation = listOf("Structure beats improvisation: “Last week I finished X. This week I'm working on Y. I'm blocked on Z.”", "Clarify before you guess: “Sorry, could you clarify that?” “Just to make sure I understand…”", "Disagree with data, not people: “I see it slightly differently — the numbers show…”"), examples = listOf(ExampleLine(text = "Last week I finished the report.", meaning = "Done work, past simple."), ExampleLine(text = "This week I'm working on the budget.", meaning = "Current work, continuous."), ExampleLine(text = "I'm blocked on the approvals.", meaning = "Say what stops you."), ExampleLine(text = "Sorry, could you clarify that?", meaning = "Ask before assuming."), ExampleLine(text = "Just to make sure I understand: we ship on Friday?", meaning = "Confirm decisions."), ExampleLine(text = "I see it slightly differently — the data shows a drop.", meaning = "Data-based disagreement."))), expressions = listOf(TargetExpression(text = "Last week I finished …", meaning = "Report completed work.", note = "Past simple for done things."), TargetExpression(text = "This week I'm working on …", meaning = "Report current work.", note = "Continuous for in progress."), TargetExpression(text = "I'm blocked on …", meaning = "Name the blocker.", note = "Blocked on + thing, not person."), TargetExpression(text = "Could you clarify …?", meaning = "Ask precisely.", note = "Clarify + the specific point."), TargetExpression(text = "Just to make sure I understand, …", meaning = "Confirm decisions.", note = "Repeat the decision back."), TargetExpression(text = "I see it slightly differently.", meaning = "Soft disagreement.", note = "Then bring your data.")), situation = "Monday stand-up: report what you finished, what you're on and what's blocked; clarify one point and politely disagree with a plan once.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Report one thing you finished last week.", expected = listOf("Last week I finished <task>."), focus = "past simple reporting", watch = "“Last week I finish” — done work takes past simple."), PracticeQuestion(prompt = "Report what you're doing this week.", expected = listOf("This week I'm working on <task>."), focus = "current work", watch = "“This week I work on” sounds like a routine — use the continuous."), PracticeQuestion(prompt = "Tell the team what is blocking you. (approvals)", expected = listOf("I'm blocked on the approvals."), focus = "blockers", watch = "“I'm blocked by the approvals” also works; “I block on” doesn't."), PracticeQuestion(prompt = "Ask for clarification about the deadline.", expected = listOf("Sorry, could you clarify the deadline?", "Could you clarify when the deadline is?"), focus = "clarifying", watch = "Clarify + the thing: the deadline, the owner, the scope."), PracticeQuestion(prompt = "Confirm a decision you half-heard. (ship on Friday)", expected = listOf("Just to make sure I understand: we ship on Friday?"), focus = "confirming", watch = "Repeat the decision back as a question."), PracticeQuestion(prompt = "Disagree with a plan, politely, with data.", expected = listOf("I see it slightly differently — the data shows a drop.", "I see your point; however, the numbers say otherwise."), focus = "soft disagreement", watch = "Data first, tone soft: no “you're wrong”."))), exercises = listOf(Exercise(id = "en-work-u1-meetings-e1", kind = "choice", prompt = "Last week I ___ the report.", options = listOf("finished", "finish", "am finishing", "was finishing"), answers = listOf("finished"), explain = "Last week + past simple for completed work."), Exercise(id = "en-work-u1-meetings-e2", kind = "gap", prompt = "This week I'm ___ on the budget. (work)", options = listOf(), answers = listOf("working"), explain = "Current work: I'm working on."), Exercise(id = "en-work-u1-meetings-e3", kind = "order", prompt = "Ask for clarification politely.", options = listOf(), answers = listOf("Could you clarify that please"), explain = "Could you clarify + object (+ please)."), Exercise(id = "en-work-u1-meetings-e4", kind = "written", prompt = "Say what blocks you: the client's approval.", options = listOf(), answers = listOf("i'm blocked on the client's approval", "i am blocked on the approval", "i'm blocked by the client's approval"), explain = "blocked on/by + the thing.")), skills = listOf("function:talk-about-work", "grammar:past-simple-regular", "grammar:present-continuous", "function:make-requests", "speaking:sustained-conversation"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-simple", "grammar:present-continuous")),
    Lesson(id = "en-work-u1-emails", title = "Professional emails", goal = "Write short professional emails: request, confirm and follow up.", intro = LessonIntro(explanation = listOf("Email skeleton: greeting → purpose in line one → details → clear ask → sign-off. “Hi Marta, I'm writing about… Could you…? Thanks, Dan.”", "Requests: “Could you send… by Wednesday?” Deadlines make asks actionable. Follow-ups stay light: “Just following up on my email below.”", "Register: no contractions is safer in formal mail; “I would be grateful if…” is the formal ask."), examples = listOf(ExampleLine(text = "I'm writing about Thursday's meeting.", meaning = "Purpose in line one."), ExampleLine(text = "Could you send the figures by Wednesday?", meaning = "Request + deadline."), ExampleLine(text = "Please find the report attached.", meaning = "The attachment line."), ExampleLine(text = "Just following up on my email below.", meaning = "Light follow-up."), ExampleLine(text = "I would be grateful if you could confirm.", meaning = "Formal ask."), ExampleLine(text = "Best regards, Daniel", meaning = "Safe sign-off."))), expressions = listOf(TargetExpression(text = "I'm writing about / to ask about …", meaning = "Open with purpose.", note = "No weather talk in work mail."), TargetExpression(text = "Could you … by <day>?", meaning = "Request + deadline.", note = "A deadline is kindness."), TargetExpression(text = "Please find … attached.", meaning = "Point at the file.", note = "attached, not annexed."), TargetExpression(text = "Just following up on …", meaning = "Nudge without nagging.", note = "Light tone, clear reference."), TargetExpression(text = "I would be grateful if you could …", meaning = "The formal ask.", note = "Clients, institutions, bosses' bosses."), TargetExpression(text = "Best regards / Kind regards", meaning = "Safe sign-offs.", note = "Cheers is for friends only.")), situation = "You need numbers from a busy colleague: write the request, set a deadline, and then follow up two days later — politely.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Open an email about the quarterly figures.", expected = listOf("I'm writing about the quarterly figures."), focus = "purpose first", watch = "Line one states the topic — no “I hope you are well” padding needed."), PracticeQuestion(prompt = "Ask for the figures with a deadline. (Wednesday)", expected = listOf("Could you send the figures by Wednesday?"), focus = "request + deadline", watch = "by + day: “until Wednesday” is different — by is the limit."), PracticeQuestion(prompt = "Point to the report you attached.", expected = listOf("Please find the report attached."), focus = "attachment line", watch = "The fixed phrase is find … attached."), PracticeQuestion(prompt = "Follow up on an unanswered email, lightly.", expected = listOf("Just following up on my email below."), focus = "follow-up", watch = "“Why didn't you answer?” is never the opening."), PracticeQuestion(prompt = "Make the formal version of the ask. (confirm attendance)", expected = listOf("I would be grateful if you could confirm your attendance."), focus = "formal register", watch = "would be grateful + if you could."), PracticeQuestion(prompt = "Choose a safe sign-off for a client.", expected = listOf("Best regards.", "Kind regards."), focus = "sign-off", watch = "Cheers and hugs stay with friends."))), exercises = listOf(Exercise(id = "en-work-u1-emails-e1", kind = "choice", prompt = "I'm writing ___ the invoice.", options = listOf("about", "of", "for see", "on see"), answers = listOf("about"), explain = "I'm writing about + topic."), Exercise(id = "en-work-u1-emails-e2", kind = "gap", prompt = "Could you send it ___ Friday? (deadline)", options = listOf(), answers = listOf("by"), explain = "by Friday = not later than Friday."), Exercise(id = "en-work-u1-emails-e3", kind = "order", prompt = "The attachment line.", options = listOf(), answers = listOf("Please find the report attached"), explain = "find + file + attached."), Exercise(id = "en-work-u1-emails-e4", kind = "written", prompt = "Formal ask: confirm attendance.", options = listOf(), answers = listOf("i would be grateful if you could confirm your attendance", "i would be grateful if you could confirm attendance"), explain = "I would be grateful if you could…")), skills = listOf("writing:email", "function:make-requests", "grammar:modal-should", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:modal-should")),
    Lesson(id = "en-work-u1-interviews", title = "Job interviews", goal = "Present yourself, describe achievements and handle hard questions in an interview.", intro = LessonIntro(explanation = listOf("The achievement formula: situation → action → result. “The team was behind (S). I rebuilt the schedule (A) and we shipped on time (R).”", "Weakness questions want honesty plus growth: “I used to over-plan; now I timebox decisions.”", "Buy time politely: “That's a good question — let me think for a second.” Silence feels longer to you than to them."), examples = listOf(ExampleLine(text = "I've led a team of five for three years.", meaning = "Present perfect for ongoing relevance."), ExampleLine(text = "The project was behind, so I rebuilt the schedule.", meaning = "Situation + action."), ExampleLine(text = "As a result, we shipped two weeks early.", meaning = "Result with a number if possible."), ExampleLine(text = "I used to over-plan; now I timebox decisions.", meaning = "Weakness + growth."), ExampleLine(text = "That's a good question — let me think for a second.", meaning = "Buying time."), ExampleLine(text = "I'm particularly proud of the migration project.", meaning = "Selective pride."))), expressions = listOf(TargetExpression(text = "I've + participle + for/since", meaning = "Experience that continues.", note = "I've worked here since 2021."), TargetExpression(text = "The situation was …, so I …", meaning = "Story spine.", note = "S-A-R: situation, action, result."), TargetExpression(text = "As a result, …", meaning = "Land the outcome.", note = "Numbers beat adjectives."), TargetExpression(text = "I used to …; now I …", meaning = "Weakness + growth.", note = "Never say “I'm a perfectionist”."), TargetExpression(text = "Let me think for a second.", meaning = "Buy time.", note = "Then answer in structure."), TargetExpression(text = "I'm particularly proud of …", meaning = "Choose your highlight.", note = "One story, told well.")), situation = "Interview rehearsal: introduce your experience, tell one achievement with S-A-R, answer the weakness question and negotiate next steps.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Describe your current role and how long you've had it.", expected = listOf("I've worked as a <role> for <time>.", "I've been a <role> since <year>."), focus = "present perfect", watch = "for + period, since + point."), PracticeQuestion(prompt = "Tell one achievement as a story. (situation → action → result)", expected = listOf("The project was behind, so I rebuilt the schedule, and as a result we shipped on time."), focus = "S-A-R", watch = "The result is the point — land it with as a result."), PracticeQuestion(prompt = "Answer the weakness question honestly with growth.", expected = listOf("I used to over-plan; now I timebox decisions."), focus = "weakness + growth", watch = "used to for the old habit, now for the fix."), PracticeQuestion(prompt = "Buy time on a hard question.", expected = listOf("That's a good question — let me think for a second."), focus = "buying time", watch = "Then structure the answer: point, example, close."), PracticeQuestion(prompt = "Explain why you want this job. (growth + contribution)", expected = listOf("I want to grow into <area>, and I believe I can contribute <strength>."), focus = "two-sided motivation", watch = "What you gain AND what you bring."), PracticeQuestion(prompt = "Close the interview politely.", expected = listOf("Thank you — I look forward to hearing from you."), focus = "closing", watch = "look forward to + -ing."))), exercises = listOf(Exercise(id = "en-work-u1-interviews-e1", kind = "choice", prompt = "I've worked here ___ 2021.", options = listOf("since", "for", "from", "during"), answers = listOf("since"), explain = "since + point in time; for + period."), Exercise(id = "en-work-u1-interviews-e2", kind = "gap", prompt = "___ a result, we shipped two weeks early.", options = listOf(), answers = listOf("as"), explain = "As a result + outcome."), Exercise(id = "en-work-u1-interviews-e3", kind = "order", prompt = "Buy time politely.", options = listOf(), answers = listOf("That's a good question let me think for a second"), explain = "The buying-time formula."), Exercise(id = "en-work-u1-interviews-e4", kind = "written", prompt = "Weakness + growth: over-plan → timebox.", options = listOf(), answers = listOf("i used to over-plan now i timebox decisions", "i used to over plan now i timebox decisions"), explain = "used to (old) + now (new).")), skills = listOf("grammar:present-perfect", "grammar:used-to", "function:talk-about-work", "speaking:justify-opinion", "function:introduce-yourself"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-perfect", "grammar:used-to"))))
}

object EsFoundationsU1 {
    val unit = CourseUnit(id = "es-foundations-u1", title = "First sentences", subtitle = "Say who you are", level = "A1", themes = listOf(ConversationTheme("lang-exchange", "Language-exchange café", "Meet and greet", "person.2", "Course", "You are at a friendly language-exchange café in Madrid. Meet the learner, exchange names, countries and jobs using the verb ser.", 0),
                ConversationTheme("introductions", "Nice to meet you", "Start somewhere small", "hand.wave", "Connection", "Meet the learner for the first time. Learn their interests through natural introductions.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u1-ser", title = "The verb “ser”", goal = "Introduce yourself and say who people are with soy, eres, es, somos, son.", intro = LessonIntro(explanation = listOf("Every Spanish sentence needs a subject and a verb. The most important verb for saying who you are is “ser”.", "One verb, five present forms: yo soy, tú eres, él/ella es, nosotros somos, ellos/ellas son. With “you” formal, use usted es.", "Use ser for identity and origin: “Soy Ana”, “Soy de España”, “Es profesora”. These facts do not change, so ser is the verb."), examples = listOf(ExampleLine(text = "Soy Ana. Soy de España.", meaning = "Your name and country."), ExampleLine(text = "Eres mi mejor amigo.", meaning = "A close bond with someone."), ExampleLine(text = "Ella es profesora.", meaning = "Someone's profession."), ExampleLine(text = "Somos muy felices hoy.", meaning = "A feeling that defines right now."), ExampleLine(text = "El café es cercano a la estación.", meaning = "Where a place is."), ExampleLine(text = "Ellos son de Madrid.", meaning = "Someone's origin."))), expressions = listOf(TargetExpression(text = "Soy …", meaning = "Introduce yourself.", note = "With your name, job or feeling: Soy Ana. Soy profesora."), TargetExpression(text = "Soy de …", meaning = "Say where you come from.", note = "Never “Soy España” — the de is obligatory: Soy de España."), TargetExpression(text = "¿Eres …?", meaning = "Ask about the other person.", note = "¿Eres estudiante? ¿Eres de aquí?"), TargetExpression(text = "Sí, lo soy. / No, no lo soy.", meaning = "Short answers to an ¿Eres…? question.", note = "Repeat the verb through lo: never just “Sí”."), TargetExpression(text = "Es …", meaning = "Say what someone else is.", note = "Es profesor — the article is often dropped with jobs: Es médico."), TargetExpression(text = "Encantado de conocerte.", meaning = "The fixed phrase when you meet someone.", note = "Answer with Encantada if you are a woman, or Igualmente.")), situation = "You meet someone new at a friendly language-exchange café in Madrid. Introduce yourselves and ask simple questions with the verb ser.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "¡Hola! Soy Ana. ¿Cómo te llamas?", expected = listOf("Me llamo <name>.", "Soy <name>."), focus = "Me llamo / Soy", watch = "Answering only the name without the verb: accept it, then recast “Me llamo …”."), PracticeQuestion(prompt = "¿De dónde eres?", expected = listOf("Soy de <country>."), focus = "ser + de", watch = "“Soy España” — recast “Soy DE España”, stress de."), PracticeQuestion(prompt = "¿Eres estudiante?", expected = listOf("Sí, lo soy.", "No, no lo soy."), focus = "short answers with ser", watch = "“Sí estudiante” — the short answer needs the verb."), PracticeQuestion(prompt = "¿Cómo estás hoy?", expected = listOf("Estoy bien.", "Estoy cansado.", "Estoy feliz."), focus = "estar for feelings", watch = "“Soy cansado” — recast “Estoy cansado”: feelings take estar."), PracticeQuestion(prompt = "Tu ciudad, ¿es grande o pequeña?", expected = listOf("Es grande.", "Es pequeña.", "Mi ciudad es …"), focus = "es with things and places", watch = "“Mi ciudad grande” — recast “Mi ciudad ES grande”."), PracticeQuestion(prompt = "¡Ya somos amigos! ¿De dónde es tu familia?", expected = listOf("Es de <country>.", "Mi familia es de <country>."), focus = "es for a group's origin", watch = "“Mi familia de …” — recast with es."))), exercises = listOf(Exercise(id = "es-foundations-u1-ser-e1", kind = "choice", prompt = "Ella ___ profesora.", options = listOf("es", "eres", "soy", "somos"), answers = listOf("es"), explain = "With él/ella/usted, ser becomes es."), Exercise(id = "es-foundations-u1-ser-e2", kind = "gap", prompt = "Nosotros ___ de Madrid.", options = listOf(), answers = listOf("somos"), explain = "With nosotros, ser is siempre somos."), Exercise(id = "es-foundations-u1-ser-e3", kind = "order", prompt = "Say where you are from.", options = listOf(), answers = listOf("Soy de España"), explain = "Soy + de + country: Soy de España."), Exercise(id = "es-foundations-u1-ser-e4", kind = "written", prompt = "Introduce yourself in one sentence: say your name.", options = listOf(), answers = listOf("Me llamo <name>", "Soy <name>"), explain = "Me llamo Ana / Soy Ana — the verb is never dropped.")), skills = listOf("grammar:verb-be", "grammar:subject-pronouns", "function:describe-people", "speaking:short-answer"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:verb-be")),
    Lesson(id = "es-foundations-u1-questions", title = "Questions & negatives", goal = "Ask yes/no questions and say what is not true, with ¿Eres…? and no soy.", intro = LessonIntro(explanation = listOf("To ask a yes/no question in Spanish, keep the word order and just add the question marks — your voice goes up at the end: “¿Eres Ana?”", "Question words carry an accent: ¿Qué? ¿Dónde? ¿Cómo? They go first: “¿De dónde eres?”", "To say something is not true, put no before the verb: “No soy Ana”, “No somos amigos”. In answers, no… twice is normal: “No, no lo soy”."), examples = listOf(ExampleLine(text = "¿Eres tú profesora?", meaning = "A yes/no question with eres."), ExampleLine(text = "No soy de Madrid.", meaning = "A negative with soy."), ExampleLine(text = "¿De dónde eres?", meaning = "Question word + eres."), ExampleLine(text = "Él no es mi hermano.", meaning = "A negative about another person."), ExampleLine(text = "¿Sois vosotros vecinos?", meaning = "Asking a group."), ExampleLine(text = "¿Qué es esto?", meaning = "What is this?"))), expressions = listOf(TargetExpression(text = "¿Eres …?", meaning = "Ask a yes/no question.", note = "Same order as the statement, just the marks and rising tone."), TargetExpression(text = "No soy …", meaning = "Say what is not true about you.", note = "No always goes before the verb: No soy de Sevilla."), TargetExpression(text = "¿De dónde eres?", meaning = "Ask where someone is from.", note = "De dónde, two words with accents."), TargetExpression(text = "No es …", meaning = "Say what someone else is not.", note = "Él no es mi jefe."), TargetExpression(text = "¿Verdad?", meaning = "Tag a statement to check it.", note = "Es tu casa, ¿verdad?"), TargetExpression(text = "Claro.", meaning = "The natural yes in talk.", note = "Also: Por supuesto.")), situation = "You chat with a new neighbour in the lift in Madrid. Ask simple yes/no questions and say what is and isn't true for you.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "¿Eres de aquí?", expected = listOf("Sí, soy de aquí.", "No, no soy de aquí."), focus = "short answers", watch = "One-word “Sí” — recast with the verb: Sí, soy de aquí."), PracticeQuestion(prompt = "¿Eres profesor o estudiante?", expected = listOf("Soy profesor.", "Soy estudiante.", "Soy profesora."), focus = "choice with ser", watch = "Accept either; recast with the article dropped: Soy profesor."), PracticeQuestion(prompt = "¿Tu familia es grande?", expected = listOf("Sí, es grande.", "No, no es grande."), focus = "es in questions about others", watch = "“Mi familia es grande, ¿verdad?” is also fine."), PracticeQuestion(prompt = "¿De dónde eres tú?", expected = listOf("Soy de <country>."), focus = "de dónde + soy", watch = "“Soy de” never “Soy en”."), PracticeQuestion(prompt = "Dime algo que no eres.", expected = listOf("No soy <job>.", "No soy de <country>."), focus = "negation with no soy", watch = "“No soy” before the rest: never “Soy no”."), PracticeQuestion(prompt = "¿Somos amigos ya?", expected = listOf("Sí, somos amigos.", "Claro, somos amigos."), focus = "somos in questions", watch = "“Sí, estamos amigos” mixes ser and estar — recast with somos."))), exercises = listOf(Exercise(id = "es-foundations-u1-questions-e1", kind = "choice", prompt = "¿___ tú de Barcelona?", options = listOf("Eres", "Es", "Soy", "Somos"), answers = listOf("Eres"), explain = "With tú, questions start with Eres."), Exercise(id = "es-foundations-u1-questions-e2", kind = "gap", prompt = "Ella no ___ mi hermana.", options = listOf(), answers = listOf("es"), explain = "no + es: with ella the negative keeps es."), Exercise(id = "es-foundations-u1-questions-e3", kind = "order", prompt = "Say you are not from Seville.", options = listOf(), answers = listOf("No soy de Sevilla"), explain = "No goes first: No soy de Sevilla."), Exercise(id = "es-foundations-u1-questions-e4", kind = "written", prompt = "Make it negative: \"Soy de Valencia.\"", options = listOf(), answers = listOf("No soy de Valencia"), explain = "no + soy: No soy de Valencia.")), skills = listOf("grammar:verb-be", "grammar:present-questions", "function:ask-simple-questions", "speaking:short-answer"), prerequisites = listOf("grammar:subject-pronouns")),
    Lesson(id = "es-foundations-u1-introduce", title = "Introducing yourself", goal = "Give a complete self-introduction: name, country, nationality and job.", intro = LessonIntro(explanation = listOf("A full Spanish introduction has four pieces: your name, your city or country, your nationality and your job.", "For the name: “Me llamo Ana” (I call myself Ana) or simply “Soy Ana”. For origin: “Soy de España”. Nationalities are lower-case: “soy española”.", "Jobs with ser drop the article: “Soy profesora”, not “Soy una profesora”. Add “Mucho gusto” at the end to close politely."), examples = listOf(ExampleLine(text = "Me llamo Ana. Mucho gusto.", meaning = "Your name plus a polite close."), ExampleLine(text = "Soy de Sevilla, del sur de España.", meaning = "City inside country."), ExampleLine(text = "Soy española, de Andalucía.", meaning = "Nationality plus region."), ExampleLine(text = "Soy enfermera en un hospital.", meaning = "Job plus workplace."), ExampleLine(text = "Tengo veinticinco años.", meaning = "Your age — with tener, not ser."), ExampleLine(text = "Encantada. ¿Y tú?", meaning = "Close and bounce the question back."))), expressions = listOf(TargetExpression(text = "Me llamo …", meaning = "Give your name.", note = "Literally “I call myself”. Also: Mi nombre es …"), TargetExpression(text = "Soy + nationality", meaning = "Say your nationality.", note = "española, francesa, alemana — nationality is lower-case in Spanish."), TargetExpression(text = "Soy de …", meaning = "Say your city or country.", note = "Soy de Sevilla; Soy de España."), TargetExpression(text = "Trabajo en …", meaning = "Say where you work.", note = "Trabajo en un hospital / en una escuela."), TargetExpression(text = "Mucho gusto.", meaning = "Polite close when you meet someone.", note = "Answer: Igualmente."), TargetExpression(text = "¿Y tú?", meaning = "Bounce the question back.", note = "—Soy de Madrid. ¿Y tú?")), situation = "Your first day at a language school in Madrid. Present yourself completely to the class: name, city, nationality and job.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "¿Cómo te llamas?", expected = listOf("Me llamo <name>.", "Soy <name>."), focus = "name formulas", watch = "Both are fine; recast the shorter one as Me llamo for variety."), PracticeQuestion(prompt = "¿De dónde eres?", expected = listOf("Soy de <country>."), focus = "origin", watch = "Never drop de: Soy DE <country>."), PracticeQuestion(prompt = "¿Cuál es tu nacionalidad?", expected = listOf("Soy <nationality>."), focus = "nationality with ser", watch = "Lower-case: soy española, not Española."), PracticeQuestion(prompt = "¿A qué te dedicas?", expected = listOf("Soy <job>.", "Trabajo en <place>."), focus = "jobs without article", watch = "“Soy una profesora” — recast dropping the article."), PracticeQuestion(prompt = "¿Y dónde vives?", expected = listOf("Vivo en <city>."), focus = "vivo en", watch = "“Vivo a Madrid” — recast with en."), PracticeQuestion(prompt = "¡Encantado! ¿Y tú, de qué trabajas?", expected = listOf("Soy <job>.", "Trabajo de <job>."), focus = "bounce back and answer", watch = "Accept Soy de <job>? No — recast: Trabajo DE/Soy <job>."))), exercises = listOf(Exercise(id = "es-foundations-u1-introduce-e1", kind = "choice", prompt = "___ Ana. Mucho gusto.", options = listOf("Me llamo", "Me llamo de", "Llamo", "Estoy"), answers = listOf("Me llamo"), explain = "Me llamo + name: one piece, no de."), Exercise(id = "es-foundations-u1-introduce-e2", kind = "gap", prompt = "Soy ___ Italia. (nationality)", options = listOf(), answers = listOf("italiana"), explain = "Nationality is lower-case: italiana, italiano."), Exercise(id = "es-foundations-u1-introduce-e3", kind = "order", prompt = "Say your name and city.", options = listOf(), answers = listOf("Soy Ana y soy de Madrid"), explain = "Two soy pieces, both with their verb."), Exercise(id = "es-foundations-u1-introduce-e4", kind = "written", prompt = "Give your complete introduction: name and country.", options = listOf(), answers = listOf("Me llamo <name> y soy de <country>", "Soy <name> y soy de <country>", "Me llamo <name>, soy de <country>"), explain = "Name + origin, each with its verb.")), skills = listOf("grammar:verb-be", "function:introduce-yourself", "vocab:introductions", "pron:word-stress"), canDo = listOf("introduce-yourself"))))
}

object EsFoundationsU2 {
    val unit = CourseUnit(id = "es-foundations-u2", title = "Mi día a día", subtitle = "Rutinas y planes", level = "A1", themes = listOf(ConversationTheme("manana-locura", "Mañana de locos", "La rutina contra el reloj", "sunrise", "Course", "Cuentas tu mañana minuto a minuto: qué haces, a qué hora y qué siempre se olvida.", 0),
                ConversationTheme("finde-juntos", "El finde juntos", "¿Qué hacemos?", "figure.walk", "Course", "Planes para el sábado con un amigo: qué quieres hacer y a qué hora os veis.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u2-rutina", title = "Mi rutina", goal = "Contar tu día con verbos en presente y las horas.", intro = LessonIntro(explanation = listOf("El presente sirve para rutinas: «Me levanto a las siete. Desayuno café y tostadas. Salgo de casa a las ocho».", "Los reflejos van con pronombre: «me levanto, me ducho, me acuesto» — el me es parte del verbo.", "Las horas en punto o y media: «a las siete», «a las siete y media». Con a: «a las ocho salgo»."), examples = listOf(ExampleLine(text = "Me levanto a las siete.", meaning = "El primer verbo del día."), ExampleLine(text = "Desayuno café y tostadas.", meaning = "El desayuno, sin pronombre."), ExampleLine(text = "Me ducho y salgo de casa a las ocho.", meaning = "Dos acciones seguidas."), ExampleLine(text = "Ceno a las nueve y me acuesto a las once.", meaning = "La rutina de noche."), ExampleLine(text = "Los sábados me levanto tarde.", meaning = "El hábito de fin de semana."))), expressions = listOf(TargetExpression(text = "Me levanto a las …", meaning = "El inicio.", note = "…siete, o tarde los sábados."), TargetExpression(text = "Desayuno / ceno …", meaning = "Comidas como verbos.", note = "Desayuno café."), TargetExpression(text = "Me ducho / me acuesto", meaning = "Reflejos del día.", note = "El me es obligatorio."), TargetExpression(text = "Salgo de casa a las …", meaning = "La salida.", note = "salir de + lugar."), TargetExpression(text = "Los sábados …", meaning = "El hábito de finde.", note = "plural = todos los sábados.")), situation = "Cuentas tu mañana a un amigo nuevo: hora de levantarte, desayuno, ducha, salida — y cómo cambia el sábado.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di a qué hora te levantas entre semana.", expected = listOf("Me levanto a las <hora> entre semana."), focus = "me levanto", watch = "El reflejo lleva me: me levanto, no levanto me."), PracticeQuestion(prompt = "Di qué desayunas.", expected = listOf("Desayuno <comida> y <comida>."), focus = "desayunar", watch = "Desayuno café — el verbo y la comida comparten raíz."), PracticeQuestion(prompt = "Di a qué hora sales de casa.", expected = listOf("Salgo de casa a las <hora>."), focus = "salir de", watch = "salir DE casa — la preposición importa."), PracticeQuestion(prompt = "Di cómo cambia tu sábado.", expected = listOf("Los sábados me levanto tarde."), focus = "los + día", watch = "Los sábados = todos los sábados."), PracticeQuestion(prompt = "Di a qué hora te acuestas.", expected = listOf("Me acuesto a las <hora>."), focus = "me acuesto", watch = "Reflejo: me acuesto, no acuesto me."))), exercises = listOf(Exercise(id = "es-foundations-u2-rutina-e1", kind = "choice", prompt = "Me ___ a las siete todos los días.", options = listOf("levanto", "levanto me", "levanta", "levantarse"), answers = listOf("levanto"), explain = "Me levanto: el me va delante."), Exercise(id = "es-foundations-u2-rutina-e2", kind = "gap", prompt = "___ café y tostadas. (desayunar)", options = listOf(), answers = listOf("Desayuno", "desayuno"), explain = "Primera persona: desayuno."), Exercise(id = "es-foundations-u2-rutina-e3", kind = "order", prompt = "Di a qué hora sales.", options = listOf(), answers = listOf("Salgo de casa a las ocho"), explain = "salgo de + lugar + a las + hora."), Exercise(id = "es-foundations-u2-rutina-e4", kind = "written", prompt = "Di tu hábito de los sábados.", options = listOf(), answers = listOf("los sábados me levanto tarde", "los sabados desayuno tarde"), explain = "Los + día + presente.")), skills = listOf("grammar:present-simple", "grammar:time-expressions", "vocab:daily-routine", "function:talk-about-routines"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u2-barrio", title = "Mi barrio", goal = "Decir qué hay en tu barrio con hay y dónde está.", intro = LessonIntro(explanation = listOf("Hay sirve para todo lo que existe: «Hay una plaza, dos bares y una frutería». No cambia con plural.", "Para preguntar: «¿Hay una farmacia por aquí?». Para negar: «No hay cine, lo siento».", "Ubica con cerca de / al lado de / enfrente de: «La frutería está enfrente del parque»."), examples = listOf(ExampleLine(text = "Hay una plaza y dos bares.", meaning = "hay no cambia con plural."), ExampleLine(text = "¿Hay una farmacia por aquí?", meaning = "La pregunta útil."), ExampleLine(text = "No hay cine en mi barrio.", meaning = "La negación."), ExampleLine(text = "La frutería está enfrente del parque.", meaning = "Ubicación exacta."), ExampleLine(text = "Todo está cerca de mi casa.", meaning = "El resumen cómodo."))), expressions = listOf(TargetExpression(text = "Hay + lugar", meaning = "Decir qué existe.", note = "Hay una panadería."), TargetExpression(text = "¿Hay … por aquí?", meaning = "Preguntar.", note = "…una farmacia?"), TargetExpression(text = "No hay …", meaning = "Lo que falta.", note = "No hay metro, lo siento."), TargetExpression(text = "está enfrente de / al lado de", meaning = "Ubicación.", note = "enfrente del parque."), TargetExpression(text = "cerca de mi casa", meaning = "La distancia.", note = "todo está cerca.")), situation = "Un visitante pregunta qué hay en tu barrio: nombra cuatro sitios, di lo que falta y ubica tu favorito.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di dos sitios que hay en tu barrio.", expected = listOf("Hay <lugar> y <lugar>."), focus = "hay", watch = "Hay no cambia: hay uno, hay dos."), PracticeQuestion(prompt = "Di lo que no hay. (cine)", expected = listOf("No hay cine en mi barrio."), focus = "no hay", watch = "No hay + lugar sin artículo."), PracticeQuestion(prompt = "Pregunta si hay farmacia cerca.", expected = listOf("¿Hay una farmacia por aquí?"), focus = "por aquí", watch = "por aquí = cerca, en esta zona."), PracticeQuestion(prompt = "Ubica tu sitio favorito.", expected = listOf("<Lugar> está enfrente de <lugar>."), focus = "enfrente de", watch = "enfrente DE + lugar."), PracticeQuestion(prompt = "Di que todo está cerca de tu casa.", expected = listOf("Todo está cerca de mi casa."), focus = "cerca de", watch = "cerca DE mi casa."))), exercises = listOf(Exercise(id = "es-foundations-u2-barrio-e1", kind = "choice", prompt = "___ dos bares y una panadería.", options = listOf("Hay", "Están", "Es", "Son"), answers = listOf("Hay"), explain = "Hay para decir qué existe."), Exercise(id = "es-foundations-u2-barrio-e2", kind = "gap", prompt = "No ___ metro en mi barrio. (existe)", options = listOf(), answers = listOf("hay"), explain = "No hay + lugar."), Exercise(id = "es-foundations-u2-barrio-e3", kind = "order", prompt = "Pregunta por una farmacia.", options = listOf(), answers = listOf("Hay una farmacia por aqui cerca"), explain = "¿Hay + lugar + por aquí?"), Exercise(id = "es-foundations-u2-barrio-e4", kind = "written", prompt = "Di qué hay enfrente de tu casa.", options = listOf(), answers = listOf("hay <lugar> enfrente de mi casa", "esta <lugar>"), explain = "Hay + lugar + enfrente de.")), skills = listOf("vocab:town", "grammar:there-is-are", "grammar:prepositions-place", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:there-is-are")),
    Lesson(id = "es-foundations-u2-planes", title = "Planes para el finde", goal = "Proponer planes con vamos a y quedar.", intro = LessonIntro(explanation = listOf("El futuro cercano: ir a + infinitivo. «El sábado vamos a ir al mercado». Va conjugado el ir, no el segundo verbo.", "Proponer: «¿Vamos al parque?», «¿Quieres venir?». Quedar es el verbo de las citas: «¿Quedamos a las seis?»", "Confirmar con hora y lugar: «Perfecto, a las seis en la plaza». Un plan sin lugar es un deseo."), examples = listOf(ExampleLine(text = "El sábado vamos a ir al mercado.", meaning = "ir a + infinitivo."), ExampleLine(text = "¿Quieres venir con nosotros?", meaning = "Invitar."), ExampleLine(text = "¿Quedamos a las seis en la plaza?", meaning = "Quedar = la cita."), ExampleLine(text = "Perfecto, ahí nos vemos.", meaning = "Confirmar."), ExampleLine(text = "Si llueve, lo dejamos para el domingo.", meaning = "El plan B."))), expressions = listOf(TargetExpression(text = "vamos a + infinitivo", meaning = "El plan conjunto.", note = "vamos a ir al mercado."), TargetExpression(text = "¿Quieres venir?", meaning = "Invitar.", note = "venir con + personas."), TargetExpression(text = "¿Quedamos a las … en …?", meaning = "La cita.", note = "quedar = vernos."), TargetExpression(text = "Perfecto / Vale", meaning = "Confirmar.", note = "Vale es el sí español."), TargetExpression(text = "Si llueve, …", meaning = "El plan B.", note = "si + presente, plan.")), situation = "Organizas el sábado con un amigo: propones mercado, quedáis a las seis en la plaza y dejáis el plan B si llueve.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Proponer el plan del sábado. (mercado, vamos a)", expected = listOf("El sábado vamos a ir al mercado."), focus = "vamos a", watch = "ir conjugado + a + infinitivo."), PracticeQuestion(prompt = "Invitar a tu amigo.", expected = listOf("¿Quieres venir conmigo?"), focus = "venir", watch = "venir con + persona."), PracticeQuestion(prompt = "Quedar en hora y lugar. (6, plaza)", expected = listOf("¿Quedamos a las seis en la plaza?"), focus = "quedar", watch = "quedar = vernos, citarse."), PracticeQuestion(prompt = "Dejar plan B si llueve.", expected = listOf("Si llueve, lo dejamos para el domingo."), focus = "si + presente", watch = "si + presente + plan."), PracticeQuestion(prompt = "Invita a tu amigo al plan.", expected = listOf("¿Quieres venir conmigo?", "¿Quieres venir con nosotros?"), focus = "venir", watch = "venir CON + persona."))), exercises = listOf(Exercise(id = "es-foundations-u2-planes-e1", kind = "choice", prompt = "El sábado vamos a ___ al mercado.", options = listOf("ir", "vamos", "van", "iremos"), answers = listOf("ir"), explain = "ir a + infinitivo: el segundo va sin conjugar."), Exercise(id = "es-foundations-u2-planes-e2", kind = "gap", prompt = "¿___ quedar a las seis? (proponer)", options = listOf(), answers = listOf("Quedamos", "Podemos"), explain = "¿Quedamos a las…?"), Exercise(id = "es-foundations-u2-planes-e3", kind = "order", prompt = "Confirmar la cita.", options = listOf(), answers = listOf("Quedamos a las seis en la plaza"), explain = "quedar + a las + hora + en + lugar."), Exercise(id = "es-foundations-u2-planes-e4", kind = "written", prompt = "Tu plan B si llueve.", options = listOf(), answers = listOf("si llueve lo dejamos para el domingo", "si llueve vamos al cine"), explain = "Si + presente + plan.")), skills = listOf("grammar:going-to", "function:make-future-plans", "vocab:social-expressions", "grammar:present-questions"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to"))))
}

object EsFoundationsU3 {
    val unit = CourseUnit(id = "es-foundations-u3", title = "La comida", subtitle = "Ingredientes y recetas", level = "A1", themes = listOf(ConversationTheme("cocina-juntos", "Cocinando juntos", "Receta sencilla", "fork.knife", "Course", "Cocináis una paella: revisáis ingredientes, seguid los pasos y compartimos.", 0),
                ConversationTheme("en-el-mercado", "En el mercado", "Fruta y verdura", "cart", "Course", "Compráis la comida de la semana: fruta, verdura, pan — contando y preguntando precios.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u3-comida", title = "La comida de casa", goal = "Hablar de comida, ingredientes y lo que te gusta comer.", intro = LessonIntro(explanation = listOf("La comida se agrupa: fruta (manzana, plátano), verdura (tomate, cebolla), carne (pollo, cerdo).", "Me gusta + infinitivo o sustantivo: «Me gusta el arroz». «Me gusta cocinar».", "Para preguntar: «¿Qué te gusta comer?» — la respuesta repite me gusta."), examples = listOf(ExampleLine(text = "Me gusta el arroz con pollo.", meaning = "me gusta + sustantivo."), ExampleLine(text = "Me gusta cocinar los domingos.", meaning = "me gusta + infinitivo."), ExampleLine(text = "¿Qué te gusta comer?", meaning = "La pregunta clásica."), ExampleLine(text = "Necesito tomates y cebollas.", meaning = "necesito + ingredientes."), ExampleLine(text = "El pan está en la mesa.", meaning = "estar + ubicación."))), expressions = listOf(TargetExpression(text = "Me gusta + comida", meaning = "Decir lo que te gusta.", note = "Me gusta el pollo."), TargetExpression(text = "No me gusta …", meaning = "Lo contrario.", note = "No me gusta el pescado."), TargetExpression(text = "¿Qué te gusta …?", meaning = "Preguntar.", note = "…comer? …cocinar?"), TargetExpression(text = "Necesito + ingrediente", meaning = "La lista de compra.", note = "Necesito aceite."), TargetExpression(text = "Está / están en …", meaning = "Ubicación de comida.", note = "Los huevos están en la nevera.")), situation = "Compráis la comida del finde: uno lee la lista, el otro busca en el súper y pregunta por lo que falta.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di qué te gusta comer.", expected = listOf("Me gusta <comida>."), focus = "me gusta", watch = "«Me gusta EL arroz» — el artículo importa con comida específica."), PracticeQuestion(prompt = "Di algo que NO te gusta.", expected = listOf("No me gusta <comida>."), focus = "no me gusta", watch = "Más suave que «odio»."), PracticeQuestion(prompt = "Di dos cosas que necesitas comprar.", expected = listOf("Necesito <comida> y <comida>."), focus = "necesito", watch = "Necesito + sustantivo."), PracticeQuestion(prompt = "Pregunta qué le gusta a tu amigo.", expected = listOf("¿Qué te gusta comer?"), focus = "la pregunta", watch = "La respuesta usa me gusta también."), PracticeQuestion(prompt = "¿Te gusta el pescado?", expected = listOf("Sí, me gusta.", "No, no me gusta."), focus = "me gusta", watch = "gusta (singular) para un solo alimento."))), exercises = listOf(Exercise(id = "es-foundations-u3-comida-e1", kind = "choice", prompt = "Me ___ el arroz con pollo.", options = listOf("gusta", "gustan", "gusto", "gustamos"), answers = listOf("gusta"), explain = "Me gusta + singular: el arroz."), Exercise(id = "es-foundations-u3-comida-e2", kind = "gap", prompt = "Me ___ las verduras. (plural: gustar)", options = listOf(), answers = listOf("gustan"), explain = "Me gustan + plural: las verduras."), Exercise(id = "es-foundations-u3-comida-e3", kind = "order", prompt = "Pregunta qué le gusta comer.", options = listOf(), answers = listOf("Que te gusta comer"), explain = "¿Qué te gusta comer?"), Exercise(id = "es-foundations-u3-comida-e4", kind = "written", prompt = "Di dos cosas que necesitas para cocinar.", options = listOf(), answers = listOf("necesito <ing1> y <ing2>", "necesito aceite y sal"), explain = "Necesito X y Y.")), skills = listOf("vocab:food", "grammar:present-simple", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u3-recetas", title = "Recetas sencillas", goal = "Seguir una receta con imperativos: corta, añade, cocina.", intro = LessonIntro(explanation = listOf("Las recetas usan imperativos: «Corta la cebolla. Añade el aceite. Cocina diez minutos.»", "Los verbos de cocina: cortar, añadir, mezclar, hervir, freír.", "Las cantidades: «un poco de sal», «doscientos gramos de arroz», «medio litro de agua»."), examples = listOf(ExampleLine(text = "Corta la cebolla en trozos pequeños.", meaning = "cortar + food."), ExampleLine(text = "Añade el aceite al fuego.", meaning = "añadir + ingrediente."), ExampleLine(text = "Hierve el agua diez minutos.", meaning = "hervir + duration."), ExampleLine(text = "Necesito medio litro de agua.", meaning = "medio litro + de."), ExampleLine(text = "Mezcla todo y añade sal.", meaning = "mezclar + todo."))), expressions = listOf(TargetExpression(text = "Corta / añade / mezcla", meaning = "Los tres verbos básicos.", note = "Imperativo: tú sin -s final."), TargetExpression(text = "Hierve / fríe / cocina", meaning = "Métodos de cocción.", note = "hervir = boil."), TargetExpression(text = "un poco de + sustantivo", meaning = "Cantidad pequeña.", note = "un poco de sal."), TargetExpression(text = "medio / media + medida", meaning = "La mitad.", note = "medio litro, media taza."), TargetExpression(text = "¡Que aproveche!", meaning = "Después de cocinar.", note = "= buen provecho.")), situation = "Cocináis una tortilla de patatas: uno lee los pasos, el otro corta, añade y cocina — y los dos comen.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di el primer paso: cortar la cebolla.", expected = listOf("Corta la cebolla."), focus = "imperativo", watch = "Corta — imperativo de tú sin -s."), PracticeQuestion(prompt = "Di cuánto tiempo hervir el agua. (10 minutos)", expected = listOf("Hierve el agua diez minutos."), focus = "hervir + duration", watch = "hierve (o→ue) + duration."), PracticeQuestion(prompt = "Di cuánta sal necesitas. (un poco)", expected = listOf("Necesito un poco de sal."), focus = "un poco de", watch = "un poco DE + sustantivo."), PracticeQuestion(prompt = "Di la frase de después de comer.", expected = listOf("¡Que aproveche!"), focus = "la frase", watch = "Se dice antes de que empiecen a comer."), PracticeQuestion(prompt = "Di que hay que mezclar todo.", expected = listOf("Mezcla todo."), focus = "mezclar", watch = "Imperativo: mezcla (tú)."))), exercises = listOf(Exercise(id = "es-foundations-u3-recetas-e1", kind = "choice", prompt = "___ la cebolla en trozos pequeños.", options = listOf("Corta", "Cortas", "Cortar", "Cortando"), answers = listOf("Corta"), explain = "Imperativo: corta (tú, sin -s)."), Exercise(id = "es-foundations-u3-recetas-e2", kind = "gap", prompt = "___ el agua diez minutos. (hervir)", options = listOf(), answers = listOf("Hierve", "hierve"), explain = "hierve (o→ue) + duration."), Exercise(id = "es-foundations-u3-recetas-e3", kind = "order", prompt = "Di la cantidad.", options = listOf(), answers = listOf("Necesito medio litro de agua"), explain = "medio litro de + sustantivo."), Exercise(id = "es-foundations-u3-recetas-e4", kind = "written", prompt = "Di el ingrediente que falta: sal y ___.", options = listOf(), answers = listOf("aceite", "pimienta", "aceite y pimienta"), explain = "Cualquier ingrediente de cocina vale.")), skills = listOf("vocab:food", "grammar:imperatives", "grammar:quantities", "function:talk-about-routines"), prerequisites = listOf("grammar:present-simple"))))
}

object EsFoundationsU6 {
    val unit = CourseUnit(id = "es-foundations-u6", title = "En el mercado", subtitle = "Compra local", level = "A1", themes = listOf(ConversationTheme("mercado-dia", "Día de mercado", "Fruta y verdura fresca", "cart", "Course", "Compras en el mercado del barrio: fruta, verdura y trato con el vendedor.", 0),
                ConversationTheme("tienda-esquina", "La tienda de la esquina", "Lo que falta", "storefront", "Course", "Falta algo para la cena: corres a la tienda de la esquina.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u6-mercado", title = "En el mercado", goal = "Comprar fruta y verdura: cantidades, precios y tratamientos educados.", intro = LessonIntro(explanation = listOf("En el mercado se pregunta: «¿A cómo están los tomates?». «¿Están maduros?»", "Las cantidades: «Medio kilo de cebollas». «Un kilo de manzanas». «Doscientos gramos de jamón».", "El trato educado: «Buenos días, ¿me pone medio kilo?» — el vendedor responde «Ahora mismo»."), examples = listOf(ExampleLine(text = "¿A cómo están los tomates?", meaning = "Precio por kilo."), ExampleLine(text = "Me pone medio kilo de cebollas.", meaning = "Pedir cantidad."), ExampleLine(text = "¿Están maduros?", meaning = "Preguntar calidad."), ExampleLine(text = "Doscientos gramos de jamón.", meaning = "Peso exacto."), ExampleLine(text = "¿Le puedo poner algo más?", meaning = "El vendedor pregunta."))), expressions = listOf(TargetExpression(text = "¿A cómo están …?", meaning = "Preguntar precio en mercado.", note = "plural: están."), TargetExpression(text = "Me pone + cantidad", meaning = "Pedir en el mercado.", note = "Me pone un kilo."), TargetExpression(text = "medio kilo / un kilo de …", meaning = "Peso.", note = "medio kilo de cebollas."), TargetExpression(text = "¿Están maduros?", meaning = "Calidad de la fruta.", note = "maduro = ripe."), TargetExpression(text = "Ahora mismo.", meaning = "El vendedor responde.", note = "= inmediatamente.")), situation = "Compras en el mercado del barrio: medio kilo de tomates, un kilo de manzanas y preguntas si están maduros.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pregunta el precio de los tomates.", expected = listOf("¿A cómo están los tomates?"), focus = "a cómo", watch = "¿A cómo están? = ¿a cuánto el kilo?"), PracticeQuestion(prompt = "Pide medio kilo de cebollas.", expected = listOf("Me pone medio kilo de cebollas."), focus = "me pone", watch = "Me pone + cantidad = fórmula de mercado."), PracticeQuestion(prompt = "Pregunta si las manzanas están maduras.", expected = listOf("¿Están maduras?"), focus = "calidad", watch = "maduras (fem plural) para manzanas."), PracticeQuestion(prompt = "Di lo que necesitas: un kilo de naranjas.", expected = listOf("Necesito un kilo de naranjas."), focus = "necesito", watch = "necesito + cantidad + comida."), PracticeQuestion(prompt = "Pide doscientos gramos de jamón.", expected = listOf("Me pone doscientos gramos de jamón.", "Quiero doscientos gramos de jamón."), focus = "me pone", watch = "Me pone + cantidad."))), exercises = listOf(Exercise(id = "es-foundations-u6-mercado-e1", kind = "choice", prompt = "¿A cómo ___ los tomates?", options = listOf("están", "es", "hay", "son"), answers = listOf("están"), explain = "¿A cómo están? — precio en mercado."), Exercise(id = "es-foundations-u6-mercado-e2", kind = "gap", prompt = "Me ___ un kilo de manzanas. (pedir)", options = listOf(), answers = listOf("pone"), explain = "Me pone — fórmula de mercado."), Exercise(id = "es-foundations-u6-mercado-e3", kind = "order", prompt = "Pide medio kilo de cebollas.", options = listOf(), answers = listOf("Me pone medio kilo de cebollas"), explain = "Me pone + cantidad."), Exercise(id = "es-foundations-u6-mercado-e4", kind = "written", prompt = "Pregunta si las manzanas están maduras.", options = listOf(), answers = listOf("estan maduras", "¿están maduras?"), explain = "¿Están maduras?")), skills = listOf("vocab:food", "grammar:quantities", "vocab:shopping", "function:go-shopping"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u6-tienda", title = "La tienda de la esquina", goal = "Comprar lo que falta: decir lo que buscas y pagar.", intro = LessonIntro(explanation = listOf("En la tienda pequeña: «¿Tiene…?» «Estoy buscando…». El tendero responde: «Sí, aquí tiene» o «Lo siento, no queda».", "No queda = se acabó. «¿No queda pan?» «No, se acabó hace un rato».", "El pago: «¿Cuánto es?» «Son tres euros». «Pague con tarjeta»."), examples = listOf(ExampleLine(text = "¿Tiene pan integral?", meaning = "Preguntar si tienen."), ExampleLine(text = "Estoy buscando levadura.", meaning = "Buscar algo específico."), ExampleLine(text = "Lo siento, no queda.", meaning = "El tendero dice que no."), ExampleLine(text = "¿Cuánto es?", meaning = "Preguntar el total."), ExampleLine(text = "Son tres euros con cincuenta.", meaning = "El precio total."))), expressions = listOf(TargetExpression(text = "¿Tiene …?", meaning = "Preguntar en tienda.", note = "¿Tiene leche sin lactosa?"), TargetExpression(text = "Estoy buscando …", meaning = "Buscar específico.", note = "…levadura fresca."), TargetExpression(text = "No queda / se acabó", meaning = "No hay más.", note = "Ambas dicen lo mismo."), TargetExpression(text = "¿Cuánto es?", meaning = "Preguntar el total.", note = "Son + precio."), TargetExpression(text = "aquí tiene", meaning = "El vendedor entrega.", note = "Aquí tiene su cambio.")), situation = "Corres a la tienda de la esquina antes de que cierre: buscas tres cosas, dos las tiene y una se acabó.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Preguntar si tienen leche sin lactosa.", expected = listOf("¿Tiene leche sin lactosa?"), focus = "tiene", watch = "¿Tiene…? — formal pero normal."), PracticeQuestion(prompt = "Decir que buscas algo específico.", expected = listOf("Estoy buscando <producto>."), focus = "buscando", watch = "estoy buscando = estoy en el proceso."), PracticeQuestion(prompt = "Reaccionar cuando no tienen algo.", expected = listOf("Lo siento, ¿tienen de otra marca?"), focus = "alternativa", watch = "Preguntar por alternativa."), PracticeQuestion(prompt = "Preguntar el total.", expected = listOf("¿Cuánto es?"), focus = "total", watch = "¿Cuánto es? — la pregunta universal."), PracticeQuestion(prompt = "Acepta cuando te ofrecen otra cosa: sí, vale.", expected = listOf("Sí vale.", "Vale gracias."), focus = "vale", watch = "Vale = está bien (España)."))), exercises = listOf(Exercise(id = "es-foundations-u6-tienda-e1", kind = "choice", prompt = "¿___ leche sin lactosa?", options = listOf("Tiene", "Hay", "Está", "Es"), answers = listOf("Tiene"), explain = "¿Tiene…? para preguntar en tienda."), Exercise(id = "es-foundations-u6-tienda-e2", kind = "gap", prompt = "Estoy ___ levadura fresca. (buscar)", options = listOf(), answers = listOf("buscando"), explain = "estoy buscando + producto."), Exercise(id = "es-foundations-u6-tienda-e3", kind = "order", prompt = "Preguntar el total.", options = listOf(), answers = listOf("Cuanto es eso senior"), explain = "¿Cuánto es?"), Exercise(id = "es-foundations-u6-tienda-e4", kind = "written", prompt = "El tendero no tiene. Di que buscas otra marca.", options = listOf(), answers = listOf("busco otra marca", "estoy buscando otra marca"), explain = "buscar + alternativa.")), skills = listOf("function:go-shopping", "grammar:present-questions", "vocab:food", "function:solve-problems"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple"))))
}

object EsFoundationsU11 {
    val unit = CourseUnit(id = "es-foundations-u11", title = "Mi casa", subtitle = "Mi espacio", level = "A1", themes = listOf(ConversationTheme("mi-espacio", "Mi espacio", "Habitaciones y muebles", "house", "Course", "Describes tu piso: el salón, la cocina y lo que hay en cada habitación.", 0),
                ConversationTheme("compartir-casa", "Compartimos casa", "Cosas y personas", "bed", "Course", "Hablas de tu compañero de piso: su habitación, sus cosas y su rutina.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u11-casa", title = "Mi piso", goal = "Describir tu piso: habitaciones, muebles y qué hay en cada sitio.", intro = LessonIntro(explanation = listOf("Para decir qué existe usamos «hay»: «En la cocina hay una mesa». Negamos con «no hay»: «No hay garaje».", "Las habitaciones de casa: el salón, la cocina, el dormitorio y el baño. «El piso tiene dos habitaciones».", "Para preguntar: «¿Cuántas habitaciones hay?». Respondes: «Hay dos: el salón y el dormitorio»."), examples = listOf(ExampleLine(text = "Mi piso es pequeño.", meaning = "Describir el piso."), ExampleLine(text = "En el salón hay un sofá y una mesa.", meaning = "Decir qué hay."), ExampleLine(text = "La cocina tiene una ventana grande.", meaning = "Describir una habitación."), ExampleLine(text = "No hay garaje.", meaning = "Decir que algo no existe."), ExampleLine(text = "¿Cuántas habitaciones hay?", meaning = "Preguntar por espacios."))), expressions = listOf(TargetExpression(text = "hay un / una …", meaning = "Decir qué existe (singular).", note = "Hay un sofá nuevo."), TargetExpression(text = "no hay …", meaning = "Decir que no existe.", note = "No hay ascensor."), TargetExpression(text = "el salón / la cocina", meaning = "Habitaciones de casa.", note = "El salón es grande."), TargetExpression(text = "el dormitorio / el baño", meaning = "Más habitaciones.", note = "El baño está a la derecha."), TargetExpression(text = "¿Cuántas habitaciones hay?", meaning = "Preguntar por espacios.", note = "Hay dos habitaciones.")), situation = "Hablas de tu piso nuevo: dos habitaciones, un salón con sofá azul y una cocina pequeña sin lavavajillas.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Describe tu salón: di que hay un sofá y una mesa.", expected = listOf("En mi salon hay un sofa y una mesa", "En mi salón hay un sofá y una mesa"), focus = "hay", watch = "hay + un/una en singular."), PracticeQuestion(prompt = "Pregunta cuántas habitaciones tiene el piso.", expected = listOf("¿Cuantas habitaciones tiene el piso?", "¿Cuántas habitaciones tiene el piso?"), focus = "cuántas", watch = "En preguntas, cuántas lleva tilde."), PracticeQuestion(prompt = "Di qué hay en la cocina.", expected = listOf("Hay una mesa y dos sillas", "hay una mesa y dos sillas"), focus = "hay", watch = "hay nunca cambia: hay una mesa, hay dos sillas."), PracticeQuestion(prompt = "Habla de tu casa: el número de habitaciones.", expected = listOf("Mi piso tiene tres habitaciones", "mi piso tiene tres habitaciones"), focus = "tiene", watch = "El piso tiene + cantidad."), PracticeQuestion(prompt = "Pregunta si hay lavavajillas.", expected = listOf("¿Hay lavavajillas en la cocina?", "¿Hay lava platos en la cocina?"), focus = "¿hay…?", watch = "Pregunta con ¿Hay…? + sustantivo."))), exercises = listOf(Exercise(id = "es-foundations-u11-casa-e1", kind = "choice", prompt = "En el salón ___ un sofá grande.", options = listOf("hay", "es", "tiene", "está"), answers = listOf("hay"), explain = "Hay + un/una: decir qué existe en un lugar."), Exercise(id = "es-foundations-u11-casa-e2", kind = "gap", prompt = "Mi piso ___ dos habitaciones. (tener)", options = listOf(), answers = listOf("tiene"), explain = "tiene: el piso posee habitaciones."), Exercise(id = "es-foundations-u11-casa-e3", kind = "order", prompt = "Di qué hay en el salón: un sofá y una mesa.", options = listOf(), answers = listOf("En el salón hay un sofá y una mesa"), explain = "hay + muebles del salón."), Exercise(id = "es-foundations-u11-casa-e4", kind = "written", prompt = "Pregunta cuántas habitaciones hay.", options = listOf(), answers = listOf("¿Cuantas habitaciones hay en el piso?", "¿Cuántas habitaciones hay en el piso?"), explain = "¿Cuántas… hay? con tilde en cuántas.")), skills = listOf("grammar:there-is-are", "grammar:present-simple", "vocab:home", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u11-lugares", title = "¿Dónde está?", goal = "Decir dónde están las cosas: encima de, debajo de y al lado de.", intro = LessonIntro(explanation = listOf("Para preguntar lugar: «¿Dónde está el teléfono?». Respondes con está + lugar: «Está en la mesa».", "Las preposiciones de lugar: encima de, debajo de, al lado de. «La lámpara está encima de la mesa».", "También usas delante de y detrás de: «El gato está debajo de la cama»."), examples = listOf(ExampleLine(text = "¿Dónde está el gato?", meaning = "Preguntar lugar."), ExampleLine(text = "Está encima de la mesa.", meaning = "Posición superior."), ExampleLine(text = "El periódico está debajo de la cama.", meaning = "Posición inferior."), ExampleLine(text = "La silla está al lado de la ventana.", meaning = "Junto a la ventana."), ExampleLine(text = "El móvil está en el cajón.", meaning = "Dentro: en."))), expressions = listOf(TargetExpression(text = "¿Dónde está …?", meaning = "Preguntar por una cosa.", note = "¿Dónde están las llaves? (plural)"), TargetExpression(text = "encima de", meaning = "Sobre algo.", note = "El libro está encima de la mesa."), TargetExpression(text = "debajo de", meaning = "Bajo algo.", note = "El gato está debajo de la silla."), TargetExpression(text = "al lado de", meaning = "Junto a algo.", note = "La cama está al lado de la ventana."), TargetExpression(text = "delante de / detrás de", meaning = "Antes o después en el espacio.", note = "El coche está delante de la casa.")), situation = "Buscas las llaves en casa: están encima de la mesa del salón, al lado de un periódico viejo.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pregunta dónde está la llave.", expected = listOf("¿Donde esta la llave?", "¿Dónde está la llave?"), focus = "¿dónde está?", watch = "dónde con tilde en preguntas."), PracticeQuestion(prompt = "Di que el libro está sobre la mesa.", expected = listOf("El libro esta encima de la mesa", "El libro está encima de la mesa"), focus = "encima de", watch = "encima de = sobre."), PracticeQuestion(prompt = "Di que el gato duerme bajo la cama.", expected = listOf("El gato esta debajo de la cama", "El gato está debajo de la cama"), focus = "debajo de", watch = "debajo de = bajo."), PracticeQuestion(prompt = "Di que la silla está junto a la ventana.", expected = listOf("La silla esta al lado de la ventana", "La silla está al lado de la ventana"), focus = "al lado de", watch = "al lado de = junto a."), PracticeQuestion(prompt = "Di que las llaves están dentro del cajón.", expected = listOf("Las llaves estan en el cajon", "Las llaves están en el cajón"), focus = "en", watch = "Para dentro usamos en."))), exercises = listOf(Exercise(id = "es-foundations-u11-lugares-e1", kind = "choice", prompt = "La cama está ___ de la ventana, muy cerca.", options = listOf("al lado de", "encima de", "debajo de", "detrás de"), answers = listOf("al lado de"), explain = "al lado de = junto a, muy cerca."), Exercise(id = "es-foundations-u11-lugares-e2", kind = "gap", prompt = "El periódico está ___ de la mesa. (posición)", options = listOf(), answers = listOf("debajo"), explain = "debajo de la mesa = bajo la mesa."), Exercise(id = "es-foundations-u11-lugares-e3", kind = "order", prompt = "Di que el móvil está dentro del cajón.", options = listOf(), answers = listOf("El móvil está en el cajón"), explain = "en + lugar = dentro."), Exercise(id = "es-foundations-u11-lugares-e4", kind = "written", prompt = "Di que la lámpara está sobre la mesa.", options = listOf(), answers = listOf("La lampara esta encima de la mesa", "La lámpara está encima de la mesa"), explain = "encima de para posición superior.")), skills = listOf("grammar:prepositions-place", "grammar:there-is-are", "vocab:home", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u11-companeros", title = "Mi compañero de piso", goal = "Describir a tu compañero de piso y hablar de sus cosas con mi, tu y su.", intro = LessonIntro(explanation = listOf("Los posesivos: mi, tu, su. «Mi compañero se llama Pablo». «Tu habitación es la grande».", "su = de él o de ella. «Ana trabaja mucho; su trabajo es interesante».", "Para describir personas: «Es simpático y muy ordenado». «Trabaja por la noche»."), examples = listOf(ExampleLine(text = "Mi compañero de piso se llama Pablo.", meaning = "Decir el nombre."), ExampleLine(text = "Su habitación está limpia.", meaning = "su = de Pablo."), ExampleLine(text = "Es simpático pero ruidoso.", meaning = "Describir carácter."), ExampleLine(text = "Mi compañera estudia medicina.", meaning = "Compañera: femenino."), ExampleLine(text = "Tu bici está en el balcón.", meaning = "tu = de ti."))), expressions = listOf(TargetExpression(text = "mi / mis", meaning = "Poseedor: yo.", note = "Mis llaves están aquí."), TargetExpression(text = "tu / tus", meaning = "Poseedor: tú.", note = "Tu móvil suena."), TargetExpression(text = "su / sus", meaning = "Poseedor: él o ella.", note = "Sus libros están en el salón."), TargetExpression(text = "se llama …", meaning = "Decir el nombre.", note = "Mi compañera se llama Ana."), TargetExpression(text = "Es + adjetivo", meaning = "Describir carácter.", note = "Es ordenado y simpático.")), situation = "Presentas a Pablo: comparte la cocina, trabaja de noche y sus cosas siempre están en el salón.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di cómo se llama tu compañero de piso.", expected = listOf("Mi compañero se llama Pablo", "mi compañero se llama pablo"), focus = "se llama", watch = "se llama + nombre."), PracticeQuestion(prompt = "Di que la habitación de él es pequeña.", expected = listOf("Su habitacion es pequena", "Su habitación es pequeña"), focus = "su", watch = "su = de él o de ella."), PracticeQuestion(prompt = "Describe el carácter de tu compañera: simpática y ordenada.", expected = listOf("Es simpatica y ordenada", "Es simpática y ordenada"), focus = "es + adjetivo", watch = "Adjetivo femenino: -a."), PracticeQuestion(prompt = "Habla de tus llaves: están en la cocina.", expected = listOf("Mis llaves estan en la cocina", "Mis llaves están en la cocina"), focus = "mis", watch = "mi → mis en plural."), PracticeQuestion(prompt = "Pregunta a tu compañero por su bici.", expected = listOf("¿Donde esta tu bici?", "¿Dónde está tu bici?"), focus = "tu", watch = "tu posesivo, sin tilde; tú pronombre, con tilde."))), exercises = listOf(Exercise(id = "es-foundations-u11-companeros-e1", kind = "choice", prompt = "Pablo es mi compañero y ___ habitación es la roja.", options = listOf("su", "tu", "mis", "nuestra"), answers = listOf("su"), explain = "su = de él: la habitación de Pablo."), Exercise(id = "es-foundations-u11-companeros-e2", kind = "gap", prompt = "___ llaves están en la mesa. (posesivo de yo)", options = listOf(), answers = listOf("Mis"), explain = "mi → mis en plural: mis llaves."), Exercise(id = "es-foundations-u11-companeros-e3", kind = "order", prompt = "Presenta a tu compañera: se llama Ana.", options = listOf(), answers = listOf("Mi compañera se llama Ana"), explain = "mi + persona + se llama + nombre."), Exercise(id = "es-foundations-u11-companeros-e4", kind = "written", prompt = "Habla del carácter de él.", options = listOf(), answers = listOf("es muy simpatico", "Es muy simpático"), explain = "Es + adjetivo: simpático lleva tilde.")), skills = listOf("grammar:possessives", "function:describe-people", "vocab:home", "grammar:present-simple"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:possessives"))))
}

object EsFoundationsU12 {
    val unit = CourseUnit(id = "es-foundations-u12", title = "Mi barrio", subtitle = "Cerca de casa", level = "A1", themes = listOf(ConversationTheme("sitios-cercanos", "Sitios cercanos", "¿Qué hay por aquí?", "map", "Course", "Buscas sitios cerca de casa: supermercado, farmacia, parque y parada de autobús.", 0),
                ConversationTheme("fruta-fresca", "Fruta del barrio", "La frutería de abajo", "cart", "Course", "Compras fruta en la frutería del barrio: kilos, medio kilo y buen precio.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u12-sitios", title = "¿Hay un supermercado?", goal = "Preguntar por sitios del barrio con ¿hay? y responder con hay / no hay.", intro = LessonIntro(explanation = listOf("Para preguntar por sitios: «¿Hay un supermercado por aquí?». «¿Hay una farmacia cerca?».", "Para responder: «Sí, hay uno en la esquina». «No, no hay nada cerca».", "Sitios del barrio: el supermercado, la farmacia, el parque y la parada de autobús."), examples = listOf(ExampleLine(text = "¿Hay un supermercado por aquí?", meaning = "Preguntar por un sitio."), ExampleLine(text = "Sí, hay uno en la esquina.", meaning = "Responder que sí."), ExampleLine(text = "¿Hay una farmacia cerca?", meaning = "Preguntar distancia."), ExampleLine(text = "No, aquí no hay banco.", meaning = "Responder que no."), ExampleLine(text = "La parada de autobús está en la avenida.", meaning = "Situar un sitio."))), expressions = listOf(TargetExpression(text = "¿Hay … por aquí?", meaning = "Preguntar por sitios.", note = "¿Hay un cajero por aquí?"), TargetExpression(text = "hay uno / hay una", meaning = "Responder que sí.", note = "¿Un bar? Hay uno al lado."), TargetExpression(text = "no hay nada", meaning = "Responder que no.", note = "No hay nada cerca."), TargetExpression(text = "la esquina", meaning = "El final de la calle.", note = "Está en la esquina."), TargetExpression(text = "la parada de autobús", meaning = "Sitio del barrio.", note = "La parada está cerca.")), situation = "Llegas al barrio y preguntas: hay un supermercado en la esquina, una farmacia cerca y una parada de autobús en la avenida.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pregunta si hay un supermercado por aquí.", expected = listOf("¿Hay un supermercado por aqui?", "¿Hay un supermercado por aquí?"), focus = "¿hay…?", watch = "Pregunta con ¿Hay…? + un/una."), PracticeQuestion(prompt = "Responde que sí: hay un bar al lado.", expected = listOf("Si hay uno al lado", "Sí, hay uno al lado"), focus = "hay uno", watch = "hay uno/una sustituye al sitio."), PracticeQuestion(prompt = "Pregunta si hay una farmacia cerca.", expected = listOf("¿Hay una farmacia cerca?", "¿Hay una farmacia por aquí?"), focus = "¿hay una…?", watch = "farmacia es femenino: una."), PracticeQuestion(prompt = "Preguntan por un banco. Di que no hay.", expected = listOf("No hay nada cerca", "no hay nada cerca"), focus = "no hay nada", watch = "nada = ningún sitio."), PracticeQuestion(prompt = "Di dónde está la parada de autobús: en la avenida.", expected = listOf("La parada de autobus esta en la avenida", "La parada de autobús está en la avenida"), focus = "está en", watch = "Sitios concretos: está + en."))), exercises = listOf(Exercise(id = "es-foundations-u12-sitios-e1", kind = "choice", prompt = "¿___ una farmacia por aquí?", options = listOf("Hay", "Es", "Está", "Son"), answers = listOf("Hay"), explain = "¿Hay…? pregunta si existe un sitio."), Exercise(id = "es-foundations-u12-sitios-e2", kind = "gap", prompt = "¿Un cajero? Sí, hay ___ en la esquina. (masculino)", options = listOf(), answers = listOf("uno"), explain = "hay uno sustituye al sustantivo masculino."), Exercise(id = "es-foundations-u12-sitios-e3", kind = "order", prompt = "Responde afirmativamente: preguntan por un bar.", options = listOf(), answers = listOf("Hay un bar en la esquina"), explain = "hay + sitio + lugar."), Exercise(id = "es-foundations-u12-sitios-e4", kind = "written", prompt = "Preguntan por un banco en esta calle. Responde negativamente.", options = listOf(), answers = listOf("No hay nada cerca", "No hay ningun banco aqui", "No hay ningún banco aquí"), explain = "No hay nada / no hay ningún + sustantivo.")), skills = listOf("grammar:there-is-are", "grammar:present-questions", "vocab:town", "function:ask-simple-questions"), canDo = listOf("ask-for-directions"), prerequisites = listOf("grammar:there-is-are")),
    Lesson(id = "es-foundations-u12-direcciones", title = "¿Cómo llego?", goal = "Pedir y dar direcciones básicas: siga recto, gire a la izquierda, está cerca.", intro = LessonIntro(explanation = listOf("Para pedir direcciones: «Perdone, ¿cómo llego a la estación?». «¿Está lejos?».", "Para dar direcciones: «Siga recto». «Gire a la izquierda». «Gire a la derecha en el semáforo».", "Para la distancia: «Está a cinco minutos». «Está muy cerca, no necesita autobús»."), examples = listOf(ExampleLine(text = "Perdone, ¿cómo llego a la estación?", meaning = "Pedir direcciones."), ExampleLine(text = "Siga recto dos calles.", meaning = "Dar una dirección."), ExampleLine(text = "Gire a la izquierda en el semáforo.", meaning = "Indicar un giro."), ExampleLine(text = "¿Está lejos?", meaning = "Preguntar distancia."), ExampleLine(text = "No, está a cinco minutos andando.", meaning = "Decir que está cerca."))), expressions = listOf(TargetExpression(text = "¿Cómo llego a …?", meaning = "Pedir direcciones.", note = "¿Cómo llego al parque?"), TargetExpression(text = "siga recto", meaning = "Seguir de frente.", note = "Siga recto hasta la plaza."), TargetExpression(text = "gire a la izquierda / derecha", meaning = "Indicar un giro.", note = "Gire a la derecha."), TargetExpression(text = "está cerca / lejos", meaning = "Distancia.", note = "Está muy cerca."), TargetExpression(text = "a cinco minutos", meaning = "Tiempo andando.", note = "Está a cinco minutos.")), situation = "Preguntas por la estación: siga recto, gire a la izquierda en la farmacia y está a diez minutos andando.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pide direcciones para ir a la estación, con educación.", expected = listOf("Perdone, ¿como llego a la estacion?", "Perdone, ¿cómo llego a la estación?"), focus = "¿cómo llego?", watch = "Perdone para llamar la atención."), PracticeQuestion(prompt = "Di que la persona debe seguir de frente.", expected = listOf("Siga recto", "siga recto"), focus = "siga recto", watch = "Fórmula de usted: siga."), PracticeQuestion(prompt = "Indica un giro a la izquierda.", expected = listOf("Gire a la izquierda", "gire a la izquierda"), focus = "gire a", watch = "gire a la izquierda / a la derecha."), PracticeQuestion(prompt = "Pregunta si el museo está lejos.", expected = listOf("¿Esta lejos el museo?", "¿Está lejos el museo?"), focus = "¿está lejos?", watch = "está con tilde."), PracticeQuestion(prompt = "Tranquiliza a la persona: el paseo dura cinco minutos.", expected = listOf("Esta a cinco minutos andando", "Está a cinco minutos andando"), focus = "a + tiempo", watch = "a cinco minutos = tiempo a pie."))), exercises = listOf(Exercise(id = "es-foundations-u12-direcciones-e1", kind = "choice", prompt = "Para llegar al parque, ___ recto.", options = listOf("siga", "gire", "está", "toma"), answers = listOf("siga"), explain = "siga recto = continuar de frente."), Exercise(id = "es-foundations-u12-direcciones-e2", kind = "gap", prompt = "En el semáforo, gire a la ___. (dirección)", options = listOf(), answers = listOf("izquierda"), explain = "a la izquierda = girar a la mano izquierda."), Exercise(id = "es-foundations-u12-direcciones-e3", kind = "order", prompt = "Indica el giro a la izquierda.", options = listOf(), answers = listOf("Gire a la izquierda"), explain = "gire a + izquierda/derecha."), Exercise(id = "es-foundations-u12-direcciones-e4", kind = "written", prompt = "Indica el giro: hay que girar en el semáforo.", options = listOf(), answers = listOf("Gire a la derecha en el semaforo", "Gire a la derecha en el semáforo"), explain = "Gire a la derecha en + lugar.")), skills = listOf("function:ask-for-directions", "vocab:directions", "grammar:present-simple", "vocab:town"), canDo = listOf("ask-for-directions"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u12-tienda", title = "En la frutería", goal = "Comprar fruta en el barrio: cantidades, calidad y fórmulas de trato.", intro = LessonIntro(explanation = listOf("En la frutería el vendedor pregunta: «¿Qué le pongo?». Tú respondes la cantidad: «Medio kilo de plátanos».", "Más cantidades: «Un kilo de naranjas». «Doscientos gramos de fresas». «Una sandía».", "Para terminar: «Eso es todo, gracias». El vendedor pregunta: «¿Algo más?»."), examples = listOf(ExampleLine(text = "Buenos días, ¿qué le pongo?", meaning = "El vendedor saluda."), ExampleLine(text = "Medio kilo de plátanos, por favor.", meaning = "Pedir cantidad."), ExampleLine(text = "¿Están buenas las fresas?", meaning = "Preguntar calidad."), ExampleLine(text = "¿Algo más?", meaning = "El vendedor pregunta."), ExampleLine(text = "Eso es todo, gracias.", meaning = "Terminar la compra."))), expressions = listOf(TargetExpression(text = "¿Qué le pongo?", meaning = "El vendedor pregunta.", note = "Respondes con la cantidad."), TargetExpression(text = "medio kilo de …", meaning = "Peso.", note = "Medio kilo de plátanos."), TargetExpression(text = "¿Están buenas …?", meaning = "Calidad de la fruta.", note = "Sí, están muy dulces."), TargetExpression(text = "¿Algo más?", meaning = "Preguntar si falta algo.", note = "Nada más, gracias."), TargetExpression(text = "Eso es todo.", meaning = "Cerrar la compra.", note = "Eso es todo, gracias.")), situation = "Compras en la frutería de tu calle: medio kilo de plátanos, una sandía y preguntas si las fresas están buenas.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "El vendedor pregunta qué quieres. Pide medio kilo de plátanos.", expected = listOf("Me pone medio kilo de platanos", "Me pone medio kilo de plátanos"), focus = "me pone", watch = "me pone + cantidad."), PracticeQuestion(prompt = "Pregunta si las fresas están buenas.", expected = listOf("¿Estan buenas las fresas?", "¿Están buenas las fresas?"), focus = "¿están buenas?", watch = "buenas concuerda con fresas."), PracticeQuestion(prompt = "Pide un kilo de naranjas.", expected = listOf("Me pone un kilo de naranjas", "Quiero un kilo de naranjas", "quiero un kilo de naranjas"), focus = "kilo", watch = "un kilo de + fruta."), PracticeQuestion(prompt = "El vendedor pregunta si falta algo. Di que no.", expected = listOf("Nada mas gracias", "Nada más, gracias"), focus = "nada más", watch = "Nada más = eso es todo."), PracticeQuestion(prompt = "Di que ya terminaste la compra.", expected = listOf("Eso es todo gracias", "Eso es todo, gracias"), focus = "eso es todo", watch = "Fórmula para cerrar."))), exercises = listOf(Exercise(id = "es-foundations-u12-tienda-e1", kind = "choice", prompt = "Buenos días, ¿qué le ___?", options = listOf("pongo", "pone", "pones", "ponemos"), answers = listOf("pone"), explain = "El vendedor dice: ¿qué le pongo?"), Exercise(id = "es-foundations-u12-tienda-e2", kind = "gap", prompt = "Quiero ___ kilo de manzanas. (ni uno ni dos)", options = listOf(), answers = listOf("medio"), explain = "medio kilo = 500 gramos."), Exercise(id = "es-foundations-u12-tienda-e3", kind = "order", prompt = "Pide medio kilo de plátanos.", options = listOf(), answers = listOf("Me pone medio kilo de plátanos"), explain = "me pone + cantidad + fruta."), Exercise(id = "es-foundations-u12-tienda-e4", kind = "written", prompt = "El vendedor pregunta «¿Algo más?». Responde que no, cortésmente.", options = listOf(), answers = listOf("Nada mas gracias", "Nada más, gracias", "Eso es todo, gracias"), explain = "Nada más, gracias = no quiero nada más.")), skills = listOf("function:go-shopping", "grammar:quantities", "vocab:food", "grammar:present-simple"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple"))))
}

object EsFoundationsU13 {
    val unit = CourseUnit(id = "es-foundations-u13", title = "Mi gente", subtitle = "Familia y amigos", level = "A1", themes = listOf(ConversationTheme("mi-familia", "Mi familia", "Personas y posesivos", "figure-2", "Course", "Presentas a tu familia: tus padres, tus hermanos y un tío muy simpático.", 0),
                ConversationTheme("mis-amigos", "Mis amigos", "Carácter y llamadas", "heart", "Course", "Describes a tus amigos por teléfono y quedas con ellos para el sábado.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u13-familia", title = "Mi familia", goal = "Presentar a tu familia: padres, hermanos y tíos, con tengo y los posesivos.", intro = LessonIntro(explanation = listOf("La familia: mi madre, mi padre, mi hermano y mi hermana. «Tengo un hermano y dos hermanas».", "Usamos tengo para hablar de tu familia: «Tengo un tío muy simpático». Si no hay: «No tengo hermanos».", "Los posesivos acompañan a la familia: «mi madre», «tu padre», «su mujer». «Mis padres viven en Madrid»."), examples = listOf(ExampleLine(text = "Tengo un hermano y una hermana.", meaning = "Decir quién está en tu familia."), ExampleLine(text = "Mi padre se llama Luis.", meaning = "Presentar a tu padre."), ExampleLine(text = "Tengo un tío muy gracioso.", meaning = "Hablar de un tío."), ExampleLine(text = "No tengo abuelos.", meaning = "Decir que alguien no está."), ExampleLine(text = "Mis padres viven en Sevilla.", meaning = "Hablar de tus padres, en plural."))), expressions = listOf(TargetExpression(text = "mi madre / mi padre", meaning = "Tus padres.", note = "Mi madre es profesora."), TargetExpression(text = "mi hermano / mi hermana", meaning = "Tus hermanos.", note = "Mi hermana tiene diez años."), TargetExpression(text = "el tío / la tía", meaning = "Los hermanos de tus padres.", note = "Tengo una tía en Valencia."), TargetExpression(text = "los abuelos", meaning = "El abuelo y la abuela.", note = "Mis abuelos viven cerca."), TargetExpression(text = "tengo … / no tengo …", meaning = "Decir quién está en tu familia.", note = "Tengo dos primos.")), situation = "Presentas a tu familia: tus padres, tu hermano pequeño y un tío que vive en Barcelona.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di que tienes un hermano y una hermana.", expected = listOf("Tengo un hermano y una hermana", "tengo un hermano y una hermana"), focus = "tengo", watch = "tengo + persona sin artículo: un hermano."), PracticeQuestion(prompt = "Presenta a tu madre: se llama Carmen.", expected = listOf("Mi madre se llama Carmen", "mi madre se llama carmen"), focus = "mi madre", watch = "mi + familia + se llama + nombre."), PracticeQuestion(prompt = "Di que tienes un tío en Barcelona.", expected = listOf("Tengo un tío en Barcelona", "Tengo un tio en Barcelona"), focus = "tío", watch = "tío lleva tilde; tía también."), PracticeQuestion(prompt = "Di que no tienes hermanos.", expected = listOf("No tengo hermanos", "no tengo hermanos"), focus = "no tengo", watch = "no + tengo para negar."), PracticeQuestion(prompt = "Habla de tus padres: viven en Madrid.", expected = listOf("Mis padres viven en Madrid", "mis padres viven en madrid"), focus = "mis", watch = "mi → mis en plural: mis padres."))), exercises = listOf(Exercise(id = "es-foundations-u13-familia-e1", kind = "choice", prompt = "La madre de mi padre es mi ___.", options = listOf("abuela", "tía", "hermana", "prima"), answers = listOf("abuela"), explain = "La madre de tu padre o de tu madre es tu abuela."), Exercise(id = "es-foundations-u13-familia-e2", kind = "gap", prompt = "La hija de mis padres es mi ___.", options = listOf(), answers = listOf("hermana"), explain = "La hija de tus padres es tu hermana."), Exercise(id = "es-foundations-u13-familia-e3", kind = "order", prompt = "Presenta a tu padre: se llama Jorge.", options = listOf(), answers = listOf("Mi padre se llama Jorge"), explain = "mi + familia + se llama + nombre."), Exercise(id = "es-foundations-u13-familia-e4", kind = "written", prompt = "Pregunta a tu amigo por su familia: el número de hermanos.", options = listOf(), answers = listOf("¿Cuántos hermanos tienes?", "¿Cuantos hermanos tienes?"), explain = "¿Cuántos…? para preguntar cantidad, con tilde.")), skills = listOf("vocab:family", "grammar:possessives", "grammar:present-simple", "function:describe-people"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:possessives")),
    Lesson(id = "es-foundations-u13-amigos", title = "¿Cómo es?", goal = "Describir el carácter de tus amigos con adjetivos: simpático, tímido, trabajador.", intro = LessonIntro(explanation = listOf("Para describir usamos ser + adjetivo: «Pablo es simpático». «Ana es tímida».", "El adjetivo cambia con la persona: simpático → simpática, tímido → tímida. «Mis amigos son trabajadores».", "Para preguntar: «¿Cómo es tu amigo?». Respondes: «Es muy simpático»."), examples = listOf(ExampleLine(text = "Mi amigo Pablo es muy simpático.", meaning = "Describir el carácter."), ExampleLine(text = "Ana es tímida pero muy amable.", meaning = "Describir a una amiga."), ExampleLine(text = "¿Cómo es tu hermana?", meaning = "Preguntar por alguien."), ExampleLine(text = "Es trabajador y serio.", meaning = "Dos adjetivos juntos."), ExampleLine(text = "Mis amigos son divertidos.", meaning = "Plural: -s al final."))), expressions = listOf(TargetExpression(text = "simpático / simpática", meaning = "Persona agradable.", note = "Tu amigo es muy simpático."), TargetExpression(text = "tímido / tímida", meaning = "Persona callada con gente nueva.", note = "Mi prima es tímida."), TargetExpression(text = "trabajador / trabajadora", meaning = "Persona que trabaja mucho.", note = "Es trabajadora y organizada."), TargetExpression(text = "¿Cómo es …?", meaning = "Preguntar por el carácter.", note = "¿Cómo es tu compañero?"), TargetExpression(text = "muy + adjetivo", meaning = "Decir mucho.", note = "Es muy divertido.")), situation = "Hablas de tus amigos: Pablo es simpático y divertido; su hermana es tímida pero muy trabajadora.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Describe el carácter de tu amigo Pablo.", expected = listOf("Es simpático", "es simpatico", "Pablo es simpático"), focus = "es + adjetivo", watch = "simpático lleva tilde."), PracticeQuestion(prompt = "Describe a tu amiga: es callada con gente nueva.", expected = listOf("Es tímida", "es timida"), focus = "tímida", watch = "Femenino: tímida, con -a y tilde."), PracticeQuestion(prompt = "Pregunta por el carácter de tu compañero.", expected = listOf("¿Cómo es tu compañero?", "¿Como es tu compañero?"), focus = "¿cómo es?", watch = "cómo con tilde en preguntas."), PracticeQuestion(prompt = "Di que tus amigos son divertidos.", expected = listOf("Mis amigos son divertidos", "mis amigos son divertidos"), focus = "son", watch = "Plural: son + divertidos."), PracticeQuestion(prompt = "Di que tu jefa trabaja mucho.", expected = listOf("Es muy trabajadora", "es muy trabajadora", "Mi jefa es muy trabajadora"), focus = "trabajadora", watch = "Femenino: trabajadora, con -a."))), exercises = listOf(Exercise(id = "es-foundations-u13-amigos-e1", kind = "choice", prompt = "Mi amiga Ana es muy ___. Habla con todo el mundo.", options = listOf("simpática", "tímida", "seria", "callada"), answers = listOf("simpática"), explain = "Habla con todo el mundo: es simpática."), Exercise(id = "es-foundations-u13-amigos-e2", kind = "gap", prompt = "Pablo no habla con gente nueva. Es ___. (carácter)", options = listOf(), answers = listOf("tímido"), explain = "Sin confianza con gente nueva: tímido, con tilde."), Exercise(id = "es-foundations-u13-amigos-e3", kind = "order", prompt = "Pregunta por el carácter de tu compañera de piso.", options = listOf(), answers = listOf("¿Cómo es tu compañera de piso?"), explain = "¿Cómo es…? para preguntar el carácter."), Exercise(id = "es-foundations-u13-amigos-e4", kind = "written", prompt = "Di que tu prima es callada con la gente nueva.", options = listOf(), answers = listOf("Es tímida", "es timida", "Mi prima es tímida"), explain = "Callada con gente nueva: tímida, con tilde.")), skills = listOf("function:describe-people", "grammar:present-simple", "vocab:feelings", "function:ask-simple-questions"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u13-llamada", title = "Una llamada", goal = "Hablar por teléfono: preguntar por alguien y quedar para llamar más tarde.", intro = LessonIntro(explanation = listOf("Al teléfono: «¿Diga?». Preguntas por alguien: «¿Está Marta?». Respondes: «Sí, soy yo» o «No, no está».", "Si no puede hablar: «Está en una llamada». Propones: «¿Llamas más tarde?».", "Para saber quién llama: «¿De parte de quién?». Respondes: «De parte de Ana»."), examples = listOf(ExampleLine(text = "¿Diga?", meaning = "Contestar el teléfono."), ExampleLine(text = "¿Está Marta, por favor?", meaning = "Preguntar por una persona."), ExampleLine(text = "Lo siento, no está.", meaning = "Decir que no puede hablar."), ExampleLine(text = "¿Llamas más tarde?", meaning = "Proponer otra llamada."), ExampleLine(text = "Vale, llamo a las cinco.", meaning = "Aceptar y decir la hora."))), expressions = listOf(TargetExpression(text = "¿Diga?", meaning = "Contestar el teléfono en España.", note = "—¿Diga? —¿Está Pablo?"), TargetExpression(text = "¿Está …?", meaning = "Preguntar por alguien.", note = "¿Está la señora García?"), TargetExpression(text = "no está / está en una llamada", meaning = "La persona no puede hablar.", note = "Está en una llamada."), TargetExpression(text = "llamo más tarde", meaning = "Volver a llamar después.", note = "Vale, llamo más tarde."), TargetExpression(text = "¿De parte de quién?", meaning = "Preguntar quién llama.", note = "De parte de Ana.")), situation = "Llamas a Marta para quedar el sábado, pero está en la ducha: llamas más tarde, a las seis.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Contesta el teléfono.", expected = listOf("¿Diga?", "¿Dígame?", "¿Sí?"), focus = "¿diga?", watch = "En España contestamos con ¿diga?."), PracticeQuestion(prompt = "Llama y pregunta por Marta.", expected = listOf("¿Está Marta?", "¿Esta Marta?"), focus = "¿está?", watch = "está con tilde: ¿Está Marta?"), PracticeQuestion(prompt = "Di que Marta no puede hablar ahora.", expected = listOf("No está ahora", "Marta no está", "Lo siento, no está"), focus = "no está", watch = "no está = no puede hablar."), PracticeQuestion(prompt = "Di que llamas después, a las seis.", expected = listOf("Llamo más tarde, a las seis", "Llamo mas tarde a las seis"), focus = "más tarde", watch = "más lleva tilde."), PracticeQuestion(prompt = "Pregunta quién llama.", expected = listOf("¿De parte de quién?", "¿De parte de quien?", "¿Quién es?", "¿Quien es?"), focus = "de parte de", watch = "¿De parte de quién? es muy útil al teléfono."))), exercises = listOf(Exercise(id = "es-foundations-u13-llamada-e1", kind = "choice", prompt = "Llamas a Marta. Su hermano contesta: «Ahora está en la ducha». Tú dices: «Vale, ___ más tarde».", options = listOf("llamo", "llamas", "llama", "llamar"), answers = listOf("llamo"), explain = "Yo llamo: llamo más tarde."), Exercise(id = "es-foundations-u13-llamada-e2", kind = "gap", prompt = "—¿___ Marta, por favor? —Sí, soy yo.", options = listOf(), answers = listOf("Está"), explain = "¿Está + nombre? para preguntar por alguien al teléfono."), Exercise(id = "es-foundations-u13-llamada-e3", kind = "order", prompt = "Deja un recado: dices la hora de tu llamada.", options = listOf(), answers = listOf("Llamo más tarde, a las seis"), explain = "llamo + más tarde + la hora."), Exercise(id = "es-foundations-u13-llamada-e4", kind = "written", prompt = "Pregunta por el señor Vargas al teléfono.", options = listOf(), answers = listOf("¿Está el señor Vargas?", "¿Esta el señor Vargas?"), explain = "¿Está + nombre? con tilde en está.")), skills = listOf("vocab:social-expressions", "grammar:present-questions", "function:ask-simple-questions", "grammar:present-simple"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:present-simple"))))
}

object EsFoundationsU14 {
    val unit = CourseUnit(id = "es-foundations-u14", title = "El tiempo", subtitle = "Días y clima", level = "A1", themes = listOf(ConversationTheme("dias-y-rutina", "Mi semana", "Rutina y frecuencia", "sun.max", "Course", "Cuentas qué haces cada día: siempre, a veces o nunca.", 0),
                ConversationTheme("clima-y-gustos", "Clima y gustos", "Tiempo y estaciones", "cloud.rain", "Course", "Hablas del clima de tu ciudad y de lo que te gusta hacer.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u14-rutina", title = "De la mañana a la noche", goal = "Contar tu día con siempre, a veces y nunca: de la mañana a la noche.", intro = LessonIntro(explanation = listOf("Los adverbios de frecuencia: siempre (todos los días), a veces (algunos días) y nunca (ningún día). «Siempre desayuno café».", "Con nunca, no hace falta no: «Nunca como tarde». También dices «No como tarde nunca».", "La rutina: me levanto, desayuno, trabajo, ceno y me acuesto. «Me levanto a las siete»."), examples = listOf(ExampleLine(text = "Siempre me levanto a las siete.", meaning = "Rutina de todos los días."), ExampleLine(text = "A veces desayuno tostadas.", meaning = "Algunos días."), ExampleLine(text = "Nunca ceno muy tarde.", meaning = "Ningún día."), ExampleLine(text = "Por la noche veo la televisión.", meaning = "Un momento del día."), ExampleLine(text = "Los sábados trabajo por la mañana.", meaning = "Un día de la semana."))), expressions = listOf(TargetExpression(text = "siempre", meaning = "Todos los días.", note = "Siempre desayuno café."), TargetExpression(text = "a veces", meaning = "Algunos días.", note = "A veces como en la oficina."), TargetExpression(text = "nunca", meaning = "Ningún día.", note = "Nunca bebo alcohol."), TargetExpression(text = "me levanto / me acuesto", meaning = "Empieza y termina el día.", note = "Me acuesto a las once."), TargetExpression(text = "por la mañana / por la noche", meaning = "Momentos del día.", note = "Estudio por la noche.")), situation = "Cuentas tu día normal: te levantas a las siete, siempre desayunas café y nunca comes en casa.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di que todos los días desayunas café.", expected = listOf("Siempre desayuno café", "siempre desayuno cafe"), focus = "siempre", watch = "siempre = todos los días."), PracticeQuestion(prompt = "Di que algunos días caminas al trabajo.", expected = listOf("A veces camino al trabajo", "a veces camino al trabajo"), focus = "a veces", watch = "a veces = algunos días."), PracticeQuestion(prompt = "Di que ningún día comes carne.", expected = listOf("Nunca como carne", "nunca como carne"), focus = "nunca", watch = "nunca = 0%, sin no."), PracticeQuestion(prompt = "Di a qué hora te levantas: siete.", expected = listOf("Me levanto a las siete", "me levanto a las siete"), focus = "me levanto", watch = "me levanto + a las + hora."), PracticeQuestion(prompt = "Di qué haces por la noche: ves la televisión.", expected = listOf("Por la noche veo la televisión", "por la noche veo la television", "veo la television por la noche"), focus = "por la noche", watch = "por la noche + presente simple."))), exercises = listOf(Exercise(id = "es-foundations-u14-rutina-e1", kind = "choice", prompt = "Todos los días bebo café. Bebo café ___.", options = listOf("siempre", "nunca", "a veces", "mañana"), answers = listOf("siempre"), explain = "Todos los días = siempre."), Exercise(id = "es-foundations-u14-rutina-e2", kind = "gap", prompt = "No como carne, ni un solo día. ___ como carne.", options = listOf(), answers = listOf("Nunca"), explain = "Nunca al principio de la frase, sin no."), Exercise(id = "es-foundations-u14-rutina-e3", kind = "order", prompt = "Di que algunos días vas a la piscina.", options = listOf(), answers = listOf("A veces voy a la piscina"), explain = "a veces + voy + lugar."), Exercise(id = "es-foundations-u14-rutina-e4", kind = "written", prompt = "Di a qué hora te acuestas: once.", options = listOf(), answers = listOf("Me acuesto a las once", "me acuesto a las once"), explain = "me acuesto + a las + hora.")), skills = listOf("grammar:frequency-adverbs", "function:talk-about-routines", "vocab:daily-routine", "grammar:present-simple"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u14-clima", title = "¿Qué tiempo hace?", goal = "Hablar del tiempo y de las estaciones: hace calor, llueve, nieva.", intro = LessonIntro(explanation = listOf("Preguntar: «¿Qué tiempo hace?». Respondes con hace: «Hace sol», «Hace frío».", "Con llueve y nieva no usamos hace: «Hoy llueve mucho», «En invierno nieva».", "Las estaciones: la primavera, el verano, el otoño y el invierno. «En verano hace calor»."), examples = listOf(ExampleLine(text = "¿Qué tiempo hace hoy?", meaning = "Preguntar por el clima."), ExampleLine(text = "Hace sol y hace calor.", meaning = "Un día de verano."), ExampleLine(text = "Hoy llueve mucho en Bilbao.", meaning = "Un día de lluvia."), ExampleLine(text = "En invierno nieva en la montaña.", meaning = "El clima del invierno."), ExampleLine(text = "En primavera hace buen tiempo.", meaning = "Hablar de una estación."))), expressions = listOf(TargetExpression(text = "¿Qué tiempo hace?", meaning = "Preguntar por el clima.", note = "¿Qué tiempo hace en Madrid?"), TargetExpression(text = "hace sol / hace calor", meaning = "El tiempo bueno.", note = "Hoy hace sol."), TargetExpression(text = "hace frío / hace viento", meaning = "El tiempo frío.", note = "En invierno hace frío."), TargetExpression(text = "llueve / nieva", meaning = "El agua y la nieve.", note = "Aquí nunca nieva."), TargetExpression(text = "la primavera, el verano, el otoño, el invierno", meaning = "Las cuatro estaciones.", note = "Mi estación es el otoño.")), situation = "Hablas del clima de tu ciudad: en verano hace mucho calor, en invierno llueve y nunca nieva.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pregunta por el clima hoy.", expected = listOf("¿Qué tiempo hace hoy?", "¿Que tiempo hace hoy?"), focus = "¿qué tiempo?", watch = "qué con tilde en preguntas."), PracticeQuestion(prompt = "Di que hoy es un día de sol.", expected = listOf("Hace sol", "hace sol"), focus = "hace sol", watch = "hace + sol, calor, frío, viento."), PracticeQuestion(prompt = "Di que la temperatura hoy es muy baja.", expected = listOf("Hace mucho frío", "hace mucho frio"), focus = "frío", watch = "frío lleva tilde."), PracticeQuestion(prompt = "Di que en tu ciudad cae agua hoy.", expected = listOf("Hoy llueve", "hoy llueve"), focus = "llueve", watch = "llueve, sin hace: hoy llueve."), PracticeQuestion(prompt = "Di que en invierno hay nieve.", expected = listOf("En invierno nieva", "nieva en invierno"), focus = "nieva", watch = "nieva, sin hace."))), exercises = listOf(Exercise(id = "es-foundations-u14-clima-e1", kind = "choice", prompt = "En el desierto la temperatura es muy alta: ___ calor.", options = listOf("hace", "llueve", "nieva", "toma"), answers = listOf("hace"), explain = "hace + calor, frío, sol, viento."), Exercise(id = "es-foundations-u14-clima-e2", kind = "gap", prompt = "Coge el paraguas: hoy ___ mucho.", options = listOf(), answers = listOf("llueve"), explain = "Llueve = cae agua; sin hace."), Exercise(id = "es-foundations-u14-clima-e3", kind = "order", prompt = "Pregunta por el clima en Sevilla.", options = listOf(), answers = listOf("¿Qué tiempo hace en Sevilla?"), explain = "¿Qué tiempo hace + en + lugar?"), Exercise(id = "es-foundations-u14-clima-e4", kind = "written", prompt = "Di que en tu ciudad, en la estación fría, la temperatura es baja.", options = listOf(), answers = listOf("En invierno hace frío", "En invierno hace frio", "Hace frío en invierno"), explain = "hace + frío; frío lleva tilde.")), skills = listOf("function:talk-about-weather", "vocab:weather", "grammar:present-simple", "function:ask-simple-questions"), canDo = listOf("talk-about-weather"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u14-hobbies", title = "Lo que me gusta", goal = "Decir qué te gusta: me gusta + infinitivo y me gusta + sustantivo.", intro = LessonIntro(explanation = listOf("me gusta + infinitivo para actividades: «Me gusta leer», «Me gusta cocinar».", "me gusta + sustantivo para cosas: «Me gusta el café», «Me gusta la música».", "Negamos con no: «No me gusta el frío». Preguntamos: «¿Te gusta el fútbol?»."), examples = listOf(ExampleLine(text = "Me gusta leer por la noche.", meaning = "Gusto + infinitivo."), ExampleLine(text = "Me gusta la música latina.", meaning = "Gusto + sustantivo."), ExampleLine(text = "¿Te gusta cocinar?", meaning = "Preguntar por los gustos."), ExampleLine(text = "No me gusta el frío.", meaning = "Decir un disgusto."), ExampleLine(text = "Me encanta viajar.", meaning = "Un gusto muy fuerte."))), expressions = listOf(TargetExpression(text = "me gusta + infinitivo", meaning = "Decir qué te gusta hacer.", note = "Me gusta nadar."), TargetExpression(text = "me gusta el / la …", meaning = "Decir qué te gusta.", note = "Me gusta el cine."), TargetExpression(text = "no me gusta …", meaning = "Decir qué no te gusta.", note = "No me gusta madrugar."), TargetExpression(text = "¿te gusta …?", meaning = "Preguntar por los gustos.", note = "¿Te gusta el chocolate?"), TargetExpression(text = "me encanta …", meaning = "Un gusto muy fuerte.", note = "Me encanta viajar.")), situation = "Hablas de tu tiempo libre: te gusta cocinar los domingos y te encanta el cine; no te gusta el frío.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di que te gusta bailar.", expected = listOf("Me gusta bailar", "me gusta bailar"), focus = "me gusta", watch = "me gusta + infinitivo."), PracticeQuestion(prompt = "Di tu opinión sobre el cine.", expected = listOf("Me gusta el cine", "me gusta el cine"), focus = "el cine", watch = "me gusta + el/la + sustantivo."), PracticeQuestion(prompt = "Pregunta a tu amigo por sus gustos en la cocina.", expected = listOf("¿Te gusta cocinar?", "¿Te gusta cocinar a ti?"), focus = "¿te gusta?", watch = "te para preguntar a tú."), PracticeQuestion(prompt = "Di que madrugar no es tu cosa.", expected = listOf("No me gusta madrugar", "no me gusta madrugar"), focus = "no me gusta", watch = "no va antes de me gusta."), PracticeQuestion(prompt = "Di que viajar te gusta mucho.", expected = listOf("Me encanta viajar", "me encanta viajar"), focus = "me encanta", watch = "me encanta = me gusta mucho."))), exercises = listOf(Exercise(id = "es-foundations-u14-hobbies-e1", kind = "choice", prompt = "___ bailar salsa los sábados; es muy divertido.", options = listOf("Me gusta", "Gusto", "Me gustan", "Gusto en"), answers = listOf("Me gusta"), explain = "me gusta + infinitivo: me gusta bailar."), Exercise(id = "es-foundations-u14-hobbies-e2", kind = "gap", prompt = "A Ana ___ el chocolate. (a ella)", options = listOf(), answers = listOf("le gusta"), explain = "A Ana le gusta: le para tercera persona."), Exercise(id = "es-foundations-u14-hobbies-e3", kind = "order", prompt = "Di qué haces con gusto los domingos: cocinar.", options = listOf(), answers = listOf("Me gusta cocinar los domingos"), explain = "me gusta + infinitivo + momento."), Exercise(id = "es-foundations-u14-hobbies-e4", kind = "written", prompt = "Di que el frío no es de tu agrado.", options = listOf(), answers = listOf("No me gusta el frío", "No me gusta el frio", "no me gusta el frio"), explain = "no me gusta + sustantivo con artículo: el frío.")), skills = listOf("vocab:hobbies", "grammar:present-simple", "function:talk-about-routines", "vocab:social-expressions"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple"))))
}

object EsFoundationsU15 {
    val unit = CourseUnit(id = "es-foundations-u15", title = "En movimiento", subtitle = "Metro, bus y tren", level = "A1", themes = listOf(ConversationTheme("metro-y-bus", "En metro y bus", "Ir por la ciudad", "bus", "Course", "Vas al centro con tus amigos: uno va en metro, otro en bus y otro a pie.", 0),
                ConversationTheme("tren-y-estacion", "En tren", "Horas y billetes", "tram", "Course", "Compras un billete en la estación y preguntas la hora de salida del tren.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u15-transporte", title = "Cómo voy", goal = "Decir cómo vas a un sitio: voy en metro, voy en bus o voy a pie.", intro = LessonIntro(explanation = listOf("Para decir tu transporte usamos voy en + transporte: «Voy en metro». «Voy al centro en bus».", "Si caminas, la frase es voy a pie: «Voy a pie al trabajo; está muy cerca».", "Para preguntar: «¿Cómo vas al trabajo?». Respondes: «Voy en metro» o «Voy a pie»."), examples = listOf(ExampleLine(text = "Voy en metro al centro.", meaning = "Decir tu transporte."), ExampleLine(text = "Voy al trabajo en bus.", meaning = "Otro transporte: el bus."), ExampleLine(text = "Voy a pie; vive cerca.", meaning = "Decir que caminas."), ExampleLine(text = "¿Cómo vas a la escuela?", meaning = "Preguntar cómo va alguien."), ExampleLine(text = "Mi hermano va en bici.", meaning = "Hablar de otra persona."))), expressions = listOf(TargetExpression(text = "voy en metro", meaning = "Tu transporte es el metro.", note = "Voy en metro al trabajo."), TargetExpression(text = "voy en bus / en autobús", meaning = "Tu transporte es el bus.", note = "Voy en autobús a la playa."), TargetExpression(text = "voy a pie", meaning = "Camino.", note = "Está cerca: voy a pie."), TargetExpression(text = "voy en coche", meaning = "Tu transporte es el coche.", note = "Mi padre va en coche."), TargetExpression(text = "¿Cómo vas a …?", meaning = "Preguntar el transporte de alguien.", note = "¿Cómo vas a la oficina?")), situation = "Vas al centro con tus amigos: tú vas en metro, Marta va en bus y Pablo va a pie porque vive cerca.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di que vas al centro en metro.", expected = listOf("Voy en metro al centro", "voy en metro al centro", "Voy al centro en metro"), focus = "voy en", watch = "voy en + metro, sin artículo."), PracticeQuestion(prompt = "Di que vas al trabajo en autobús.", expected = listOf("Voy al trabajo en autobús", "voy al trabajo en autobus", "Voy al trabajo en bus"), focus = "en autobús", watch = "autobús lleva tilde; bus no."), PracticeQuestion(prompt = "Di que caminas a la escuela: está cerca.", expected = listOf("Voy a pie a la escuela", "voy a pie", "Voy andando a la escuela"), focus = "a pie", watch = "A pie, nunca «a pies»."), PracticeQuestion(prompt = "Pregunta cómo va tu compañero a la oficina.", expected = listOf("¿Cómo vas a la oficina?", "¿Como vas a la oficina?"), focus = "¿cómo vas?", watch = "cómo con tilde en preguntas."), PracticeQuestion(prompt = "Di que no vas en coche: vas andando.", expected = listOf("No voy en coche; voy a pie", "no voy en coche voy a pie", "Voy a pie"), focus = "no voy en", watch = "A pie = andando."))), exercises = listOf(Exercise(id = "es-foundations-u15-transporte-e1", kind = "choice", prompt = "El centro está lejos. No camino; ___ en metro.", options = listOf("voy", "vas", "va", "vamos"), answers = listOf("voy"), explain = "Yo: voy en metro. Con yo decimos voy."), Exercise(id = "es-foundations-u15-transporte-e2", kind = "gap", prompt = "Está muy cerca. No voy en bus: voy ___. (andando)", options = listOf(), answers = listOf("a pie"), explain = "Andar = ir a pie, nunca «a pies»."), Exercise(id = "es-foundations-u15-transporte-e3", kind = "order", prompt = "Pregunta cómo va tu amiga al trabajo.", options = listOf(), answers = listOf("¿Cómo vas al trabajo?"), explain = "Preguntas el transporte: ¿Cómo vas al trabajo?, con tilde."), Exercise(id = "es-foundations-u15-transporte-e4", kind = "written", prompt = "Di que vas a la playa en autobús.", options = listOf(), answers = listOf("Voy a la playa en autobús", "voy a la playa en autobus", "Voy a la playa en bus"), explain = "voy en + autobús, con tilde; bus también vale.")), skills = listOf("vocab:transport", "grammar:present-simple", "function:ask-simple-questions", "vocab:town"), canDo = listOf("use-transport"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u15-horario", title = "¿A qué hora sale?", goal = "Preguntar y decir la hora de un transporte: el tren sale a las ocho y media.", intro = LessonIntro(explanation = listOf("Para preguntar la hora de un transporte: «¿A qué hora sale el tren?». Para la hora ahora: «¿Qué hora es?».", "La hora va con a las: «Sale a las ocho». Y media: «a las ocho y media». Y cuarto: «a las ocho y cuarto».", "Con la una usamos a la: «Sale a la una». Con las demás: a las dos, a las tres, a las cuatro…"), examples = listOf(ExampleLine(text = "¿A qué hora sale el tren?", meaning = "Preguntar la hora de salida."), ExampleLine(text = "Sale a las ocho y media.", meaning = "Decir la hora: 8:30."), ExampleLine(text = "El metro pasa a las nueve y cuarto.", meaning = "La hora: 9:15."), ExampleLine(text = "El primer bus es a las seis.", meaning = "El horario de la mañana."), ExampleLine(text = "¿Qué hora es? — Es la una.", meaning = "La hora exacta: 1:00."))), expressions = listOf(TargetExpression(text = "¿A qué hora sale …?", meaning = "Preguntar la hora de un transporte.", note = "¿A qué hora sale el bus?"), TargetExpression(text = "a las ocho y media", meaning = "8:30.", note = "El tren sale a las ocho y media."), TargetExpression(text = "a las … y cuarto", meaning = "…:15.", note = "Llego a las siete y cuarto."), TargetExpression(text = "el primero / la primera", meaning = "El primero del día.", note = "El primer metro es a las seis."), TargetExpression(text = "¿Qué hora es?", meaning = "Preguntar la hora ahora.", note = "¿Qué hora es? — Son las tres.")), situation = "Estás en la estación: el primero tren es a las seis, tu tren sale a las ocho y media y el último, a las once.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pregunta la hora de salida del tren.", expected = listOf("¿A qué hora sale el tren?", "¿A que hora sale el tren?", "¿Qué hora sale el tren?", "¿Que hora sale el tren?"), focus = "¿a qué hora?", watch = "qué con tilde en preguntas."), PracticeQuestion(prompt = "Di la hora de salida de tu autobús: 8:30.", expected = listOf("El autobús sale a las ocho y media", "el autobus sale a las ocho y media", "Sale a las ocho y media"), focus = "a las ocho y media", watch = "8:30 = ocho y media; autobús con tilde."), PracticeQuestion(prompt = "Di que llegas a las nueve y cuarto.", expected = listOf("Llego a las nueve y cuarto", "llego a las nueve y cuarto"), focus = "a las nueve y cuarto", watch = "9:15 = nueve y cuarto."), PracticeQuestion(prompt = "Pregunta la hora ahora a tu amigo.", expected = listOf("¿Qué hora es?", "¿Que hora es?", "¿Qué hora es, por favor?", "¿Que hora es, por favor?"), focus = "¿qué hora es?", watch = "qué con tilde."), PracticeQuestion(prompt = "Di que tu primer metro es a la una.", expected = listOf("El primer metro es a la una", "el primer metro es a la una", "Mi primer metro es a la una"), focus = "a la una", watch = "Con una decimos a la una, no a las una."))), exercises = listOf(Exercise(id = "es-foundations-u15-horario-e1", kind = "choice", prompt = "El tren sale a las siete y media. Son las siete y cuarto. Faltan ___ minutos.", options = listOf("quince", "treinta", "cuarenta y cinco", "diez"), answers = listOf("quince"), explain = "De las siete y cuarto a las siete y media hay quince minutos."), Exercise(id = "es-foundations-u15-horario-e2", kind = "gap", prompt = "Son las 9:15. El tren sale ahora: sale a las nueve ___.", options = listOf(), answers = listOf("y cuarto"), explain = "9:15 = nueve y cuarto; 30 = y media."), Exercise(id = "es-foundations-u15-horario-e3", kind = "order", prompt = "Pregunta la hora de llegada del bus.", options = listOf(), answers = listOf("¿A qué hora llega el bus?"), explain = "La llegada es con llegar: ¿A qué hora llega el bus?"), Exercise(id = "es-foundations-u15-horario-e4", kind = "written", prompt = "Di que tu tren sale a las siete y media.", options = listOf(), answers = listOf("Mi tren sale a las siete y media", "mi tren sale a las siete y media"), explain = "mi + transporte + sale + a las + hora.")), skills = listOf("function:tell-time", "vocab:transport", "grammar:present-questions", "grammar:present-simple"), canDo = listOf("tell-time"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u15-billete", title = "Un billete, por favor", goal = "Comprar billetes en la taquilla: un billete de ida y vuelta, por favor.", intro = LessonIntro(explanation = listOf("En la taquilla pides con quiero o con un…, por favor: «Quiero un billete». «Un billete, por favor».", "Para dos billetes usamos el plural: «Dos billetes, por favor». Y preguntas el precio: «¿Cuánto cuesta?».", "El billete de ida y vuelta es para ir y volver: «Un billete de ida y vuelta, por favor»."), examples = listOf(ExampleLine(text = "Un billete, por favor.", meaning = "Pedir un billete."), ExampleLine(text = "Quiero un billete de ida y vuelta.", meaning = "Ida y vuelta: allí y de regreso."), ExampleLine(text = "Dos billetes para el centro.", meaning = "Pedir dos billetes."), ExampleLine(text = "¿Cuánto cuesta el billete?", meaning = "Preguntar el precio."), ExampleLine(text = "¿De qué andén sale el tren?", meaning = "Preguntar el andén."))), expressions = listOf(TargetExpression(text = "un billete, por favor", meaning = "Pedir un billete.", note = "Un billete, por favor. — Son dos euros."), TargetExpression(text = "de ida y vuelta", meaning = "Allí y de regreso.", note = "De ida y vuelta, por favor."), TargetExpression(text = "solo ida", meaning = "Sin vuelta.", note = "Solo ida, por favor."), TargetExpression(text = "¿Cuánto cuesta?", meaning = "Preguntar el precio.", note = "¿Cuánto cuesta? — Tres euros."), TargetExpression(text = "el andén", meaning = "El lugar del tren en la estación.", note = "El tren sale del andén dos.")), situation = "Compras billetes en la estación: dos billetes de ida y vuelta para Segovia, dieciséis euros, andén tres.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pide un billete al empleado.", expected = listOf("Un billete, por favor", "un billete por favor", "Quiero un billete, por favor"), focus = "por favor", watch = "En la taquilla: un billete, por favor."), PracticeQuestion(prompt = "Estás en la taquilla con tu amigo; queréis ir al centro. Pide los billetes.", expected = listOf("Dos billetes para el centro", "dos billetes para el centro", "Dos billetes al centro"), focus = "dos billetes", watch = "Plural: dos billetes."), PracticeQuestion(prompt = "Pregunta el precio del billete.", expected = listOf("¿Cuánto cuesta el billete?", "¿Cuanto cuesta el billete?", "¿Cuánto es?", "¿Cuanto es?"), focus = "¿cuánto cuesta?", watch = "cuánto con tilde en preguntas."), PracticeQuestion(prompt = "Vas a Valencia y vuelves el viernes. Pide el billete adecuado.", expected = listOf("Un billete de ida y vuelta, por favor", "un billete de ida y vuelta por favor", "Quiero un billete de ida y vuelta"), focus = "ida y vuelta", watch = "Ida y vuelta = allí y de regreso."), PracticeQuestion(prompt = "Pregunta por el andén del tren a Toledo.", expected = listOf("¿De qué andén sale el tren?", "¿De que anden sale el tren?", "¿De qué andén sale el tren a Toledo?", "¿De que anden sale el tren a Toledo?"), focus = "¿de qué andén?", watch = "andén lleva tilde."))), exercises = listOf(Exercise(id = "es-foundations-u15-billete-e1", kind = "choice", prompt = "Vas a Salamanca y vuelves el mismo día. Pides: «Un billete de ___, por favor».", options = listOf("ida y vuelta", "andén", "hora", "metro"), answers = listOf("ida y vuelta"), explain = "Vas y vuelves el mismo día: ida y vuelta."), Exercise(id = "es-foundations-u15-billete-e2", kind = "gap", prompt = "—¿___ cuesta el billete? —Cuatro euros.", options = listOf(), answers = listOf("Cuánto", "Cuanto"), explain = "El precio: ¿Cuánto cuesta?, con tilde en cuánto."), Exercise(id = "es-foundations-u15-billete-e3", kind = "order", prompt = "Estás en la taquilla con un amigo: queréis ir al centro. Pide los billetes.", options = listOf(), answers = listOf("Dos billetes para el centro"), explain = "Pides dos: dos billetes + destino."), Exercise(id = "es-foundations-u15-billete-e4", kind = "written", prompt = "Pregunta el precio del billete de tren a Sevilla.", options = listOf(), answers = listOf("¿Cuánto cuesta el billete?", "¿Cuanto cuesta el billete?", "¿Cuánto es?", "¿Cuanto es?"), explain = "El precio: ¿Cuánto cuesta el billete?, con tilde.")), skills = listOf("function:go-shopping", "function:make-requests", "vocab:transport", "grammar:quantities"), canDo = listOf("use-transport"), prerequisites = listOf("grammar:present-simple"))))
}

object EsFoundationsU16 {
    val unit = CourseUnit(id = "es-foundations-u16", title = "Me siento bien", subtitle = "Salud básica", level = "A1", themes = listOf(ConversationTheme("hoy-no-estoy-bien", "Hoy no estoy bien", "Síntomas y dolores", "cross.case", "Course", "Tienes dolor de cabeza y fiebre: explicas qué te pasa.", 0),
                ConversationTheme("farmacia-y-habitos", "Farmacia y vida sana", "Remedios y costumbres", "pills", "Course", "Compras algo para el dolor en la farmacia y hablas de tus hábitos sanos.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u16-sintomas", title = "No me siento bien", goal = "Decir qué te pasa: me duele la cabeza, tengo fiebre.", intro = LessonIntro(explanation = listOf("Para el dolor usamos me duele + parte del cuerpo: «Me duele la cabeza». «Me duele el estómago».", "Otros síntomas van con tengo: «Tengo fiebre». «Tengo tos». «Tengo frío».", "Para preguntar a alguien: «¿Qué te pasa?». Respondes: «No me siento bien; me duele la cabeza»."), examples = listOf(ExampleLine(text = "No me siento bien.", meaning = "Decir que estás mal."), ExampleLine(text = "Me duele la cabeza.", meaning = "Dolor en la cabeza."), ExampleLine(text = "Tengo fiebre y tos.", meaning = "Dos síntomas."), ExampleLine(text = "Me duele el estómago.", meaning = "Dolor en el estómago."), ExampleLine(text = "¿Qué te pasa? — Tengo gripe.", meaning = "Preguntar y responder."))), expressions = listOf(TargetExpression(text = "me duele la cabeza", meaning = "Dolor de cabeza.", note = "Me duele la cabeza; quiero dormir."), TargetExpression(text = "tengo fiebre", meaning = "Tu cuerpo está muy caliente.", note = "Tengo fiebre; estoy en casa."), TargetExpression(text = "tengo tos", meaning = "Toses.", note = "Tengo tos por la noche."), TargetExpression(text = "me duele el estómago", meaning = "Dolor de estómago.", note = "Me duele el estómago después de comer."), TargetExpression(text = "¿Qué te pasa?", meaning = "Preguntar a alguien cómo está.", note = "¿Qué te pasa? — Me duele la cabeza.")), situation = "Es lunes y no vas al trabajo: tienes fiebre y tos, y te duele la cabeza; tu amigo pregunta qué te pasa.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di que estás mal hoy.", expected = listOf("No me siento bien", "no me siento bien", "Hoy no me siento bien"), focus = "no me siento bien", watch = "yo me siento; tú te sientes."), PracticeQuestion(prompt = "Di que te duele la cabeza.", expected = listOf("Me duele la cabeza", "me duele la cabeza", "Me duele un poco la cabeza"), focus = "me duele", watch = "me duele + la + parte del cuerpo."), PracticeQuestion(prompt = "Di que tienes fiebre.", expected = listOf("Tengo fiebre", "tengo fiebre", "Tengo mucha fiebre"), focus = "tengo fiebre", watch = "Síntomas con tengo: fiebre, tos, frío."), PracticeQuestion(prompt = "Pregunta a tu amigo qué le pasa.", expected = listOf("¿Qué te pasa?", "¿Que te pasa?"), focus = "¿qué te pasa?", watch = "qué con tilde en preguntas."), PracticeQuestion(prompt = "Di que te duele el estómago.", expected = listOf("Me duele el estómago", "me duele el estomago"), focus = "estómago", watch = "estómago lleva tilde."))), exercises = listOf(Exercise(id = "es-foundations-u16-sintomas-e1", kind = "choice", prompt = "Tu cabeza está mal hoy: «___ la cabeza».", options = listOf("Me duele", "Tengo", "Me gusta", "Estoy"), answers = listOf("Me duele"), explain = "El dolor va con me duele: me duele la cabeza."), Exercise(id = "es-foundations-u16-sintomas-e2", kind = "gap", prompt = "Toses mucho por la noche: tienes ___.", options = listOf(), answers = listOf("tos"), explain = "El sustantivo es tos: tengo tos, con -s final."), Exercise(id = "es-foundations-u16-sintomas-e3", kind = "order", prompt = "Tu cabeza está mal hoy: dilo.", options = listOf(), answers = listOf("Me duele la cabeza"), explain = "El dolor: me duele + la cabeza."), Exercise(id = "es-foundations-u16-sintomas-e4", kind = "written", prompt = "Tu amigo no está bien. Pregúntale qué pasa.", options = listOf(), answers = listOf("¿Qué te pasa?", "¿Que te pasa?"), explain = "¿Qué te pasa? para preguntar, con tilde en qué.")), skills = listOf("function:talk-about-health", "vocab:health", "grammar:present-simple", "function:ask-simple-questions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u16-farmacia", title = "En la farmacia", goal = "Pedir un remedio en la farmacia: quiero algo para la cabeza.", intro = LessonIntro(explanation = listOf("En la farmacia pides con quiero algo para…: «Quiero algo para la cabeza».", "El farmacéutico pregunta: «¿Para qué es?». Respondes: «Es para el dolor de garganta».", "Preguntas la dosis con ¿cada cuántas horas?: «¿Cada cuántas horas tomo la pastilla?»."), examples = listOf(ExampleLine(text = "Quiero algo para la cabeza.", meaning = "Pedir un remedio."), ExampleLine(text = "¿Para qué es?", meaning = "El farmacéutico pregunta."), ExampleLine(text = "Es para el dolor de garganta.", meaning = "Decir tu problema."), ExampleLine(text = "¿Cada cuántas horas tomo la pastilla?", meaning = "Preguntar la dosis."), ExampleLine(text = "Son doce euros.", meaning = "El farmacéutico dice el precio."))), expressions = listOf(TargetExpression(text = "quiero algo para…", meaning = "Pedir un remedio.", note = "Quiero algo para la tos."), TargetExpression(text = "el dolor de cabeza / de garganta", meaning = "El sitio donde te duele.", note = "Es para el dolor de garganta."), TargetExpression(text = "¿cada cuántas horas?", meaning = "Preguntar el tiempo entre tomas.", note = "¿Cada cuántas horas la tomo?"), TargetExpression(text = "la pastilla", meaning = "Medicina pequeña, para tragar.", note = "Tomo una pastilla al día."), TargetExpression(text = "el jarabe", meaning = "Medicina líquida y dulce.", note = "El jarabe es bueno para la tos.")), situation = "Vas a la farmacia: quieres algo para la garganta; el farmacéutico te da unas pastillas: una cada ocho horas.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pide algo para el dolor de cabeza en la farmacia.", expected = listOf("Quiero algo para la cabeza", "quiero algo para la cabeza", "Quiero algo para el dolor de cabeza"), focus = "algo para", watch = "quiero algo para + el problema."), PracticeQuestion(prompt = "El farmacéutico pregunta para qué es. Di tu problema: la garganta.", expected = listOf("Es para el dolor de garganta", "es para el dolor de garganta", "Para la garganta"), focus = "es para", watch = "es para + el problema."), PracticeQuestion(prompt = "Pregunta el precio del jarabe.", expected = listOf("¿Cuánto cuesta?", "¿Cuanto cuesta?", "¿Cuánto es?", "¿Cuanto es?"), focus = "¿cuánto cuesta?", watch = "cuánto con tilde."), PracticeQuestion(prompt = "Pregunta cuántas pastillas tomas al día.", expected = listOf("¿Cuántas pastillas tomo al día?", "¿Cuantas pastillas tomo al dia?", "¿Cuántas tomo?", "¿Cuantas tomo?"), focus = "¿cuántas…?", watch = "cuántas con tilde."), PracticeQuestion(prompt = "Tu problema es la tos. Di para qué sirve el jarabe.", expected = listOf("El jarabe es para la tos", "el jarabe es para la tos"), focus = "es para la tos", watch = "el jarabe es líquido y dulce."))), exercises = listOf(Exercise(id = "es-foundations-u16-farmacia-e1", kind = "choice", prompt = "Estás en la farmacia y te duele la cabeza. Dices: «Quiero ___ para la cabeza».", options = listOf("algo", "nadie", "nada", "todos"), answers = listOf("algo"), explain = "Pides un remedio: quiero algo para la cabeza."), Exercise(id = "es-foundations-u16-farmacia-e2", kind = "gap", prompt = "—¿___ es? —Es para el dolor de garganta.", options = listOf(), answers = listOf("Para qué", "Para que"), explain = "El farmacéutico pregunta: ¿Para qué es?, con tilde en qué."), Exercise(id = "es-foundations-u16-farmacia-e3", kind = "order", prompt = "Pide un remedio para la tos.", options = listOf(), answers = listOf("Quiero algo para la tos"), explain = "Pides con quiero + algo para + la tos."), Exercise(id = "es-foundations-u16-farmacia-e4", kind = "written", prompt = "Pregunta al farmacéutico el precio de las pastillas.", options = listOf(), answers = listOf("¿Cuánto cuestan las pastillas?", "¿Cuanto cuestan las pastillas?", "¿Cuánto es?", "¿Cuanto es?"), explain = "El precio: ¿Cuánto cuesta?, con tilde.")), ski