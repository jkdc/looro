    Lesson(id = "fr-foundations-u25-veille", title = "Demain, on part", goal = "Organiser la veille du départ : ce soir… demain…, demander un dernier service et tout vérifier.", intro = LessonIntro(explanation = listOf("Le contraste ce soir / demain : « Ce soir, je prépare tout. Demain, on va se lever à cinq heures. »", "Le dernier service avec tu peux + infinitif : « Tu peux arroser les plantes ? » « Tu peux garder les clés ? »", "La check-list avec d'abord… ensuite… enfin : « D'abord les fenêtres, ensuite le gaz, et enfin, au lit ! »"), examples = listOf(ExampleLine(text = "Ce soir, je prépare tout.", meaning = "La veille active."), ExampleLine(text = "Demain, on va se lever à cinq heures.", meaning = "Le réveil du départ."), ExampleLine(text = "Tu peux arroser les plantes ?", meaning = "Le service du voisin."), ExampleLine(text = "Je laisse un mot avec les clés.", meaning = "Prévenir par écrit."), ExampleLine(text = "D'abord les fenêtres, ensuite le gaz.", meaning = "La check-list."), ExampleLine(text = "Et enfin, au lit !", meaning = "La fin de la veille."))), expressions = listOf(TargetExpression(text = "ce soir… demain…", meaning = "Le contraste de la veille.", note = "Ce soir je prépare, demain je pars."), TargetExpression(text = "tu peux + infinitif ?", meaning = "Le dernier service.", note = "Tu peux arroser les plantes ?"), TargetExpression(text = "se lever à + heure", meaning = "L'heure du départ.", note = "on se lève à cinq heures."), TargetExpression(text = "laisser un mot", meaning = "Prévenir sans appel.", note = "un mot pour le voisin."), TargetExpression(text = "être prêt(e)", meaning = "Le calme avant le départ.", note = "Tout est prêt !"), TargetExpression(text = "vérifier + nom", meaning = "La dernière vérification.", note = "vérifier les fenêtres.")), situation = "La veille au soir : vous préparez tout, vous prévenez le voisin pour les plantes, vous vérifiez fenêtres et gaz — demain, départ à cinq heures.", practice = LessonPractice(questions = 