ons-u25-valise-e3", kind = "order", prompt = "Rappelle à Léa son passeport.", options = listOf(), answers = listOf("N'oublie pas ton passeport"), explain = "Ne… pas + oublier à l'impératif : le rappel du départ."), Exercise(id = "fr-foundations-u25-valise-e4", kind = "written", prompt = "Dis ton plan : partir tôt demain (avec on).", options = listOf(), answers = listOf("on va partir tot demain", "on va partir tôt demain", "on va partir tot"), explain = "On va + infinitif : le plan de demain.")), skills = listOf("grammar:going-to", "vocab:travel", "function:make-future-plans", "grammar:connectors"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
