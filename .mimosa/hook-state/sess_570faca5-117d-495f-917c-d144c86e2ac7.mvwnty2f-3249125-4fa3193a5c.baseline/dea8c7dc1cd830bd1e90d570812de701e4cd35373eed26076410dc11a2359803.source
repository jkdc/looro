    Lesson(id = "it-foundations-u7-negozare", title = "E se chiudiamo a 50 ?", goal = "Negoziare un accordo: proporre col condizionale, mettere condizioni, chiudere.", intro = LessonIntro(explanation = listOf("Proporre: « E se chiudessimo a 50 ? », « Le darei 60 se include il trasporto ».", "Mettere condizioni: « Solo se consegna oggi », « In cambio, voglio la garanzia ».", "Chiudere: « Affare fatto », « D'accordo, ma a una condizione »."), examples = listOf(ExampleLine(text = "E se chiudessimo a 50 ?", meaning = "Proposta col congiuntivo."), ExampleLine(text = "Le darei 60 se include il trasporto.", meaning = "Condizionale + se + presente."), ExampleLine(text = "Solo se consegna oggi.", meaning = "Condizione ferma."), ExampleLine(text = "In cambio, voglio la garanzia.", meaning = "Controproposta."), ExampleLine(text = "Affare fatto.", meaning = "Chiusura."))), expressions = listOf(TargetExpression(text = "e se + congiuntivo ?", meaning = "Proporre.", note = "E se chiudessimo a… ?"), TargetExpression(text = "…rei se + presente", meaning = "Condizioni.", note = "le darei 60 se…"), TargetExpression(text = "solo se…", meaning = "Condizione ferma.", note = "solo se è oggi."), TargetExpression(text = "in cambio, …", meaning = "Controproposta.", note = "…la garanzia."), TargetExpression(text = "affare fatto", meaning = "Chiudere.", note = "dopo l'accordo.")), situation = "Trattate un tavolo di seconda mano: aprite alti, offrite con condizioni e chiudete a metà strada.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Proponi: e se chiudessimo a 50 ?", expected = listOf("E se chiudessimo a 50", "E se chiudessimo a 50 ?"), focus = "e se… ?", watch = "Chiudessimo: proposta."), PracticeQuestion(prompt = "Offri con condizione: le darei 60 se include il trasporto.", expected = listOf("Le darei 60 se include il trasporto"), focus = "darei se", watch = "Condizionale + se + presente."), PracticeQuestion(prompt = "Condizione ferma: solo se consegna oggi.", e