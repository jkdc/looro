object DeFoundationsU15 {
    val unit = CourseUnit(id = "de-foundations-u15", title = "Ich fühle mich gut", subtitle = "Grundgesundheit", level = "A1", themes = listOf(ConversationTheme("nicht-so-gut", "Nicht so gut", "Symptome sagen", "cross.case", "Course", "Mia fühlt sich nicht gut: Kopfschmerzen und Fieber. Kim fragt: Was hast du ?", 0),
                ConversationTheme("gesund-leben", "Gesund leben", "Gute Gewohnheiten", "pills", "Course", "Immer Wasser trinken, nie Fast Food — so bleibst du gesund.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u15-symptome", title = "Ich fühle mich nicht gut", goal = "Sagen, wie du dich fühlst, und Symptome nennen: Kopfschmerzen, Fieber, Husten.", intro = LessonIntro(explanation = listOf("sich fühlen: „Ich fühle mich gut.“ „Ich fühle mich nicht gut.“ Beispiel: „Wie fühlst du dich ?“", "haben + Krankheit: „Ich habe Kopfschmerzen.“ „Ich habe Fieber.“ Beispiel: „Ich habe Husten.“", "sein + Gefühl: „Ich bin krank.“ „Ich bin müde.“ Beispiel: „Er ist auch krank.“"), examples = listOf(ExampleLine(text = "Ich fühle mich nicht gut.", meaning = "sich fühlen: Mir geht es schlecht."), ExampleLine(text = "Ich habe Kopfschmerzen.", meaning = "haben + Schmerzen."), ExampleLine(text = "Ich habe Fieber.", meaning = "haben + Fieber."), ExampleLine(text = "Ich bin müde und krank.", meaning = "sein + Adjektiv."), ExampleLine(text = "Was hast du ?", meaning = "Nach Symptomen fragen."))), expressions = listOf(TargetExpression(text = "Ich fühle mich …", meaning = "Sagen, wie es dir geht.", note = "Ich fühle mich gut."), TargetExpression(text = "Kopfschmerzen haben", meaning = "Der Kopf tut weh.", note = "Ich habe Kopfschmerzen."), TargetExpression(text = "Fieber / Husten haben", meaning = "Krankheit mit haben.", note = "Ich habe Husten und Fieber."), TargetExpression(text = "Ich bin müde.", meaning = "Keine Energie: sein + müde.", note = "Ich bin so müde."), TargetExpression(text = "Was hast du ?", meaning = "Fragen, was los ist.", note = "Was hast du ? — Ich bin krank.")), situation = "Mia fühlt sich nicht gut: Sie ist müde und hat Kopfschmerzen. Kim fragt: Was hast du ?", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sagst, dass es dir nicht gut geht.", expected = listOf("Ich fühle mich nicht gut.", "ich fuehle mich nicht gut"), focus = "sich fühlen", watch = "fühlen = fuehlen."), PracticeQuestion(prompt = "Sagst, dass dein Kopf wehtut.", expected = listOf("Ich habe Kopfschmerzen.", "ich habe kopfschmerzen"), focus = "haben + …schmerzen", watch = "Kopf + Schmerzen = Kopfschmerzen."), PracticeQuestion(prompt = "Sagst, dass deine Temperatur 39 Grad ist.", expected = listOf("Ich habe Fieber.", "ich habe fieber"), focus = "Fieber haben", watch = "Hohe Temperatur = Fieber."), PracticeQuestion(prompt = "Fragst Sam, was los ist.", expected = listOf("Was hast du ?", "was hast du"), focus = "Was hast du ?", watch = "du hast → hast du ?"), PracticeQuestion(prompt = "Sagst zwei Gefühle. (müde und krank)", expected = listOf("Ich bin müde und krank.", "ich bin muede und krank"), focus = "sein + Adjektiv", watch = "müde = muede."))), exercises = listOf(Exercise(id = "de-foundations-u15-symptome-e1", kind = "choice", prompt = "Ich habe ___. Mein Kopf tut weh.", options = listOf("Kopfschmerzen", "Fieber", "Husten", "Durst"), answers = listOf("Kopfschmerzen"), explain = "Mein Kopf tut weh = ich habe Kopfschmerzen."), Exercise(id = "de-foundations-u15-symptome-e2", kind = "gap", prompt = "Ich habe ___. Die Temperatur ist 39 Grad.", options = listOf(), answers = listOf("fieber", "Fieber"), explain = "Hohe Temperatur: ich habe Fieber."), Exercise(id = "de-foundations-u15-symptome-e3", kind = "order", prompt = "Sagst, dass es dir nicht gut geht.", options = listOf(), answers = listOf("Ich fühle mich nicht gut"), explain = "sich fühlen: so sagt man, dass man krank ist."), Exercise(id = "de-foundations-u15-symptome-e4", kind = "written", prompt = "Fragst deine Freundin, was los ist.", options = listOf(), answers = listOf("was hast du", "Was hast du ?"), explain = "Frage nach Symptomen: Was hast du ?")), skills = listOf("function:talk-about-health", "vocab:health", "grammar:present-simple", "function:ask-simple-questions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u15-apotheke", title = "In der Apotheke", goal = "In der Apotheke etwas gegen Schmerzen oder Husten fragen und Anweisungen verstehen.", intro = LessonIntro(explanation = listOf("brauchen + Sache: „Ich brauche etwas gegen die Schmerzen.“ Beispiel: „Ich brauche Taschentücher.“", "etwas gegen + Problem: „Haben Sie etwas gegen Husten ?“ Beispiel: „etwas gegen Kopfschmerzen.“", "Anweisung mit Sie: „Nehmen Sie zwei Tabletten.“ Beispiel: „Gute Besserung !“"), examples = listOf(ExampleLine(text = "Ich brauche etwas gegen die Schmerzen.", meaning = "brauchen + gegen."), ExampleLine(text = "Haben Sie etwas gegen Husten ?", meaning = "Höflich fragen mit Sie."), ExampleLine(text = "Nehmen Sie zwei Tabletten.", meaning = "Anweisung mit Sie."), ExampleLine(text = "Das macht 6 Euro 50.", meaning = "Der Preis in der Apotheke."), ExampleLine(text = "Gute Besserung !", meaning = "Wunsch: bald wieder gesund."))), expressions = listOf(TargetExpression(text = "die Apotheke", meaning = "Hier kaufst du Medikamente.", note = "Ich gehe in die Apotheke."), TargetExpression(text = "etwas gegen …", meaning = "Ein Medikament für ein Problem.", note = "etwas gegen Kopfschmerzen"), TargetExpression(text = "die Tablette / die Tabletten", meaning = "eine Tablette — zwei Tabletten.", note = "Nehmen Sie zwei Tabletten."), TargetExpression(text = "Ich brauche …", meaning = "Sagen, was du brauchst.", note = "Ich brauche etwas gegen Husten."), TargetExpression(text = "Gute Besserung !", meaning = "Wunsch für Kranke.", note = "gute Besserung und schlaf gut !")), situation = "Kim ist für Mia in der Apotheke: Sie fragt nach etwas gegen die Schmerzen und wünscht gute Besserung.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sagst in der Apotheke, was du brauchst. (etwas gegen die Schmerzen)", expected = listOf("Ich brauche etwas gegen die Schmerzen.", "ich brauche etwas gegen die schmerzen"), focus = "brauchen + gegen", watch = "gegen die Schmerzen."), PracticeQuestion(prompt = "Fragst höflich nach etwas gegen Husten. (Sie)", expected = listOf("Haben Sie etwas gegen Husten ?", "haben sie etwas gegen husten"), focus = "Haben Sie … ?", watch = "Sie (höflich) schreibt man groß."), PracticeQuestion(prompt = "Sagst, wie oft du die Tabletten nimmst. (dreimal am Tag)", expected = listOf("Ich nehme die Tabletten dreimal am Tag.", "ich nehme die tabletten dreimal am tag"), focus = "dreimal am Tag", watch = "drei + mal = dreimal."), PracticeQuestion(prompt = "Wünschst deiner Freundin, dass sie bald gesund ist.", expected = listOf("Gute Besserung !", "gute besserung"), focus = "Gute Besserung !", watch = "Fester Wunsch für Kranke."), PracticeQuestion(prompt = "Sagst, wohin du gehst. (die Apotheke)", expected = listOf("Ich gehe in die Apotheke.", "ich gehe in die apotheke"), focus = "in die Apotheke", watch = "die Apotheke: ich gehe in die Apotheke."))), exercises = listOf(Exercise(id = "de-foundations-u15-apotheke-e1", kind = "choice", prompt = "Haben Sie etwas ___ Kopfschmerzen ?", options = listOf("gegen", "für", "mit", "von"), answers = listOf("gegen"), explain = "etwas gegen + Problem: etwas gegen Kopfschmerzen."), Exercise(id = "de-foundations-u15-apotheke-e2", kind = "gap", prompt = "Ich gehe in ___ Apotheke.", options = listOf(), answers = listOf("die"), explain = "die Apotheke: ich gehe in die Apotheke."), Exercise(id = "de-foundations-u15-apotheke-e3", kind = "order", prompt = "Fragst in der Apotheke nach Husten.", options = listOf(), answers = listOf("Haben Sie etwas gegen Husten"), explain = "Höfliche Frage mit Sie: Haben Sie etwas gegen Husten ?"), Exercise(id = "de-foundations-u15-apotheke-e4", kind = "written", prompt = "Wünschst jemandem, dass er bald gesund wird.", options = listOf(), answers = listOf("gute besserung", "Gute Besserung !"), explain = "Für Kranke wünscht man: Gute Besserung !")), skills = listOf("function:go-shopping", "vocab:health", "function:make-requests", "grammar:present-simple"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u15-gewohnheiten", title = "Gesund leben", goal = "Gesunde Gewohnheiten mit immer, oft und nie beschreiben.", intro = LessonIntro(explanation = listOf("Gesunde Gewohnheiten: Wasser trinken, Obst essen, spazieren gehen, schlafen. Beispiel: „Ich esse Obst.“", "immer / nie + Verb: „Ich trinke immer Wasser.“ „Ich rauche nie.“ Beispiel: „Ich gehe oft spazieren.“", "wie oft: „jeden Tag“, „zweimal pro Woche“. Beispiel: „Ich schwimme zweimal pro Woche.“"), examples = listOf(ExampleLine(text = "Ich trinke immer viel Wasser.", meaning = "immer: jeden Tag."), ExampleLine(text = "Ich esse nie Fast Food.", meaning = "nie: 0 %."), ExampleLine(text = "Ich gehe oft spazieren.", meaning = "spazieren gehen: zu Fuß draußen."), ExampleLine(text = "Ich schlafe acht Stunden.", meaning = "schlafen + Zeit."), ExampleLine(text = "Ich schwimme zweimal pro Woche.", meaning = "wie oft: zweimal."))), expressions = listOf(TargetExpression(text = "spazieren gehen", meaning = "Zu Fuß draußen sein.", note = "Ich gehe jeden Tag spazieren."), TargetExpression(text = "viel Wasser trinken", meaning = "Gesund für den Körper.", note = "Ich trinke viel Wasser."), TargetExpression(text = "nie rauchen", meaning = "0 % — sehr gesund.", note = "Er raucht nie."), TargetExpression(text = "Obst und Gemüse", meaning = "Gesund essen.", note = "Ich esse oft Obst."), TargetExpression(text = "schlafen", meaning = "Ausruhen: so bleibst du gesund.", note = "Ich schlafe acht Stunden.")), situation = "Mia ist wieder fit: Sie trinkt immer viel Wasser, isst nie Fast Food und geht oft spazieren.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sagst, dass du jeden Tag Wasser trinkst.", expected = listOf("Ich trinke immer Wasser.", "ich trinke immer wasser"), focus = "immer + Verb", watch = "immer steht nach dem Verb."), PracticeQuestion(prompt = "Sagst, dass du nie Fast Food isst.", expected = listOf("Ich esse nie Fast Food.", "ich esse nie fast food"), focus = "nie + Verb", watch = "nie: 0 %."), PracticeQuestion(prompt = "Sagst, wie oft du schwimmst. (2 x pro Woche)", expected = listOf("Ich schwimme zweimal pro Woche.", "ich schwimme zweimal pro woche", "zweimal pro woche"), focus = "zweimal", watch = "zwei + mal = zweimal."), PracticeQuestion(prompt = "Sagst, dass du oft draußen zu Fuß gehst.", expected = listOf("Ich gehe oft spazieren.", "ich gehe oft spazieren"), focus = "spazieren gehen", watch = "ich gehe + spazieren."), PracticeQuestion(prompt = "Fragst Sam, wie oft er schwimmt.", expected = listOf("Wie oft schwimmst du ?", "wie oft schwimmst du"), focus = "wie oft … ?", watch = "schwimmen: du schwimmst."))), exercises = listOf(Exercise(id = "de-foundations-u15-gewohnheiten-e1", kind = "choice", prompt = "Ich trinke ___ viel Wasser — jeden Tag.", options = listOf("immer", "nie", "manchmal", "selten"), answers = listOf("immer"), explain = "jeden Tag = immer: 100 %."), Exercise(id = "de-foundations-u15-gewohnheiten-e2", kind = "gap", prompt = "Ich esse ___ Fast Food. Ich mag es nicht.", options = listOf(), answers = listOf("nie"), explain = "Ich mag es nicht = 0 % = nie."), Exercise(id = "de-foundations-u15-gewohnheiten-e3", kind = "order", prompt = "Sagst, dass du oft draußen zu Fuß gehst.", options = listOf(), answers = listOf("Ich gehe oft spazieren"), explain = "spazieren gehen: ich gehe oft spazieren — gesund und einfach."), Exercise(id = "de-foundations-u15-gewohnheiten-e4", kind = "written", prompt = "Sagst, wie oft du Obst isst. (jeden Tag)", options = listOf(), answers = listOf("ich esse jeden tag obst", "Ich esse jeden Tag Obst."), explain = "jeden Tag = immer: ich esse jeden Tag Obst.")), skills = listOf("grammar:frequency-adverbs", "function:talk-about-routines", "vocab:health", "vocab:daily-routine"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:frequency-adverbs"))))
}

object DeFoundationsU16 {
    val unit = CourseUnit(id = "de-foundations-u16", title = "Am Tisch", subtitle = "Essen gehen", level = "A1", themes = listOf(ConversationTheme("im-restaurant", "Im Restaurant", "Ich nehme …", "fork.knife", "Course", "Lena und Kim essen im Café: die Kellnerin fragt, was sie möchten — und alle bestellen.", 0),
                ConversationTheme("die-karte", "Die Karte", "Was ist in … ?", "takeout.bag", "Course", "Auf der Karte stehen Vorspeisen, Hauptgerichte und Getränke. Was ist in der Suppe ? Fragt nach.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u16-restaurant", title = "Im Restaurant", goal = "Im Restaurant bestellen: was man möchte, höflich sagen.", intro = LessonIntro(explanation = listOf("Bestellen mit ich nehme: « Ich nehme die Tomatensuppe. » Und zum Nachbarn: « Und für dich ? »", "Höflicher ist möchte: « Ich möchte einen Kaffee, bitte. » möchte steht wie ein Modalverb: ich möchte, du möchtest, Sie möchten.", "Die Kellnerin fragt: « Was möchten Sie ? » — Antwort kurz: « Ein Wasser, bitte. »"), examples = listOf(ExampleLine(text = "Ich nehme den Salat.", meaning = "Bestellen: ich nehme + Akkusativ."), ExampleLine(text = "Ich möchte einen Kaffee, bitte.", meaning = "Höflich: möchte + Akkusativ."), ExampleLine(text = "Was nimmst du ?", meaning = "Frage am Tisch."), ExampleLine(text = "Ein Wasser für mich, bitte.", meaning = "Beim Bestellen: ein Wasser statt eines."), ExampleLine(text = "Und für dich ?", meaning = "Zurückfragen am Tisch."))), expressions = listOf(TargetExpression(text = "Ich nehme …", meaning = "Bestellen.", note = "Ich nehme die Suppe."), TargetExpression(text = "Ich möchte …", meaning = "Wünschen.", note = "möchte + Akkusativ: einen Kaffee"), TargetExpression(text = "Was nimmst du ?", meaning = "Fragen.", note = "nehmen → du nimmst (a → ä)"), TargetExpression(text = "… , bitte !", meaning = "Höflich.", note = "Ein Wasser, bitte !"), TargetExpression(text = "Und für dich ?", meaning = "Zurückfragen.", note = "höflich: Und für Sie ?")), situation = "Lena und Kim sitzen im Café. Die Kellnerin fragt: « Was möchten Sie ? » — Lena möchte Suppe, Kim nimmt Salat, und beide trinken Wasser.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Bestelle: du nimmst die Tomatensuppe.", expected = listOf("Ich nehme die Tomatensuppe.", "ich nehme die tomatensuppe"), focus = "ich nehme", watch = "nehmen → ich nehme."), PracticeQuestion(prompt = "Bestelle höflich: einen Kaffee.", expected = listOf("Ich möchte einen Kaffee, bitte.", "ich möchte einen kaffee bitte", "Ich moechte einen Kaffee, bitte."), focus = "ich möchte", watch = "der Kaffee → einen Kaffee (Akkusativ)."), PracticeQuestion(prompt = "Frag deine Freundin am Tisch, was sie nimmt.", expected = listOf("Was nimmst du ?", "was nimmst du"), focus = "was nimmst du", watch = "nehmen → du nimmst (a → ä)."), PracticeQuestion(prompt = "Bestelle ein Wasser, ganz ohne Artikelwort.", expected = listOf("Ein Wasser, bitte.", "ein wasser bitte"), focus = "ein wasser", watch = "Bestellung kurz: ein Wasser, bitte."), PracticeQuestion(prompt = "Frag zurück: und deine Freundin ?", expected = listOf("Und für dich ?", "und fur dich", "und für dich"), focus = "und für dich", watch = "für + dich (Akkusativ)."))), exercises = listOf(Exercise(id = "de-foundations-u16-restaurant-e1", kind = "choice", prompt = "Kellnerin: « Was ___ Sie ? »", options = listOf("möchten", "möchte", "nimmst", "ist"), answers = listOf("möchten"), explain = "Sie möchten: möchten für Sie und wir."), Exercise(id = "de-foundations-u16-restaurant-e2", kind = "gap", prompt = "Ich ___ die Tomatensuppe. (bestellen — mit nehmen)", options = listOf(), answers = listOf("nehme"), explain = "nehmen → ich nehme: so bestellt man."), Exercise(id = "de-foundations-u16-restaurant-e3", kind = "order", prompt = "Bestelle höflich einen Orangensaft.", options = listOf(), answers = listOf("Ich möchte einen Orangensaft, bitte"), explain = "möchte + Akkusativ + bitte: die höfliche Bestellung."), Exercise(id = "de-foundations-u16-restaurant-e4", kind = "written", prompt = "Sag, was du isst: du nimmst den Salat.", options = listOf(), answers = listOf("ich nehme den salat", "ich moechte den salat", "ich möchte den salat", "ich nehme einen salat"), explain = "Bestellen mit nehmen oder möchte: ich nehme den Salat.")), skills = listOf("function:order-food", "vocab:food", "grammar:present-simple", "function:ask-simple-questions"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u16-karte", title = "Die Karte", goal = "Die Karte lesen: Gerichte und Getränke nennen und fragen, was drin ist.", intro = LessonIntro(explanation = listOf("Die Karte hat Gänge: die Vorspeise, das Hauptgericht, der Nachtisch. Getränke: das Wasser, der Saft, der Kaffee.", "Fragen, was drin ist: « Was ist in der Suppe ? » — « Tomaten und Kartoffeln. » in + Dativ: in der Suppe, im Salat.", "Antwort im Plural mit sind: « Im Salat sind Tomaten und Käse. »"), examples = listOf(ExampleLine(text = "Die Karte, bitte.", meaning = "Nach der Karte fragen."), ExampleLine(text = "Was ist in der Suppe ?", meaning = "Nach den Zutaten fragen."), ExampleLine(text = "Im Salat sind Tomaten und Käse.", meaning = "Plural: sind — im = in dem."), ExampleLine(text = "Die Vorspeise ist eine kleine Suppe.", meaning = "Vorspeise = erster Gang."), ExampleLine(text = "Was nehmt ihr zu trinken ?", meaning = "Nach den Getränken fragen."))), expressions = listOf(TargetExpression(text = "die Vorspeise / das Hauptgericht / der Nachtisch", meaning = "Die Gänge der Karte.", note = "Nachtisch = postre."), TargetExpression(text = "Was ist in … ?", meaning = "Nach den Zutaten fragen.", note = "Was ist in der Soße ?"), TargetExpression(text = "in der Suppe / im Salat", meaning = "in + Dativ.", note = "im = in dem."), TargetExpression(text = "zu trinken / zu essen", meaning = "Getränke / Essen.", note = "Was gibt es zu trinken ?"), TargetExpression(text = "Wie schmeckt es ?", meaning = "Nach dem Geschmack fragen.", note = "Es schmeckt gut !")), situation = "Zuerst kommt die Karte: Vorspeise, Hauptgericht, Nachtisch. Kim fragt, was in der Suppe ist, Lena fragt, was es zu trinken gibt.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Frag, was in der Suppe ist.", expected = listOf("Was ist in der Suppe ?", "was ist in der suppe"), focus = "was ist in", watch = "in + Dativ: in der Suppe."), PracticeQuestion(prompt = "Sag, was im Salat ist: Tomaten und Käse.", expected = listOf("Im Salat sind Tomaten und Käse.", "im salat sind tomaten und käse", "Im Salat sind Tomaten und Kaese."), focus = "im salat sind", watch = "Plural: sind."), PracticeQuestion(prompt = "Frag, was es zu trinken gibt.", expected = listOf("Was gibt es zu trinken ?", "was gibt es zu trinken"), focus = "zu trinken", watch = "zu + Infinitiv: zu trinken."), PracticeQuestion(prompt = "Sag, was du trinkst: einen Apfelsaft.", expected = listOf("Ich nehme einen Apfelsaft.", "ich nehme einen apfelsaft", "Ich moechte einen Apfelsaft.", "Ich möchte einen Apfelsaft."), focus = "ich nehme", watch = "der Saft → einen Saft (Akkusativ)."), PracticeQuestion(prompt = "Frag, wie die Suppe schmeckt.", expected = listOf("Wie schmeckt die Suppe ?", "wie schmeckt die suppe", "Wie schmeckt es ?"), focus = "wie schmeckt", watch = "schmecken: Wie schmeckt es ?"))), exercises = listOf(Exercise(id = "de-foundations-u16-karte-e1", kind = "choice", prompt = "___ ist in der Suppe ?", options = listOf("Was", "Wo", "Wie", "Wer"), answers = listOf("Was"), explain = "Nach den Zutaten fragen: Was ist in … ?"), Exercise(id = "de-foundations-u16-karte-e2", kind = "gap", prompt = "Im Salat ___ Tomaten und Käse.", options = listOf(), answers = listOf("sind"), explain = "Plural: sind — im Salat sind Tomaten."), Exercise(id = "de-foundations-u16-karte-e3", kind = "order", prompt = "Frag, was in der Soße ist.", options = listOf(), answers = listOf("Was ist in der Soße"), explain = "Was ist in + Dativ: so fragt man nach Zutaten."), Exercise(id = "de-foundations-u16-karte-e4", kind = "written", prompt = "Sag, was du zu trinken nimmst. (ein Mineralwasser)", options = listOf(), answers = listOf("ich nehme ein mineralwasser", "ich moechte ein mineralwasser", "ich möchte ein mineralwasser"), explain = "Getränk bestellen: ich nehme ein Mineralwasser.")), skills = listOf("function:order-food", "vocab:food", "grammar:present-questions", "grammar:present-simple"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u16-rechnung", title = "Die Rechnung", goal = "Um die Rechnung bitten, zusammen oder getrennt zahlen und Trinkgeld geben.", intro = LessonIntro(explanation = listOf("Um die Rechnung bitten: « Die Rechnung, bitte ! » oder « Ich möchte zahlen. »", "Die Kellnerin fragt: « Zusammen oder getrennt ? » — zusammen = alle zahlen alles, getrennt = jeder zahlt für sich.", "Der Betrag: « Das macht vierundzwanzig Euro. » Trinkgeld gibt man so: « Stimmt so. » — der Kellner behält den Rest."), examples = listOf(ExampleLine(text = "Die Rechnung, bitte !", meaning = "So bittet man um die Rechnung."), ExampleLine(text = "Ich möchte zahlen.", meaning = "Auch möglich: zahlen, bitte."), ExampleLine(text = "Zusammen oder getrennt ?", meaning = "Die Standardfrage am Tisch."), ExampleLine(text = "Das macht 24 Euro.", meaning = "Der Betrag."), ExampleLine(text = "Stimmt so.", meaning = "Trinkgeld: kein Wechselgeld nötig."))), expressions = listOf(TargetExpression(text = "Die Rechnung, bitte !", meaning = "Um die Rechnung bitten.", note = "auch: zahlen, bitte !"), TargetExpression(text = "Ich möchte zahlen.", meaning = "Zahlen.", note = "auch: wir möchten zahlen"), TargetExpression(text = "Zusammen oder getrennt ?", meaning = "Am Tisch fragen.", note = "getrennt = jeder für sich"), TargetExpression(text = "Das macht … Euro.", meaning = "Der Betrag.", note = "Das macht vierundzwanzig Euro."), TargetExpression(text = "Stimmt so.", meaning = "Trinkgeld geben.", note = "der Kellner behält den Rest")), situation = "Das Essen ist fertig. Lena ruft: « Die Rechnung, bitte ! » — « Zusammen oder getrennt ? » — « Getrennt, bitte. » Kim gibt Trinkgeld: « Stimmt so. »", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Bittet um die Rechnung.", expected = listOf("Die Rechnung, bitte !", "die rechnung bitte", "Ich möchte zahlen.", "ich mochte zahlen"), focus = "die rechnung", watch = "Die Rechnung, bitte !"), PracticeQuestion(prompt = "Fragt am Tisch: alles zusammen oder jeder für sich ?", expected = listOf("Zusammen oder getrennt ?", "zusammen oder getrennt"), focus = "zusammen oder getrennt", watch = "Die Standardfrage am Tisch."), PracticeQuestion(prompt = "Sagt, dass jeder für sich zahlt.", expected = listOf("Getrennt, bitte.", "getrennt bitte", "Wir zahlen getrennt."), focus = "getrennt", watch = "getrennt = jeder für sich."), PracticeQuestion(prompt = "Sagt den Betrag: 24 Euro.", expected = listOf("Das macht 24 Euro.", "das macht vierundzwanzig euro", "Das macht vierundzwanzig Euro."), focus = "das macht", watch = "Der Betrag: das macht … Euro."), PracticeQuestion(prompt = "Gebt Trinkgeld: kein Wechselgeld nötig.", expected = listOf("Stimmt so.", "stimmt so"), focus = "stimmt so", watch = "« Stimmt so » = der Rest ist Trinkgeld."))), exercises = listOf(Exercise(id = "de-foundations-u16-rechnung-e1", kind = "choice", prompt = "« Die ___, bitte ! » (ihr wollt zahlen)", options = listOf("Rechnung", "Karte", "Speise", "Küche"), answers = listOf("Rechnung"), explain = "Die Rechnung, bitte ! = so bittet man um Zahlen."), Exercise(id = "de-foundations-u16-rechnung-e2", kind = "gap", prompt = "Das ___ zwölf Euro.", options = listOf(), answers = listOf("macht"), explain = "Der Betrag: das macht zwölf Euro."), Exercise(id = "de-foundations-u16-rechnung-e3", kind = "order", prompt = "Bittet höflich um die Rechnung.", options = listOf(), answers = listOf("Die Rechnung bitte"), explain = "Die Rechnung, bitte ! — kurze, höfliche Formel."), Exercise(id = "de-foundations-u16-rechnung-e4", kind = "written", prompt = "Ihr zahlt zusammen und gebt Trinkgeld. Was sagt ihr ?", options = listOf(), answers = listOf("stimmt so", "stimmt so danke"), explain = "« Stimmt so » = der Rest ist Trinkgeld.")), skills = listOf("function:order-food", "grammar:quantities", "vocab:food", "vocab:social-expressions"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple"))))
}

object DeFoundationsU19 {
    val unit = CourseUnit(id = "de-foundations-u19", title = "Ein Besuch", subtitle = "Bei Freunden zu Gast", level = "A1", themes = listOf(ConversationTheme("die-einladung", "Die Einladung", "Darf ich … ?", "door.left.open", "Course", "Jakob klingelt an Leas Tür: darf er reinkommen, darf er die Schuhe anlassen ? Die Gastgeberin entscheidet mit darf.", 0),
                ConversationTheme("das-mitbringsel", "Das Mitbringsel", "Ich bringe etwas mit", "gift", "Course", "Niemals mit leeren Händen: Blumen, Kuchen, Schokolade — was bringst du zu Besuch mit ?", 1)), lessons = listOf(    Lesson(id = "de-foundations-u19-besuch", title = "Darf ich reinkommen ?", goal = "Um Erlaubnis bitten: mit darf fragst du, was erlaubt ist — an der Tür, im Haus, bei Freunden.", intro = LessonIntro(explanation = listOf("Fragen mit darf: « Darf ich reinkommen ? », « Darf ich die Schuhe anlassen ? » darf ist wie kann: ich darf, du darfst, Sie dürfen.", "Erlaubnis geben geht mit du darfst: « Du darfst gern reinkommen. » Kurz und freundlich: « Natürlich, komm rein ! »", "Was verboten ist, sagt man mit darf nicht: « Hier darf man nicht rauchen. » darf nicht = es ist nicht erlaubt."), examples = listOf(ExampleLine(text = "Darf ich reinkommen ?", meaning = "An der Tür um Erlaubnis fragen."), ExampleLine(text = "Darf ich Ihnen helfen ?", meaning = "Höflich mit Sie: dürfen."), ExampleLine(text = "Du darfst gern die Schuhe ausziehen.", meaning = "Erlaubnis geben: du darfst."), ExampleLine(text = "Hier darf man nicht rauchen.", meaning = "Verbot: darf nicht."), ExampleLine(text = "Natürlich, komm rein !", meaning = "Die freundliche Antwort."))), expressions = listOf(TargetExpression(text = "Darf ich … ?", meaning = "Um Erlaubnis bitten.", note = "Darf ich reinkommen ?"), TargetExpression(text = "du darfst / Sie dürfen", meaning = "Erlaubnis geben.", note = "Du darfst gern mitkommen."), TargetExpression(text = "darf nicht", meaning = "Nicht erlaubt.", note = "Ich darf hier nicht parken."), TargetExpression(text = "Natürlich !", meaning = "Ja sagen.", note = "Natürlich, komm rein !"), TargetExpression(text = "komm rein / reinkommen", meaning = "Ins Haus bitten.", note = "trennbar: Ich komme rein.")), situation = "Jakob steht vor Leas Tür und klingelt. « Darf ich reinkommen ? » — « Natürlich ! Die Schuhe darfst du ausziehen. » Rauchen darf man hier nicht.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Frag an der Tür, ob du reinkommen darfst.", expected = listOf("Darf ich reinkommen ?", "darf ich reinkommen", "Darf ich hereinkommen ?"), focus = "darf ich", watch = "Fragen mit Darf ich … ?"), PracticeQuestion(prompt = "Frag höflich mit Sie, ob du helfen darfst.", expected = listOf("Darf ich Ihnen helfen ?", "darf ich ihnen helfen", "Darf ich Ihnen helfen"), focus = "darf ich ihnen", watch = "Höflich: Darf ich Ihnen … ?"), PracticeQuestion(prompt = "Gib deinem Gast die Erlaubnis: er darf die Schuhe ausziehen.", expected = listOf("Du darfst die Schuhe ausziehen.", "du darfst die schuhe ausziehen"), focus = "du darfst", watch = "Erlaubnis: du darfst + Infinitiv."), PracticeQuestion(prompt = "Sag, dass man hier nicht rauchen darf.", expected = listOf("Hier darf man nicht rauchen.", "hier darf man nicht rauchen", "Man darf hier nicht rauchen."), focus = "darf nicht", watch = "Verbot: darf nicht."), PracticeQuestion(prompt = "Dein Gast fragt: Darf ich reinkommen ? Antworte freundlich mit Ja.", expected = listOf("Natürlich, komm rein !", "natürlich komm rein", "Natürlich komm rein", "Klar, komm rein !"), focus = "natürlich", watch = "Natürlich ! = Ja, gern."))), exercises = listOf(Exercise(id = "de-foundations-u19-besuch-e1", kind = "choice", prompt = "« ___ ich reinkommen ? » (an der Tür)", options = listOf("Darf", "Kannst", "Muss", "Bin"), answers = listOf("Darf"), explain = "Um Erlaubnis bitten: Darf ich … ?"), Exercise(id = "de-foundations-u19-besuch-e2", kind = "gap", prompt = "Du ___ gern mitessen. (Erlaubnis geben)", options = listOf(), answers = listOf("darfst"), explain = "du darfst: so gibst du die Erlaubnis."), Exercise(id = "de-foundations-u19-besuch-e3", kind = "order", prompt = "Frag an der Tür höflich mit Sie, ob du helfen darfst.", options = listOf(), answers = listOf("Darf ich Ihnen helfen"), explain = "Darf ich Ihnen helfen ? — die höfliche Frage mit Ihnen."), Exercise(id = "de-foundations-u19-besuch-e4", kind = "written", prompt = "Sag, dass du hier nicht parken darfst.", options = listOf(), answers = listOf("ich darf hier nicht parken", "hier darf man nicht parken"), explain = "darf nicht = verboten: ich darf hier nicht parken.")), skills = listOf("grammar:can", "function:make-requests", "vocab:social-expressions", "grammar:present-simple"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u19-mitbringsel", title = "Ich bringe etwas mit", goal = "Den Gastgebern etwas anbieten: Blumen, Kuchen oder Schokolade — ich bringe … mit.", intro = LessonIntro(explanation = listOf("Das Mitbringsel kommt mit: « Ich bringe einen Kuchen mit. » mitbringen ist trennbar: ich bringe … mit.", "Nachfragen am Telefon: « Was kann ich mitbringen ? » — die Antwort: « Bring nichts mit, komm einfach ! »", "Am Tisch bietet man an: « Möchtest du noch Saft ? » — und bedankt sich: « Danke, der Kuchen schmeckt super ! »"), examples = listOf(ExampleLine(text = "Ich bringe Blumen mit.", meaning = "mitbringen: ich bringe … mit."), ExampleLine(text = "Was kann ich mitbringen ?", meaning = "Nach dem Mitbringsel fragen."), ExampleLine(text = "Bring doch Schokolade mit !", meaning = "Einen Vorschlag machen."), ExampleLine(text = "Der Kuchen ist für euch.", meaning = "Das Geschenk zeigen."), ExampleLine(text = "Möchtest du noch Saft ?", meaning = "Am Tisch anbieten."))), expressions = listOf(TargetExpression(text = "Ich bringe … mit.", meaning = "Das Mitbringsel ankündigen.", note = "Ich bringe Wein mit."), TargetExpression(text = "Was kann ich mitbringen ?", meaning = "Nachfragen.", note = "« Bring nichts mit ! »"), TargetExpression(text = "Blumen / Schokolade / ein Kuchen", meaning = "Typische Mitbringsel.", note = "Blumen für die Gastgeberin"), TargetExpression(text = "Möchtest du … ?", meaning = "Am Tisch anbieten.", note = "Möchtest du noch Kuchen ?"), TargetExpression(text = "Das ist für dich/euch.", meaning = "Übergeben.", note = "Die Blumen sind für dich.")), situation = "Jakob fragt am Telefon: « Was kann ich mitbringen ? » Lea sagt: « Bring nichts mit ! » — aber er bringt Blumen und einen Kuchen mit. Am Tisch: « Möchtest du noch Saft ? »", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sag, was du mitbringst: einen Kuchen.", expected = listOf("Ich bringe einen Kuchen mit.", "ich bringe einen kuchen mit"), focus = "ich bringe", watch = "trennbar: bringe … mit."), PracticeQuestion(prompt = "Frag am Telefon, was du mitbringen kannst.", expected = listOf("Was kann ich mitbringen ?", "was kann ich mitbringen"), focus = "was kann ich", watch = "Fragen mit kann."), PracticeQuestion(prompt = "Biete am Tisch noch Kuchen an. (Möchtest du … ?)", expected = listOf("Möchtest du noch Kuchen ?", "möchtest du noch kuchen", "Moechtest du noch Kuchen ?"), focus = "möchtest du", watch = "Angebot: Möchtest du … ?"), PracticeQuestion(prompt = "Gib das Mitbringsel weiter: Blumen, und an wen sie gehen.", expected = listOf("Die Blumen sind für Lea.", "die blumen sind für lea", "die blumen sind fur lea"), focus = "für", watch = "für + Akkusativ."), PracticeQuestion(prompt = "Bedanke dich für den Kuchen: er schmeckt super.", expected = listOf("Der Kuchen schmeckt super.", "der kuchen schmeckt super", "Danke, der Kuchen schmeckt super !"), focus = "schmeckt", watch = "schmecken: Der Kuchen schmeckt super."))), exercises = listOf(Exercise(id = "de-foundations-u19-mitbringsel-e1", kind = "choice", prompt = "« Ich ___ einen Salat mit. » (zur Party)", options = listOf("bringe", "bringst", "bringt", "kommen"), answers = listOf("bringe"), explain = "mitbringen ist trennbar: ich bringe … mit."), Exercise(id = "de-foundations-u19-mitbringsel-e2", kind = "gap", prompt = "Was ___ ich mitbringen ? (können)", options = listOf(), answers = listOf("kann"), explain = "Fragen mit kann: Was kann ich mitbringen ?"), Exercise(id = "de-foundations-u19-mitbringsel-e3", kind = "order", prompt = "Sag, was du zu Kim mitbringst: Blumen.", options = listOf(), answers = listOf("Ich bringe Blumen mit"), explain = "trennbares Verb am Satzende: bringe … mit."), Exercise(id = "de-foundations-u19-mitbringsel-e4", kind = "written", prompt = "Biete deinem Gast noch Tee an.", options = listOf(), answers = listOf("möchtest du noch tee", "moechtest du noch tee", "willst du noch tee"), explain = "Am Tisch anbieten: Möchtest du noch Tee ?")), skills = listOf("function:make-requests", "vocab:food", "vocab:social-expressions", "function:order-food"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u19-abschied", title = "Bis zum nächsten Mal", goal = "Sich verabschieden und danken: Vielen Dank für die Einladung — bis zum nächsten Mal !", intro = LessonIntro(explanation = listOf("Danken gehört zum Abschied: « Vielen Dank für die Einladung ! » oder kurz: « Danke für alles ! »", "Der Abschied mit bis: « Bis bald ! », « Bis zum nächsten Mal ! » — und: « Grüße an deine Familie ! »", "Hilfe und Weggehen mit kann: « Kann ich dir beim Aufräumen helfen ? » — « Komm gut nach Hause ! »"), examples = listOf(ExampleLine(text = "Vielen Dank für die Einladung !", meaning = "Sich bedanken."), ExampleLine(text = "Es war wirklich schön.", meaning = "Das Kompliment am Ende."), ExampleLine(text = "Bis zum nächsten Mal !", meaning = "Der Abschied."), ExampleLine(text = "Komm gut nach Hause !", meaning = "Gute Heimfahrt wünschen."), ExampleLine(text = "Kann ich dir beim Aufräumen helfen ?", meaning = "Hilfe anbieten mit kann."))), expressions = listOf(TargetExpression(text = "Vielen Dank für …", meaning = "Sich bedanken.", note = "Vielen Dank für das tolle Essen !"), TargetExpression(text = "Bis bald ! / Bis zum nächsten Mal !", meaning = "Der Abschied.", note = "Bis Sonntag !"), TargetExpression(text = "Grüße an … !", meaning = "Grüße ausrichten.", note = "Grüße an deine Eltern !"), TargetExpression(text = "Komm gut nach Hause !", meaning = "Gute Heimfahrt wünschen.", note = "auch: Fahr gut !"), TargetExpression(text = "Kann ich dir helfen ?", meaning = "Hilfe anbieten.", note = "beim Aufräumen, beim Kochen")), situation = "Am späten Abend steht Jakob auf: « Vielen Dank für die Einladung ! » Er hilft kurz beim Aufräumen und verabschiedet sich: « Bis zum nächsten Mal ! Grüße an Tim ! »", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Bedanke dich für die Einladung.", expected = listOf("Vielen Dank für die Einladung.", "vielen dank für die einladung", "vielen dank fur die einladung", "Danke für die Einladung."), focus = "vielen dank", watch = "Vielen Dank für + Akkusativ."), PracticeQuestion(prompt = "Sag am Ende des Abends, dass es schön war.", expected = listOf("Es war schön.", "es war schön", "es war schoen", "Es war wirklich schön."), focus = "es war schön", watch = "« Es war schön »: feste Formel."), PracticeQuestion(prompt = "Verabschiede dich mit der festen Formel fürs Wiedersehen.", expected = listOf("Bis zum nächsten Mal !", "bis zum nächsten mal", "bis zum nachsten mal", "Bis bald !"), focus = "bis", watch = "bis + Zeit: bis bald, bis Sonntag."), PracticeQuestion(prompt = "Biete Hilfe beim Aufräumen an. (kann)", expected = listOf("Kann ich dir beim Aufräumen helfen ?", "kann ich dir beim aufräumen helfen", "kann ich dir beim aufraumen helfen"), focus = "kann ich dir", watch = "kann + beim: beim Aufräumen."), PracticeQuestion(prompt = "Wünsch deinem Gastgeber eine gute Heimfahrt.", expected = listOf("Komm gut nach Hause !", "komm gut nachhause", "Gute Heimfahrt !", "Fahr gut !"), focus = "komm gut", watch = "« Komm gut nach Hause ! »"))), exercises = listOf(Exercise(id = "de-foundations-u19-abschied-e1", kind = "choice", prompt = "« Vielen Dank ___ die Einladung ! »", options = listOf("für", "an", "auf", "mit"), answers = listOf("für"), explain = "Vielen Dank für + Akkusativ: für die Einladung."), Exercise(id = "de-foundations-u19-abschied-e2", kind = "gap", prompt = "___ zum nächsten Mal !", options = listOf(), answers = listOf("Bis"), explain = "Der Abschied: Bis zum nächsten Mal !"), Exercise(id = "de-foundations-u19-abschied-e3", kind = "order", prompt = "Biete Hilfe beim Aufräumen an.", options = listOf(), answers = listOf("Kann ich dir beim Aufräumen helfen"), explain = "Hilfe anbieten mit kann: Kann ich dir helfen ?"), Exercise(id = "de-foundations-u19-abschied-e4", kind = "written", prompt = "Verabschiede dich für das nächste Wochenende. (bis)", options = listOf(), answers = listOf("bis zum nächsten mal", "bis zum nachsten mal", "bis bald", "bis sonntag"), explain = "bis + Zeit: bis zum nächsten Mal.")), skills = listOf("vocab:social-expressions", "grammar:present-simple", "function:ask-simple-questions", "grammar:can"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple"))))
}

object DeFoundationsU22 {
    val unit = CourseUnit(id = "de-foundations-u22", title = "Wir feiern", subtitle = "Partys, Geschenke, Wünsche", level = "A1", themes = listOf(ConversationTheme("die-ueberraschung", "Die Überraschung", "Kommst du auch ?", "party.popper", "Course", "Lea plant eine Überraschungsparty für Tim: einladen, zusagen, mitbringen — alles im Präsens.", 0),
                ConversationTheme("der-geburtstag", "Der Geburtstag", "Alles Gute !", "birthday.cake", "Course", "Die Kerzen brennen, die Tür geht auf: « Überraschung ! » Gratulieren, wünschen, sich freuen.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u22-fest", title = "Eine Einladung", goal = "Einladen und zusagen: mit Präsens und Wollen wir … lädst du Freunde zur Party ein.", intro = LessonIntro(explanation = listOf("Einladen geht einfach: « Ich feiere am Samstag eine Party. Kommst du auch ? » — Frage + Präsens, mehr brauchst du nicht.", "Zusagen oder absagen: « Ja, ich komme gern ! », « Leider kann ich nicht. » — mit kann sagst du auch freundlich Nein.", "Vorschläge mit Wollen wir … ? verbinden: « Wollen wir zusammen kommen ? » — der Infinitiv steht am Ende."), examples = listOf(ExampleLine(text = "Ich feiere am Samstag eine Party.", meaning = "Die Einladung im Präsens."), ExampleLine(text = "Kommst du auch ?", meaning = "Die direkte Frage."), ExampleLine(text = "Ja, ich komme gern !", meaning = "Die Zusage — gern zeigt Freude."), ExampleLine(text = "Leider kann ich nicht.", meaning = "Die höfliche Absage."), ExampleLine(text = "Wollen wir um sieben kommen ?", meaning = "Der Vorschlag mit Infinitiv am Ende."))), expressions = listOf(TargetExpression(text = "Ich feiere …", meaning = "Einladen.", note = "Ich feiere am Freitag ein Fest."), TargetExpression(text = "Kommst du auch ?", meaning = "Freunde fragen.", note = "Kommst du zu meiner Party ?"), TargetExpression(text = "Ja, ich komme gern !", meaning = "Zusagen.", note = "gern zeigt: du freust dich."), TargetExpression(text = "Leider kann ich nicht.", meaning = "Absagen.", note = "leider macht das Nein höflich."), TargetExpression(text = "Wollen wir … ?", meaning = "Vorschlagen.", note = "Wollen wir zusammen fahren ?")), situation = "Lea ruft Mira an: sie feiert am Samstag eine Party für Tim. « Kommst du auch ? » — Mira sagt zu und fragt, was sie mitbringen soll.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Lade ein: du feierst am Samstag eine Party.", expected = listOf("Ich feiere am Samstag eine Party.", "ich feiere am samstag eine party"), focus = "ich feiere", watch = "Präsens + Zeitangabe."), PracticeQuestion(prompt = "Frag Mira, ob sie auch kommt.", expected = listOf("Kommst du auch ?", "kommst du auch", "Kommst du zu meiner Party ?"), focus = "kommst du", watch = "Ja/Nein-Frage im Präsens."), PracticeQuestion(prompt = "Sage ja — du kommst gern.", expected = listOf("Ja, ich komme gern.", "ja ich komme gern", "Ja, ich komme !"), focus = "ich komme", watch = "gern drückt Freude aus."), PracticeQuestion(prompt = "Sage höflich nein: du hast keine Zeit.", expected = listOf("Leider kann ich nicht.", "leider kann ich nicht", "Ich kann leider nicht.", "Leider habe ich keine Zeit."), focus = "leider", watch = "leider + kann: die Absage."), PracticeQuestion(prompt = "Schlage vor: ihr kommt zusammen um sieben.", expected = listOf("Wollen wir um sieben kommen ?", "wollen wir um sieben kommen", "Lass uns um sieben kommen !"), focus = "wollen wir", watch = "Vorschlag: Wollen wir … ?"))), exercises = listOf(Exercise(id = "de-foundations-u22-fest-e1", kind = "choice", prompt = "« Ich ___ am Samstag eine Party. Kommst du ? »", options = listOf("feiere", "feierst", "feiert", "feiern"), answers = listOf("feiere"), explain = "ich feiere: die Einladung im Präsens."), Exercise(id = "de-foundations-u22-fest-e2", kind = "gap", prompt = "Leider ___ ich nicht. (keine Zeit)", options = listOf(), answers = listOf("kann"), explain = "Absage mit kann: Leider kann ich nicht."), Exercise(id = "de-foundations-u22-fest-e3", kind = "order", prompt = "Schlage um sieben Uhr vor.", options = listOf(), answers = listOf("Wollen wir um sieben Uhr kommen"), explain = "Vorschlag: Wollen wir … ? + Infinitiv am Ende."), Exercise(id = "de-foundations-u22-fest-e4", kind = "written", prompt = "Sage zu und zeige deine Freude.", options = listOf(), answers = listOf("ja ich komme gern", "ich komme gern", "ja ich komme"), explain = "Zusage: Ja, ich komme gern !")), skills = listOf("vocab:social-expressions", "grammar:present-simple", "function:make-suggestions", "function:ask-simple-questions"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u22-geschenkidee", title = "Was schenken wir ?", goal = "Über Geschenke sprechen: mit W-Fragen im Präsens findest du das richtige Geschenk.", intro = LessonIntro(explanation = listOf("W-Fragen helfen beim Planen: « Was schenken wir Lena ? », « Was braucht sie ? » — Fragewort + Verb + Subjekt.", "Im Laden fragst du so: « Haben Sie diese Tasse in Blau ? », « Was kostet das ? » — mit Sie bleibst du höflich.", "Ideen sammeln mit Vorschlägen: « Schenken wir doch einen Kalender ! » — « Gute Idee ! »"), examples = listOf(ExampleLine(text = "Was schenken wir Lena ?", meaning = "Die Geschenkfrage."), ExampleLine(text = "Was braucht sie denn ?", meaning = "Nach dem Bedarf fragen."), ExampleLine(text = "Haben Sie diese Tasse in Blau ?", meaning = "Im Laden nach Farbe fragen."), ExampleLine(text = "Was kostet das Geschenkpapier ?", meaning = "Nach dem Preis fragen."), ExampleLine(text = "Schenken wir doch einen Kalender !", meaning = "Der Vorschlag mit doch."))), expressions = listOf(TargetExpression(text = "Was schenkst du … ?", meaning = "Über Geschenke reden.", note = "Was schenkst du deiner Schwester ?"), TargetExpression(text = "Was brauchst du ?", meaning = "Nach Wünschen fragen.", note = "Ich brauche eine neue Tasche."), TargetExpression(text = "Haben Sie … ?", meaning = "Im Laden fragen.", note = "Haben Sie das auch in Rot ?"), TargetExpression(text = "Was kostet … ?", meaning = "Nach dem Preis fragen.", note = "Was kostet die Tasse ?"), TargetExpression(text = "Gute Idee !", meaning = "Zustimmen.", note = "Dann schenken wir einen Kalender.")), situation = "Mira und Lea suchen ein Geburtstagsgeschenk für Tim. Kopfhörer sind zu teuer — also fragen sie im Laden nach einer Tasse mit Foto. « Was kostet sie ? »", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Frag Mira, was ihr Tim schenkt.", expected = listOf("Was schenken wir Tim ?", "was schenken wir tim", "Was schenkst du Tim ?"), focus = "was schenken", watch = "W-Frage: was + Verb + Subjekt."), PracticeQuestion(prompt = "Frag, was Tim braucht.", expected = listOf("Was braucht Tim ?", "was braucht tim", "Was braucht er ?"), focus = "was braucht", watch = "brauchen + Sache."), PracticeQuestion(prompt = "Frag im Laden, ob es die Tasse in Blau gibt.", expected = listOf("Haben Sie die Tasse in Blau ?", "haben sie die tasse in blau", "Haben Sie die Tasse auch in Blau ?"), focus = "haben sie", watch = "Höflich im Laden: Haben Sie … ?"), PracticeQuestion(prompt = "Frag nach dem Preis der Tasse.", expected = listOf("Was kostet die Tasse ?", "was kostet die tasse", "Was kostet sie ?"), focus = "was kostet", watch = "Preisfrage mit was/wie viel."), PracticeQuestion(prompt = "Stimme dem Vorschlag zu: ein Kalender.", expected = listOf("Gute Idee !", "gute idee", "Das ist eine gute Idee !"), focus = "gute idee", watch = "Zustimmung: Gute Idee !"))), exercises = listOf(Exercise(id = "de-foundations-u22-geschenkidee-e1", kind = "choice", prompt = "« Was ___ wir Lena zum Geburtstag ? »", options = listOf("schenken", "schenkt", "schenkst", "geschenkt"), answers = listOf("schenken"), explain = "wir schenken: W-Frage mit wir im Präsens."), Exercise(id = "de-foundations-u22-geschenkidee-e2", kind = "gap", prompt = "Haben ___ diese Tasse in Blau ?", options = listOf(), answers = listOf("Sie"), explain = "Im Laden fragt man höflich mit Sie."), Exercise(id = "de-foundations-u22-geschenkidee-e3", kind = "order", prompt = "Frag im Laden nach dem Preis der Tasse.", options = listOf(), answers = listOf("Was kostet die Tasse"), explain = "Preisfrage: Was kostet + Sache ?"), Exercise(id = "de-foundations-u22-geschenkidee-e4", kind = "written", prompt = "Sammle Ideen: frag, was Tim braucht.", options = listOf(), answers = listOf("was braucht tim", "was braucht er", "was braucht tim denn"), explain = "W-Frage: Was braucht Tim ?")), skills = listOf("function:go-shopping", "vocab:social-expressions", "grammar:present-questions", "grammar:present-simple"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u22-gratulieren", title = "Alles Gute !", goal = "Gratulieren und wünschen: Alles Gute, Herzlichen Glückwunsch — und die Freude zeigen.", intro = LessonIntro(explanation = listOf("Der Geburtstagswunsch: « Alles Gute zum Geburtstag ! » oder « Herzlichen Glückwunsch ! » — beides klingt immer richtig.", "Wünschen mit ich wünsche dir: « Ich wünsche dir viel Glück und Gesundheit. » — dir ist Dativ.", "Freude zeigen: « Ich freue mich ! », « Danke, das ist lieb von dir ! » — so bedankst du dich für Geschenke."), examples = listOf(ExampleLine(text = "Alles Gute zum Geburtstag !", meaning = "Der Klassiker unter den Wünschen."), ExampleLine(text = "Herzlichen Glückwunsch !", meaning = "Für Feste und Erfolge."), ExampleLine(text = "Ich wünsche dir viel Glück.", meaning = "Der Wunsch mit wünschen + Dativ."), ExampleLine(text = "Danke, das ist lieb von dir !", meaning = "Sich für ein Geschenk bedanken."), ExampleLine(text = "Ich freue mich sehr !", meaning = "Die Freude zeigen."))), expressions = listOf(TargetExpression(text = "Alles Gute zum Geburtstag !", meaning = "Gratulieren.", note = "kurz und immer richtig"), TargetExpression(text = "Herzlichen Glückwunsch !", meaning = "Glückwunsch für Erfolge.", note = "auch: zur Prüfung, zum Kind"), TargetExpression(text = "Ich wünsche dir …", meaning = "Wünsche sagen.", note = "… viel Glück und Gesundheit."), TargetExpression(text = "Viel Glück ! / Viel Spaß !", meaning = "Kurze Wünsche.", note = "Viel Spaß bei der Party !"), TargetExpression(text = "Das ist lieb von dir !", meaning = "Sich bedanken.", note = "Danke, das ist lieb !")), situation = "Tim öffnet die Tür — und alle rufen « Überraschung ! » Lea gratuliert, Mira schenkt die Tasse. Tim freut sich: « Das ist lieb von euch ! »", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Gratuliere Tim zum Geburtstag.", expected = listOf("Alles Gute zum Geburtstag.", "alles gute zum geburtstag", "Herzlichen Glückwunsch zum Geburtstag.", "Herzlichen Glueckwunsch zum Geburtstag."), focus = "alles gute", watch = "Der Standardwunsch: Alles Gute zum Geburtstag !"), PracticeQuestion(prompt = "Wünsch ihm viel Glück und Gesundheit.", expected = listOf("Ich wünsche dir viel Glück und Gesundheit.", "ich wünsche dir viel glück und gesundheit", "ich wünsche dir viel glueck und gesundheit"), focus = "ich wünsche", watch = "wünschen + Dativ: ich wünsche dir."), PracticeQuestion(prompt = "Bedanke dich für die Tasse — das Geschenk ist lieb.", expected = listOf("Danke, das ist lieb von dir.", "danke das ist lieb von dir", "Danke, das ist lieb von euch."), focus = "lieb von dir", watch = "Dank für Geschenke: das ist lieb von dir."), PracticeQuestion(prompt = "Sag, dass du dich sehr freust.", expected = listOf("Ich freue mich sehr.", "ich freue mich sehr", "Ich freue mich !"), focus = "ich freue mich", watch = "sich freuen: die Freude zeigen."), PracticeQuestion(prompt = "Wünsch ihm Spaß bei der Party.", expected = listOf("Viel Spaß bei der Party.", "viel spaß bei der party", "viel spass bei der party"), focus = "viel spaß", watch = "Viel + Nomen: der Kurz-Wunsch."))), exercises = listOf(Exercise(id = "de-foundations-u22-gratulieren-e1", kind = "choice", prompt = "« ___ Gute zum Geburtstag ! »", options = listOf("Alles", "Alle", "Ganz", "Viel"), answers = listOf("Alles"), explain = "Der feste Wunsch: Alles Gute zum Geburtstag !"), Exercise(id = "de-foundations-u22-gratulieren-e2", kind = "gap", prompt = "Ich wünsche ___ viel Glück.", options = listOf(), answers = listOf("dir"), explain = "wünschen + Dativ: ich wünsche dir."), Exercise(id = "de-foundations-u22-gratulieren-e3", kind = "order", prompt = "Gratuliere herzlich zur bestandenen Prüfung.", options = listOf(), answers = listOf("Herzlichen Glückwunsch zur Prüfung"), explain = "Herzlichen Glückwunsch + Anlass."), Exercise(id = "de-foundations-u22-gratulieren-e4", kind = "written", prompt = "Bedanke dich für ein Geschenk.", options = listOf(), answers = listOf("danke das ist lieb von dir", "danke das ist lieb von euch", "vielen dank für das geschenk", "vielen dank fur das geschenk"), explain = "Dank für Geschenke: Das ist lieb von dir !")), skills = listOf("vocab:social-expressions", "function:make-suggestions", "grammar:present-simple", "vocab:feelings"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple"))))
}

object DeFoundationsU23 {
    val unit = CourseUnit(id = "de-foundations-u23", title = "Kleidung und Größen", subtitle = "Im Geschäft", level = "A1", themes = listOf(ConversationTheme("im-laden", "Im Laden", "Welche Größe ?", "tshirt", "Course", "Anna sucht ein T-Shirt in Größe M: Haben Sie das in Blau ? Und wo ist die Umkleide ?", 0),
                ConversationTheme("an-der-kasse", "An der Kasse", "Zahlen, bitte", "bag", "Course", "Die Tasche gefällt dir — aber 80 Euro ? An der Kasse: bar oder mit Karte ? Und die Quittung nicht vergessen.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u23-laden", title = "Welche Größe ?", goal = "Im Kleiderladen einkaufen: Größe und Farbe fragen — ich suche, haben Sie … ?", intro = LessonIntro(explanation = listOf("Sagen, was du suchst: « Ich suche ein T-Shirt. », « Ich suche eine Hose in Größe M. » — ein/eine passt sich dem Nomen an.", "Im Laden fragen: « Haben Sie das auch in Blau ? », « Welche Größe haben Sie ? » — so fragt auch die Verkäuferin.", "Mengen und Preise: « Ich nehme zwei T-Shirts. », « Wie viel kostet die Hose ? »"), examples = listOf(ExampleLine(text = "Ich suche ein T-Shirt.", meaning = "Suchen mit ein/eine + Nomen."), ExampleLine(text = "Welche Größe haben Sie ?", meaning = "Die Größe erfragen."), ExampleLine(text = "Haben Sie das auch in Blau ?", meaning = "Nach Farben fragen."), ExampleLine(text = "Ich nehme zwei T-Shirts.", meaning = "Mehrere Sachen kaufen."), ExampleLine(text = "Wie viel kostet die Hose ?", meaning = "Nach dem Preis fragen."))), expressions = listOf(TargetExpression(text = "Ich suche …", meaning = "Sagen, was du willst.", note = "Ich suche eine Jacke."), TargetExpression(text = "Welche Größe … ?", meaning = "Die Größe fragen.", note = "Welche Größe haben Sie ?"), TargetExpression(text = "Größe S / M / L", meaning = "Die Kleidergrößen.", note = "Ich trage Größe M."), TargetExpression(text = "Haben Sie das in Blau ?", meaning = "Farbe und Modell fragen.", note = "auch: in Rot, in Weiß"), TargetExpression(text = "Wie viel kostet … ?", meaning = "Der Preis.", note = "Wie viel kostet das ?")), situation = "Anna steht im Laden und sucht ein T-Shirt für die Party. Die Verkäuferin fragt nach der Größe — M, blau — und zeigt ihr drei Modelle. « Wie viel kostet das ? »", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sag, was du suchst: ein T-Shirt.", expected = listOf("Ich suche ein T-Shirt.", "ich suche ein t-shirt", "Ich suche ein blaues T-Shirt."), focus = "ich suche", watch = "suchen + ein/eine + Nomen."), PracticeQuestion(prompt = "Die Verkäuferin fragt dich: welche Größe ? Schreib ihre Frage.", expected = listOf("Welche Größe haben Sie ?", "welche größe haben sie", "welche groesse haben sie", "Welche Größe brauchen Sie ?"), focus = "welche größe", watch = "Welche Größe + haben/brauchen."), PracticeQuestion(prompt = "Frag, ob es das T-Shirt auch in Blau gibt.", expected = listOf("Haben Sie das auch in Blau ?", "haben sie das auch in blau", "Gibt es das auch in Blau ?"), focus = "haben sie", watch = "Haben Sie das in + Farbe ?"), PracticeQuestion(prompt = "Kauf zwei T-Shirts.", expected = listOf("Ich nehme zwei T-Shirts.", "ich nehme zwei t-shirts", "Ich nehme die zwei T-Shirts."), focus = "ich nehme", watch = "nehmen = kaufen, am Ladentisch."), PracticeQuestion(prompt = "Frag nach dem Preis der Hose.", expected = listOf("Wie viel kostet die Hose ?", "wie viel kostet die hose", "Was kostet die Hose ?"), focus = "wie viel", watch = "Wie viel kostet + Singular."))), exercises = listOf(Exercise(id = "de-foundations-u23-laden-e1", kind = "choice", prompt = "« Ich ___ eine Jacke in Größe M. »", options = listOf("suche", "suchst", "sucht", "suchen"), answers = listOf("suche"), explain = "ich suche: sagen, was du suchst."), Exercise(id = "de-foundations-u23-laden-e2", kind = "gap", prompt = "Ich nehme ___ T-Shirts. (2)", options = listOf(), answers = listOf("zwei"), explain = "Mengen: zwei T-Shirts."), Exercise(id = "de-foundations-u23-laden-e3", kind = "order", prompt = "Frag im Laden nach der Größe des Kunden.", options = listOf(), answers = listOf("Welche Größe haben Sie"), explain = "Welche Größe haben Sie ? — die Frage im Laden."), Exercise(id = "de-foundations-u23-laden-e4", kind = "written", prompt = "Frag nach dem Preis vom T-Shirt.", options = listOf(), answers = listOf("wie viel kostet das t-shirt", "was kostet das t-shirt", "wie viel kostet das t shirt"), explain = "Wie viel kostet … ? — die Preisfrage.")), skills = listOf("function:go-shopping", "vocab:shopping", "grammar:quantities", "grammar:present-simple"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u23-umkleide", title = "In der Umkleide", goal = "Anprobieren mit kann: Kann ich das anprobieren ? — und sagen, ob es passt.", intro = LessonIntro(explanation = listOf("Anprobieren mit kann: « Kann ich das anprobieren ? » — damit öffnest du dir die Umkleide.", "Passt es ? Drei Antworten: « Es passt gut. », « Es ist zu groß. », « Es ist zu klein. »", "Höflich bitten: « Können Sie mir Größe L bringen ? » — können + Sie bleibt immer freundlich."), examples = listOf(ExampleLine(text = "Kann ich das anprobieren ?", meaning = "Die Bitte an der Umkleide."), ExampleLine(text = "Wo ist die Umkleide ?", meaning = "Den Ort fragen."), ExampleLine(text = "Es passt gut !", meaning = "Die Jacke sitzt."), ExampleLine(text = "Die Hose ist zu klein.", meaning = "Zu eng, zu kurz, zu weit."), ExampleLine(text = "Können Sie mir Größe L bringen ?", meaning = "Die Bitte an die Verkäuferin."))), expressions = listOf(TargetExpression(text = "Kann ich … anprobieren ?", meaning = "Anprobieren fragen.", note = "Kann ich die Jacke anprobieren ?"), TargetExpression(text = "Wo ist die Umkleide ?", meaning = "Den Ort fragen.", note = "die Kabine im Geschäft"), TargetExpression(text = "Es passt (gut).", meaning = "Die richtige Größe.", note = "Der Pulli passt perfekt."), TargetExpression(text = "zu groß / zu klein / zu eng", meaning = "Passt nicht.", note = "Die Jacke ist zu eng."), TargetExpression(text = "Können Sie mir … bringen ?", meaning = "Höflich bitten.", note = "… eine andere Größe bringen ?")), situation = "Anna probiert das blaue T-Shirt an: zu eng. « Kann ich Größe L probieren ? » — Die Verkäuferin bringt es. « Und, passt es ? » — « Ja, jetzt passt es gut ! »", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Frag höflich, ob du die Jacke anprobieren kannst.", expected = listOf("Kann ich die Jacke anprobieren ?", "kann ich die jacke anprobieren", "Darf ich die Jacke anprobieren ?"), focus = "kann ich", watch = "Kann ich + anprobieren ?"), PracticeQuestion(prompt = "Frag, wo die Umkleide ist.", expected = listOf("Wo ist die Umkleide ?", "wo ist die umkleide", "Wo sind die Umkleiden ?"), focus = "wo ist", watch = "Wo ist + Ort ?"), PracticeQuestion(prompt = "Die Hose ist zu klein. Sag es der Verkäuferin.", expected = listOf("Die Hose ist zu klein.", "die hose ist zu klein", "Sie ist zu klein."), focus = "zu klein", watch = "zu + Adjektiv = passt nicht."), PracticeQuestion(prompt = "Bitte um Größe L.", expected = listOf("Können Sie mir Größe L bringen ?", "können sie mir größe l bringen", "können sie mir groesse l bringen", "Haben Sie Größe L ?"), focus = "können sie", watch = "Können Sie mir … ? = Bitte im Laden."), PracticeQuestion(prompt = "Sag: die Jacke sitzt perfekt.", expected = listOf("Die Jacke passt perfekt.", "die jacke passt perfekt", "Es passt perfekt."), focus = "passt", watch = "passen = die richtige Größe."))), exercises = listOf(Exercise(id = "de-foundations-u23-umkleide-e1", kind = "choice", prompt = "« Kann ich die Jacke ___ ? » (probieren)", options = listOf("anprobieren", "probieren", "ausprobieren an", "probieren an"), answers = listOf("anprobieren"), explain = "trennbar: anprobieren — ich probiere … an."), Exercise(id = "de-foundations-u23-umkleide-e2", kind = "gap", prompt = "Die Schuhe ___ nicht. (falsche Größe)", options = listOf(), answers = listOf("passen"), explain = "passen + nicht: die falsche Größe."), Exercise(id = "de-foundations-u23-umkleide-e3", kind = "order", prompt = "Bitte die Verkäuferin um eine andere Größe.", options = listOf(), answers = listOf("Können Sie mir eine andere Größe bringen"), explain = "Höfliche Bitte: Können Sie mir … bringen ?"), Exercise(id = "de-foundations-u23-umkleide-e4", kind = "written", prompt = "Sag mit zu, warum die Hose nicht passt.", options = listOf(), answers = listOf("die hose ist zu eng", "sie ist zu eng", "die hose ist zu klein"), explain = "zu + Adjektiv: Die Hose ist zu eng.")), skills = listOf("function:make-requests", "function:go-shopping", "grammar:can", "vocab:shopping"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:can")),
    Lesson(id = "de-foundations-u23-kasse", title = "Zu teuer ?", goal = "An der Kasse zahlen und über Preise reden: Wie viel … ? — Das ist zu teuer.", intro = LessonIntro(explanation = listOf("Über Preise reden: « Wie viel kostet das ? », « 80 Euro ? Das ist zu teuer ! » — zu + Adjektiv zeigt dein Gefühl.", "Nach Rabatt fragen: « Ist das im Angebot ? » — im Angebot heißt: gerade billiger.", "Zahlen: « Ich zahle mit Karte. », « Bar, bitte. » — und: « Die Quittung, bitte ! »"), examples = listOf(ExampleLine(text = "Das ist zu teuer.", meaning = "80 Euro ? Nein !"), ExampleLine(text = "Ist das im Angebot ?", meaning = "Nach Rabatt fragen."), ExampleLine(text = "Ich nehme es trotzdem.", meaning = "Trotzdem kaufen."), ExampleLine(text = "Bar oder mit Karte ?", meaning = "Die Frage an der Kasse."), ExampleLine(text = "Die Quittung, bitte.", meaning = "Den Beleg nicht vergessen."))), expressions = listOf(TargetExpression(text = "zu teuer / zu billig", meaning = "Preis-Gefühl.", note = "Das T-Shirt ist zu teuer."), TargetExpression(text = "Ist das im Angebot ?", meaning = "Nach Rabatt fragen.", note = "im Angebot = gerade billiger"), TargetExpression(text = "Ich nehme es.", meaning = "Entscheiden.", note = "Ich nehme die Tasche."), TargetExpression(text = "Bar oder mit Karte ?", meaning = "Bezahlen.", note = "Ich zahle bar, bitte."), TargetExpression(text = "Die Quittung, bitte.", meaning = "Beleg verlangen.", note = "brauchst du für den Umtausch")), situation = "Die Tasche kostet 80 Euro — zu teuer, findet Anna. « Ist sie im Angebot ? » Nein, aber sie gefällt ihr. An der Kasse zahlt sie mit Karte und nimmt die Quittung mit.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sag: 80 Euro sind zu teuer.", expected = listOf("Das ist zu teuer.", "das ist zu teuer", "80 Euro ? Das ist zu teuer !"), focus = "zu teuer", watch = "zu + Adjektiv = dein Gefühl zum Preis."), PracticeQuestion(prompt = "Frag, ob die Tasche im Angebot ist.", expected = listOf("Ist die Tasche im Angebot ?", "ist die tasche im angebot", "Ist das im Angebot ?"), focus = "im angebot", watch = "im Angebot = gerade billiger."), PracticeQuestion(prompt = "Entscheide dich: du nimmst die Tasche.", expected = listOf("Ich nehme die Tasche.", "ich nehme die tasche", "Ich nehme es."), focus = "ich nehme", watch = "nehmen = kaufen."), PracticeQuestion(prompt = "Die Kassiererin fragt: bar oder Karte ? Antworte: Karte.", expected = listOf("Mit Karte, bitte.", "mit karte bitte", "Ich zahle mit Karte."), focus = "mit karte", watch = "mit Karte oder bar."), PracticeQuestion(prompt = "Verlang die Quittung.", expected = listOf("Die Quittung, bitte.", "die quittung bitte", "Kann ich die Quittung haben ?"), focus = "quittung", watch = "Die Quittung brauchst du für den Umtausch."))), exercises = listOf(Exercise(id = "de-foundations-u23-kasse-e1", kind = "choice", prompt = "« 100 Euro für eine Tasche ? Das ist zu ___ ! »", options = listOf("teuer", "teure", "kostet", "zahlen"), answers = listOf("teuer"), explain = "zu teuer = der Preis ist zu hoch."), Exercise(id = "de-foundations-u23-kasse-e2", kind = "gap", prompt = "Ich zahle ___. (keine Karte)", options = listOf(), answers = listOf("bar"), explain = "bar zahlen = mit Geld."), Exercise(id = "de-foundations-u23-kasse-e3", kind = "order", prompt = "Verlang an der Kasse den Beleg.", options = listOf(), answers = listOf("Die Quittung bitte"), explain = "Die Quittung, bitte ! — der Beleg."), Exercise(id = "de-foundations-u23-kasse-e4", kind = "written", prompt = "Frag, ob der Pullover im Angebot ist.", options = listOf(), answers = listOf("ist der pullover im angebot", "ist der pulli im angebot", "ist das im angebot"), explain = "im Angebot = gerade billiger: Ist das im Angebot ?")), skills = listOf("function:go-shopping", "grammar:quantities", "vocab:shopping", "vocab:social-expressions"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple"))))
}

object DeFoundationsU27 {
    val unit = CourseUnit(id = "de-foundations-u27", title = "Freizeit", subtitle = "Hobbys und Wochenende", level = "A1", themes = listOf(ConversationTheme("das-hobby", "Das Hobby", "Was du gern machst", "book", "Course", "Lena erzählt, was sie in ihrer Freizeit macht: Gitarre, Krimis, Kaffee mit Freunden — und was sie gar nicht gern macht.", 0),
                ConversationTheme("das-wochenende", "Das Wochenende", "Pläne für Samstag und Sonntag", "figure.walk", "Course", "Freitagabend: Was machen wir am Wochenende ? Lena und Ben planen ihr Wochenende — mit Fahrrad, See und einem faulen Sonntag.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u27-hobbys", title = "Ich spiele gern Gitarre", goal = "Über Hobbys reden: Ich spiele gern Gitarre — sag, was du gern machst und was nicht.", intro = LessonIntro(explanation = listOf("gern steht nach dem Verb: « Ich spiele gern Gitarre. », « Ich lese gern. » — so sagst du, was du magst.", "Fragen mit was: « Was machst du gern ? » — das Verb an Position 2: du machst.", "Das Gegenteil: « Ich koche nicht gern. » — nicht gern heißt höflich: nein, danke."), examples = listOf(ExampleLine(text = "Ich spiele gern Gitarre.", meaning = "gern + Verb: die Lieblingssache."), ExampleLine(text = "Ich lese gern Bücher.", meaning = "lesen + gern."), ExampleLine(text = "Was machst du in deiner Freizeit ?", meaning = "Die Frage nach dem Hobby."), ExampleLine(text = "Ich schwimme nicht gern.", meaning = "nicht gern: das höfliche Nein."), ExampleLine(text = "Er hört gern Musik.", meaning = "hören → er hört: er/sie/es + t."))), expressions = listOf(TargetExpression(text = "gern + Verb", meaning = "Sagen, was du magst.", note = "Ich schwimme gern."), TargetExpression(text = "in meiner Freizeit", meaning = "Wenn du nicht arbeitest.", note = "In meiner Freizeit lese ich."), TargetExpression(text = "Was machst du gern ?", meaning = "Nach dem Hobby fragen.", note = "— Ich koche gern !"), TargetExpression(text = "nicht gern", meaning = "Sagen, was du nicht magst.", note = "Ich fahre nicht gern Bus."), TargetExpression(text = "das Hobby, die Hobbys", meaning = "Die Sache, die du in der Freizeit liebst.", note = "Gitarre ist mein Hobby.")), situation = "Lena trifft Ben im Park. « Was machst du in deiner Freizeit ? » — « Ich spiele gern Gitarre und lese gern. Und du ? » — « Ich koche nicht gern, aber ich laufe gern. » — « Dann gehen wir zusammen laufen ! »", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sag, dass du gern Gitarre spielst.", expected = listOf("Ich spiele gern Gitarre.", "ich spiele gern gitarre"), focus = "spiele gern", watch = "gern steht nach dem Verb: spiele gern."), PracticeQuestion(prompt = "Frag Lena, was sie gern macht.", expected = listOf("Was machst du gern ?", "was machst du gern", "Was machst du in deiner Freizeit ?"), focus = "was machst du", watch = "W-Frage: das Verb an Position 2 — machst."), PracticeQuestion(prompt = "Sag, dass du gern Bücher liest.", expected = listOf("Ich lese gern Bücher.", "ich lese gern bücher", "ich lese gern buecher"), focus = "lese gern", watch = "ich lese + gern."), PracticeQuestion(prompt = "Sag höflich: Kochen ist nichts für dich.", expected = listOf("Ich koche nicht gern.", "ich koche nicht gern", "Ich koche nicht so gern."), focus = "nicht gern", watch = "nicht steht vor gern: koche nicht gern."), PracticeQuestion(prompt = "Frag, was Ben in seiner Freizeit macht.", expected = listOf("Was machst du in deiner Freizeit ?", "was machst du in deiner freizeit", "Was machst du gern ?"), focus = "freizeit", watch = "in deiner Freizeit = nach der Arbeit oder Schule."))), exercises = listOf(Exercise(id = "de-foundations-u27-hobbys-e1", kind = "choice", prompt = "« Ich spiele ___ Gitarre. »", options = listOf("gern", "gut", "oft", "immer"), answers = listOf("gern"), explain = "gern nach dem Verb: ich spiele gern."), Exercise(id = "de-foundations-u27-hobbys-e2", kind = "gap", prompt = "Er ___ gern Musik. (hören, er-Form)", options = listOf(), answers = listOf("hört", "hoert"), explain = "hören → er hört: aus dem Stamm + t."), Exercise(id = "de-foundations-u27-hobbys-e3", kind = "order", prompt = "Frag Lena nach ihrem Hobby.", options = listOf(), answers = listOf("Was machst du gern"), explain = "Die W-Frage: Was + machst + du + gern ?"), Exercise(id = "de-foundations-u27-hobbys-e4", kind = "written", prompt = "Sag, dass du nicht gern schwimmst.", options = listOf(), answers = listOf("ich schwimme nicht gern", "ich schwimme nicht so gern"), explain = "nicht gern: das höfliche Nein beim Sport.")), skills = listOf("grammar:present-simple", "vocab:hobbies", "function:ask-simple-questions", "grammar:frequency-adverbs"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u27-wochenende", title = "Was machst du am Wochenende ?", goal = "Wochenendpläne im Präsens: Am Samstag fahre ich an den See — frag und erzähl, was du machst.", intro = LessonIntro(explanation = listOf("Zeit vorne, Verb an Position 2: « Am Samstag fahre ich an den See. » — so planst du laut.", "am + Tag: « am Samstag », « am Sonntag », « am Wochenende » — auch am Morgen, am Abend.", "Achtung Vokalwechsel: « Du fährst schnell ! » — fahren → du fährst, er fährt; lesen → du liest."), examples = listOf(ExampleLine(text = "Am Samstag fahre ich an den See.", meaning = "Zeit an Position 1, Verb an Position 2."), ExampleLine(text = "Was machst du am Wochenende ?", meaning = "Die Wochenendfrage."), ExampleLine(text = "Am Sonntag schlafe ich lange.", meaning = "Ausschlafen im Präsens."), ExampleLine(text = "Du fährst mit dem Fahrrad.", meaning = "fahren → du fährst: der Vokalwechsel."), ExampleLine(text = "Wir treffen uns um zehn.", meaning = "Wir-Pläne: sich treffen."))), expressions = listOf(TargetExpression(text = "am Samstag / am Sonntag", meaning = "Der Tag + am.", note = "Am Samstag backe ich Kuchen."), TargetExpression(text = "am Wochenende", meaning = "Samstag und Sonntag zusammen.", note = "Was machst du am Wochenende ?"), TargetExpression(text = "lange schlafen", meaning = "Ausschlafen am Sonntag.", note = "Ich schlafe am Sonntag lange."), TargetExpression(text = "Wir treffen uns …", meaning = "Pläne mit Freunden.", note = "Wir treffen uns am See."), TargetExpression(text = "fahren → du fährst", meaning = "Der Vokalwechsel a → ä.", note = "Du fährst schnell !")), situation = "Freitagabend: Lena und Ben planen das Wochenende. « Am Samstag fahre ich an den See — kommst du mit ? » — « Gerne ! Ich hole das Fahrrad. Am Sonntag schlafe ich dann lange. » — « Perfekt, wir treffen uns um zehn ! »", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sag deinen Plan: Samstag, an den See fahren.", expected = listOf("Am Samstag fahre ich an den See.", "am samstag fahre ich an den see"), focus = "am samstag", watch = "Zeit an Position 1, Verb an Position 2."), PracticeQuestion(prompt = "Frag Ben nach seinem Wochenende.", expected = listOf("Was machst du am Wochenende ?", "was machst du am wochenende"), focus = "wochenende", watch = "am Wochenende = Samstag + Sonntag."), PracticeQuestion(prompt = "Sag mit du: mit dem Fahrrad fahren.", expected = listOf("Du fährst mit dem Fahrrad.", "du fährst mit dem fahrrad", "du faehrst mit dem fahrrad", "Du fährst mit dem Rad."), focus = "du fährst", watch = "fahren → du fährst mit ä."), PracticeQuestion(prompt = "Schlag vor: ihr trefft euch um zehn.", expected = listOf("Wir treffen uns um zehn.", "wir treffen uns um zehn"), focus = "wir treffen", watch = "sich treffen: Wir treffen uns."), PracticeQuestion(prompt = "Sag: Sonntag, lange schlafen.", expected = listOf("Am Sonntag schlafe ich lange.", "am sonntag schlafe ich lange", "Ich schlafe am Sonntag lange."), focus = "schlafe lange", watch = "schlafen → ich schlafe."))), exercises = listOf(Exercise(id = "de-foundations-u27-wochenende-e1", kind = "choice", prompt = "« Am Sonntag ___ ich lange. »", options = listOf("schlafe", "schlafst", "schlafen", "schläfst"), answers = listOf("schlafe"), explain = "ich schlafe: aus schlafen wird schlafe."), Exercise(id = "de-foundations-u27-wochenende-e2", kind = "gap", prompt = "Du ___ mit dem Fahrrad. (fahren, du-Form)", options = listOf(), answers = listOf("fährst", "faehrst"), explain = "fahren → du fährst: der Vokalwechsel a → ä."), Exercise(id = "de-foundations-u27-wochenende-e3", kind = "order", prompt = "Sag deinen Samstag-Plan mit dem See.", options = listOf(), answers = listOf("Am Samstag fahre ich an den See"), explain = "Zeit an Position 1 (Am Samstag), Verb an Position 2, Ziel am Ende."), Exercise(id = "de-foundations-u27-wochenende-e4", kind = "written", prompt = "Frag, was jemand am Wochenende macht.", options = listOf(), answers = listOf("was machst du am wochenende", "was hast du am wochenende vor"), explain = "Die Wochenendfrage: was + machst du + am Wochenende ?")), skills = listOf("grammar:time-expressions", "grammar:present-simple", "function:talk-about-routines", "vocab:hobbies"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:time-expressions"))))
}

object DeFoundationsU3 {
    val unit = CourseUnit(id = "de-foundations-u3", title = "Die Vergangenheit", subtitle = "Was hast du gemacht ?", level = "A2", themes = listOf(ConversationTheme("wochenende-vergangen", "Das vergangene Wochenende", "Perfekt", "clock.arrow.circlepath", "Course", "Ihr erzählt euer Wochenende: Ausflüge, Essen, Begegnungen — im Perfekt.", 0),
                ConversationTheme("reise-erinnern", "Die Reise letzten Sommer", "Erinnerungen", "airplane", "Course", "Eine unvergessliche Reise: wohin, was gesehen, mit wem.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u3-perfekt", title = "Das Perfekt", goal = "Abgeschlossene Handlungen mit haben/sein + Partizip II erzählen.", intro = LessonIntro(explanation = listOf("Das Perfekt = haben oder sein + Partizip II. „Ich habe gegessen. Sie ist gefahren.“", "Die meisten Verben benutzen haben. Bewegungsverben (gehen, fahren, fliegen) benutzen sein.", "Regelmäßiges Partizip: ge- + Stamm + -t (gemacht, gespielt). Unregelmäßig: gegessen, gesehen, getrunken."), examples = listOf(ExampleLine(text = "Ich habe eine Paella gegessen.", meaning = "haben + gegessen."), ExampleLine(text = "Sie ist ins Kino gegangen.", meaning = "sein + gegangen."), ExampleLine(text = "Wir haben einen Film gesehen.", meaning = "haben + gesehen."), ExampleLine(text = "Er ist früh angekommen.", meaning = "sein + angekommen."), ExampleLine(text = "Hast du deine Hausaufgaben gemacht ?", meaning = "haben + Partizip in der Frage."))), expressions = listOf(TargetExpression(text = "ich habe / du hast + Partizip", meaning = "haben + Partizip II.", note = "Ich habe gegessen."), TargetExpression(text = "ich bin / sie ist + Partizip", meaning = "sein für Bewegung.", note = "Ich bin gefahren."), TargetExpression(text = "gemacht / gesagt / gesehen", meaning = "Partizip II Formen.", note = "machen → gemacht."), TargetExpression(text = "gegangen / gefahren / gegessen", meaning = "Unregelmäßig.", note = "gehen → gegangen."), TargetExpression(text = "gestern / letzte Woche", meaning = "Zeitangaben.", note = "Gestern habe ich…")), situation = "Ihr erzählt euer Wochenende: was ihr gemacht habt, mit wem, und eine Überraschung.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sag eine Handlung vom Wochenende. (essen im Restaurant)", expected = listOf("Ich habe im Restaurant gegessen."), focus = "haben + pp", watch = "Ich habe gegessen — abgeschlossen."), PracticeQuestion(prompt = "Sag, wohin du gegangen bist. (der Park)", expected = listOf("Ich bin in den Park gegangen."), focus = "sein + pp", watch = "gehen nimmt sein."), PracticeQuestion(prompt = "Frag deinen Freund, was er gemacht hat.", expected = listOf("Was hast du gemacht ?"), focus = "hast + pp", watch = "Was hast du gemacht ?"), PracticeQuestion(prompt = "Sag, dass du einen Fehler gemacht hast.", expected = listOf("Ich habe einen Fehler gemacht."), focus = "machen → gemacht", watch = "haben + gemacht."), PracticeQuestion(prompt = "Sag, wann: gestern Abend.", expected = listOf("Gestern Abend habe ich einen Film gesehen."), focus = "gestern Abend", watch = "Zeitangabe + Perfekt."))), exercises = listOf(Exercise(id = "de-foundations-u3-perfekt-e1", kind = "choice", prompt = "Ich ___ einen Film gesehen.", options = listOf("habe", "bin", "hat", "war"), answers = listOf("habe"), explain = "sehen nimmt haben: ich habe gesehen."), Exercise(id = "de-foundations-u3-perfekt-e2", kind = "gap", prompt = "Sie ___ ins Kino ___. (gehen)", options = listOf(), answers = listOf("ist gegangen"), explain = "sein + gegangen."), Exercise(id = "de-foundations-u3-perfekt-e3", kind = "order", prompt = "Frag das Wochenende.", options = listOf(), answers = listOf("Was hast du am Wochenende gemacht"), explain = "Was + hast + du + Partizip ?"), Exercise(id = "de-foundations-u3-perfekt-e4", kind = "written", prompt = "Sag, dass du einen Fehler gemacht hast.", options = listOf(), answers = listOf("ich habe einen fehler gemacht", "ich habe einen fehler gemacht"), explain = "haben + gemacht.")), skills = listOf("grammar:past-simple-regular", "grammar:past-simple-irregular", "grammar:time-expressions", "function:describe-past-events"), canDo = listOf("describe-past-events"), prerequisites = listOf("grammar:past-simple-regular"))))
}

object DeFoundationsU4 {
    val unit = CourseUnit(id = "de-foundations-u4", title = "Vergleichen und Pläne", subtitle = "Größer, günstiger, morgen", level = "A2", themes = listOf(ConversationTheme("zwei-wohnungen", "Zwei Wohnungen", "Welche nehmen ?", "house", "Course", "Ihr vergleicht zwei Wohnungen: Miete, Größe, Lage — und entscheidet euch.", 0),
                ConversationTheme("urlaubsplaene", "Urlaubspläne", "Wohin gehen wir ?", "airplane", "Course", "Ihr plant den Urlaub mit werden + Infinitiv oder Präsens + Zeitangabe.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u4-komparativ", title = "Komparativ und Superlativ", goal = "Vergleichen mit größer als, am größten, so groß wie.", intro = LessonIntro(explanation = listOf("Komparativ: Adjektivstamm + -er + als. „Dieser Computer ist schneller als der alte.“", "Superlativ: am + Adjektivstamm + -sten. „Das ist am schnellsten.“", "Unregelmäßig: gut → besser → am besten, viel → mehr → am meisten."), examples = listOf(ExampleLine(text = "Dieser Computer ist schneller als der alte.", meaning = "schnell → schneller + als."), ExampleLine(text = "Das ist das beste Restaurant der Stadt.", meaning = "gut → das beste."), ExampleLine(text = "Berlin ist größer als München.", meaning = "groß → größer."), ExampleLine(text = "Es ist am schönsten im Sommer.", meaning = "am + Superlativ."), ExampleLine(text = "So teuer wie letzte Jahr.", meaning = "so + adj + wie = Gleichheit."))), expressions = listOf(TargetExpression(text = "größer / kleiner als", meaning = "Komparativ.", note = "größer + als."), TargetExpression(text = "am besten / am schönsten", meaning = "Superlativ.", note = "am + -sten."), TargetExpression(text = "besser / mehr", meaning = "Unregelmäßig.", note = "gut → besser."), TargetExpression(text = "so … wie", meaning = "Gleichheit.", note = "so groß wie ich."), TargetExpression(text = "viel / mehr / am meisten", meaning = "Mengenvergleich.", note = "mehr als erwartet.")), situation = "Ihr vergleicht zwei Wohnungen: Miete, Größe, Lage — und wählt die beste.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Vergleiche den Preis: A 800€, B 1000€.", expected = listOf("Wohnung A ist billiger als Wohnung B."), focus = "billiger als", watch = "billig → billiger + als."), PracticeQuestion(prompt = "Sag, welche die beste ist. (B)", expected = listOf("Wohnung B ist die beste."), focus = "die beste", watch = "Superlativ mit die."), PracticeQuestion(prompt = "Sag, dass sie gleich groß sind.", expected = listOf("Sie sind so groß wie die andere."), focus = "so wie", watch = "so + adj + wie = Gleichheit."), PracticeQuestion(prompt = "Wähle und begründe. (B, größer)", expected = listOf("Ich nehme B, weil sie größer ist."), focus = "weil", watch = "weil + Satzbau mit Verb am Ende."), PracticeQuestion(prompt = "Vergleiche die Größe: A 60m², B 80m².", expected = listOf("B ist größer als A."), focus = "größer als", watch = "größer + als."))), exercises = listOf(Exercise(id = "de-foundations-u4-komparativ-e1", kind = "choice", prompt = "Berlin ist ___ ___ München.", options = listOf("größer als", "groß als", "so groß wie", "am größten"), answers = listOf("größer als"), explain = "Komparativ + als."), Exercise(id = "de-foundations-u4-komparativ-e2", kind = "gap", prompt = "Das ist das ___ Restaurant. (gut)", options = listOf(), answers = listOf("beste"), explain = "gut → das beste."), Exercise(id = "de-foundations-u4-komparativ-e3", kind = "order", prompt = "Vergleiche den Preis.", options = listOf(), answers = listOf("Wohnung A ist billiger als B"), explain = "Komparativ + als."), Exercise(id = "de-foundations-u4-komparativ-e4", kind = "written", prompt = "Dein Lieblingsrestaurant.", options = listOf(), answers = listOf("mein lieblingsrestaurant ist <name>", "das beste ist <name>"), explain = "Mein Liebling ist X.")), skills = listOf("grammar:comparatives", "grammar:superlatives", "grammar:connectors", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:comparatives"))))
}

object DeFoundationsU17 {
    val unit = CourseUnit(id = "de-foundations-u17", title = "Gut ausmachen", subtitle = "Pläne und Geschenke", level = "A2", themes = listOf(ConversationTheme("vorschlaege", "Vorschläge", "Kommst du oder lieber… ?", "calendar.badge.clock", "Course", "Ihr plant das Wochenende: Kino, Kochen, Spaziergang — wer schlägt was vor, wer sagt ab ?", 0),
                ConversationTheme("das-geschenk", "Das Geschenk", "Was wirst du schenken ?", "gift", "Course", "Emma hat bald Geburtstag. Ihr plant Geschenk und Party mit werden + Infinitiv.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u17-vorschlaege", title = "Kommst du oder lieber… ?", goal = "Vorschläge machen (Wollen wir… ?, Lust auf… ?) und Pläne mit werden antworten.", intro = LessonIntro(explanation = listOf("Vorschläge mit Wollen wir … ?: « Wollen wir am Samstag ins Kino gehen ? » Oder ganz locker: « Lust auf Pizza ? »", "Zwei Ideen stellt man mit oder lieber … ? gegenüber: « Kaffee oder lieber Tee ? » — so bietest du eine Alternative an.", "Antworten: « Gute idée ! » — nein: « Gute Idee ! » oder « Ja, gern ! ». Den eigenen Plan sagst du mit werden + Infinitiv: « Ich werde kochen. »"), examples = listOf(ExampleLine(text = "Wollen wir am Samstag ins Kino gehen ?", meaning = "Der Standard-Vorschlag."), ExampleLine(text = "Lust auf Pizza heute Abend ?", meaning = "Locker, unter Freunden."), ExampleLine(text = "Ins Kino oder lieber ins Café ?", meaning = "oder lieber = die Alternative."), ExampleLine(text = "Ich werde Salat machen.", meaning = "werden + Infinitiv am Ende."), ExampleLine(text = "Was wirst du mitbringen ?", meaning = "Nach dem Plan fragen."))), expressions = listOf(TargetExpression(text = "Wollen wir … ?", meaning = "Vorschlag.", note = "Wollen wir bowlen ?"), TargetExpression(text = "Lust auf … ?", meaning = "Locker fragen.", note = "Lust auf Eis ?"), TargetExpression(text = "oder lieber … ?", meaning = "Alternative anbieten.", note = "Kaffee oder lieber Tee ?"), TargetExpression(text = "Gute Idee !", meaning = "Zusagen.", note = "auch: Ja, gern !"), TargetExpression(text = "Ich werde … + Infinitiv", meaning = "Den Plan sagen.", note = "Ich werde kochen.")), situation = "Ihr plant den Samstag: zuerst Kino, dann Kochen. Am Ende steht der Plan — ihr werdet zusammen kochen und danach ins Kino gehen.", practice = LessonPractice(questions 