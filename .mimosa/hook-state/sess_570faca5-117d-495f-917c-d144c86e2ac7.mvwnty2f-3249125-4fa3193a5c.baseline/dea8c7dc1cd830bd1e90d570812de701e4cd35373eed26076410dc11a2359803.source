object EsFoundationsU17 {
    val unit = CourseUnit(id = "es-foundations-u17", title = "A la mesa", subtitle = "Comer fuera", level = "A1", themes = listOf(ConversationTheme("en-el-restaurante", "En el restaurante", "Pedir comida", "fork.knife", "Course", "Pedís mesa y comida: quieres, para mí… y preguntar qué hay.", 0),
                ConversationTheme("la-carta", "La carta", "Platos y la cuenta", "takeout.bag", "Course", "Miráis la carta, preguntáis qué lleva cada plato y pedís la cuenta.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u17-restaurante", title = "En el restaurante", goal = "Pedir en un restaurante: quiero…, para mí…, y preguntar qué hay.", intro = LessonIntro(explanation = listOf("Para pedir usamos querer: «Quiero una ensalada». Y para cortesía, por favor: «Un café, por favor».", "«Para mí…» marca tu plato cuando coméis en grupo: «Para mí, el pollo». «Para beber, un agua».", "Para preguntar qué hay: «¿Qué tiene de primero?». El camarero responde: «Tenemos paella y sopa»."), examples = listOf(ExampleLine(text = "Quiero una ensalada, por favor.", meaning = "Pedir tu plato."), ExampleLine(text = "Para mí, un bocadillo.", meaning = "Tu plato en grupo."), ExampleLine(text = "¿Qué tiene de segundo?", meaning = "Preguntar al camarero."), ExampleLine(text = "Tenemos pescado y pollo.", meaning = "El camarero responde."), ExampleLine(text = "¿Me trae el menú, por favor?", meaning = "Pedir la carta."), ExampleLine(text = "Quiero agua, por favor.", meaning = "Pedir una bebida."))), expressions = listOf(TargetExpression(text = "quiero + comida", meaning = "Pedir algo.", note = "Quiero una sopa."), TargetExpression(text = "para mí, …", meaning = "Tu pedido en grupo.", note = "Para mí, el pollo."), TargetExpression(text = "¿Qué tiene …?", meaning = "Preguntar qué hay.", note = "¿Qué tiene de postre?"), TargetExpression(text = "por favor", meaning = "Cortesía al pedir.", note = "Un café, por favor."), TargetExpression(text = "¿Me trae …?", meaning = "Pedir algo a la mesa.", note = "¿Me trae más pan?")), situation = "Estás en un restaurante con amigos: pides una ensalada, preguntas qué hay de segundo y pides más pan.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pide una ensalada con cortesía.", expected = listOf("Quiero una ensalada, por favor", "quiero una ensalada por favor"), focus = "quiero", watch = "quiero + comida + por favor."), PracticeQuestion(prompt = "En grupo, di que tu plato es el pollo.", expected = listOf("Para mí, el pollo", "para mi el pollo"), focus = "para mí", watch = "para mí lleva tilde."), PracticeQuestion(prompt = "Pregunta al camarero qué hay de primero.", expected = listOf("¿Qué tiene de primero?", "¿Que tiene de primero?"), focus = "¿qué tiene?", watch = "qué con tilde en preguntas."), PracticeQuestion(prompt = "Pide el menú.", expected = listOf("¿Me trae el menú, por favor?", "¿Me trae el menu por favor?"), focus = "¿me trae?", watch = "menú lleva tilde."), PracticeQuestion(prompt = "Di que quieres agua.", expected = listOf("Quiero agua", "quiero agua", "Quiero un agua"), focus = "quiero", watch = "un agua: agua es masculino."))), exercises = listOf(Exercise(id = "es-foundations-u17-restaurante-e1", kind = "choice", prompt = "Quiero ___ ensalada y un agua.", options = listOf("una", "un", "unos", "unas"), answers = listOf("una"), explain = "Ensalada es femenino: una ensalada."), Exercise(id = "es-foundations-u17-restaurante-e2", kind = "gap", prompt = "___ mí, el pollo con patatas.", options = listOf(), answers = listOf("Para", "para"), explain = "«Para mí» marca tu plato; mí lleva tilde."), Exercise(id = "es-foundations-u17-restaurante-e3", kind = "order", prompt = "Pregunta al camarero qué hay de postre.", options = listOf(), answers = listOf("¿Qué tiene de postre?"), explain = "¿Qué tiene…? pregunta lo que hay."), Exercise(id = "es-foundations-u17-restaurante-e4", kind = "written", prompt = "Pide un café con cortesía.", options = listOf(), answers = listOf("Un café, por favor", "un cafe por favor", "Quiero un café, por favor"), explain = "por favor añade cortesía; café lleva tilde.")), skills = listOf("function:order-food", "vocab:food", "grammar:present-simple", "function:ask-simple-questions"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u17-carta", title = "La carta", goal = "Leer la carta: platos y bebidas, y preguntar qué lleva cada plato.", intro = LessonIntro(explanation = listOf("La carta ordena la comida: de primero, de segundo y de postre. «De segundo, merluza».", "Para saber los ingredientes: «¿Qué lleva la paella?». Se responde con lleva: «Lleva arroz y marisco».", "Las bebidas van de beber: «¿Qué quieren de beber?». «Dos aguas y un zumo»."), examples = listOf(ExampleLine(text = "¿Qué lleva el gazpacho?", meaning = "Preguntar los ingredientes."), ExampleLine(text = "Lleva tomate y pepino.", meaning = "Responder con lleva."), ExampleLine(text = "De segundo quiero merluza.", meaning = "Elegir en la carta."), ExampleLine(text = "¿Qué hay de postre?", meaning = "Preguntar por los postres."), ExampleLine(text = "Para beber, dos aguas.", meaning = "Pedir bebidas."), ExampleLine(text = "¿Qué lleva la ensalada?", meaning = "Preguntar por un plato."))), expressions = listOf(TargetExpression(text = "¿Qué lleva …?", meaning = "Preguntar los ingredientes.", note = "¿Qué lleva la ensalada?"), TargetExpression(text = "lleva + ingrediente", meaning = "Los ingredientes del plato.", note = "Lleva atún y cebolla."), TargetExpression(text = "de primero / de segundo", meaning = "Los platos en orden.", note = "De segundo, tortilla."), TargetExpression(text = "de postre", meaning = "El final de la comida.", note = "¿Qué hay de postre?"), TargetExpression(text = "de beber", meaning = "Las bebidas.", note = "¿Qué quieren de beber?")), situation = "Miráis la carta: preguntas qué lleva el arroz, eliges de segundo y pedís dos refrescos y un agua.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pregunta qué lleva la sopa.", expected = listOf("¿Qué lleva la sopa?", "¿Que lleva la sopa?"), focus = "¿qué lleva?", watch = "qué con tilde en preguntas."), PracticeQuestion(prompt = "Di que la ensalada lleva tomate y atún.", expected = listOf("La ensalada lleva tomate y atún", "la ensalada lleva tomate y atun"), focus = "lleva", watch = "atún lleva tilde."), PracticeQuestion(prompt = "Elige la tortilla de segundo.", expected = listOf("De segundo, tortilla", "de segundo tortilla", "De segundo quiero tortilla"), focus = "de segundo", watch = "de segundo marca el plato."), PracticeQuestion(prompt = "Pregunta qué hay de postre.", expected = listOf("¿Qué hay de postre?", "¿Que hay de postre?"), focus = "de postre", watch = "hay = existe."), PracticeQuestion(prompt = "Pide dos refrescos para beber.", expected = listOf("Dos refrescos, por favor", "Para beber, dos refrescos", "para beber dos refrescos"), focus = "de beber", watch = "refresco: bebida fría."))), exercises = listOf(Exercise(id = "es-foundations-u17-carta-e1", kind = "choice", prompt = "¿Qué ___ la paella? — Arroz, pollo y marisco.", options = listOf("lleva", "come", "toma", "bebe"), answers = listOf("lleva"), explain = "Lleva habla de los ingredientes de un plato."), Exercise(id = "es-foundations-u17-carta-e2", kind = "gap", prompt = "___ segundo quiero merluza.", options = listOf(), answers = listOf("De", "de"), explain = "De primero / de segundo ordenan la comida."), Exercise(id = "es-foundations-u17-carta-e3", kind = "order", prompt = "Pregunta por los ingredientes del gazpacho.", options = listOf(), answers = listOf("¿Qué lleva el gazpacho?"), explain = "¿Qué lleva…? pregunta los ingredientes."), Exercise(id = "es-foundations-u17-carta-e4", kind = "written", prompt = "Sois dos en la mesa y queréis agua: ¿qué pides?", options = listOf(), answers = listOf("Dos aguas, por favor", "dos aguas", "Para beber, dos aguas"), explain = "aguas en plural: dos aguas.")), skills = listOf("function:order-food", "vocab:food", "grammar:present-questions", "grammar:present-simple"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u17-cuenta", title = "La cuenta", goal = "Pedir la cuenta, preguntar el total y pagar: tarjeta, efectivo y propina.", intro = LessonIntro(explanation = listOf("Al terminar: «La cuenta, por favor». El camarero dice el total con son: «Son veintidós euros».", "Para pagar: «¿Puedo pagar con tarjeta?». En efectivo: «Pago en efectivo».", "La propina es opcional en España: «El cambio es para usted» y el camarero lo agradece."), examples = listOf(ExampleLine(text = "La cuenta, por favor.", meaning = "Pedir la cuenta."), ExampleLine(text = "¿Cuánto es?", meaning = "Preguntar el total."), ExampleLine(text = "Son dieciocho euros.", meaning = "El camarero dice el total."), ExampleLine(text = "¿Puedo pagar con tarjeta?", meaning = "Preguntar por el pago."), ExampleLine(text = "El cambio es para usted.", meaning = "Dejar propina."))), expressions = listOf(TargetExpression(text = "la cuenta, por favor", meaning = "Pedir la cuenta.", note = "La cuenta, por favor."), TargetExpression(text = "¿Cuánto es?", meaning = "Preguntar el total.", note = "¿Cuánto es todo?"), TargetExpression(text = "son … euros", meaning = "El total.", note = "Son veinte euros."), TargetExpression(text = "con tarjeta / en efectivo", meaning = "Formas de pago.", note = "¿Puedo pagar en efectivo?"), TargetExpression(text = "el cambio es para usted", meaning = "Dejar propina.", note = "El cambio es para usted.")), situation = "Termináis la cena: pides la cuenta, son veinticuatro euros, pagas con tarjeta y dejas el cambio al camarero.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pide la cuenta con cortesía.", expected = listOf("La cuenta, por favor", "la cuenta por favor"), focus = "la cuenta", watch = "por favor al final."), PracticeQuestion(prompt = "Pregunta el total.", expected = listOf("¿Cuánto es?", "¿Cuanto es?", "¿Cuánto es todo?"), focus = "¿cuánto?", watch = "cuánto con tilde en preguntas."), PracticeQuestion(prompt = "Di el total: veinte euros.", expected = listOf("Son veinte euros", "son veinte euros"), focus = "son", watch = "son + precio: son veinte euros."), PracticeQuestion(prompt = "Pregunta si puedes pagar con tarjeta.", expected = listOf("¿Puedo pagar con tarjeta?", "Puedo pagar con tarjeta"), focus = "¿puedo…?", watch = "puedo + infinitivo."), PracticeQuestion(prompt = "Di que el cambio es para el camarero.", expected = listOf("El cambio es para el camarero", "el cambio es para usted"), focus = "para usted", watch = "usted: cortesía al camarero."))), exercises = listOf(Exercise(id = "es-foundations-u17-cuenta-e1", kind = "choice", prompt = "—¿Cuánto es? —___ veintidós euros.", options = listOf("Son", "Es", "Están", "Hay"), answers = listOf("Son"), explain = "Los precios van con ser: son veintidós euros."), Exercise(id = "es-foundations-u17-cuenta-e2", kind = "gap", prompt = "¿Puedo pagar ___ tarjeta?", options = listOf(), answers = listOf("con", "Con"), explain = "pagar con tarjeta / en efectivo."), Exercise(id = "es-foundations-u17-cuenta-e3", kind = "order", prompt = "Termináis de cenar: ¿qué dices para que traigan el ticket?", options = listOf(), answers = listOf("La cuenta, por favor"), explain = "Frase fija para pedir la cuenta."), Exercise(id = "es-foundations-u17-cuenta-e4", kind = "written", prompt = "Pregunta por el precio total.", options = listOf(), answers = listOf("¿Cuánto es?", "¿Cuanto es?", "¿Cuánto es todo?"), explain = "¿Cuánto es? con tilde.")), skills = listOf("function:order-food", "grammar:quantities", "vocab:food", "vocab:social-expressions"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple"))))
}

object EsFoundationsU20 {
    val unit = CourseUnit(id = "es-foundations-u20", title = "Una visita", subtitle = "En casa de otros", level = "A1", themes = listOf(ConversationTheme("la-llegada", "La llegada", "Pedir permiso", "door.left.open", "Course", "Llegas a casa de tu vecina: llamas a la puerta, pides pasar y dejas el paraguas.", 0),
                ConversationTheme("el-detalle-visita", "El detalle", "Ofrecer y agradecer", "gift", "Course", "Traes un postre, lo ofreces a los anfitriones y te despides dando las gracias.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u20-visita", title = "¿Puedo pasar?", goal = "Pedir permiso en casa de alguien: ¿puedo pasar?, ¿puedo…? y responder con pasa, sí, sí.", intro = LessonIntro(explanation = listOf("Para pedir permiso usamos poder: «¿Puedo pasar?». La respuesta es corta y amable: «¡Pasa, pasa!».", "Puedo + infinitivo sirve para todo en una visita: «¿Puedo quitarme los zapatos?», «¿Puedo dejar el paraguas aquí?».", "Para preguntar por alguien: «¿Está Carmen?». Y para entrar con educación: «¿Se puede?»."), examples = listOf(ExampleLine(text = "¿Puedo pasar?", meaning = "Pedir permiso para entrar."), ExampleLine(text = "¡Pasa, pasa!", meaning = "Dar permiso."), ExampleLine(text = "¿Puedo dejar el paraguas aquí?", meaning = "Pedir permiso con puedo + infinitivo."), ExampleLine(text = "¿Puedo quitarme los zapatos?", meaning = "Otra petición de permiso."), ExampleLine(text = "¿Está Carmen?", meaning = "Preguntar por una persona."))), expressions = listOf(TargetExpression(text = "¿puedo + infinitivo?", meaning = "Pedir permiso.", note = "¿Puedo entrar?"), TargetExpression(text = "¿puedo pasar?", meaning = "Pedir pasar a una casa.", note = "¿Puedo pasar? — ¡Pasa, pasa!"), TargetExpression(text = "pasa / pasa, pasa", meaning = "Dar permiso al invitado.", note = "¡Pasa, pasa, está abierta!"), TargetExpression(text = "¿está …?", meaning = "Preguntar por alguien.", note = "¿Está tu madre?"), TargetExpression(text = "¿se puede?", meaning = "Pedir permiso, fórmula fija.", note = "¿Se puede? — Sí, sí, adelante.")), situation = "Llegas a casa de tu vecina Carmen: llamas a la puerta, pides pasar, dejas el paraguas y preguntas si está su hijo.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Llamas a la puerta de Carmen: pide pasar.", expected = listOf("¿Puedo pasar?", "¿Puedo pasar"), focus = "¿puedo pasar?", watch = "puedo + infinitivo."), PracticeQuestion(prompt = "Pide permiso para quitarte los zapatos.", expected = listOf("¿Puedo quitarme los zapatos?", "puedo quitarme los zapatos"), focus = "¿puedo…?", watch = "quitarme: quitarse + me."), PracticeQuestion(prompt = "Está lloviendo: pide permiso para dejar el paraguas.", expected = listOf("¿Puedo dejar el paraguas aquí?", "puedo dejar el paraguas"), focus = "dejar", watch = "dejar = poner algo en un sitio."), PracticeQuestion(prompt = "Pregunta si el hijo de Carmen está en casa.", expected = listOf("¿Está tu hijo?", "¿Está tu hijo en casa?"), focus = "¿está…?", watch = "está con tilde."), PracticeQuestion(prompt = "Carmen te abre: responde a «¿Puedo pasar?».", expected = listOf("¡Pasa, pasa!", "Pasa, pasa", "Sí, pasa"), focus = "pasa", watch = "pasa: dar permiso."))), exercises = listOf(Exercise(id = "es-foundations-u20-visita-e1", kind = "choice", prompt = "¿___ entrar? — Sí, sí, pasa.", options = listOf("Puedo", "Puedes", "Quiero", "Tengo"), answers = listOf("Puedo"), explain = "Puedo + infinitivo: pedir permiso para ti."), Exercise(id = "es-foundations-u20-visita-e2", kind = "gap", prompt = "¿___ quitarme los zapatos aquí?", options = listOf(), answers = listOf("Puedo", "puedo"), explain = "Puedo + infinitivo pide permiso; la respuesta corta es «Sí, puedes»."), Exercise(id = "es-foundations-u20-visita-e3", kind = "order", prompt = "Estás mojado: pide permiso para dejar el paraguas en la entrada.", options = listOf(), answers = listOf("¿Puedo dejar el paraguas aquí?"), explain = "¿Puedo + infinitivo? es la fórmula de permiso en una visita."), Exercise(id = "es-foundations-u20-visita-e4", kind = "written", prompt = "Llama a la puerta y pregunta por la dueña de la casa.", options = listOf(), answers = listOf("¿Está Carmen?", "¿Esta Carmen?", "¿Está Carmen en casa?"), explain = "¿Está + nombre? pregunta si la persona está en casa; está lleva tilde.")), skills = listOf("grammar:can", "function:make-requests", "vocab:social-expressions", "grammar:present-simple"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u20-detalle", title = "Traigo un detalle", goal = "Ofrecer algo a los anfitriones al llegar: traigo…, es para ti, es un detalle, ¿dónde lo pongo?", intro = LessonIntro(explanation = listOf("Al llegar con algo, traer va en primera persona: «Traigo un postre», «Traigo pan».", "Para entregarlo: «Esto es para ti», «Es un detalle». Un detalle es un regalo pequeño y amable.", "La anfitriona lo agradece: «¡Qué detallista!». Y tú preguntas: «¿Dónde lo pongo?»."), examples = listOf(ExampleLine(text = "Traigo un postre.", meaning = "Decir qué traes."), ExampleLine(text = "Esto es para ti.", meaning = "Entregar el regalo."), ExampleLine(text = "Es un detalle.", meaning = "Presentar un regalo pequeño."), ExampleLine(text = "¡Qué detallista!", meaning = "La anfitriona agradece."), ExampleLine(text = "¿Dónde lo pongo?", meaning = "Preguntar el sitio."))), expressions = listOf(TargetExpression(text = "traigo + comida", meaning = "Decir qué traes.", note = "Traigo una tarta."), TargetExpression(text = "esto es para ti", meaning = "Entregar el detalle.", note = "Esto es para ti, Carmen."), TargetExpression(text = "es un detalle", meaning = "Regalo pequeño y amable.", note = "No hacía falta, es un detalle."), TargetExpression(text = "¿dónde lo pongo?", meaning = "Preguntar dónde dejarlo.", note = "¿Dónde lo pongo, en la mesa?"), TargetExpression(text = "¡qué detallista!", meaning = "La anfitriona agradece.", note = "¡Qué detallista eres!")), situation = "Vas a cenar en casa de Carmen con una tarta: dices qué traes, la entregas y preguntas dónde la pones.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Llegas con una tarta: di qué traes.", expected = listOf("Traigo una tarta", "traigo tarta"), focus = "traigo", watch = "traigo: yo traigo, presente."), PracticeQuestion(prompt = "Entrega el regalo a Carmen.", expected = listOf("Esto es para ti", "es para ti"), focus = "para ti", watch = "para + persona."), PracticeQuestion(prompt = "Preséntalo como regalo pequeño.", expected = listOf("Es un detalle", "es un detalle"), focus = "un detalle", watch = "un detalle: regalo amable."), PracticeQuestion(prompt = "Pregunta dónde dejas la tarta.", expected = listOf("¿Dónde lo pongo?", "¿Dónde pongo la tarta?"), focus = "¿dónde lo pongo?", watch = "dónde con tilde."), PracticeQuestion(prompt = "Responde al regalo: ¡qué detallista!", expected = listOf("¡Qué detallista!", "Qué detallista eres"), focus = "detallista", watch = "¡qué + adjetivo!"))), exercises = listOf(Exercise(id = "es-foundations-u20-detalle-e1", kind = "choice", prompt = "Traigo ___ vino para la cena. — ¡Qué detallista!", options = listOf("un", "una", "unos", "unas"), answers = listOf("un"), explain = "Vino es masculino: un vino; unos es plural."), Exercise(id = "es-foundations-u20-detalle-e2", kind = "gap", prompt = "Esto es ___ ti, Carmen. Gracias por invitarme.", options = listOf(), answers = listOf("para", "Para"), explain = "para ti: el regalo va dirigido a la persona; por marca el motivo."), Exercise(id = "es-foundations-u20-detalle-e3", kind = "order", prompt = "Llegas con una tarta a la cena: di qué traes.", options = listOf(), answers = listOf("Traigo una tarta"), explain = "traigo + comida: presentar el detalle al llegar."), Exercise(id = "es-foundations-u20-detalle-e4", kind = "written", prompt = "Pregunta a la anfitriona dónde dejas el postre.", options = listOf(), answers = listOf("¿Dónde lo pongo?", "¿Donde lo pongo?", "¿Dónde pongo la tarta?"), explain = "¿Dónde lo pongo? pregunta el sitio; dónde lleva tilde.")), skills = listOf("function:make-requests", "vocab:food", "vocab:social-expressions", "function:order-food"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u20-despedida", title = "Hasta la próxima", goal = "Despedirse y agradecer al irte de una casa: gracias por todo, hasta la próxima y ¿puedo ayudar?", intro = LessonIntro(explanation = listOf("Para agradecer: «Gracias por todo», «Muchas gracias por la cena». La respuesta es corta: «De nada».", "Para despedirse: «Hasta la próxima», «Nos vemos». La próxima significa la próxima vez.", "Antes de irte, ofreces ayuda con puedo: «¿Puedo ayudar a recoger?»."), examples = listOf(ExampleLine(text = "Gracias por todo.", meaning = "Agradecer la visita."), ExampleLine(text = "Muchas gracias por la cena.", meaning = "Agradecer por el motivo."), ExampleLine(text = "De nada.", meaning = "La respuesta a gracias."), ExampleLine(text = "Hasta la próxima.", meaning = "Despedirse para otra vez."), ExampleLine(text = "¿Puedo ayudar a recoger?", meaning = "Ofrecer ayuda al irte."))), expressions = listOf(TargetExpression(text = "gracias por todo", meaning = "Agradecer de forma general.", note = "Gracias por todo, Carmen."), TargetExpression(text = "muchas gracias por + comida", meaning = "Agradecer el motivo.", note = "Muchas gracias por la cena."), TargetExpression(text = "de nada", meaning = "Responder a gracias.", note = "—Gracias. —De nada."), TargetExpression(text = "hasta la próxima", meaning = "Despedirse para otra vez.", note = "Hasta la próxima, nos vemos."), TargetExpression(text = "¿puedo ayudar?", meaning = "Ofrecer ayuda con puedo.", note = "¿Puedo ayudar a recoger?")), situation = "Termina la cena en casa de Carmen: ofreces ayuda para recoger, das las gracias por la cena y te despides hasta la próxima.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Agradece toda la visita.", expected = listOf("Gracias por todo", "gracias por todo"), focus = "gracias por", watch = "gracias + por + motivo."), PracticeQuestion(prompt = "Agradece la cena en concreto.", expected = listOf("Muchas gracias por la cena", "muchas gracias por la cena"), focus = "por la cena", watch = "por marca el motivo."), PracticeQuestion(prompt = "Carmen dice gracias: responde.", expected = listOf("De nada", "de nada"), focus = "de nada", watch = "La respuesta fija a gracias."), PracticeQuestion(prompt = "Despídete para otra vez.", expected = listOf("Hasta la próxima", "hasta la proxima"), focus = "hasta la próxima", watch = "próxima lleva tilde."), PracticeQuestion(prompt = "Ofrece ayuda para recoger la mesa.", expected = listOf("¿Puedo ayudar a recoger?", "puedo ayudar"), focus = "¿puedo ayudar?", watch = "puedo + infinitivo."))), exercises = listOf(Exercise(id = "es-foundations-u20-despedida-e1", kind = "choice", prompt = "—¡Muchas gracias por la cena! —___ nada.", options = listOf("De", "Por", "Con", "Sin"), answers = listOf("De"), explain = "La respuesta fija a gracias es «De nada»."), Exercise(id = "es-foundations-u20-despedida-e2", kind = "gap", prompt = "Gracias ___ la cena, estaba riquísima.", options = listOf(), answers = listOf("por", "Por"), explain = "gracias por + motivo: gracias por la cena, gracias por el café."), Exercise(id = "es-foundations-u20-despedida-e3", kind = "order", prompt = "Te vas de casa de Carmen: despídete para otra vez.", options = listOf(), answers = listOf("Hasta la próxima"), explain = "Hasta la próxima = hasta la próxima vez; despida amable de visita."), Exercise(id = "es-foundations-u20-despedida-e4", kind = "written", prompt = "Antes de irte, ofrece ayuda con el permiso de puedo.", options = listOf(), answers = listOf("¿Puedo ayudar?", "¿Puedo ayudar a recoger?", "puedo ayudar"), explain = "¿Puedo ayudar? ofrece ayuda; puedo + infinitivo pide permiso para ayudar.")), skills = listOf("vocab:social-expressions", "grammar:present-simple", "function:ask-simple-questions", "grammar:can"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple"))))
}

object EsFoundationsU23 {
    val unit = CourseUnit(id = "es-foundations-u23", title = "Celebra", subtitle = "Fiestas y cumpleaños", level = "A1", themes = listOf(ConversationTheme("la-invitacion", "La invitación", "Invitar y responder", "party.popper", "Course", "Organizáis una fiesta en casa: pasáis las invitaciones, preguntáis por la hora y confirmáis quién viene.", 0),
                ConversationTheme("el-cumpleanos", "El cumpleaños", "Regalos y buenos deseos", "birthday.cake", "Course", "Es el cumpleaños de Ana: pensáis el regalo, cantáis en la fiesta y felicitáis con buenos deseos.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u23-fiesta", title = "Invitados y anfitriones", goal = "Invitar a una fiesta y responder: ¿vienes a mi fiesta?, os invito, claro que voy, ¿a qué hora?", intro = LessonIntro(explanation = listOf("Para invitar, preguntas con presente: «¿Vienes a mi fiesta el sábado?», «Os invito a mi cumpleaños».", "Para proponer ir acompañado: «¿Vamos juntos a la fiesta?», «Vamos a llevar un pastel».", "Acepta con ganas («Claro que voy») o declina con disculpa: «Lo siento, no puedo». Y el anfitrión da los detalles: «Es en mi casa, a las ocho»."), examples = listOf(ExampleLine(text = "¿Vienes a mi fiesta el sábado?", meaning = "Invitar a una persona."), ExampleLine(text = "Os invito a mi cumpleaños.", meaning = "Invitar a un grupo."), ExampleLine(text = "¿Vamos juntos a la fiesta?", meaning = "Sugerir ir acompañados."), ExampleLine(text = "Claro que voy, gracias.", meaning = "Aceptar la invitación."), ExampleLine(text = "Lo siento, no puedo ir.", meaning = "Declinar con disculpa."), ExampleLine(text = "La fiesta es a las ocho en mi casa.", meaning = "Decir hora y lugar."))), expressions = listOf(TargetExpression(text = "¿vienes a…?", meaning = "Invitar a una persona.", note = "¿Vienes a la fiesta?"), TargetExpression(text = "os invito a…", meaning = "Invitar a un grupo.", note = "Os invito a cenar."), TargetExpression(text = "¿vamos juntos?", meaning = "Sugerir ir acompañados.", note = "¿Vamos juntos a la fiesta?"), TargetExpression(text = "claro que voy", meaning = "Aceptar con ganas.", note = "Claro que voy, ¡gracias!"), TargetExpression(text = "lo siento, no puedo", meaning = "Declinar con disculpa.", note = "Lo siento, no puedo ir."), TargetExpression(text = "¿a qué hora…?", meaning = "Preguntar la hora.", note = "¿A qué hora empieza?")), situation = "Invitas a tus compañeros a tu fiesta del sábado: confirmas quién viene, propones ir juntos y les das la hora y la dirección.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Invita a Pablo a tu fiesta del sábado.", expected = listOf("¿Vienes a mi fiesta el sábado?", "Vienes a mi fiesta el sábado", "vienes a mi fiesta"), focus = "¿vienes…?", watch = "vienes: tú. Para un grupo, ¿venís…?"), PracticeQuestion(prompt = "Invita a todo el grupo a cenar en tu casa.", expected = listOf("Os invito a cenar en mi casa", "os invito a cenar", "Os invito a cenar en casa"), focus = "os invito", watch = "os: vosotros, el grupo."), PracticeQuestion(prompt = "Propón ir juntos a la fiesta.", expected = listOf("¿Vamos juntos a la fiesta?", "Vamos juntos", "¿Vamos juntos?"), focus = "¿vamos juntos?", watch = "la sugerencia con vamos."), PracticeQuestion(prompt = "Acepta la invitación con ganas.", expected = listOf("Claro que voy", "claro que voy", "¡Cómo no! Voy"), focus = "aceptar", watch = "claro que + presente: aceptación."), PracticeQuestion(prompt = "Declina la invitación con disculpa.", expected = listOf("Lo siento, no puedo ir", "lo siento no puedo", "Lo siento, no puedo"), focus = "lo siento", watch = "lo siento + no puedo: disculpa y razón corta."), PracticeQuestion(prompt = "Pregunta la hora de la fiesta.", expected = listOf("¿A qué hora empieza la fiesta?", "a que hora empieza", "¿A qué hora empieza?"), focus = "¿a qué hora?", watch = "qué con tilde en la pregunta."))), exercises = listOf(Exercise(id = "es-foundations-u23-fiesta-e1", kind = "choice", prompt = "¿___ a mi fiesta el sábado?", options = listOf("Vienes", "Voy", "Va", "Vamos"), answers = listOf("Vienes"), explain = "Vienes: tú, el presente de la invitación; la persona invitada responde voy."), Exercise(id = "es-foundations-u23-fiesta-e2", kind = "gap", prompt = "Os ___ a mi cumpleaños el viernes. (invitar)", options = listOf(), answers = listOf("invito", "Invito"), explain = "invito: yo; con os, invitas a todo el grupo."), Exercise(id = "es-foundations-u23-fiesta-e3", kind = "order", prompt = "Acepta la invitación con entusiasmo.", options = listOf(), answers = listOf("Claro que voy, gracias"), explain = "claro que voy: la aceptación con ganas; gracias la suaviza."), Exercise(id = "es-foundations-u23-fiesta-e4", kind = "written", prompt = "Pregunta por la hora de la cena.", options = listOf(), answers = listOf("¿a qué hora es la cena?", "a que hora es la cena", "¿a qué hora empieza la cena?"), explain = "¿A qué hora…? pregunta la hora del evento; qué con tilde.")), skills = listOf("vocab:social-expressions", "grammar:present-simple", "function:make-suggestions", "function:ask-simple-questions"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u23-regalo", title = "¿Qué le regalo?", goal = "Pensar un regalo con los gustos: ¿qué le regalo?, ¿qué le gusta?, le gustan los libros, creo que…", intro = LessonIntro(explanation = listOf("La pregunta clave: «¿Qué le regalo a Ana?». Le = a ella, a él.", "Los gustos orientan la compra: «Le gusta el chocolate», «Le gustan los libros». Gusta en singular, gustan en plural.", "Opina con suavidad: «Creo que es buena idea», «¿Qué te parece una bufanda?»."), examples = listOf(ExampleLine(text = "¿Qué le regalo a Ana?", meaning = "La pregunta clave."), ExampleLine(text = "¿Qué le gusta?", meaning = "Preguntar por sus gustos."), ExampleLine(text = "Le gustan los libros de viajes.", meaning = "Gustos en plural."), ExampleLine(text = "Creo que es buena idea.", meaning = "Opinar con suavidad."), ExampleLine(text = "¿Qué te parece una bufanda?", meaning = "Pedir otra opinión."))), expressions = listOf(TargetExpression(text = "¿qué le regalo?", meaning = "Pedir ideas de regalo.", note = "¿Qué le regalo a Marta?"), TargetExpression(text = "le gusta + singular", meaning = "Un gusto.", note = "Le gusta el chocolate."), TargetExpression(text = "le gustan + plural", meaning = "Varios gustos.", note = "Le gustan las plantas."), TargetExpression(text = "creo que…", meaning = "Opinar.", note = "Creo que le va a encantar."), TargetExpression(text = "¿qué te parece?", meaning = "Pedir opinión.", note = "¿Qué te parece un libro?")), situation = "El cumpleaños de Ana es el viernes: entre todos pensáis el regalo con sus gustos: le gustan las plantas y los libros, y al final elegís uno.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pregunta qué comprarle a Ana para su cumpleaños.", expected = listOf("¿Qué le regalo a Ana?", "que le regalo", "¿Qué le regalo?"), focus = "¿qué le regalo?", watch = "le: a ella."), PracticeQuestion(prompt = "Di el gusto de Ana: el chocolate.", expected = listOf("Le gusta el chocolate", "le gusta el chocolate", "A Ana le gusta el chocolate"), focus = "le gusta", watch = "gusta en singular."), PracticeQuestion(prompt = "Di los gustos de Ana: los libros de viajes.", expected = listOf("Le gustan los libros de viajes", "le gustan los libros"), focus = "le gustan", watch = "gustan en plural."), PracticeQuestion(prompt = "Opina: para ti, es buena idea.", expected = listOf("Creo que es buena idea", "creo que es buena idea"), focus = "creo que", watch = "creo que + opinión."), PracticeQuestion(prompt = "Pide la opinión de tu amigo sobre una bufanda.", expected = listOf("¿Qué te parece una bufanda?", "que te parece una bufanda"), focus = "¿qué te parece?", watch = "te: la opinión de tu compañero."))), exercises = listOf(Exercise(id = "es-foundations-u23-regalo-e1", kind = "choice", prompt = "A Ana le ___ las plantas.", options = listOf("gustan", "gusta", "gusto", "gustamos"), answers = listOf("gustan"), explain = "Las plantas es plural: le gustan; con un solo gusto sería le gusta."), Exercise(id = "es-foundations-u23-regalo-e2", kind = "gap", prompt = "¿Qué ___ regalo a Marta, un libro o una planta? (a ella)", options = listOf(), answers = listOf("le", "Le"), explain = "le regalo: a ella; le vale para él y para ella."), Exercise(id = "es-foundations-u23-regalo-e3", kind = "order", prompt = "Opina con suavidad sobre la idea.", options = listOf(), answers = listOf("Creo que es buena idea"), explain = "creo que + opinión: la forma suave de valorar una idea."), Exercise(id = "es-foundations-u23-regalo-e4", kind = "written", prompt = "Pregunta a tu compañero qué le parece el regalo.", options = listOf(), answers = listOf("¿qué te parece el regalo?", "que te parece el regalo", "¿qué te parece?"), explain = "¿Qué te parece…? pide la opinión de la otra persona.")), skills = listOf("function:go-shopping", "vocab:social-expressions", "grammar:present-questions", "grammar:present-simple"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u23-felicitacion", title = "Feliz cumpleaños", goal = "Felicitar y desear: ¡feliz cumpleaños!, que lo pases muy bien, gracias por venir, ¡salud!", intro = LessonIntro(explanation = listOf("Para felicitar: «¡Feliz cumpleaños!», «¡Felicidades!». Las dos valen en un cumpleaños.", "Los deseos van con que: «Que lo pases muy bien», «Que cumplas muchos más».", "El anfitrión agradece: «Gracias por venir»; todos brindan: «¡Salud!», y se comparte el ánimo: «Estoy muy contenta»."), examples = listOf(ExampleLine(text = "¡Feliz cumpleaños, Ana!", meaning = "Felicitar."), ExampleLine(text = "¡Felicidades!", meaning = "La palabra comodín."), ExampleLine(text = "Que lo pases muy bien.", meaning = "Desear un buen día."), ExampleLine(text = "Gracias por venir.", meaning = "Agradecer la visita."), ExampleLine(text = "Estoy muy contenta por ti.", meaning = "Decir tu alegría."), ExampleLine(text = "¡Salud!", meaning = "Brindar juntos."))), expressions = listOf(TargetExpression(text = "¡feliz cumpleaños!", meaning = "Felicitar en el día.", note = "¡Feliz cumpleaños, Ana!"), TargetExpression(text = "¡felicidades!", meaning = "Felicitar en cualquier fiesta.", note = "¡Felicidades por tu premio!"), TargetExpression(text = "que lo pases…", meaning = "Desear algo bueno.", note = "Que lo pases muy bien."), TargetExpression(text = "gracias por + infinitivo", meaning = "Agradecer.", note = "Gracias por venir."), TargetExpression(text = "estoy muy contento/a", meaning = "Compartir tu alegría.", note = "Estoy muy contenta por ti."), TargetExpression(text = "¡salud!", meaning = "Brindar.", note = "¡Salud! Por Ana.")), situation = "En la fiesta de Ana: todos cantan y felicitan, ella agradece a cada invitado que venga y, al final, todos brindáis juntos por su día.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Felicita a Ana en su día.", expected = listOf("¡Feliz cumpleaños, Ana!", "feliz cumpleaños", "¡Feliz cumpleaños!"), focus = "feliz cumpleaños", watch = "la fórmula fija del día."), PracticeQuestion(prompt = "Felicita a tu compañero por su ascenso.", expected = listOf("¡Felicidades por tu ascenso!", "¡Felicidades!", "felicidades"), focus = "felicidades", watch = "felicidades sirve para todo."), PracticeQuestion(prompt = "Desea a Ana un día muy bueno.", expected = listOf("Que lo pases muy bien", "que lo pases genial", "Que lo pases genial"), focus = "que lo pases", watch = "que + deseo: fórmula fija."), PracticeQuestion(prompt = "Agradece a tus invitados.", expected = listOf("Gracias por venir", "gracias por venir", "Gracias por venir, ¡salud!"), focus = "gracias por", watch = "gracias por + infinitivo."), PracticeQuestion(prompt = "Di tu alegría por Ana (mujer).", expected = listOf("Estoy muy contenta por ti", "estoy muy contenta", "Estoy muy contento por ti"), focus = "estoy contento/a", watch = "contento o contenta: concuerda contigo."), PracticeQuestion(prompt = "Brinda con todos por Ana.", expected = listOf("¡Salud!", "salud", "¡Salud, por Ana!"), focus = "salud", watch = "brindar: ¡salud!"))), exercises = listOf(Exercise(id = "es-foundations-u23-felicitacion-e1", kind = "choice", prompt = "¡___ cumpleaños, Ana!", options = listOf("Feliz", "Contento", "Alegra", "Fiesta"), answers = listOf("Feliz"), explain = "Feliz cumpleaños: la fórmula fija para felicitar en el día."), Exercise(id = "es-foundations-u23-felicitacion-e2", kind = "gap", prompt = "___ lo pases muy bien en tu día. (deseo)", options = listOf(), answers = listOf("Que", "que"), explain = "que + deseo: Que lo pases bien; mayúscula si abre la frase."), Exercise(id = "es-foundations-u23-felicitacion-e3", kind = "order", prompt = "Agradece a los invitados.", options = listOf(), answers = listOf("Gracias por venir"), explain = "gracias por + infinitivo: la forma de agradecer la visita."), Exercise(id = "es-foundations-u23-felicitacion-e4", kind = "written", prompt = "Brinda en la fiesta.", options = listOf(), answers = listOf("¡salud!", "salud", "¡salud, por ana!"), explain = "¡Salud! es el brindis típico de las fiestas.")), skills = listOf("vocab:social-expressions", "function:make-suggestions", "grammar:present-simple", "vocab:feelings"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple"))))
}

object EsFoundationsU24 {
    val unit = CourseUnit(id = "es-foundations-u24", title = "Ropa y tallas", subtitle = "Colores, precios y pago", level = "A1", themes = listOf(ConversationTheme("la-tienda", "En la tienda", "Tallas y probadores", "tshirt", "Course", "Compráis ropa en una tienda: pedís tallas y colores y probáis en el probador.", 0),
                ConversationTheme("el-precio", "El precio", "Pagar y regatear", "bag", "Course", "Negociáis el precio en el mercado: preguntáis, pedís descuento y pagáis en efectivo o con tarjeta.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u24-tienda-ropa", title = "En la tienda de ropa", goal = "Pedir ropa con talla y color: ¿tiene esta camiseta en talla M?, la quiero azul, ¿cuánto cuesta?", intro = LessonIntro(explanation = listOf("Para pedir, pregunta con usted: «¿Tiene esta camiseta en talla M?». En la tienda, usted es cortés.", "Talla y color van detrás del producto: «La quiero en talla M, en azul». Si no va bien: «Necesito una talla más grande».", "El precio siempre se pregunta: «¿Cuánto cuesta?» o «¿Cuánto es?»."), examples = listOf(ExampleLine(text = "¿Tiene esta camiseta en talla M?", meaning = "Pedir una talla."), ExampleLine(text = "¿Qué talla necesita?", meaning = "La pregunta del dependiente."), ExampleLine(text = "Uso la talla 40.", meaning = "Decir tu talla."), ExampleLine(text = "La quiero en azul.", meaning = "Elegir el color."), ExampleLine(text = "¿Cuánto cuesta?", meaning = "Preguntar el precio."))), expressions = listOf(TargetExpression(text = "¿tiene… en talla M?", meaning = "Pedir una talla.", note = "¿Tiene este pantalón en talla 42?"), TargetExpression(text = "¿qué talla necesita?", meaning = "La pregunta de la tienda.", note = "—¿Qué talla necesita? —La M."), TargetExpression(text = "la quiero en + color", meaning = "Elegir el color.", note = "La quiero en negro."), TargetExpression(text = "una talla más grande", meaning = "Cambiar de talla.", note = "Necesito una talla más grande."), TargetExpression(text = "¿cuánto cuesta?", meaning = "El precio.", note = "¿Cuánto cuesta la camiseta?")), situation = "Entras en una tienda de ropa: buscas una camiseta azul de talla M, el dependiente te pregunta tu talla y, antes de pagar, preguntas el precio.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pide al dependiente esta camiseta en talla M.", expected = listOf("¿Tiene esta camiseta en talla M?", "¿Tiene esta camiseta en talla m?", "tiene esta camiseta en talla m"), focus = "¿tiene…?", watch = "tiene: usted, la forma cortés."), PracticeQuestion(prompt = "El dependiente pregunta tu talla. Responde: la 40.", expected = listOf("Uso la talla 40", "uso la 40", "Mi talla es la 40"), focus = "decir la talla", watch = "uso la… o mi talla es…"), PracticeQuestion(prompt = "Pide la camiseta en color azul.", expected = listOf("La quiero en azul", "La quiero azul", "la quiero azul"), focus = "la quiero en", watch = "la quiero en + color."), PracticeQuestion(prompt = "Di que la talla no va bien: te queda pequeña.", expected = listOf("Necesito una talla más grande", "Necesito una talla mas grande", "Necesito una más grande"), focus = "una talla más", watch = "más grande / más pequeña."), PracticeQuestion(prompt = "Pregunta el precio del pantalón.", expected = listOf("¿Cuánto cuesta el pantalón?", "cuanto cuesta", "¿Cuánto es?"), focus = "¿cuánto cuesta?", watch = "cuánto con tilde."))), exercises = listOf(Exercise(id = "es-foundations-u24-tienda-ropa-e1", kind = "choice", prompt = "¿___ esta camiseta en talla M?", options = listOf("Tiene", "Tienes", "Tengo", "Tenemos"), answers = listOf("Tiene"), explain = "¿Tiene…?: usted, la forma cortés con el dependiente."), Exercise(id = "es-foundations-u24-tienda-ropa-e2", kind = "gap", prompt = "La ___ en azul, por favor. (querer, la camiseta)", options = listOf(), answers = listOf("quiero", "Quiero"), explain = "La quiero en azul: el color va con en."), Exercise(id = "es-foundations-u24-tienda-ropa-e3", kind = "order", prompt = "Pregunta el precio de la camiseta.", options = listOf(), answers = listOf("¿Cuánto cuesta la camiseta?"), explain = "¿Cuánto cuesta…? pregunta el precio; ¿cuánto es?, el total."), Exercise(id = "es-foundations-u24-tienda-ropa-e4", kind = "written", prompt = "Di que la talla M no te va bien: pides otra.", options = listOf(), answers = listOf("necesito una talla más grande", "necesito una talla mas grande"), explain = "una talla más grande: cuando la ropa queda pequeña.")), skills = listOf("function:go-shopping", "vocab:shopping", "grammar:quantities", "grammar:present-simple"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "es-foundations-u24-probar", title = "¿Puedo probármelo?", goal = "Pedir permiso y ayuda en el probador: ¿puedo probármelo?, ¿me da una talla más grande?, me queda bien.", intro = LessonIntro(explanation = listOf("Para pedir permiso, usa puedo: «¿Puedo probármelo?». Probármelo = probarlo en tu cuerpo.", "Para pedir ayuda al dependiente: «¿Me da una talla más pequeña?», «¿Me abre el probador?».", "La talla se comenta con quedar: «Me queda bien», «Me queda grande». Y si va bien: «Me lo llevo»."), examples = listOf(ExampleLine(text = "¿Puedo probármelo?", meaning = "Pedir permiso."), ExampleLine(text = "¿Dónde está el probador?", meaning = "Buscar el probador."), ExampleLine(text = "¿Me da una talla más grande?", meaning = "Pedir otra talla."), ExampleLine(text = "Me queda un poco grande.", meaning = "La talla no va bien."), ExampleLine(text = "Me queda bien, me lo llevo.", meaning = "Comprar al final."))), expressions = listOf(TargetExpression(text = "¿puedo probármelo?", meaning = "Pedir permiso para probar.", note = "¿Puedo probármelo, por favor?"), TargetExpression(text = "¿me da…?", meaning = "Pedir algo al dependiente.", note = "¿Me da otra talla?"), TargetExpression(text = "me queda + adjetivo", meaning = "Cómo va la ropa.", note = "Me queda grande."), TargetExpression(text = "me lo llevo", meaning = "Decidir comprar.", note = "Me queda bien, me lo llevo."), TargetExpression(text = "¿dónde está el probador?", meaning = "Buscar el probador.", note = "Perdone, ¿dónde está el probador?")), situation = "Viste un jersey que te gusta: pides permiso para probarlo, el probador está al fondo, el jersey queda grande y pides al dependiente una talla más pequeña.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pide permiso para probar el jersey.", expected = listOf("¿Puedo probármelo?", "puedo probarmelo", "¿Puedo probarme el jersey?"), focus = "¿puedo…?", watch = "probármelo: para ti."), PracticeQuestion(prompt = "Busca el probador con cortesía.", expected = listOf("¿Dónde está el probador?", "donde esta el probador", "Perdone, ¿dónde está el probador?"), focus = "¿dónde está?", watch = "Perdone suaviza la pregunta."), PracticeQuestion(prompt = "Pide al dependiente una talla más pequeña.", expected = listOf("¿Me da una talla más pequeña?", "¿Me da una talla mas pequena?", "¿Me trae una talla más pequeña?"), focus = "¿me da…?", watch = "me da / me trae: peticiones corteses."), PracticeQuestion(prompt = "Di que el jersey te va grande.", expected = listOf("Me queda grande", "me queda grande", "Me queda un poco grande"), focus = "me queda", watch = "queda en singular: el jersey queda grande."), PracticeQuestion(prompt = "Decide comprar el jersey.", expected = listOf("Me lo llevo", "me lo llevo", "Me lo llevo, gracias"), focus = "me lo llevo", watch = "me lo llevo: decisión de compra."))), exercises = listOf(Exercise(id = "es-foundations-u24-probar-e1", kind = "choice", prompt = "¿___ probármelo, por favor?", options = listOf("Puedo", "Puedes", "Debe", "Quiero"), answers = listOf("Puedo"), explain = "¿Puedo…?: pedir permiso en primera persona; puedes sería para el otro."), Exercise(id = "es-foundations-u24-probar-e2", kind = "gap", prompt = "El jersey no me va bien: me ___ un poco grande. (quedar)", options = listOf(), answers = listOf("queda", "Queda"), explain = "Me queda grande: la ropa + quedar + adjetivo."), Exercise(id = "es-foundations-u24-probar-e3", kind = "order", prompt = "Pide al dependiente otra talla.", options = listOf(), answers = listOf("¿Me da una talla más grande?"), explain = "¿Me da…? + lo que necesitas: la petición cortesa en la tienda."), Exercise(id = "es-foundations-u24-probar-e4", kind = "written", prompt = "Di que la camiseta va bien y la compras.", options = listOf(), answers = listOf("me queda bien me la llevo", "me queda bien, me la llevo", "me la llevo"), explain = "me queda bien + me la llevo: la compra feliz.")), skills = listOf("function:make-requests", "function:go-shopping", "grammar:can", "vocab:shopping"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:can")),
    Lesson(id = "es-foundations-u24-regateo", title = "Muy caro", goal = "Negociar el precio y pagar: es muy caro, ¿me haces un descuento?, pago en efectivo, ¿acepta tarjeta?", intro = LessonIntro(explanation = listOf("El precio se comenta: «¿Cuánto es?», «Es muy caro». En el mercado, se puede regatear.", "Para pedir descuento: «¿Me haces un descuento?», «¿Se lo deja en quince euros?».", "Para pagar: «Pago en efectivo» o con tarjeta: «¿Acepta tarjeta?»."), examples = listOf(ExampleLine(text = "¿Cuánto es todo?", meaning = "El precio total."), ExampleLine(text = "Es muy caro.", meaning = "Opinar del precio."), ExampleLine(text = "¿Me haces un descuento?", meaning = "Pedir descuento."), ExampleLine(text = "¿Se lo deja en quince euros?", meaning = "Proponer un precio."), ExampleLine(text = "Pago en efectivo.", meaning = "Pagar con dinero."), ExampleLine(text = "¿Acepta tarjeta?", meaning = "Preguntar por tarjeta."))), expressions = listOf(TargetExpression(text = "¿cuánto es?", meaning = "El total a pagar.", note = "¿Cuánto es? Son veinte."), TargetExpression(text = "es muy caro", meaning = "El precio alto.", note = "Cincuenta es muy caro."), TargetExpression(text = "¿me haces un descuento?", meaning = "Regatear con tú.", note = "¿Me haces un descuento si llevo dos?"), TargetExpression(text = "pago en efectivo", meaning = "Pagar con dinero.", note = "Pago en efectivo, gracias."), TargetExpression(text = "¿acepta tarjeta?", meaning = "Preguntar por tarjeta.", note = "¿Acepta tarjeta o solo efectivo?")), situation = "En el mercado quieres una chaqueta: cuesta cuarenta euros, te parece muy cara, pides descuento y al final pagas veinticinco en efectivo.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pregunta cuánto cuesta todo.", expected = listOf("¿Cuánto es todo?", "cuanto es", "¿Cuánto es?"), focus = "¿cuánto es?", watch = "cuánto con tilde."), PracticeQuestion(prompt = "Di que el precio te parece alto.", expected = listOf("Es muy caro", "es muy caro", "Es demasiado caro"), focus = "es muy caro", watch = "caro / barato: opiniones del precio."), PracticeQuestion(prompt = "Pide un descuento al vendedor.", expected = listOf("¿Me haces un descuento?", "me haces un descuento", "¿Hay algún descuento?"), focus = "descuento", watch = "con tú: me haces; con usted: me hace."), PracticeQuestion(prompt = "Propón pagar veinte euros.", expected = listOf("¿Se lo deja en veinte?", "¿Me lo deja en veinte?", "se lo deja en veinte"), focus = "¿me lo deja en…?", watch = "dejar en + precio: proponer precio."), PracticeQuestion(prompt = "Di que pagas con dinero, sin tarjeta.", expected = listOf("Pago en efectivo", "pago en efectivo", "Pago con efectivo"), focus = "en efectivo", watch = "en efectivo: la fórmula fija."))), exercises = listOf(Exercise(id = "es-foundations-u24-regateo-e1", kind = "choice", prompt = "¿___ tarjeta o paga en efectivo?", options = listOf("Acepta", "Aceptas", "Acepto", "Aceptan"), answers = listOf("Acepta"), explain = "¿Acepta tarjeta?: usted, como paga en efectivo; acepta sin s."), Exercise(id = "es-foundations-u24-regateo-e2", kind = "gap", prompt = "Son cuarenta euros. —Uf, ___ muy caro. (ser)", options = listOf(), answers = listOf("es", "Es"), explain = "Es muy caro: la opinión del precio con ser."), Exercise(id = "es-foundations-u24-regateo-e3", kind = "order", prompt = "Pide descuento al vendedor.", options = listOf(), answers = listOf("¿Me haces un descuento?"), explain = "¿Me haces un descuento?: la fórmula del regateo con tú."), Exercise(id = "es-foundations-u24-regateo-e4", kind = "written", prompt = "Cierra la compra: pagas con tarjeta.", options = listOf(), answers = listOf("pago con tarjeta", "pago con tarjeta, gracias", "quiero pagar con tarjeta"), explain = "pago con tarjeta: la forma de pago alternativa al efectivo.")), skills = listOf("function:go-shopping", "grammar:quantities", "vocab:shopping", "vocab:social-expressions"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple"))))
}

object EsFoundationsU4 {
    val unit = CourseUnit(id = "es-foundations-u4", title = "El pasado", subtitle = "Qué hiciste ayer", level = "A2", themes = listOf(ConversationTheme("finde-pasado", "El finde que fue", "Qué hiciste", "clock.arrow.circlepath", "Course", "Contáis qué hicisteis el finde: salidas, comidas, planes que salieron bien o mal.", 0),
                ConversationTheme("viaje-recordado", "El viaje del año pasado", "Recordando", "airplane", "Course", "Un viaje memorable: dónde fuiste, qué viste, con quién — todo en pasado.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u4-indefinido", title = "El pretérito indefinido", goal = "Contar acciones terminadas en el pasado con -é/-aste/-ó y -í/-iste/-ió.", intro = LessonIntro(explanation = listOf("El indefinido habla de acciones terminadas: «Ayer comí paella». «El año pasado viajé a México».", "Regulares: -ar → é/aste/ó/amos/asteis/aron. -er/-ir → í/iste/ió/imos/isteis/ieron.", "Irregulares frecuentes: fui/fue, hice/hizo, vi/vio, dije/dijo, estuve/estuvo."), examples = listOf(ExampleLine(text = "Ayer comí paella en el centro.", meaning = "comer → comí."), ExampleLine(text = "El año pasado viajé a México.", meaning = "viajar → viajé."), ExampleLine(text = "Fui al cine con mi hermana.", meaning = "ir → fui."), ExampleLine(text = "Hice la reserva por teléfono.", meaning = "hacer → hice."), ExampleLine(text = "No me gustó el hotel.", meaning = "gustar → gustó."))), expressions = listOf(TargetExpression(text = "comí / comiste / comió", meaning = "Comer en pasado.", note = "-er: í/iste/ió."), TargetExpression(text = "hablé / hablaste / habló", meaning = "-ar en pasado.", note = "hablar → hablé."), TargetExpression(text = "fui / fue", meaning = "Ir y ser en pasado.", note = "fui al cine, fue a casa."), TargetExpression(text = "hice / dijo / vi", meaning = "Irregulares frecuentes.", note = "hice la cena, vi la peli."), TargetExpression(text = "ayer / anoche / el año pasado", meaning = "Marcadores de tiempo.", note = "Anoche salí.")), situation = "Contáis el finde: uno cuenta lo que hizo el sábado, el otro pregunta detalles y cuenta lo suyo.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di una acción que hiciste ayer. (comer fuera)", expected = listOf("Ayer comí fuera."), focus = "comer → comí", watch = "Ayer + comí — terminado."), PracticeQuestion(prompt = "Di adónde fuiste el finde.", expected = listOf("Fui a la playa."), focus = "ir → fui", watch = "“I went” → fui, no “voy”."), PracticeQuestion(prompt = "Pregunta a tu amigo qué hizo anoche.", expected = listOf("¿Qué hiciste anoche?"), focus = "hiciste", watch = "hacer → hiciste en pregunta."), PracticeQuestion(prompt = "Di que no te gustó la película.", expected = listOf("No me gustó la película."), focus = "gustó", watch = "gustó (singular) para la película."), PracticeQuestion(prompt = "Di cuándo viajaste por última vez. (el año pasado)", expected = listOf("El año pasado viajé a <lugar>."), focus = "el año pasado", watch = "Marcador de tiempo + pretérito."))), exercises = listOf(Exercise(id = "es-foundations-u4-indefinido-e1", kind = "choice", prompt = "Ayer ___ al cine con mi hermana.", options = listOf("fui", "voy", "iba", "voy a ir"), answers = listOf("fui"), explain = "ir → fui (pretérito)."), Exercise(id = "es-foundations-u4-indefinido-e2", kind = "gap", prompt = "Anoche ___ una paella increíble. (comer)", options = listOf(), answers = listOf("comí", "comi"), explain = "comer → comí."), Exercise(id = "es-foundations-u4-indefinido-e3", kind = "order", prompt = "Pregunta por el finde.", options = listOf(), answers = listOf("Que hiciste el fin de semana"), explain = "¿Qué hiciste el fin de semana?"), Exercise(id = "es-foundations-u4-indefinido-e4", kind = "written", prompt = "Di una acción en pasado: hablar con Marta.", options = listOf(), answers = listOf("hablé con marta", "hablé con marta ayer"), explain = "hablar → hablé.")), skills = listOf("grammar:past-simple-regular", "grammar:past-simple-irregular", "grammar:time-expressions", "function:describe-past-events"), canDo = listOf("describe-past-events"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "es-foundations-u4-comparando", title = "Comparando", goal = "Comparar dos cosas con más/menos… que y el mejor/peor.", intro = LessonIntro(explanation = listOf("Comparativos: más/menos + adjetivo + que. «Este hotel es más caro que aquel». «Menos frío que ayer».", "Superlativos: el/la más/menos + adjetivo + de. «El mejor restaurante de la ciudad».", "Irregulares: mejor (bueno), peor (malo). «Este es mejor que aquel»."), examples = listOf(ExampleLine(text = "Este hotel es más caro que aquel.", meaning = "más + adjetivo + que."), ExampleLine(text = "La playa es menos concurrida que la piscina.", meaning = "menos + adjetivo."), ExampleLine(text = "Es el mejor restaurante de la ciudad.", meaning = "el mejor + de."), ExampleLine(text = "Este verano es peor que el pasado.", meaning = "peor = malo comparado."), ExampleLine(text = "Tan simple como eso.", meaning = "tan + adjetivo + como."))), expressions = listOf(TargetExpression(text = "más … que", meaning = "Más que.", note = "más caro que."), TargetExpression(text = "menos … que", meaning = "Menos que.", note = "menos frío que."), TargetExpression(text = "el/la más … de", meaning = "Superlativo.", note = "el más alto de la clase."), TargetExpression(text = "mejor / peor", meaning = "Irregulares.", note = "mejor que, el peor de."), TargetExpression(text = "tan … como", meaning = "Igualdad.", note = "tan caro como antes.")), situation = "Comparáis dos hoteles para las vacaciones: precio, ubicación, limpieza — y elegís el mejor.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Compara el precio: hotel A 80€, hotel B 100€.", expected = listOf("El hotel A es más barato que el hotel B."), focus = "más barato", watch = "barato → más barato que."), PracticeQuestion(prompt = "Di cuál es el mejor. (hotel A)", expected = listOf("El hotel A es el mejor."), focus = "el mejor", watch = "el mejor + de/in."), PracticeQuestion(prompt = "Di que el hotel B es peor.", expected = listOf("El hotel B es peor que el A."), focus = "peor", watch = "peor que — irregular."), PracticeQuestion(prompt = "Compara ubicación: A cerca, B lejos.", expected = listOf("El hotel A está más cerca del centro."), focus = "más cerca", watch = "cerca → más cerca de."), PracticeQuestion(prompt = "Di que son iguales en limpieza.", expected = listOf("Son tan limpios como el otro."), focus = "tan como", watch = "tan + adjetivo + como = igualdad."))), exercises = listOf(Exercise(id = "es-foundations-u4-comparando-e1", kind = "choice", prompt = "Este hotel es ___ caro ___ aquel.", options = listOf("más … que", "más … de", "tan … que", "muy … que"), answers = listOf("más … que"), explain = "más + adjetivo + que."), Exercise(id = "es-foundations-u4-comparando-e2", kind = "gap", prompt = "Es el ___ restaurante de la ciudad. (bueno)", options = listOf(), answers = listOf("mejor"), explain = "bueno → el mejor."), Exercise(id = "es-foundations-u4-comparando-e3", kind = "order", prompt = "Compara precio.", options = listOf(), answers = listOf("Este es más barato que aquel"), explain = "más + adjetivo + que."), Exercise(id = "es-foundations-u4-comparando-e4", kind = "written", prompt = "Di tu restaurante favorito.", options = listOf(), answers = listOf("mi restaurante favorito es <nombre>", "el mejor es <nombre>"), explain = "Mi favorito es X.")), skills = listOf("grammar:comparatives", "grammar:superlatives", "grammar:connectors", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:comparatives")),
    Lesson(id = "es-foundations-u4-futuro", title = "El futuro", goal = "Hablar de planes con ir a + infinitivo y expresar intención.", intro = LessonIntro(explanation = listOf("El futuro cercano: ir a + infinitivo. «Voy a estudiar esta noche». «Vamos a viajar en verano».", "Preguntar: «¿Vas a venir?» «¿Qué vas a hacer?» — el verbo ir se conjuga, el infinitivo no.", "Irregulares en el infinitivo se mantienen: «Voy a hacer la cena» (no «hacer» cambia)."), examples = listOf(ExampleLine(text = "Voy a estudiar esta noche.", meaning = "ir a + infinitivo."), ExampleLine(text = "Vamos a viajar en verano.", meaning = "Nosotros: vamos a."), ExampleLine(text = "¿Vas a venir a la fiesta?", meaning = "Pregunta con ir a."), ExampleLine(text = "Va a llover, no salgas.", meaning = "Predicción: va a + verbo."), ExampleLine(text = "No voy a trabajar el sábado.", meaning = "Negativo: no voy a."))), expressions = listOf(TargetExpression(text = "voy / vas / va a + inf", meaning = "El futuro cercano.", note = "Voy a comer."), TargetExpression(text = "vamos a + inf", meaning = "Nosotros.", note = "Vamos a viajar."), TargetExpression(text = "¿Vas a + inf?", meaning = "Preguntar.", note = "¿Vas a venir?"), TargetExpression(text = "no voy a + inf", meaning = "Negar el plan.", note = "No voy a salir."), TargetExpression(text = "va a + inf (clima)", meaning = "Predicción.", note = "Va a llover.")), situation = "Planificáis el finde: uno propone, el otro acepta o rechaza, y decidís hora y lugar.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di qué vas a hacer este finde. (descansar)", expected = listOf("Voy a descansar este finde."), focus = "voy a", watch = "voy a + infinitivo."), PracticeQuestion(prompt = "Pregunta qué va a hacer tu amigo.", expected = listOf("¿Qué vas a hacer?"), focus = "la pregunta", watch = "¿Qué + vas a + infinitivo?"), PracticeQuestion(prompt = "Di que no vas a salir el sábado.", expected = listOf("No voy a salir el sábado."), focus = "no voy a", watch = "no voy a + infinitivo."), PracticeQuestion(prompt = "Di que va a llover mañana.", expected = listOf("Mañana va a llover."), focus = "predicción", watch = "va a + infinitivo para predicción."), PracticeQuestion(prompt = "Pregunta si tu amigo va a venir.", expected = listOf("¿Vas a venir?"), focus = "¿Vas a…?", watch = "Vas a + infinitivo."))), exercises = listOf(Exercise(id = "es-foundations-u4-futuro-e1", kind = "choice", prompt = "Voy ___ descansar este finde.", options = listOf("a", "de", "que", "para"), answers = listOf("a"), explain = "ir A + infinitivo."), Exercise(id = "es-foundations-u4-futuro-e2", kind = "gap", prompt = "Vamos ___ ___ al cine. (ir a + ir)", options = listOf(), answers = listOf("a ir", "a ir"), explain = "vamos a ir."), Exercise(id = "es-foundations-u4-futuro-e3", kind = "order", prompt = "Pregunta sobre el plan.", options = listOf(), answers = listOf("Que vas a hacer este finde"), explain = "¿Qué vas a hacer este finde?"), Exercise(id = "es-foundations-u4-futuro-e4", kind = "written", prompt = "Di un plan para mañana.", options = listOf(), answers = listOf("voy a <actividad> mañana", "mañana voy a <actividad>"), explain = "Voy a + verbo.")), skills = listOf("grammar:going-to", "function:make-future-plans", "grammar:future-forms", "vocab:social-expressions"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to"))))
}

object EsFoundationsU7 {
    val unit = CourseUnit(id = "es-foundations-u7", title = "Comparar y planear", subtitle = "Mejor o peor", level = "A2", themes = listOf(ConversationTheme("dos-pisos", "Dos pisos", "Cuál es mejor", "house", "Course", "Comparáis dos pisos para alquilar: uno más barato, el otro más luminoso.", 0),
                ConversationTheme("plan-finde", "El plan del finde", "Qué vais a hacer", "calendar", "Course", "Organizáis el fin de semana: qué vais a hacer, a qué hora y dónde quedar.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u7-comparando", title = "Comparando pisos", goal = "Comparar opciones con comparativos y superlativos y dar tu opinión.", intro = LessonIntro(explanation = listOf("El comparativo: « más … que ». « Este piso es más barato que el otro ».", "Los irregulares: « mejor » (bien) y « peor » (mal). « Este es mejor, pero está peor situado ».", "El superlativo: « el más luminoso de los dos ». « Es la zona más tranquila del barrio »."), examples = listOf(ExampleLine(text = "Este piso es más barato que el otro.", meaning = "Comparativo."), ExampleLine(text = "Es más pequeño, pero más luminoso.", meaning = "pero + matiz."), ExampleLine(text = "La cocina es la mejor de las dos.", meaning = "Superlativo irregular."), ExampleLine(text = "Está peor situado.", meaning = "peor = estar mal situado."), ExampleLine(text = "Para mí, es la mejor opción.", meaning = "Opinión."))), expressions = listOf(TargetExpression(text = "más … que", meaning = "Comparativo.", note = "más barato que."), TargetExpression(text = "mejor / peor", meaning = "Irregulares.", note = "bien→mejor, mal→peor."), TargetExpression(text = "el/la más … de", meaning = "Superlativo.", note = "el más luminoso de."), TargetExpression(text = "Para mí, …", meaning = "Opinión.", note = "Para mí, es la mejor."), TargetExpression(text = "no tan … como", meaning = "Igualdad negativa.", note = "No es tan caro como parece.")), situation = "Comparamos dos pisos en la app de alquiler: precio, tamaño, luz y barrio, y decidimos cuál pedir visita.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di que este piso es más barato que el otro.", expected = listOf("Este piso es más barato que el otro."), focus = "más … que", watch = "más + adjetivo + que."), PracticeQuestion(prompt = "Di que la cocina es la mejor de las dos.", expected = listOf("La cocina es la mejor de las dos."), focus = "mejor", watch = "mejor (irregular), no «más bueno»."), PracticeQuestion(prompt = "Di que está peor situado.", expected = listOf("Está peor situado."), focus = "peor", watch = "peor, no «más malo»."), PracticeQuestion(prompt = "Da tu opinión: es la mejor opción.", expected = listOf("Para mí es la mejor opción.", "Para mí, es la mejor opción."), focus = "para mí", watch = "Para mí + opinión."), PracticeQuestion(prompt = "Di que no es tan caro como parece.", expected = listOf("No es tan caro como parece."), focus = "tan … como", watch = "no tan + adjetivo + como."))), exercises = listOf(Exercise(id = "es-foundations-u7-comparando-e1", kind = "choice", prompt = "Este piso es ___ barato ___ el otro.", options = listOf("más / que", "muy / que", "más / como", "tan / que"), answers = listOf("más / que"), explain = "Comparativo: más + adjetivo + que."), Exercise(id = "es-foundations-u7-comparando-e2", kind = "gap", prompt = "La cocina es la ___ de las dos. (bueno)", options = listOf(), answers = listOf("mejor"), explain = "Superlativo irregular: bueno → el mejor."), Exercise(id = "es-foundations-u7-comparando-e3", kind = "order", prompt = "Compara: este barrio es el más tranquilo.", options = listOf(), answers = listOf("Este barrio es el más tranquilo"), explain = "el más + adjetivo."), Exercise(id = "es-foundations-u7-comparando-e4", kind = "written", prompt = "Compara: tu barrio es más tranquilo que este.", options = listOf(), answers = listOf("mi barrio es más tranquilo que este", "mi barrio es más tranquilo"), explain = "más + adjetivo + que.")), skills = listOf("grammar:comparatives", "grammar:superlatives", "grammar:connectors", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:comparatives")),
    Lesson(id = "es-foundations-u7-plan", title = "El plan del finde", goal = "Hablar de planes con ir a + infinitivo y quedar a una hora.", intro = LessonIntro(explanation = listOf("El futuro cercano: « ir a + infinitivo ». « Vamos a cenar fuera el sábado ».", "Preguntar planes: « ¿Qué vas a hacer ? ». « ¿Vienes con nosotros ? ».", "Quedar: « Quedamos a las ocho en la plaza ». « ¿A qué hora nos vemos ? »."), examples = listOf(ExampleLine(text = "Vamos a cenar fuera el sábado.", meaning = "ir a + infinitivo."), ExampleLine(text = "¿Qué vas a hacer ?", meaning = "Preguntar planes."), ExampleLine(text = "Voy a visitar a mi hermana.", meaning = "voy a + infinitivo."), ExampleLine(text = "Quedamos a las ocho en la plaza.", meaning = "Quedar + hora + lugar."), ExampleLine(text = "¿A qué hora nos vemos ?", meaning = "Cerrar el plan."))), expressions = listOf(TargetExpression(text = "ir a + infinitivo", meaning = "Futuro cercano.", note = "vamos a cenar."), TargetExpression(text = "¿Qué vas a hacer ?", meaning = "Preguntar planes.", note = "vas a + infinitivo."), TargetExpression(text = "Quedamos a las + hora", meaning = "Quedar.", note = "a las ocho."), TargetExpression(text = "¿Te viene bien ?", meaning = "Confirmar hora.", note = "¿Te viene bien el sábado ?"), TargetExpression(text = "Nos vemos en + lugar", meaning = "Cita.", note = "en la plaza.")), situation = "Organizáis el sábado: uno propone montaña, el otro mercado; acabáis quedando a las diez para ir al lago.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Propón: vamos a cenar fuera el sábado.", expected = listOf("Vamos a cenar fuera el sábado."), focus = "vamos a", watch = "ir a + infinitivo."), PracticeQuestion(prompt = "Pregunta qué va a hacer.", expected = listOf("Qué vas a hacer ?", "¿Qué vas a hacer ?"), focus = "qué vas a", watch = "¿Qué + vas a hacer ?"), PracticeQuestion(prompt = "Di que vas a visitar a tu hermana.", expected = listOf("Voy a visitar a mi hermana."), focus = "voy a", watch = "voy a + infinitivo."), PracticeQuestion(prompt = "Propón quedar a las ocho en la plaza.", expected = listOf("Quedamos a las ocho en la plaza."), focus = "quedamos", watch = "Quedamos a las + hora."), PracticeQuestion(prompt = "Pregunta a qué hora os veis.", expected = listOf("A qué hora nos vemos ?", "¿A qué hora nos vemos ?"), focus = "a qué hora", watch = "¿A qué hora + nos vemos ?"))), exercises = listOf(Exercise(id = "es-foundations-u7-plan-e1", kind = "choice", prompt = "Mañana ___ visitar el museo.", options = listOf("vamos a", "vamos de", "vamos que", "vamos por"), answers = listOf("vamos a"), explain = "ir a + infinitivo."), Exercise(id = "es-foundations-u7-plan-e2", kind = "gap", prompt = "Quedamos ___ las ocho. (hora)", options = listOf(), answers = listOf("a"), explain = "a las + hora."), Exercise(id = "es-foundations-u7-plan-e3", kind = "order", prompt = "Cierra el plan: nos vemos en la plaza.", options = listOf(), answers = listOf("Nos vemos a las ocho en la plaza"), explain = "nos vemos + hora + lugar."), Exercise(id = "es-foundations-u7-plan-e4", kind = "written", prompt = "Di lo que vas a hacer el fin de semana: descansar.", options = listOf(), answers = listOf("voy a descansar", "voy a descansar el fin de semana"), explain = "voy a + infinitivo.")), skills = listOf("grammar:going-to", "function:make-future-plans", "grammar:future-forms", "vocab:social-expressions"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to"))))
}

object EsFoundationsU18 {
    val unit = CourseUnit(id = "es-foundations-u18", title = "Quedar bien", subtitle = "Invitaciones y planes", level = "A2", themes = listOf(ConversationTheme("propuestas", "¿Vienes?", "Propuestas y excusas", "calendar.badge.clock", "Course", "Proponéis planes de semana: alguien se apunta, alguien pone una excusa.", 0),
                ConversationTheme("el-regalo", "El regalo", "Planes con ir a", "gift", "Course", "Organizáis un regalo de cumpleaños: qué vais a comprarle y cuándo.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u18-propuestas", title = "¿Vienes o prefieres…?", goal = "Hacer propuestas y responder: aceptar, dudar o preferir otra cosa.", intro = LessonIntro(explanation = listOf("Para proponer: «¿Vienes al cine?» o «¿Por qué no vamos a la playa?». La pregunta suaviza el plan.", "También proponemos con ir a: «Vamos a ir de excursión el sábado, ¿te apuntas?».", "Para responder: aceptas «Vale, me apunto», dudas «Déjame pensarlo» o prefieres «Prefiero quedar el domingo»."), examples = listOf(ExampleLine(text = "¿Vienes al cine esta tarde?", meaning = "Proponer un plan."), ExampleLine(text = "¿Por qué no vamos a la playa?", meaning = "Proponer con ¿por qué no…?"), ExampleLine(text = "Vale, me apunto.", meaning = "Aceptar."), ExampleLine(text = "No sé, déjame pensarlo.", meaning = "Dudar."), ExampleLine(text = "Prefiero quedar el domingo.", meaning = "Preferir otra cosa."))), expressions = listOf(TargetExpression(text = "¿Vienes a…?", meaning = "Invitar a un plan.", note = "¿Vienes a cenar?"), TargetExpression(text = "¿Por qué no + presente?", meaning = "Proponer.", note = "¿Por qué no lo probamos?"), TargetExpression(text = "me apunto", meaning = "Aceptar un plan.", note = "¡Me apunto!"), TargetExpression(text = "déjame pensarlo", meaning = "Dudar.", note = "Déjame pensarlo y te digo."), TargetExpression(text = "prefiero + infinitivo", meaning = "Preferir.", note = "Prefiero ir en tren.")), situation = "Propones plan de sábado a tu grupo: cine o excursión; unos se apuntan y otros prefieren el domingo.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Propón el cine para esta tarde.", expected = listOf("¿Vienes al cine esta tarde?", "Vienes al cine esta tarde"), focus = "¿vienes…?", watch = "Vienes + a + plan."), PracticeQuestion(prompt = "Propón ir a la playa con ¿por qué no?", expected = listOf("¿Por qué no vamos a la playa?", "¿Por que no vamos a la playa?"), focus = "¿por qué no?", watch = "por qué con tilde."), PracticeQuestion(prompt = "Acepta el plan.", expected = listOf("Vale, me apunto", "Me apunto", "Vale me apunto"), focus = "me apunto", watch = "me apunto = acepto."), PracticeQuestion(prompt = "Di que necesitas pensarlo.", expected = listOf("Déjame pensarlo", "dejame pensarlo", "No sé, déjame pensarlo"), focus = "déjame", watch = "déjame lleva tilde."), PracticeQuestion(prompt = "Di que prefieres quedar en casa.", expected = listOf("Prefiero quedarme en casa", "prefiero quedar en casa"), focus = "prefiero", watch = "prefiero + infinitivo."))), exercises = listOf(Exercise(id = "es-foundations-u18-propuestas-e1", kind = "choice", prompt = "¿Por qué no ___ al museo el sábado?", options = listOf("vamos", "vamos a", "fuimos", "iremos"), answers = listOf("vamos"), explain = "¿Por qué no + presente? propone un plan."), Exercise(id = "es-foundations-u18-propuestas-e2", kind = "gap", prompt = "¿Te ___ al concierto del viernes?", options = listOf(), answers = listOf("apuntas", "Apuntas"), explain = "¿Te apuntas? invita a unirse al plan."), Exercise(id = "es-foundations-u18-propuestas-e3", kind = "order", prompt = "Acepta la propuesta para ir de excursión.", options = listOf(), answers = listOf("Vale, me apunto a la excursión"), explain = "me apunto = aceptar el plan."), Exercise(id = "es-foundations-u18-propuestas-e4", kind = "written", prompt = "Di que prefieres ir el domingo.", options = listOf(), answers = listOf("prefiero ir el domingo", "Prefiero ir el domingo"), explain = "prefiero + infinitivo.")), skills = listOf("function:make-suggestions", "grammar:going-to", "vocab:social-expressions", "grammar:present-simple"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "es-foundations-u18-excusa", title = "Qué pena, no puedo", goal = "Aceptar y rechazar invitaciones con excusas amables: qué pena, es que…, lo siento.", intro = LessonIntro(explanation = listOf("Para rechazar con tacto, la pena va primero: «¡Qué pena! No puedo ir».", "La excusa se introduce con es que: «Es que tengo que trabajar». Suaviza el no.", "El rechazo deja el plan abierto con conectores: «Entonces, ¿el sábado?», «Tengo fiesta, así que no puedo»."), examples = listOf(ExampleLine(text = "¡Qué pena! No puedo ir.", meaning = "Rechazar con pena."), ExampleLine(text = "Es que tengo que trabajar.", meaning = "Explicar la excusa."), ExampleLine(text = "Lo siento, tengo planes.", meaning = "Rechazar corto."), ExampleLine(text = "Entonces, ¿el sábado?", meaning = "Dejar el plan abierto."), ExampleLine(text = "Tengo fiesta, así que no puedo.", meaning = "así que + consecuencia."))), expressions = listOf(TargetExpression(text = "¡qué pena!", meaning = "Lamenta el no.", note = "¡Qué pena, no puedo!"), TargetExpression(text = "es que…", meaning = "Introduce la excusa.", note = "Es que estoy resfriado."), TargetExpression(text = "lo siento", meaning = "Rechazar amable.", note = "Lo siento, no puedo."), TargetExpression(text = "tengo que + infinitivo", meaning = "Obligación.", note = "Tengo que estudiar."), TargetExpression(text = "¿el finde que viene?", meaning = "Reprogramar.", note = "¿Mejor el finde que viene?")), situation = "Te invitan a un concierto el jueves, pero trabajas hasta las diez: rechazas con pena y propones el sábado.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Rechaza la invitación con pena.", expected = listOf("¡Qué pena, no puedo!", "Qué pena, no puedo", "que pena no puedo"), focus = "qué pena", watch = "qué con tilde."), PracticeQuestion(prompt = "Da tu excusa: trabajar.", expected = listOf("Es que tengo que trabajar", "es que tengo que trabajar"), focus = "es que", watch = "es que + excusa."), PracticeQuestion(prompt = "Rechaza corto y amable.", expected = listOf("Lo siento, no puedo", "lo siento no puedo"), focus = "lo siento", watch = "lo siento + no puedo."), PracticeQuestion(prompt = "Propón el fin de semana que viene.", expected = listOf("¿El finde que viene?", "¿Mejor el finde que viene?", "¿El fin de semana que viene?"), focus = "que viene", watch = "finde = fin de semana."), PracticeQuestion(prompt = "Di que tienes planes, con así que.", expected = listOf("Tengo planes, así que no puedo", "tengo planes asi que no puedo"), focus = "así que", watch = "así lleva tilde."))), exercises = listOf(Exercise(id = "es-foundations-u18-excusa-e1", kind = "choice", prompt = "___ pena, mañana no puedo.", options = listOf("Qué", "Que", "Cuál", "Cómo"), answers = listOf("Qué"), explain = "¡Qué pena! lleva tilde: lamenta el no."), Exercise(id = "es-foundations-u18-excusa-e2", kind = "gap", prompt = "Lo siento, ___ que tengo que estudiar.", options = listOf(), answers = listOf("es", "Es"), explain = "es que + excusa suaviza el no."), Exercise(id = "es-foundations-u18-excusa-e3", kind = "order", prompt = "Rechaza y deja un plan para después.", options = listOf(), answers = listOf("Entonces, ¿mejor el sábado?"), explain = "Entonces retoma el plan; mejor propone otra fecha."), Exercise(id = "es-foundations-u18-excusa-e4", kind = "written", prompt = "Di que no puedes ir porque tienes que trabajar.", options = listOf(), answers = listOf("no puedo ir porque tengo que trabajar", "No puedo ir porque tengo que trabajar", "es que tengo que trabajar"), explain = "porque / es que introducen la causa.")), skills = listOf("vocab:social-expressions", "function:make-suggestions", "grammar:present-simple", "grammar:connectors"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "es-foundations-u18-regalo", title = "El regalo perfecto", goal = "Planear un regalo con ir a: qué vais a comprarle, dónde y para quién.", intro = LessonIntro(explanation = listOf("El plan del regalo va con ir a + infinitivo: «Voy a comprarle un libro».", "El pronombre se pega al infinitivo: «comprarle», «regalarle». Le = a él o a ella.", "Para organizaros: «¿Qué le vamos a regalar?». «Vamos a mirar en la tienda nueva»."), examples = listOf(ExampleLine(text = "Voy a comprarle un libro.", meaning = "Tu plan de regalo."), ExampleLine(text = "Vamos a regalarle unas flores.", meaning = "El plan del grupo."), ExampleLine(text = "¿Qué le vamos a regalar?", meaning = "Preguntar por el plan."), ExampleLine(text = "Voy a mirar en la tienda nueva.", meaning = "Buscar el regalo."), ExampleLine(text = "Le va a encantar.", meaning = "Predecir su reacción."))), expressions = listOf(TargetExpression(text = "ir a + infinitivo", meaning = "Futuro cercano.", note = "Voy a comprarle algo."), TargetExpression(text = "comprarle / regalarle", meaning = "le pegado al infinitivo.", note = "Voy a regalarle un reloj."), TargetExpression(text = "le va a encantar", meaning = "Predecir su reacción.", note = "Le va a encantar, seguro."), TargetExpression(text = "¿qué le vamos a regalar?", meaning = "Preguntar el plan.", note = "¿Qué le vamos a regalar a Lucía?"), TargetExpression(text = "es una sorpresa", meaning = "Guardar el secreto.", note = "Shh, es una sorpresa.")), situation = "El cumpleaños de Lucía es el sábado: vais a regalarle unos auriculares; tú vas a mirarlos hoy a la tienda nueva.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di tu plan: comprarle un libro.", expected = listOf("Voy a comprarle un libro", "voy a comprarle un libro"), focus = "voy a", watch = "comprar + le = comprarle."), PracticeQuestion(prompt = "Pregunta qué vais a regalarle a Lucía.", expected = listOf("¿Qué le vamos a regalar a Lucía?", "¿Que le vamos a regalar a Lucia?"), focus = "¿qué le…?", watch = "qué con tilde."), PracticeQuestion(prompt = "Di que vais a regalarle flores.", expected = listOf("Vamos a regalarle flores", "vamos a regalarle flores"), focus = "regalarle", watch = "regalar + le."), PracticeQuestion(prompt = "Predice su reacción: encantar.", expected = listOf("Le va a encantar", "le va a encantar", "Seguro que le va a encantar"), focus = "le va a encantar", watch = "le = a Lucía."), PracticeQuestion(prompt = "Guarda el secreto.", expected = listOf("Es una sorpresa", "es una sorpresa"), focus = "sorpresa", watch = "Shh, es una sorpresa."))), exercises = listOf(Exercise(id = "es-foundations-u18-regalo-e1", kind = "choice", prompt = "Le ___ a encantar.", options = listOf("va", "voy", "van", "vas"), answers = listOf("va"), explain = "le va a encantar: la tercera persona."), Exercise(id = "es-foundations-u18-regalo-e2", kind = "gap", prompt = "Vamos a ___ unas flores. (regalar + le)", options = listOf(), answers = listOf("regalarle", "Regalarle"), explain = "regalar + le = regalarle, pegado al infinitivo."), Exercise(id = "es-foundations-u18-regalo-e3", kind = "order", prompt = "Di qué vas a hacer con el dinero del grupo.", options = listOf(), answers = listOf("Voy a comprarle un libro"), explain = "voy a + comprarle: plan de regalo."), Exercise(id = "es-foundations-u18-regalo-e4", kind = "written", prompt = "Pregunta al grupo por el regalo de tu jefe.", options = listOf(), answers = listOf("¿Qué le vamos a regalar?", "¿Que le vamos a regalar?", "qué le vamos a regalar"), explain = "le vamos a regalar: futuro cercano.")), skills = listOf("grammar:going-to", "function:make-future-plans", "vocab:social-expressions", "function:go-shopping"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "es-foundations-u18-quedar", title = "¿A qué hora quedamos?", goal = "Concretar la hora y el lugar de un plan: quedar a las…, quedar en…, nos vemos.", intro = LessonIntro(explanation = listOf("Para cerrar un plan usamos quedar: «¿Quedamos a las ocho en la plaza?». Fija hora y lugar en una sola pregunta.", "La hora va con a («a las ocho y media») y el lugar con en («en la puerta del cine»).", "Para confirmar, repites el plan: «Entonces, a las ocho en la plaza, ¿no?». Y si te retrasas, avisas: «Voy a llegar cinco minutos tarde»."), examples = listOf(ExampleLine(text = "¿A qué hora quedamos?", meaning = "Preguntar por la hora del plan."), ExampleLine(text = "Quedamos a las ocho y media.", meaning = "Concretar la hora."), ExampleLine(text = "¿Dónde nos vemos?", meaning = "Preguntar por el lugar."), ExampleLine(text = "Quedamos en la puerta del cine.", meaning = "Concretar el lugar."), ExampleLine(text = "Voy a llegar cinco minutos tarde.", meaning = "Avisar de un retraso."))), expressions = listOf(TargetExpression(text = "¿a qué hora…?", meaning = "Preguntar la hora.", note = "¿A qué hora quedamos?"), TargetExpression(text = "quedar a las + hora", meaning = "Fijar la hora.", note = "Quedamos a las siete."), TargetExpression(text = "quedar en + lugar", meaning = "Fijar el lugar.", note = "Quedamos en la plaza."), TargetExpression(text = "nos vemos en…", meaning = "Confirmar el punto de encuentro.", note = "Nos vemos en el metro."), TargetExpression(text = "llegar tarde", meaning = "Avisar de un retraso.", note = "Voy a llegar diez minutos tarde.")), situation = "Cierras el plan del sábado con tu amiga: acordáis hora, lugar y avisas si vas a llegar tarde.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pregunta a qué hora quedáis.", expected = listOf("¿A qué hora quedamos?", "a que hora quedamos", "¿A qué hora nos vemos?"), focus = "a qué hora", watch = "qué con tilde."), PracticeQuestion(prompt = "Di que quedáis a las ocho y media.", expected = listOf("Quedamos a las ocho y media", "quedamos a las 8 y media", "Nos vemos a las ocho y media"), focus = "quedar a las", watch = "a las + hora."), PracticeQuestion(prompt = "Pregunta por el lugar del encuentro.", expected = listOf("¿Dónde nos vemos?", "donde nos vemos", "¿Dónde quedamos?"), focus = "dónde", watch = "dónde con tilde."), PracticeQuestion(prompt = "Di que quedáis en la puerta del cine.", expected = listOf("Quedamos en la puerta del cine", "Nos vemos en la puerta del cine", "quedamos en la puerta del cine"), focus = "quedar en", watch = "en + lugar."), PracticeQuestion(prompt = "Avisa de que llegarás cinco minutos tarde.", expected = listOf("Voy a llegar cinco minutos tarde", "voy a llegar 5 minutos tarde", "Llego cinco minutos tarde"), focus = "llegar tarde", watch = "voy a + infinitivo."))), exercises = listOf(Exercise(id = "es-foundations-u18-quedar-e1", kind = "choice", prompt = "¿Quedamos ___ la puerta del teatro?", options = listOf("en", "a", "de", "para"), answers = listOf("en"), explain = "El lugar de encuentro va con en: quedar en + lugar."), Exercise(id = "es-foundations-u18-quedar-e2", kind = "gap", prompt = "Nos ___ en la cafetería de la plaza a las siete.", options = listOf(), answers = listOf("vemos", "Vemos"), explain = "Nos vemos = quedamos; confirma el punto de encuentro."), Exercise(id = "es-foundations-u18-quedar-e3", kind = "order", prompt = "Avisa de que vas a llegar tarde al plan.", options = listOf(), answers = listOf("Voy a llegar diez minutos tarde"), explain = "Para avisar del retraso: voy a llegar + tiempo + tarde."), Exercise(id = "es-foundations-u18-quedar-e4", kind = "written", prompt = "Propón quedar mañana a las siete.", options = listOf(), answers = listOf("¿Quedamos mañana a las siete?", "quedamos mañana a las siete", "Quedamos manana a las siete"), explain = "¿Quedamos + tiempo? propone el plan y pregunta a la vez.")), skills = listOf("function:make-suggestions", "grammar:time-expressions", "grammar:present-simple", "vocab:social-expressions"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:time-expressions"))))
}

object EsFoundationsU21 {
    val unit = CourseUnit(id = "es-foundations-u21", title = "Problemas del día a día", subtitle = "Averías y soluciones", level = "A2", themes = listOf(ConversationTheme("la-averia", "La avería", "Contar qué pasó", "wrench.and.screwdriver", "Course", "Contáis una avería de casa: qué se estropeó, cuándo pasó y a quién llamasteis.", 0),
                ConversationTheme("la-solucion", "La solución", "Arreglar y reclamar", "phone.badge.checkmark", "Course", "Buscáis soluciones tranquilas: pedís ayuda, probáis pasos sencillos y reclamáis por teléfono.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u21-averia", title = "Se ha estropeado", goal = "Contar una avería en pasado: se estropeó, se rompió, dejó de funcionar y llamé al técnico.", intro = LessonIntro(explanation = listOf("La avería se cuenta en pasado: «La lavadora se estropeó ayer», «Se rompió la pantalla del móvil».", "Hay irregulares muy frecuentes: «Se me cayó el móvil», «Hizo un ruido raro y paró».", "Después cuentas la reacción: «Llamé al técnico», «Busqué el número en internet»."), examples = listOf(ExampleLine(text = "La lavadora se estropeó ayer.", meaning = "Contar la avería."), ExampleLine(text = "Se rompió la pantalla.", meaning = "El daño concreto."), ExampleLine(text = "Se me cayó el móvil al suelo.", meaning = "Irregular: caer → cayó."), ExampleLine(text = "Hizo un ruido raro y paró.", meaning = "Irregular: hacer → hizo."), ExampleLine(text = "Llamé al técnico por la mañana.", meaning = "Tu reacción en pasado."))), expressions = listOf(TargetExpression(text = "se estropeó", meaning = "Dejó de funcionar.", note = "La nevera se estropeó."), TargetExpression(text = "se rompió", meaning = "Se partió o se dañó.", note = "Se rompió la pantalla."), TargetExpression(text = "dejó de funcionar", meaning = "Regular: dejó de + infinitivo.", note = "La luz dejó de funcionar."), TargetExpression(text = "se me cayó", meaning = "Irregular: caer → cayó.", note = "Se me cayó el vaso."), TargetExpression(text = "llamé a + persona", meaning = "Tu reacción en pasado.", note = "Llamé al técnico.")), situation = "Cuentas el desastre del fin de semana: la lavadora se estropeó el sábado, el móvil se te cayó y, al final, llamaste al técnico.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Cuenta la avería: la lavadora, ayer.", expected = listOf("La lavadora se estropeó ayer", "la lavadora se estropeo ayer"), focus = "se estropeó", watch = "estropeó lleva tilde."), PracticeQuestion(prompt = "Di el daño: la pantalla del móvil.", expected = listOf("Se rompió la pantalla", "se rompio la pantalla"), focus = "se rompió", watch = "rompió con tilde."), PracticeQuestion(prompt = "Cuenta el giro: el móvil, al suelo.", expected = listOf("Se me cayó el móvil", "se me cayo el movil"), focus = "se me cayó", watch = "cayó: irregular de caer."), PracticeQuestion(prompt = "Di la reacción: llamar al técnico.", expected = listOf("Llamé al técnico", "llame al tecnico"), focus = "llamé", watch = "llamó vs llamé: tú llamaste, yo llamé."), PracticeQuestion(prompt = "Di que la nevera dejó de funcionar.", expected = listOf("La nevera dejó de funcionar", "la nevera dejo de funcionar"), focus = "dejó de", watch = "dejó de + infinitivo."))), exercises = listOf(Exercise(id = "es-foundations-u21-averia-e1", kind = "choice", prompt = "La lavadora ___ de funcionar ayer.", options = listOf("dejó", "deja", "dejará", "dejar"), answers = listOf("dejó"), explain = "Pasado regular: dejó de funcionar = se estropeó; dejó lleva tilde."), Exercise(id = "es-foundations-u21-averia-e2", kind = "gap", prompt = "Se me ___ el móvil al suelo y se rompió la pantalla. (caer, pasado)", options = listOf(), answers = listOf("cayó", "cayo", "Cayó"), explain = "cayó: pasado irregular de caer; lleva tilde en la última sílaba."), Exercise(id = "es-foundations-u21-averia-e3", kind = "order", prompt = "Cuenta la avería de la nevera: fue ayer.", options = listOf(), answers = listOf("La nevera se estropeó ayer"), explain = "se estropeó + tiempo: la estructura mínima para contar una avería."), Exercise(id = "es-foundations-u21-averia-e4", kind = "written", prompt = "Cuenta tu reacción: llamar al técnico por teléfono.", options = listOf(), answers = listOf("llamé al técnico por teléfono", "llame al tecnico por telefono", "llamé al técnico"), explain = "llamé: primera persona del pasado; llamó es él o ella.")), skills = listOf("function:solve-problems", "grammar:past-simple-regular", "grammar:past-simple-irregular", "function:describe-past-events"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "es-foundations-u21-solucion", title = "¿Qué hago?", goal = "Pedir y dar soluciones sencillas: ¿qué hago?, ¿puedes echarme una mano?, prueba a…, si no funciona, llama.", intro = LessonIntro(explanation = listOf("Para pedir ayuda: «¿Qué hago?», «¿Puedes echarme una mano?». Echar una mano es ayudar.", "Para dar soluciones, un paso cada vez: «Prueba a apagarlo y encenderlo», «Mira si está enchufado».", "Los conectores encadenan el plan: «Primero mira el enchufe; después prueba otra vez»."), examples = listOf(ExampleLine(text = "¿Qué hago?", meaning = "Pedir consejo."), ExampleLine(text = "¿Puedes echarme una mano?", meaning = "Pedir ayuda."), ExampleLine(text = "Prueba a apagarlo y encenderlo.", meaning = "Dar una solución sencilla."), ExampleLine(text = "Mira si está enchufado.", meaning = "El primer paso."), ExampleLine(text = "Si no funciona, llama al técnico.", meaning = "El plan B con si."))), expressions = listOf(TargetExpression(text = "¿qué hago?", meaning = "Pedir consejo.", note = "No va la wifi, ¿qué hago?"), TargetExpression(text = "echar una mano", meaning = "Ayudar.", note = "¿Me echas una mano?"), TargetExpression(text = "prueba a + infinitivo", meaning = "Sugerir un paso.", note = "Prueba a reiniciarlo."), TargetExpression(text = "si no funciona, …", meaning = "El plan B.", note = "Si no funciona, llama."), TargetExpression(text = "primero…, después…", meaning = "Ordenar los pasos.", note = "Primero mira; después prueba.")), situation = "La impresora no va y pides ayuda a tu compañero: os pasáis pasos sencillos y, si nada funciona, llamaréis al técnico.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pide consejo: la wifi no va.", expected = listOf("¿Qué hago?", "que hago"), focus = "¿qué hago?", watch = "qué con tilde."), PracticeQuestion(prompt = "Pide ayuda a tu compañero.", expected = listOf("¿Puedes echarme una mano?", "puedes echarme una mano"), focus = "echar una mano", watch = "echar una mano: ayudar."), PracticeQuestion(prompt = "Sugiere apagarlo y encenderlo.", expected = listOf("Prueba a apagarlo y encenderlo", "prueba a apagarlo y encenderlo"), focus = "prueba a", watch = "prueba a + infinitivo."), PracticeQuestion(prompt = "Da el primer paso: mirar el enchufe.", expected = listOf("Mira si está enchufado", "primero mira el enchufe"), focus = "primero", watch = "Primero el paso uno."), PracticeQuestion(prompt = "Da el plan B: llamar al técnico.", expected = listOf("Si no funciona, llama al técnico", "si no funciona llama al tecnico"), focus = "si no funciona", watch = "si + presente: condición."))), exercises = listOf(Exercise(id = "es-foundations-u21-solucion-e1", kind = "choice", prompt = "La impresora no va. ¿___ hago?", options = listOf("Qué", "Que", "Cómo", "Dónde"), answers = listOf("Qué"), explain = "«¿Qué hago?» pide consejo; qué lleva tilde en la pregunta."), Exercise(id = "es-foundations-u21-solucion-e2", kind = "gap", prompt = "___ a apagarlo y encenderlo otra vez. (intenta este paso)", options = listOf(), answers = listOf("Prueba", "prueba"), explain = "prueba a + infinitivo: la sugerencia sencilla para arreglar algo."), Exercise(id = "es-foundations-u21-solucion-e3", kind = "order", prompt = "Pide ayuda a tu compañero de forma coloquial.", options = listOf(), answers = listOf("¿Puedes echarme una mano?"), explain = "echar una mano: fórmula fija para pedir ayuda; con puedo pides permiso-ayuda."), Exercise(id = "es-foundations-u21-solucion-e4", kind = "written", prompt = "Da el plan B: si la luz vuelve a fallar, tú llamas al técnico.", options = listOf(), answers = listOf("si no funciona llamo al técnico", "si no funciona llamo al tecnico", "si no funciona, llamo al técnico"), explain = "si + presente + presente: la condición y su consecuencia directa.")), skills = listOf("function:solve-problems", "function:make-requests", "grammar:connectors", "vocab:social-expressions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "es-foundations-u21-reclamo", title = "Un reclamo tranquilo", goal = "Reclamar algo roto o mal entregado con educación: quiero reclamar, compró… pero no funciona, ¿qué me puede ofrecer?", intro = LessonIntro(explanation = listOf("El reclamo empieza tranquilo y directo: «Buenas tardes, quiero reclamar un pedido».", "El problema se explica con pasado + pero: «Compré una lámpara, pero llegó rota».", "La solución se pide con cortesía: «¿Qué me puede ofrecer?», «Quiero la devolución, por favor»."), examples = listOf(ExampleLine(text = "Buenas tardes, quiero reclamar un pedido.", meaning = "Abrir el reclamo."), ExampleLine(text = "Compré una lámpara, pero llegó rota.", meaning = "El hecho en pasado."), ExampleLine(text = "No funciona nada.", meaning = "El problema en presente."), ExampleLine(text = "¿Qué me puede ofrecer?", meaning = "Pedir la solución."), ExampleLine(text = "Quiero la devolución, por favor.", meaning = "Pedir la devolución."))), expressions = listOf(TargetExpression(text = "quiero reclamar", meaning = "Abrir el reclamo.", note = "Quiero reclamar un pedido."), TargetExpression(text = "compré…, pero…", meaning = "El hecho y el contraste.", note = "Compré una lámpara, pero no funciona."), TargetExpression(text = "¿qué me puede ofrecer?", meaning = "Pedir la solución al dependiente.", note = "¿Qué me puede ofrecer, un cambio?"), TargetExpression(text = "el cambio / la devolución", meaning = "Las dos soluciones típicas.", note = "Quiero la devolución."), TargetExpression(text = "llegó roto", meaning = "El estado al llegar.", note = "El paquete llegó roto.")), situation = "El pedido de una lámpara llegó roto: llamas a la tienda, explicas el problema con calma y pides la devolución.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Abre el reclamo por teléfono.", expected = listOf("Quiero reclamar un pedido", "quiero reclamar"), focus = "quiero reclamar", watch = "Directo y tranquilo."), PracticeQuestion(prompt = "Explica el hecho: compraste una lámpara, pero no funciona.", expected = listOf("Compré una lámpara, pero no funciona", "compre una lampara pero no funciona"), focus = "compré…, pero…", watch = "compré: yo compré."), PracticeQuestion(prompt = "Pregunta qué solución te ofrecen.", expected = listOf("¿Qué me puede ofrecer?", "que me puede ofrecer"), focus = "¿qué me puede ofrecer?", watch = "Cortesía con puede (usted)."), PracticeQuestion(prompt = "Pide la devolución con cortesía.", expected = listOf("Quiero la devolución, por favor", "quiero la devolucion"), focus = "la devolución", watch = "devolución lleva tilde."), PracticeQuestion(prompt = "Di el estado del paquete al llegar.", expected = listOf("El paquete llegó roto", "el paquete llego roto"), focus = "llegó roto", watch = "llegó con tilde."))), exercises = listOf(Exercise(id = "es-foundations-u21-reclamo-e1", kind = "choice", prompt = "Compré una lámpara, ___ no funciona.", options = listOf("pero", "porque", "además", "entonces"), answers = listOf("pero"), explain = "pero contraste lo esperado con lo real; porque daría la causa equivocada."), Exercise(id = "es-foundations-u21-reclamo-e2", kind = "gap", prompt = "Buenas tardes, ___ reclamar un pedido que llegó roto.", options = listOf(), answers = listOf("quiero", "Quiero"), explain = "quiero reclamar: abre el reclamo de forma directa y tranquila."), Exercise(id = "es-foundations-u21-reclamo-e3", kind = "order", prompt = "Pregunta al dependiente qué solución te ofrece.", options = listOf(), answers = listOf("¿Qué me puede ofrecer?"), explain = "¿Qué me puede ofrecer? pide opciones con cortesía (usted)."), Exercise(id = "es-foundations-u21-reclamo-e4", kind = "written", prompt = "Explica el problema del envío y pide la solución con cortesía.", options = listOf(), answers = listOf("el pedido llegó roto y quiero la devolución", "el pedido llego roto y quiero la devolucion", "quiero la devolución porque el pedido llegó roto"), explain = "Pasado + pero + petición: la estructura del reclamo tranquilo.")), skills = listOf("function:solve-problems", "grammar:present-questions", "vocab:social-expressions", "grammar:connectors"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors"))))
}

object EsFoundationsU25 {
    val unit = CourseUnit(id = "es-foundations-u25", title = "Compras grandes", subtitle = "Comparar, devolver y pagar", level = "A2", themes = listOf(ConversationTheme("la-decision", "La decisión", "Comparar productos", "cart", "Course", "Compráis un móvil nuevo: comparáis precios y tamaños y decidís cuál es el mejor.", 0),
                ConversationTheme("el-dinero", "El dinero", "Devolver y pagar a plazos", "creditcard", "Course", "Hay que devolver una compra y financiar otra: pedís la devolución y habláis de pagos a plazos.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u25-decidir", title = "¿Cuál compro?", goal = "Comparar productos para decidir una compra: más barato que, más grande que, el mejor, el más nuevo.", intro = LessonIntro(explanation = listOf("El comparativo con más… que: «Este móvil es más barato que ese».", "El superlativo con el/la más… de: «Es el más nuevo de la tienda». Irregulares: mejor, peor, mayor, menor.", "Para decidir, opina y elige: «Creo que este es el mejor», «Me quedo con el azul»."), examples = listOf(ExampleLine(text = "Este móvil es más barato que ese.", meaning = "Comparar precios."), ExampleLine(text = "La pantalla es más grande que la mía.", meaning = "Comparar tamaños."), ExampleLine(text = "Es el más nuevo de la tienda.", meaning = "El superlativo."), ExampleLine(text = "Creo que este es el mejor.", meaning = "Decidir con opinión."), ExampleLine(text = "Me quedo con el blanco.", meaning = "Cerrar la decisión."))), expressions = listOf(TargetExpression(text = "más… que", meaning = "Comparar dos cosas.", note = "Este es más caro que ese."), TargetExpression(text = "el/la más… de", meaning = "El superlativo.", note = "Es el más barato de la tienda."), TargetExpression(text = "mejor / peor", meaning = "Comparativos irregulares.", note = "Este modelo es mejor."), TargetExpression(text = "me quedo con…", meaning = "Elegir al final.", note = "Me quedo con el azul."), TargetExpression(text = "creo que es el mejor", meaning = "Recomendar.", note = "Creo que es el mejor para ti.")), situation = "En la tienda de móviles comparáis dos modelos: uno es más barato pero más pequeño; al final elegís el mejor para tu presupuesto.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Compara precios: este móvil, más barato que ese.", expected = listOf("Este móvil es más barato que ese", "Este es más barato que ese", "este movil es mas barato que ese"), focus = "más… que", watch = "más + adjetivo + que."), PracticeQuestion(prompt = "Compara pantallas: la de este, más grande que la mía.", expected = listOf("La pantalla es más grande que la mía", "la pantalla es mas grande que la mia", "Esta pantalla es más grande"), focus = "comparativos", watch = "que introduce la segunda parte."), PracticeQuestion(prompt = "Usa el superlativo con el modelo recién llegado.", expected = listOf("Es el más nuevo de la tienda", "es el mas nuevo de la tienda", "Es el modelo más nuevo de la tienda"), focus = "el más… de", watch = "el/la más… de + grupo."), PracticeQuestion(prompt = "Recomienda el mejor con tu opinión.", expected = listOf("Creo que este es el mejor", "creo que es el mejor", "Para mí, este es el mejor"), focus = "creo que", watch = "mejor: irregular, nunca «más bueno»."), PracticeQuestion(prompt = "Cierra la compra: eliges el negro.", expected = listOf("Me quedo con el negro", "me quedo con el negro", "Me llevo el negro"), focus = "me quedo con", watch = "me quedo con + producto."))), exercises = listOf(Exercise(id = "es-foundations-u25-decidir-e1", kind = "choice", prompt = "Este móvil es ___ barato que ese.", options = listOf("más", "mucho", "mejor", "muy"), answers = listOf("más"), explain = "más barato que: el comparativo; mejor es irregular y no vale aquí."), Exercise(id = "es-foundations-u25-decidir-e2", kind = "gap", prompt = "Es el ___ nuevo de la tienda, acaba de llegar. (superlativo)", options = listOf(), answers = listOf("más", "Mas"), explain = "el más nuevo de: superlativo dentro de un grupo."), Exercise(id = "es-foundations-u25-decidir-e3", kind = "order", prompt = "Compara los dos móviles: el precio del negro frente al blanco.", options = listOf(), answers = listOf("El negro es más barato que el blanco"), explain = "más barato que: la comparación de precio entre dos productos."), Exercise(id = "es-foundations-u25-decidir-e4", kind = "written", prompt = "Di con qué móvil te quedas y por qué (el azul, el mejor).", options = listOf(), answers = listOf("me quedo con el azul porque es el mejor", "me quedo con el azul", "creo que el azul es el mejor"), explain = "me quedo con + producto + porque + razón: la decisión completa.")), skills = listOf("grammar:comparatives", "function:go-shopping", "grammar:superlatives", "vocab:shopping"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:comparatives")),
    Lesson(id = "es-foundations-u25-devolver", title = "Quiero devolverlo", goal = "Devolver una compra: lo compré ayer pero no funciona, quiero devolverlo, ¿me devuelve el dinero?", intro = LessonIntro(explanation = listOf("La compra se cuenta en pasado: «Lo compré ayer», «Llegó con la caja rota».", "El problema se explica con pero: «Compré la cafetera, pero no calienta».", "La petición es directa y educada: «Quiero devolverlo», «¿Me devuelve el dinero?»."), examples = listOf(ExampleLine(text = "Compré esta cafetera ayer.", meaning = "La compra en pasado."), ExampleLine(text = "No calienta nada.", meaning = "El problema en presente."), ExampleLine(text = "Quiero devolverlo.", meaning = "La petición principal."), ExampleLine(text = "¿Tiene el recibo?", meaning = "La pregunta de la tienda."), ExampleLine(text = "Prefiero el dinero, gracias.", meaning = "Elegir devolución o cambio."))), expressions = listOf(TargetExpression(text = "lo compré ayer", meaning = "La compra en pasado.", note = "Lo compré el lunes."), TargetExpression(text = "no funciona", meaning = "El problema en presente.", note = "Funcionó dos días y ya no funciona."), TargetExpression(text = "quiero devolverlo", meaning = "Pedir la devolución.", note = "Quiero devolverlo, por favor."), TargetExpression(text = "¿me devuelve el dinero?", meaning = "Pedir el reembolso.", note = "¿Me devuelve el dinero o prefiere un cambio?"), TargetExpression(text = "prefiero el dinero / el cambio", meaning = "Elegir la solución.", note = "Prefiero el dinero.")), situation = "La cafetera que compraste ayer no calienta: vuelves a la tienda con el recibo, explicas el problema con calma y pides el dinero.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di cuándo compraste la cafetera: ayer.", expected = listOf("La compré ayer", "la compre ayer", "Compré esta cafetera ayer"), focus = "compré", watch = "compré: yo; compró: él o ella."), PracticeQuestion(prompt = "Explica el problema de la cafetera.", expected = listOf("No calienta", "no calienta nada", "La cafetera no calienta"), focus = "el problema", watch = "pasado + pero + presente: la estructura del reclamo."), PracticeQuestion(prompt = "Pide la devolución del producto.", expected = listOf("Quiero devolverlo", "quiero devolverlo", "Quiero devolver la cafetera"), focus = "quiero devolverlo", watch = "devolver: la o se convierte en ue."), PracticeQuestion(prompt = "Pregunta si te devuelven el dinero.", expected = listOf("¿Me devuelve el dinero?", "me devuelve el dinero", "¿Puedo recuperar el dinero?"), focus = "reembolso", watch = "devolver el dinero = reembolsar."), PracticeQuestion(prompt = "Elige: dinero, no cambio.", expected = listOf("Prefiero el dinero", "prefiero el dinero", "Prefiero el dinero, no el cambio"), focus = "prefiero", watch = "prefiero: yo; diptongo ie."))), exercises = listOf(Exercise(id = "es-foundations-u25-devolver-e1", kind = "choice", prompt = "___ la cafetera ayer, pero no calienta.", options = listOf("Compré", "Compra", "Compro", "Comprará"), answers = listOf("Compré"), explain = "Compré: pasado de yo; la compra ya pasó, con tilde."), Exercise(id = "es-foundations-u25-devolver-e2", kind = "gap", prompt = "Quiero ___ este móvil porque no funciona. (darlo de vuelta)", options = listOf(), answers = listOf("devolver", "Devolver"), explain = "devolver + producto: pedir la devolución."), Exercise(id = "es-foundations-u25-devolver-e3", kind = "order", prompt = "Pide el reembolso en la tienda.", options = listOf(), answers = listOf("¿Me devuelve el dinero, por favor?"), explain = "¿Me devuelve el dinero?: la petición del reembolso con usted y por favor."), Exercise(id = "es-foundations-u25-devolver-e4", kind = "written", prompt = "Explica la compra y el problema: ayer, la lámpara, llegó rota.", options = listOf(), answers = listOf("compré la lámpara ayer y llegó rota", "compre la lampara ayer y llego rota", "la lámpara llegó rota y la quiero devolver"), explain = "pasado + problema + petición: el reclamo completo.")), skills = listOf("function:solve-problems", "grammar:past-simple-regular", "function:make-requests", "vocab:shopping"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "es-foundations-u25-pagar", title = "Pagar a plazos", goal = "Hablar de formas de pago: al contado, a plazos, sin intereses, primero… y después…", intro = LessonIntro(explanation = listOf("Las formas de pago: «al contado» (todo de una vez), «con tarjeta», «a plazos» (en partes).", "El plan de pago se encadena: «Primero pago una señal y después el resto cada mes».", "Pregunta antes de firmar: «¿Hay intereses?», «¿Cuántas cuotas son?»."), examples = listOf(ExampleLine(text = "¿Cómo prefiere pagar?", meaning = "La pregunta de la tienda."), ExampleLine(text = "Pago al contado.", meaning = "Todo de una vez."), ExampleLine(text = "¿Puedo pagar a plazos?", meaning = "Pagar en partes."), ExampleLine(text = "Son doce cuotas sin intereses.", meaning = "El plan de pago."), ExampleLine(text = "Primero una señal y después el resto.", meaning = "El encadenado."))), expressions = listOf(TargetExpression(text = "al contado", meaning = "Pagar todo de una vez.", note = "¿Lo pago al contado?"), TargetExpression(text = "a plazos", meaning = "Pagar en partes.", note = "Lo compro a plazos."), TargetExpression(text = "la cuota", meaning = "Cada pago del plan.", note = "Son cuotas de cincuenta euros."), TargetExpression(text = "sin intereses", meaning = "No pagas extra.", note = "A plazos y sin intereses."), TargetExpression(text = "primero…, después…", meaning = "Ordenar los pagos.", note = "Primero la señal; después, el resto.")), situation = "Compras un portátil de seiscientos euros: la tienda pregunta cómo pagas, tú propones pagar a plazos y acordáis doce cuotas sin intereses.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "La tienda pregunta cómo pagas. Di que todo de una vez.", expected = listOf("Pago al contado", "pago al contado", "Pago todo de una vez"), focus = "al contado", watch = "al contado = de una vez."), PracticeQuestion(prompt = "Propón pagar en partes.", expected = listOf("¿Puedo pagar a plazos?", "puedo pagar a plazos", "¿Se puede pagar a plazos?"), focus = "a plazos", watch = "a plazos = en cuotas."), PracticeQuestion(prompt = "Di el número de cuotas: doce, sin coste extra.", expected = listOf("Son doce cuotas sin intereses", "doce cuotas sin intereses", "Son doce pagos sin intereses"), focus = "la cuota", watch = "cuota: cada pago mensual."), PracticeQuestion(prompt = "Encadena el plan: señal hoy, resto después.", expected = listOf("Primero una señal y después el resto", "primero la señal y después el resto", "Primero la señal, después el resto"), focus = "primero…, después…", watch = "la señal: el primer pago pequeño."), PracticeQuestion(prompt = "Pregunta si hay coste extra.", expected = listOf("¿Hay intereses?", "hay intereses", "¿Hay algún interés?"), focus = "intereses", watch = "sin intereses: no pagas extra."))), exercises = listOf(Exercise(id = "es-foundations-u25-pagar-e1", kind = "choice", prompt = "Pago ___ contado, todo de una vez.", options = listOf("al", "a", "el", "en"), answers = listOf("al"), explain = "al contado: fórmula fija para pagar de una vez."), Exercise(id = "es-foundations-u25-pagar-e2", kind = "gap", prompt = "Lo compro ___ plazos: son doce cuotas. (en partes)", options = listOf(), answers = listOf("a", "A"), explain = "a plazos: pagar en partes mensuales."), Exercise(id = "es-foundations-u25-pagar-e3", kind = "order", prompt = "Encadena el plan de pago.", options = listOf(), answers = listOf("Primero la señal y después el resto"), explain = "primero…, después…: el plan de pago ordenado."), Exercise(id = "es-foundations-u25-pagar-e4", kind = "written", prompt = "Di que compras el portátil en partes y sin coste extra.", options = listOf(), answers = listOf("lo compro a plazos y sin intereses", "lo compro a plazos sin intereses", "lo compro en cuotas y sin intereses"), explain = "a plazos + sin intereses: la compra repartida y sin extra.")), skills = listOf("function:go-shopping", "grammar:connectors", "vocab:shopping", "vocab:social-expressions"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:connectors"))))
}

object EsFoundationsU26 {
    val unit = CourseUnit(id = "es-foundations-u26", title = "Prepara el viaje", subtitle = "Maleta, reservas y salida", level = "A2", themes = listOf(ConversationTheme("la-maleta", "La maleta", "Documentos y lista", "suitcase", "Course", "Preparáis la maleta el fin de semana: hacéis la lista, revisáis los documentos y repartís las tareas.", 0),
                ConversationTheme("los-vuelos", "Los vuelos", "Reservar y salir", "airplane", "Course", "Reserváis el vuelo por teléfono y organizáis la víspera del viaje: cada uno con sus tareas.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u26-maleta", title = "La lista de la maleta", goal = "Planificar la maleta con ir a: voy a llevar…, no olvides…, primero los documentos y después la ropa.", intro = LessonIntro(explanation = listOf("El plan de la maleta va con ir a + infinitivo: «Voy a llevar ropa ligera».", "Los avisos con no olvides: «No olvides el pasaporte». Olvidar los documentos arruina el viaje.", "Encadena con conectores: «Primero hago la lista y después preparo la maleta»."), examples = listOf(ExampleLine(text = "El sábado voy a viajar a Lisboa.", meaning = "El plan con ir a."), ExampleLine(text = "Voy a llevar ropa ligera.", meaning = "Lo que metes en la maleta."), ExampleLine(text = "No olvides el pasaporte.", meaning = "El aviso importante."), ExampleLine(text = "Primero hago la lista y después preparo la maleta.", meaning = "El orden."), ExampleLine(text = "¿Llevas paraguas? Puede llover.", meaning = "La pregunta práctica."))), expressions = listOf(TargetExpression(text = "voy a + infinitivo", meaning = "El plan.", note = "Voy a viajar el sábado."), TargetExpression(text = "voy a llevar…", meaning = "Lo que metes.", note = "Voy a llevar dos camisetas."), TargetExpression(text = "no olvides + objeto", meaning = "El aviso.", note = "No olvides el cargador."), TargetExpression(text = "primero…, después…", meaning = "Ordenar los pasos.", note = "Primero los documentos; después, la ropa."), TargetExpression(text = "¿llevas…?", meaning = "Repartir preguntas.", note = "¿Llevas el adaptador?")), situation = "El sábado viajáis a Lisboa: hacéis la lista juntos, revisáis pasaportes y DNI y decidís quién lleva el adaptador y quién el cargador.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di tu plan: viajar a Lisboa el sábado.", expected = listOf("El sábado voy a viajar a Lisboa", "Voy a viajar a Lisboa el sábado", "voy a viajar a lisboa el sabado"), focus = "ir a + infinitivo", watch = "voy a + infinitivo: el plan."), PracticeQuestion(prompt = "Di lo que vas a meter: ropa ligera.", expected = listOf("Voy a llevar ropa ligera", "voy a llevar ropa ligera", "Voy a meter ropa ligera"), focus = "voy a llevar", watch = "llevar: meter en la maleta."), PracticeQuestion(prompt = "Avisa a tu compañero: el pasaporte.", expected = listOf("No olvides el pasaporte", "no olvides el pasaporte", "No te olvides del pasaporte"), focus = "no olvides", watch = "olvidar u olvidarse de: las dos valen."), PracticeQuestion(prompt = "Ordena los pasos: lista, maleta.", expected = listOf("Primero hago la lista y después preparo la maleta", "Primero hago la lista, después la maleta", "primero la lista y después la maleta"), focus = "primero…, después…", watch = "los conectores ordenan."), PracticeQuestion(prompt = "Pregunta a tu compañero por el paraguas.", expected = listOf("¿Llevas paraguas?", "llevas paraguas", "¿Vas a llevar paraguas?"), focus = "¿llevas…?", watch = "llevas: tú."))), exercises = listOf(Exercise(id = "es-foundations-u26-maleta-e1", kind = "choice", prompt = "El sábado ___ viajar a Lisboa.", options = listOf("voy a", "voy", "iba a", "vaya"), answers = listOf("voy a"), explain = "ir a + infinitivo: voy a viajar, el plan de viaje."), Exercise(id = "es-foundations-u26-maleta-e2", kind = "gap", prompt = "No ___ el pasaporte: es lo primero. (olvidar, aviso con tú)", options = listOf(), answers = listOf("olvides", "Olvides"), explain = "no olvides + objeto: el aviso con tú."), Exercise(id = "es-foundations-u26-maleta-e3", kind = "order", prompt = "Ordena los pasos de la preparación.", options = listOf(), answers = listOf("Primero los documentos y después la ropa"), explain = "primero…, después…: el orden de la maleta."), Exercise(id = "es-foundations-u26-maleta-e4", kind = "written", prompt = "Di qué vas a meter: dos camisetas y un cargador.", options = listOf(), answers = listOf("voy a llevar dos camisetas y un cargador", "voy a llevar dos camisetas", "voy a meter dos camisetas y un cargador"), explain = "voy a llevar + la lista de cosas.")), skills = listOf("grammar:going-to", "vocab:travel", "function:make-future-plans", "grammar:connectors"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "es-foundations-u26-reservar", title = "Reservar el vuelo", goal = "Reservar por teléfono: quería reservar un vuelo, ¿a qué hora sale?, ¿me lo puede confirmar?", intro = LessonIntro(explanation = listOf("La llamada abre con quería: «Buenas, quería reservar un vuelo». Quería suena más educada que quiero.", "Los horarios van en presente: «El primer vuelo sale a las siete y llega a las nueve».", "Las peticiones con ¿me puede…?: «¿Me lo puede confirmar por email?»."), examples = listOf(ExampleLine(text = "Buenas, quería reservar un vuelo a Lisboa.", meaning = "Abrir la llamada."), ExampleLine(text = "¿A qué hora sale el primer vuelo?", meaning = "El horario de salida."), ExampleLine(text = "¿Cuánto cuesta la ida y vuelta?", meaning = "El billete completo."), ExampleLine(text = "Prefiero asiento de ventanilla.", meaning = "Tu preferencia."), ExampleLine(text = "¿Me lo puede confirmar por email?", meaning = "Cerrar la reserva."))), expressions = listOf(TargetExpression(text = "quería + infinitivo", meaning = "Pedir con educación.", note = "Quería reservar un vuelo."), TargetExpression(text = "¿a qué hora sale…?", meaning = "El horario.", note = "¿A qué hora sale el vuelo?"), TargetExpression(text = "la ida y vuelta", meaning = "El billete de dos trayectos.", note = "Quiero ida y vuelta."), TargetExpression(text = "prefiero + nombre", meaning = "Elegir.", note = "Prefiero asiento de pasillo."), TargetExpression(text = "¿me lo puede confirmar?", meaning = "Pedir confirmación.", note = "¿Me lo puede confirmar por email?")), situation = "Llamas a la agencia: quieres un vuelo a Lisboa el sábado, preguntas horarios y precio del billete de ida y vuelta y pides la confirmación por email.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Abre la llamada con educación: reservar un vuelo a Lisboa.", expected = listOf("Quería reservar un vuelo a Lisboa", "Buenas, quería reservar un vuelo", "queria reservar un vuelo"), focus = "quería", watch = "quería: más educado que quiero."), PracticeQuestion(prompt = "Pregunta la hora de salida del vuelo.", expected = listOf("¿A qué hora sale el vuelo?", "a que hora sale", "¿A qué hora sale?"), focus = "¿a qué hora sale?", watch = "los horarios van en presente."), PracticeQuestion(prompt = "Pregunta el precio del billete de dos trayectos.", expected = listOf("¿Cuánto cuesta la ida y vuelta?", "cuanto cuesta la ida y vuelta", "¿Cuánto es la ida y vuelta?"), focus = "la ida y vuelta", watch = "ida y vuelta: los dos trayectos."), PracticeQuestion(prompt = "Di tu preferencia: asiento de ventanilla.", expected = listOf("Prefiero asiento de ventanilla", "Prefiero un asiento de ventanilla", "prefiero ventana"), focus = "prefiero", watch = "ventanilla o pasillo: elige."), PracticeQuestion(prompt = "Pide la confirmación por email.", expected = listOf("¿Me lo puede confirmar por email?", "me lo puede confirmar por email", "¿Me puede enviar la confirmación por email?"), focus = "confirmar", watch = "¿me lo puede…?: petición con usted."))), exercises = listOf(Exercise(id = "es-foundations-u26-reservar-e1", kind = "choice", prompt = "Buenas, ___ reservar un vuelo a Lisboa.", options = listOf("quería", "quiero que", "querré", "quiera"), answers = listOf("quería"), explain = "quería + infinitivo: la petición educada al teléfono."), Exercise(id = "es-foundations-u26-reservar-e2", kind = "gap", prompt = "El primer vuelo ___ a las siete y llega a las nueve. (salir)", options = listOf(), answers = listOf("sale", "Sale"), explain = "salir en presente: los horarios fijos van en presente."), Exercise(id = "es-foundations-u26-reservar-e3", kind = "order", prompt = "Pide la confirmación de la reserva.", options = listOf(), answers = listOf("¿Me lo puede confirmar por email?"), explain = "¿Me lo puede confirmar…?: cerrar la reserva con cortesía."), Exercise(id = "es-foundations-u26-reservar-e4", kind = "written", prompt = "Pide el billete completo de dos trayectos y su precio.", options = listOf(), answers = listOf("quiero un billete de ida y vuelta", "¿cuánto cuesta la ida y vuelta?", "quería la ida y vuelta, por favor"), explain = "ida y vuelta: el billete de los dos trayectos.")), skills = listOf("function:make-requests", "vocab:transport", "grammar:going-to", "vocab:travel"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "es-foundations-u26-vispera", title = "La víspera del viaje", goal = "Organizar el día antes: mañana voy a…, va a venir…, porque el vuelo sale a las siete.", intro = LessonIntro(explanation = listOf("La víspera se planifica con ir a: «Mañana voy a madrugar», «Voy a dejar la casa lista».", "Las tareas de otros van con va a: «Mi vecino va a venir a por las llaves».", "Las razones van con porque: «Duermo temprano porque el vuelo sale a las siete»."), examples = listOf(ExampleLine(text = "Mañana es el gran día.", meaning = "La víspera."), ExampleLine(text = "Voy a madrugar: el vuelo sale a las siete.", meaning = "El plan y la razón."), ExampleLine(text = "Mi vecino va a venir a por las llaves.", meaning = "La tarea de otro."), ExampleLine(text = "Después de cenar, voy a revisar la maleta.", meaning = "El momento con después de."), ExampleLine(text = "Ya está todo listo.", meaning = "La tranquilidad final."))), expressions = listOf(TargetExpression(text = "mañana voy a…", meaning = "El plan del día siguiente.", note = "Mañana voy a madrugar."), TargetExpression(text = "va a venir a por…", meaning = "La tarea de otro.", note = "Mi vecino va a venir a por las llaves."), TargetExpression(text = "porque + presente", meaning = "La razón.", note = "Madrugo porque el vuelo sale a las siete."), TargetExpression(text = "después de + infinitivo", meaning = "El orden.", note = "Después de cenar reviso la maleta."), TargetExpression(text = "ya está todo listo", meaning = "Cerrar la lista.", note = "Maleta revisada: ya está todo listo.")), situation = "Es la víspera: mañana madrugáis, tu vecino viene a por las llaves y, después de cenar, revisáis la maleta y los documentos otra vez.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di tu plan de mañana: madrugar.", expected = listOf("Mañana voy a madrugar", "Voy a madrugar mañana", "mañana voy a madrugar"), focus = "mañana voy a", watch = "mañana + voy a + infinitivo."), PracticeQuestion(prompt = "Di la tarea del vecino: recoger las llaves.", expected = listOf("Mi vecino va a venir a por las llaves", "el vecino va a venir a por las llaves", "mi vecino va a recoger las llaves"), focus = "va a venir a por", watch = "a por + cosa: ir a buscar algo."), PracticeQuestion(prompt = "Di la razón de madrugar: el vuelo, a las siete.", expected = listOf("Madrugo porque el vuelo sale a las siete", "duermo temprano porque el vuelo sale a las siete", "madrugo porque el vuelo sale a las siete"), focus = "porque", watch = "porque + presente: la razón."), PracticeQuestion(prompt = "Ordena: cenar, revisar la maleta.", expected = listOf("Después de cenar reviso la maleta", "Después de cenar, reviso la maleta", "después de cenar voy a revisar la maleta"), focus = "después de", watch = "después de + infinitivo."), PracticeQuestion(prompt = "Di que ya no falta nada.", expected = listOf("Ya está todo listo", "ya esta todo listo", "Ya está todo preparado"), focus = "ya está todo", watch = "listo o preparado: las dos valen."))), exercises = listOf(Exercise(id = "es-foundations-u26-vispera-e1", kind = "choice", prompt = "Mañana ___ madrugar: el vuelo sale a las siete.", options = listOf("voy a", "voy", "iba a", "vaya a"), answers = listOf("voy a"), explain = "voy a + infinitivo: el plan de mañana."), Exercise(id = "es-foundations-u26-vispera-e2", kind = "gap", prompt = "Mi vecino ___ a venir a por las llaves a las ocho. (ir, él)", options = listOf(), answers = listOf("va", "Va"), explain = "va a venir: la tarea de otra persona, en singular."), Exercise(id = "es-foundations-u26-vispera-e3", kind = "order", prompt = "Di la razón de tu madrugón.", options = listOf(), answers = listOf("Madrugo porque el vuelo sale a las siete"), explain = "porque + presente: la razón del plan."), Exercise(id = "es-foundations-u26-vispera-e4", kind = "written", prompt = "Cierra la víspera: todo preparado.", options = listOf(), answers = listOf("ya está todo listo", "ya esta todo listo", "ya está todo preparado"), explain = "ya está todo listo: la calma antes del viaje.")), skills = listOf("grammar:going-to", "function:make-future-plans", "vocab:transport", "grammar:connectors"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to"))))
}

object EsFoundationsU5 {
    val unit = CourseUnit(id = "es-foundations-u5", title = "Experiencias y opiniones", subtitle = "Contar lo vivido", level = "B1", themes = listOf(ConversationTheme("viaje-inolvidable", "El viaje inolvidable", "Presente perfecto", "airplane", "Course", "Habéis viajado mucho: comparad experiencias con he/ha + participio.", 0),
                ConversationTheme("cambio-vida", "El cambio de vida", "Antes y ahora", "arrow.triangle.swap", "Course", "Comparáis vuestra vida de antes con la de ahora: trabajo, ciudad, hábitos.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u5-presente-perfecto", title = "He viajado mucho", goal = "Hablar de experiencias vitales con he/has/ha + participio.", intro = LessonIntro(explanation = listOf("El presente perfecto conecta el pasado con el presente: «He comido en ese restaurante» (y puedo volver a ir).", "Participios: -ar → -ado (hablado), -er/-ir → -ido (comido, vivido). Irregulares: hecho, visto, dicho, escrito.", "Marcadores: ya (ya he comido), todavía no (no he ido), alguna vez (¿Has estado en…?)."), examples = listOf(ExampleLine(text = "He comido en ese restaurante.", meaning = "he + participio."), ExampleLine(text = "¿Has estado en Barcelona?", meaning = "has estado: experiencia."), ExampleLine(text = "Nunca he visto la nieve.", meaning = "nunca + he + participio."), ExampleLine(text = "Ya hemos terminado el proyecto.", meaning = "ya = terminado."), ExampleLine(text = "Todavía no he visitado México.", meaning = "todavía no = aún no."))), expressions = listOf(TargetExpression(text = "he / has / ha + participio", meaning = "Yo/tú/él.", note = "he comido, has visto, ha vivido."), TargetExpression(text = "ya + he + participio", meaning = "Ya terminado.", note = "Ya he comido."), TargetExpression(text = "todavía no + he", meaning = "Aún no.", note = "Todavía no he ido."), TargetExpression(text = "¿Has … alguna vez?", meaning = "Experiencia vital.", note = "alguna vez = alguna vez en la vida."), TargetExpression(text = "nunca + he", meaning = "Nunca en la vida.", note = "Nunca he visto nieve.")), situation = "Comparáis experiencias de viaje: quién ha estado en más países, quién ha probado comida más rara, quién nunca ha volado.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di una experiencia: comer en ese restaurante.", expected = listOf("He comido en ese restaurante."), focus = "he + participio", watch = "he comido = experiencia sin fecha."), PracticeQuestion(prompt = "Pregunta si tu amigo ha estado en Perú.", expected = listOf("¿Has estado en Perú?"), focus = "has estado", watch = "estado, no «ido» — para lugares."), PracticeQuestion(prompt = "Di que nunca has visto la nieve.", expected = listOf("Nunca he visto la nieve."), focus = "nunca", watch = "nunca + he + visto."), PracticeQuestion(prompt = "Di que ya has comido.", expected = listOf("Ya he comido."), focus = "ya", watch = "ya = la acción está terminada."), PracticeQuestion(prompt = "Di que todavía no has visitado México.", expected = listOf("Todavía no he visitado México."), focus = "todavía no", watch = "todavía no = aún no."))), exercises = listOf(Exercise(id = "es-foundations-u5-presente-perfecto-e1", kind = "choice", prompt = "___ ___ en ese restaurante. (comer, yo)", options = listOf("He comido", "He comí", "He comido", "He comía"), answers = listOf("He comido"), explain = "he + comido (participio)."), Exercise(id = "es-foundations-u5-presente-perfecto-e2", kind = "gap", prompt = "¿___ ___ ___ en Perú? (estar, tú)", options = listOf(), answers = listOf("Has estado"), explain = "has estado = experiencia."), Exercise(id = "es-foundations-u5-presente-perfecto-e3", kind = "order", prompt = "Di que nunca has visto nieve.", options = listOf(), answers = listOf("Nunca he visto la nieve"), explain = "nunca + he + participio."), Exercise(id = "es-foundations-u5-presente-perfecto-e4", kind = "written", prompt = "Di que ya has comido.", options = listOf(), answers = listOf("ya he comido", "ya he comido"), explain = "ya + he + comido.")), skills = listOf("grammar:present-perfect", "grammar:past-simple-irregular", "function:describe-past-events"), canDo = listOf("describe-past-events"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "es-foundations-u5-antes-ahora", title = "Antes y ahora", goal = "Comparar el pasado con el presente usando antes/imperiético y ahora/presente.", intro = LessonIntro(explanation = listOf("Antes + imperfecto: «Antes vivía en Madrid». Ahora + presente: «Ahora vivo en Barcelona».", "El imperfecto describe hábitos del pasado: «Iba al parque todos los días». «Jugaba al fútbol».", "La contraste: «Antes tenía tiempo, ahora no tengo nada»."), examples = listOf(ExampleLine(text = "Antes vivía en Madrid.", meaning = "antes + imperfecto."), ExampleLine(text = "Ahora vivo en Barcelona.", meaning = "ahora + presente."), ExampleLine(text = "Iba al parque todos los días.", meaning = "imperfecto: hábito pasado."), ExampleLine(text = "Antes tenía más tiempo libre.", meaning = "tener → tenía."), ExampleLine(text = "Ahora trabajo desde casa.", meaning = "ahora + presente."))), expressions = listOf(TargetExpression(text = "Antes + imperfecto", meaning = "El pasado habitual.", note = "Antes vivía…"), TargetExpression(text = "Ahora + presente", meaning = "El presente.", note = "Ahora trabajo…"), TargetExpression(text = "-ía / -aba", meaning = "El imperfecto.", note = "vivía, comía, trabajaba."), TargetExpression(text = "tenía / iba / era", meaning = "Imperfectos frecuentes.", note = "tenía tiempo."), TargetExpression(text = "ahora no …", meaning = "El contraste negativo.", note = "ahora no tengo tiempo.")), situation = "Comparáis vuestra vida de estudiantes con la vida de ahora: horarios, hobbies, dinero, libertad.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di dónde vivías antes. (Madrid)", expected = listOf("Antes vivía en Madrid."), focus = "antes + imperfecto", watch = "vivía = imperfecto de vivir."), PracticeQuestion(prompt = "Di qué hacías todos los días. (ir al parque)", expected = listOf("Iba al parque todos los días."), focus = "iba", watch = "ir → iba en imperfecto."), PracticeQuestion(prompt = "Di qué haces ahora.", expected = listOf("Ahora trabajo desde casa."), focus = "ahora + presente", watch = "ahora marca el presente."), PracticeQuestion(prompt = "Di qué ya no tienes. (tiempo)", expected = listOf("Antes tenía tiempo, ahora no tengo."), focus = "contraste", watch = "antes tenía → ahora no tengo."), PracticeQuestion(prompt = "Di qué hacías los domingos antes.", expected = listOf("Iba al cine los domingos."), focus = "imperfecto", watch = "Iba — imperfecto de ir."))), exercises = listOf(Exercise(id = "es-foundations-u5-antes-ahora-e1", kind = "choice", prompt = "Antes ___ en Madrid.", options = listOf("vivía", "vivo", "viví", "viviré"), answers = listOf("vivía"), explain = "imperfecto: hábito pasado."), Exercise(id = "es-foundations-u5-antes-ahora-e2", kind = "gap", prompt = "___ ___ al parque todos los días. (ir, imperfecto)", options = listOf(), answers = listOf("Iba", "iba"), explain = "Imperfecto de ir: iba, ibas, íbamos — describe rutinas del pasado."), Exercise(id = "es-foundations-u5-antes-ahora-e3", kind = "order", prompt = "Di el contraste.", options = listOf(), answers = listOf("Antes tenia tiempo ahora no tengo nada"), explain = "Antes + imperfecto, ahora + presente."), Exercise(id = "es-foundations-u5-antes-ahora-e4", kind = "written", prompt = "Di un hábito de antes.", options = listOf(), answers = listOf("antes <hbito>", "antes jugaba al futbol"), explain = "Antes + imperfecto.")), skills = listOf("grammar:used-to", "grammar:connectors", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:used-to"))))
}

object EsFoundationsU19 {
    val unit = CourseUnit(id = "es-foundations-u19", title = "Contar historias", subtitle = "Pasado y anécdotas", level = "B1", themes = listOf(ConversationTheme("lo-que-paso", "Lo que pasó", "Enlazar hechos", "book", "Course", "Contáis un día de viaje hecho un desastre: primero, después y al final.", 0),
                ConversationTheme("el-giro", "El giro", "Sorpresa y anécdotas", "sparkles", "Course", "Narráis con giros inesperados y reaccionáis a las anécdotas de otros.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u19-narrar", title = "Lo que pasó", goal = "Enlazar hechos pasados en orden: primero…, después…, al final….", intro = LessonIntro(explanation = listOf("La narración ordena los hechos: «Primero fuimos a la estación; después compramos los billetes».", "Los irregulares del pasado aparecen siempre: fui, hicimos, vimos. «Primero fui yo».", "Al final cierras con el resultado: «Al final, perdimos el tren, pero nos reímos mucho»."), examples = listOf(ExampleLine(text = "Primero fuimos a la estación.", meaning = "Abre la secuencia."), ExampleLine(text = "Después compramos los billetes.", meaning = "El segundo hecho."), ExampleLine(text = "Luego corrimos al andén.", meaning = "Luego = después."), ExampleLine(text = "El tren no esperó a nadie.", meaning = "Un hecho del pasado."), ExampleLine(text = "Al final nos reímos mucho.", meaning = "Cierra la historia."))), expressions = listOf(TargetExpression(text = "primero, …", meaning = "El primer hecho.", note = "Primero fuimos al hotel."), TargetExpression(text = "después / luego", meaning = "El siguiente paso.", note = "Después cenamos en el puerto."), TargetExpression(text = "al final, …", meaning = "El cierre o resultado.", note = "Al final llegó tarde."), TargetExpression(text = "fui / hicimos / vimos", meaning = "Irregulares frecuentes.", note = "Hicimos un viaje largo."), TargetExpression(text = "pero / así que", meaning = "Conectan el giro.", note = "Llovió, así que volvimos.")), situation = "Cuentas un día de viaje con sustos: primero el retraso, después la lluvia y, al final, un atardecer increíble.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Abre tu historia: ir al hotel primero.", expected = listOf("Primero fuimos al hotel", "primero fuimos al hotel"), focus = "primero", watch = "fuimos: ir en pasado."), PracticeQuestion(prompt = "Di el segundo hecho: cenar en el puerto.", expected = listOf("Después cenamos en el puerto", "Luego cenamos en el puerto"), focus = "después", watch = "después / luego conectan."), PracticeQuestion(prompt = "Di el giro: llovió, así que volvisteis.", expected = listOf("Llovió, así que volvimos", "llovio asi que volvimos"), focus = "así que", watch = "así que + consecuencia."), PracticeQuestion(prompt = "Cierra: reíros mucho.", expected = listOf("Al final nos reímos mucho", "al final nos reimos mucho"), focus = "al final", watch = "al final cierra la historia."), PracticeQuestion(prompt = "Di lo que visteis en el museo: una expo rara.", expected = listOf("Vimos una exposición rara", "vimos una expo rara", "En el museo vimos una exposición rara"), focus = "vimos", watch = "vimos: ver en pasado."))), exercises = listOf(Exercise(id = "es-foundations-u19-narrar-e1", kind = "choice", prompt = "___ fuimos a la estación; después, a comprar agua.", options = listOf("Primero", "Al final", "Luego", "Después"), answers = listOf("Primero"), explain = "Primero abre la secuencia; después encadena."), Exercise(id = "es-foundations-u19-narrar-e2", kind = "gap", prompt = "El tren no ___ a esperar. (esperar, pasado)", options = listOf(), answers = listOf("esperó", "espero", "Esperó"), explain = "esperó: pasado con tilde en la última sílaba."), Exercise(id = "es-foundations-u19-narrar-e3", kind = "order", prompt = "Cierra tu historia del viaje.", options = listOf(), answers = listOf("Al final nos reímos mucho"), explain = "Al final + resultado cierra la narración."), Exercise(id = "es-foundations-u19-narrar-e4", kind = "written", prompt = "Di que fuisteis a la playa y después comisteis paella.", options = listOf(), answers = listOf("fuimos a la playa y luego comimos paella", "Fuimos a la playa y luego comimos paella", "fuimos a la playa y comimos paella"), explain = "fuimos: irregular; comimos: regular del pasado.")), skills = listOf("function:tell-a-story", "grammar:past-simple-irregular", "grammar:connectors", "grammar:past-simple-regular"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "es-foundations-u19-sorpresa", title = "El giro inesperado", goal = "Narrar con sorpresa: de repente…, resultó que…, resultó ser…", intro = LessonIntro(explanation = listOf("El giro llega con de repente: «Y de repente, se fue la luz». Cambia el ritmo de la historia.", "Resultó que revela la verdad escondida: «Resultó que el ladrón era el vecino».", "Para enganchar: «No te imaginas lo que pasó». Y el clímax: «Lo mejor de todo fue el final»."), examples = listOf(ExampleLine(text = "Y de repente, se fue la luz.", meaning = "El giro."), ExampleLine(text = "Resultó que era el vecino.", meaning = "Revela la verdad."), ExampleLine(text = "Resultó ser una fiesta.", meaning = "La sorpresa final."), ExampleLine(text = "Lo mejor de todo fue el final.", meaning = "Anuncia el clímax."), ExampleLine(text = "No te imaginas lo que pasó.", meaning = "Engancha al oyente."))), expressions = listOf(TargetExpression(text = "de repente", meaning = "Giro sin aviso.", note = "De repente, empezó a llover."), TargetExpression(text = "resultó que…", meaning = "Revela la verdad.", note = "Resultó que era gratis."), TargetExpression(text = "resultó ser…", meaning = "La revelación con ser.", note = "Resultó ser su hermano."), TargetExpression(text = "lo mejor de todo", meaning = "Anuncia el clímax.", note = "Lo mejor de todo fue la cena."), TargetExpression(text = "no te imaginas…", meaning = "Engancha.", note = "No te imaginas quién llamó.")), situation = "Cuentas la noche en que se fue la luz en el hostal y, de repente, todos bajaron a la terraza: resultó ser una fiesta del barrio.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Cuenta el giro: se fue la luz.", expected = listOf("Y de repente, se fue la luz", "De repente se fue la luz", "de repente se fue la luz"), focus = "de repente", watch = "de repente + pasado."), PracticeQuestion(prompt = "Revela la verdad: era gratis.", expected = listOf("Resultó que era gratis", "resulto que era gratis"), focus = "resultó que", watch = "resultó lleva tilde."), PracticeQuestion(prompt = "Di que resultó ser su hermano.", expected = listOf("Resultó ser su hermano", "resulto ser su hermano"), focus = "resultó ser", watch = "resultó ser + persona."), PracticeQuestion(prompt = "Anuncia el clímax: la cena.", expected = listOf("Lo mejor de todo fue la cena", "lo mejor de todo fue la cena"), focus = "lo mejor de todo", watch = "anuncia el momento fuerte."), PracticeQuestion(prompt = "Engancha al oyente: quién llamó.", expected = listOf("No te imaginas quién llamó", "no te imaginas quien llamo"), focus = "no te imaginas", watch = "quién y llamó llevan tilde."))), exercises = listOf(Exercise(id = "es-foundations-u19-sorpresa-e1", kind = "choice", prompt = "Estábamos cenando y, ___, se fue la luz.", options = listOf("de repente", "de verdad", "de nuevo", "de nada"), answers = listOf("de repente"), explain = "De repente marca el giro sin aviso."), Exercise(id = "es-foundations-u19-sorpresa-e2", kind = "gap", prompt = "___ que el concierto era gratis. (revelar la verdad)", options = listOf(), answers = listOf("Resultó", "resultó", "Resulto"), explain = "Resultó que + la verdad escondida."), Exercise(id = "es-foundations-u19-sorpresa-e3", kind = "order", prompt = "Engancha al oyente antes de contar el final.", options = listOf(), answers = listOf("No te imaginas lo que pasó"), explain = "No te imaginas… engancha al oyente."), Exercise(id = "es-foundations-u19-sorpresa-e4", kind = "written", prompt = "Revela la sorpresa: era el vecino.", options = listOf(), answers = listOf("resultó que era el vecino", "resulto que era el vecino", "resultó ser el vecino"), explain = "Resultó que / resultó ser + la verdad.")), skills = listOf("function:tell-a-story", "grammar:connectors", "grammar:past-simple-irregular", "vocab:social-expressions"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-irregular")),
    Lesson(id = "es-foundations-u19-anecdotas", title = "La anécdota del verano", goal = "Contar una anécdota y reaccionar a la de otros: no me digas, ¿y luego?, qué fuerte.", intro = LessonIntro(explanation = listOf("La anécdota es una historia corta y graciosa: contexto, giro y remate. «Pues mira, me pasó en agosto».", "Para reaccionar: «¡No me digas!», «¿Y luego?», «¡Qué fuerte!». Animan a seguir contando.", "El giro con me pega el susto a ti: «Se me cayó el móvil», «Se me olvidó la cartera»."), examples = listOf(ExampleLine(text = "Pues mira, me pasó en agosto.", meaning = "Abre la anécdota."), ExampleLine(text = "Estaba en la cola del bus.", meaning = "El contexto."), ExampleLine(text = "Se me cayó el móvil al suelo.", meaning = "El giro."), ExampleLine(text = "¿Y luego?", meaning = "Pide más historia."), ExampleLine(text = "¡No me digas!", meaning = "Reacciona con sorpresa."))), expressions = listOf(TargetExpression(text = "pues mira, …", meaning = "Abre la anécdota.", note = "Pues mira, me pasó ayer."), TargetExpression(text = "se me cayó / se me olvidó", meaning = "El giro con me.", note = "Se me olvidó la cartera."), TargetExpression(text = "¿y luego?", meaning = "Pide el siguiente hecho.", note = "¿Y luego? ¿Qué hiciste?"), TargetExpression(text = "no me digas", meaning = "Sorpresa del oyente.", note = "¡No me digas!"), TargetExpression(text = "qué fuerte / qué vergüenza", meaning = "Reacciones.", note = "¡Qué vergüenza, tío!")), situation = "En la terraza, cuentas que se te cayó el móvil al mar en agosto; tu amigo no lo puede creer y quiere saber qué pasó después.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Abre tu anécdota de agosto.", expected = listOf("Pues mira, me pasó en agosto", "pues mira me paso en agosto"), focus = "pues mira", watch = "pasó lleva tilde."), PracticeQuestion(prompt = "Di el giro: se te cayó el móvil.", expected = listOf("Se me cayó el móvil", "se me cayo el movil"), focus = "se me cayó", watch = "se me cayó: el giro con me."), PracticeQuestion(prompt = "Pide el siguiente paso de la historia.", expected = listOf("¿Y luego?", "¿Y luego qué?", "y luego"), focus = "¿y luego?", watch = "¿Y luego? pide más historia."), PracticeQuestion(prompt = "Reacciona con sorpresa.", expected = listOf("¡No me digas!", "No me digas", "no me digas"), focus = "no me digas", watch = "Reacción de sorpresa."), PracticeQuestion(prompt = "Reacciona fuerte: qué vergüenza.", expected = listOf("¡Qué vergüenza!", "Que vergüenza", "qué verguenza"), focus = "qué vergüenza", watch = "qué con tilde."))), exercises = listOf(Exercise(id = "es-foundations-u19-anecdotas-e1", kind = "choice", prompt = "—Se me cayó el móvil al mar. —¡No ___ digas!", options = listOf("me", "te", "se", "le"), answers = listOf("me"), explain = "No me digas: fórmula de sorpresa del oyente."), Exercise(id = "es-foundations-u19-anecdotas-e2", kind = "gap", prompt = "¿Y ___? Cuéntame el final. (pedir el siguiente hecho)", options = listOf(), answers = listOf("luego", "Luego"), explain = "¿Y luego? pide el siguiente paso de la historia."), Exercise(id = "es-foundations-u19-anecdotas-e3", kind = "order", prompt = "Abre la anécdota del verano.", options = listOf(), answers = listOf("Pues mira, me pasó en agosto"), explain = "Pues mira + contexto abre la anécdota."), Exercise(id = "es-foundations-u19-anecdotas-e4", kind = "written", prompt = "Di que olvidaste las llaves en la playa.", options = listOf(), answers = listOf("se me olvidaron las llaves en la playa", "se me olvidaron las llaves", "olvidé las llaves en la playa", "olvide las llaves en la playa"), explain = "se me olvidaron: el giro con me.")), skills = listOf("function:tell-a-story", "vocab:social-expressions", "grammar:past-simple-regular", "function:describe-past-events"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-regular"))))
}

object EsFoundationsU22 {
    val unit = CourseUnit(id = "es-foundations-u22", title = "El trabajo", subtitle = "Oficina y metas", level = "B1", themes = listOf(ConversationTheme("la-entrevista", "La entrevista", "Experiencia y puntos fuertes", "briefcase", "Course", "Preparas una entrevista: cuentas tu experiencia con presente perfecto y eliges tus puntos fuertes.", 0),
                ConversationTheme("el-equipo", "El equipo", "Ambiente y propósitos", "bubble.left.and.text.bubble.right", "Course", "Con los compañeros describís el ambiente de la oficina y compartís vuestros planes profesionales.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u22-entrevista", title = "La entrevista", goal = "Hablar de experiencia y puntos fuertes en una entrevista: he trabajado…, llevo…, destaco en….", intro = LessonIntro(explanation = listOf("La experiencia va con presente perfecto: «He trabajado en marketing cinco años». Une el pasado con el ahora.", "El tiempo que sigues dentro se marca con llevar: «Llevo dos años en esta empresa».", "Los puntos fuertes se presentan con ser o destacar: «Soy organizado», «Destaco en el trabajo en equipo»."), examples = listOf(ExampleLine(text = "He trabajado en marketing cinco años.", meaning = "Experiencia con presente perfecto."), ExampleLine(text = "Llevo dos años en esta empresa.", meaning = "El tiempo que sigue vigente."), ExampleLine(text = "Soy organizado y puntual.", meaning = "Puntos fuertes con ser."), ExampleLine(text = "Destaco en el trabajo en equipo.", meaning = "Tu punto fuerte con destacar."), ExampleLine(text = "Además, hablo inglés y francés.", meaning = "Añadir un argumento."))), expressions = listOf(TargetExpression(text = "he trabajado en…", meaning = "Experiencia pasada con valor ahora.", note = "He trabajado en ventas."), TargetExpression(text = "llevo + tiempo + en…", meaning = "Experiencia que sigue.", note = "Llevo tres años aquí."), TargetExpression(text = "soy + adjetivo", meaning = "Puntos fuertes.", note = "Soy organizado."), TargetExpression(text = "destaco en…", meaning = "Lo que mejor sabes hacer.", note = "Destaco en atención al cliente."), TargetExpression(text = "además / por eso", meaning = "Encadenar el argumento.", note = "Además, hablo inglés.")), situation = "Preparas una entrevista: cuentas tus cinco años en marketing, añades los idiomas y eliges tu punto fuerte, el trabajo en equipo.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Cuenta tu experiencia: marketing, cinco años.", expected = listOf("He trabajado en marketing cinco años", "he trabajado en marketing"), focus = "he trabajado", watch = "he + participio: trabajado."), PracticeQuestion(prompt = "Di que sigues dos años en la empresa.", expected = listOf("Llevo dos años en esta empresa", "llevo dos años aquí"), focus = "llevo", watch = "llevo + tiempo: sigue abierto."), PracticeQuestion(prompt = "Da tu punto fuerte con destacar.", expected = listOf("Destaco en el trabajo en equipo", "destaco en el trabajo en equipo"), focus = "destaco en", watch = "destacar en + área."), PracticeQuestion(prompt = "Preséntate: organizado y puntual.", expected = listOf("Soy organizado y puntual", "soy organizada y puntual"), focus = "soy", watch = "ser + adjetivo de carácter."), PracticeQuestion(prompt = "Añade un argumento: hablas inglés.", expected = listOf("Además, hablo inglés", "además hablo ingles"), focus = "además", watch = "además encadena argumentos."))), exercises = listOf(Exercise(id = "es-foundations-u22-entrevista-e1", kind = "choice", prompt = "___ trabajado en ventas tres años.", options = listOf("He", "Hace", "Estoy", "Fui"), answers = listOf("He"), explain = "Presente perfecto: he + participio; la experiencia cuenta para el ahora."), Exercise(id = "es-foundations-u22-entrevista-e2", kind = "gap", prompt = "___ dos años en esta empresa y me gusta el equipo. (llevar)", options = listOf(), answers = listOf("Llevo", "llevo"), explain = "Llevo + tiempo: la experiencia que sigue abierta en el presente."), Exercise(id = "es-foundations-u22-entrevista-e3", kind = "order", prompt = "Di tu punto fuerte con el verbo destacar.", options = listOf(), answers = listOf("Destaco en el trabajo en equipo"), explain = "destacar en + área: la fórmula de los puntos fuertes en entrevista."), Exercise(id = "es-foundations-u22-entrevista-e4", kind = "written", prompt = "Vende tu perfil: experiencia en marketing y, con un conector, los idiomas.", options = listOf(), answers = listOf("he trabajado en marketing y además hablo inglés", "he trabajado en marketing, además hablo inglés", "he trabajado en marketing y ademas hablo ingles"), explain = "he trabajado + además: experiencia y argumento encadenado.")), skills = listOf("function:talk-about-work", "vocab:work", "grammar:present-perfect", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-perfect")),
    Lesson(id = "es-foundations-u22-compañeros", title = "Con los compañeros", goal = "Describir el ambiente de trabajo: el equipo es…, nos llevamos bien, lo mejor es…, lo peor….", intro = LessonIntro(explanation = listOf("El ambiente se describe con ser y estar: «El equipo es muy cercano», «La oficina está siempre a tope».", "Las relaciones van con llevarse: «Nos llevamos bien», «Me llevo genial con mi jefa».", "El balance usa lo mejor y lo peor: «Lo mejor es el ambiente; lo peor, las reuniones de las nueve»."), examples = listOf(ExampleLine(text = "El equipo es muy cercano.", meaning = "Describir el ambiente."), ExampleLine(text = "Nos llevamos muy bien todos.", meaning = "Las relaciones con llevarse."), ExampleLine(text = "Me llevo genial con mi jefa.", meaning = "La relación con una persona."), ExampleLine(text = "La oficina está siempre a tope.", meaning = "El ritmo con estar."), ExampleLine(text = "Lo mejor es el café de las once.", meaning = "El balance positivo."))), expressions = listOf(TargetExpression(text = "el ambiente de trabajo", meaning = "El clima de la oficina.", note = "El ambiente es bueno."), TargetExpression(text = "nos llevamos + bien/mal", meaning = "La relación del grupo.", note = "Nos llevamos muy bien."), TargetExpression(text = "me llevo + bien/mal + con…", meaning = "La relación con alguien.", note = "Me llevo bien con mi jefe."), TargetExpression(text = "lo mejor es…, lo peor…", meaning = "El balance.", note = "Lo peor son las reuniones."), TargetExpression(text = "en general", meaning = "La valoración global.", note = "En general, estamos a gusto.")), situation = "En el café de la oficina describís el ambiente: os lleváis bien, el equipo es cercano, pero lo peor son las reuniones de las nueve.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Describe el ambiente: el equipo, cercano.", expected = listOf("El equipo es muy cercano", "el equipo es cercano"), focus = "es cercano", watch = "ser para el carácter del grupo."), PracticeQuestion(prompt = "Di cómo os lleváis en el equipo.", expected = listOf("Nos llevamos muy bien", "nos llevamos bien"), focus = "nos llevamos", watch = "llevarse bien: relación mutua."), PracticeQuestion(prompt = "Di tu relación con la jefa.", expected = listOf("Me llevo genial con mi jefa", "me llevo bien con mi jefa"), focus = "me llevo con", watch = "con + persona."), PracticeQuestion(prompt = "Di lo peor de la oficina: las reuniones.", expected = listOf("Lo peor son las reuniones", "lo peor son las reuniones de las nueve"), focus = "lo peor", watch = "lo mejor / lo peor balancean."), PracticeQuestion(prompt = "Valora en global: estáis a gusto.", expected = listOf("En general, estamos a gusto", "en general estamos a gusto"), focus = "en general", watch = "en general: valoración global."))), exercises = listOf(Exercise(id = "es-foundations-u22-compañeros-e1", kind = "choice", prompt = "En la oficina ___ llevamos muy bien todos.", options = listOf("nos", "se", "les", "me"), answers = listOf("nos"), explain = "llevarse bien: relación entre personas; nos marca el grupo."), Exercise(id = "es-foundations-u22-compañeros-e2", kind = "gap", prompt = "Lo ___ de la oficina es el café de las once; lo peor, las reuniones.", options = listOf(), answers = listOf("mejor", "Mejor"), explain = "lo mejor…, lo peor…: el balance del ambiente en dos mitades."), Exercise(id = "es-foundations-u22-compañeros-e3", kind = "order", prompt = "Describe la relación de tu equipo con llevarse.", options = listOf(), answers = listOf("Nos llevamos muy bien en el equipo"), explain = "nos llevamos + bien/mal: la descripción de la relación del grupo."), Exercise(id = "es-foundations-u22-compañeros-e4", kind = "written", prompt = "Haz el balance: equipo cercano, pero hay demasiadas reuniones.", options = listOf(), answers = listOf("el equipo es muy cercano, pero hay demasiadas reuniones", "el equipo es cercano pero hay demasiadas reuniones", "el equipo es muy cercano, pero lo peor son las reuniones"), explain = "Descripción + pero + lo peor: el balance honesto del ambiente.")), skills = listOf("function:talk-about-work", "vocab:work", "function:describe-people", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "es-foundations-u22-propositos", title = "Propósitos laborales", goal = "Hablar de metas profesionales: quiero lograr…, me gustaría…, para ello voy a….", intro = LessonIntro(explanation = listOf("La meta se abre con querer + lograr: «Quiero lograr un ascenso este año». Lograr es conseguir la meta.", "Me gustaría suaviza el deseo: «Me gustaría cambiar de departamento». Suena menos rotundo que quiero.", "El plan se encadena con conectores: «Para ello, voy a formarme», «Así que este año me presento»."), examples = listOf(ExampleLine(text = "Quiero lograr un ascenso este año.", meaning = "La meta con querer + lograr."), ExampleLine(text = "Me gustaría cambiar de departamento.", meaning = "El deseo con matiz."), ExampleLine(text = "Para ello, voy a formarme.", meaning = "El plan encadenado."), ExampleLine(text = "Así que este año me presento.", meaning = "La consecuencia con así que."), ExampleLine(text = "Mi meta es aprender inglés.", meaning = "La meta con ser."))), expressions = listOf(TargetExpression(text = "quiero lograr…", meaning = "La meta directa.", note = "Quiero lograr un ascenso."), TargetExpression(text = "me gustaría + infinitivo", meaning = "El deseo con matiz.", note = "Me gustaría viajar por trabajo."), TargetExpression(text = "para ello, …", meaning = "Encadena el plan.", note = "Para ello, me formo."), TargetExpression(text = "así que este año…", meaning = "La consecuencia del deseo.", note = "Así que me presento."), TargetExpression(text = "mi meta es…", meaning = "La meta con ser.", note = "Mi meta es el examen B2.")), situation = "A inicio de año compartís propósitos: tú quieres lograr un ascenso y, para ello, te vas a formar; tu compañero prefiere cambiar de aires.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di tu meta: el ascenso, este año.", expected = listOf("Quiero lograr un ascenso este año", "quiero lograr un ascenso"), focus = "quiero lograr", watch = "querer + infinitivo."), PracticeQuestion(prompt = "Suaviza el deseo: cambiar de departamento.", expected = listOf("Me gustaría cambiar de departamento", "me gustaria cambiar de departamento"), focus = "me gustaría", watch = "gustaría lleva tilde."), PracticeQuestion(prompt = "Encadena el plan: formarte.", expected = listOf("Para ello, voy a formarme", "para ello voy a formarme"), focus = "para ello", watch = "para ello: conecta meta y plan."), PracticeQuestion(prompt = "Di tu meta con ser: el inglés.", expected = listOf("Mi meta es aprender inglés", "mi meta es aprender ingles"), focus = "mi meta es", watch = "mi meta es + infinitivo."), PracticeQuestion(prompt = "Cierra con la consecuencia: te presentas este año.", expected = listOf("Así que este año me presento", "asi que este año me presento"), focus = "así que", watch = "así que: consecuencia."))), exercises = listOf(Exercise(id = "es-foundations-u22-propositos-e1", kind = "choice", prompt = "Quiero ___ un ascenso este año.", options = listOf("lograr", "logro", "logré", "logrando"), answers = listOf("lograr"), explain = "querer + infinitivo: quiero lograr; logrado sería participio y no encaja."), Exercise(id = "es-foundations-u22-propositos-e2", kind = "gap", prompt = "___ cambiar de departamento el año que viene. (deseo con matiz)", options = listOf(), answers = listOf("Me gustaría", "me gustaría", "Me gustaria", "me gustaria"), explain = "Me gustaría + infinitivo: el deseo suave; gustaría lleva tilde."), Exercise(id = "es-foundations-u22-propositos-e3", kind = "order", prompt = "Di tu meta para este año con la fórmula de ser.", options = listOf(), answers = listOf("Mi meta es aprender inglés"), explain = "mi meta es + infinitivo: presentar la meta con ser."), Exercise(id = "es-foundations-u22-propositos-e4", kind = "written", prompt = "Cuenta tu plan completo: la meta es el ascenso y el paso es formarte.", options = listOf(), answers = listOf("quiero lograr un ascenso, así que voy a formarme", "quiero lograr un ascenso y voy a formarme", "para lograr un ascenso voy a formarme"), explain = "Meta + para ello + plan: la estructura del propósito laboral.")), skills = listOf("function:describe-goals", "function:talk-about-work", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors"))))
}

object EsFoundationsU27 {
    val unit = CourseUnit(id = "es-foundations-u27", title = "La ciudad que quiero", subtitle = "Opinar, proponer y consumir", level = "B1", themes = listOf(ConversationTheme("el-barrio", "El barrio", "Opiniones y propuestas", "building.2", "Course", "Debatís el futuro del barrio: opiniones con matices y una propuesta para el ayuntamiento.", 0),
                ConversationTheme("el-consumo", "El consumo", "Consumo responsable", "leaf", "Course", "Pensáis en cómo consumís: comprar menos y mejor, reparar y comprar de segunda mano.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u27-opinar", title = "Mi barrio, mi opinión", goal = "Opinar sobre la ciudad con matices: en mi opinión…, por un lado…, por otro lado…, lo que me molesta es…", intro = LessonIntro(explanation = listOf("La opinión se abre con fórmulas: «En mi opinión…», «Creo que el barrio ha cambiado mucho».", "El matiz va con por un lado…, por otro (lado)…: «Por un lado, hay más zonas verdes; por otro, hay más ruido».", "Justifica con porque + dato: «Creo que falta transporte, porque la última línea de bus llegó en 2010»."), examples = listOf(ExampleLine(text = "En mi opinión, el barrio ha cambiado mucho.", meaning = "Abrir la opinión."), ExampleLine(text = "Por un lado, hay más zonas verdes.", meaning = "La parte buena."), ExampleLine(text = "Por otro lado, hay mucho tráfico.", meaning = "La parte mala."), ExampleLine(text = "Lo que más me molesta es el ruido.", meaning = "La queja concreta."), ExampleLine(text = "Estoy a favor de más carriles bici.", meaning = "Posicionarse."))), expressions = listOf(TargetExpression(text = "en mi opinión, …", meaning = "Abrir la opinión.", note = "En mi opinión, falta transporte."), TargetExpression(text = "por un lado…, por otro…", meaning = "Los dos lados.", note = "Por un lado es barato; por otro, es lento."), TargetExpression(text = "lo que más me molesta es…", meaning = "La queja.", note = "Lo que más me molesta es el ruido."), TargetExpression(text = "a favor de / en contra de", meaning = "Posicionarse.", note = "Estoy a favor de más zonas verdes."), TargetExpression(text = "creo que…, porque…", meaning = "Opinar y justificar.", note = "Creo que funciona, porque hay más gente en la calle.")), situation = "En la asociación de vecinos opináis sobre el barrio: más zonas verdes pero más tráfico, y cada uno justifica su postura con datos.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Abre tu opinión sobre los cambios del barrio.", expected = listOf("En mi opinión, el barrio ha cambiado mucho", "Creo que el barrio ha cambiado mucho", "en mi opinion el barrio ha cambiado mucho"), focus = "en mi opinión", watch = "en mi opinión abre; después, el matiz."), PracticeQuestion(prompt = "Matiza: más zonas verdes, pero más tráfico.", expected = listOf("Por un lado hay más zonas verdes; por otro, hay más tráfico", "Por un lado hay más zonas verdes; por otro lado, más tráfico", "por un lado mas zonas verdes por otro mas trafico"), focus = "por un lado…, por otro…", watch = "los conectores presentan los dos lados."), PracticeQuestion(prompt = "Di tu queja principal sobre la ciudad.", expected = listOf("Lo que más me molesta es el ruido", "lo que mas me molesta es el ruido", "Lo que más me molesta es el ruido de los bares"), focus = "lo que me molesta", watch = "la queja con estructura fija."), PracticeQuestion(prompt = "Posiciónate a favor de los carriles bici.", expected = listOf("Estoy a favor de más carriles bici", "Estoy a favor del carril bici", "estoy a favor de los carriles bici"), focus = "a favor de", watch = "a favor de / en contra de + nombre."), PracticeQuestion(prompt = "Justifica con una razón tu opinión sobre el transporte.", expected = listOf("Creo que falta transporte porque la última línea llegó en 2010", "Falta transporte, porque los buses tardan mucho", "creo que falta transporte"), focus = "porque", watch = "porque + dato: la justificación."))), exercises = listOf(Exercise(id = "es-foundations-u27-opinar-e1", kind = "choice", prompt = "___ mi opinión, el barrio ha cambiado mucho.", options = listOf("En", "Por", "Con", "De"), answers = listOf("En"), explain = "en mi opinión: fórmula fija para abrir la opinión."), Exercise(id = "es-foundations-u27-opinar-e2", kind = "gap", prompt = "Por un lado, hay más zonas verdes; por ___, hay más tráfico.", options = listOf(), answers = listOf("otro", "Otro"), explain = "por un lado… por otro…: los dos lados del matiz."), Exercise(id = "es-foundations-u27-opinar-e3", kind = "order", prompt = "Di tu queja principal sobre la ciudad.", options = listOf(), answers = listOf("Lo que más me molesta es el ruido"), explain = "lo que más me molesta es…: la estructura de la queja concreta."), Exercise(id = "es-foundations-u27-opinar-e4", kind = "written", prompt = "Opina y justifica: el barrio, mejor, con más zonas verdes.", options = listOf(), answers = listOf("el barrio es mejor porque tiene más zonas verdes", "el barrio ha mejorado porque tiene más zonas verdes", "creo que el barrio es mejor porque tiene más zonas verdes"), explain = "opinión + porque + dato: la estructura B1 de la justificación.")), skills = listOf("function:express-opinion", "grammar:connectors", "speaking:justify-opinion", "grammar:comparatives"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "es-foundations-u27-propuesta", title = "La propuesta vecinal", goal = "Escribir y defender una propuesta: proponemos…, porque…, además…, por eso pedimos…", intro = LessonIntro(explanation = listOf("La propuesta se abre con proponemos + infinitivo: «Proponemos peatonalizar la calle del Mercado».", "Los argumentos van con porque / además: «Porque hay mucho tráfico», «Además, es peligroso para los niños».", "Se cierra con por eso + pedimos: «Por eso pedimos una zona peatonal»."), examples = listOf(ExampleLine(text = "Proponemos peatonalizar la calle del Mercado.", meaning = "La propuesta."), ExampleLine(text = "Porque ahora hay mucho tráfico.", meaning = "El argumento uno."), ExampleLine(text = "Además, es peligroso para los niños.", meaning = "El argumento dos."), ExampleLine(text = "Por eso pedimos una zona peatonal.", meaning = "El cierre."), ExampleLine(text = "Doscientos vecinos ya han firmado la carta.", meaning = "El apoyo."))), expressions = listOf(TargetExpression(text = "proponemos + infinitivo", meaning = "Abrir la propuesta.", note = "Proponemos más árboles en la plaza."), TargetExpression(text = "porque + argumento", meaning = "Justificar.", note = "Porque la calle es muy ruidosa."), TargetExpression(text = "además, …", meaning = "Sumar un argumento.", note = "Además, el aire está más limpio."), TargetExpression(text = "por eso pedimos…", meaning = "El cierre con petición.", note = "Por eso pedimos vuestro apoyo."), TargetExpression(text = "firmar la carta", meaning = "Apoyar la propuesta.", note = "Ya han firmado doscientos vecinos.")), situation = "Escribís una carta al ayuntamiento: proponéis peatonalizar la calle del Mercado, dais dos argumentos y pedís una reunión para explicarlo.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Abre la carta con la propuesta: peatonalizar la calle del Mercado.", expected = listOf("Proponemos peatonalizar la calle del Mercado", "proponemos peatonalizar la calle del mercado", "Proponemos peatonalizar la calle"), focus = "proponemos", watch = "proponemos + infinitivo."), PracticeQuestion(prompt = "Da el primer argumento: mucho tráfico.", expected = listOf("Porque ahora hay mucho tráfico", "Porque hay demasiado tráfico", "porque hay mucho trafico"), focus = "porque", watch = "porque + el problema actual."), PracticeQuestion(prompt = "Suma el segundo argumento: los niños.", expected = listOf("Además, es peligroso para los niños", "ademas es peligroso para los niños", "Además, los niños no pueden cruzar tranquilos"), focus = "además", watch = "además suma un segundo motivo."), PracticeQuestion(prompt = "Cierra con la petición: la zona peatonal.", expected = listOf("Por eso pedimos una zona peatonal", "por eso pedimos zona peatonal", "Por eso pedimos peatonalizar la calle"), focus = "por eso", watch = "por eso conecta argumentos y petición."), PracticeQuestion(prompt = "Informa: la carta ya tiene las firmas del barrio.", expected = listOf("Los vecinos ya han firmado la carta", "ya hemos firmado la carta", "Doscientos vecinos han firmado la carta"), focus = "firmar", watch = "han firmado: presente perfecto."))), exercises = listOf(Exercise(id = "es-foundations-u27-propuesta-e1", kind = "choice", prompt = "___ peatonalizar la calle del Mercado.", options = listOf("Proponemos", "Proponía", "Propongan", "Proponed"), answers = listOf("Proponemos"), explain = "proponemos + infinitivo: la propuesta de la carta, en nosotros."), Exercise(id = "es-foundations-u27-propuesta-e2", kind = "gap", prompt = "___ eso pedimos una reunión con el ayuntamiento. (conector de cierre)", options = listOf(), answers = listOf("Por", "por"), explain = "por eso + petición: el conector que cierra el argumento."), Exercise(id = "es-foundations-u27-propuesta-e3", kind = "order", prompt = "Cierra la carta con la petición.", options = listOf(), answers = listOf("Por eso pedimos una zona peatonal"), explain = "por eso + pedimos: el cierre con la petición concreta."), Exercise(id = "es-foundations-u27-propuesta-e4", kind = "written", prompt = "Escribe la propuesta con su argumento: más árboles, hace calor en verano.", options = listOf(), answers = listOf("proponemos más árboles porque hace calor en verano", "proponemos mas arboles porque hace calor en verano", "proponemos plantar más árboles porque hace calor"), explain = "proponemos + porque: la estructura mínima de la propuesta.")), skills = listOf("function:express-opinion", "writing:argument", "grammar:connectors", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "es-foundations-u27-consumo", title = "Consumir con cabeza", goal = "Opinar sobre hábitos de consumo: comprar menos y mejor, reparar en vez de tirar, de segunda mano.", intro = LessonIntro(explanation = listOf("La crítica se abre igual que una opinión: «Creo que compramos demasiadas cosas».", "La alternativa va con en vez de + infinitivo: «Reparar en vez de tirar».", "Los dos lados otra vez: «Por un lado, ahorro dinero; por otro, ayudo al planeta»."), examples = listOf(ExampleLine(text = "Creo que compramos demasiadas cosas.", meaning = "La crítica."), ExampleLine(text = "Antes de comprar, pienso si lo necesito.", meaning = "El hábito bueno."), ExampleLine(text = "Compro de segunda mano porque es más barato.", meaning = "La alternativa."), ExampleLine(text = "Reparar es mejor que tirar.", meaning = "Comparar hábitos."), ExampleLine(text = "Por un lado ahorro; por otro, ayudo al planeta.", meaning = "Los dos lados."))), expressions = listOf(TargetExpression(text = "demasiado/a/os/as", meaning = "El exceso.", note = "Compramos demasiada ropa."), TargetExpression(text = "antes de + infinitivo", meaning = "El hábito de pensar.", note = "Antes de comprar, pienso."), TargetExpression(text = "en vez de + infinitivo", meaning = "La alternativa.", note = "Reparo en vez de tirar."), TargetExpression(text = "de segunda mano", meaning = "Lo ya usado.", note = "Compro libros de segunda mano."), TargetExpression(text = "es mejor que…", meaning = "Comparar hábitos.", note = "Ahorrar es mejor que deber.")), situation = "En el taller de consumo responsable del barrio comentáis vuestros hábitos: comprar menos, reparar ropa y muebles y buscar segunda mano antes de comprar nuevo.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di tu crítica sobre el consumo actual.", expected = listOf("Creo que compramos demasiadas cosas", "compramos demasiadas cosas", "Compramos demasiada ropa"), focus = "demasiadas", watch = "demasiado concuerda: demasiadas cosas."), PracticeQuestion(prompt = "Di tu hábito: pensar antes de comprar.", expected = listOf("Antes de comprar, pienso si lo necesito", "antes de comprar pienso si lo necesito", "Antes de comprar, pienso"), focus = "antes de", watch = "antes de + infinitivo."), PracticeQuestion(prompt = "Di la alternativa a tirar: reparar.", expected = listOf("Reparar en vez de tirar", "reparo en vez de tirar", "Reparar en vez de tirar es mejor"), focus = "en vez de", watch = "en vez de + infinitivo."), PracticeQuestion(prompt = "Di que compras libros usados.", expected = listOf("Compro libros de segunda mano", "compro libros usados", "Compro de segunda mano"), focus = "de segunda mano", watch = "de segunda mano: lo ya usado."), PracticeQuestion(prompt = "Resume los dos lados: dinero y planeta.", expected = listOf("Por un lado ahorro dinero; por otro, ayudo al planeta", "Por un lado ahorro dinero, por otro ayudo al planeta", "por un lado ahorro por otro ayudo al planeta"), focus = "por un lado…, por otro…", watch = "el matiz de los dos lados otra vez."))), exercises = listOf(Exercise(id = "es-foundations-u27-consumo-e1", kind = "choice", prompt = "Compramos ___ ropa: no nos cabe en el armario.", options = listOf("demasiada", "muy", "más que", "tantas"), answers = listOf("demasiada"), explain = "demasiada ropa: cantidad excesiva; concuerda con el nombre."), Exercise(id = "es-foundations-u27-consumo-e2", kind = "gap", prompt = "Reparo ___ vez de tirar. (alternativa)", options = listOf(), answers = listOf("en", "En"), explain = "en vez de + infinitivo: la alternativa al hábito malo."), Exercise(id = "es-foundations-u27-consumo-e3", kind = "order", prompt = "Compara los dos hábitos con mejor.", options = listOf(), answers = listOf("Reparar es mejor que tirar"), explain = "es mejor que: la comparación entre dos hábitos."), Exercise(id = "es-foundations-u27-consumo-e4", kind = "written", prompt = "Opina sobre la compra de segunda mano con una razón.", options = listOf(), answers = listOf("compro de segunda mano porque es más barato", "compro de segunda mano porque es mas barato", "comprar de segunda mano es mejor porque ahorra dinero"), explain = "hábito + porque + razón: la opinión justificada.")), skills = listOf("grammar:connectors", "writing:argument", "function:express-opinion", "grammar:comparatives"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors"))))
}

object EsFoundationsU8 {
    val unit = CourseUnit(id = "es-foundations-u8", title = "Opiniones y matices", subtitle = "Si tuviera…", level = "B2", themes = listOf(ConversationTheme("es-b2-hipotesis", "Planes imposibles", "Si tuviera tiempo", "sparkles", "Course", "Debatís qué haríais con tiempo libre infinito y proponéis un compromiso real.", 0),
                ConversationTheme("es-b2-trato", "El regateo", "¿Y si lo dejamos en 50?", "handshake", "Course", "Negociáis una compra de segunda mano: oferta, condiciones y cierre.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u8-hipotetico", title = "Si tuviera tiempo…", goal = "Opinar sobre hipótesis con el condicional compuesto (si + imperfecto de subjuntivo, …ría).", intro = LessonIntro(explanation = listOf("La hipótesis irreal: « Si tuviera tiempo, viajaría más ». La parte con « si » va en imperfecto de subjuntivo; la otra, en condicional (-ría).", "Nunca « si + condicional »: se dice « si tuviera », no « si tendría ».", "Sirve para opinar con tacto: « Yo en tu lugar lo intentaría », « No es que no quiera; es que no podría »."), examples = listOf(ExampleLine(text = "Si tuviera más tiempo, viajaría más.", meaning = "Hipótesis irreal."), ExampleLine(text = "Yo en tu lugar lo intentaría.", meaning = "Consejo con tacto."), ExampleLine(text = "Si pudiera, cambiaría de trabajo.", meaning = "poder → pudiera / podría."), ExampleLine(text = "¿Y si nos viéramos el jueves?", meaning = "Propuesta suave."), ExampleLine(text = "No es que no quiera; es que no podría.", meaning = "Matiz: querer vs poder."))), expressions = listOf(TargetExpression(text = "Si + imperfecto de subjuntivo, …ría", meaning = "Hipótesis.", note = "Si tuviera…, viajaría."), TargetExpression(text = "tener → tuviera", meaning = "Subjuntivo clave.", note = "Si tuviera tiempo."), TargetExpression(text = "poder → pudiera", meaning = "Subjuntivo clave.", note = "Si pudiera, lo haría."), TargetExpression(text = "Yo en tu lugar, …ría", meaning = "Consejo.", note = "…lo intentaría."), TargetExpression(text = "¿Y si + imperfecto…?", meaning = "Propuesta.", note = "¿Y si lo probáramos ?")), situation = "Debatís planes imposibles: con más tiempo, con otro trabajo, en otra ciudad — y proponéis un compromiso real para este mes.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di tu hipótesis: si tuvieras más tiempo, viajarías más.", expected = listOf("Si tuviera mas tiempo viajaria mas", "Si tuviera más tiempo, viajaría más"), focus = "si tuviera…ría", watch = "Imperfecto de subjuntivo + condicional."), PracticeQuestion(prompt = "Da un consejo con tacto: en mi lugar lo intentaría.", expected = listOf("Yo en tu lugar lo intentaría", "En tu lugar lo intentaría"), focus = "en tu lugar", watch = "Yo en tu lugar + condicional."), PracticeQuestion(prompt = "Di que si pudieras, cambiarías de trabajo.", expected = listOf("Si pudiera cambiaria de trabajo", "Si pudiera, cambiaría de trabajo"), focus = "pudiera/podría", watch = "poder: pudiera… cambiaría."), PracticeQuestion(prompt = "Propón suave: ¿y si nos viéramos el jueves?", expected = listOf("Y si nos viéramos el jueves", "¿Y si nos viéramos el jueves ?"), focus = "¿y si…?", watch = "¿Y si + imperfecto de subjuntivo ?"), PracticeQuestion(prompt = "Matico: no es que no quiera; es que no podría.", expected = listOf("No es que no quiera es que no podria", "No es que no quiera; es que no podría"), focus = "no es que…", watch = "Contraste querer/poder."))), exercises = listOf(Exercise(id = "es-foundations-u8-hipotetico-e1", kind = "choice", prompt = "Si ___ más tiempo, viajaría más.", options = listOf("tuviera", "tendría", "tengo", "tenía"), answers = listOf("tuviera"), explain = "Con « si » irreal: imperfecto de subjuntivo."), Exercise(id = "es-foundations-u8-hipotetico-e2", kind = "gap", prompt = "Si pudiera, ___ de trabajo. (cambiar, condicional)", options = listOf(), answers = listOf("cambiaría", "cambiaria"), explain = "pudiera + condicional: cambiaría."), Exercise(id = "es-foundations-u8-hipotetico-e3", kind = "order", prompt = "Consejo con tacto: yo en tu lugar lo intentaría.", options = listOf(), answers = listOf("Yo en tu lugar lo intentaría"), explain = "en tu lugar + condicional."), Exercise(id = "es-foundations-u8-hipotetico-e4", kind = "written", prompt = "Tu hipótesis con el trabajo: si pudieras, cambiarías de trabajo.", options = listOf(), answers = listOf("si pudiera cambiaria de trabajo", "si pudiera, cambiaría de trabajo", "si pudieras cambiaria de trabajo"), explain = "Si pudiera, cambiaría de trabajo.")), skills = listOf("grammar:second-conditional", "function:express-opinion", "speaking:justify-opinion", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:past-simple-irregular", "grammar:connectors")),
    Lesson(id = "es-foundations-u8-registro", title = "Se dice que…", goal = "Hablar de lo que otros afirman: estilo impersonal con « se » y pasiva con « ser + participio ».", intro = LessonIntro(explanation = listOf("El impersonal: « Se dice que el barrio cambia ». No importa quién lo dice.", "La pasiva con participio: « El concierto fue cancelado », « Las entradas se han agotado ». Común en noticias.", "El registro sube con la pasiva y baja con el impersonal: noticias « oficiales » frente a rumor de barrio."), examples = listOf(ExampleLine(text = "Se dice que el barrio va a cambiar.", meaning = "Impersonal: rumor."), ExampleLine(text = "El concierto fue cancelado por la lluvia.", meaning = "Pasiva + agente."), ExampleLine(text = "Las entradas se han agotado.", meaning = "Pasiva refleja."), ExampleLine(text = "Se han cancelado todos los trenes.", meaning = "Noticia oficial."), ExampleLine(text = "Según el ayuntamiento, se retrasará la obra.", meaning = "Fuente + impersonal."))), expressions = listOf(TargetExpression(text = "Se dice que…", meaning = "Rumor.", note = "…el barrio va a cambiar."), TargetExpression(text = "fue/será + participio", meaning = "Pasiva.", note = "fue cancelado."), TargetExpression(text = "se han + participio", meaning = "Pasiva refleja.", note = "se han agotado."), TargetExpression(text = "Según + fuente", meaning = "Citar.", note = "Según el ayuntamiento."), TargetExpression(text = "se retrasará / se cancelará", meaning = "Futuro impersonal.", note = "noticias.")), situation = "Comentáis las noticias del barrio: qué se dice, qué se ha decidido y qué fuente creéis menos.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Transmite el rumor: se dice que el barrio va a cambiar.", expected = listOf("Se dice que el barrio va a cambiar"), focus = "se dice que", watch = "Impersonal, sin sujeto."), PracticeQuestion(prompt = "Noticia: el concierto fue cancelado por la lluvia.", expected = listOf("El concierto fue cancelado por la lluvia"), focus = "fue cancelado", watch = "ser + participio + por."), PracticeQuestion(prompt = "Di que las entradas se han agotado.", expected = listOf("Las entradas se han agotado"), focus = "se han agotado", watch = "Pasiva refleja con participio."), PracticeQuestion(prompt = "Cita la fuente: según el ayuntamiento, se retrasará la obra.", expected = listOf("Segun el ayuntamiento se retrasara la obra", "Según el ayuntamiento, se retrasará la obra"), focus = "según", watch = "Según + fuente."), PracticeQuestion(prompt = "Di que se han cancelado todos los trenes.", expected = listOf("Se han cancelado todos los trenes"), focus = "se han cancelado", watch = "Pasiva refleja plural."))), exercises = listOf(Exercise(id = "es-foundations-u8-registro-e1", kind = "choice", prompt = "___ dice que el barrio va a cambiar.", options = listOf("Se", "Es", "Hay", "Lo"), answers = listOf("Se"), explain = "Impersonal: se dice que."), Exercise(id = "es-foundations-u8-registro-e2", kind = "gap", prompt = "El concierto fue ___ por la lluvia. (cancelar)", options = listOf(), answers = listOf("cancelado"), explain = "ser + participio: cancelado."), Exercise(id = "es-foundations-u8-registro-e3", kind = "order", prompt = "Noticia: se han cancelado los trenes.", options = listOf(), answers = listOf("Se han cancelado todos los trenes"), explain = "se han + participio."), Exercise(id = "es-foundations-u8-registro-e4", kind = "written", prompt = "Rumor del barrio: hablará de un mercado nuevo que abrirá.", options = listOf(), answers = listOf("se dice que abrira un mercado nuevo", "se dice que abrirán un mercado nuevo"), explain = "Se dice que + futuro.")), skills = listOf("grammar:passive-intro", "grammar:present-perfect", "function:express-opinion", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:past-simple-regular", "grammar:verb-be")),
    Lesson(id = "es-foundations-u8-negociar", title = "¿Y si lo dejamos en 50?", goal = "Negociar un acuerdo: proponer con condicional, poner condiciones y cerrar.", intro = LessonIntro(explanation = listOf("Proponer: « ¿Y si lo dejáramos en 50 ? », « Yo te daría 60 si incluyes el transporte ».", "Poner condiciones: « Solo si me lo entregas hoy », « A cambio, te pido… ».", "Cerrar: « Trato hecho », « De acuerdo, pero con una condición »."), examples = listOf(ExampleLine(text = "¿Y si lo dejáramos en 50 ?", meaning = "Propuesta con subjuntivo."), ExampleLine(text = "Te daría 60 si incluyes el transporte.", meaning = "Condicional + condición."), ExampleLine(text = "Solo si me lo entregas hoy.", meaning = "Condición dura."), ExampleLine(text = "A cambio, te pido la garantía.", meaning = "Contraoferta."), ExampleLine(text = "Trato hecho.", meaning = "Cierre."))), expressions = listOf(TargetExpression(text = "¿Y si lo dejáramos en…?", meaning = "Proponer precio.", note = "dejáramos en 50."), TargetExpression(text = "…ría si + presente", meaning = "Condiciones.", note = "te daría 60 si…"), TargetExpression(text = "solo si…", meaning = "Condición dura.", note = "solo si es hoy."), TargetExpression(text = "a cambio, …", meaning = "Contraoferta.", note = "a cambio, la garantía."), TargetExpression(text = "trato hecho", meaning = "Cerrar.", note = "tras el acuerdo.")), situation = "Regateáis una mesa de segunda mano: abrís alto, ofrecéis con condiciones y cerráis a mitad de camino.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Propone precio: ¿y si lo dejáramos en 50?", expected = listOf("Y si lo dejaramos en 50", "¿Y si lo dejáramos en 50 ?"), focus = "¿y si…?", watch = "dejáramos: subjuntivo de propuesta."), PracticeQuestion(prompt = "Ofrece con condición: te daría 60 si incluyes el transporte.", expected = listOf("Te daria 60 si incluyes el transporte", "Te daría 60 si incluyes el transporte"), focus = "daría si", watch = "Condicional + si + presente."), PracticeQuestion(prompt = "Pon condición dura: solo si me lo entregas hoy.", expected = listOf("Solo si me lo entregas hoy"), focus = "solo si", watch = "Solo si + presente."), PracticeQuestion(prompt = "Contraoferta: a cambio, te pido la garantía.", expected = listOf("A cambio te pido la garantia", "A cambio, te pido la garantía"), focus = "a cambio", watch = "A cambio + petición."), PracticeQuestion(prompt = "Cierra el trato.", expected = listOf("Trato hecho", "De acuerdo"), focus = "trato hecho", watch = "Frase fija de cierre."))), exercises = listOf(Exercise(id = "es-foundations-u8-negociar-e1", kind = "choice", prompt = "¿Y si lo ___ en 50 ?", options = listOf("dejáramos", "dejamos ayer", "dejaríamos que", "dejar"), answers = listOf("dejáramos"), explain = "Propuesta: dejáramos (subjuntivo)."), Exercise(id = "es-foundations-u8-negociar-e2", kind = "gap", prompt = "Te ___ 60 si incluyes el transporte. (dar, condicional)", options = listOf(), answers = listOf("daría", "daria"), explain = "daría + si + presente."), Exercise(id = "es-foundations-u8-negociar-e3", kind = "order", prompt = "Condición dura: solo si me lo entregas hoy.", options = listOf(), answers = listOf("Solo si me lo entregas hoy"), explain = "solo si + presente."), Exercise(id = "es-foundations-u8-negociar-e4", kind = "written", prompt = "Cierra el trato poniendo un pero.", options = listOf(), answers = listOf("de acuerdo pero con una condicion", "de acuerdo, pero con una condición"), explain = "De acuerdo, pero…")), skills = listOf("function:negotiate", "grammar:second-conditional", "speaking:negotiate", "grammar:connectors"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors"))))
}

object EsFoundationsU9 {
    val unit = CourseUnit(id = "es-foundations-u9", title = "Medios y argumento", subtitle = "La noticia que leí", level = "B2", themes = listOf(ConversationTheme("es-b2-noticias", "Semana de noticias", "Lo que se dijo", "newspaper", "Course", "Resumís la semana con relativos: quién, dónde y qué pasó.", 0),
                ConversationTheme("es-b2-columna", "Tu columna", "Por un lado… por otro…", "pencil", "Course", "Escribís una columna de opinión sobre peatonalizar el centro.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u9-relativos", title = "La noticia que leí", goal = "Contar noticias con oraciones de relativo: que, quien, donde, cuyo.", intro = LessonIntro(explanation = listOf("La relativa explica el sustantivo: « La noticia que leí dice que… », « El periodista quien lo entrevistó… ».", "« Donde » para lugares: « La plaza donde se manifestaron ». « Cuyo » para posesión: « la empresa cuyo director dimitió ».", "En noticias, las relativas comprimen información: quién, dónde, qué pasó."), examples = listOf(ExampleLine(text = "La noticia que leí dice que…", meaning = "Relativa de objeto."), ExampleLine(text = "El periodista que lo entrevistó dimitió.", meaning = "Relativa de sujeto."), ExampleLine(text = "La plaza donde se manifestaron es céntrica.", meaning = "donde + lugar."), ExampleLine(text = "La empresa cuyo director dimitió reaccionó.", meaning = "cuyo = posesión."), ExampleLine(text = "Todo lo que sé viene de la radio.", meaning = "todo lo que + verbo."))), expressions = listOf(TargetExpression(text = "el/la que…", meaning = "Relativa.", note = "la noticia que leí."), TargetExpression(text = "quien…", meaning = "Persona.", note = "quien lo entrevistó."), TargetExpression(text = "donde…", meaning = "Lugar.", note = "la plaza donde…"), TargetExpression(text = "cuyo/a…", meaning = "Posesión.", note = "la empresa cuyo director…"), TargetExpression(text = "todo lo que…", meaning = "Generalizar.", note = "todo lo que sé.")), situation = "Resumís una semana de noticias: la historia que más impactó, la persona que habló y el lugar donde pasó.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Resume: la noticia que leíste dice que el museo amplía horarios.", expected = listOf("La noticia que lei dice que el museo amplia horarios", "La noticia que leí dice que el museo amplía horarios"), focus = "que leí", watch = "Relativa sobre la noticia."), PracticeQuestion(prompt = "Di quién: el periodista que lo entrevistó dimitió.", expected = listOf("El periodista que lo entrevistó dimitió"), focus = "que lo entrevistó", watch = "Relativa de sujeto."), PracticeQuestion(prompt = "Lugar: la plaza donde se manifestaron es céntrica.", expected = listOf("La plaza donde se manifestaron es centrica", "La plaza donde se manifestaron es céntrica"), focus = "donde", watch = "donde + lugar."), PracticeQuestion(prompt = "Posesión: la empresa cuyo director dimitió reaccionó.", expected = listOf("La empresa cuyo director dimitió reacciono", "La empresa cuyo director dimitió reaccionó"), focus = "cuyo", watch = "cuyo + sustantivo."), PracticeQuestion(prompt = "Generaliza: todo lo que sé viene de la radio.", expected = listOf("Todo lo que se viene de la radio", "Todo lo que sé viene de la radio"), focus = "todo lo que", watch = "todo lo que + verbo."))), exercises = listOf(Exercise(id = "es-foundations-u9-relativos-e1", kind = "choice", prompt = "La noticia ___ leí dice que amplían el museo.", options = listOf("que", "quien", "cuyo", "donde"), answers = listOf("que"), explain = "Cosa: la noticia que leí."), Exercise(id = "es-foundations-u9-relativos-e2", kind = "gap", prompt = "La plaza ___ se manifestaron es céntrica.", options = listOf(), answers = listOf("donde"), explain = "Lugar: donde."), Exercise(id = "es-foundations-u9-relativos-e3", kind = "order", prompt = "Sujeto: el periodista que lo entrevistó dimitió.", options = listOf(), answers = listOf("El periodista que lo entrevistó dimitió"), explain = "Relativa de sujeto."), Exercise(id = "es-foundations-u9-relativos-e4", kind = "written", prompt = "Cuenta tu noticia: la noticia que leíste dice que cerrarán la calle.", options = listOf(), answers = listOf("la noticia que lei dice que cerraran la calle", "la noticia que leí dice que cerrarán la calle"), explain = "La noticia que + pretérito.")), skills = listOf("grammar:relative-clauses", "grammar:present-perfect", "function:express-opinion", "vocab:work"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:present-perfect")),
    Lesson(id = "es-foundations-u9-argumentar", title = "Por un lado… por otro…", goal = "Escribir y defender una opinión estructurada: tesis, argumentos, concesión y conclusión.", intro = LessonIntro(explanation = listOf("Estructura: tesis (« Creo que las ciudades deberían peatonalizarse »), argumentos (« por un lado…, por otro lado… »), concesión (« es cierto que…, pero… »).", "La concesión te da credibilidad: reconoces la parte contraria antes de rebatirla.", "Conclusión con peso: « Por todo ello, defiendo que… »."), examples = listOf(ExampleLine(text = "Creo que deberíamos peatonalizar el centro.", meaning = "Tesis."), ExampleLine(text = "Por un lado, baja la contaminación.", meaning = "Argumento 1."), ExampleLine(text = "Por otro lado, perjudica al comercio.", meaning = "Argumento 2 (contrario)."), ExampleLine(text = "Es cierto que…, pero los datos dicen otra cosa.", meaning = "Concesión + rebote."), ExampleLine(text = "Por todo ello, defiendo la medida.", meaning = "Conclusión."))), expressions = listOf(TargetExpression(text = "Creo que + condicional", meaning = "Tesis.", note = "deberíamos peatonalizar."), TargetExpression(text = "por un lado… por otro lado…", meaning = "Argumentos.", note = "encadenan dos caras."), TargetExpression(text = "es cierto que…, pero…", meaning = "Concesión.", note = "reconocer y rebatir."), TargetExpression(text = "los datos dicen…", meaning = "Evidencia.", note = "argumento de autoridad."), TargetExpression(text = "por todo ello, …", meaning = "Conclusión.", note = "cierre formal.")), situation = "Escribís un mini-artículo de opinión sobre peatonalizar el centro: tesis, dos caras, concesión y cierre.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Tesis: creo que deberíamos peatonalizar el centro.", expected = listOf("Creo que deberiamos peatonalizar el centro", "Creo que deberíamos peatonalizar el centro"), focus = "creo que", watch = "Creo que + deberíamos."), PracticeQuestion(prompt = "Argumento 1: por un lado, baja la contaminación.", expected = listOf("Por un lado baja la contaminacion", "Por un lado, baja la contaminación"), focus = "por un lado", watch = "Primer argumento."), PracticeQuestion(prompt = "Argumento contrario: por otro lado, perjudica al comercio.", expected = listOf("Por otro lado perjudica al comercio", "Por otro lado, perjudica al comercio"), focus = "por otro lado", watch = "Segunda cara."), PracticeQuestion(prompt = "Concede: es cierto que es incómodo, pero los datos dicen otra cosa.", expected = listOf("Es cierto que es incomodo pero los datos dicen otra cosa", "Es cierto que es incómodo, pero los datos dicen otra cosa"), focus = "es cierto que", watch = "Concesión + pero."), PracticeQuestion(prompt = "Cierra: por todo ello, defiendo la medida.", expected = listOf("Por todo ello defiendo la medida", "Por todo ello, defiendo la medida"), focus = "por todo ello", watch = "Conclusión formal."))), exercises = listOf(Exercise(id = "es-foundations-u9-argumentar-e1", kind = "choice", prompt = "___ un lado, baja la contaminación.", options = listOf("Por", "Para", "En", "Con"), answers = listOf("Por"), explain = "por un lado = primer argumento."), Exercise(id = "es-foundations-u9-argumentar-e2", kind = "gap", prompt = "Es cierto que es incómodo, ___ los datos dicen otra cosa.", options = listOf(), answers = listOf("pero", "aunque"), explain = "Concesión + contraste."), Exercise(id = "es-foundations-u9-argumentar-e3", kind = "order", prompt = "Conclusión: por todo ello, defiendo la medida.", options = listOf(), answers = listOf("Por todo ello defiendo la medida"), explain = "por todo ello + presente."), Exercise(id = "es-foundations-u9-argumentar-e4", kind = "written", prompt = "Tu tesis sobre ampliar el tranvía.", options = listOf(), answers = listOf("creo que deberiamos ampliar el tranvia", "creo que deberíamos ampliar el tranvía"), explain = "Creo que + deberíamos.")), skills = listOf("writing:argument", "grammar:connectors", "function:express-opinion", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors"))))
}

object EsFoundationsU10 {
    val unit = CourseUnit(id = "es-foundations-u10", title = "Matices y registro", subtitle = "Decirlo mejor", level = "C1", themes = listOf(ConversationTheme("es-c1-registro", "Dos registros", "Formal o coloquial", "sparkles", "Course", "Escribís el mismo mensaje dos veces — para un cliente y para un compañero — y comparáis lo que cambia.", 0),
                ConversationTheme("es-c1-matices", "El matiz", "Más o menos", "bubble-left-and-text", "Course", "Debatís un proyecto sin posturas absolutas: practicáis el sí parcial, la reformulación y el cierre.", 1)), lessons = listOf(    Lesson(id = "es-foundations-u10-registro", title = "Cómo lo digo", goal = "Adaptar el registro: lo mismo para un cliente que para un compañero, sin sonar ni rígido ni descuidado.", intro = LessonIntro(explanation = listOf("El registro formal alarga y cortesiza: « Le agradecería que me confirmara la fecha ». El coloquial acorta y tutea: « ¿Me confirmas la fecha ? ».", "El email formal se abre con « Le escribo para… » o « En relación con… » y se cierra con « Quedo a su disposición » o « Un cordial saludo ».", "Los conectores delatan el tono: « no obstante » suena formal, « pero » es neutro y « o sea » delata conversación de pasillo."), examples = listOf(ExampleLine(text = "Le escribo en relación con el contrato.", meaning = "Apertura formal de email."), ExampleLine(text = "¿Te viene bien el jueves a las diez ?", meaning = "Coloquial: proponer hora."), ExampleLine(text = "Le agradecería una respuesta cuanto antes.", meaning = "Petición formal."), ExampleLine(text = "Oye, ¿me pasas el informe cuando puedas ?", meaning = "Petición coloquial."), ExampleLine(text = "No obstante, quedo a su disposición.", meaning = "Cierre formal con conector."))), expressions = listOf(TargetExpression(text = "Le/Les agradecería que + subjuntivo", meaning = "Petición formal.", note = "Le agradecería que lo revisara."), TargetExpression(text = "¿Te viene bien…?", meaning = "Coloquial: cerrar cita.", note = "¿Te viene bien el martes ?"), TargetExpression(text = "en relación con…", meaning = "Presentar un asunto, formal.", note = "en relación con el contrato."), TargetExpression(text = "no obstante", meaning = "Contraste, registro formal.", note = "No obstante, hay un detalle."), TargetExpression(text = "Un cordial saludo", meaning = "Despedida formal de email.", note = "antes de la firma.")), situation = "Comparáis el mismo encargo en dos versiones — email para un cliente y mensaje para un compañero — y decidís qué registro pide cada destinatario.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pide con cortesía formal: le agradecería que me confirmara la fecha.", expected = listOf("Le agradeceria que me confirmara la fecha", "Le agradecería que me confirmara la fecha"), focus = "le agradecería", watch = "Que + subjuntivo: confirmara."), PracticeQuestion(prompt = "Propón hora en confianza: ¿te viene bien el jueves a las diez?", expected = listOf("Te viene bien el jueves a las diez", "¿Te viene bien el jueves a las diez ?"), focus = "¿te viene bien?", watch = "Coloquial: tú, no usted."), PracticeQuestion(prompt = "Despide un email formal: un cordial saludo.", expected = listOf("Un cordial saludo", "Saludos cordiales"), focus = "cordial", watch = "Despedida formal de email."), PracticeQuestion(prompt = "Contrasta en formal: no obstante, quedo a su disposición.", expected = listOf("No obstante quedo a su disposicion", "No obstante, quedo a su disposición"), focus = "no obstante", watch = "Conector formal, entre comas."), PracticeQuestion(prompt = "Pide informal: oye, ¿me pasas el informe cuando puedas?", expected = listOf("Oye me pasas el informe cuando puedas", "Oye, ¿me pasas el informe cuando puedas ?"), focus = "oye", watch = "Apelativo coloquial de atención."))), exercises = listOf(Exercise(id = "es-foundations-u10-registro-e1", kind = "choice", prompt = "___ agradecería que me confirmara la fecha lo antes posible.", options = listOf("Le", "Te", "Yo", "Me"), answers = listOf("Le"), explain = "Cortesía formal: le agradecería (de usted)."), Exercise(id = "es-foundations-u10-registro-e2", kind = "gap", prompt = "Hubo retrasos; ___, el proyecto sigue en marcha. (conector formal de contraste)", options = listOf(), answers = listOf("no obstante", "sin embargo"), explain = "No obstante / sin embargo: contraste en registro formal."), Exercise(id = "es-foundations-u10-registro-e3", kind = "choice", prompt = "¿Cuál es la versión formal de « te escribo por lo del contrato » ?", options = listOf("Le escribo en relación con el contrato", "Te suelto lo del contrato", "Te paso lo del contrato ese", "Le comento una cosita del contrato"), answers = listOf("Le escribo en relación con el contrato"), explain = "En relación con: fórmula formal para presentar un asunto."), Exercise(id = "es-foundations-u10-registro-e4", kind = "written", prompt = "Pide por email, en registro formal, que te confirmen la fecha de la reunión.", options = listOf(), answers = listOf("le agradeceria que me confirmaran la fecha de la reunion", "le agradecería que me confirmaran la fecha de la reunión", "quisiera pedirle que confirmara la fecha de la reunión"), explain = "Le agradecería que + subjuntivo: petición formal por escrito.")), skills = listOf("vocab:social-expressions", "function:talk-about-work", "writing:email", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "es-foundations-u10-matices", title = "Más o menos", goal = "Matizar opiniones: acordar a medias, reformular y situar el punto de vista propio.", intro = LessonIntro(explanation = listOf("Para matizar: « En cierto modo sí, pero… », « Hasta cierto punto lo comparto ». No niegas ni aceptas del todo.", "Para reformular: « por así decirlo », « Digamos que… ». Avisan de que la palabra elegida no es exacta.", "Para situar tu opinión: « Desde mi punto de vista », « A mi juicio ». Pesan más que un simple « creo que »."), examples = listOf(ExampleLine(text = "En cierto modo, tienes razón.", meaning = "Acuerdo parcial."), ExampleLine(text = "Hasta cierto punto lo comparto.", meaning = "Delimita el acuerdo."), ExampleLine(text = "Es, por así decirlo, un puente.", meaning = "Aviso de metáfora."), ExampleLine(text = "Desde mi punto de vista, sobra la reunión.", meaning = "Opinión situada."), ExampleLine(text = "Digamos que fue un malentendido.", meaning = "Suaviza el juicio."))), expressions = listOf(TargetExpression(text = "En cierto modo, …", meaning = "Acuerdo parcial.", note = "En cierto modo, sí."), TargetExpression(text = "hasta cierto punto", meaning = "Matiza el alcance.", note = "Hasta cierto punto lo entiendo."), TargetExpression(text = "por así decirlo", meaning = "Reformula con tacto.", note = "tras una metáfora."), TargetExpression(text = "Desde mi punto de vista, …", meaning = "Opinión con peso.", note = "equivale a para mí, pero más formal."), TargetExpression(text = "Digamos que…", meaning = "Suaviza.", note = "Digamos que no fue así.")), situation = "Valoráis el último proyecto en equipo: nadie quiere un sí o un no rotundos, y practicáis la respuesta intermedia.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Matiza: en cierto modo, tienes razón.", expected = listOf("En cierto modo tienes razon", "En cierto modo, tienes razón"), focus = "en cierto modo", watch = "Acuerdo parcial, no total."), PracticeQuestion(prompt = "Acuerda a medias: hasta cierto punto lo comparto.", expected = listOf("Hasta cierto punto lo comparto", "Lo comparto hasta cierto punto"), focus = "hasta cierto punto", watch = "Delimita el alcance del acuerdo."), PracticeQuestion(prompt = "Reformula: es, por así decirlo, un puente.", expected = listOf("Es por asi decirlo un puente", "Es, por así decirlo, un puente"), focus = "por así decirlo", watch = "Entre comas: aviso de metáfora."), PracticeQuestion(prompt = "Sitúa tu opinión: desde mi punto de vista, sobra la reunión.", expected = listOf("Desde mi punto de vista sobra la reunion", "Desde mi punto de vista, sobra la reunión"), focus = "desde mi punto de vista", watch = "Fórmula fija, no « en mi punto de vista »."), PracticeQuestion(prompt = "Suaviza: digamos que fue un malentendido.", expected = listOf("Digamos que fue un malentendido", "Digamos que no fue del todo correcto"), focus = "digamos que", watch = "Suaviza el juicio."))), exercises = listOf(Exercise(id = "es-foundations-u10-matices-e1", kind = "choice", prompt = "___ cierto modo, la propuesta funciona.", options = listOf("En", "Por", "Con", "De"), answers = listOf("En"), explain = "En cierto modo: acuerdo parcial."), Exercise(id = "es-foundations-u10-matices-e2", kind = "gap", prompt = "___ mi punto de vista, el plan es buenísimo.", options = listOf(), answers = listOf("Desde"), explain = "Fórmula fija de opinión: desde mi punto de vista."), Exercise(id = "es-foundations-u10-matices-e3", kind = "choice", prompt = "¿Qué fórmula avisa de que una palabra no es exacta ?", options = listOf("por así decirlo", "desde luego", "sin falta", "en absoluto"), answers = listOf("por así decirlo"), explain = "Por así decirlo introduce una reformulación aproximada."), Exercise(id = "es-foundations-u10-matices-e4", kind = "written", prompt = "Opina sobre las reuniones del lunes con la fórmula de punto de vista.", options = listOf(), answers = listOf("desde mi punto de vista las reuniones del lunes sobran", "desde mi punto de vista, las reuniones del lunes sobran", "en mi opinion las reuniones del lunes sobran"), explain = "Desde mi punto de vista + juicio: opinión situada.")), skills = listOf("function:express-opinion", "speaking:justify-opinion", "grammar:connectors", "vocab:collocations"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "es-foundations-u10-presentar", title = "Presentar ideas", goal = "Estructurar una intervención breve: abrir, encadenar argumentos y cerrar con una conclusión limpia.", intro = LessonIntro(explanation = listOf("Abre marcando el camino: « Para empezar », « En primer lugar ». El oyente sabe que viene una secuencia.", "Encadena sin saltos: « Por otra parte », « A esto se añade que… ». Cada idea engancha con la anterior.", "Cierra con señal clara: « En resumen », « Para concluir ». Una sola idea final, no tres."), examples = listOf(ExampleLine(text = "Para empezar, repasemos los datos.", meaning = "Abre la secuencia."), ExampleLine(text = "En primer lugar, el presupuesto.", meaning = "Primer punto."), ExampleLine(text = "Por otra parte, falta tiempo.", meaning = "Añade un argumento."), ExampleLine(text = "A esto se añade que el equipo es nuevo.", meaning = "Encadena otra razón."), ExampleLine(text = "En resumen: adelante, pero con calendario.", meaning = "Conclusión breve."))), expressions = listOf(TargetExpression(text = "Para empezar, …", meaning = "Abre.", note = "Para empezar, los datos."), TargetExpression(text = "en primer lugar", meaning = "Primer punto.", note = "tras él: en segundo lugar."), TargetExpression(text = "por otra parte, …", meaning = "Añade otra cara.", note = "Por otra parte, el tiempo."), TargetExpression(text = "a esto se añade que…", meaning = "Encadena razones.", note = "A esto se añade que…"), TargetExpression(text = "En resumen, …", meaning = "Cierra.", note = "En resumen: sí, pero tarde.")), situation = "Cada uno presenta en dos minutos una propuesta: abrir con un punto claro, encadenar dos razones y cerrar con una sola frase.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Abre: para empezar, repasemos los datos.", expected = listOf("Para empezar repasemos los datos", "Para empezar, repasemos los datos"), focus = "para empezar", watch = "Señal de apertura."), PracticeQuestion(prompt = "Primer punto: en primer lugar, el presupuesto.", expected = listOf("En primer lugar el presupuesto", "En primer lugar, el presupuesto"), focus = "en primer lugar", watch = "Después: en segundo lugar."), PracticeQuestion(prompt = "Añade otra cara: por otra parte, falta tiempo.", expected = listOf("Por otra parte falta tiempo", "Por otra parte, falta tiempo"), focus = "por otra parte", watch = "Añade un argumento nuevo."), PracticeQuestion(prompt = "Encadena: a esto se añade que el equipo es nuevo.", expected = listOf("A esto se anade que el equipo es nuevo", "A esto se añade que el equipo es nuevo"), focus = "a esto se añade", watch = "Engancha con lo anterior."), PracticeQuestion(prompt = "Cierra: en resumen, adelante, pero con calendario.", expected = listOf("En resumen adelante pero con calendario", "En resumen, adelante, pero con calendario"), focus = "en resumen", watch = "Una sola idea final."))), exercises = listOf(Exercise(id = "es-foundations-u10-presentar-e1", kind = "choice", prompt = "___ empezar, repasemos los números del trimestre.", options = listOf("Para", "Por", "Al", "En"), answers = listOf("Para"), explain = "Para empezar: fórmula de apertura."), Exercise(id = "es-foundations-u10-presentar-e2", kind = "gap", prompt = "La propuesta tiene ventajas; ___, exige presupuesto y tiempo. (conector que añade otra cara)", options = listOf(), answers = listOf("por otra parte", "por otro lado"), explain = "Por otra parte / por otro lado: añaden un argumento nuevo."), Exercise(id = "es-foundations-u10-presentar-e3", kind = "choice", prompt = "¿Cuál de estas fórmulas sirve para cerrar una intervención ?", options = listOf("En resumen", "Para empezar", "En primer lugar", "A esto se añade"), answers = listOf("En resumen"), explain = "En resumen anuncia la conclusión; las demás organizan la secuencia."), Exercise(id = "es-foundations-u10-presentar-e4", kind = "written", prompt = "Cierra la presentación de tu propuesta con la fórmula de resumen.", options = listOf(), answers = listOf("en resumen la propuesta avanza pero en enero", "en resumen, la propuesta avanza, pero en enero", "para concluir la propuesta avanza pero en enero"), explain = "En resumen + una sola idea: cierre de discurso.")), skills = listOf("speaking:sustained-conversation", "function:talk-about-work", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "es-foundations-u10-debatir", title = "De acuerdo en desacuerdo", goal = "Discrepar con tacto: reconocer el punto del otro antes de contradecirlo.", intro = LessonIntro(explanation = listOf("La discrepancia cortés arranca reconociendo: «Entiendo tu punto, pero…». Lo que va antes del pero suaviza.", "Es discutible pone el no en modo debate: «Es discutible; los datos dicen otra cosa».", "Para no cerrar la conversación: «No lo veo así, precisamente porque…». La justificación evita el choque de creencias."), examples = listOf(ExampleLine(text = "Entiendo tu punto, pero no lo comparto.", meaning = "Reconocer y discrepar."), ExampleLine(text = "Es discutible; los datos dicen otra cosa.", meaning = "Discrepar con evidencia."), ExampleLine(text = "Veo por dónde vas, aunque no lo veo así.", meaning = "Matiza el desacuerdo."), ExampleLine(text = "No lo veo así, precisamente porque faltan plazos.", meaning = "Justificar el no."), ExampleLine(text = "De acuerdo en el fondo, no en la forma.", meaning = "Acordar parcialmente."))), expressions = listOf(TargetExpression(text = "entiendo tu punto, pero…", meaning = "Reconocer antes de discrepar.", note = "Entiendo tu punto, pero faltan datos."), TargetExpression(text = "es discutible", meaning = "Pone el no en debate.", note = "Es discutible, aunque entiendo la idea."), TargetExpression(text = "veo por dónde vas, aunque…", meaning = "Suaviza el desacuerdo.", note = "aunque no comparto el paso siguiente."), TargetExpression(text = "no lo veo así", meaning = "Discrepar directo.", note = "No lo veo así, precisamente porque…"), TargetExpression(text = "de acuerdo en el fondo, no en la forma", meaning = "Acuerdo parcial.", note = "separa el qué del cómo.")), situation = "En una reunión, discrepáis sobre el calendario: reconoces el argumento del otro, pero defiendes el tuyo con datos y dejáis la conversación abierta.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Discrepa con tacto: reconocer y no compartir.", expected = listOf("Entiendo tu punto, pero no lo comparto", "entiendo tu punto pero no lo comparto"), focus = "entiendo tu punto", watch = "Reconocer suaviza el no."), PracticeQuestion(prompt = "Di que la idea está abierta a debate.", expected = listOf("Es discutible", "es discutible", "Me parece discutible"), focus = "discutible", watch = "es discutible abre el debate, no lo cierra."), PracticeQuestion(prompt = "Suaviza: ver su intención y discrepar.", expected = listOf("Veo por dónde vas, aunque no lo veo así", "veo por donde vas aunque no lo veo asi"), focus = "veo por dónde vas", watch = "aunque introduce tu matiz."), PracticeQuestion(prompt = "Justifica tu no: faltan plazos.", expected = listOf("No lo veo así, precisamente porque faltan plazos", "no lo veo asi precisamente porque faltan plazos"), focus = "precisamente porque", watch = "La justificación evita el choque."), PracticeQuestion(prompt = "Acuerda a medias: el fondo sí, la forma no.", expected = listOf("De acuerdo en el fondo, no en la forma", "de acuerdo en el fondo no en la forma"), focus = "en el fondo", watch = "Separa el qué del cómo."))), exercises = listOf(Exercise(id = "es-foundations-u10-debatir-e1", kind = "choice", prompt = "Entiendo tu punto, ___ no lo comparto.", options = listOf("pero", "porque", "así que", "además"), answers = listOf("pero"), explain = "El pero traslada el peso a tu postura."), Exercise(id = "es-foundations-u10-debatir-e2", kind = "gap", prompt = "Es ___; los datos dicen otra cosa. (abre el debate)", options = listOf(), answers = listOf("discutible", "Discutible"), explain = "Es discutible: el no en modo debate."), Exercise(id = "es-foundations-u10-debatir-e3", kind = "choice", prompt = "¿Qué fórmula reconoce el argumento del otro antes de discrepar?", options = listOf("Entiendo tu punto", "Estás equivocado", "No me interesa", "Cambia de tema"), answers = listOf("Entiendo tu punto"), explain = "Reconocer el punto del otro es la cortesía clave."), Exercise(id = "es-foundations-u10-debatir-e4", kind = "written", prompt = "Discrepa del calendario con tacto y justifica.", options = listOf(), answers = listOf("no lo veo así, precisamente porque faltan plazos", "no lo veo asi precisamente porque faltan plazos", "entiendo tu punto, pero faltan plazos"), explain = "Reconocer + pero + causa: discrepancia con tacto.")), skills = listOf("function:express-opinion", "speaking:sustained-conversation", "grammar:connectors", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "es-foundations-u10-tono", title = "El tono exacto", goal = "Ajustar el tono con collocations exactas: echar de menos o extrañar, tomar la decisión de…; la palabra que pinta el registro justo.", intro = LessonIntro(explanation = listOf("El tono vive en las collocations: «echar de menos» suena peninsular y entrañable; «extrañar» suena americano y más literario.", "La fórmula completa compromete más: «tomar la decisión de…» avisa de deliberación; «decidir» a secas registra el acto y ya.", "En el argumento, la collocation exacta ahorra adjetivos: «dar la razón en parte» matiza con más precisión que «estoy un poco de acuerdo»."), examples = listOf(ExampleLine(text = "Echo de menos aquellas sobremesas.", meaning = "Nostalgia peninsular, tono cercano."), ExampleLine(text = "Extraño las comidas de familia.", meaning = "Extrañar: registro americano."), ExampleLine(text = "Tomamos la decisión de posponerlo.", meaning = "Decisión compartida y asumida."), ExampleLine(text = "Te doy la razón en parte.", meaning = "Acuerdo parcial con peso."), ExampleLine(text = "No es lo mismo decidir que tomar la decisión.", meaning = "Precisión entre dos fórmulas."))), expressions = listOf(TargetExpression(text = "echar de menos a/algo", meaning = "Echar en falta; nostalgia peninsular.", note = "Echo de menos mi barrio."), TargetExpression(text = "extrañar", meaning = "Echar de menos, registro americano.", note = "Extraño esas tardes tranquilas."), TargetExpression(text = "tomar la decisión de + infinitivo", meaning = "Decidir de forma asumida y formal.", note = "Tomamos la decisión de esperar."), TargetExpression(text = "dar la razón en parte", meaning = "Acuerdo parcial con peso argumental.", note = "Te doy la razón en parte, no del todo."), TargetExpression(text = "no es lo mismo X que Y", meaning = "Precisión léxica en el debate.", note = "No es lo mismo escuchar que oír.")), situation = "Revisáis una columna dos veces — para un diario y para un blog personal — y elegís la collocation que da el tono exacto: extrañar o echar de menos, decidir o tomar la decisión.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di con tono peninsular que tu barrio te falta: echar de menos.", expected = listOf("Echo de menos mi barrio", "echo de menos mi barrio"), focus = "echo de menos", watch = "echar de menos: collocation fija."), PracticeQuestion(prompt = "Di lo mismo con registro americano: extrañar.", expected = listOf("Extraño esas tardes tranquilas", "extraño esas tardes tranquilas"), focus = "extraño", watch = "extrañar: registro americano."), PracticeQuestion(prompt = "Comprométete con la fórmula completa: tomar la decisión de esperar.", expected = listOf("Tomamos la decisión de esperar", "tomamos la decision de esperar"), focus = "tomar la decisión", watch = "La fórmula larga avisa de deliberación."), PracticeQuestion(prompt = "Matiza en debate: dar la razón en parte.", expected = listOf("Te doy la razón en parte", "te doy la razon en parte"), focus = "dar la razón en parte", watch = "Delimita el acuerdo."), PracticeQuestion(prompt = "Marca la diferencia entre dos verbos: escuchar y oír.", expected = listOf("No es lo mismo escuchar que oír", "no es lo mismo escuchar que oir"), focus = "no es lo mismo", watch = "Fórmula de precisión léxica."))), exercises = listOf(Exercise(id = "es-foundations-u10-tono-e1", kind = "choice", prompt = "___ de menos aquellas sobremesas de agosto.", options = listOf("Echo", "Hago", "Doy", "Tomo"), answers = listOf("Echo"), explain = "echar de menos: collocation fija; no se sustituye por hacer ni por dar."), Exercise(id = "es-foundations-u10-tono-e2", kind = "gap", prompt = "La dirección ___ la decisión de cerrar la sala en agosto. (tomar, pasado)", options = listOf(), answers = listOf("tomó", "tomo", "Tomó"), explain = "tomar la decisión de: fórmula completa y asumida; tomó lleva tilde."), Exercise(id = "es-foundations-u10-tono-e3", kind = "choice", prompt = "¿Qué fórmula acota el acuerdo con más precisión argumental?", options = listOf("Te doy la razón en parte", "Estoy un poco de acuerdo", "Creo que sí", "Puede ser"), answers = listOf("Te doy la razón en parte"), explain = "Dar la razón en parte delimita el alcance; las otras dos son difusas."), Exercise(id = "es-foundations-u10-tono-e4", kind = "written", prompt = "Escribe tu posición sobre el cierre de agosto acotando el acuerdo con la fórmula de la razón parcial.", options = listOf(), answers = listOf("te doy la razón en parte, pero agosto es complicado", "te doy la razon en parte, pero agosto es complicado", "doy la razón en parte: agosto es complicado"), explain = "Dar la razón en parte + matiz: la posición exacta en un texto argumentativo.")), skills = listOf("vocab:collocations", "function:express-opinion", "writing:argument", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors"))))
}

object EsWorkU1 {
    val unit = CourseUnit(id = "es-work-u1", title = "La jornada laboral", subtitle = "Reuniones, correos, entrevistas", level = "B1", themes = listOf(ConversationTheme("la-reunion", "La reunión", "Opinar y proponer", "person.3", "Course", "Defiendes tus ideas en una reunión de equipo: opinas, propones cambios y matizas tu posición.", 0),
                ConversationTheme("la-entrevista", "La entrevista", "Experiencia y logros", "person.badge.key", "Course", "Ensayas una entrevista de trabajo: te presentas, cuentas tu experiencia y hablas de tus metas.", 1)), lessons = listOf(    Lesson(id = "es-work-u1-reuniones", title = "En reuniones", goal = "Opinar y proponer en una reunión: en mi opinión…, propongo…, ¿qué os parece?, estoy de acuerdo, pero…", intro = LessonIntro(explanation = listOf("La reunión arranca con opiniones: «En mi opinión, el plan funciona», «Creo que vamos bien de tiempo».", "Para proponer: «Propongo empezar el lunes», «¿Qué os parece si lo probamos una semana?».", "El desacuerdo con matiz: «Estoy de acuerdo, pero no tenemos tiempo», «Por un lado ahorra dinero; por otro, cuesta tiempo»."), examples = listOf(ExampleLine(text = "En mi opinión, el plan funciona.", meaning = "Abrir la opinión."), ExampleLine(text = "Propongo empezar el lunes.", meaning = "Proponer con yo."), ExampleLine(text = "¿Qué os parece si lo probamos una semana?", meaning = "Proponer con pregunta."), ExampleLine(text = "Estoy de acuerdo, pero falta tiempo.", meaning = "Matizar el acuerdo."), ExampleLine(text = "Vamos a votar y decidimos hoy.", meaning = "Cerrar la reunión."))), expressions = listOf(TargetExpression(text = "en mi opinión, …", meaning = "Tu postura.", note = "En mi opinión, es la mejor opción."), TargetExpression(text = "propongo + infinitivo", meaning = "Tu idea.", note = "Propongo dividir el trabajo."), TargetExpression(text = "¿qué os parece…?", meaning = "Consultar al equipo.", note = "¿Qué os parece el nuevo horario?"), TargetExpression(text = "estoy de acuerdo, pero…", meaning = "Acuerdo con matiz.", note = "Estoy de acuerdo, pero es caro."), TargetExpression(text = "por un lado…, por otro…", meaning = "Los dos lados.", note = "Por un lado es rápido; por otro, es caro.")), situation = "Reunión de equipo sobre el nuevo horario: opinas, propones una semana de prueba, matizas con los dos lados y la decisión se cierra con una votación.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Opina sobre el plan: para ti, funciona.", expected = listOf("En mi opinión, el plan funciona", "Creo que el plan funciona", "en mi opinion el plan funciona"), focus = "en mi opinión", watch = "abre con la fórmula y da tu postura."), PracticeQuestion(prompt = "Propone empezar el lunes.", expected = listOf("Propongo empezar el lunes", "Yo propongo empezar el lunes", "propongo empezar el lunes"), focus = "propongo", watch = "propongo: primera persona."), PracticeQuestion(prompt = "Consulta al equipo con una pregunta: probarlo una semana.", expected = listOf("¿Qué os parece si lo probamos una semana?", "¿Qué os parece la idea?", "que os parece si lo probamos una semana"), focus = "¿qué os parece?", watch = "si + presente: la propuesta suave."), PracticeQuestion(prompt = "Matiza tu acuerdo: sí, pero falta tiempo.", expected = listOf("Estoy de acuerdo, pero falta tiempo", "Estoy de acuerdo, pero no tenemos tiempo", "estoy de acuerdo pero no hay tiempo"), focus = "de acuerdo, pero", watch = "pero + el problema: el desacuerdo educado."), PracticeQuestion(prompt = "Propón cerrar la decisión con una votación.", expected = listOf("Vamos a votar", "Propongo votar", "Vamos a votar y decidimos hoy"), focus = "votar", watch = "vamos a + infinitivo: la propuesta de cierre."))), exercises = listOf(Exercise(id = "es-work-u1-reuniones-e1", kind = "choice", prompt = "___ mi opinión, el nuevo plan funciona.", options = listOf("En", "Por", "Sobre", "Entre"), answers = listOf("En"), explain = "en mi opinión: fórmula fija para dar tu postura."), Exercise(id = "es-work-u1-reuniones-e2", kind = "gap", prompt = "___ dividir el trabajo en dos equipos. (proponer, yo)", options = listOf(), answers = listOf("Propongo", "propongo"), explain = "propongo + infinitivo: la idea de quien habla."), Exercise(id = "es-work-u1-reuniones-e3", kind = "order", prompt = "Matiza tu acuerdo en la reunión.", options = listOf(), answers = listOf("Estoy de acuerdo, pero falta tiempo"), explain = "estoy de acuerdo, pero…: el matiz que abre el debate."), Exercise(id = "es-work-u1-reuniones-e4", kind = "written", prompt = "Consulta al equipo sobre el nuevo horario.", options = listOf(), answers = listOf("¿qué os parece el nuevo horario?", "que os parece el nuevo horario", "¿qué os parece el horario nuevo?"), explain = "¿Qué os parece…? abre el debate del equipo.")), skills = listOf("function:talk-about-work", "function:express-opinion", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "es-work-u1-correos", title = "Correos formales", goal = "Escribir un email formal: estimada señora…, les escribo para…, les ruego que confirmen…, un cordial saludo.", intro = LessonIntro(explanation = listOf("El saludo formal: «Estimada Sra. García:». El asunto va en la primera línea: «Les escribo para solicitar…».", "Las peticiones formales con les ruego / agradecería: «Les ruego que me confirmen la fecha», «Agradecería una respuesta antes del viernes».", "El archivo y la despedida: «Adjunto el informe», «Un cordial saludo» o «Atentamente»."), examples = listOf(ExampleLine(text = "Estimada Sra. García:", meaning = "El saludo formal."), ExampleLine(text = "Les escribo para solicitar el informe.", meaning = "El asunto en línea uno."), ExampleLine(text = "Les ruego que me confirmen la fecha.", meaning = "La petición formal."), ExampleLine(text = "Adjunto el presupuesto del proyecto.", meaning = "El archivo."), ExampleLine(text = "Un cordial saludo, Elena Ruiz.", meaning = "La despedida formal."))), expressions = listOf(TargetExpression(text = "estimado/a + apellido:", meaning = "El saludo formal.", note = "Estimado Sr. López:"), TargetExpression(text = "les escribo para + infinitivo", meaning = "El asunto.", note = "Les escribo para confirmar la reunión."), TargetExpression(text = "les ruego que + presente", meaning = "La petición formal.", note = "Les ruego que respondan hoy."), TargetExpression(text = "adjunto + documento", meaning = "El archivo.", note = "Adjunto la factura de mayo."), TargetExpression(text = "un cordial saludo", meaning = "La despedida.", note = "Un cordial saludo, Elena Ruiz.")), situation = "Escribes a una clienta: presentas el presupuesto, adjuntas el documento, pides la confirmación de la fecha y cierras con una despedida formal.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Saluda formalmente a la Sra. García.", expected = listOf("Estimada Sra. García:", "Estimada señora García:", "estimada sra garcia"), focus = "estimada", watch = "estimado/a + apellido: el saludo formal."), PracticeQuestion(prompt = "Abre el asunto: solicitar el presupuesto.", expected = listOf("Les escribo para solicitar el presupuesto", "Les escribo por el presupuesto", "les escribo para solicitar el presupuesto"), focus = "les escribo para", watch = "el asunto en la primera línea."), PracticeQuestion(prompt = "Pide la confirmación de la fecha, formal.", expected = listOf("Les ruego que me confirmen la fecha", "Agradecería que me confirmaran la fecha", "les ruego que me confirmen la fecha"), focus = "les ruego que", watch = "les ruego que + presente: la petición formal."), PracticeQuestion(prompt = "Di que incluyes el informe en el email.", expected = listOf("Adjunto el informe", "Le adjunto el informe", "adjunto el informe"), focus = "adjunto", watch = "adjunto + documento, sin preposición."), PracticeQuestion(prompt = "Despídete formalmente.", expected = listOf("Un cordial saludo", "Atentamente", "Un cordial saludo, Elena"), focus = "la despedida", watch = "cordial saludo o atentamente; el tono cariñoso no."))), exercises = listOf(Exercise(id = "es-work-u1-correos-e1", kind = "choice", prompt = "___ Sra. García: les escribo para confirmar la reunión.", options = listOf("Estimada", "Querida", "Hola", "Buenas"), answers = listOf("Estimada"), explain = "Estimada + apellido: el saludo formal del email de trabajo."), Exercise(id = "es-work-u1-correos-e2", kind = "gap", prompt = "Les ___ que me confirmen la fecha antes del viernes. (rogar, formal)", options = listOf(), answers = listOf("ruego", "Ruego"), explain = "les ruego que + presente: la petición formal por escrito."), Exercise(id = "es-work-u1-correos-e3", kind = "order", prompt = "Escribe la línea del archivo.", options = listOf(), answers = listOf("Adjunto el presupuesto del proyecto"), explain = "adjunto + documento: la línea del archivo sin preposición."), Exercise(id = "es-work-u1-correos-e4", kind = "written", prompt = "Cierra el email formal.", options = listOf(), answers = listOf("un cordial saludo", "atentamente", "un cordial saludo, elena ruiz"), explain = "un cordial saludo / atentamente: las despedidas formales.")), skills = listOf("writing:email", "function:make-requests", "vocab:work", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "es-work-u1-entrevistas", title = "Entrevistas de trabajo", goal = "Hablar de tu experiencia y metas: he trabajado…, he dirigido…, mi objetivo es…, a largo plazo quiero…", intro = LessonIntro(explanation = listOf("La experiencia va en presente perfecto: «He trabajado cinco años en ventas», «He dirigido un equipo de seis personas».", "El logro se cuenta con estructura, situación, acción y resultado: «El equipo iba retrasado, reorganicé el calendario y entregamos a tiempo».", "Las metas van con objetivo / quiero: «Mi objetivo es crecer en marketing», «A largo plazo, quiero dirigir mi propio equipo»."), examples = listOf(ExampleLine(text = "He trabajado cinco años en ventas.", meaning = "Experiencia con he + participio."), ExampleLine(text = "He dirigido un equipo de seis personas.", meaning = "Responsabilidad en presente perfecto."), ExampleLine(text = "El proyecto iba retrasado y lo entregamos a tiempo.", meaning = "El logro con estructura."), ExampleLine(text = "Mi objetivo es crecer en marketing.", meaning = "La meta corta."), ExampleLine(text = "A largo plazo, quiero dirigir mi propio equipo.", meaning = "La meta de futuro."))), expressions = listOf(TargetExpression(text = "he + participio", meaning = "La experiencia.", note = "He gestionado presupuestos grandes."), TargetExpression(text = "he trabajado… años en…", meaning = "El tiempo de experiencia.", note = "He trabajado tres años en ventas."), TargetExpression(text = "mi mayor logro fue…", meaning = "El logro estrella.", note = "Mi mayor logro fue abrir el mercado mexicano."), TargetExpression(text = "mi objetivo es + infinitivo", meaning = "La meta.", note = "Mi objetivo es especializarme en datos."), TargetExpression(text = "a largo plazo, quiero…", meaning = "El futuro profesional.", note = "A largo plazo, quiero liderar un equipo.")), situation = "Ensayas una entrevista: cuentas tus cinco años en ventas, describes un logro con su resultado y hablas de tu meta de dirigir un equipo propio.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di tu experiencia: cinco años en ventas.", expected = listOf("He trabajado cinco años en ventas", "Llevo cinco años trabajando en ventas", "he trabajado cinco años en ventas"), focus = "he trabajado", watch = "he + participio: la experiencia que cuenta."), PracticeQuestion(prompt = "Di tu responsabilidad: un equipo de seis personas.", expected = listOf("He dirigido un equipo de seis personas", "He gestionado un equipo de seis personas", "he dirigido un equipo de seis personas"), focus = "he dirigido", watch = "dirigir o gestionar: los dos valen."), PracticeQuestion(prompt = "Cuenta tu mayor logro: el proyecto retrasado que llegó a tiempo.", expected = listOf("Mi mayor logro fue entregar el proyecto a tiempo", "Mi mayor logro fue el proyecto que entregamos a tiempo", "mi mayor logro fue entregar el proyecto a tiempo"), focus = "mi mayor logro", watch = "logro + resultado: lo que quieren oír."), PracticeQuestion(prompt = "Di tu meta: especializarte en datos.", expected = listOf("Mi objetivo es especializarme en datos", "Quiero especializarme en datos", "mi objetivo es especializarme en datos"), focus = "mi objetivo es", watch = "objetivo es + infinitivo."), PracticeQuestion(prompt = "Di tu futuro a largo plazo: dirigir un equipo.", expected = listOf("A largo plazo, quiero dirigir mi propio equipo", "A largo plazo, me gustaría dirigir un equipo", "a largo plazo quiero dirigir un equipo"), focus = "a largo plazo", watch = "a largo plazo: el futuro lejano."))), exercises = listOf(Exercise(id = "es-work-u1-entrevistas-e1", kind = "choice", prompt = "He ___ cinco años en el departamento de ventas.", options = listOf("trabajado", "trabajar", "trabajando", "trabajo"), answers = listOf("trabajado"), explain = "he + participio (trabajado): presente perfecto de experiencia."), Exercise(id = "es-work-u1-entrevistas-e2", kind = "gap", prompt = "___ dirigido un equipo de seis personas. (yo)", options = listOf(), answers = listOf("He", "he"), explain = "he dirigido: la responsabilidad con presente perfecto."), Exercise(id = "es-work-u1-entrevistas-e3", kind = "order", prompt = "Di tu meta profesional.", options = listOf(), answers = listOf("Mi objetivo es especializarme en datos"), explain = "mi objetivo es + infinitivo: la meta profesional clara."), Exercise(id = "es-work-u1-entrevistas-e4", kind = "written", prompt = "Habla de tu futuro a largo plazo: tu propio equipo.", options = listOf(), answers = listOf("a largo plazo quiero dirigir mi propio equipo", "a largo plazo quiero dirigir mi equipo", "me gustaria dirigir mi propio equipo a largo plazo"), explain = "a largo plazo + quiero: la visión de futuro.")), skills = listOf("function:talk-about-work", "grammar:present-perfect", "vocab:work", "function:describe-goals"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-perfect"))))
}

object FrFoundationsU1 {
    val unit = CourseUnit(id = "fr-foundations-u1", title = "First sentences", subtitle = "Say who you are", level = "A1", themes = listOf(ConversationTheme("lang-exchange", "Language-exchange café", "Meet and greet", "person.2", "Course", "You are at a friendly language-exchange café in Lyon. Meet the learner, exchange names, countries and jobs using the verb être.", 0),
                ConversationTheme("introductions", "Nice to meet you", "Start somewhere small", "hand.wave", "Connection", "Meet the learner for the first time. Learn their interests through natural introductions.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u1-etre", title = "The verb “être”", goal = "Introduce yourself and say who people are with je suis, tu es, il est, nous sommes, vous êtes, ils sont.", intro = LessonIntro(explanation = listOf("Every French sentence needs a subject and a verb. The verb for saying who you are is “être”.", "Six forms, one per subject: je suis, tu es, il/elle est, nous sommes, vous êtes, ils/elles sont. French never drops the subject: say “Je suis”, not just “Suis”.", "Use être for identity and origin: “Je suis Ana”, “Je suis de France”, “Il est professeur”. Put “de” after a city: “Je suis de Lyon”."), examples = listOf(ExampleLine(text = "Je suis Ana. Je suis de France.", meaning = "Your name and country."), ExampleLine(text = "Tu es mon meilleur ami.", meaning = "A close bond with someone."), ExampleLine(text = "Elle est professeure.", meaning = "Someone's profession."), ExampleLine(text = "Nous sommes très contents aujourd'hui.", meaning = "A feeling that defines right now."), ExampleLine(text = "Le café est près de la gare.", meaning = "Where a place is."), ExampleLine(text = "Ils sont de Paris.", meaning = "Someone's origin."))), expressions = listOf(TargetExpression(text = "Je suis …", meaning = "Introduce yourself.", note = "With your name or job: Je suis Ana. Je suis professeure."), TargetExpression(text = "Je suis de …", meaning = "Say where you come from.", note = "Never “Je suis France” — the de is obligatory: Je suis de France."), TargetExpression(text = "Tu es … ?", meaning = "Ask about the other person.", note = "Tu es étudiant ? Tu es d'ici ?"), TargetExpression(text = "Oui, je le suis. / Non, pas du tout.", meaning = "Short answers to a Tu es… ? question.", note = "Repeat the verb through le."), TargetExpression(text = "Il est / Elle est …", meaning = "Say what someone else is.", note = "Elle est médecin — jobs often drop the article."), TargetExpression(text = "Enchanté(e).", meaning = "The fixed phrase when you meet someone.", note = "Add -e if you are a woman: Enchantée.")), situation = "You meet someone new at a friendly language-exchange café in Lyon. Introduce yourselves and ask simple questions with the verb être.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Bonjour ! Je suis Ana. Comment tu t'appelles ?", expected = listOf("Je m'appelle <name>.", "Moi, c'est <name>."), focus = "Je m'appelle / Moi, c'est", watch = "Answering only the name: accept it, then recast “Je m'appelle …”."), PracticeQuestion(prompt = "Tu es de quelle ville ?", expected = listOf("Je suis de <city>.", "Je viens de <city>."), focus = "être + de", watch = "“Je suis Lyon” — recast “Je suis DE Lyon”."), PracticeQuestion(prompt = "Tu es étudiant ?", expected = listOf("Oui, je le suis.", "Non, je ne le suis pas."), focus = "short answers with être", watch = "One-word “Oui” — recast with the verb."), PracticeQuestion(prompt = "Comment ça va, aujourd'hui ?", expected = listOf("Ça va bien.", "Je suis fatigué.", "Je suis content."), focus = "être for feelings", watch = "“Je vais content” mixes verbs — recast with Je suis."), PracticeQuestion(prompt = "Ta ville, elle est grande ou petite ?", expected = listOf("Elle est grande.", "Elle est petite.", "Ma ville est …"), focus = "est with places", watch = "“Ma ville grande” — recast “Ma ville EST grande”."), PracticeQuestion(prompt = "On est amis maintenant ! Ta famille est de où ?", expected = listOf("Elle est de <country>.", "Ma famille est de <country>."), focus = "est for a group's origin", watch = "“Ma famille de …” — recast with est."))), exercises = listOf(Exercise(id = "fr-foundations-u1-etre-e1", kind = "choice", prompt = "Elle ___ professeure.", options = listOf("est", "es", "suis", "sommes"), answers = listOf("est"), explain = "With il/elle, être becomes est."), Exercise(id = "fr-foundations-u1-etre-e2", kind = "gap", prompt = "Nous ___ de Lyon.", options = listOf(), answers = listOf("sommes"), explain = "With nous, être is toujours sommes."), Exercise(id = "fr-foundations-u1-etre-e3", kind = "order", prompt = "Say where you are from.", options = listOf(), answers = listOf("Je suis de France"), explain = "Je suis + de + country: Je suis de France."), Exercise(id = "fr-foundations-u1-etre-e4", kind = "written", prompt = "Introduce yourself in one sentence: say your name.", options = listOf(), answers = listOf("Je m'appelle <name>", "Je suis <name>", "Moi c'est <name>"), explain = "Je m'appelle Ana / Je suis Ana — the subject is never dropped.")), skills = listOf("grammar:verb-be", "grammar:subject-pronouns", "function:describe-people", "speaking:short-answer"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:verb-be")),
    Lesson(id = "fr-foundations-u1-questions", title = "Questions & negatives", goal = "Ask yes/no questions and say what is not true, with Tu es… ? and je ne suis pas.", intro = LessonIntro(explanation = listOf("Spoken French asks yes/no questions with rising intonation: “Tu es fatigué ?” The formal way adds est-ce que: “Est-ce que tu es fatigué ?”", "To negate, wrap the verb: ne + verb + pas. With être: “Je ne suis pas fatigué”, “Il n'est pas professeur” — ne becomes n' before a vowel.", "Question words go first: “Où es-tu ?”, “Qu'est-ce que c'est ?” — and they always carry their accents."), examples = listOf(ExampleLine(text = "Tu es professeure ?", meaning = "A yes/no question with es."), ExampleLine(text = "Je ne suis pas de Paris.", meaning = "A negative with suis."), ExampleLine(text = "Où es-tu ?", meaning = "Question word + es."), ExampleLine(text = "Il n'est pas mon frère.", meaning = "A negative about another person."), ExampleLine(text = "Vous êtes voisins ?", meaning = "Asking a group."), ExampleLine(text = "Qu'est-ce que c'est ?", meaning = "What is this?"))), expressions = listOf(TargetExpression(text = "Tu es … ?", meaning = "Ask a yes/no question.", note = "Spoken style: rising tone. Formal: Est-ce que tu es … ?"), TargetExpression(text = "Je ne suis pas …", meaning = "Say what is not true about you.", note = "ne + suis + pas wraps the verb."), TargetExpression(text = "Où es-tu ?", meaning = "Ask where someone is.", note = "Où with its accent, always."), TargetExpression(text = "Il n'est pas …", meaning = "Say what someone else is not.", note = "ne becomes n' before a vowel: n'est."), TargetExpression(text = "C'est ça ?", meaning = "Tag a statement to check it.", note = "Tu es d'ici, c'est ça ?"), TargetExpression(text = "Bien sûr.", meaning = "The natural yes in talk.", note = "Also: Exact.")), situation = "You chat with a new neighbour in the lift in Lyon. Ask simple yes/no questions and say what is and isn't true for you.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Tu es d'ici ?", expected = listOf("Oui, je suis d'ici.", "Non, je ne suis pas d'ici."), focus = "short answers", watch = "One-word “Oui” — recast with the verb: Oui, je suis d'ici."), PracticeQuestion(prompt = "Tu es professeur ou étudiant ?", expected = listOf("Je suis professeur.", "Je suis étudiant.", "Je suis professeure."), focus = "choice with être", watch = "Accept either; note the article stays dropped."), PracticeQuestion(prompt = "Ta famille est grande ?", expected = listOf("Oui, elle est grande.", "Non, elle n'est pas grande."), focus = "est in questions about others", watch = "“Elle n'est pas grande” — n' before est."), PracticeQuestion(prompt = "Tu es de où, toi ?", expected = listOf("Je suis de <country>.", "Je viens de <country>."), focus = "où + es", watch = "“Je suis à France” — recast with de: Je suis DE France."), PracticeQuestion(prompt = "Dis-moi quelque chose que tu n'es pas.", expected = listOf("Je ne suis pas <job>.", "Je ne suis pas de <country>."), focus = "negation ne…pas", watch = "Both parts needed: ne before, pas after."), PracticeQuestion(prompt = "On est amis maintenant ?", expected = listOf("Oui, on est amis.", "Bien sûr, on est amis."), focus = "on est", watch = "“On sommes” doesn't exist — on always takes est."))), exercises = listOf(Exercise(id = "fr-foundations-u1-questions-e1", kind = "choice", prompt = "¿ ___ tu de Marseille ?", options = listOf("Es", "Est", "Suis", "Êtes"), answers = listOf("Es"), explain = "With tu, the question starts with Es: Tu es de… ?"), Exercise(id = "fr-foundations-u1-questions-e2", kind = "gap", prompt = "Elle ___ pas ma sœur.", options = listOf(), answers = listOf("n'est"), explain = "ne + est → n'est pas: n' before the vowel."), Exercise(id = "fr-foundations-u1-questions-e3", kind = "order", prompt = "Say you are not from Nantes.", options = listOf(), answers = listOf("Je ne suis pas de Nantes"), explain = "ne + suis + pas wraps the verb."), Exercise(id = "fr-foundations-u1-questions-e4", kind = "written", prompt = "Make it negative: \"Je suis de Bordeaux.\"", options = listOf(), answers = listOf("Je ne suis pas de Bordeaux"), explain = "ne…pas around suis: Je ne suis pas de Bordeaux.")), skills = listOf("grammar:verb-be", "grammar:present-questions", "function:ask-simple-questions", "speaking:short-answer"), prerequisites = listOf("grammar:subject-pronouns")),
    Lesson(id = "fr-foundations-u1-introduce", title = "Introducing yourself", goal = "Give a complete self-introduction: name, city, nationality and job.", intro = LessonIntro(explanation = listOf("A full French introduction has four pieces: your name, your city, your nationality and your job.", "For the name: “Je m'appelle Ana” or “Moi, c'est Ana”. For origin: “Je suis de Lyon”. Nationalities are lower-case: “je suis française”.", "Jobs with être usually drop the article: “Je suis professeure”. Close with “Enchantée” and bounce the question back with “Et toi ?”"), examples = listOf(ExampleLine(text = "Je m'appelle Ana. Enchantée.", meaning = "Your name plus a polite close."), ExampleLine(text = "Je suis de Lyon, dans le sud-est.", meaning = "City inside country."), ExampleLine(text = "Je suis française, de la région Rhône.", meaning = "Nationality plus region."), ExampleLine(text = "Je suis infirmière à l'hôpital.", meaning = "Job plus workplace."), ExampleLine(text = "J'ai vingt-cinq ans.", meaning = "Your age — with avoir, not être."), ExampleLine(text = "Et toi ? Tu fais quoi ?", meaning = "Bounce the question back."))), expressions = listOf(TargetExpression(text = "Je m'appelle …", meaning = "Give your name.", note = "Literally “I call myself”. Also: Moi, c'est …"), TargetExpression(text = "Je suis + nationality", meaning = "Say your nationality.", note = "française, allemande, italienne — lower-case in French."), TargetExpression(text = "Je suis de …", meaning = "Say your city or country.", note = "Je suis de Lyon; Je suis de France."), TargetExpression(text = "Je travaille à …", meaning = "Say where you work.", note = "Je travaille à l'hôpital / dans une école."), TargetExpression(text = "Enchanté(e).", meaning = "Polite close when you meet someone.", note = "Answer: Moi aussi."), TargetExpression(text = "Et toi ?", meaning = "Bounce the question back.", note = "—Je suis de Lyon. Et toi ?")), situation = "Your first day at a language school in Lyon. Present yourself completely to the class: name, city, nationality and job.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Comment tu t'appelles ?", expected = listOf("Je m'appelle <name>.", "Moi, c'est <name>."), focus = "name formulas", watch = "Both are fine; recast the shorter one as Je m'appelle for variety."), PracticeQuestion(prompt = "Tu viens d'où ?", expected = listOf("Je viens de <country>.", "Je suis de <country>."), focus = "origin", watch = "Never drop de: Je viens DE <country>."), PracticeQuestion(prompt = "Tu es de quelle nationalité ?", expected = listOf("Je suis <nationality>."), focus = "nationality with être", watch = "Lower-case: je suis française, not Française."), PracticeQuestion(prompt = "Tu fais quoi dans la vie ?", expected = listOf("Je suis <job>.", "Je travaille comme <job>."), focus = "jobs without article", watch = "“Je suis une professeure” — recast dropping the article."), PracticeQuestion(prompt = "Et tu habites où ?", expected = listOf("J'habite à <city>."), focus = "j'habite à", watch = "“J'habite à Lyon” — à for cities."), PracticeQuestion(prompt = "Enchanté ! Et toi, tu fais quoi ?", expected = listOf("Je suis <job>."), focus = "bounce back and answer", watch = "Recast with Je suis + job."))), exercises = listOf(Exercise(id = "fr-foundations-u1-introduce-e1", kind = "choice", prompt = "___ Ana. Enchantée.", options = listOf("Je m'appelle", "Je m'appelle de", "J'appelle", "Je suis de"), answers = listOf("Je m'appelle"), explain = "Je m'appelle + name: one piece, no de."), Exercise(id = "fr-foundations-u1-introduce-e2", kind = "gap", prompt = "Je suis ___ Italie. (nationality)", options = listOf(), answers = listOf("italienne"), explain = "Nationality is lower-case: italienne, italien."), Exercise(id = "fr-foundations-u1-introduce-e3", kind = "order", prompt = "Say your name and city.", options = listOf(), answers = listOf("Je suis Ana et je suis de Lyon"), explain = "Two suis pieces, each with its subject."), Exercise(id = "fr-foundations-u1-introduce-e4", kind = "written", prompt = "Give your complete introduction: name and country.", options = listOf(), answers = listOf("Je m'appelle <name> et je suis de <country>", "Je suis <name> et je suis de <country>"), explain = "Name + origin, each with its subject.")), skills = listOf("grammar:verb-be", "function:introduce-yourself", "vocab:introductions", "pron:word-stress"), canDo = listOf("introduce-yourself"))))
}

object FrFoundationsU2 {
    val unit = CourseUnit(id = "fr-foundations-u2", title = "Mon quotidien", subtitle = "Routine et projets", level = "A1", themes = listOf(ConversationTheme("matinee-folle", "Matinée folle", "Contre le réveil", "sunrise", "Course", "Tu racontes ta matinée minute par minute : heures, habitudes et oublis.", 0),
                ConversationTheme("samedi-ensemble", "Samedi ensemble", "On fait quoi ?", "figure.walk", "Course", "Des projets pour samedi avec un ami : marché, heure, lieu de rendez-vous.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u2-routine", title = "Ma routine", goal = "Raconter ta journée au présent avec les heures.", intro = LessonIntro(explanation = listOf("Le présent raconte les habitudes : « Je me lève à sept heures. Je prends un café. Je pars à huit heures. »", "Les verbes réflexifs gardent me/te/se : « je me lève, je me douche, je me couche » — le pronom fait partie du verbe.", "Les heures : « à sept heures », « à sept heures et demie ». Avec à : « à huit heures, je pars »."), examples = listOf(ExampleLine(text = "Je me lève à sept heures.", meaning = "Le premier verbe."), ExampleLine(text = "Je prends un café le matin.", meaning = "La boisson du réveil."), ExampleLine(text = "Je me douche et je pars à huit heures.", meaning = "Deux actions de suite."), ExampleLine(text = "Le samedi, je me lève tard.", meaning = "L'habitude du week-end."), ExampleLine(text = "Je me couche vers onze heures.", meaning = "Le soir, avec vers."))), expressions = listOf(TargetExpression(text = "Je me lève à …", meaning = "Le réveil.", note = "me + lève : inséparables."), TargetExpression(text = "Je prends mon petit-déjeuner", meaning = "Le matin.", note = "prendre le petit-déjeuner."), TargetExpression(text = "Je pars à …", meaning = "La sortie.", note = "partir de + lieu."), TargetExpression(text = "Le samedi, …", meaning = "L'habitude.", note = "le + jour = chaque jour."), TargetExpression(text = "Je me couche vers …", meaning = "Le coucher.", note = "vers = environ.")), situation = "Tu racontes ta matinée à un nouvel ami : réveil, petit-déjeuner, douche, départ — et le changement du samedi.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dis à quelle heure tu te lèves en semaine.", expected = listOf("Je me lève à <heure> en semaine."), focus = "je me lève", watch = "me/te/se font partie du verbe."), PracticeQuestion(prompt = "Dis ce que tu prends au petit-déjeuner.", expected = listOf("Je prends un café et des toasts."), focus = "prendre", watch = "prendre le petit-déjeuner = desayunar."), PracticeQuestion(prompt = "Dis à quelle heure tu pars de chez toi.", expected = listOf("Je pars de chez moi à <heure>."), focus = "partir de", watch = "partir DE chez moi."), PracticeQuestion(prompt = "Dis ton habitude du samedi.", expected = listOf("Le samedi, je me lève tard."), focus = "le + jour", watch = "le samedi = cada sábado."), PracticeQuestion(prompt = "Dis à quelle heure tu te couches.", expected = listOf("Je me couche vers <heure>."), focus = "je me couche", watch = "me couche — vers = hacia las."))), exercises = listOf(Exercise(id = "fr-foundations-u2-routine-e1", kind = "choice", prompt = "Je ___ ___ à sept heures.", options = listOf("me lève", "lève me", "se lève", "lever"), answers = listOf("me lève"), explain = "me/te/se + verbe : je me lève."), Exercise(id = "fr-foundations-u2-routine-e2", kind = "gap", prompt = "Je ___ un café le matin. (prendre)", options = listOf(), answers = listOf("prends"), explain = "je prends : prendre fait prendre."), Exercise(id = "fr-foundations-u2-routine-e3", kind = "order", prompt = "Dis ton départ.", options = listOf(), answers = listOf("Je pars de chez moi a huit heures"), explain = "je pars de + lieu."), Exercise(id = "fr-foundations-u2-routine-e4", kind = "written", prompt = "Ton habitude du samedi.", options = listOf(), answers = listOf("le samedi je me leve tard", "le samedi je me leve tard"), explain = "le + jour + présent.")), skills = listOf("grammar:present-simple", "grammar:time-expressions", "vocab:daily-routine", "function:talk-about-routines"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u2-quartier", title = "Mon quartier", goal = "Dire ce qu'il y a dans ton quartier avec il y a.", intro = LessonIntro(explanation = listOf("Il y a ne change jamais : « Il y a une boulangerie, deux cafés et un parc. »", "Pour demander : « Il y a une pharmacie par ici ? ». Pour nier : « Il n'y a pas de cinéma. »", "Situer : en face de, à côté de, près de : « La boulangerie est en face du parc. »"), examples = listOf(ExampleLine(text = "Il y a une boulangerie et deux cafés.", meaning = "il y a, toujours pareil."), ExampleLine(text = "Il y a une pharmacie par ici ?", meaning = "La question utile."), ExampleLine(text = "Il n'y a pas de cinéma.", meaning = "La négation, avec de."), ExampleLine(text = "La boulangerie est en face du parc.", meaning = "La localisation."), ExampleLine(text = "Tout est près de chez moi.", meaning = "Le résumé."))), expressions = listOf(TargetExpression(text = "Il y a + lieu", meaning = "Dire ce qui existe.", note = "Il y a un parc."), TargetExpression(text = "Il y a … par ici ?", meaning = "Demander.", note = "…une pharmacie ?"), TargetExpression(text = "Il n'y a pas de …", meaning = "Ce qui manque.", note = "pas de cinéma."), TargetExpression(text = "en face de / à côté de", meaning = "Situer.", note = "en face du parc."), TargetExpression(text = "près de chez moi", meaning = "La distance.", note = "tout est près.")), situation = "Un visiteur demande ton quartier : nomme quatre lieux, dis ce qui manque et situe ton préféré.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Nomme deux lieux de ton quartier.", expected = listOf("Il y a <lieu> et <lieu>."), focus = "il y a", watch = "il y a ne change jamais."), PracticeQuestion(prompt = "Dis ce qui manque. (cinéma)", expected = listOf("Il n'y a pas de cinéma dans mon quartier."), focus = "pas de", watch = "négation : pas DE cinéma."), PracticeQuestion(prompt = "Demande s'il y a une pharmacie.", expected = listOf("Il y a une pharmacie par ici ?"), focus = "par ici", watch = "par ici = cerca, por esta zona."), PracticeQuestion(prompt = "Situe ton lieu préféré.", expected = listOf("<Lieu> est en face de <lieu>."), focus = "en face de", watch = "en face DE + lieu."), PracticeQuestion(prompt = "Dis que tout est près de chez toi.", expected = listOf("Tout est près de chez moi."), focus = "près de", watch = "près DE chez moi."))), exercises = listOf(Exercise(id = "fr-foundations-u2-quartier-e1", kind = "choice", prompt = "___ une boulangerie et deux cafés.", options = listOf("Il y a", "Ils sont", "C'est", "Il est"), answers = listOf("Il y a"), explain = "il y a pour l'existence."), Exercise(id = "fr-foundations-u2-quartier-e2", kind = "gap", prompt = "Il n'y a ___ de cinéma ici. (negación)", options = listOf(), answers = listOf("pas"), explain = "il n'y a pas de + lieu."), Exercise(id = "fr-foundations-u2-quartier-e3", kind = "order", prompt = "Demande une pharmacie.", options = listOf(), answers = listOf("Il y a une pharmacie par ici"), explain = "Il y a + lieu + par ici ?"), Exercise(id = "fr-foundations-u2-quartier-e4", kind = "written", prompt = "Dis ce qu'il y a devant chez toi.", options = listOf(), answers = listOf("il y a <lieu> en face de chez moi", "il y a un parc"), explain = "Il y a + lieu + en face de.")), skills = listOf("vocab:town", "grammar:there-is-are", "grammar:prepositions-place", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:there-is-are")),
    Lesson(id = "fr-foundations-u2-projets", title = "Des projets pour samedi", goal = "Proposer des projets avec on va et fixer un rendez-vous.", intro = LessonIntro(explanation = listOf("Le futur proche : aller + infinitif. « Samedi, on va aller au marché. » C'est aller qui se conjugue.", "Proposer : « On va au marché ? », « Tu veux venir ? ». Se donner rendez-vous : « On se retrouve à six heures ? »", "Confirmer avec lieu et heure : « Parfait, six heures, devant le parc. » Un plan sans lieu reste un rêve."), examples = listOf(ExampleLine(text = "Samedi, on va aller au marché.", meaning = "aller + infinitif."), ExampleLine(text = "Tu veux venir avec nous ?", meaning = "L'invitation."), ExampleLine(text = "On se retrouve à six heures, devant le parc ?", meaning = "Le rendez-vous."), ExampleLine(text = "Parfait, c'est noté.", meaning = "La confirmation."), ExampleLine(text = "S'il pleut, on reporte à dimanche.", meaning = "Le plan B."))), expressions = listOf(TargetExpression(text = "on va + infinitif", meaning = "Le projet du groupe.", note = "on va aller au marché."), TargetExpression(text = "Tu veux venir ?", meaning = "Inviter.", note = "venir avec nous."), TargetExpression(text = "On se retrouve à … , …", meaning = "Le rendez-vous.", note = "heure + lieu."), TargetExpression(text = "Parfait / C'est noté", meaning = "Confirmer.", note = "c'est noté = queda apuntado."), TargetExpression(text = "S'il pleut, on …", meaning = "Le plan B.", note = "si + présent.")), situation = "Tu organises samedi avec un ami : le marché, rendez-vous à six heures devant le parc, et plan B s'il pleut.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Propose le marché avec on va.", expected = listOf("Samedi, on va aller au marché."), focus = "on va", watch = "aller conjugué + infinitif."), PracticeQuestion(prompt = "Invite ton ami.", expected = listOf("Tu veux venir avec nous ?"), focus = "venir", watch = "venir AVEC quelqu'un."), PracticeQuestion(prompt = "Fixe le rendez-vous. (6h, le parc)", expected = listOf("On se retrouve à six heures, devant le parc ?"), focus = "se retrouver", watch = "heure + lieu."), PracticeQuestion(prompt = "Donne le plan B. (pluie / dimanche)", expected = listOf("S'il pleut, on reporte à dimanche."), focus = "si + présent", watch = "si + présent + plan."), PracticeQuestion(prompt = "Invite ton ami au plan.", expected = listOf("Tu veux venir avec nous ?"), focus = "venir", watch = "venir AVEC nous."))), exercises = listOf(Exercise(id = "fr-foundations-u2-projets-e1", kind = "choice", prompt = "Samedi, on va ___ au marché.", options = listOf("aller", "allons", "vont", "irons"), answers = listOf("aller"), explain = "aller + infinitif : le second reste à l'infinitif."), Exercise(id = "fr-foundations-u2-projets-e2", kind = "gap", prompt = "On ___ retrouve à six heures ? (rendez-vous)", options = listOf(), answers = listOf("se"), explain = "on se retrouve = nos vemos."), Exercise(id = "fr-foundations-u2-projets-e3", kind = "order", prompt = "Fixe le rendez-vous.", options = listOf(), answers = listOf("On se retrouve a six heures devant le parc"), explain = "on se retrouve + heure + lieu."), Exercise(id = "fr-foundations-u2-projets-e4", kind = "written", prompt = "Le plan B s'il pleut.", options = listOf(), answers = listOf("sil pleut on reporte a dimanche", "s'il pleut on va a dimanche"), explain = "si + présent + plan.")), skills = listOf("grammar:going-to", "function:make-future-plans", "vocab:social-expressions", "grammar:present-questions"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to"))))
}

object FrFoundationsU5 {
    val unit = CourseUnit(id = "fr-foundations-u5", title = "Au marché", subtitle = "Acheter local", level = "A1", themes = listOf(ConversationTheme("marche-du-quartier", "Le marché du quartier", "Fruits et légumes", "cart", "Course", "Vous achetez au marché du quartier: fruits, légumes et contact avec le vendeur.", 0),
                ConversationTheme("epicerie-coin", "L'épicerie du coin", "Ce qui manque", "storefront", "Course", "Il manque quelque chose pour le dîner: vous courez à l'épicerie.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u5-marche", title = "Au marché", goal = "Acheter des fruits et légumes: quantités, prix et formules polies.", intro = LessonIntro(explanation = listOf("Au marché on demande: « C'est combien, les tomates ? ». « Elles sont bonnes ? »", "Les quantités: « Une livre de cerises ». « Un kilo de pommes ». « Deux cents grammes de jambon ».", "La formule polie: « Bonjour, je voudrais un kilo de pommes, s'il vous plaît »."), examples = listOf(ExampleLine(text = "C'est combien, les tomates ?", meaning = "Le prix."), ExampleLine(text = "Je voudrais un kilo de pommes.", meaning = "Je voudrais + quantité."), ExampleLine(text = "Elles sont bonnes ?", meaning = "Qualité."), ExampleLine(text = "Deux cents grammes de jambon.", meaning = "Poids exact."), ExampleLine(text = "Vous désirez autre chose ?", meaning = "Le vendeur demande."))), expressions = listOf(TargetExpression(text = "C'est combien, … ?", meaning = "Prix.", note = "…les tomates ?"), TargetExpression(text = "Je voudrais + quantité", meaning = "Demander.", note = "Je voudrais un kilo."), TargetExpression(text = "Elles sont bonnes ?", meaning = "Qualité.", note = "bonnes (fem pl)."), TargetExpression(text = "une livre de …", meaning = "Poids français.", note = "= environ 500 g."), TargetExpression(text = "Vous désirez … ?", meaning = "Le vendeur demande.", note = "= Que voulez-vous ?")), situation = "Vous achetez au marché: un kilo de pommes, une livre de cerises et vous demandez si tout est frais.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Demandez le prix des tomates.", expected = listOf("C'est combien, les tomates ?"), focus = "combien", watch = "C'est combien + article + nom."), PracticeQuestion(prompt = "Demandez un kilo de pommes.", expected = listOf("Je voudrais un kilo de pommes, s'il vous plaît."), focus = "je voudrais", watch = "je voudrais + quantité + produit."), PracticeQuestion(prompt = "Demandez si les pommes sont bonnes.", expected = listOf("Elles sont bonnes ?"), focus = "qualité", watch = "Elles (pommes, fem pl)."), PracticeQuestion(prompt = "Dites ce que vous voulez: une livre de cerises.", expected = listOf("Je voudrais une livre de cerises."), focus = "livre", watch = "une livre ≈ 500 g."), PracticeQuestion(prompt = "Répondez au vendeur : rien d'autre, merci.", expected = listOf("Rien d'autre merci.", "C'est tout merci."), focus = "vous désirez", watch = "Rien d'autre = nada más."))), exercises = listOf(Exercise(id = "fr-foundations-u5-marche-e1", kind = "choice", prompt = "___ ___, les tomates ?", options = listOf("C'est combien", "C'est comment", "Il est combien", "Qu'est-ce"), answers = listOf("C'est combien"), explain = "C'est combien + article + nom."), Exercise(id = "fr-foundations-u5-marche-e2", kind = "gap", prompt = "Je ___ un kilo de pommes. (vouloir poliment)", options = listOf(), answers = listOf("voudrais"), explain = "je voudrais + quantité."), Exercise(id = "fr-foundations-u5-marche-e3", kind = "order", prompt = "Demandez des cerises.", options = listOf(), answers = listOf("Je voudrais une livre de cerises"), explain = "je voudrais + poids + produit."), Exercise(id = "fr-foundations-u5-marche-e4", kind = "written", prompt = "Demandez si les pommes sont bonnes.", options = listOf(), answers = listOf("elles sont bonnes", "sont-elles bonnes"), explain = "Elles sont bonnes ?")), skills = listOf("vocab:food", "grammar:quantities", "vocab:shopping", "function:go-shopping"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u5-epicerie", title = "L'épicerie du coin", goal = "Acheter ce qui manque: chercher, demander et payer.", intro = LessonIntro(explanation = listOf("À l'épicerie: « Vous avez…? » « Je cherche… ». Le vendeur répond: « Oui, là-bas » ou « Désolé, c'est en rupture ».", "Rupture = épuisé. « C'est en rupture de stock. » « Il n'y en a plus. »", "Le paiement: « Ça fait combien ? » « Ça fait sept euros. » « Vous payez par carte ? »"), examples = listOf(ExampleLine(text = "Vous avez du pain complet ?", meaning = "Preguntar si tienen."), ExampleLine(text = "Je cherche de la levadure fraîche.", meaning = "Buscar algo."), ExampleLine(text = "Désolé, c'est en rupture de stock.", meaning = "No queda."), ExampleLine(text = "Ça fait combien ?", meaning = "Preguntar el total."), ExampleLine(text = "Je paie par carte.", meaning = "Método de pago."))), expressions = listOf(TargetExpression(text = "Vous avez … ?", meaning = "Preguntar en tienda.", note = "…du pain complet ?"), TargetExpression(text = "Je cherche …", meaning = "Buscar.", note = "…de la levadure fraîche."), TargetExpression(text = "c'est en rupture", meaning = "Epuisé.", note = "rupture de stock."), TargetExpression(text = "Ça fait combien ?", meaning = "El total.", note = "Ça fait + precio."), TargetExpression(text = "Je paie par carte.", meaning = "Pago.", note = "payer par carte.")), situation = "Corres a la épicerie antes del cierre: buscas tres cosas, dos las tiene y una está agotada.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Preguntar si tienen pan integral.", expected = listOf("Vous avez du pain complet ?"), focus = "vous avez", watch = "Vous avez + produit ?"), PracticeQuestion(prompt = "Decir que buscas levadura fresca.", expected = listOf("Je cherche de la levadure fraîche."), focus = "je cherche", watch = "je cherche + produit."), PracticeQuestion(prompt = "Reaccionar cuando está agotado.", expected = listOf("Ah, c'est en rupture de stock. Dommage !"), focus = "rupture", watch = "dommage = lástima."), PracticeQuestion(prompt = "Preguntar el total.", expected = listOf("Ça fait combien ?"), focus = "total", watch = "Ça fait + precio."), PracticeQuestion(prompt = "Dites comment vous payez : par carte.", expected = listOf("Je paie par carte.", "Je paie par carte, s'il vous plaît."), focus = "je paie", watch = "par carte = con tarjeta."))), exercises = listOf(Exercise(id = "fr-foundations-u5-epicerie-e1", kind = "choice", prompt = "___ ___ du pain complet ?", options = listOf("Vous avez", "Il y a", "C'est", "Vous êtes"), answers = listOf("Vous avez"), explain = "Vous avez + produit ?"), Exercise(id = "fr-foundations-u5-epicerie-e2", kind = "gap", prompt = "Je ___ de la levadure fraîche. (chercher)", options = listOf(), answers = listOf("cherche"), explain = "je cherche + produit."), Exercise(id = "fr-foundations-u5-epicerie-e3", kind = "order", prompt = "Preguntar el total.", options = listOf(), answers = listOf("Ca fait combien"), explain = "Ça fait combien ?"), Exercise(id = "fr-foundations-u5-epicerie-e4", kind = "written", prompt = "Di que buscas levadura fresca.", options = listOf(), answers = listOf("je cherche de la levadure fraiche", "je cherche de la levure fraiche"), explain = "Je cherche + producto.")), skills = listOf("function:go-shopping", "grammar:present-questions", "vocab:food", "function:solve-problems"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple"))))
}

object FrFoundationsU10 {
    val unit = CourseUnit(id = "fr-foundations-u10", title = "Ma maison", subtitle = "Mon espace", level = "A1", themes = listOf(ConversationTheme("visite-appart", "La visite de l'appart", "Il y a / il n'y a pas", "house", "Course", "Vous visitez un petit appartement du quartier : les pièces, les meubles, et ce qui manque.", 0),
                ConversationTheme("coloc-recherche", "La colocation", "Mon, ma, mes", "bed", "Course", "Karim arrive avec ses cartons : sa chambre, ses livres — et vous présentez vos choses.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u10-maison", title = "Mon appart", goal = "Dire ce qu'il y a chez toi : les pièces et les meubles avec il y a.", intro = LessonIntro(explanation = listOf("Pour dire ce qui existe, on utilise « il y a » : « Il y a une grande cuisine. Il y a deux chambres. »", "Un, une pour le singulier, des pour le pluriel : « Il y a un canapé, une table, des chaises. »", "La négation : « Il n'y a pas de garage. » Devant une voyelle, de devient d' : « Il n'y a pas d'ascenseur. »"), examples = listOf(ExampleLine(text = "Il y a une grande cuisine.", meaning = "La pièce pour cuisiner."), ExampleLine(text = "Il y a deux chambres.", meaning = "La pièce pour dormir."), ExampleLine(text = "Dans le salon, il y a un canapé.", meaning = "Les meubles du salon."), ExampleLine(text = "Il y a des chaises dans la cuisine.", meaning = "Le pluriel avec des."), ExampleLine(text = "Il n'y a pas d'ascenseur.", meaning = "La négation avec d'."))), expressions = listOf(TargetExpression(text = "Il y a + un / une / des", meaning = "Dire ce qui existe.", note = "Il y a un lit dans la chambre."), TargetExpression(text = "Il n'y a pas de …", meaning = "La négation.", note = "pas de garage ; pas d'ascenseur."), TargetExpression(text = "la salle de bains", meaning = "La pièce pour se laver.", note = "les toilettes, c'est à côté."), TargetExpression(text = "un deux-pièces", meaning = "Un petit appartement.", note = "une pièce = une chambre."), TargetExpression(text = "C'est grand / petit.", meaning = "La taille.", note = "C'est petit mais clair.")), situation = "Vous visitez un petit appartement : deux pièces, une cuisine claire, pas d'ascenseur — et vous demandez s'il y a un balcon.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dis ce qu'il y a dans ta cuisine.", expected = listOf("Il y a une table et des chaises.", "Dans ma cuisine, il y a une table et des chaises."), focus = "il y a", watch = "des pour le pluriel."), PracticeQuestion(prompt = "L'immeuble n'a pas de place pour la voiture. Dis-le.", expected = listOf("Il n'y a pas de garage.", "Il n'y a pas de parking."), focus = "pas de", watch = "négation : pas DE + nom."), PracticeQuestion(prompt = "Demandez au propriétaire s'il y a un balcon.", expected = listOf("Il y a un balcon ?", "Est-ce qu'il y a un balcon ?"), focus = "question", watch = "est-ce que + il y a."), PracticeQuestion(prompt = "Dis ce qu'il y a dans ta chambre.", expected = listOf("Il y a un lit et une armoire.", "Il y a un lit et un bureau."), focus = "la chambre", watch = "un lit, une armoire."), PracticeQuestion(prompt = "L'appartement est au cinquième étage. Dis que l'immeuble n'a pas d'ascenseur.", expected = listOf("Il n'y a pas d'ascenseur.", "Il n'y a pas d'ascenseur dans l'immeuble."), focus = "d'ascenseur", watch = "de devient d' devant une voyelle."))), exercises = listOf(Exercise(id = "fr-foundations-u10-maison-e1", kind = "choice", prompt = "___ ___ une grande cuisine dans ton appart ?", options = listOf("Il y a", "Il est", "C'est", "Elle a"), answers = listOf("Il y a"), explain = "il y a = il existe ; il est = identité."), Exercise(id = "fr-foundations-u10-maison-e2", kind = "gap", prompt = "Dans la chambre, il y a ___ grand lit.", options = listOf(), answers = listOf("un"), explain = "un lit : masculin singulier."), Exercise(id = "fr-foundations-u10-maison-e3", kind = "order", prompt = "Décrivez la cuisine.", options = listOf(), answers = listOf("Il y a une table dans la cuisine"), explain = "il y a + article + nom + lieu."), Exercise(id = "fr-foundations-u10-maison-e4", kind = "written", prompt = "Dis ce qu'il y a dans le salon : un canapé bleu et une télé.", options = listOf(), answers = listOf("il y a un canapé bleu et une télé", "il y a un canape bleu et une tele"), explain = "il y a + un/une + meuble.")), skills = listOf("grammar:there-is-are", "grammar:present-simple", "vocab:home", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u10-endroits", title = "Où est-ce ?", goal = "Situer les objets : sur, sous, à côté de — et demander où est la chose.", intro = LessonIntro(explanation = listOf("Les mots de lieu : « sur » (en haut) et « sous » (en bas) : « Le chat est sur le lit. Les clés sont sous la table. »", "« À côté de » dit la proximité : « à côté du canapé » (le), « à côté de la fenêtre » (la), « à côté des livres » (les).", "Pour demander : « Où est le chat ? » (un seul objet), « Où sont les clés ? » (plusieurs objets)."), examples = listOf(ExampleLine(text = "Le chat est sur le lit.", meaning = "En haut du lit."), ExampleLine(text = "Les clés sont sous la table.", meaning = "En bas de la table."), ExampleLine(text = "La lampe est à côté du canapé.", meaning = "Près du canapé."), ExampleLine(text = "Où est la salle de bains ?", meaning = "Demander une pièce."), ExampleLine(text = "Où sont mes clés ?", meaning = "Plusieurs objets."))), expressions = listOf(TargetExpression(text = "sur", meaning = "En haut.", note = "sur le lit, sur la table."), TargetExpression(text = "sous", meaning = "En bas.", note = "sous le canapé."), TargetExpression(text = "à côté de / du / de la", meaning = "Près.", note = "à côté du frigo."), TargetExpression(text = "Où est … ?", meaning = "Un seul objet.", note = "Où est le chat ?"), TargetExpression(text = "Où sont … ?", meaning = "Plusieurs objets.", note = "Où sont les clés ?")), situation = "Le chat joue à cache-cache dans l'appartement : sur le lit, sous la table, à côté du frigo — et vous cherchez aussi vos clés.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Le chat est en haut du lit. Dis-le avec sur.", expected = listOf("Le chat est sur le lit.", "Il est sur le lit."), focus = "sur", watch = "sur = en haut de."), PracticeQuestion(prompt = "Les chaussures sont en bas du lit. Dis-le avec sous.", expected = listOf("Les chaussures sont sous le lit.", "Elles sont sous le lit."), focus = "sous", watch = "sous = en bas de."), PracticeQuestion(prompt = "La lampe est près du canapé. Dis-le avec à côté de.", expected = listOf("La lampe est à côté du canapé.", "Elle est à côté du canapé.", "La lampe est a cote du canape."), focus = "à côté du", watch = "de + le = du ; de + la = de la."), PracticeQuestion(prompt = "Vous cherchez la salle de bains. Posez la question.", expected = listOf("Où est la salle de bains ?", "Ou est la salle de bains ?"), focus = "où est", watch = "où est + un objet singulier."), PracticeQuestion(prompt = "Vos clés ont disparu. Posez la question.", expected = listOf("Où sont mes clés ?", "Ou sont mes cles ?"), focus = "où sont", watch = "où sont + pluriel."))), exercises = listOf(Exercise(id = "fr-foundations-u10-endroits-e1", kind = "choice", prompt = "Le chat est ___ le lit : en haut !", options = listOf("sur", "sous", "dans", "à côté"), answers = listOf("sur"), explain = "sur = en haut ; sous = en bas."), Exercise(id = "fr-foundations-u10-endroits-e2", kind = "gap", prompt = "La lampe est à côté ___ canapé.", options = listOf(), answers = listOf("du"), explain = "à côté de + le = du."), Exercise(id = "fr-foundations-u10-endroits-e3", kind = "order", prompt = "Décrivez la photo : le chat et le lit.", options = listOf(), answers = listOf("Le chat est sur le lit"), explain = "sur + le lit : en haut."), Exercise(id = "fr-foundations-u10-endroits-e4", kind = "written", prompt = "Vous cherchez vos clés. Un ami répond : la table, en haut.", options = listOf(), answers = listOf("les clés sont sur la table", "les cles sont sur la table", "elles sont sur la table"), explain = "les clés sont sur + lieu.")), skills = listOf("grammar:prepositions-place", "grammar:there-is-are", "vocab:home", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u10-coloc", title = "Mon colocataire", goal = "Présenter ton colocataire et parler de tes choses avec mon, ma, mes.", intro = LessonIntro(explanation = listOf("mon, ma, mes disent à qui est la chose : « mon frère, ma sœur, mes amis. »", "mon devant un mot masculin, ma devant un mot féminin, mes au pluriel : « mon colocataire, ma chambre, mes meubles. »", "Pour décrire une personne : « Il est grand et sympa. » « Elle est très gentille. »"), examples = listOf(ExampleLine(text = "Mon colocataire s'appelle Karim.", meaning = "mon + masculin."), ExampleLine(text = "Ma chambre est petite mais claire.", meaning = "ma + féminin."), ExampleLine(text = "Mes voisins sont très gentils.", meaning = "mes + pluriel."), ExampleLine(text = "Karim est grand et sympa.", meaning = "La description."), ExampleLine(text = "Il aime la musique et le foot.", meaning = "Les goûts."))), expressions = listOf(TargetExpression(text = "mon …", meaning = "Possessif masculin.", note = "mon frère, mon colocataire."), TargetExpression(text = "ma …", meaning = "Possessif féminin.", note = "ma chambre, ma sœur."), TargetExpression(text = "mes …", meaning = "Possessif pluriel.", note = "mes amis, mes clés."), TargetExpression(text = "Il est / Elle est …", meaning = "Décrire quelqu'un.", note = "Elle est très sympa."), TargetExpression(text = "Il / Elle aime …", meaning = "Les goûts.", note = "Il aime le foot.")), situation = "Karim arrive avec ses cartons : sa chambre, ses livres, sa guitare — et vous présentez vos choses à lui.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Présente ton colocataire : il s'appelle Karim.", expected = listOf("Mon colocataire s'appelle Karim.", "Mon colocataire, c'est Karim."), focus = "mon", watch = "colocataire = mot masculin."), PracticeQuestion(prompt = "Ta chambre est petite. Dis-le avec mon, ma ou mes.", expected = listOf("Ma chambre est petite.", "Ma chambre est vraiment petite."), focus = "ma", watch = "chambre = féminin : ma."), PracticeQuestion(prompt = "Tes amis sont gentils. Dis-le avec mon, ma ou mes.", expected = listOf("Mes amis sont gentils.", "Mes amis sont très gentils."), focus = "mes", watch = "pluriel : mes."), PracticeQuestion(prompt = "Comment est Karim ? Donnez deux qualités.", expected = listOf("Il est grand et sympa.", "Karim est grand et sympa."), focus = "description", watch = "il/elle est + adjectif."), PracticeQuestion(prompt = "Dis ce qu'aime ta colocataire Léa : la musique.", expected = listOf("Elle aime la musique.", "Léa aime la musique.", "Lea aime la musique."), focus = "elle aime", watch = "elle + aime + activité."))), exercises = listOf(Exercise(id = "fr-foundations-u10-coloc-e1", kind = "choice", prompt = "___ chambre est en désordre, désolé !", options = listOf("Ma", "Mon", "Mes", "Me"), answers = listOf("Ma"), explain = "chambre = féminin : ma."), Exercise(id = "fr-foundations-u10-coloc-e2", kind = "gap", prompt = "J'habite avec ___ deux frères.", options = listOf(), answers = listOf("mes"), explain = "frères = pluriel : mes."), Exercise(id = "fr-foundations-u10-coloc-e3", kind = "order", prompt = "Présente ta colocataire et son caractère.", options = listOf(), answers = listOf("Ma colocataire est grande et sympa"), explain = "ma + nom + être + adjectif."), Exercise(id = "fr-foundations-u10-coloc-e4", kind = "written", prompt = "Décris ta colocataire Léa.", options = listOf(), answers = listOf("elle est grande et gentille", "léa est grande et gentille"), explain = "elle est + adjectifs.")), skills = listOf("grammar:possessives", "function:describe-people", "vocab:home", "grammar:present-simple"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:possessives"))))
}

object FrFoundationsU11 {
    val unit = CourseUnit(id = "fr-foundations-u11", title = "Mon quartier", subtitle = "Près de chez moi", level = "A1", themes = listOf(ConversationTheme("carte-du-quartier", "La carte du quartier", "Les lieux utiles", "map", "Course", "Vous cherchez les lieux du quartier : boulangerie, pharmacie, banque, parc et gare.", 0),
                ConversationTheme("le-primeur", "Le primeur du coin", "Fruits et légumes", "cart", "Course", "Chez le primeur du quartier : vous choisissez vos fruits et vous payez.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u11-lieux", title = "Y a-t-il un supermarché ?", goal = "Demander ce qu'il y a dans le quartier avec est-ce qu'il y a.", intro = LessonIntro(explanation = listOf("Pour demander un lieu : « Est-ce qu'il y a un supermarché près d'ici ? » Ou plus court : « Il y a une boulangerie ici ? »", "La réponse : « Oui, il y en a une à côté. » Négatif : « Non, il n'y en a pas. »", "Les lieux du quartier : la boulangerie, la pharmacie, la banque, la gare, le parc."), examples = listOf(ExampleLine(text = "Est-ce qu'il y a une boulangerie près d'ici ?", meaning = "Demander un lieu."), ExampleLine(text = "Oui, il y en a une à côté.", meaning = "Réponse affirmative."), ExampleLine(text = "Non, il n'y en a pas.", meaning = "Réponse négative."), ExampleLine(text = "Il y a un parc près de la gare.", meaning = "Situer deux lieux."), ExampleLine(text = "La pharmacie est ouverte le dimanche ?", meaning = "Une question utile."))), expressions = listOf(TargetExpression(text = "Est-ce qu'il y a … ?", meaning = "Demander un lieu.", note = "…un supermarché près d'ici ?"), TargetExpression(text = "près d'ici", meaning = "À quelques minutes.", note = "près d'ici = tout proche."), TargetExpression(text = "il y en a un / une", meaning = "Répondre oui.", note = "une boulangerie → il y en a une."), TargetExpression(text = "il n'y en a pas", meaning = "Répondre non.", note = "= il n'y a pas de lieu."), TargetExpression(text = "la boulangerie", meaning = "Le pain du quartier.", note = "la pharmacie : les médicaments.")), situation = "Vous êtes nouveau dans le quartier : vous cherchez une boulangerie, une pharmacie et un endroit pour courir.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Demandez s'il y a une boulangerie près d'ici.", expected = listOf("Est-ce qu'il y a une boulangerie près d'ici ?", "Il y a une boulangerie près d'ici ?", "Est-ce qu'il y a une boulangerie pres d'ici ?"), focus = "est-ce qu'il y a", watch = "est-ce que + il y a."), PracticeQuestion(prompt = "La pharmacie est dans la rue d'à côté. Répondez oui.", expected = listOf("Oui, il y en a une à côté.", "Oui, il y a une pharmacie à côté.", "Oui, il y en a une a cote."), focus = "il y en a", watch = "une pharmacie → il y en a une."), PracticeQuestion(prompt = "Il n'y a pas de banque ici. Répondez négativement.", expected = listOf("Non, il n'y en a pas.", "Non, il n'y a pas de banque."), focus = "négation", watch = "en = de ce lieu."), PracticeQuestion(prompt = "Demandez s'il y a un parc dans le quartier.", expected = listOf("Est-ce qu'il y a un parc dans le quartier ?", "Il y a un parc dans le quartier ?"), focus = "un parc", watch = "un parc : masculin singulier."), PracticeQuestion(prompt = "Situez la gare : elle est proche du parc.", expected = listOf("La gare est près du parc.", "Elle est près du parc.", "La gare est pres du parc."), focus = "près de", watch = "près du (masc.), près de la (fém.)."))), exercises = listOf(Exercise(id = "fr-foundations-u11-lieux-e1", kind = "choice", prompt = "___ ___ ___ une pharmacie près d'ici ?", options = listOf("Est-ce qu'il y a", "Est-ce qu'il est", "Est-ce que c'est", "Il y est"), answers = listOf("Est-ce qu'il y a"), explain = "il y a pour dire l'existence d'un lieu."), Exercise(id = "fr-foundations-u11-lieux-e2", kind = "gap", prompt = "Oui, il y en ___ une, à côté de la banque.", options = listOf(), answers = listOf("a"), explain = "il y en a une = elle existe."), Exercise(id = "fr-foundations-u11-lieux-e3", kind = "order", prompt = "Demandez un parc dans le quartier.", options = listOf(), answers = listOf("Il y a un parc dans le quartier"), explain = "il y a + article + lieu."), Exercise(id = "fr-foundations-u11-lieux-e4", kind = "written", prompt = "La banque est loin. Dites qu'il n'y en a pas près d'ici.", options = listOf(), answers = listOf("il n'y a pas de banque près d'ici", "il n'y a pas de banque pres d'ici"), explain = "il n'y a pas de + lieu.")), skills = listOf("grammar:there-is-are", "grammar:present-questions", "vocab:town", "function:ask-simple-questions"), canDo = listOf("ask-for-directions"), prerequisites = listOf("grammar:there-is-are")),
    Lesson(id = "fr-foundations-u11-directions", title = "Comment y aller ?", goal = "Demander le chemin et comprendre : tout droit, à gauche, à droite.", intro = LessonIntro(explanation = listOf("Pour demander le chemin : « Pardon, où est la gare ? Comment y aller ? »", "Les directions à l'impératif : « Allez tout droit. Tournez à gauche au feu. Tournez à droite après la boulangerie. »", "La distance : « C'est près. C'est à cinq minutes à pied. »"), examples = listOf(ExampleLine(text = "Pardon, où est la gare ?", meaning = "Attirer l'attention."), ExampleLine(text = "Allez tout droit.", meaning = "Ne tournez pas."), ExampleLine(text = "Tournez à gauche au feu.", meaning = "Le carrefour."), ExampleLine(text = "C'est à cinq minutes à pied.", meaning = "La distance à pied."), ExampleLine(text = "C'est près de la boulangerie.", meaning = "Un lieu connu pour situer."))), expressions = listOf(TargetExpression(text = "Comment y aller ?", meaning = "Demander le chemin.", note = "y = à ce lieu."), TargetExpression(text = "Allez tout droit.", meaning = "La direction.", note = "tout droit = en ligne."), TargetExpression(text = "Tournez à gauche / à droite.", meaning = "Le carrefour.", note = "au feu, après la banque."), TargetExpression(text = "à … minutes à pied", meaning = "La distance.", note = "à cinq minutes à pied."), TargetExpression(text = "C'est près / loin.", meaning = "Près ou loin.", note = "près = à côté.")), situation = "Un touriste vous demande la gare : tout droit, à gauche au feu — cinq minutes à pied, c'est près.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Un inconnu vous arrête. Demandez la gare.", expected = listOf("Pardon, où est la gare ?", "Où est la gare, s'il vous plaît ?", "Ou est la gare, s'il vous plait ?"), focus = "où est", watch = "où est + lieu ?"), PracticeQuestion(prompt = "Guidez quelqu'un : la rue continue tout droit. Employez l'impératif.", expected = listOf("Allez tout droit.", "Vous allez tout droit."), focus = "tout droit", watch = "impératif : allez (vous)."), PracticeQuestion(prompt = "Guidez : le carrefour est à votre main gauche. Employez l'impératif.", expected = listOf("Tournez à gauche.", "Tournez à gauche au feu.", "Tournez a gauche au feu."), focus = "à gauche", watch = "à gauche / à droite."), PracticeQuestion(prompt = "La gare ? Comptez cinq minutes en marchant. Dites-le.", expected = listOf("C'est à cinq minutes à pied.", "C'est a cinq minutes a pied.", "La gare est à cinq minutes à pied."), focus = "à pied", watch = "à pied = en marchant."), PracticeQuestion(prompt = "La pharmacie est vraiment proche. Dites-le avec un mot.", expected = listOf("C'est près.", "C'est tout près.", "C'est pres."), focus = "près", watch = "près / loin."))), exercises = listOf(Exercise(id = "fr-foundations-u11-directions-e1", kind = "choice", prompt = "Pour aller à la gare : ___ tout droit.", options = listOf("Allez", "Aller", "Allons", "Allez-vous"), answers = listOf("Allez"), explain = "impératif avec vous : allez."), Exercise(id = "fr-foundations-u11-directions-e2", kind = "gap", prompt = "Tournez ___ gauche après la boulangerie.", options = listOf(), answers = listOf("à", "a"), explain = "à gauche / à droite."), Exercise(id = "fr-foundations-u11-directions-e3", kind = "order", prompt = "Guidez quelqu'un jusqu'au feu.", options = listOf(), answers = listOf("Allez tout droit jusqu'au feu"), explain = "allez + direction + jusqu'au + lieu."), Exercise(id = "fr-foundations-u11-directions-e4", kind = "written", prompt = "La pharmacie ? Comptez cinq minutes en marchant.", options = listOf(), answers = listOf("c'est à cinq minutes à pied", "c est a cinq minutes a pied", "elle est à cinq minutes à pied"), explain = "c'est à + minutes + à pied.")), skills = listOf("function:ask-for-directions", "vocab:directions", "grammar:present-simple", "vocab:town"), canDo = listOf("ask-for-directions"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u11-fruitier", title = "Chez le primeur", goal = "Acheter des fruits au primeur du quartier : quantités et prix.", intro = LessonIntro(explanation = listOf("Au primeur, on commande avec la quantité : « Je voudrais un kilo de pommes. Deux cents grammes de fraises. »", "Le vendeur propose : « Vous désirez ? Avec ceci ? » On répond : « C'est tout, merci. »", "Le prix : « C'est combien, les fraises ? » — « Ça fait trois euros. »"), examples = listOf(ExampleLine(text = "Bonjour, je voudrais un kilo de pommes.", meaning = "La commande."), ExampleLine(text = "Je prends aussi deux bananes.", meaning = "Ajouter un article."), ExampleLine(text = "C'est combien, les fraises ?", meaning = "Le prix."), ExampleLine(text = "Avec ceci ?", meaning = "Le vendeur propose."), ExampleLine(text = "Ça fait trois euros.", meaning = "Le total."))), expressions = listOf(TargetExpression(text = "Je voudrais + quantité", meaning = "Commander.", note = "un kilo de pommes."), TargetExpression(text = "Je prends …", meaning = "Choisir.", note = "Je prends deux bananes."), TargetExpression(text = "C'est combien, … ?", meaning = "Le prix.", note = "…les fraises ?"), TargetExpression(text = "Avec ceci ?", meaning = "Le vendeur propose.", note = "= autre chose ?"), TargetExpression(text = "C'est tout, merci.", meaning = "Terminer l'achat.", note = "= rien d'autre.")), situation = "Samedi matin, chez le primeur du quartier : un kilo de pommes, deux bananes — et vous demandez le prix des fraises.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Commandez un kilo de pommes.", expected = listOf("Je voudrais un kilo de pommes.", "Un kilo de pommes, s'il vous plaît.", "Un kilo de pommes, s'il vous plait."), focus = "je voudrais", watch = "je voudrais + quantité + produit."), PracticeQuestion(prompt = "Demandez le prix des fraises.", expected = listOf("C'est combien, les fraises ?", "C'est combien les fraises ?"), focus = "combien", watch = "c'est combien + article + fruit."), PracticeQuestion(prompt = "Ajoutez deux bananes à votre commande.", expected = listOf("Je prends deux bananes.", "Et deux bananes, aussi."), focus = "je prends", watch = "je prends = je choisis."), PracticeQuestion(prompt = "Le vendeur propose encore quelque chose. Refusez poliment.", expected = listOf("C'est tout, merci.", "C'est tout merci.", "Rien d'autre, merci."), focus = "c'est tout", watch = "= je ne veux rien d'autre."), PracticeQuestion(prompt = "Dites le total : trois euros.", expected = listOf("Ça fait trois euros.", "Ca fait trois euros."), focus = "ça fait", watch = "ça fait + prix."))), exercises = listOf(Exercise(id = "fr-foundations-u11-fruitier-e1", kind = "choice", prompt = "Bonjour, madame, je ___ un kilo de pommes, s'il vous plaît.", options = listOf("voudrais", "vouloir", "voudra", "voulu"), answers = listOf("voudrais"), explain = "je voudrais : la forme polie de vouloir."), Exercise(id = "fr-foundations-u11-fruitier-e2", kind = "gap", prompt = "C'est ___ , les fraises ?", options = listOf(), answers = listOf("combien"), explain = "c'est combien = demandez le prix."), Exercise(id = "fr-foundations-u11-fruitier-e3", kind = "order", prompt = "Commandez deux bananes.", options = listOf(), answers = listOf("Je voudrais deux bananes"), explain = "je voudrais + quantité + fruit."), Exercise(id = "fr-foundations-u11-fruitier-e4", kind = "written", prompt = "Refusez poliment la proposition du vendeur.", options = listOf(), answers = listOf("c'est tout merci", "c'est tout, merci.", "rien d'autre, merci."), explain = "formule fixe pour terminer.")), skills = listOf("function:go-shopping", "grammar:quantities", "vocab:food", "grammar:present-simple"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple"))))
}

object FrFoundationsU12 {
    val unit = CourseUnit(id = "fr-foundations-u12", title = "Ma tribu", subtitle = "Famille et amis", level = "A1", themes = listOf(ConversationTheme("photos-de-famille", "Les photos de famille", "Mon, ma, mes", "figure-2", "Course", "Vous montrez les photos : mon père, ma sœur, mes cousins — et vous parlez de votre oncle à Marseille.", 0),
                ConversationTheme("les-copains", "Les copains", "Il est sympa", "heart", "Course", "Au café, vous décrivez vos amis : Léa est timide mais très gentille, Karim est travailleur — et vous faites un appel.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u12-famille", title = "Ma famille", goal = "Présenter ta famille : mon père, ma sœur, mes parents — et dire que tu as un oncle.", intro = LessonIntro(explanation = listOf("La famille : « Voici mon père, ma mère, mon frère et ma sœur. Mes grands-parents sont à Nice. »", "mon + masculin (mon oncle), ma + féminin (ma tante), mes + pluriel (mes parents) : « Mes parents habitent à Lyon. »", "Pour dire que la famille existe, on utilise avoir : « J'ai un oncle à Marseille. Tu as une tante ? »"), examples = listOf(ExampleLine(text = "Voici mon père et ma mère.", meaning = "Les parents."), ExampleLine(text = "Ma sœur s'appelle Léa.", meaning = "ma + féminin."), ExampleLine(text = "Mes frères sont sportifs.", meaning = "mes + pluriel."), ExampleLine(text = "J'ai un oncle à Marseille.", meaning = "avoir : j'ai + un."), ExampleLine(text = "Tu as des cousins ?", meaning = "La question avec avoir."))), expressions = listOf(TargetExpression(text = "mon / ma / mes", meaning = "À qui est la chose.", note = "mon oncle, ma tante, mes cousins."), TargetExpression(text = "les grands-parents", meaning = "Le grand-père et la grand-mère.", note = "mamie et papi, c'est familier."), TargetExpression(text = "J'ai un / une …", meaning = "Dire la famille.", note = "J'ai un frère et une sœur."), TargetExpression(text = "un oncle / une tante", meaning = "Le frère ou la sœur des parents.", note = "Mon oncle Paul arrive dimanche."), TargetExpression(text = "les enfants", meaning = "Le fils et la fille.", note = "Mon oncle a deux enfants.")), situation = "Vous montrez les photos de la famille sur votre téléphone : mon père, ma sœur, mes grands-parents — et vous annoncez la visite de votre oncle Paul.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Présente ton père sur la photo.", expected = listOf("C'est mon père.", "C'est mon pere."), focus = "mon père", watch = "père = masculin : mon."), PracticeQuestion(prompt = "Ta sœur s'appelle Léa. Dis-le.", expected = listOf("Ma sœur s'appelle Léa.", "Ma soeur s'appelle Lea."), focus = "ma sœur", watch = "sœur = féminin : ma."), PracticeQuestion(prompt = "Tes parents habitent à Lyon. Dis-le.", expected = listOf("Mes parents habitent à Lyon.", "Mes parents habitent a Lyon."), focus = "mes", watch = "pluriel : mes."), PracticeQuestion(prompt = "Tu as un oncle à Marseille. Dis-le.", expected = listOf("J'ai un oncle à Marseille.", "J'ai un oncle a Marseille."), focus = "j'ai", watch = "avoir : j'ai + un/une."), PracticeQuestion(prompt = "Demande à un ami s'il a une tante.", expected = listOf("Tu as une tante ?", "Est-ce que tu as une tante ?"), focus = "tu as", watch = "question : est-ce que + tu as."))), exercises = listOf(Exercise(id = "fr-foundations-u12-famille-e1", kind = "choice", prompt = "___ sœur s'appelle Léa.", options = listOf("Ma", "Mon", "Mes", "Me"), answers = listOf("Ma"), explain = "sœur = féminin : ma."), Exercise(id = "fr-foundations-u12-famille-e2", kind = "gap", prompt = "J'ai ___ oncle à Marseille.", options = listOf(), answers = listOf("un"), explain = "oncle = masculin : un oncle."), Exercise(id = "fr-foundations-u12-famille-e3", kind = "order", prompt = "Présente tes grands-parents.", options = listOf(), answers = listOf("Mes grands-parents habitent à Lyon"), explain = "mes + nom + verbe + lieu."), Exercise(id = "fr-foundations-u12-famille-e4", kind = "written", prompt = "Dis que tu as un frère et une sœur.", options = listOf(), answers = listOf("j'ai un frère et une sœur", "j'ai un frere et une soeur", "j'ai un frère et une soeur"), explain = "avoir : j'ai + un/une + membre.")), skills = listOf("vocab:family", "grammar:possessives", "grammar:present-simple", "function:describe-people"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:possessives")),
    Lesson(id = "fr-foundations-u12-amis", title = "Il est comment ?", goal = "Décrire tes amis : sympa, timide, travailleur — et demander comment ils sont.", intro = LessonIntro(explanation = listOf("Pour demander le caractère : « Il est comment, ton frère ? » La réponse : « Il est sympa. »", "L'adjectif vient après être : « Léa est timide mais très gentille. » Timide est pareil pour les filles et les garçons.", "Attention au féminin : « Karim est travailleur, sa sœur est travailleuse. » Grand donne grande, petit donne petite."), examples = listOf(ExampleLine(text = "Il est comment, ton frère ?", meaning = "La question."), ExampleLine(text = "Mon frère est très sympa.", meaning = "Sympa = gentil."), ExampleLine(text = "Léa est timide.", meaning = "Timide : même forme."), ExampleLine(text = "Karim est travailleur.", meaning = "Il travaille beaucoup."), ExampleLine(text = "Ma sœur est travailleuse.", meaning = "Le féminin de travailleur."))), expressions = listOf(TargetExpression(text = "Il / Elle est comment ?", meaning = "Demander le caractère.", note = "Elle est comment, ta sœur ?"), TargetExpression(text = "être sympa", meaning = "Être gentil et agréable.", note = "Mes voisins sont très sympas."), TargetExpression(text = "être timide", meaning = "Ne pas parler beaucoup.", note = "Au début, il est timide."), TargetExpression(text = "être travailleur / travailleuse", meaning = "Travailler beaucoup.", note = "Léa est travailleuse."), TargetExpression(text = "être gentil / gentille", meaning = "Être aimable.", note = "Mon oncle est très gentil.")), situation = "Au café, vous parlez de vos amis : Léa est timide mais gentille, Karim est travailleur et très sympa — et vous demandez : il est comment, ton frère ?", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Demande comment est le frère de Léa.", expected = listOf("Il est comment, ton frère ?", "Il est comment, ton frere ?", "Ton frere, il est comment ?"), focus = "il est comment", watch = "être + comment."), PracticeQuestion(prompt = "Dis que ton ami est adorable, toujours à l'heure.", expected = listOf("Karim est très sympa.", "Karim est tres sympa."), focus = "sympa", watch = "il est + adjectif."), PracticeQuestion(prompt = "Léa ne parle pas beaucoup. Décris-la.", expected = listOf("Léa est timide.", "Lea est timide.", "Elle est timide."), focus = "timide", watch = "timide : pareil au féminin."), PracticeQuestion(prompt = "Dis que ta sœur travaille beaucoup.", expected = listOf("Ma sœur est travailleuse.", "Ma soeur est travailleuse."), focus = "travailleuse", watch = "travailleur donne travailleuse au féminin."), PracticeQuestion(prompt = "Dis que tes voisins sont gentils.", expected = listOf("Mes voisins sont gentils.", "Mes voisins sont très gentils.", "Mes voisins sont tres gentils."), focus = "gentils", watch = "pluriel : gentils ; féminin : gentilles."))), exercises = listOf(Exercise(id = "fr-foundations-u12-amis-e1", kind = "choice", prompt = "Léa ne parle pas beaucoup : elle est ___.", options = listOf("timide", "travailleuse", "sympa", "grande"), answers = listOf("timide"), explain = "timide = qui ne parle pas beaucoup."), Exercise(id = "fr-foundations-u12-amis-e2", kind = "gap", prompt = "Karim travaille beaucoup : il est ___.", options = listOf(), answers = listOf("travailleur"), explain = "il est travailleur ; elle est travailleuse."), Exercise(id = "fr-foundations-u12-amis-e3", kind = "order", prompt = "Décris Léa : très, gentille.", options = listOf(), answers = listOf("Léa est très gentille"), explain = "être + très + adjectif au féminin."), Exercise(id = "fr-foundations-u12-amis-e4", kind = "written", prompt = "Demande à un ami comment est sa sœur.", options = listOf(), answers = listOf("elle est comment, ta sœur ?", "elle est comment, ta soeur ?", "ta soeur, elle est comment ?"), explain = "elle est comment + la personne ?")), skills = listOf("function:describe-people", "grammar:present-simple", "vocab:feelings", "function:ask-simple-questions"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u12-appel", title = "Un appel", goal = "Téléphoner : allô, tu es là ? — et laisser un message : je rappelle plus tard.", intro = LessonIntro(explanation = listOf("Au téléphone, on commence par « Allô ? » puis on se présente : « Allô, c'est Léa. Tu es là ? »", "Pour demander une personne : « Il est là ? Elle est là ? » La réponse : « Non, elle n'est pas là, elle revient à six heures. »", "Pour la fin de l'appel : « Je rappelle plus tard » ou « Rappelle-moi ! » : vous appelez encore après."), examples = listOf(ExampleLine(text = "Allô ? C'est Léa.", meaning = "Le début de l'appel."), ExampleLine(text = "Tu es là ?", meaning = "Vérifier la personne."), ExampleLine(text = "Elle est là ?", meaning = "Demander une autre personne."), ExampleLine(text = "Non, elle n'est pas là.", meaning = "La réponse négative."), ExampleLine(text = "Je rappelle plus tard.", meaning = "Appeler encore après."))), expressions = listOf(TargetExpression(text = "Allô ?", meaning = "Répondre au téléphone.", note = "Allô, c'est mamie !"), TargetExpression(text = "C'est + prénom.", meaning = "Se présenter au téléphone.", note = "C'est Karim."), TargetExpression(text = "Il / Elle est là ?", meaning = "Demander une personne.", note = "Ta mère est là ?"), TargetExpression(text = "Je rappelle plus tard.", meaning = "Appeler encore après.", note = "Je suis au travail, je rappelle plus tard."), TargetExpression(text = "Rappelle-moi !", meaning = "Demander un rappel.", note = "Rappelle-moi ce soir !")), situation = "Vous appelez mamie : allô, c'est Léa, tu es là ? Maman n'est pas là, elle revient à six heures — alors vous rappelez plus tard.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Tu téléphones à mamie. Commence l'appel.", expected = listOf("Allô, c'est Léa.", "Allo, c'est Lea."), focus = "allô", watch = "allô : le mot du téléphone."), PracticeQuestion(prompt = "Demande à ton ami s'il est au téléphone.", expected = listOf("Tu es là ?", "Tu es la ?"), focus = "tu es là", watch = "là = ici, présent."), PracticeQuestion(prompt = "Demande si la mère de Léa est là.", expected = listOf("Elle est là, ta mère ?", "Elle est la, ta mere ?"), focus = "elle est là", watch = "elle pour une femme."), PracticeQuestion(prompt = "La personne n'est pas là. Dis-le.", expected = listOf("Elle n'est pas là.", "Elle n'est pas la."), focus = "n'est pas là", watch = "ne…pas : la négation."), PracticeQuestion(prompt = "Tu rappelles ce soir. Dis-le à mamie.", expected = listOf("Je rappelle plus tard.", "Je rappelle ce soir."), focus = "rappelle", watch = "re + appeler = rappeler."))), exercises = listOf(Exercise(id = "fr-foundations-u12-appel-e1", kind = "choice", prompt = "___ ? C'est Karim. Tu es là ?", options = listOf("Allô", "Bonjour", "Salut", "Voilà"), answers = listOf("Allô"), explain = "allô : le mot du téléphone."), Exercise(id = "fr-foundations-u12-appel-e2", kind = "gap", prompt = "Maman n'est pas là, elle revient à six heures. Je ___ plus tard.", options = listOf(), answers = listOf("rappelle"), explain = "rappeler = appeler encore."), Exercise(id = "fr-foundations-u12-appel-e3", kind = "order", prompt = "Tu veux un appel ce soir. Demande-le.", options = listOf(), answers = listOf("Rappelle-moi ce soir"), explain = "rappelle-moi + le moment."), Exercise(id = "fr-foundations-u12-appel-e4", kind = "written", prompt = "Tu appelles ta sœur. Elle n'est pas là. Laisse un message : tu rappelles plus tard.", options = listOf(), answers = listOf("je rappelle plus tard", "je te rappelle plus tard"), explain = "je rappelle plus tard : je rappelle après.")), skills = listOf("vocab:social-expressions", "grammar:present-questions", "function:ask-simple-questions", "grammar:present-simple"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:present-simple"))))
}

object FrFoundationsU13 {
    val unit = CourseUnit(id = "fr-foundations-u13", title = "Le temps", subtitle = "Jours et météo", level = "A1", themes = listOf(ConversationTheme("les-jours", "Les jours", "Toujours, souvent, jamais", "sun.max", "Course", "Du café du matin au dîner du soir : votre semaine, avec toujours, souvent, parfois et jamais.", 0),
                ConversationTheme("ciel-et-saisons", "Le ciel", "Il pleut, il fait beau", "cloud.rain", "Course", "Quel temps ! Vous regardez la météo et vous décidez : parc ou chocolat chaud ?", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u13-routine", title = "Du matin au soir", goal = "Raconter ta journée : le matin, l'après-midi, le soir — avec toujours, souvent, parfois, jamais.", intro = LessonIntro(explanation = listOf("Le présent raconte les habitudes : « Je prends mon café à sept heures. Je fais du sport le samedi. »", "Les adverbes de fréquence viennent après le verbe : « Je bois toujours un café. Je lis souvent le soir. »", "La négation avec jamais : « Je ne mange jamais de viande. » Et parfois, c'est quelquefois."), examples = listOf(ExampleLine(text = "Je prends mon café à sept heures.", meaning = "Le matin."), ExampleLine(text = "Je bois toujours un café.", meaning = "Tous les jours."), ExampleLine(text = "Je lis souvent le soir.", meaning = "Beaucoup de fois."), ExampleLine(text = "Parfois, je marche au parc.", meaning = "Quelquefois."), ExampleLine(text = "Je ne mange jamais de viande.", meaning = "Zéro fois : la négation."))), expressions = listOf(TargetExpression(text = "toujours", meaning = "Tous les jours.", note = "Je prends toujours mon café."), TargetExpression(text = "souvent", meaning = "Beaucoup de fois.", note = "Je lis souvent le soir."), TargetExpression(text = "parfois", meaning = "Quelquefois.", note = "Parfois, je regarde un film."), TargetExpression(text = "ne … jamais", meaning = "Jamais, zéro fois.", note = "Je ne sors jamais le dimanche."), TargetExpression(text = "le matin / le soir", meaning = "Les moments de la journée.", note = "Le matin, je travaille ; le soir, je lis.")), situation = "Une journée ordinaire : café à sept heures, travail le matin, lecture le soir — toujours, souvent, parfois, jamais.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dis ton habitude du matin : café, à sept heures.", expected = listOf("Je prends mon café à sept heures.", "Je prends mon cafe a sept heures."), focus = "le matin", watch = "le présent pour les habitudes."), PracticeQuestion(prompt = "Tu lis le soir, tous les jours. Utilise toujours.", expected = listOf("Je lis toujours le soir.", "Je lis toujours un livre le soir."), focus = "toujours", watch = "adverbe après le verbe."), PracticeQuestion(prompt = "Tu vas au parc, quelquefois. Utilise parfois.", expected = listOf("Parfois, je vais au parc.", "Je vais parfois au parc."), focus = "parfois", watch = "parfois = quelquefois."), PracticeQuestion(prompt = "Tu ne manges pas de viande. Utilise jamais.", expected = listOf("Je ne mange jamais de viande.", "Jamais de viande pour moi."), focus = "jamais", watch = "ne…jamais : la négation."), PracticeQuestion(prompt = "Tu travailles le samedi, beaucoup de fois. Utilise souvent.", expected = listOf("Je travaille souvent le samedi.", "Le samedi, je travaille souvent."), focus = "souvent", watch = "souvent = beaucoup de fois."))), exercises = listOf(Exercise(id = "fr-foundations-u13-routine-e1", kind = "choice", prompt = "Je ___ lis un livre le soir : tous les jours !", options = listOf("toujours", "souvent", "parfois", "jamais"), answers = listOf("toujours"), explain = "toujours = tous les jours."), Exercise(id = "fr-foundations-u13-routine-e2", kind = "gap", prompt = "Je ne mange ___ de viande.", options = listOf(), answers = listOf("jamais"), explain = "ne…jamais = zéro fois."), Exercise(id = "fr-foundations-u13-routine-e3", kind = "order", prompt = "Dis ton habitude : souvent, lire, le soir.", options = listOf(), answers = listOf("Je lis souvent le soir"), explain = "adverbe après le verbe."), Exercise(id = "fr-foundations-u13-routine-e4", kind = "written", prompt = "Dis ce que tu fais toujours le matin.", options = listOf(), answers = listOf("je prends toujours mon café", "je prends toujours mon cafe", "je lis toujours le matin"), explain = "toujours après le verbe.")), skills = listOf("grammar:frequency-adverbs", "function:talk-about-routines", "vocab:daily-routine", "grammar:present-simple"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u13-meteo", title = "Quel temps fait-il ?", goal = "Parler du ciel : il fait beau, il pleut — et des saisons : en été, en hiver.", intro = LessonIntro(explanation = listOf("La question : « Quel temps fait-il ? » La réponse avec il fait : « Il fait beau. Il fait chaud. Il fait froid. »", "La pluie et la neige : « Il pleut. Il neige. » Et le vent : « Il y a du vent. »", "Les saisons : « En été, il fait chaud. En hiver, il neige. » Mais au printemps, c'est en automne."), examples = listOf(ExampleLine(text = "Quel temps fait-il ?", meaning = "La question."), ExampleLine(text = "Il fait beau aujourd'hui.", meaning = "Il y a du soleil."), ExampleLine(text = "Il pleut, prends ton parapluie !", meaning = "Il y a de l'eau du ciel."), ExampleLine(text = "En hiver, il neige.", meaning = "La saison froide."), ExampleLine(text = "Aujourd'hui, il y a du vent.", meaning = "Le vent bouge les arbres."))), expressions = listOf(TargetExpression(text = "Quel temps fait-il ?", meaning = "Demander le temps.", note = "Quel temps fait-il demain ?"), TargetExpression(text = "Il fait beau / chaud / froid.", meaning = "Le temps avec il fait.", note = "En été, il fait chaud."), TargetExpression(text = "Il pleut / Il neige.", meaning = "L'eau et la neige.", note = "Il pleut sur Toulouse."), TargetExpression(text = "Il y a du vent.", meaning = "Le vent.", note = "Il y a du vent, ferme la fenêtre."), TargetExpression(text = "en été / en hiver", meaning = "Les saisons.", note = "En hiver, il fait froid ; au printemps, il fait doux.")), situation = "Quel temps ! Il fait beau, vous allez au parc ; il pleut, vous restez à la maison avec un chocolat chaud.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Demande le temps de demain.", expected = listOf("Quel temps fait-il demain ?", "Demain, quel temps fait-il ?"), focus = "quel temps", watch = "question figée : quel temps fait-il ?"), PracticeQuestion(prompt = "Il y a du soleil. Dis-le avec il fait.", expected = listOf("Il fait beau.", "Aujourd'hui, il fait beau."), focus = "il fait beau", watch = "il fait beau = il y a du soleil."), PracticeQuestion(prompt = "Il y a de l'eau du ciel. Dis-le.", expected = listOf("Il pleut.", "Il pleut beaucoup."), focus = "il pleut", watch = "pleuvoir : il pleut."), PracticeQuestion(prompt = "Tu es à Paris, en hiver : très froid. Dis-le avec il fait.", expected = listOf("En hiver, il fait très froid.", "En hiver, il fait tres froid."), focus = "en hiver", watch = "en + saison, mais au printemps."), PracticeQuestion(prompt = "Le vent bouge les arbres aujourd'hui. Dis-le.", expected = listOf("Il y a du vent.", "Il y a beaucoup de vent."), focus = "du vent", watch = "il y a du + nom."))), exercises = listOf(Exercise(id = "fr-foundations-u13-meteo-e1", kind = "choice", prompt = "___ temps fait-il ?", options = listOf("Quel", "Quelle", "Comment", "Qui"), answers = listOf("Quel"), explain = "quel temps fait-il ? : question figée."), Exercise(id = "fr-foundations-u13-meteo-e2", kind = "gap", prompt = "Il ___ : prends ton parapluie !", options = listOf(), answers = listOf("pleut"), explain = "il pleut = il y a de l'eau."), Exercise(id = "fr-foundations-u13-meteo-e3", kind = "order", prompt = "Décris l'été.", options = listOf(), answers = listOf("En été il fait très chaud"), explain = "en + saison + il fait + adjectif."), Exercise(id = "fr-foundations-u13-meteo-e4", kind = "written", prompt = "Tu es à Paris en hiver. Dis le temps : froid.", options = listOf(), answers = listOf("il fait froid", "il fait très froid", "il fait tres froid"), explain = "il fait + froid : le temps.")), skills = listOf("function:talk-about-weather", "vocab:weather", "grammar:present-simple", "function:ask-simple-questions"), canDo = listOf("talk-about-weather"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u13-envies", title = "Ce que j'aime", goal = "Dire tes goûts : j'aime la musique, j'aime lire — et demander : et toi ?", intro = LessonIntro(explanation = listOf("J'aime + nom : « J'aime le vélo. J'adore la musique. »", "J'aime + verbe à l'infinitif : « J'aime lire. J'aime faire du sport. »", "La négation : « Je n'aime pas cuisiner. » Pour demander : « Tu aimes le foot ? Et toi ? »"), examples = listOf(ExampleLine(text = "J'aime le vélo.", meaning = "aimer + nom."), ExampleLine(text = "J'adore la musique.", meaning = "Aimer beaucoup."), ExampleLine(text = "J'aime lire le soir.", meaning = "aimer + infinitif."), ExampleLine(text = "Je n'aime pas cuisiner.", meaning = "La négation."), ExampleLine(text = "Tu aimes le foot ? Et toi ?", meaning = "La question au groupe."))), expressions = listOf(TargetExpression(text = "j'aime + nom", meaning = "Les goûts.", note = "J'aime les crêpes."), TargetExpression(text = "j'aime + infinitif", meaning = "Les activités.", note = "J'aime nager."), TargetExpression(text = "j'adore …", meaning = "J'aime beaucoup.", note = "J'adore le chocolat."), TargetExpression(text = "je n'aime pas …", meaning = "Le dégoût.", note = "Je n'aime pas la pluie."), TargetExpression(text = "Et toi ?", meaning = "Rendre la question.", note = "J'aime lire. Et toi ?")), situation = "Chacun ses goûts : Léa aime le vélo, Karim adore lire, Mai aime faire des crêpes — et vous, qu'est-ce que vous aimez ?", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dis ton goût : la musique, beaucoup.", expected = listOf("J'adore la musique.", "J'aime beaucoup la musique."), focus = "j'adore", watch = "j'adore = j'aime beaucoup."), PracticeQuestion(prompt = "Dis ton activité : lire, le soir.", expected = listOf("J'aime lire le soir.", "J'aime lire."), focus = "j'aime lire", watch = "aimer + verbe à l'infinitif."), PracticeQuestion(prompt = "Tu ne veux pas cuisiner. Dis-le avec aimer.", expected = listOf("Je n'aime pas cuisiner.", "Je n'aime pas la cuisine."), focus = "je n'aime pas", watch = "ne…pas après j'aime."), PracticeQuestion(prompt = "Demande à Karim s'il aime le foot.", expected = listOf("Tu aimes le foot ?", "Est-ce que tu aimes le foot ?"), focus = "tu aimes", watch = "est-ce que pour la question."), PracticeQuestion(prompt = "Rends la question à ton ami.", expected = listOf("Et toi ?", "Et vous ?"), focus = "et toi", watch = "et toi = à toi de répondre."))), exercises = listOf(Exercise(id = "fr-foundations-u13-envies-e1", kind = "choice", prompt = "J'___ le chocolat : c'est trop bon !", options = listOf("adore", "adore pas", "déteste", "oublie"), answers = listOf("adore"), explain = "j'adore = j'aime beaucoup."), Exercise(id = "fr-foundations-u13-envies-e2", kind = "gap", prompt = "J'aime ___ du vélo le samedi.", options = listOf(), answers = listOf("faire"), explain = "aimer + infinitif : faire du vélo."), Exercise(id = "fr-foundations-u13-envies-e3", kind = "order", prompt = "Dis ton goût : la pluie, non.", options = listOf(), answers = listOf("Je n'aime pas la pluie"), explain = "ne…pas + aimer + nom."), Exercise(id = "fr-foundations-u13-envies-e4", kind = "written", prompt = "Dis une activité que tu aimes.", options = listOf(), answers = listOf("j'aime lire le soir", "j'aime faire du vélo", "j'aime faire du velo", "j'aime lire"), explain = "j'aime + verbe à l'infinitif.")), skills = listOf("vocab:hobbies", "grammar:present-simple", "function:talk-about-routines", "vocab:social-expressions"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple"))))
}

object FrFoundationsU14 {
    val unit = CourseUnit(id = "fr-foundations-u14", title = "En mouvement", subtitle = "Métro, bus et train", level = "A1", themes = listOf(ConversationTheme("metro-et-bus", "Le métro et le bus", "Je prends le métro", "bus", "Course", "Chaque matin, vous prenez le métro à la station République — et un ami vous demande : comment tu vas au centre-ville ?", 0),
                ConversationTheme("le-train", "Le train", "Un billet, s'il vous plaît", "tram", "Course", "À la gare, vous lisez les horaires : le train part à sept heures et demie — et au guichet, vous demandez un billet pour Lyon.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u14-transport", title = "Comment j'y vais", goal = "Parler de tes transports du quotidien : je prends le métro, je prends le bus — ou je vais à pied.", intro = LessonIntro(explanation = listOf("Pour dire comment tu vas quelque part, on utilise prendre : « Je prends le métro. » « Je prends le bus numéro 12. »", "On peut aussi aller à pied : « Je vais au travail à pied. » À pied = je marche.", "Pour demander le moyen : « Tu vas au bureau en bus ? » ou « Comment tu vas au centre-ville ? »"), examples = listOf(ExampleLine(text = "Je prends le métro tous les jours.", meaning = "Le métro du quotidien."), ExampleLine(text = "Je prends le bus à la gare.", meaning = "Prendre le bus."), ExampleLine(text = "Je vais au travail à pied.", meaning = "À pied = je marche."), ExampleLine(text = "Tu vas au bureau en bus ?", meaning = "La question avec est-ce que ou non."), ExampleLine(text = "Comment tu vas au centre-ville ?", meaning = "Demander le moyen."))), expressions = listOf(TargetExpression(text = "prendre le métro / le bus", meaning = "Utiliser un transport.", note = "Je prends le métro à République."), TargetExpression(text = "à pied", meaning = "Marcher.", note = "Je vais à la piscine à pied."), TargetExpression(text = "en bus / en métro", meaning = "Dire le moyen.", note = "Je vais en bus, pas en métro."), TargetExpression(text = "la station / l'arrêt", meaning = "Où prendre le métro / le bus.", note = "L'arrêt de bus est là."), TargetExpression(text = "Comment tu vas … ?", meaning = "Demander le moyen.", note = "Comment tu vas au travail ?")), situation = "Chaque matin, vous prenez le métro à la station République avec le bus numéro 12 pour les grands jours — et un ami vous demande : comment tu vas au centre-ville ?", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dis que tu prends le métro.", expected = listOf("Je prends le métro.", "Je prends le metro.", "Je prends toujours le métro."), focus = "prendre le métro", watch = "avec je : je prends."), PracticeQuestion(prompt = "Dis que tu vas au travail à pied.", expected = listOf("Je vais au travail à pied.", "Je vais au travail a pied.", "Je vais à pied au travail."), focus = "à pied", watch = "à pied = je marche."), PracticeQuestion(prompt = "Demande à un ami s'il va au bureau en bus.", expected = listOf("Tu vas au bureau en bus ?", "Est-ce que tu vas au bureau en bus ?"), focus = "en bus", watch = "question : est-ce que + tu vas."), PracticeQuestion(prompt = "Demande comment un ami va au centre-ville.", expected = listOf("Comment tu vas au centre-ville ?", "Tu vas au centre-ville comment ?"), focus = "comment", watch = "comment + tu vas."), PracticeQuestion(prompt = "Dis que tu prends le bus à la gare.", expected = listOf("Je prends le bus à la gare.", "Je prends le bus a la gare.", "Je prends le bus, à la gare."), focus = "à la gare", watch = "à = le lieu."))), exercises = listOf(Exercise(id = "fr-foundations-u14-transport-e1", kind = "choice", prompt = "Je ___ le bus numéro 12.", options = listOf("prends", "prend", "prendre", "vais"), answers = listOf("prends"), explain = "Avec je : je prends le bus."), Exercise(id = "fr-foundations-u14-transport-e2", kind = "gap", prompt = "Je vais au travail ___ pied.", options = listOf(), answers = listOf("à", "a"), explain = "à pied = je marche."), Exercise(id = "fr-foundations-u14-transport-e3", kind = "order", prompt = "Dis que le métro est ton transport, chaque jour.", options = listOf(), answers = listOf("Je prends le métro tous les jours"), explain = "je prends + le métro + le moment."), Exercise(id = "fr-foundations-u14-transport-e4", kind = "written", prompt = "Et toi ? Dis comment tu vas au centre-ville : tu vas en métro.", options = listOf(), answers = listOf("je vais au centre-ville en métro", "je vais au centre-ville en metro", "je prends le métro pour aller au centre-ville"), explain = "aller en métro : le moyen de transport.")), skills = listOf("vocab:transport", "grammar:present-simple", "function:ask-simple-questions", "vocab:town"), canDo = listOf("use-transport"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u14-horaires", title = "Ça part à quelle heure ?", goal = "Lire les horaires et dire l'heure : le train part à sept heures et demie, le bus arrive à neuf heures et quart.", intro = LessonIntro(explanation = listOf("Pour demander l'heure : « Il est quelle heure ? » Pour le départ : « Ça part à quelle heure ? » La réponse : « Ça part à sept heures. »", "Les minutes faciles : « et quart » = 15 minutes après, « et demie » = 30 minutes après. 7 h 30 = sept heures et demie.", "Pour les horaires, on utilise partir et arriver : « Le bus part à huit heures. Le métro arrive à neuf heures et quart. »"), examples = listOf(ExampleLine(text = "Il est quelle heure ?", meaning = "Demander l'heure."), ExampleLine(text = "Il est huit heures.", meaning = "Dire l'heure."), ExampleLine(text = "Ça part à quelle heure ?", meaning = "Demander le départ."), ExampleLine(text = "Le train part à sept heures et demie.", meaning = "7 h 30 : et demie."), ExampleLine(text = "Le bus arrive à neuf heures et quart.", meaning = "9 h 15 : et quart."))), expressions = listOf(TargetExpression(text = "Il est quelle heure ?", meaning = "Demander l'heure.", note = "Il est quelle heure ? — Il est midi."), TargetExpression(text = "à + heure", meaning = "Le moment du départ.", note = "Le bus part à huit heures."), TargetExpression(text = "et demie", meaning = "30 minutes après.", note = "À sept heures et demie (7 h 30)."), TargetExpression(text = "et quart", meaning = "15 minutes après.", note = "À neuf heures et quart (9 h 15)."), TargetExpression(text = "partir / arriver", meaning = "Le départ et l'arrivée.", note = "Le train part, il arrive à Lyon.")), situation = "À la gare, vous lisez les horaires : le train part à sept heures et demie, le bus arrive à neuf heures et quart.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Demande l'heure à un ami.", expected = listOf("Il est quelle heure ?", "Quelle heure est-il ?"), focus = "quelle heure", watch = "Il est + quelle heure ?"), PracticeQuestion(prompt = "Demande à quelle heure part le train.", expected = listOf("Le train part à quelle heure ?", "Le train part a quelle heure ?", "Ça part à quelle heure ?"), focus = "à quelle heure", watch = "à + quelle heure."), PracticeQuestion(prompt = "Dis que le train part à sept heures et demie.", expected = listOf("Le train part à sept heures et demie.", "Le train part a sept heures et demie.", "Il part à sept heures et demie."), focus = "et demie", watch = "7 h 30 = et demie."), PracticeQuestion(prompt = "Dis que le bus arrive à neuf heures et quart.", expected = listOf("Le bus arrive à neuf heures et quart.", "Le bus arrive a neuf heures et quart."), focus = "et quart", watch = "9 h 15 = et quart."), PracticeQuestion(prompt = "Dis que le métro arrive à six heures.", expected = listOf("Le métro arrive à six heures.", "Le metro arrive a six heures.", "Il arrive à six heures."), focus = "arrive", watch = "arriver à + heure."))), exercises = listOf(Exercise(id = "fr-foundations-u14-horaires-e1", kind = "choice", prompt = "Il est 7 h 30 : sept heures et ___.", options = listOf("demie", "quart", "midi", "minuit"), answers = listOf("demie"), explain = "30 minutes après : et demie."), Exercise(id = "fr-foundations-u14-horaires-e2", kind = "gap", prompt = "Le bus arrive ___ neuf heures et quart.", options = listOf(), answers = listOf("à", "a"), explain = "à + heure : le moment."), Exercise(id = "fr-foundations-u14-horaires-e3", kind = "order", prompt = "Il est 7 h 30 et le train part. Dis-le.", options = listOf(), answers = listOf("Le train part à sept heures et demie"), explain = "partir à + l'heure."), Exercise(id = "fr-foundations-u14-horaires-e4", kind = "written", prompt = "Demande à un ami à quelle heure part le bus.", options = listOf(), answers = listOf("le bus part à quelle heure", "le bus part a quelle heure", "ça part à quelle heure", "ca part a quelle heure"), explain = "partir à quelle heure ? : la question.")), skills = listOf("function:tell-time", "vocab:transport", "grammar:present-questions", "grammar:present-simple"), canDo = listOf("tell-time"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u14-billet", title = "Un billet, s'il vous plaît", goal = "Acheter des billets : un billet pour Lyon, aller-retour — et demander le prix.", intro = LessonIntro(explanation = listOf("Pour acheter un billet, on dit la destination après pour : « Un billet pour Lyon, s'il vous plaît. »", "Aller simple = seulement l'aller. Aller-retour = aller et revenir : « Un aller-retour, s'il vous plaît. »", "Pour le prix : « Ça coûte combien ? » La réponse : « Ça coûte douze euros. » On demande aussi : « Combien de bagages ? »"), examples = listOf(ExampleLine(text = "Un billet pour Lyon, s'il vous plaît.", meaning = "La demande polie."), ExampleLine(text = "Aller-retour, s'il vous plaît.", meaning = "Aller et revenir."), ExampleLine(text = "Un aller simple pour Paris.", meaning = "Seulement l'aller."), ExampleLine(text = "Ça coûte combien ?", meaning = "Demander le prix."), ExampleLine(text = "Ça coûte douze euros.", meaning = "Le prix."))), expressions = listOf(TargetExpression(text = "un billet pour + ville", meaning = "Le billet de destination.", note = "Un billet pour Marseille."), TargetExpression(text = "aller simple / aller-retour", meaning = "Un trajet ou deux.", note = "Je prends un aller-retour."), TargetExpression(text = "s'il vous plaît", meaning = "La formule polie.", note = "Un billet, s'il vous plaît."), TargetExpression(text = "Ça coûte combien ?", meaning = "Demander le prix.", note = "Ça coûte combien, le billet ?"), TargetExpression(text = "combien de + quantité", meaning = "La quantité.", note = "Combien de bagages ?")), situation = "Au guichet de la gare, vous demandez : un billet pour Lyon, s'il vous plaît, aller-retour — et vous demandez le prix.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Demande un billet pour Paris.", expected = listOf("Un billet pour Paris, s'il vous plaît.", "Je voudrais un billet pour Paris."), focus = "un billet pour", watch = "poli : s'il vous plaît."), PracticeQuestion(prompt = "Demande un billet aller-retour.", expected = listOf("Un aller-retour, s'il vous plaît.", "Je voudrais un aller-retour."), focus = "aller-retour", watch = "aller et revenir."), PracticeQuestion(prompt = "Demande le prix du billet.", expected = listOf("Ça coûte combien ?", "C'est combien ?", "Ça coûte combien, le billet ?"), focus = "combien", watch = "ça coûte combien ?"), PracticeQuestion(prompt = "Dis que le billet coûte douze euros.", expected = listOf("Ça coûte douze euros.", "C'est douze euros."), focus = "coûter", watch = "ça coûte + le prix."), PracticeQuestion(prompt = "Demande au vendeur combien de bagages tu peux prendre.", expected = listOf("Combien de bagages ?", "Combien de bagages je peux prendre ?"), focus = "combien de", watch = "de après combien."))), exercises = listOf(Exercise(id = "fr-foundations-u14-billet-e1", kind = "choice", prompt = "Je voudrais un billet ___ Lyon, s'il vous plaît.", options = listOf("pour", "à", "en", "de"), answers = listOf("pour"), explain = "pour + la destination : pour Lyon."), Exercise(id = "fr-foundations-u14-billet-e2", kind = "gap", prompt = "Un aller-___, s'il vous plaît. Je reviens ce soir.", options = listOf(), answers = listOf("retour"), explain = "aller-retour = aller et revenir."), Exercise(id = "fr-foundations-u14-billet-e3", kind = "order", prompt = "Demande le prix, poliment.", options = listOf(), answers = listOf("Ça coûte combien"), explain = "ça coûte + combien : le prix."), Exercise(id = "fr-foundations-u14-billet-e4", kind = "written", prompt = "Au guichet : demande un billet pour Lyon, poliment.", options = listOf(), answers = listOf("un billet pour lyon, s'il vous plaît", "un billet pour lyon s'il vous plait", "je voudrais un billet pour lyon"), explain = "un billet pour + ville + s'il vous plaît.")), skills = listOf("function:go-shopping", "function:make-requests", "vocab:transport", "grammar:quantities"), canDo = listOf("use-transport"), prerequisites = listOf("grammar:present-simple"))))
}

object FrFoundationsU15 {
    val unit = CourseUnit(id = "fr-foundations-u15", title = "Je me sens bien", subtitle = "Santé de base", level = "A1", themes = listOf(ConversationTheme("pas-en-forme", "Je ne me sens pas bien", "J'ai mal à la tête", "cross.case", "Course", "Vous êtes malade : j'ai mal à la tête et j'ai de la fièvre — un ami demande : ça va ?", 0),
                ConversationTheme("la-pharmacie", "À la pharmacie", "Quelque chose pour la douleur", "pills", "Course", "À la pharmacie, vous demandez quelque chose pour la tête — et vous demandez : combien de fois par jour ?", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u15-symptomes", title = "Je ne me sens pas bien", goal = "Dire tes symptômes : j'ai mal à la tête, j'ai de la fièvre — et demander : ça va ?", intro = LessonIntro(explanation = listOf("Pour dire que tu n'es pas en forme : « Je ne me sens pas bien. » On dit aussi : « Je suis malade. »", "La douleur avec avoir mal à : « J'ai mal à la tête. » « J'ai mal au ventre. » à la (féminin), au (masculin).", "Autres symptômes avec avoir : « J'ai de la fièvre. » « Je suis fatigué. » Pour demander : « Ça va ? Tu es malade ? »"), examples = listOf(ExampleLine(text = "Je ne me sens pas bien.", meaning = "Être malade."), ExampleLine(text = "J'ai mal à la tête.", meaning = "La tête fait mal."), ExampleLine(text = "J'ai mal au ventre.", meaning = "à + le = au."), ExampleLine(text = "J'ai de la fièvre.", meaning = "38 °C, c'est la fièvre."), ExampleLine(text = "Tu es malade ?", meaning = "La question."))), expressions = listOf(TargetExpression(text = "avoir mal à la tête / au ventre", meaning = "Dire la douleur.", note = "à la (féminin), au (masculin)."), TargetExpression(text = "avoir de la fièvre", meaning = "Être chaud, malade.", note = "J'ai 38 de fièvre."), TargetExpression(text = "être malade", meaning = "Ne pas être en forme.", note = "Il est malade, il reste au lit."), TargetExpression(text = "être fatigué / fatiguée", meaning = "Ne pas avoir d'énergie.", note = "Je suis très fatiguée."), TargetExpression(text = "Ça va ?", meaning = "Demander la santé.", note = "Ça va ? — Non, je suis malade.")), situation = "Vous êtes malade : je ne me sens pas bien, j'ai mal à la tête et j'ai de la fièvre — un ami demande : ça va ?", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dis que tu ne te sens pas bien.", expected = listOf("Je ne me sens pas bien.", "Je suis malade."), focus = "ne…pas", watch = "négation : ne me sens pas."), PracticeQuestion(prompt = "Dis que tu as mal à la tête.", expected = listOf("J'ai mal à la tête.", "J'ai mal a la tete.", "J'ai très mal à la tête."), focus = "mal à la tête", watch = "à la + féminin : la tête."), PracticeQuestion(prompt = "Dis que tu as de la fièvre.", expected = listOf("J'ai de la fièvre.", "J'ai de la fievre.", "J'ai beaucoup de fièvre."), focus = "fièvre", watch = "avoir de la + fièvre."), PracticeQuestion(prompt = "Dis que tu as mal au ventre.", expected = listOf("J'ai mal au ventre.", "J'ai très mal au ventre."), focus = "mal au ventre", watch = "à + le = au."), PracticeQuestion(prompt = "Demande à un ami s'il va bien.", expected = listOf("Ça va ?", "Tu vas bien ?", "Ça va, tu es malade ?"), focus = "ça va", watch = "question rapide : ça va ?"))), exercises = listOf(Exercise(id = "fr-foundations-u15-symptomes-e1", kind = "choice", prompt = "J'ai ___ à la tête.", options = listOf("mal", "bien", "froid", "peur"), answers = listOf("mal"), explain = "avoir mal à : la douleur."), Exercise(id = "fr-foundations-u15-symptomes-e2", kind = "gap", prompt = "J'ai mal ___ ventre.", options = listOf(), answers = listOf("au"), explain = "à + le = au : au ventre."), Exercise(id = "fr-foundations-u15-symptomes-e3", kind = "order", prompt = "Tu as 38 °C. Dis-le avec la fièvre.", options = listOf(), answers = listOf("J'ai de la fièvre"), explain = "avoir de la fièvre : le symptôme."), Exercise(id = "fr-foundations-u15-symptomes-e4", kind = "written", prompt = "Dis deux choses : tu es malade et tu as mal à la tête.", options = listOf(), answers = listOf("je suis malade et j'ai mal à la tête", "je suis malade et j'ai mal a la tete", "je ne me sens pas bien et j'ai mal à la tête"), explain = "être malade + avoir mal à : les symptômes.")), skills = listOf("function:talk-about-health", "vocab:health", "grammar:present-simple", "function:ask-simple-questions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u15-pharmacie", title = "À la pharmacie", goal = "Demander quelque chose pour la douleur à la pharmacie — et comprendre combien de fois par jour.", intro = LessonIntro(explanation = listOf("À la pharmacie, on demande : « Bonjour, quelque chose pour la tête, s'il vous plaît. » On dit le problème après pour.", "Le pharmacien demande : « Vous avez une ordonnance ? » La réponse : « Non, je n'ai pas d'ordonnance. » Une ordonnance = le papier du docteur.", "La posologie : « Combien de fois par jour ? » La réponse : « Deux fois par jour, matin et soir. »"), examples = listOf(ExampleLine(text = "Bonjour, je voudrais quelque chose pour la tête.", meaning = "La demande."), ExampleLine(text = "Vous avez une ordonnance ?", meaning = "La question du pharmacien."), ExampleLine(text = "Non, je n'ai pas d'ordonnance.", meaning = "La réponse négative."), ExampleLine(text = "Combien de fois par jour ?", meaning = "La posologie."), ExampleLine(text = "Deux fois par jour, matin et soir.", meaning = "La réponse."))), expressions = listOf(TargetExpression(text = "quelque chose pour…", meaning = "Demander un médicament.", note = "Quelque chose pour la gorge ?"), TargetExpression(text = "une ordonnance", meaning = "Le papier du docteur.", note = "Vous avez une ordonnance ?"), TargetExpression(text = "des comprimés / un sirop", meaning = "Le médicament.", note = "Un sirop pour la toux."), TargetExpression(text = "deux fois par jour", meaning = "La quantité du jour.", note = "Deux fois par jour, matin et soir."), TargetExpression(text = "Je voudrais…", meaning = "Demander poliment.", note = "Je voudrais quelque chose pour dormir.")), situation = "À la pharmacie, vous demandez quelque chose pour la tête. Le pharmacien demande une ordonnance — non — et vous demandez : combien de fois par jour ?", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Demande quelque chose pour la tête, à la pharmacie.", expected = listOf("Quelque chose pour la tête, s'il vous plaît.", "Quelque chose pour la tete, s'il vous plait."), focus = "quelque chose pour", watch = "pour + le problème."), PracticeQuestion(prompt = "Le pharmacien demande une ordonnance. Réponds : non.", expected = listOf("Non, je n'ai pas d'ordonnance.", "Je n'ai pas d'ordonnance."), focus = "pas d'ordonnance", watch = "ne…pas de : pas d'ordonnance."), PracticeQuestion(prompt = "Demande combien de fois par jour tu prends le médicament.", expected = listOf("Combien de fois par jour ?", "Je le prends combien de fois par jour ?"), focus = "combien de fois", watch = "fois : la fréquence."), PracticeQuestion(prompt = "Dis que tu prends deux comprimés par jour.", expected = listOf("Je prends deux comprimés par jour.", "Deux fois par jour, matin et soir."), focus = "deux fois", watch = "deux fois par jour."), PracticeQuestion(prompt = "Demande poliment quelque chose pour dormir.", expected = listOf("Je voudrais quelque chose pour dormir.", "Quelque chose pour dormir, s'il vous plaît."), focus = "je voudrais", watch = "je voudrais = poli."))), exercises = listOf(Exercise(id = "fr-foundations-u15-pharmacie-e1", kind = "choice", prompt = "Quelque chose ___ la gorge, s'il vous plaît.", options = listOf("pour", "à", "au", "de"), answers = listOf("pour"), explain = "pour + le problème de santé."), Exercise(id = "fr-foundations-u15-pharmacie-e2", kind = "gap", prompt = "Vous avez une ___ ? — Non, je n'ai pas.", options = listOf(), answers = listOf("ordonnance"), explain = "une ordonnance : le papier du docteur."), Exercise(id = "fr-foundations-u15-pharmacie-e3", kind = "order", prompt = "Demande la posologie.", options = listOf(), answers = listOf("Combien de fois par jour"), explain = "combien de fois par jour : la fréquence."), Exercise(id = "fr-foundations-u15-pharmacie-e4", kind = "written", prompt = "À la pharmacie : demande quelque chose pour la tête.", options = listOf(), answers = listOf("quelque chose pour la tête, s'il vous plaît", "quelque chose pour la tete s'il vous plait", "je voudrais quelque chose pour la tête"), explain = "quelque chose pour + la douleur.")), skills = listOf("function:go-shopping", "vocab:health", "function:make-requests", "grammar:present-simple"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u15-habitudes", title = "Une vie saine", goal = "Parler de tes habitudes avec toujours et jamais : je bois toujours de l'eau, je ne fume jamais.", intro = LessonIntro(explanation = listOf("Toujours = 100 % du temps : « Je bois toujours de l'eau. » Jamais = 0 % : « Je ne fume jamais. »", "Position : toujours et jamais viennent après le verbe : « Je mange toujours des fruits. » « Je ne dors jamais tard. »", "Les bonnes habitudes : « Je fais du sport le matin, je dors huit heures. » Pour demander : « Tu fais du sport ? »"), examples = listOf(ExampleLine(text = "Je bois toujours de l'eau.", meaning = "Tous les jours."), ExampleLine(text = "Je ne fume jamais.", meaning = "Zéro cigarettes."), ExampleLine(text = "Je mange toujours des fruits.", meaning = "après le verbe."), ExampleLine(text = "Je ne dors jamais tard.", meaning = "ne…jamais."), ExampleLine(text = "Je fais du sport le matin.", meaning = "La bonne habitude."))), expressions = listOf(TargetExpression(text = "toujours", meaning = "100 % du temps.", note = "Je bois toujours de l'eau."), TargetExpression(text = "ne…jamais", meaning = "0 % du temps.", note = "Je ne fume jamais."), TargetExpression(text = "faire du sport", meaning = "Bouger le corps.", note = "Je fais du sport deux fois par semaine."), TargetExpression(text = "dormir huit heures", meaning = "Bien dormir.", note = "Je dors huit heures par nuit."), TargetExpression(text = "être en forme", meaning = "Être en bonne santé.", note = "Je mange des fruits et je marche : je suis en forme.")), situation = "Vous parlez de votre vie saine : vous buvez toujours de l'eau, vous ne fumez jamais — et vous dormez huit heures.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dis que tu bois toujours de l'eau.", expected = listOf("Je bois toujours de l'eau.", "Je bois de l'eau tous les jours."), focus = "toujours", watch = "toujours après le verbe."), PracticeQuestion(prompt = "Dis que tu ne fumes jamais.", expected = listOf("Je ne fume jamais.", "Non, je ne fume jamais."), focus = "ne…jamais", watch = "ne + verbe + jamais."), PracticeQuestion(prompt = "Dis que tu manges toujours des fruits.", expected = listOf("Je mange toujours des fruits.", "Je mange toujours des fruits frais."), focus = "toujours", watch = "toujours après le verbe."), PracticeQuestion(prompt = "Dis que tu ne dors jamais tard.", expected = listOf("Je ne dors jamais tard.", "Je me couche toujours tôt."), focus = "jamais", watch = "ne…jamais + tard."), PracticeQuestion(prompt = "Demande à un ami s'il fait du sport.", expected = listOf("Tu fais du sport ?", "Est-ce que tu fais du sport ?"), focus = "faire du sport", watch = "question : est-ce que + tu fais."))), exercises = listOf(Exercise(id = "fr-foundations-u15-habitudes-e1", kind = "choice", prompt = "À chaque repas, je bois de l'eau : je ___ bois !", options = listOf("toujours", "jamais", "souvent", "peu"), answers = listOf("toujours"), explain = "toujours = tous les jours, 100 %."), Exercise(id = "fr-foundations-u15-habitudes-e2", kind = "gap", prompt = "Je ne fume ___, c'est mauvais pour la santé.", options = listOf(), answers = listOf("jamais"), explain = "ne…jamais = 0 %."), Exercise(id = "fr-foundations-u15-habitudes-e3", kind = "order", prompt = "Bonne habitude : le sport, chaque matin. Dis-le.", options = listOf(), answers = listOf("Je fais du sport le matin"), explain = "faire du sport + le moment."), Exercise(id = "fr-foundations-u15-habitudes-e4", kind = "written", prompt = "Donne deux bonnes habitudes avec toujours et jamais.", options = listOf(), answers = listOf("je bois toujours de l'eau et je ne fume jamais", "je bois toujours de l'eau, je ne fume jamais", "je bois toujours de l'eau et je ne fume jamais !"), explain = "toujours + jamais : deux habitudes saines.")), skills = listOf("grammar:frequency-adverbs", "function:talk-about-routines", "vocab:health", "vocab:daily-routine"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:frequency-adverbs"))))
}

object FrFoundationsU16 {
    val unit = CourseUnit(id = "fr-foundations-u16", title = "À table", subtitle = "Manger dehors", level = "A1", themes = listOf(ConversationTheme("au-restaurant", "Au restaurant", "Commander", "fork.knife", "Course", "Vous déjeunez en terrasse avec Léa : le serveur arrive, vous demandez une table, puis chacun commande plat et boisson.", 0),
                ConversationTheme("carte-et-addition", "La carte et l'addition", "Plats, boissons, pourboire", "takeout.bag", "Course", "Vous lisez la carte, vous demandez ce qu'il y a dans les plats, puis vous payez et laissez un petit pourboire.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u16-restaurant", title = "Au restaurant", goal = "Commander un plat et une boisson au restaurant avec je voudrais et je prends.", intro = LessonIntro(explanation = listOf("Pour commander poliment, on dit « je voudrais » : « Je voudrais le menu, s'il vous plaît. »", "« Je prends » marche aussi : « Je prends une quiche. » Et pour demander : « Vous avez une table pour deux ? »", "Le serveur relance : « Et comme boisson ? » On répond simplement : « Une eau gazeuse. »"), examples = listOf(ExampleLine(text = "Je voudrais le menu, s'il vous plaît.", meaning = "Commander poliment."), ExampleLine(text = "Je prends une quiche lorraine.", meaning = "Commander avec prendre."), ExampleLine(text = "Vous avez une table pour deux ?", meaning = "Demander une table."), ExampleLine(text = "Et comme boisson ?", meaning = "Le serveur relance."), ExampleLine(text = "Pour moi, une eau gazeuse.", meaning = "Commander pour quelqu'un."))), expressions = listOf(TargetExpression(text = "je voudrais + plat", meaning = "Commander poliment.", note = "Je voudrais une quiche."), TargetExpression(text = "je prends + plat", meaning = "Commander simplement.", note = "Je prends le menu."), TargetExpression(text = "Vous avez … ?", meaning = "Demander ce qui existe.", note = "Vous avez une terrasse ?"), TargetExpression(text = "et comme boisson ?", meaning = "Le serveur relance.", note = "Un jus d'orange."), TargetExpression(text = "une table pour deux", meaning = "Le nombre de personnes.", note = "pour trois, pour quatre.")), situation = "Vous êtes en terrasse avec Léa : le serveur arrive, vous demandez une table pour deux, puis chacun commande plat et boisson.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Demandez poliment le menu.", expected = listOf("Je voudrais le menu, s'il vous plaît.", "Je voudrais le menu", "Je voudrais le menu, s'il vous plait"), focus = "je voudrais", watch = "voudrais = vouloir, version polie."), PracticeQuestion(prompt = "Commandez la quiche avec le verbe prendre.", expected = listOf("Je prends la quiche.", "Je prends la quiche lorraine."), focus = "je prends", watch = "je prends, avec un s."), PracticeQuestion(prompt = "Demandez au serveur une table pour deux.", expected = listOf("Vous avez une table pour deux ?", "Une table pour deux, s'il vous plaît ?"), focus = "vous avez", watch = "question simple : vous avez … ?"), PracticeQuestion(prompt = "Le serveur demande la boisson : répondez (eau gazeuse).", expected = listOf("Une eau gazeuse.", "Pour moi, une eau gazeuse."), focus = "comme boisson", watch = "on peut enlever le verbe."), PracticeQuestion(prompt = "Dites ce que Léa commande : le poulet.", expected = listOf("Elle prend le poulet.", "Léa prend le poulet.", "Elle voudrait le poulet."), focus = "elle prend", watch = "elle prend, comme je prends."))), exercises = listOf(Exercise(id = "fr-foundations-u16-restaurant-e1", kind = "choice", prompt = "Le serveur demande : « Vous voulez ? » Tu réponds poliment : « ___ une quiche, s'il vous plaît. »", options = listOf("Je voudrais", "Je suis", "J'ai", "Je vais"), answers = listOf("Je voudrais"), explain = "Je voudrais = je veux, mais plus poli : la formule du restaurant."), Exercise(id = "fr-foundations-u16-restaurant-e2", kind = "gap", prompt = "Je ___ le menu du jour. (verbe : prendre)", options = listOf(), answers = listOf("prends"), explain = "Je prends : prendre à la 1re personne, avec un s."), Exercise(id = "fr-foundations-u16-restaurant-e3", kind = "order", prompt = "Commandez une table pour deux, poliment.", options = listOf(), answers = listOf("Vous avez une table pour deux"), explain = "Vous avez + nom : la question simple du restaurant."), Exercise(id = "fr-foundations-u16-restaurant-e4", kind = "written", prompt = "Tu veux un café. Dis-le au serveur.", options = listOf(), answers = listOf("je voudrais un café", "je voudrais un cafe", "je prends un café", "je prends un cafe"), explain = "Je voudrais ou je prends + boisson : on commande.")), skills = listOf("function:order-food", "vocab:food", "grammar:present-simple", "function:ask-simple-questions"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u16-menu", title = "La carte", goal = "Lire la carte : plats et boissons, et demander ce qu'il y a dans un plat.", intro = LessonIntro(explanation = listOf("La carte liste les plats : entrée, plat, dessert — et les boissons : eau, jus, café.", "Pour connaître les ingrédients : « Qu'est-ce qu'il y a dans la quiche ? »", "On répond avec il y a : « Il y a des œufs, du fromage et des lardons. »"), examples = listOf(ExampleLine(text = "Qu'est-ce qu'il y a dans la quiche ?", meaning = "Demander les ingrédients."), ExampleLine(text = "Il y a des tomates et du fromage.", meaning = "La réponse avec il y a."), ExampleLine(text = "Je voudrais une carafe d'eau.", meaning = "L'eau du robinet, gratuite."), ExampleLine(text = "Comme dessert, il y a une tarte aux pommes.", meaning = "Le dessert du jour."), ExampleLine(text = "Vous avez un plat sans viande ?", meaning = "Demander autre chose."))), expressions = listOf(TargetExpression(text = "qu'est-ce qu'il y a dans … ?", meaning = "Demander les ingrédients.", note = "…dans la soupe ?"), TargetExpression(text = "il y a du / de la / des", meaning = "Les ingrédients.", note = "du pain, de la salade, des frites."), TargetExpression(text = "une carafe d'eau", meaning = "L'eau gratuite.", note = "on la demande sans payer."), TargetExpression(text = "l'entrée / le plat / le dessert", meaning = "Les trois services.", note = "on choisit sur la carte."), TargetExpression(text = "sans viande", meaning = "Végétarien.", note = "un plat sans viande.")), situation = "Vous lisez la carte : qu'est-ce qu'il y a dans la soupe ? Et dans le sandwich ? Vous demandez, le serveur répond.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Demandez ce qu'il y a dans la soupe.", expected = listOf("Qu'est-ce qu'il y a dans la soupe ?", "Qu'est-ce qu'il y a dans la soupe"), focus = "qu'est-ce qu'il y a", watch = "question figée pour les ingrédients."), PracticeQuestion(prompt = "Répondez : tomates et fromage.", expected = listOf("Il y a des tomates et du fromage.", "Dans la salade, il y a des tomates et du fromage."), focus = "il y a", watch = "du + masculin, de la + féminin, des + pluriel."), PracticeQuestion(prompt = "Demandez de l'eau du robinet.", expected = listOf("Une carafe d'eau, s'il vous plaît.", "Je voudrais une carafe d'eau."), focus = "carafe d'eau", watch = "la carafe est gratuite."), PracticeQuestion(prompt = "Le dessert est la tarte aux pommes. Dites-le.", expected = listOf("Comme dessert, il y a une tarte aux pommes.", "Il y a une tarte aux pommes comme dessert."), focus = "le dessert", watch = "comme dessert introduit."), PracticeQuestion(prompt = "Vous ne mangez pas de viande. Demandez un plat adapté.", expected = listOf("Vous avez un plat sans viande ?", "Il y a un plat sans viande ?"), focus = "sans viande", watch = "sans + nom, sans article."))), exercises = listOf(Exercise(id = "fr-foundations-u16-menu-e1", kind = "choice", prompt = "« ___ qu'il y a dans la soupe ? »", options = listOf("Qu'est-ce", "Que est-ce", "Quel est-ce", "Quoi"), answers = listOf("Qu'est-ce"), explain = "Qu'est-ce qu'il y a : la question pour connaître les ingrédients."), Exercise(id = "fr-foundations-u16-menu-e2", kind = "gap", prompt = "Il y a ___ fromage dans la quiche. (article + masculin)", options = listOf(), answers = listOf("du"), explain = "Du fromage : l'article partitif au masculin."), Exercise(id = "fr-foundations-u16-menu-e3", kind = "order", prompt = "Demandez les ingrédients de la quiche.", options = listOf(), answers = listOf("Qu'est-ce qu'il y a dans la quiche"), explain = "Qu'est-ce qu'il y a dans + plat : la question type."), Exercise(id = "fr-foundations-u16-menu-e4", kind = "written", prompt = "Dites ce qu'il y a dans la salade : tomates et fromage.", options = listOf(), answers = listOf("il y a des tomates et du fromage", "dans la salade, il y a des tomates et du fromage"), explain = "Il y a + du / de la / des + ingrédient.")), skills = listOf("function:order-food", "vocab:food", "grammar:present-questions", "grammar:present-simple"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u16-addition", title = "L'addition", goal = "Payer : demander l'addition, le total, et laisser un petit pourboire.", intro = LessonIntro(explanation = listOf("Pour payer : « L'addition, s'il vous plaît. » C'est la phrase magique de la fin du repas.", "On paye ensemble ou séparément : « On paye ensemble. » « On paye séparément. »", "Le pourboire est petit en France : « Gardez la monnaie. » = un petit merci pour le serveur."), examples = listOf(ExampleLine(text = "L'addition, s'il vous plaît.", meaning = "Demander à payer."), ExampleLine(text = "On paye séparément.", meaning = "Chacun sa part."), ExampleLine(text = "Vous acceptez la carte ?", meaning = "Payer par carte."), ExampleLine(text = "Ça fait combien ?", meaning = "Demander le prix total."), ExampleLine(text = "Gardez la monnaie.", meaning = "Laisser un pourboire."))), expressions = listOf(TargetExpression(text = "l'addition, s'il vous plaît", meaning = "Payer.", note = "la fin du repas."), TargetExpression(text = "on paye ensemble / séparément", meaning = "La façon de payer.", note = "ensemble = tous les deux."), TargetExpression(text = "ça fait combien ?", meaning = "Le total.", note = "Ça fait 24 euros."), TargetExpression(text = "par carte / en espèces", meaning = "Le moyen de paiement.", note = "carte = CB."), TargetExpression(text = "gardez la monnaie", meaning = "Le pourboire.", note = "un petit merci.")), situation = "Le repas est fini : vous demandez l'addition, le total, vous payez par carte et vous laissez la monnaie au serveur.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Le repas est fini. Demandez la note.", expected = listOf("L'addition, s'il vous plaît.", "L'addition, s'il vous plait"), focus = "l'addition", watch = "l'addition = la note."), PracticeQuestion(prompt = "Vous payez chacun de votre côté. Dites-le.", expected = listOf("On paye séparément.", "On paie séparément."), focus = "séparément", watch = "deux orthographes : paye / paie."), PracticeQuestion(prompt = "Demandez le prix total.", expected = listOf("Ça fait combien ?", "C'est combien ?"), focus = "ça fait combien", watch = "ça fait + prix."), PracticeQuestion(prompt = "Demandez si vous pouvez payer par CB.", expected = listOf("Vous acceptez la carte ?", "Je peux payer par carte ?"), focus = "par carte", watch = "carte = CB."), PracticeQuestion(prompt = "Le serveur rend 3 euros. Laissez-les en pourboire.", expected = listOf("Gardez la monnaie.", "Gardez la monnaie, merci !"), focus = "le pourboire", watch = "gardez = pour vous."))), exercises = listOf(Exercise(id = "fr-foundations-u16-addition-e1", kind = "choice", prompt = "« ___, s'il vous plaît ! » Tu veux payer et partir.", options = listOf("L'addition", "La commande", "La carte", "La table"), answers = listOf("L'addition"), explain = "L'addition = la note qu'on demande à la fin du repas."), Exercise(id = "fr-foundations-u16-addition-e2", kind = "gap", prompt = "On paye ___ : chacun sa part. (contraire d'ensemble)", options = listOf(), answers = listOf("séparément", "separement"), explain = "On paye séparément : chacun paye sa part."), Exercise(id = "fr-foundations-u16-addition-e3", kind = "order", prompt = "Demandez le prix total au serveur.", options = listOf(), answers = listOf("Ça fait combien"), explain = "Ça fait combien ? : le total, simplement."), Exercise(id = "fr-foundations-u16-addition-e4", kind = "written", prompt = "Le serveur rend la monnaie : dis-lui de la garder.", options = listOf(), answers = listOf("gardez la monnaie", "gardez la monnaie, merci"), explain = "Gardez la monnaie : un petit pourboire pour le serveur.")), skills = listOf("function:order-food", "grammar:quantities", "vocab:food", "vocab:social-expressions"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple"))))
}

object FrFoundationsU19 {
    val unit = CourseUnit(id = "fr-foundations-u19", title = "Une visite", subtitle = "Chez des amis", level = "A1", themes = listOf(ConversationTheme("chez-l-hote", "Chez l'hôte", "Entrer, offrir", "door.left.open", "Course", "Vous arrivez chez Léa pour le dîner : vous demandez à entrer, vous laissez votre manteau et vous apportez un petit quelque chose.", 0),
                ConversationTheme("l-adieu", "L'adieu", "Merci et à la prochaine", "gift", "Course", "La soirée se termine : vous remerciez pour le repas, vous complimentez le gâteau et chacun rentre avec un à la prochaine !", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u19-visite", title = "Je peux entrer ?", goal = "Demander la permission avec je peux : entrer, laisser son manteau, aider en cuisine.", intro = LessonIntro(explanation = listOf("Pour demander la permission, on dit « je peux » : « Je peux entrer ? » — court, simple et poli.", "La version complète avec est-ce que monte le ton : « Est-ce que je peux laisser mon manteau ici ? »", "Avec « on peut », on demande pour le groupe : « On peut s'asseoir ici ? » Et pour aider : « Je peux t'aider en cuisine ? »"), examples = listOf(ExampleLine(text = "Je peux entrer ?", meaning = "Demander la permission."), ExampleLine(text = "Oui, bien sûr, entre !", meaning = "Répondre oui à l'invité."), ExampleLine(text = "Est-ce que je peux laisser mon manteau ici ?", meaning = "La question complète et polie."), ExampleLine(text = "On peut s'asseoir ici ?", meaning = "Demander pour le groupe."), ExampleLine(text = "Je peux t'aider en cuisine ?", meaning = "Offrir son aide."))), expressions = listOf(TargetExpression(text = "je peux + infinitif ?", meaning = "Demander la permission.", note = "Je peux entrer ?"), TargetExpression(text = "est-ce que je peux… ?", meaning = "La version complète.", note = "…laisser mon manteau ?"), TargetExpression(text = "oui, bien sûr !", meaning = "Accorder.", note = "Bien sûr, entre !"), TargetExpression(text = "je peux t'aider ?", meaning = "Offrir son aide.", note = "…en cuisine ?"), TargetExpression(text = "mets-toi à l'aise", meaning = "L'hôte accueille.", note = "l'invité se sent bien.")), situation = "Vous sonnez chez Léa pour le dîner : elle ouvre, vous demandez à entrer, vous laissez votre manteau et vous proposez votre aide en cuisine.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Tu sonnes chez Léa. Demande la permission d'entrer.", expected = listOf("Je peux entrer ?", "Je peux entrer"), focus = "je peux", watch = "question courte, sans est-ce que, à l'oral."), PracticeQuestion(prompt = "Demande poliment (forme complète) si tu peux laisser ton manteau.", expected = listOf("Est-ce que je peux laisser mon manteau ?", "Est-ce que je peux laisser mon manteau ici ?"), focus = "est-ce que", watch = "est-ce que garde la porte ouverte, c'est poli."), PracticeQuestion(prompt = "Le canapé est libre : demande la permission de t'asseoir.", expected = listOf("On peut s'asseoir ici ?", "Je peux m'asseoir ici ?"), focus = "on peut", watch = "on peut demande pour tout le groupe."), PracticeQuestion(prompt = "Propose ton aide pour la cuisine.", expected = listOf("Je peux t'aider en cuisine ?", "Je peux aider ?"), focus = "je peux t'aider", watch = "t' = à la personne qui reçoit."), PracticeQuestion(prompt = "L'hôte ouvre la porte : qu'est-ce qu'il dit pour te mettre à l'aise ?", expected = listOf("Mets-toi à l'aise !", "Mets-toi à l'aise"), focus = "mets-toi à l'aise", watch = "c'est l'hôte qui le dit."))), exercises = listOf(Exercise(id = "fr-foundations-u19-visite-e1", kind = "choice", prompt = "Tu es sur le pas de la porte. Tu demandes : « ___ entrer ? »", options = listOf("Je peux", "Je vais", "Je veux", "Je dois"), answers = listOf("Je peux"), explain = "Je peux + infinitif : la demande de permission la plus simple."), Exercise(id = "fr-foundations-u19-visite-e2", kind = "gap", prompt = "Est-ce que je ___ t'aider en cuisine ? (verbe : pouvoir)", options = listOf(), answers = listOf("peux"), explain = "Je peux : pouvoir à la 1re personne du singulier."), Exercise(id = "fr-foundations-u19-visite-e3", kind = "order", prompt = "Demande la permission d'entrer.", options = listOf(), answers = listOf("Je peux entrer"), explain = "Je peux + infinitif : la question de l'invité qui arrive."), Exercise(id = "fr-foundations-u19-visite-e4", kind = "written", prompt = "Tu proposes ton aide pour la cuisine.", options = listOf(), answers = listOf("je peux t'aider en cuisine", "je peux aider", "je peux aider en cuisine"), explain = "Je peux t'aider ? : on propose son aide avec je peux.")), skills = listOf("grammar:can", "function:make-requests", "vocab:social-expressions", "grammar:present-simple"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u19-attention", title = "J'apporte un petit quelque chose", goal = "Offrir aux hôtes et accepter poliment : j'apporte…, vous voulez… ?, volontiers !", intro = LessonIntro(explanation = listOf("On n'arrive jamais les mains vides : « J'apporte des fleurs. » « J'apporte un petit quelque chose pour le café. »", "L'hôte offre avec vous voulez : « Vous voulez un café ? » On accepte : « Volontiers ! » « Avec plaisir. »", "Pour refuser sans froisser, on ajoute merci : « Non merci. » — le merci adoucit le non."), examples = listOf(ExampleLine(text = "J'apporte un petit quelque chose.", meaning = "Le geste de l'invité."), ExampleLine(text = "Voici des fleurs pour vous.", meaning = "Offrir son cadeau."), ExampleLine(text = "Vous voulez un café ?", meaning = "L'hôte propose."), ExampleLine(text = "Volontiers, merci !", meaning = "Accepter chaleureusement."), ExampleLine(text = "Non merci, c'est très bon.", meaning = "Refuser gentiment."))), expressions = listOf(TargetExpression(text = "j'apporte + quelque chose", meaning = "Ce que l'invité apporte.", note = "des fleurs, un dessert."), TargetExpression(text = "vous voulez + quelque chose ?", meaning = "L'hôte offre.", note = "Vous voulez un café ?"), TargetExpression(text = "volontiers !", meaning = "Accepter.", note = "Volontiers, avec plaisir."), TargetExpression(text = "non, merci", meaning = "Refuser gentiment.", note = "merci adoucit le refus."), TargetExpression(text = "servez-vous", meaning = "L'hôte invite à goûter.", note = "le plat est au centre.")), situation = "Vous arrivez chez Léa avec des chocolats : elle vous propose un café, puis un morceau de gâteau — vous acceptez le café, vous refusez gentiment le deuxième morceau.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dites ce que vous apportez : un gâteau.", expected = listOf("J'apporte un gâteau.", "J'apporte un gâteau."), focus = "j'apporte", watch = "présent : j'apporte, tu apportes."), PracticeQuestion(prompt = "Offrez les fleurs à Léa.", expected = listOf("Voici des fleurs pour vous.", "Des fleurs pour toi."), focus = "voici", watch = "voici + cadeau = j'offre."), PracticeQuestion(prompt = "Léa propose un café : acceptez.", expected = listOf("Volontiers !", "Oui, avec plaisir !"), focus = "volontiers", watch = "l'acceptation polie et courte."), PracticeQuestion(prompt = "Elle propose un deuxième morceau : refusez gentiment.", expected = listOf("Non merci, c'est très bon.", "Non, merci."), focus = "non merci", watch = "le merci garde le sourire."), PracticeQuestion(prompt = "Le plat arrive : qu'est-ce que l'hôte dit ?", expected = listOf("Servez-vous !", "Servez-vous"), focus = "servez-vous", watch = "l'hôte invite tout le monde."))), exercises = listOf(Exercise(id = "fr-foundations-u19-attention-e1", kind = "choice", prompt = "« ___ un petit quelque chose pour le café. » (tu arrives avec un dessert)", options = listOf("J'apporte", "Je prends", "Je mets", "Je vais"), answers = listOf("J'apporte"), explain = "J'apporte : le présent de ce que l'invité apporte."), Exercise(id = "fr-foundations-u19-attention-e2", kind = "gap", prompt = "Vous ___ un café ? (verbe : vouloir, l'hôte propose)", options = listOf(), answers = listOf("voulez"), explain = "Vous voulez + nom : l'offre de l'hôte."), Exercise(id = "fr-foundations-u19-attention-e3", kind = "order", prompt = "L'hôte propose un café. Acceptez chaleureusement.", options = listOf(), answers = listOf("Oui je veux bien"), explain = "Oui, je veux bien : on accepte simplement et poliment."), Exercise(id = "fr-foundations-u19-attention-e4", kind = "written", prompt = "Léa propose du gâteau. Tu ne veux plus. Refuse gentiment.", options = listOf(), answers = listOf("non merci", "non, merci", "non merci c'est très bon"), explain = "Non, merci : le merci adoucit le refus.")), skills = listOf("function:make-requests", "vocab:food", "vocab:social-expressions", "function:order-food"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u19-adieu", title = "À la prochaine", goal = "Remercier les hôtes et se dire au revoir : merci pour tout, on remet ça samedi ?", intro = LessonIntro(explanation = listOf("Le grand merci de la fin : « Merci pour tout, Léa ! » Et on complimente : « Le gâteau est délicieux ! »", "Pour la prochaine fois, une question suffit : « On remet ça samedi ? » — on remet ça = on recommence.", "Les adieux légers : « Bonne nuit ! » « À la prochaine ! » « À bientôt ! »"), examples = listOf(ExampleLine(text = "Merci pour tout, Léa !", meaning = "Remercier pour la soirée."), ExampleLine(text = "Le gâteau est délicieux !", meaning = "Complimenter le repas."), ExampleLine(text = "On remet ça samedi ?", meaning = "Proposer la prochaine fois."), ExampleLine(text = "Bonne nuit ! Rentre bien !", meaning = "Les souhaits du départ."), ExampleLine(text = "À la prochaine !", meaning = "L'au revoir léger."))), expressions = listOf(TargetExpression(text = "merci pour tout", meaning = "Le grand merci.", note = "Merci pour tout, c'était parfait !"), TargetExpression(text = "c'est délicieux", meaning = "Complimenter le repas.", note = "Le gâteau est délicieux !"), TargetExpression(text = "on remet ça + quand ?", meaning = "Proposer la prochaine fois.", note = "On remet ça samedi ?"), TargetExpression(text = "bonne soirée / bonne nuit", meaning = "Le souhait du départ.", note = "selon l'heure."), TargetExpression(text = "à la prochaine !", meaning = "L'au revoir léger.", note = "à bientôt !")), situation = "La soirée se termine : vous remerciez Léa pour le repas, vous complimentez le gâteau, vous proposez samedi et vous vous dites à la prochaine !", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Remercie Léa pour toute la soirée.", expected = listOf("Merci pour tout !", "Merci pour tout"), focus = "merci pour tout", watch = "le merci qui résume la soirée."), PracticeQuestion(prompt = "Complimente le gâteau.", expected = listOf("Le gâteau est délicieux !", "C'est délicieux !"), focus = "délicieux", watch = "le présent pour complimenter."), PracticeQuestion(prompt = "Il est tard : formule le souhait du départ.", expected = listOf("Bonne nuit !", "Bonne nuit"), focus = "bonne nuit", watch = "bonne soirée avant minuit, bonne nuit après."), PracticeQuestion(prompt = "Propose de se revoir samedi.", expected = listOf("On remet ça samedi ?", "On remet ça samedi"), focus = "on remet ça", watch = "on remet ça = on recommence."), PracticeQuestion(prompt = "Termine avec l'au revoir léger.", expected = listOf("À la prochaine !", "À bientôt !"), focus = "à la prochaine", watch = "l'adieu qui promet une suite."))), exercises = listOf(Exercise(id = "fr-foundations-u19-adieu-e1", kind = "choice", prompt = "« Merci pour ___ ! » La soirée est finie.", options = listOf("tout", "tous", "toute", "toutes"), answers = listOf("tout"), explain = "Merci pour tout : la formule de fin de soirée."), Exercise(id = "fr-foundations-u19-adieu-e2", kind = "gap", prompt = "Le gâteau est ___ ! (très bon au goût)", options = listOf(), answers = listOf("délicieux", "delicieux"), explain = "Délicieux : le compliment classique pour un plat."), Exercise(id = "fr-foundations-u19-adieu-e3", kind = "order", prompt = "Souhaite une bonne soirée à tes hôtes.", options = listOf(), answers = listOf("Je vous souhaite une bonne soirée"), explain = "Souhaiter : je vous souhaite + le souhait."), Exercise(id = "fr-foundations-u19-adieu-e4", kind = "written", prompt = "Dis au revoir avec la formule légère.", options = listOf(), answers = listOf("à la prochaine", "a la prochaine", "à bientôt", "a bientôt"), explain = "À la prochaine ! : l'au revoir qui promet une suite.")), skills = listOf("vocab:social-expressions", "grammar:present-simple", "function:ask-simple-questions", "grammar:can"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple"))))
}

object FrFoundationsU22 {
    val unit = CourseUnit(id = "fr-foundations-u22", title = "On fête", subtitle = "Invitations et cadeaux", level = "A1", themes = listOf(ConversationTheme("l-invitation", "L'invitation", "Inviter, répondre", "party.popper", "Course", "L'anniversaire de Karim approche : il invite Léa pour samedi, elle accepte avec plaisir et demande l'heure.", 0),
                ConversationTheme("le-cadeau", "Le cadeau", "Idées et félicitations", "birthday.cake", "Course", "Quelle idée pour Mai ? On cherche ce qu'elle aime, on choisit le cadeau et à la fête, chacun fait ses vœux.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u22-fete", title = "Tu es libre samedi ?", goal = "Inviter un ami et répondre à une invitation : tu es libre samedi ? On fête mon anniversaire. Bonne idée !", intro = LessonIntro(explanation = listOf("On invite avec une question toute simple au présent : « Tu es libre samedi ? » — la porte est ouverte, l'autre répond oui ou non.", "Pour proposer, on utilise on : « On fête mon anniversaire chez moi. » — on = nous, plus léger et plus naturel à l'oral.", "On répond vite et simplement : « Bonne idée ! » « Avec plaisir ! » Et pour refuser : « Je suis désolé, je travaille samedi. »"), examples = listOf(ExampleLine(text = "Tu es libre samedi soir ?", meaning = "L'invitation simple."), ExampleLine(text = "On fête mon anniversaire chez moi.", meaning = "Proposer avec on."), ExampleLine(text = "Bonne idée ! J'apporte le dessert.", meaning = "Accepter et participer."), ExampleLine(text = "Avec plaisir !", meaning = "L'acceptation chaleureuse."), ExampleLine(text = "C'est à quelle heure ?", meaning = "Demander le détail."), ExampleLine(text = "Je suis désolé, je travaille samedi.", meaning = "Refuser poliment."))), expressions = listOf(TargetExpression(text = "tu es libre + quand ?", meaning = "L'invitation directe.", note = "Tu es libre demain soir ?"), TargetExpression(text = "on + présent ?", meaning = "Proposer une activité.", note = "On va au marché ?"), TargetExpression(text = "bonne idée !", meaning = "Accepter.", note = "Bonne idée, à samedi !"), TargetExpression(text = "avec plaisir", meaning = "Accepter chaleureusement.", note = "Avec plaisir, merci !"), TargetExpression(text = "je suis désolé(e) + raison", meaning = "Refuser poliment.", note = "Je suis désolée, je travaille."), TargetExpression(text = "c'est à quelle heure ?", meaning = "Demander l'heure.", note = "C'est à quelle heure exactement ?")), situation = "Karim invite Léa pour son anniversaire : il demande si elle est libre samedi, il propose la fête chez lui, elle accepte avec plaisir et demande l'heure.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Invite Léa : elle est libre samedi ?", expected = listOf("Tu es libre samedi ?", "Tu es libre samedi"), focus = "tu es libre", watch = "la question courte ouvre l'invitation."), PracticeQuestion(prompt = "Propose la fête : chez toi, samedi. (avec on)", expected = listOf("On fête mon anniversaire chez moi samedi.", "On fait une fête chez moi samedi."), focus = "on + présent", watch = "on = nous, plus naturel à l'oral."), PracticeQuestion(prompt = "Léa accepte avec enthousiasme.", expected = listOf("Bonne idée !", "Avec plaisir !", "Oui, avec plaisir !"), focus = "bonne idée", watch = "l'acceptation la plus simple."), PracticeQuestion(prompt = "Demande l'heure de la fête.", expected = listOf("C'est à quelle heure ?", "C'est à quelle heure, la fête ?"), focus = "à quelle heure", watch = "à + heure pour le rendez-vous."), PracticeQuestion(prompt = "Tu es occupé samedi : refuse poliment.", expected = listOf("Je suis désolé, je travaille samedi.", "Désolé, je ne peux pas.", "Je suis désolée, je travaille."), focus = "je suis désolé", watch = "désolé + la raison adoucit le non."))), exercises = listOf(Exercise(id = "fr-foundations-u22-fete-e1", kind = "choice", prompt = "« ___ libre samedi ? » (l'invitation)", options = listOf("Tu es", "Tu as", "Tu fais", "Tu vas"), answers = listOf("Tu es"), explain = "Être libre : tu es libre + le moment, l'invitation simple."), Exercise(id = "fr-foundations-u22-fete-e2", kind = "gap", prompt = "On ___ mon anniversaire chez moi samedi. (verbe : fêter)", options = listOf(), answers = listOf("fête", "fete"), explain = "On fête : fêter au présent avec on (comme il/elle)."), Exercise(id = "fr-foundations-u22-fete-e3", kind = "order", prompt = "Accepte l'invitation et propose ton dessert.", options = listOf(), answers = listOf("Bonne idée j'apporte le dessert"), explain = "Bonne idée + j'apporte : on accepte et on participe."), Exercise(id = "fr-foundations-u22-fete-e4", kind = "written", prompt = "Tu travailles samedi : refuse l'invitation poliment.", options = listOf(), answers = listOf("je suis désolé je travaille samedi", "desole je travaille samedi", "je suis desolee je travaille", "désolé je travaille samedi"), explain = "Je suis désolé + la raison : le refus poli.")), skills = listOf("vocab:social-expressions", "grammar:present-simple", "function:make-suggestions", "function:ask-simple-questions"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u22-cadeau", title = "Qu'est-ce qu'il aime ?", goal = "Chercher une idée de cadeau avec les questions en qu'est-ce que : Qu'est-ce qu'il aime ? Qu'est-ce que je peux offrir ?", intro = LessonIntro(explanation = listOf("Pour poser la question, qu'est-ce que vient en tête : « Qu'est-ce qu'il aime, Paul ? » — puis la réponse : « Il adore la musique. »", "Qu'est-ce que je peux + infinitif demande une idée : « Qu'est-ce que je peux lui offrir ? »", "Et on répond avec une suggestion : « Un livre, c'est une bonne idée. » — elle aime le chocolat ? Alors des chocolats !"), examples = listOf(ExampleLine(text = "Qu'est-ce qu'il aime ?", meaning = "La question qui guide le cadeau."), ExampleLine(text = "Il adore la musique.", meaning = "La réponse avec adorer."), ExampleLine(text = "Qu'est-ce que je peux lui offrir ?", meaning = "Demander une idée."), ExampleLine(text = "Elle collectionne les livres.", meaning = "L'indice utile."), ExampleLine(text = "Un livre, c'est une bonne idée.", meaning = "La suggestion simple."), ExampleLine(text = "Tu as une idée de cadeau ?", meaning = "Demander conseil."))), expressions = listOf(TargetExpression(text = "qu'est-ce que + personne + aime ?", meaning = "Trouver le goût.", note = "Qu'est-ce qu'elle aime ?"), TargetExpression(text = "qu'est-ce que je peux offrir ?", meaning = "Demander une idée.", note = "…lui offrir pour sa fête ?"), TargetExpression(text = "il/elle adore + nom", meaning = "L'indice fort.", note = "Elle adore le chocolat."), TargetExpression(text = "c'est une bonne idée", meaning = "Valider une suggestion.", note = "Un livre, c'est une bonne idée."), TargetExpression(text = "tu as une idée ?", meaning = "Demander conseil.", note = "Tu as une idée, toi ?"), TargetExpression(text = "lui + infinitif", meaning = "Offrir à la personne.", note = "je veux lui offrir un livre.")), situation = "L'anniversaire de Paul approche : avec Léa, vous cherchez l'idée — qu'est-ce qu'il aime, qu'est-ce que vous pouvez lui offrir, et le livre s'impose.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Demande à Léa ce que Paul aime.", expected = listOf("Qu'est-ce qu'il aime ?", "Qu'est-ce qu'il aime, Paul ?"), focus = "qu'est-ce que", watch = "qu'est-ce que + il aime : la question garde l'ordre affirmatif."), PracticeQuestion(prompt = "Dis que Paul adore la musique.", expected = listOf("Il adore la musique.", "Paul adore la musique."), focus = "adorer", watch = "adorer = aimer beaucoup."), PracticeQuestion(prompt = "Demande une idée : quoi offrir à Paul ?", expected = listOf("Qu'est-ce que je peux lui offrir ?", "Qu'est-ce que je peux offrir ?"), focus = "qu'est-ce que je peux", watch = "pouvoir + infinitif : la demande d'idée."), PracticeQuestion(prompt = "Propose le livre : c'est une bonne idée.", expected = listOf("Un livre, c'est une bonne idée.", "Le livre, c'est une bonne idée."), focus = "c'est une bonne idée", watch = "c'est + nom = la suggestion."), PracticeQuestion(prompt = "Demande conseil à Léa.", expected = listOf("Tu as une idée ?", "Tu as une idée de cadeau ?"), focus = "tu as une idée", watch = "avoir une idée : la question ouverte."))), exercises = listOf(Exercise(id = "fr-foundations-u22-cadeau-e1", kind = "choice", prompt = "« Qu'est-ce que je ___ lui offrir ? » (demander une idée)", options = listOf("peux", "veux", "dois", "vais"), answers = listOf("peux"), explain = "Pouvoir + infinitif : je peux lui offrir, la demande d'idée."), Exercise(id = "fr-foundations-u22-cadeau-e2", kind = "gap", prompt = "Il ___ la musique. (verbe : adorer)", options = listOf(), answers = listOf("adore"), explain = "Il adore : adorer au présent, il/elle + adore."), Exercise(id = "fr-foundations-u22-cadeau-e3", kind = "order", prompt = "Propose le livre comme cadeau.", options = listOf(), answers = listOf("Un livre c'est une bonne idée"), explain = "C'est une bonne idée : on valide la suggestion."), Exercise(id = "fr-foundations-u22-cadeau-e4", kind = "written", prompt = "Demande ce que Paul aime.", options = listOf(), answers = listOf("qu'est-ce qu'il aime", "qu'est ce qu'il aime", "qu'est-ce que paul aime", "qu'est-ce qu'il aime comme cadeau"), explain = "Qu'est-ce qu'il aime ? : la question qui guide le cadeau.")), skills = listOf("function:go-shopping", "vocab:social-expressions", "grammar:present-questions", "grammar:present-simple"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u22-feliciter", title = "Félicitations !", goal = "Féliciter et faire ses vœux : joyeux anniversaire, félicitations, bon voyage — et dire sa joie avec être content.", intro = LessonIntro(explanation = listOf("Le vœu universel : bon + nom. « Joyeux anniversaire ! » « Bon voyage ! » « Bon appétit ! »", "Pour une réussite, on dit « Félicitations ! » ou « Bravo ! » — et la personne répond : « Merci beaucoup ! »", "Pour dire sa joie, être + sentiment : « Je suis très content pour toi. » « Ça me fait plaisir. »"), examples = listOf(ExampleLine(text = "Joyeux anniversaire !", meaning = "Le vœu du jour J."), ExampleLine(text = "Félicitations pour ton examen !", meaning = "Féliciter une réussite."), ExampleLine(text = "Bon voyage !", meaning = "Le vœu du départ."), ExampleLine(text = "Bon rétablissement !", meaning = "Le vœu du malade."), ExampleLine(text = "Merci beaucoup, c'est gentil !", meaning = "La réponse au vœu."), ExampleLine(text = "Je suis très contente pour toi.", meaning = "Dire sa joie."))), expressions = listOf(TargetExpression(text = "joyeux anniversaire !", meaning = "Le vœu d'anniversaire.", note = "Joyeux anniversaire, Mai !"), TargetExpression(text = "félicitations / bravo !", meaning = "Féliciter.", note = "Bravo pour ton examen !"), TargetExpression(text = "bon + nom", meaning = "Le vœu universel.", note = "Bon voyage, bon appétit, bon rétablissement."), TargetExpression(text = "merci beaucoup", meaning = "Répondre au vœu.", note = "Merci beaucoup, c'est gentil !"), TargetExpression(text = "je suis content(e)", meaning = "Dire son bonheur.", note = "Je suis très contente pour toi."), TargetExpression(text = "ça me fait plaisir", meaning = "La joie simple.", note = "Ça me fait plaisir de te voir.")), situation = "La fête bat son plein : vous soufflez les bougies avec Mai, vous félicitez son examen, vous souhaitez bon voyage à Karim et chacun dit sa joie.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "C'est l'anniversaire de Mai : souhaite-lui.", expected = listOf("Joyeux anniversaire !", "Joyeux anniversaire"), focus = "joyeux anniversaire", watch = "le vœu se dit au moment du gâteau."), PracticeQuestion(prompt = "Mai réussit son examen : félicite-la.", expected = listOf("Félicitations !", "Bravo !", "Félicitations pour ton examen !"), focus = "félicitations", watch = "félicitations ou bravo, les deux marchent."), PracticeQuestion(prompt = "Karim part en voyage demain : fais ton vœu.", expected = listOf("Bon voyage !", "Bon voyage, Karim !"), focus = "bon voyage", watch = "bon + nom : la formule courte."), PracticeQuestion(prompt = "Dis ta joie : tu es contente pour Mai.", expected = listOf("Je suis très contente pour toi.", "Je suis content pour toi."), focus = "je suis content", watch = "être + sentiment : la joie se dit simplement."), PracticeQuestion(prompt = "Que répond Mai à « Joyeux anniversaire » ?", expected = listOf("Merci beaucoup !", "Merci beaucoup"), focus = "merci beaucoup", watch = "merci + beaucoup : la réponse chaleureuse."))), exercises = listOf(Exercise(id = "fr-foundations-u22-feliciter-e1", kind = "choice", prompt = "« ___ pour ton examen ! » (féliciter)", options = listOf("Félicitations", "Joyeux anniversaire", "Bon voyage", "Bonne nuit"), answers = listOf("Félicitations"), explain = "Félicitations + pour : on félicite une réussite."), Exercise(id = "fr-foundations-u22-feliciter-e2", kind = "gap", prompt = "Merci ___ , c'est gentil ! (une grande quantité)", options = listOf(), answers = listOf("beaucoup", "beacoup"), explain = "Merci beaucoup : la réponse au vœu."), Exercise(id = "fr-foundations-u22-feliciter-e3", kind = "order", prompt = "Karim part demain : fais ton vœu de départ.", options = listOf(), answers = listOf("Bon voyage et à bientôt"), explain = "Bon voyage + à bientôt : le vœu du départ."), Exercise(id = "fr-foundations-u22-feliciter-e4", kind = "written", prompt = "Dis ta joie pour Mai (tu es contente).", options = listOf(), answers = listOf("je suis très contente pour toi", "je suis contente pour toi", "je suis tres content pour toi", "je suis content pour toi"), explain = "Je suis content(e) pour toi : le bonheur se dit avec être.")), skills = listOf("vocab:social-expressions", "function:make-suggestions", "grammar:present-simple", "vocab:feelings"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple"))))
}

object FrFoundationsU23 {
    val unit = CourseUnit(id = "fr-foundations-u23", title = "Vêtements et tailles", subtitle = "Acheter et essayer", level = "A1", themes = listOf(ConversationTheme("en-boutique", "En boutique", "Chercher, essayer", "tshirt", "Course", "Vous entrez en boutique : vous cherchez un t-shirt, vous demandez la taille et la cabine d'essayage.", 0),
                ConversationTheme("la-caisse", "La caisse", "Payer, emporter", "bag", "Course", "À la caisse : le total, la carte ou les espèces, et le sac — trop cher ? On renonce avec le sourire.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u23-boutique", title = "Je cherche un t-shirt", goal = "Trouver son vêtement en boutique : je cherche…, vous avez du bleu ?, quelle est votre taille ?", intro = LessonIntro(explanation = listOf("On entre et on annonce ce qu'on cherche : « Je cherche un t-shirt. » « Je cherche une robe pour l'été. »", "Le vendeur demande la taille : « Vous cherchez quelle taille ? » On répond : « Du medium, je pense. »", "Pour vérifier le stock : « Vous avez du bleu ? » « Vous avez d'autres tailles ? » — du/des pour les choses sans chiffre précis."), examples = listOf(ExampleLine(text = "Je cherche un t-shirt.", meaning = "Ce qu'on veut acheter."), ExampleLine(text = "Vous avez du bleu ?", meaning = "Demander la couleur."), ExampleLine(text = "Vous cherchez quelle taille ?", meaning = "La question du vendeur."), ExampleLine(text = "Du medium, je pense.", meaning = "La réponse simple."), ExampleLine(text = "Vous avez d'autres tailles ?", meaning = "Vérifier le stock."), ExampleLine(text = "Je regarde, merci.", meaning = "Se laisser le temps."))), expressions = listOf(TargetExpression(text = "je cherche + vêtement", meaning = "Annoncer sa recherche.", note = "Je cherche une veste."), TargetExpression(text = "vous avez + du/de la + couleur ?", meaning = "Demander le stock.", note = "Vous avez du noir ?"), TargetExpression(text = "quelle est votre taille ?", meaning = "La question de la taille.", note = "…et vous cherchez quelle couleur ?"), TargetExpression(text = "du / de la / des", meaning = "Les quantités sans chiffre.", note = "du coton, de la laine, des chaussettes."), TargetExpression(text = "d'autres + pluriel", meaning = "Encore des.", note = "Vous avez d'autres couleurs ?"), TargetExpression(text = "je regarde, merci", meaning = "Se laisser le temps.", note = "le vendeur laisse tranquille.")), situation = "En boutique : vous cherchez un t-shirt bleu, la vendeuse demande votre taille, vous demandez d'autres couleurs et vous continuez à regarder tranquillement.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dites ce que vous cherchez : un t-shirt.", expected = listOf("Je cherche un t-shirt.", "Je cherche un t-shirt"), focus = "je cherche", watch = "chercher + le vêtement : on annonce d'abord."), PracticeQuestion(prompt = "La vendeuse demande votre taille : répondez (medium).", expected = listOf("Du medium, je pense.", "Medium, je pense."), focus = "la taille", watch = "du + taille : du small au XL."), PracticeQuestion(prompt = "Demandez si le bleu est disponible.", expected = listOf("Vous avez du bleu ?", "Vous avez du bleu"), focus = "vous avez du", watch = "du + couleur : le stock en vrac."), PracticeQuestion(prompt = "Demandez d'autres tailles.", expected = listOf("Vous avez d'autres tailles ?", "Vous avez d'autres tailles"), focus = "d'autres", watch = "d'autres + pluriel : encore des tailles."), PracticeQuestion(prompt = "Vous voulez regarder tranquillement : dites-le poliment.", expected = listOf("Je regarde, merci.", "Je regarde juste, merci."), focus = "je regarde", watch = "la formule qui calme l'insistance."))), exercises = listOf(Exercise(id = "fr-foundations-u23-boutique-e1", kind = "choice", prompt = "« Je ___ une robe pour l'été. » (vous entrez en boutique)", options = listOf("cherche", "essaie", "paye", "prends"), answers = listOf("cherche"), explain = "Je cherche + vêtement : on annonce ce qu'on veut."), Exercise(id = "fr-foundations-u23-boutique-e2", kind = "gap", prompt = "Vous avez ___ bleu ? (le stock)", options = listOf(), answers = listOf("du"), explain = "Du + couleur : le stock sans chiffre précis."), Exercise(id = "fr-foundations-u23-boutique-e3", kind = "order", prompt = "Le vendeur demande votre taille : répondez.", options = listOf(), answers = listOf("Du medium je pense"), explain = "Du + taille : la réponse toute simple."), Exercise(id = "fr-foundations-u23-boutique-e4", kind = "written", prompt = "Demandez la couleur noire en stock.", options = listOf(), answers = listOf("vous avez du noir", "est-ce que vous avez du noir", "vous avez du noir en stock", "est ce que vous avez du noir"), explain = "Vous avez du + couleur : la question du stock.")), skills = listOf("function:go-shopping", "vocab:shopping", "grammar:quantities", "grammar:present-simple"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u23-essayage", title = "Je peux l'essayer ?", goal = "Essayer un vêtement avec je peux : la cabine, la taille qui va ou pas, et la décision finale.", intro = LessonIntro(explanation = listOf("On demande la permission avec je peux : « Je peux l'essayer ? » — l' = le vêtement, déjà nommé.", "En cabine, on juge avec aller : « Ça me va bien. » « Il est trop petit. » « Elle est trop grande. »", "Et la décision : « Je le prends ! » ou « Finalement, non merci. »"), examples = listOf(ExampleLine(text = "Je peux l'essayer ?", meaning = "Demander la cabine."), ExampleLine(text = "Où est la cabine ?", meaning = "Chercher l'essayage."), ExampleLine(text = "Ça me va bien !", meaning = "La taille est bonne."), ExampleLine(text = "Il est trop petit.", meaning = "Le problème de taille."), ExampleLine(text = "Vous avez plus grand ?", meaning = "Demander la taille au-dessus."), ExampleLine(text = "Je le prends.", meaning = "Décider d'acheter."))), expressions = listOf(TargetExpression(text = "je peux l'essayer ?", meaning = "La demande d'essayage.", note = "l' = le pantalon."), TargetExpression(text = "ça me va (bien)", meaning = "La taille est bonne.", note = "Cette robe me va très bien."), TargetExpression(text = "trop petit / trop grand", meaning = "Le problème de taille.", note = "il est trop petit."), TargetExpression(text = "vous avez plus grand / plus petit ?", meaning = "La taille voisine.", note = "plus grand, s'il vous plaît."), TargetExpression(text = "je le prends / je la prends", meaning = "Acheter.", note = "je la prends pour une robe."), TargetExpression(text = "finalement, non merci", meaning = "Renoncer.", note = "Finalement, non merci.")), situation = "En cabine : vous essayez le t-shirt, il vous va bien, mais le pantalon est trop petit — vous demandez plus grand et vous prenez le t-shirt.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Demandez à essayer le pantalon.", expected = listOf("Je peux l'essayer ?", "Je peux essayer le pantalon ?"), focus = "je peux", watch = "l' = le pantalon : le pronom évite la répétition."), PracticeQuestion(prompt = "Le t-shirt est parfait : dis-le.", expected = listOf("Ça me va bien !", "Ça me va très bien.", "Il me va bien."), focus = "ça me va", watch = "aller à quelqu'un : ça me va = la taille est bonne."), PracticeQuestion(prompt = "Les chaussures sont trop petites : dites-le.", expected = listOf("Elles sont trop petites.", "C'est trop petit."), focus = "trop petit", watch = "trop = plus qu'il faut."), PracticeQuestion(prompt = "Demandez la taille au-dessus.", expected = listOf("Vous avez plus grand ?", "Avez-vous plus grand ?"), focus = "plus grand", watch = "plus + adjectif : la taille d'à côté."), PracticeQuestion(prompt = "Vous décidez d'acheter le t-shirt.", expected = listOf("Je le prends.", "Je le prends !"), focus = "je le prends", watch = "le = le t-shirt : prendre = acheter ici."))), exercises = listOf(Exercise(id = "fr-foundations-u23-essayage-e1", kind = "choice", prompt = "« Je peux ___ essayer ? » (le manteau)", options = listOf("l'", "la", "les", "me"), answers = listOf("l'"), explain = "Devant une voyelle, le devient l' : je peux l'essayer."), Exercise(id = "fr-foundations-u23-essayage-e2", kind = "gap", prompt = "Ça me ___ très bien, cette robe ! (verbe : aller)", options = listOf(), answers = listOf("va"), explain = "Aller à quelqu'un : ça me va = la taille est bonne."), Exercise(id = "fr-foundations-u23-essayage-e3", kind = "order", prompt = "La robe est trop petite : demandez la taille au-dessus.", options = listOf(), answers = listOf("Vous avez plus grand"), explain = "Plus grand : la taille immédiatement au-dessus."), Exercise(id = "fr-foundations-u23-essayage-e4", kind = "written", prompt = "Vous achetez le manteau : annoncez votre décision.", options = listOf(), answers = listOf("je le prends", "je le prend", "je prends le manteau"), explain = "Je le prends : la décision d'acheter.")), skills = listOf("function:make-requests", "function:go-shopping", "grammar:can", "vocab:shopping"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:can")),
    Lesson(id = "fr-foundations-u23-caisse", title = "C'est combien ?", goal = "Payer en boutique : c'est combien, ça fait 25 euros, c'est trop cher — carte ou espèces, et le sac.", intro = LessonIntro(explanation = listOf("Le prix se demande avec combien : « C'est combien, ce sac ? » Et la caisse répond : « Ça fait 25 euros. »", "Si le prix dépasse : « C'est trop cher ! » — et on peut prendre son temps : « Merci, je vais réfléchir. »", "Le paiement : « Vous payez comment ? » « Par carte. » « En espèces. » Et le dernier détail : « Un sac, s'il vous plaît ? »"), examples = listOf(ExampleLine(text = "C'est combien, ce sac ?", meaning = "Demander le prix."), ExampleLine(text = "Ça fait 25 euros.", meaning = "Le total de la caisse."), ExampleLine(text = "C'est trop cher !", meaning = "Le prix dépasse."), ExampleLine(text = "Vous payez comment ?", meaning = "La question de la caisse."), ExampleLine(text = "Par carte, s'il vous plaît.", meaning = "Le paiement classique."), ExampleLine(text = "Un sac, s'il vous plaît ?", meaning = "Le dernier détail."))), expressions = listOf(TargetExpression(text = "c'est combien ?", meaning = "Demander un prix.", note = "C'est combien, ce t-shirt ?"), TargetExpression(text = "ça fait + prix", meaning = "Le total.", note = "Ça fait 25 euros."), TargetExpression(text = "c'est trop cher", meaning = "Le prix dépasse.", note = "trop cher pour moi."), TargetExpression(text = "payer par carte / en espèces", meaning = "Les deux paiements.", note = "Vous payez par carte ?"), TargetExpression(text = "je vais réfléchir", meaning = "Prendre le temps.", note = "Merci, je vais réfléchir."), TargetExpression(text = "un sac, s'il vous plaît", meaning = "La demande du sac.", note = "le dernier échange de la caisse.")), situation = "À la caisse : le t-shirt et le sac font 32 euros, le sac vous paraît un peu cher, vous payez par carte et vous demandez un sac.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Demandez le prix du sac.", expected = listOf("C'est combien, ce sac ?", "C'est combien ?"), focus = "c'est combien", watch = "combien + le prix : la question de base."), PracticeQuestion(prompt = "Vous êtes la caisse : annoncez le total (32 euros).", expected = listOf("Ça fait 32 euros.", "Trente-deux euros."), focus = "ça fait", watch = "ça fait + prix : le total au présent."), PracticeQuestion(prompt = "Le sac coûte 40 euros : réagissez.", expected = listOf("C'est trop cher !", "C'est trop cher."), focus = "trop cher", watch = "trop + cher : plus que le budget."), PracticeQuestion(prompt = "La caisse demande votre moyen de paiement : la carte.", expected = listOf("Par carte, s'il vous plaît.", "Je paie par carte."), focus = "par carte", watch = "par carte, en espèces : deux formules fixes."), PracticeQuestion(prompt = "Demandez un sac.", expected = listOf("Un sac, s'il vous plaît ?", "Vous avez un sac ?"), focus = "un sac", watch = "s'il vous plaît + la demande : poli et court."))), exercises = listOf(Exercise(id = "fr-foundations-u23-caisse-e1", kind = "choice", prompt = "« ___ , ce t-shirt ? » (le prix)", options = listOf("C'est combien", "C'est quoi", "C'est qui", "C'est où"), answers = listOf("C'est combien"), explain = "C'est combien : la question du prix."), Exercise(id = "fr-foundations-u23-caisse-e2", kind = "gap", prompt = "Ça ___ 32 euros. (le total à la caisse)", options = listOf(), answers = listOf("fait"), explain = "Ça fait + prix : le total qu'annonce la caisse."), Exercise(id = "fr-foundations-u23-caisse-e3", kind = "order", prompt = "Vous payez par carte : dites-le.", options = listOf(), answers = listOf("Je paie par carte s'il vous plaît"), explain = "Payer par carte : la formule du paiement."), Exercise(id = "fr-foundations-u23-caisse-e4", kind = "written", prompt = "Le prix est trop élevé : réagissez.", options = listOf(), answers = listOf("c'est trop cher", "c est trop cher", "c'est beaucoup trop cher"), explain = "C'est trop cher : le prix dépasse le budget.")), skills = listOf("function:go-shopping", "grammar:quantities", "vocab:shopping", "vocab:social-expressions"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple"))))
}

object FrFoundationsU27 {
    val unit = CourseUnit(id = "fr-foundations-u27", title = "Numéros et âge", subtitle = "Compter, téléphoner, se présenter", level = "A1", themes = listOf(ConversationTheme("les-nombres", "Les nombres", "De zéro à cent", "number", "Course", "Au café puis dans la rue : Léa paie sept euros, Karim cherche le vingt-cinq et note un numéro de téléphone par petits groupes.", 0),
                ConversationTheme("l-age", "L'âge", "Quel âge tu as ?", "person.crop.circle", "Course", "À la soirée de bienvenue : Mai demande l'âge de Léa, Léa parle de sa sœur et du bébé de la famille.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u27-nombres", title = "De zéro à cent", goal = "Compter de zéro à cent, donner ton numéro de téléphone et comprendre un prix ou un numéro de rue : j'habite au vingt-cinq.", intro = LessonIntro(explanation = listOf("Les nombres servent partout : « Deux cafés, s'il vous plaît — ça fait sept euros. » Le prix, l'heure, l'adresse : toujours des nombres.", "Pour un numéro de téléphone, on le coupe en petits groupes : « C'est le zéro six, vingt, trente et un. » Plus facile à dire, plus facile à noter.", "On demande un numéro avec quel : « C'est quel numéro ? » Et on répond tout simplement : « C'est le vingt-cinq. »"), examples = listOf(ExampleLine(text = "Ça fait sept euros.", meaning = "Le prix, tout simplement."), ExampleLine(text = "J'habite au vingt-cinq.", meaning = "Le numéro de la rue."), ExampleLine(text = "C'est quel numéro ?", meaning = "Demander un numéro."), ExampleLine(text = "Mon numéro, c'est le zéro six douze.", meaning = "Le téléphone, par petits groupes."), ExampleLine(text = "Rendez-vous à dix-huit heures.", meaning = "L'heure, encore des nombres."))), expressions = listOf(TargetExpression(text = "ça fait + prix", meaning = "Le total à payer.", note = "Ça fait douze euros."), TargetExpression(text = "c'est quel numéro ?", meaning = "Demander un numéro.", note = "C'est quel numéro, ta maison ?"), TargetExpression(text = "j'habite au + nombre", meaning = "Donner son adresse.", note = "J'habite au dix rue Victor."), TargetExpression(text = "le zéro six…", meaning = "Commencer un numéro de portable.", note = "Le zéro six, c'est le portable."), TargetExpression(text = "à + nombre heures", meaning = "Donner l'heure du rendez-vous.", note = "À neuf heures, c'est bon ?")), situation = "Karim cherche la maison de Léa : il relit le numéro de la rue, il lui téléphone, elle lui donne son numéro et l'heure du rendez-vous.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ça fait quel prix ? Deux cafés à trois euros cinquante.", expected = listOf("Ça fait sept euros.", "Ca fait sept euros.", "Ça fait 7 euros."), focus = "ça fait", watch = "ça fait + le prix : le total tout simple."), PracticeQuestion(prompt = "Donne ton adresse : rue Victor, numéro dix.", expected = listOf("J'habite au dix rue Victor.", "J'habite au 10 rue Victor."), focus = "j'habite au", watch = "au + le numéro, avant le nom de la rue."), PracticeQuestion(prompt = "Tu veux connaître le numéro de la maison de Léa. Demande-le.", expected = listOf("C'est quel numéro ?", "C'est quel numero ?", "C'est quel numéro, ta maison ?"), focus = "c'est quel numéro", watch = "quel + être : la question toute simple."), PracticeQuestion(prompt = "Donne ton numéro de portable par groupes : zéro six, puis vingt.", expected = listOf("C'est le zéro six vingt.", "Le zéro six vingt.", "Zero six vingt."), focus = "le zéro six", watch = "on dit chaque groupe, sans le réfléchir : zéro six, c'est le portable."), PracticeQuestion(prompt = "Fixe le rendez-vous à dix-huit heures.", expected = listOf("Rendez-vous à dix-huit heures.", "On se retrouve à dix-huit heures ?", "Rendez-vous a dix-huit heures."), focus = "à dix-huit heures", watch = "à + l'heure : le point de rendez-vous."))), exercises = listOf(Exercise(id = "fr-foundations-u27-nombres-e1", kind = "choice", prompt = "« J'habite ___ vingt-cinq rue des Lilas. » (la petite préposition)", options = listOf("au", "à la", "de", "en"), answers = listOf("au"), explain = "Pour un numéro de rue : j'habite au vingt-cinq."), Exercise(id = "fr-foundations-u27-nombres-e2", kind = "gap", prompt = "Deux cafés et un thé : ça ___ sept euros. (verbe : faire)", options = listOf(), answers = listOf("fait"), explain = "Ça fait + le prix : faire au présent avec ça."), Exercise(id = "fr-foundations-u27-nombres-e3", kind = "order", prompt = "Tu veux connaître le numéro de la maison de Léa.", options = listOf(), answers = listOf("C'est quel numéro ta maison"), explain = "C'est quel numéro : la question directe pour un numéro."), Exercise(id = "fr-foundations-u27-nombres-e4", kind = "written", prompt = "Le rendez-vous est à trois heures de l'après-midi. Écris l'heure complète en lettres.", options = listOf(), answers = listOf("à quinze heures", "a quinze heures", "quinze heures", "rendez-vous à quinze heures"), explain = "Trois heures de l'après-midi, c'est à quinze heures.")), skills = listOf("grammar:present-simple", "function:tell-time", "function:ask-simple-questions", "vocab:social-expressions"), canDo = listOf("tell-time"), prerequisites = listOf("grammar:subject-pronouns")),
    Lesson(id = "fr-foundations-u27-age", title = "Quel âge tu as ?", goal = "Demander et dire ton âge avec avoir : j'ai vingt ans. Parler de l'âge de ta famille : ma sœur a seize ans.", intro = LessonIntro(explanation = listOf("En français, l'âge se dit avec avoir : « J'ai vingt ans. » On a un âge, on n'est pas un âge.", "Pour demander : « Tu as quel âge ? » — la question courte, parfaite entre amis.", "Avec la famille, le possessif accompagne le nom : « Mon petit frère a huit ans. » Mon, ma, mes : chacun son accord."), examples = listOf(ExampleLine(text = "Tu as quel âge ?", meaning = "La question directe."), ExampleLine(text = "J'ai vingt et un ans.", meaning = "Dire son âge avec avoir."), ExampleLine(text = "Ma sœur a seize ans.", meaning = "L'âge d'un proche."), ExampleLine(text = "Mon grand-père a soixante-dix ans.", meaning = "Les grands nombres d'âge."), ExampleLine(text = "Il est tout petit : il a trois ans.", meaning = "L'âge et la description ensemble."))), expressions = listOf(TargetExpression(text = "tu as quel âge ?", meaning = "Demander l'âge.", note = "Tu as quel âge, Mai ?"), TargetExpression(text = "j'ai + nombre + ans", meaning = "Dire ton âge.", note = "J'ai vingt-deux ans."), TargetExpression(text = "mon / ma + famille", meaning = "Désigner un proche.", note = "Ma cousine a dix ans."), TargetExpression(text = "il / elle a + ans", meaning = "L'âge des autres.", note = "Elle a trente ans."), TargetExpression(text = "tout(e) + adjectif", meaning = "Insister sur la description.", note = "Elle est toute petite.")), situation = "À la soirée de bienvenue, on fait connaissance : Mai demande l'âge à Léa, Léa parle de sa sœur et du bébé de la famille.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Demande l'âge de Mai (avec tu).", expected = listOf("Tu as quel âge ?", "Tu as quel age ?", "Quel âge tu as ?"), focus = "tu as quel âge", watch = "avoir pour l'âge : tu as, jamais tu es."), PracticeQuestion(prompt = "Dis ton âge : vingt ans.", expected = listOf("J'ai vingt ans.", "J'ai 20 ans.", "Jai vingt ans."), focus = "j'ai vingt ans", watch = "j'ai + nombre + ans : la formule complète."), PracticeQuestion(prompt = "Ta sœur a seize ans. Dis-le.", expected = listOf("Ma sœur a seize ans.", "Ma soeur a seize ans.", "Ma sœur a 16 ans."), focus = "ma sœur a", watch = "ma + sœur : le possessif s'accorde au féminin."), PracticeQuestion(prompt = "Ton grand-père a soixante-dix-huit ans. Dis-le.", expected = listOf("Mon grand-père a soixante-dix-huit ans.", "Mon grand-pere a soixante-dix-huit ans."), focus = "mon grand-père a", watch = "mon + grand-père : le possessif masculin."), PracticeQuestion(prompt = "Le bébé de la famille a trois ans. Décris-le avec tendresse.", expected = listOf("Il est tout petit : il a trois ans.", "Il a trois ans.", "Il a 3 ans."), focus = "il a trois ans", watch = "tout + adjectif pour insister : tout petit, toute petite."))), exercises = listOf(Exercise(id = "fr-foundations-u27-age-e1", kind = "choice", prompt = "« ___ seize ans. » (parler de ta sœur)", options = listOf("Ma sœur a", "Ma sœur est", "Mon sœur a", "Ma sœur ai"), answers = listOf("Ma sœur a"), explain = "L'âge avec avoir : ma sœur a seize ans."), Exercise(id = "fr-foundations-u27-age-e2", kind = "gap", prompt = "J'___ vingt-deux ans. (verbe : avoir)", options = listOf(), answers = listOf("ai"), explain = "J'ai : avoir à la première personne, l'âge se dit avec avoir."), Exercise(id = "fr-foundations-u27-age-e3", kind = "order", prompt = "Tu veux connaître l'âge de Mai. Pose la question.", options = listOf(), answers = listOf("Tu as quel âge Mai"), explain = "Tu as quel âge : avoir + quel âge, la question des âges."), Exercise(id = "fr-foundations-u27-age-e4", kind = "written", prompt = "Parle de ta cousine : elle a dix ans. Écris la phrase complète.", options = listOf(), answers = listOf("ma cousine a dix ans", "ma cousine a 10 ans"), explain = "Ma cousine a dix ans : possessif + avoir + ans.")), skills = listOf("function:describe-people", "vocab:family", "grammar:present-simple", "grammar:possessives"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:present-simple"))))
}

object FrFoundationsU3 {
    val unit = CourseUnit(id = "fr-foundations-u3", title = "Le passé", subtitle = "Qu'est-ce que tu as fait ?", level = "A2", themes = listOf(ConversationTheme("weekend-passe", "Le week-end passé", "Passé composé", "clock.arrow.circlepath", "Course", "Vous racontez votre week-end : sorties, repas, rencontres — au passé composé.", 0),
                ConversationTheme("voyage-dernier", "Le voyage de l'année dernière", "Se souvenir", "airplane", "Course", "Un voyage mémorable : où vous êtes allé, ce que vous avez vu.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u3-passe-compose", title = "Le passé composé", goal = "Raconter des actions terminées avec avoir/être + participe passé.", intro = LessonIntro(explanation = listOf("Le passé composé = auxiliaire (avoir ou être) + participe passé. « J'ai mangé. Elle est allée. »", "La plupart des verbes prennent avoir. Les verbes de mouvement (aller, venir, partir) prennent être.", "Avec être, le participe s'accorde : « Elle est allée » (féminin + e), « Ils sont allés » (masculin pluriel + s)."), examples = listOf(ExampleLine(text = "J'ai mangé une paella hier.", meaning = "avoir + mangé."), ExampleLine(text = "Elle est allée au cinéma.", meaning = "être + allée (féminin)."), ExampleLine(text = "Nous avons vu un film.", meaning = "avoir + vu (voir → vu)."), ExampleLine(text = "Ils sont partis tôt.", meaning = "être + partis (pluriel)."), ExampleLine(text = "Tu as fait tes devoirs ?", meaning = "avoir + fait (faire → fait)."))), expressions = listOf(TargetExpression(text = "j'ai / tu as / il a + pp", meaning = "avoir + participe.", note = "J'ai mangé."), TargetExpression(text = "je suis / elle est + pp", meaning = "Être pour mouvement.", note = "Je suis allé(e)."), TargetExpression(text = "fait / dit / vu / écrit", meaning = "Participes irréguliers.", note = "faire → fait."), TargetExpression(text = "accord avec être", meaning = "e/s selon le sujet.", note = "elle est allée, ils sont allés."), TargetExpression(text = "hier / la semaine dernière", meaning = "Marqueurs de temps.", note = "Hier, j'ai vu…")), situation = "Vous racontez votre week-end : ce que vous avez fait, avec qui, et une surprise.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dis une action du week-end. (manger au restaurant)", expected = listOf("J'ai mangé au restaurant."), focus = "avoir + pp", watch = "J'ai mangé — action terminée."), PracticeQuestion(prompt = "Dis où tu es allé(e) samedi.", expected = listOf("Je suis allé(e) au parc."), focus = "être + allé", watch = "aller prend être: je suis allé(e)."), PracticeQuestion(prompt = "Demande à ton ami ce qu'il a fait.", expected = listOf("Qu'est-ce que tu as fait ?"), focus = "as + pp", watch = "Qu'est-ce que tu as fait ?"), PracticeQuestion(prompt = "Dis que tu as fait une erreur.", expected = listOf("J'ai fait une erreur."), focus = "faire → fait", watch = "faire → fait (participe)."), PracticeQuestion(prompt = "Dis quand : hier soir.", expected = listOf("Hier soir, j'ai regardé un film."), focus = "hier soir", watch = "hier soir + passé composé."))), exercises = listOf(Exercise(id = "fr-foundations-u3-passe-compose-e1", kind = "choice", prompt = "J'___ un film hier soir.", options = listOf("ai regardé", "regarde", "regardais", "vais regarder"), answers = listOf("ai regardé"), explain = "Hier: passé composé."), Exercise(id = "fr-foundations-u3-passe-compose-e2", kind = "gap", prompt = "Elle ___ ___ au marché. (aller)", options = listOf(), answers = listOf("est allée"), explain = "aller prend être + accord féminin."), Exercise(id = "fr-foundations-u3-passe-compose-e3", kind = "order", prompt = "Demande le week-end.", options = listOf(), answers = listOf("Qu'est-ce que tu as fait ce weekend"), explain = "Qu'est-ce que tu as fait ?"), Exercise(id = "fr-foundations-u3-passe-compose-e4", kind = "written", prompt = "Dis que tu as fait une erreur.", options = listOf(), answers = listOf("jai fait une erreur", "j'ai fait une erreur"), explain = "faire → fait.")), skills = listOf("grammar:past-simple-regular", "grammar:past-simple-irregular", "grammar:time-expressions", "function:describe-past-events"), canDo = listOf("describe-past-events"), prerequisites = listOf("grammar:past-simple-regular"))))
}

object FrFoundationsU4 {
    val unit = CourseUnit(id = "fr-foundations-u4", title = "Comparer et projeter", subtitle = "Plus, moins, futur", level = "A2", themes = listOf(ConversationTheme("deux-apparts", "Deux appartements", "Lequel choisir ?", "house", "Course", "Vous comparez deux appartements : loyer, taille, quartier — et vous choisissez.", 0),
                ConversationTheme("projets-vacances", "Projets de vacances", "On va où ?", "airplane", "Course", "Vous planifiez les vacances avec le futur proche.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u4-comparatifs", title = "Comparatifs et superlatifs", goal = "Comparer avec plus/moins… que et le/la plus/moins… de.", intro = LessonIntro(explanation = listOf("Comparatifs: plus/moins + adjectif + que. « Ce café est plus cher que l'autre. »", "Superlatifs: le/la plus/moins + adjectif + de. « C'est le meilleur restaurant de la ville. »", "Irréguliers: bon → meilleur, mauvais → pire."), examples = listOf(ExampleLine(text = "Ce café est plus cher que l'autre.", meaning = "plus + adj + que."), ExampleLine(text = "Le train est moins lent que le bus.", meaning = "moins + adj."), ExampleLine(text = "C'est le meilleur restaurant de la ville.", meaning = "le meilleur + de."), ExampleLine(text = "Ce film est pire que l'original.", meaning = "pire = mauvais comparé."), ExampleLine(text = "Aussi cher qu'avant.", meaning = "aussi + adj + que = égalité."))), expressions = listOf(TargetExpression(text = "plus … que", meaning = "Plus que.", note = "plus cher que."), TargetExpression(text = "moins … que", meaning = "Moins que.", note = "moins cher que."), TargetExpression(text = "le/la plus … de", meaning = "Superlatif.", note = "le plus grand de France."), TargetExpression(text = "meilleur / pire", meaning = "Irréguliers.", note = "bon → meilleur, mauvais → pire."), TargetExpression(text = "aussi … que", meaning = "Égalité.", note = "aussi grand que moi.")), situation = "Vous comparez deux appartements : loyer, surface, quartier — et vous choisissez le meilleur.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Compare le prix : A 800€, B 1000€.", expected = listOf("L'appartement A est moins cher que le B."), focus = "moins cher", watch = "moins + adj + que."), PracticeQuestion(prompt = "Dis lequel est le meilleur. (B)", expected = listOf("L'appartement B est le meilleur."), focus = "le meilleur", watch = "Superlatif avec le/la."), PracticeQuestion(prompt = "Dis qu'ils sont aussi grands.", expected = listOf("Ils sont aussi grands l'un que l'autre."), focus = "aussi que", watch = "aussi + adj + que = égalité."), PracticeQuestion(prompt = "Choisis et justifie.", expected = listOf("Je préfère le B parce qu'il est plus grand."), focus = "parce que", watch = "préférence + parce que + raison."), PracticeQuestion(prompt = "Compare la taille: A 60m², B 80m².", expected = listOf("Le B est plus grand que le A."), focus = "plus grand", watch = "grand → plus grand + que."))), exercises = listOf(Exercise(id = "fr-foundations-u4-comparatifs-e1", kind = "choice", prompt = "Ce café est ___ cher ___ l'autre.", options = listOf("plus … que", "plus … de", "très … que", "beaucoup … que"), answers = listOf("plus … que"), explain = "plus + adj + que."), Exercise(id = "fr-foundations-u4-comparatifs-e2", kind = "gap", prompt = "C'est le ___ restaurant de la ville. (bon)", options = listOf(), answers = listOf("meilleur"), explain = "bon → le meilleur."), Exercise(id = "fr-foundations-u4-comparatifs-e3", kind = "order", prompt = "Compare le prix.", options = listOf(), answers = listOf("Ce est plus cher que celui-la"), explain = "plus + adj + que + démonstratif."), Exercise(id = "fr-foundations-u4-comparatifs-e4", kind = "written", prompt = "Ton restaurant préféré.", options = listOf(), answers = listOf("mon restaurant prefere est <nom>", "mon favori est <nom>"), explain = "Mon préféré est X.")), skills = listOf("grammar:comparatives", "grammar:superlatives", "grammar:connectors", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:comparatives")),
    Lesson(id = "fr-foundations-u4-futur-proche", title = "Le futur proche", goal = "Parler de projets avec aller + infinitif.", intro = LessonIntro(explanation = listOf("Le futur proche : aller (conjugué) + infinitif. « Je vais partir. Nous allons manger. »", "Seul aller se conjugue ; le second verbe reste à l'infinitif.", "Négation autour de aller : « Je ne vais pas sortir. »"), examples = listOf(ExampleLine(text = "Je vais partir demain.", meaning = "aller + partir."), ExampleLine(text = "Nous allons manger au restaurant.", meaning = "nous allons + inf."), ExampleLine(text = "Tu vas venir avec nous ?", meaning = "Question avec vas."), ExampleLine(text = "Je ne vais pas sortir ce soir.", meaning = "Négation: ne…pas autour d'aller."), ExampleLine(text = "Il va pleuvoir, prends un parapluie.", meaning = "Prédiction."))), expressions = listOf(TargetExpression(text = "je vais + inf", meaning = "Ton plan.", note = "Je vais dormir."), TargetExpression(text = "nous allons + inf", meaning = "Le projet du groupe.", note = "Nous allons voyager."), TargetExpression(text = "tu vas + inf ?", meaning = "Demander.", note = "Tu vas venir ?"), TargetExpression(text = "ne vais pas + inf", meaning = "Refuser.", note = "Je ne vais pas sortir."), TargetExpression(text = "il va + inf (météo)", meaning = "Prédire.", note = "Il va pleuvoir.")), situation = "Vous planifiez le samedi : proposition, acceptation ou refus, heure et lieu.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dis ton plan pour demain. (se reposer)", expected = listOf("Demain, je vais me reposer."), focus = "aller + inf", watch = "je vais + infinitif."), PracticeQuestion(prompt = "Demande le plan de ton ami.", expected = listOf("Qu'est-ce que tu vas faire ?"), focus = "la question", watch = "Qu'est-ce que + vas + inf ?"), PracticeQuestion(prompt = "Dis que tu ne vas pas sortir.", expected = listOf("Je ne vais pas sortir ce soir."), focus = "négation", watch = "ne + vais + pas + inf."), PracticeQuestion(prompt = "Prédis la pluie.", expected = listOf("Il va pleuvoir demain."), focus = "prédiction", watch = "il va + inf pour la météo."), PracticeQuestion(prompt = "Dis que tu ne vas pas travailler samedi.", expected = listOf("Je ne vais pas travailler samedi."), focus = "ne vais pas", watch = "ne + vais + pas + infinitif."))), exercises = listOf(Exercise(id = "fr-foundations-u4-futur-proche-e1", kind = "choice", prompt = "Je ___ ___ dormir. (2 mots)", options = listOf("vais dormir", "vais à dormir", "vais dormi", "vais dormeur"), answers = listOf("vais dormir"), explain = "aller + infinitif."), Exercise(id = "fr-foundations-u4-futur-proche-e2", kind = "gap", prompt = "Nous ___ ___ voyager en été. (2 mots)", options = listOf(), answers = listOf("allons voyager"), explain = "nous allons + inf."), Exercise(id = "fr-foundations-u4-futur-proche-e3", kind = "order", prompt = "Demande le plan.", options = listOf(), answers = listOf("Qu'est-ce que tu vas faire ce weekend"), explain = "Qu'est-ce que + vas + inf ?"), Exercise(id = "fr-foundations-u4-futur-proche-e4", kind = "written", prompt = "Un plan pour demain.", options = listOf(), answers = listOf("je vais <activite> demain", "demain je vais <activite>"), explain = "Je vais + verbe.")), skills = listOf("grammar:going-to", "function:make-future-plans", "grammar:future-forms", "vocab:social-expressions"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to"))))
}

object FrFoundationsU17 {
    val unit = CourseUnit(id = "fr-foundations-u17", title = "Bien se retrouver", subtitle = "Invitations et projets", level = "A2", themes = listOf(ConversationTheme("on-se-voit", "On se voit ?", "Propositions et réponses", "calendar.badge.clock", "Course", "Vous fixez un rendez-vous avec Léa : proposer une sortie, accepter, refuser poliment et reprogrammer.", 0),
                ConversationTheme("le-cadeau", "Le cadeau", "Nos projets", "gift", "Course", "L'anniversaire de Mai approche : vous prévoyez le cadeau et la fête avec aller + infinitif.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u17-propositions", title = "Tu viens ou tu préfères… ?", goal = "Proposer une sortie et offrir un choix : on va…, ça te dit ?, tu préfères… ?", intro = LessonIntro(explanation = listOf("Pour proposer : « On va au cinéma samedi, ça te dit ? » — aller + infinitif annonce le projet.", "L'alternative : « Tu viens samedi ou tu préfères dimanche ? » — tu préfères donne le choix.", "Pour répondre : « Bonne idée ! », « Volontiers ! », « Ça marche ! »"), examples = listOf(ExampleLine(text = "On va au cinéma samedi, ça te dit ?", meaning = "La proposition."), ExampleLine(text = "Tu viens samedi ou tu préfères dimanche ?", meaning = "Proposer un choix."), ExampleLine(text = "Tu préfères manger dehors ?", meaning = "tu préfères + infinitif."), ExampleLine(text = "Bonne idée ! On y va.", meaning = "Accepter."), ExampleLine(text = "Ça marche, à quelle heure ?", meaning = "Accepter et organiser."))), expressions = listOf(TargetExpression(text = "on va + infinitif ?", meaning = "Proposer une sortie.", note = "On va au marché ?"), TargetExpression(text = "ça te dit ?", meaning = "Ça t'intéresse ?", note = "très courant à l'oral."), TargetExpression(text = "tu préfères + infinitif", meaning = "Offrir un choix.", note = "Tu préfères rester ici ?"), TargetExpression(text = "bonne idée !", meaning = "Accepter.", note = "Super idée !"), TargetExpression(text = "à quelle heure ?", meaning = "Fixer l'heure.", note = "À huit heures ?")), situation = "Vous organisez samedi avec Léa : cinéma ou marché, midi ou soir — vous proposez, elle choisit.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Propose le cinéma samedi (ça te dit ?).", expected = listOf("On va au cinéma samedi, ça te dit ?", "On va au cinéma samedi ?"), focus = "ça te dit", watch = "aller + infinitif pour le projet."), PracticeQuestion(prompt = "Propose un choix : samedi ou dimanche.", expected = listOf("Tu viens samedi ou tu préfères dimanche ?", "Samedi ou dimanche ?"), focus = "tu préfères", watch = "tu préfères + jour ou + infinitif."), PracticeQuestion(prompt = "Accepte avec enthousiasme.", expected = listOf("Bonne idée !", "Super, bonne idée !", "Volontiers !"), focus = "accepter", watch = "bonne idée !"), PracticeQuestion(prompt = "Demande l'heure du rendez-vous.", expected = listOf("À quelle heure ?", "À quelle heure on se retrouve ?"), focus = "à quelle heure", watch = "à + heure."), PracticeQuestion(prompt = "Dis ce que préfère Mai : manger dehors.", expected = listOf("Elle préfère manger dehors.", "Mai préfère manger dehors."), focus = "préfère + infinitif", watch = "préfère + infinitif, sans préposition."))), exercises = listOf(Exercise(id = "fr-foundations-u17-propositions-e1", kind = "choice", prompt = "On ___ au marché samedi, ça te dit ?", options = listOf("va", "vais", "vas", "allez"), answers = listOf("va"), explain = "On va : aller à la 3e personne du singulier avec on."), Exercise(id = "fr-foundations-u17-propositions-e2", kind = "gap", prompt = "Tu viens ou tu ___ manger dehors ? (verbe : préférer)", options = listOf(), answers = listOf("préfères", "preferes"), explain = "Tu préfères + infinitif : l'alternative polie."), Exercise(id = "fr-foundations-u17-propositions-e3", kind = "order", prompt = "Propose le cinéma samedi.", options = listOf(), answers = listOf("On va au cinéma samedi"), explain = "On va + lieu + moment : la proposition de base."), Exercise(id = "fr-foundations-u17-propositions-e4", kind = "written", prompt = "Accepte la proposition de Léa avec enthousiasme.", options = listOf(), answers = listOf("bonne idée", "bonne idee", "super idée", "volontiers"), explain = "Bonne idée ! ou volontiers ! : on accepte.")), skills = listOf("function:make-suggestions", "grammar:going-to", "vocab:social-expressions", "grammar:present-simple"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "fr-foundations-u17-excuse", title = "Dommage, je ne peux pas", goal = "Accepter ou refuser une invitation poliment, et proposer une autre date.", intro = LessonIntro(explanation = listOf("Pour refuser poliment : « Dommage, je ne peux pas. » — dommage exprime le regret.", "On explique avec parce que : « Je ne peux pas venir parce que je travaille. »", "Pour garder le contact : « Une autre fois ? » « La semaine prochaine ? »"), examples = listOf(ExampleLine(text = "Dommage, je ne peux pas venir.", meaning = "Refuser avec regret."), ExampleLine(text = "Je suis désolée, je travaille samedi.", meaning = "Refuser avec l'excuse."), ExampleLine(text = "Avec plaisir !", meaning = "Accepter chaleureusement."), ExampleLine(text = "Je ne peux pas parce que je suis fatigué.", meaning = "L'excuse avec parce que."), ExampleLine(text = "Une autre fois, promis !", meaning = "Reproposer."))), expressions = listOf(TargetExpression(text = "dommage, …", meaning = "C'est un regret.", note = "Dommage !"), TargetExpression(text = "je ne peux pas + infinitif", meaning = "Le refus.", note = "Je ne peux pas venir."), TargetExpression(text = "je suis désolé(e)", meaning = "S'excuser.", note = "désolée pour les femmes."), TargetExpression(text = "parce que + phrase", meaning = "L'excuse.", note = "parce que je travaille."), TargetExpression(text = "une autre fois ?", meaning = "Reproposer.", note = "La semaine prochaine ?")), situation = "Léa invite Karim samedi : il accepte avec plaisir, mais Mai refuse — elle travaille — et propose la semaine prochaine.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Refuse l'invitation avec dommage.", expected = listOf("Dommage, je ne peux pas.", "Dommage, je ne peux pas venir."), focus = "dommage", watch = "dommage + je ne peux pas."), PracticeQuestion(prompt = "Excuse-toi : tu travailles samedi.", expected = listOf("Je suis désolé, je travaille samedi.", "Désolée, je travaille samedi."), focus = "désolé(e)", watch = "désolé (homme) / désolée (femme)."), PracticeQuestion(prompt = "Explique ton refus : tu es malade.", expected = listOf("Je ne peux pas venir parce que je suis malade.", "Je suis malade, je ne peux pas venir."), focus = "parce que", watch = "parce que + l'excuse."), PracticeQuestion(prompt = "Accepte chaleureusement.", expected = listOf("Avec plaisir !", "Oui, avec plaisir !"), focus = "avec plaisir", watch = "l'acceptation polie."), PracticeQuestion(prompt = "Repropose : la semaine prochaine.", expected = listOf("Une autre fois ? La semaine prochaine ?", "La semaine prochaine ?"), focus = "une autre fois", watch = "on repropose pour garder le contact."))), exercises = listOf(Exercise(id = "fr-foundations-u17-excuse-e1", kind = "choice", prompt = "« ___, je ne peux pas. » Tu regrettes vraiment.", options = listOf("Dommage", "Content", "Bonne idée", "Avec plaisir"), answers = listOf("Dommage"), explain = "Dommage exprime le regret avant le refus."), Exercise(id = "fr-foundations-u17-excuse-e2", kind = "gap", prompt = "Je ne peux pas venir ___ je travaille. (l'excuse)", options = listOf(), answers = listOf("parce que"), explain = "Parce que introduit l'excuse."), Exercise(id = "fr-foundations-u17-excuse-e3", kind = "order", prompt = "Refuse poliment : tu es malade.", options = listOf(), answers = listOf("Je ne peux pas venir parce que je suis malade"), explain = "Refus + parce que + excuse : la formule complète."), Exercise(id = "fr-foundations-u17-excuse-e4", kind = "written", prompt = "Tu acceptes l'invitation de Léa. Réponds chaleureusement.", options = listOf(), answers = listOf("avec plaisir", "oui, avec plaisir", "avec plaisir !"), explain = "Avec plaisir : l'acceptation chaleureuse.")), skills = listOf("vocab:social-expressions", "function:make-suggestions", "grammar:present-simple", "grammar:connectors"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "fr-foundations-u17-cadeau", title = "Le cadeau parfait", goal = "Prévoir un cadeau et la fête : qu'est-ce qu'on va lui offrir ?", intro = LessonIntro(explanation = listOf("Le projet avec aller : « On va lui offrir un livre. » — aller + infinitif dit le futur proche.", "Lui = à la personne du cadeau : « On va lui offrir » = à Mai, à Karim…", "Pour décider : « Qu'est-ce qu'on va lui offrir ? » Et pour prédire : « Elle va adorer ! »"), examples = listOf(ExampleLine(text = "Qu'est-ce qu'on va lui offrir ?", meaning = "Poser la question du cadeau."), ExampleLine(text = "Je vais lui acheter un livre.", meaning = "Le projet avec aller."), ExampleLine(text = "On va lui offrir des fleurs.", meaning = "offrir à quelqu'un."), ExampleLine(text = "Elle va adorer !", meaning = "Prédire la joie."), ExampleLine(text = "Tu vas chercher le gâteau ?", meaning = "Organiser la fête."))), expressions = listOf(TargetExpression(text = "qu'est-ce qu'on va + infinitif ?", meaning = "Décider ensemble.", note = "…va lui offrir ?"), TargetExpression(text = "aller + infinitif", meaning = "Le futur proche.", note = "Je vais acheter."), TargetExpression(text = "lui offrir / lui acheter", meaning = "Le cadeau à quelqu'un.", note = "lui = à Mai."), TargetExpression(text = "elle va adorer", meaning = "La prédiction.", note = "il va aimer."), TargetExpression(text = "aller chercher", meaning = "Aller récupérer.", note = "aller chercher le gâteau.")), situation = "L'anniversaire de Mai est samedi : qu'est-ce qu'on va lui offrir ? Un livre, des fleurs ? Et qui va chercher le gâteau ?", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Demande quel cadeau on va donner à Mai.", expected = listOf("Qu'est-ce qu'on va lui offrir ?", "Qu'est-ce qu'on va offrir à Mai ?"), focus = "lui offrir", watch = "lui = à Mai."), PracticeQuestion(prompt = "Dis ton projet : tu vas acheter un livre.", expected = listOf("Je vais lui acheter un livre.", "Je vais acheter un livre."), focus = "je vais", watch = "aller + infinitif."), PracticeQuestion(prompt = "Propose les fleurs.", expected = listOf("On va lui offrir des fleurs.", "Et des fleurs ?"), focus = "on va", watch = "on va + infinitif."), PracticeQuestion(prompt = "Prédis la joie de Mai.", expected = listOf("Elle va adorer !", "Elle va adorer son cadeau."), focus = "elle va adorer", watch = "aller + infinitif pour prédire."), PracticeQuestion(prompt = "Organise : Karim doit récupérer le gâteau. Dis-le.", expected = listOf("Karim va chercher le gâteau.", "Tu vas chercher le gâteau, Karim ?"), focus = "aller chercher", watch = "aller chercher = récupérer."))), exercises = listOf(Exercise(id = "fr-foundations-u17-cadeau-e1", kind = "choice", prompt = "Qu'est-ce qu'on ___ lui offrir ?", options = listOf("va", "vais", "vas", "allez"), answers = listOf("va"), explain = "On va + infinitif : le projet du groupe."), Exercise(id = "fr-foundations-u17-cadeau-e2", kind = "gap", prompt = "Je ___ lui acheter un livre. (verbe aller, futur proche)", options = listOf(), answers = listOf("vais"), explain = "Je vais + infinitif : le futur proche."), Exercise(id = "fr-foundations-u17-cadeau-e3", kind = "order", prompt = "Parle de ton projet cadeau : les fleurs.", options = listOf(), answers = listOf("On va lui offrir des fleurs"), explain = "On va + lui + infinitif + cadeau."), Exercise(id = "fr-foundations-u17-cadeau-e4", kind = "written", prompt = "Mai reçoit son cadeau : prédis sa joie.", options = listOf(), answers = listOf("elle va adorer", "elle va adorer !", "elle va aimer"), explain = "Elle va adorer : aller + infinitif pour prédire.")), skills = listOf("grammar:going-to", "function:make-future-plans", "vocab:social-expressions", "function:go-shopping"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to"))))
}

object FrFoundationsU20 {
    val unit = CourseUnit(id = "fr-foundations-u20", title = "Les pépins du quotidien", subtitle = "Pannes et solutions", level = "A2", themes = listOf(ConversationTheme("la-panne", "La panne", "Raconter le pépin", "wrench.and.screwdriver", "Course", "Votre vélo est tombé en panne ce matin : vous racontez le pépin au passé composé et vous cherchez une solution avec Léa.", 0),
                ConversationTheme("la-reclamation", "La réclamation", "Réclamer poliment", "phone.badge.checkmark", "Course", "Au téléphone avec le magasin : votre imprimante est cassée, vous expliquez calmement et vous demandez un échange.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u20-panne", title = "C'est tombé en panne", goal = "Raconter une panne au passé composé : mon vélo est tombé en panne et j'ai appelé le garagiste.", intro = LessonIntro(explanation = listOf("Le pépin se raconte au passé composé : « Mon vélo est tombé en panne ce matin. » — tomber prend être.", "Ce que vous avez fait avec avoir : « J'ai appelé le garagiste » (en -é), « J'ai perdu mes clés » (perdu, irrégulier).", "Le résultat, lui, est au présent : « Ça ne marche plus. » — ne… plus dit que c'est fini."), examples = listOf(ExampleLine(text = "Mon vélo est tombé en panne ce matin.", meaning = "La panne au passé composé."), ExampleLine(text = "J'ai appelé le garagiste.", meaning = "Passé composé régulier en -é."), ExampleLine(text = "J'ai perdu les clés de la maison.", meaning = "Participe irrégulier : perdre → perdu."), ExampleLine(text = "Le moteur ne démarre plus.", meaning = "Le résultat au présent."), ExampleLine(text = "Ça m'est arrivé ce matin.", meaning = "Introduire le récit du pépin."))), expressions = listOf(TargetExpression(text = "tomber en panne", meaning = "Ça ne marche plus.", note = "Mon vélo est tombé en panne."), TargetExpression(text = "ça m'est arrivé", meaning = "Introduire le pépin.", note = "…ce matin, devant la gare."), TargetExpression(text = "j'ai appelé / cherché", meaning = "Passé composé en -é.", note = "J'ai appelé le garage."), TargetExpression(text = "j'ai fait / perdu", meaning = "Participes irréguliers.", note = "faire → fait, perdre → perdu."), TargetExpression(text = "ça ne marche plus", meaning = "L'état actuel.", note = "ne… plus = c'est fini.")), situation = "Ce matin, votre vélo est tombé en panne devant la gare : vous racontez le pépin à Léa — ce qui est cassé et ce que vous avez déjà fait.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Raconte : ton vélo est tombé en panne ce matin.", expected = listOf("Mon vélo est tombé en panne ce matin.", "Mon vélo est tombé en panne"), focus = "est tombé", watch = "tomber prend être : est tombé."), PracticeQuestion(prompt = "Dis que tu as appelé le garagiste.", expected = listOf("J'ai appelé le garagiste.", "J'ai appelé le garage."), focus = "j'ai appelé", watch = "avoir + participe en -é."), PracticeQuestion(prompt = "Les clés ont disparu : dis-le au passé.", expected = listOf("J'ai perdu les clés.", "J'ai perdu les clés de la maison."), focus = "j'ai perdu", watch = "perdre → perdu, irrégulier."), PracticeQuestion(prompt = "Le moteur ne fonctionne plus : dis-le avec ne… plus.", expected = listOf("Le moteur ne marche plus.", "Le moteur ne démarre plus."), focus = "ne… plus", watch = "le présent + ne… plus = fini."), PracticeQuestion(prompt = "Commence ton récit avec la formule du pépin.", expected = listOf("Ça m'est arrivé ce matin.", "Ça m'est arrivé hier."), focus = "ça m'est arrivé", watch = "la porte d'entrée des petites histoires."))), exercises = listOf(Exercise(id = "fr-foundations-u20-panne-e1", kind = "choice", prompt = "Mon téléphone ___ en panne hier.", options = listOf("est tombé", "a tombé", "est tombée", "tombe"), answers = listOf("est tombé"), explain = "Tomber au passé composé prend être : est tombé (le téléphone = masculin)."), Exercise(id = "fr-foundations-u20-panne-e2", kind = "gap", prompt = "J'___ le garagiste ce matin. (verbe : appeler, passé composé)", options = listOf(), answers = listOf("ai appelé", "ai appelle"), explain = "J'ai appelé : avoir + participe passé en -é."), Exercise(id = "fr-foundations-u20-panne-e3", kind = "order", prompt = "Raconte le pépin du vélo.", options = listOf(), answers = listOf("Mon vélo est tombé en panne"), explain = "être + tombé : la phrase type de la panne."), Exercise(id = "fr-foundations-u20-panne-e4", kind = "written", prompt = "Le moteur est en panne. Dis-le.", options = listOf(), answers = listOf("le moteur ne marche plus", "le moteur ne démarre plus", "le moteur ne demarre plus"), explain = "Ne… plus : l'action est finie, le moteur ne fonctionne plus maintenant.")), skills = listOf("function:solve-problems", "grammar:past-simple-regular", "grammar:past-simple-irregular", "function:describe-past-events"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "fr-foundations-u20-solution", title = "Qu'est-ce que je fais ?", goal = "Demander de l'aide et proposer une solution simple : qu'est-ce que je fais ?, tu n'as qu'à…, il faut…", intro = LessonIntro(explanation = listOf("Le problème sans solution tient dans une question : « Qu'est-ce que je fais ? » « Tu peux m'aider ? »", "La solution la plus simple avec tu n'as qu'à : « Tu n'as qu'à appeler le garage. » — rien de plus à faire que ça.", "Le conseil général avec il faut : « Il faut d'abord vérifier la batterie. » Et on accepte : « D'accord, j'essaie tout de suite. »"), examples = listOf(ExampleLine(text = "Qu'est-ce que je fais ?", meaning = "Demander de l'aide."), ExampleLine(text = "Tu peux m'aider, s'il te plaît ?", meaning = "La demande directe."), ExampleLine(text = "Tu n'as qu'à appeler le garage.", meaning = "La solution simple."), ExampleLine(text = "Il faut d'abord vérifier la batterie.", meaning = "Le conseil avec il faut."), ExampleLine(text = "D'accord, j'essaie tout de suite.", meaning = "Accepter la solution."))), expressions = listOf(TargetExpression(text = "qu'est-ce que je fais ?", meaning = "Le problème sans solution.", note = "très courant à l'oral."), TargetExpression(text = "tu n'as qu'à + infinitif", meaning = "La solution facile.", note = "Tu n'as qu'à demander."), TargetExpression(text = "il faut + infinitif", meaning = "Le conseil général.", note = "Il faut vérifier d'abord."), TargetExpression(text = "tu peux m'aider ?", meaning = "Demander un coup de main.", note = "s'il te plaît."), TargetExpression(text = "j'essaie tout de suite", meaning = "Accepter la solution.", note = "tout de suite = maintenant.")), situation = "Votre vélo ne marche toujours pas : vous expliquez le problème à Léa, elle vous propose une solution, et vous décidez d'essayer tout de suite.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ton vélo ne marche pas : demande de l'aide avec la question type.", expected = listOf("Qu'est-ce que je fais ?", "Qu'est-ce que je fais"), focus = "qu'est-ce que je fais", watch = "la question du blocage, à l'oral."), PracticeQuestion(prompt = "Conseille à Karim : appeler le garage (tu n'as qu'à…).", expected = listOf("Tu n'as qu'à appeler le garage.", "Tu n'as qu'à appeler le garage."), focus = "tu n'as qu'à", watch = "tu n'as qu'à + infinitif."), PracticeQuestion(prompt = "Conseille avec il faut : vérifier la batterie.", expected = listOf("Il faut vérifier la batterie.", "Il faut d'abord vérifier la batterie."), focus = "il faut", watch = "il faut + infinitif : le conseil général."), PracticeQuestion(prompt = "Léa propose une solution : accepte.", expected = listOf("D'accord, j'essaie tout de suite.", "Bonne idée, j'essaie."), focus = "j'essaie", watch = "essaie = je vais essayer."), PracticeQuestion(prompt = "Demande un coup de main, poliment.", expected = listOf("Tu peux m'aider, s'il te plaît ?", "Tu peux m'aider ?"), focus = "tu peux m'aider", watch = "la demande directe et polie."))), exercises = listOf(Exercise(id = "fr-foundations-u20-solution-e1", kind = "choice", prompt = "Tu ___ qu'à appeler le garage.", options = listOf("n'as", "n'es", "ne vas", "n'allais"), answers = listOf("n'as"), explain = "Tu n'as qu'à + infinitif : la solution la plus simple."), Exercise(id = "fr-foundations-u20-solution-e2", kind = "gap", prompt = "Il ___ d'abord vérifier la batterie. (le conseil)", options = listOf(), answers = listOf("faut"), explain = "Il faut + infinitif : le conseil général."), Exercise(id = "fr-foundations-u20-solution-e3", kind = "order", prompt = "Demande de l'aide avec la question type.", options = listOf(), answers = listOf("Qu'est-ce que je fais"), explain = "Qu'est-ce que je fais ? : le blocage posé en une question."), Exercise(id = "fr-foundations-u20-solution-e4", kind = "written", prompt = "Léa propose une solution. Accepte avec enthousiasme.", options = listOf(), answers = listOf("d'accord j'essaie tout de suite", "d'accord j essaie tout de suite", "bonne idée j'essaie", "bonne idee j essaie"), explain = "D'accord, j'essaie tout de suite : on accepte et on agit.")), skills = listOf("function:solve-problems", "function:make-requests", "grammar:connectors", "vocab:social-expressions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "fr-foundations-u20-reclamation", title = "Une réclamation tranquille", goal = "Réclamer poliment un article cassé : j'ai acheté…, elle ne marche plus, est-ce que je peux avoir un échange ?", intro = LessonIntro(explanation = listOf("On commence par les faits : « J'ai acheté cette imprimante la semaine dernière. »", "Le problème au présent : « Elle ne marche plus depuis hier. » Puis la conséquence avec donc : « Donc j'ai le ticket, le voici. »", "La demande polie avec est-ce que : « Est-ce que je peux avoir un échange ? » — le ton reste tranquille."), examples = listOf(ExampleLine(text = "J'ai acheté cette imprimante la semaine dernière.", meaning = "Les faits d'abord."), ExampleLine(text = "Elle ne marche plus depuis hier.", meaning = "Le problème au présent."), ExampleLine(text = "Est-ce que je peux avoir un échange ?", meaning = "La demande polie."), ExampleLine(text = "J'ai bien le ticket, le voici.", meaning = "La preuve d'achat."), ExampleLine(text = "Merci, c'est très gentil.", meaning = "Terminer poliment."))), expressions = listOf(TargetExpression(text = "j'ai acheté + article", meaning = "Ouvrir la réclamation.", note = "…la semaine dernière."), TargetExpression(text = "il ne marche plus", meaning = "Décrire la panne.", note = "depuis hier."), TargetExpression(text = "est-ce que je peux + infinitif ?", meaning = "La demande polie.", note = "…avoir un échange ?"), TargetExpression(text = "un échange / un remboursement", meaning = "Ce qu'on demande.", note = "échange = un autre article."), TargetExpression(text = "voici le ticket", meaning = "La preuve d'achat.", note = "garde toujours le ticket.")), situation = "Au téléphone avec le magasin : vous avez acheté une imprimante cassée — vous expliquez calmement, vous montrez le ticket et vous demandez un échange.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ouvre la réclamation : achat d'une imprimante la semaine dernière.", expected = listOf("J'ai acheté cette imprimante la semaine dernière.", "J'ai acheté une imprimante la semaine dernière."), focus = "j'ai acheté", watch = "les faits au passé composé."), PracticeQuestion(prompt = "Explique la panne : plus rien depuis hier.", expected = listOf("Elle ne marche plus depuis hier.", "Elle ne fonctionne plus depuis hier."), focus = "ne… plus", watch = "ne… plus + depuis : la panne et sa durée."), PracticeQuestion(prompt = "Demande poliment un échange.", expected = listOf("Est-ce que je peux avoir un échange ?", "Est-ce que je peux avoir un echange ?"), focus = "est-ce que", watch = "est-ce que garde le ton tranquille."), PracticeQuestion(prompt = "Le vendeur demande une preuve d'achat.", expected = listOf("Voici le ticket.", "J'ai le ticket."), focus = "le ticket", watch = "le ticket fait foi."), PracticeQuestion(prompt = "Le vendeur accepte : remercie poliment.", expected = listOf("Merci, c'est très gentil.", "Merci beaucoup."), focus = "remercier", watch = "on clôt la réclamation par un merci."))), exercises = listOf(Exercise(id = "fr-foundations-u20-reclamation-e1", kind = "choice", prompt = "J'ai ___ cette imprimante la semaine dernière.", options = listOf("acheté", "acheter", "achetais", "achète"), answers = listOf("acheté"), explain = "Passé composé : j'ai acheté, participe en -é."), Exercise(id = "fr-foundations-u20-reclamation-e2", kind = "gap", prompt = "Est-ce que je peux avoir un ___ ? (un autre article)", options = listOf(), answers = listOf("échange", "echange"), explain = "Un échange : on rend l'article cassé et on en reçoit un autre."), Exercise(id = "fr-foundations-u20-reclamation-e3", kind = "order", prompt = "Demande poliment l'échange au magasin.", options = listOf(), answers = listOf("Est-ce que je peux avoir un échange"), explain = "Est-ce que je peux + infinitif : la demande polie."), Exercise(id = "fr-foundations-u20-reclamation-e4", kind = "written", prompt = "L'appareil est cassé depuis hier. Dis-le.", options = listOf(), answers = listOf("il ne marche plus depuis hier", "elle ne marche plus depuis hier"), explain = "Ne… plus + depuis : la panne et sa durée.")), skills = listOf("function:solve-problems", "grammar:present-questions", "vocab:social-expressions", "grammar:connectors"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors"))))
}

object FrFoundationsU24 {
    val unit = CourseUnit(id = "fr-foundations-u24", title = "Gros achats", subtitle = "Comparer, rendre, payer", level = "A2", themes = listOf(ConversationTheme("le-bon-choix", "Le bon choix", "Comparer avant d'acheter", "cart", "Course", "Un nouveau frigo : vous comparez les modèles en ligne, vous lisez les avis et vous choisissez le moins cher des deux bons.", 0),
                ConversationTheme("apres-l-achat", "Après l'achat", "Rendre et payer en fois", "creditcard", "Course", "Le lave-linge est arrivé cassé : vous le rendez, vous étalez le paiement sur trois mois et tout rentre dans l'ordre.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u24-comparer", title = "Plus grand, moins cher", goal = "Comparer deux produits : plus/moins… que, le plus/le moins, et trancher avec je préfère.", intro = LessonIntro(explanation = listOf("La comparaison : plus/moins + adjectif + que. « Ce modèle est plus silencieux que l'autre. »", "Le champion du groupe : le plus / le moins. « C'est le moins cher des deux. » Et l'irrégulier : bon → meilleur.", "Et on tranche : « Je préfère celui-là, il consomme moins. »"), examples = listOf(ExampleLine(text = "Ce modèle est plus grand que l'autre.", meaning = "La comparaison haute."), ExampleLine(text = "Celui-ci est moins cher.", meaning = "La comparaison basse."), ExampleLine(text = "C'est le moins cher des deux.", meaning = "Le superlatif."), ExampleLine(text = "Il consomme moins d'électricité.", meaning = "La donnée qui décide."), ExampleLine(text = "C'est le meilleur rapport qualité-prix.", meaning = "L'argument du vendeur."), ExampleLine(text = "Je préfère celui-là.", meaning = "Le choix final."))), expressions = listOf(TargetExpression(text = "plus + adjectif + que", meaning = "Comparer vers le haut.", note = "plus grand que l'autre."), TargetExpression(text = "moins + adjectif + que", meaning = "Comparer vers le bas.", note = "moins cher que celui-là."), TargetExpression(text = "le plus / le moins + adjectif", meaning = "Le superlatif.", note = "le moins cher des deux."), TargetExpression(text = "bon → meilleur", meaning = "L'irrégulier à connaître.", note = "c'est le meilleur choix."), TargetExpression(text = "je préfère + celui-là/celui-ci", meaning = "Trancher.", note = "Je préfère celui-ci."), TargetExpression(text = "le rapport qualité-prix", meaning = "L'argument du vendeur.", note = "le meilleur rapport qualité-prix.")), situation = "Vous comparez deux frigos en ligne : le blanc est plus grand, l'inox est moins cher et plus silencieux — et l'avis des clients tranche : le meilleur rapport qualité-prix.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Le frigo blanc est grand ; l'inox aussi. Comparez (le blanc).", expected = listOf("Le blanc est plus grand que l'inox.", "Il est plus grand que l'autre."), focus = "plus… que", watch = "plus + adjectif + que : la base de la comparaison."), PracticeQuestion(prompt = "L'inox coûte 399 euros, le blanc 450 : comparez l'inox.", expected = listOf("L'inox est moins cher que le blanc.", "Il est moins cher."), focus = "moins… que", watch = "moins + adjectif + que : vers le bas."), PracticeQuestion(prompt = "Des deux, l'inox est le silencieux : dites-le en superlatif.", expected = listOf("L'inox est le plus silencieux des deux.", "C'est le plus silencieux."), focus = "le plus", watch = "le + plus + adjectif : le champion du groupe."), PracticeQuestion(prompt = "Utilisez l'adjectif bon au superlatif pour l'inox.", expected = listOf("C'est le meilleur.", "L'inox est le meilleur choix."), focus = "meilleur", watch = "bon fait meilleur, pas « plus bon »."), PracticeQuestion(prompt = "Vous choisissez : tranchez avec je préfère.", expected = listOf("Je préfère l'inox.", "Je préfère celui-là."), focus = "je préfère", watch = "préférer + nom ou celui-là."))), exercises = listOf(Exercise(id = "fr-foundations-u24-comparer-e1", kind = "choice", prompt = "« Ce modèle est ___ silencieux que l'autre. » (comparaison haute)", options = listOf("plus", "le plus", "mieux", "très"), answers = listOf("plus"), explain = "Plus + adjectif + que : la comparaison de deux choses."), Exercise(id = "fr-foundations-u24-comparer-e2", kind = "gap", prompt = "C'est le ___ cher des deux. (l'opposé de plus)", options = listOf(), answers = listOf("moins"), explain = "Le moins + adjectif : le superlatif vers le bas."), Exercise(id = "fr-foundations-u24-comparer-e3", kind = "order", prompt = "Comparez : l'inox face au blanc (le prix).", options = listOf(), answers = listOf("L'inox est moins cher que le blanc"), explain = "Moins + adjectif + que : la comparaison des prix."), Exercise(id = "fr-foundations-u24-comparer-e4", kind = "written", prompt = "Dites votre choix pour l'inox avec je préfère.", options = listOf(), answers = listOf("je préfère l'inox", "je prefere l'inox", "je préfère celui-là", "je prefere celui la"), explain = "Je préfère + nom ou celui-là : le choix assumé.")), skills = listOf("grammar:comparatives", "function:go-shopping", "grammar:superlatives", "vocab:shopping"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:comparatives")),
    Lesson(id = "fr-foundations-u24-retour", title = "Je voudrais le rendre", goal = "Rendre un article défectueux : expliquer au passé composé, demander avec je voudrais, sortir le ticket de caisse.", intro = LessonIntro(explanation = listOf("On raconte le problème au passé composé : « J'ai acheté ce lave-linge la semaine dernière. Il est arrivé cassé. »", "La demande avec je voudrais reste ferme et polie : « Je voudrais le rendre. » « Est-ce que je peux avoir un remboursement ? »", "Les pièces du dossier : « Voici le ticket de caisse. » Sans preuve, pas de retour."), examples = listOf(ExampleLine(text = "J'ai acheté ce lave-linge la semaine dernière.", meaning = "L'achat daté."), ExampleLine(text = "Il est arrivé cassé.", meaning = "Le problème en une phrase."), ExampleLine(text = "Je voudrais le rendre.", meaning = "La demande claire."), ExampleLine(text = "Est-ce que je peux avoir un remboursement ?", meaning = "L'option remboursement."), ExampleLine(text = "Voici le ticket de caisse.", meaning = "La preuve."), ExampleLine(text = "On vous le rembourse sous cinq jours.", meaning = "La réponse du magasin."))), expressions = listOf(TargetExpression(text = "j'ai acheté + quand", meaning = "Situer l'achat.", note = "la semaine dernière."), TargetExpression(text = "il est arrivé + cassé/rayé", meaning = "Le constat.", note = "arrivé cassé, arrivé rayé."), TargetExpression(text = "je voudrais + rendre/échanger", meaning = "La demande polie.", note = "Je voudrais un échange."), TargetExpression(text = "est-ce que je peux avoir un remboursement ?", meaning = "L'option forte.", note = "…ou un avoir ?"), TargetExpression(text = "voici le ticket de caisse", meaning = "La preuve qui débloque.", note = "on tend et on dit."), TargetExpression(text = "échanger / rembourser", meaning = "Les deux issues.", note = "échanger contre le même modèle.")), situation = "Le lave-linge livré mardi est cassé : vous revenez au magasin, vous expliquez l'achat de la semaine dernière, vous sortez le ticket et vous demandez le remboursement.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Expliquez quand vous avez acheté (la semaine dernière).", expected = listOf("J'ai acheté ce lave-linge la semaine dernière.", "Je l'ai acheté la semaine dernière."), focus = "j'ai acheté", watch = "passé composé : l'achat est daté et fini."), PracticeQuestion(prompt = "Décrivez le problème : cassé à l'arrivée.", expected = listOf("Il est arrivé cassé.", "Le lave-linge est arrivé cassé."), focus = "arrivé cassé", watch = "arrivé + état : le constat en une phrase."), PracticeQuestion(prompt = "Demandez à rendre l'article.", expected = listOf("Je voudrais le rendre.", "Je voudrais rendre le lave-linge."), focus = "je voudrais", watch = "je voudrais + infinitif : ferme et poli."), PracticeQuestion(prompt = "Montrez votre preuve d'achat.", expected = listOf("Voici le ticket de caisse.", "Voilà le ticket."), focus = "voici", watch = "voici + preuve : on tend et on dit."), PracticeQuestion(prompt = "Demandez le remboursement.", expected = listOf("Est-ce que je peux avoir un remboursement ?", "Je voudrais un remboursement."), focus = "remboursement", watch = "remboursement = l'argent revient."))), exercises = listOf(Exercise(id = "fr-foundations-u24-retour-e1", kind = "choice", prompt = "« J'___ ce lave-linge la semaine dernière. »", options = listOf("ai acheté", "achète", "achetais", "vais acheter"), answers = listOf("ai acheté"), explain = "Passé composé : l'achat fini et daté."), Exercise(id = "fr-foundations-u24-retour-e2", kind = "gap", prompt = "Je ___ le rendre. (vouloir au conditionnel poli)", options = listOf(), answers = listOf("voudrais"), explain = "Je voudrais + infinitif : la demande polie et ferme."), Exercise(id = "fr-foundations-u24-retour-e3", kind = "order", prompt = "Présentez votre preuve d'achat.", options = listOf(), answers = listOf("Voici le ticket de caisse"), explain = "Voici + le ticket : la preuve qui débloque le retour."), Exercise(id = "fr-foundations-u24-retour-e4", kind = "written", prompt = "Demandez un remboursement.", options = listOf(), answers = listOf("est-ce que je peux avoir un remboursement", "je voudrais un remboursement", "est ce que je peux avoir un remboursement", "je voudrais etre rembourse"), explain = "Remboursement : l'argent retourne sur votre compte.")), skills = listOf("function:solve-problems", "grammar:past-simple-regular", "function:make-requests", "vocab:shopping"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "fr-foundations-u24-paiement", title = "Payer en plusieurs fois", goal = "Étaler un gros achat : en trois fois, d'abord… ensuite…, et conclure avec donc.", intro = LessonIntro(explanation = listOf("Le gros achat s'étale : « Vous pouvez payer en trois fois. » « Sans frais. »", "Le déroulé avec d'abord… ensuite… : « D'abord un acompte, ensuite deux mensualités. »", "On conclut avec donc : « Du coup, ça fait 100 euros par mois. Donc je signe ici ? »"), examples = listOf(ExampleLine(text = "Vous pouvez payer en trois fois.", meaning = "La proposition du magasin."), ExampleLine(text = "D'abord un acompte de 100 euros.", meaning = "La première étape."), ExampleLine(text = "Ensuite, deux mensualités de 100 euros.", meaning = "La suite du plan."), ExampleLine(text = "Il n'y a pas de frais.", meaning = "L'argument qui rassure."), ExampleLine(text = "Du coup, ça fait 100 euros par mois.", meaning = "Le calcul simple."), ExampleLine(text = "Donc je signe ici ?", meaning = "La conclusion."))), expressions = listOf(TargetExpression(text = "payer en + nombre + fois", meaning = "Étaler le paiement.", note = "en trois fois sans frais."), TargetExpression(text = "d'abord… ensuite…", meaning = "Le plan en étapes.", note = "D'abord l'acompte, ensuite le reste."), TargetExpression(text = "un acompte", meaning = "La première somme.", note = "100 euros à la commande."), TargetExpression(text = "une mensualité", meaning = "Le paiement mensuel.", note = "100 euros par mois."), TargetExpression(text = "du coup / donc", meaning = "Conclure.", note = "Du coup, ça rentre dans le budget."), TargetExpression(text = "sans frais", meaning = "Zéro supplément.", note = "c'est sans frais.")), situation = "Le lave-linge coûte 300 euros : la vendeuse propose trois fois sans frais, un acompte puis deux mensualités — donc vous signez.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "La vendeuse propose d'étaler : dites-le (trois fois).", expected = listOf("Vous pouvez payer en trois fois.", "On peut payer en trois fois."), focus = "en trois fois", watch = "en + nombre + fois : la formule du paiement étalé."), PracticeQuestion(prompt = "Expliquez la première étape : un acompte de 100 euros.", expected = listOf("D'abord un acompte de 100 euros."), focus = "d'abord", watch = "d'abord ouvre le plan."), PracticeQuestion(prompt = "Expliquez la suite : deux mensualités de 100 euros.", expected = listOf("Ensuite deux mensualités de 100 euros.", "Ensuite, deux mensualités."), focus = "ensuite", watch = "ensuite enchaîne l'étape deux."), PracticeQuestion(prompt = "L'argument qui rassure : zéro frais.", expected = listOf("Il n'y a pas de frais.", "C'est sans frais."), focus = "sans frais", watch = "sans frais = aucun supplément."), PracticeQuestion(prompt = "Concluez : vous signez.", expected = listOf("Donc je signe ici ?", "Donc je signe."), focus = "donc", watch = "donc relie le plan et la décision."))), exercises = listOf(Exercise(id = "fr-foundations-u24-paiement-e1", kind = "choice", prompt = "« Vous pouvez payer en trois ___ , sans frais. »", options = listOf("fois", "parts", "morceaux", "euros"), answers = listOf("fois"), explain = "En trois fois : le paiement étalé par défaut."), Exercise(id = "fr-foundations-u24-paiement-e2", kind = "gap", prompt = "___ , un acompte ; ensuite, deux mensualités. (la première étape)", options = listOf(), answers = listOf("d'abord", "d abord"), explain = "D'abord… ensuite… : le plan en étapes."), Exercise(id = "fr-foundations-u24-paiement-e3", kind = "order", prompt = "Concluez le paiement : vous signez.", options = listOf(), answers = listOf("Donc je signe ici"), explain = "Donc + question : la conclusion qui finalise."), Exercise(id = "fr-foundations-u24-paiement-e4", kind = "written", prompt = "Résumez le paiement mensuel avec le connecteur du coup.", options = listOf(), answers = listOf("du coup ca fait 100 euros par mois", "du coup ça fait 100 euros par mois", "du coup ça fait cent euros par mois"), explain = "Du coup, ça fait + somme : le calcul qui convainc.")), skills = listOf("function:go-shopping", "grammar:connectors", "vocab:shopping", "vocab:social-expressions"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:connectors"))))
