object FrFoundationsU28 {
    val unit = CourseUnit(id = "fr-foundations-u28", title = "Imprévus en voyage", subtitle = "Organiser, réagir, changer les plans", level = "A2", themes = listOf(ConversationTheme("le-projet", "Le projet", "On part ce week-end", "map", "Course", "Mardi soir : Léa propose un week-end à Lyon, on prévoit le train de samedi et Karim promet de réserver l'hôtel.", 0),
                ConversationTheme("les-imprevus", "Les imprévus", "Quand tout déraille", "exclamationmark.triangle", "Course", "À la gare puis à l'hôtel : le train est annulé, la réservation a disparu. On réagit, on demande de l'aide et on change le plan.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u28-projet", title = "On part ce week-end ?", goal = "Proposer et organiser un voyage avec le futur proche : on va partir à Lyon. Prendre ses responsabilités : je vais réserver l'hôtel.", intro = LessonIntro(explanation = listOf("Le futur proche, c'est aller + infinitif : « On va partir à Lyon samedi. » Un projet déjà décidé, pas une hypothèse.", "Avec l'intonation montante, le plan devient une suggestion : « On va prendre le train de huit heures ? »", "Pour organiser, on enchaîne avec des connecteurs : « D'abord le train, ensuite l'hôtel, après le programme. »"), examples = listOf(ExampleLine(text = "On va partir à Lyon ce week-end.", meaning = "Le projet décidé."), ExampleLine(text = "Je vais réserver le train ce soir.", meaning = "Une action prévue, une promesse."), ExampleLine(text = "On va prendre le train de huit heures ?", meaning = "Le plan transformé en suggestion."), ExampleLine(text = "Tu vas adorer le vieux Lyon.", meaning = "Prédire avec aller + infinitif."), ExampleLine(text = "D'abord la gare, ensuite l'hôtel.", meaning = "Le programme dans l'ordre."))), expressions = listOf(TargetExpression(text = "on va + infinitif", meaning = "Proposer un projet.", note = "On va visiter le musée ?"), TargetExpression(text = "je vais réserver", meaning = "Prendre une tâche.", note = "Je vais réserver l'hôtel."), TargetExpression(text = "tu vas + infinitif", meaning = "Parler des plans de l'autre.", note = "Tu vas venir avec nous ?"), TargetExpression(text = "d'abord… ensuite", meaning = "Mettre en ordre.", note = "D'abord le train, ensuite l'hôtel."), TargetExpression(text = "ça te dit ?", meaning = "Proposer léger.", note = "Lyon samedi, ça te dit ?")), situation = "Léa propose un week-end à Lyon : on va prendre le train de samedi matin, Karim va réserver l'hôtel et on va visiter le vieux Lyon.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Propose Lyon pour ce week-end (avec on + aller).", expected = listOf("On va partir à Lyon ce week-end.", "On va aller à Lyon ce week-end."), focus = "on va + infinitif", watch = "vais, vas, va + infinitif : le futur proche du projet."), PracticeQuestion(prompt = "Tu prends en charge l'hôtel : dis-le avec le futur proche.", expected = listOf("Je vais réserver l'hôtel.", "Je vais reserver l'hotel."), focus = "je vais réserver", watch = "aller + infinitif : le second verbe reste à l'infinitif."), PracticeQuestion(prompt = "Suggère le train de huit heures (avec on).", expected = listOf("On va prendre le train de huit heures ?", "On va prendre le train de 8 heures ?"), focus = "on va prendre", watch = "l'intonation montante transforme le plan en suggestion."), PracticeQuestion(prompt = "Mets le programme en ordre : la gare, puis l'hôtel.", expected = listOf("D'abord la gare, ensuite l'hôtel.", "D'abord la gare ensuite l'hotel."), focus = "d'abord… ensuite", watch = "les connecteurs donnent l'ordre du programme."), PracticeQuestion(prompt = "Propose simplement le week-end à Lyon à Karim.", expected = listOf("Lyon samedi, ça te dit ?", "Ça te dit ?", "Ca te dit ?"), focus = "ça te dit", watch = "l'invitation légère entre amis : ça te dit ?"))), exercises = listOf(Exercise(id = "fr-foundations-u28-projet-e1", kind = "choice", prompt = "« Samedi, on ___ visiter le vieux Lyon. » (futur proche)", options = listOf("va", "vas", "allez", "vais"), answers = listOf("va"), explain = "On va + infinitif : aller à la troisième personne du singulier."), Exercise(id = "fr-foundations-u28-projet-e2", kind = "gap", prompt = "Je ___ réserver le train ce soir. (verbe : aller)", options = listOf(), answers = listOf("vais"), explain = "Je vais + infinitif : le futur proche de la décision."), Exercise(id = "fr-foundations-u28-projet-e3", kind = "order", prompt = "Organise le programme : le train d'abord, l'hôtel ensuite.", options = listOf(), answers = listOf("D'abord le train ensuite l'hôtel"), explain = "D'abord… ensuite : les connecteurs ordonnent le programme."), Exercise(id = "fr-foundations-u28-projet-e4", kind = "written", prompt = "Propose un café à Mai, avec l'invitation légère des amis.", options = listOf(), answers = listOf("un café ça te dit", "ça te dit un café", "un cafe ca te dit", "cafe ca te dit"), explain = "Ça te dit ? : l'invitation légère, suivie de la proposition.")), skills = listOf("grammar:going-to", "function:make-future-plans", "function:make-suggestions", "vocab:travel"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u28-hotel", title = "Il n'y a pas ma réservation", goal = "Signaler un problème à l'hôtel : il n'y a pas ma réservation. Demander de l'aide poliment : est-ce que vous pouvez m'aider ?", intro = LessonIntro(explanation = listOf("Pour signaler un problème, on reste simple et calme : « Il n'y a pas ma réservation. » Un constat, pas une dispute.", "On demande de l'aide avec pouvoir et le vous de politesse : « Est-ce que vous pouvez m'aider ? »", "L'impératif fait avancer : « Vérifiez, s'il vous plaît. » Le verbe tout seul, sans sujet, adouci par s'il vous plaît."), examples = listOf(ExampleLine(text = "Il n'y a pas ma réservation.", meaning = "Signaler le problème."), ExampleLine(text = "Est-ce que vous pouvez m'aider ?", meaning = "Demander de l'aide."), ExampleLine(text = "J'ai réservé pour deux nuits.", meaning = "Expliquer la situation."), ExampleLine(text = "Vérifiez, s'il vous plaît.", meaning = "Demander une action, poliment."), ExampleLine(text = "Pas grave, ça me va.", meaning = "Accepter la solution."))), expressions = listOf(TargetExpression(text = "il n'y a pas + nom", meaning = "Signaler un manque.", note = "Il n'y a pas ma chambre."), TargetExpression(text = "est-ce que vous pouvez… ?", meaning = "Demander de l'aide poliment.", note = "Est-ce que vous pouvez vérifier ?"), TargetExpression(text = "j'ai réservé", meaning = "Rappeler la réservation.", note = "J'ai réservé au nom de Karim."), TargetExpression(text = "impératif + s'il vous plaît", meaning = "Une demande ferme et polie.", note = "Regardez, s'il vous plaît."), TargetExpression(text = "ça me va", meaning = "Accepter.", note = "Une chambre au troisième ? Ça me va.")), situation = "À la réception, Karim découvre que sa réservation a disparu. Il explique le problème calmement, demande de l'aide et accepte une chambre au troisième.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ta réservation n'existe pas dans l'ordinateur. Signale-le.", expected = listOf("Il n'y a pas ma réservation.", "Il ny a pas ma reservation.", "Il y a pas ma réservation."), focus = "il n'y a pas", watch = "ne… pas autour de y a : le constat calme."), PracticeQuestion(prompt = "Demande de l'aide à la réception (avec vous).", expected = listOf("Est-ce que vous pouvez m'aider ?", "Est-ce que vous pouvez maider ?", "Pouvez-vous m'aider ?"), focus = "vous pouvez m'aider", watch = "vous de politesse + pouvoir + m'aider."), PracticeQuestion(prompt = "Explique ta réservation : deux nuits, au nom de Karim.", expected = listOf("J'ai réservé deux nuits au nom de Karim.", "J'ai reserve deux nuits."), focus = "j'ai réservé", watch = "participe passé : réserver → réservé."), PracticeQuestion(prompt = "Demande à la réception de vérifier, avec l'impératif et la politesse.", expected = listOf("Vérifiez, s'il vous plaît.", "Verifiez sil vous plait.", "Vérifiez s'il vous plaît."), focus = "vérifiez", watch = "l'impératif avec vous : le verbe prend -ez."), PracticeQuestion(prompt = "On te propose une chambre au troisième. Accepte.", expected = listOf("Ça me va.", "Ca me va.", "Pas grave, ça me va."), focus = "ça me va", watch = "ça me va : ça me convient, en trois mots."))), exercises = listOf(Exercise(id = "fr-foundations-u28-hotel-e1", kind = "choice", prompt = "« ___ pas ma réservation. » (le constat calme)", options = listOf("Il n'y a", "Il n'a", "Il y", "Il n'est"), answers = listOf("Il n'y a"), explain = "Il n'y a pas : signaler le manque avec y avoir."), Exercise(id = "fr-foundations-u28-hotel-e2", kind = "gap", prompt = "Est-ce que vous ___ m'aider ? (verbe : pouvoir)", options = listOf(), answers = listOf("pouvez"), explain = "Vous pouvez : pouvoir avec vous, la demande polie."), Exercise(id = "fr-foundations-u28-hotel-e3", kind = "order", prompt = "Demande à la réception de vérifier, avec politesse.", options = listOf(), answers = listOf("Vérifiez s'il vous plaît"), explain = "Vérifiez, s'il vous plaît : l'impératif adouci par la politesse."), Exercise(id = "fr-foundations-u28-hotel-e4", kind = "written", prompt = "Explique ta situation : tu as réservé deux nuits, au nom de Karim.", options = listOf(), answers = listOf("j'ai réservé deux nuits au nom de karim", "j'ai reserve deux nuits", "j'ai réservé pour deux nuits"), explain = "J'ai réservé + les détails : la situation devient claire.")), skills = listOf("function:solve-problems", "function:make-requests", "vocab:travel", "grammar:imperatives"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "fr-foundations-u28-imprevus", title = "Changer les plans", goal = "Conseiller avec devrais et proposer une alternative avec pourrait : tu devrais prendre celui de dix heures, on pourrait partir dimanche.", intro = LessonIntro(explanation = listOf("Pour conseiller : « Tu devrais prendre le train de dix heures. » Devrais, c'est le conseil doux, sans obligation.", "Pour proposer une alternative : « On pourrait partir dimanche. » Pourrait ouvre la porte sans imposer.", "On réagit d'abord au problème : « Ah mince ! » Puis on avance : « Pas grave, on change le plan. »"), examples = listOf(ExampleLine(text = "Ah mince, le train est annulé !", meaning = "La petite déception."), ExampleLine(text = "Tu devrais prendre celui de dix heures.", meaning = "Le conseil."), ExampleLine(text = "On pourrait partir dimanche à la place.", meaning = "L'alternative."), ExampleLine(text = "Pas grave, on change le plan.", meaning = "Rester positif."), ExampleLine(text = "Ça marche pour toi, dimanche ?", meaning = "Vérifier l'accord."))), expressions = listOf(TargetExpression(text = "tu devrais + infinitif", meaning = "Conseiller.", note = "Tu devrais réserver maintenant."), TargetExpression(text = "on pourrait + infinitif", meaning = "Proposer une alternative.", note = "On pourrait y aller en bus."), TargetExpression(text = "ah mince !", meaning = "La petite déception.", note = "Ah mince, c'est complet !"), TargetExpression(text = "pas grave", meaning = "Minimiser le problème.", note = "Pas grave, demain c'est bien aussi."), TargetExpression(text = "ça marche ?", meaning = "Vérifier l'accord.", note = "Dix heures, ça marche ?")), situation = "Le train de samedi est annulé : Léa conseille celui de dix heures, Karim propose de partir dimanche et on vérifie que le nouveau plan convient.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Conseille à Karim le train de dix heures.", expected = listOf("Tu devrais prendre le train de dix heures.", "Tu devrais prendre le train de 10 heures.", "Tu devrais prendre le train de dix heures"), focus = "tu devrais", watch = "devrais + infinitif : le conseil sans obligation."), PracticeQuestion(prompt = "Propose de partir dimanche (avec on).", expected = listOf("On pourrait partir dimanche.", "On pourait partir dimanche."), focus = "on pourrait", watch = "pouvoir au conditionnel : la proposition souple."), PracticeQuestion(prompt = "Le train est annulé. Réagis avec la petite déception.", expected = listOf("Ah mince !", "Ah mince, le train est annulé !"), focus = "ah mince", watch = "l'interjection petite, très française."), PracticeQuestion(prompt = "Rassure Karim : le problème est petit.", expected = listOf("Pas grave, on change le plan.", "Pas grave.", "Pas grave, demain c'est bien."), focus = "pas grave", watch = "pas grave : le problème devient tout petit."), PracticeQuestion(prompt = "Vérifie que dix heures convient à Karim.", expected = listOf("Dix heures, ça marche ?", "10 heures, ça marche ?", "Ça marche, dix heures ?"), focus = "ça marche", watch = "ça marche ? : l'accord se vérifie en deux mots."))), exercises = listOf(Exercise(id = "fr-foundations-u28-imprevus-e1", kind = "choice", prompt = "« Tu ___ prendre le train de dix heures. » (le conseil doux)", options = listOf("devrais", "dois", "veux", "vas"), answers = listOf("devrais"), explain = "Tu devrais + infinitif : le conseil, pas l'obligation."), Exercise(id = "fr-foundations-u28-imprevus-e2", kind = "gap", prompt = "On ___ visiter le musée demain. (proposer avec pouvoir au conditionnel)", options = listOf(), answers = listOf("pourrait"), explain = "On pourrait : l'alternative proposée en douceur."), Exercise(id = "fr-foundations-u28-imprevus-e3", kind = "order", prompt = "Conseille à Léa de réserver maintenant.", options = listOf(), answers = listOf("Tu devrais réserver maintenant"), explain = "Tu devrais + infinitif : le conseil doux."), Exercise(id = "fr-foundations-u28-imprevus-e4", kind = "written", prompt = "Le musée est complet : réagis avec la petite déception française.", options = listOf(), answers = listOf("ah mince", "ah mince !", "mince", "oh mince"), explain = "Ah mince ! : la déception légère, sans drame.")), skills = listOf("grammar:modal-should", "function:solve-problems", "function:make-suggestions", "vocab:transport"), canDo = listOf("solve-everyday-problems", "use-transport"), prerequisites = listOf("grammar:present-simple"))))
}

object FrFoundationsU6 {
    val unit = CourseUnit(id = "fr-foundations-u6", title = "Expériences et changements", subtitle = "Déjà ou jamais", level = "B1", themes = listOf(ConversationTheme("fr-b1-voyage", "Le voyage inoubliable", "Déjà vu", "airplane", "Course", "Vous parlez des voyages et des premières fois : déjà allé, jamais vu, et une histoire inoubliable.", 0),
                ConversationTheme("fr-b1-changement", "Le changement de vie", "Avant / maintenant", "arrow-up-forward", "Course", "Vous comparez votre vie d'avant et d'aujourd'hui et expliquez ce qui a changé.", 1)), lessons = listOf(    Lesson(id = "fr-b1-experiencias", title = "Tu l'as déjà fait ?", goal = "Raconter des expériences avec le passé composé et déjà/jamais.", intro = LessonIntro(explanation = listOf("L'expérience : « Tu as déjà été à Lisbonne ? » — « Oui, j'y suis allé l'année dernière. »", "déjà = une fois dans la vie. « J'ai déjà goûté ce plat. » jamais = zéro fois. « Je n'ai jamais skié. »", "Les participes irréguliers reviennent : « J'ai vu », « J'ai fait », « J'ai été »."), examples = listOf(ExampleLine(text = "Tu as déjà été à Lisbonne ?", meaning = "Question d'expérience."), ExampleLine(text = "Je n'ai jamais skié.", meaning = "jamais = zéro fois."), ExampleLine(text = "J'ai déjà goûté la paella.", meaning = "déjà = une fois."), ExampleLine(text = "C'était la première fois.", meaning = "Première fois."), ExampleLine(text = "Qu'est-ce que tu as fait là-bas ?", meaning = "Relancer."))), expressions = listOf(TargetExpression(text = "Tu as déjà + pp ?", meaning = "Expérience.", note = "Tu as déjà été à Rome ?"), TargetExpression(text = "Je n'ai jamais + pp", meaning = "jamais.", note = "Je n'ai jamais vu ça."), TargetExpression(text = "vu / fait / été", meaning = "Participes clés.", note = "voir→vu, faire→fait, aller→été."), TargetExpression(text = "la première fois que…", meaning = "Première fois.", note = "C'est la première fois que je…"), TargetExpression(text = "et toi ?", meaning = "Renvoyer la question.", note = "Et toi, tu as déjà… ?")), situation = "Vous parlez voyages : qui a déjà pris l'avion, qui n'a jamais campé, et une première fois inoubliable.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Demande si ton ami a déjà été à Lisbonne.", expected = listOf("Tu as déjà été à Lisbonne ?", "Est-ce que tu as déjà été à Lisbonne ?"), focus = "déjà + pp", watch = "déjà entre auxiliaire et participe."), PracticeQuestion(prompt = "Dis que tu n'as jamais skié.", expected = listOf("Je n'ai jamais skié.", "Je n'ai jamais fait de ski."), focus = "jamais", watch = "ne… jamais autour de l'auxiliaire."), PracticeQuestion(prompt = "Dis que tu as déjà goûté la paella.", expected = listOf("J'ai déjà goûté la paella."), focus = "déjà", watch = "J'ai déjà + pp."), PracticeQuestion(prompt = "Dis que c'était ta première fois.", expected = listOf("C'était la première fois."), focus = "première fois", watch = "imparfait pour le cadre."), PracticeQuestion(prompt = "Renvoie la question : et toi ?", expected = listOf("Et toi ?", "Et toi, tu as déjà fait du surf ?"), focus = "et toi", watch = "et toi relance."))), exercises = listOf(Exercise(id = "fr-b1-experiencias-e1", kind = "choice", prompt = "Tu ___ déjà ___ à Rome ?", options = listOf("as / été", "es / allé", "as / allé", "es / été"), answers = listOf("as / été"), explain = "aller → être, mais ici : as été (expérience avec avoir accepté : « avoir été »)."), Exercise(id = "fr-b1-experiencias-e2", kind = "gap", prompt = "Je n'ai ___ skié. (jamais)", options = listOf(), answers = listOf("jamais"), explain = "ne… jamais autour de l'auxiliaire."), Exercise(id = "fr-b1-experiencias-e3", kind = "order", prompt = "Demande l'expérience : tu as déjà mangé des escargots ?", options = listOf(), answers = listOf("Tu as déjà mangé des escargots"), explain = "Tu as déjà + pp + objet ?"), Exercise(id = "fr-b1-experiencias-e4", kind = "written", prompt = "Dis une expérience : tu as déjà vu ce film.", options = listOf(), answers = listOf("j'ai deja vu ce film", "j'ai déjà vu ce film"), explain = "J'ai déjà + pp.")), skills = listOf("grammar:present-perfect", "grammar:past-simple-irregular", "function:describe-past-events"), canDo = listOf("describe-past-events"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "fr-b1-antes-ahora", title = "Avant et maintenant", goal = "Opposer le passé et le présent avec l'imparfait et les connecteurs.", intro = LessonIntro(explanation = listOf("L'imparfait peint le passé régulier : « Avant, j'habitais en ville. »", "L'opposition : « Avant… maintenant… ». « Avant je fumais, maintenant je cours. »", "Les connecteurs : « mais », « parce que », « donc ». « C'était fatigant, donc j'ai déménagé. »"), examples = listOf(ExampleLine(text = "Avant, j'habitais en ville.", meaning = "imparfait du passé."), ExampleLine(text = "Maintenant, je vis à la campagne.", meaning = "présent contrasté."), ExampleLine(text = "Avant je fumais, maintenant je cours.", meaning = "Changement de vie."), ExampleLine(text = "C'était fatigant, donc j'ai déménagé.", meaning = "donc = conséquence."), ExampleLine(text = "Je préfère ma vie actuelle, parce que…", meaning = "parce que = cause."))), expressions = listOf(TargetExpression(text = "Avant, j'…-ais", meaning = "imparfait.", note = "j'habitais, je faisais."), TargetExpression(text = "maintenant, je …", meaning = "présent.", note = "maintenant je vis…"), TargetExpression(text = "mais / donc / parce que", meaning = "Connecteurs.", note = "mais = contraste."), TargetExpression(text = "je préfère …", meaning = "Opinion.", note = "je préfère ma vie…"), TargetExpression(text = "C'était + adjectif", meaning = "Cadre du passé.", note = "C'était calme.")), situation = "Vous comparez la vie d'avant et d'aujourd'hui : la ville et la campagne, le travail et le temps libre, et pourquoi vous avez changé.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dis qu'avant tu habitais en ville.", expected = listOf("Avant j'habitais en ville.", "Avant, j'habitais en ville."), focus = "imparfait", watch = "-ais : j'habitais."), PracticeQuestion(prompt = "Dis que maintenant tu vis à la campagne.", expected = listOf("Maintenant je vis à la campagne.", "Maintenant, je vis à la campagne."), focus = "maintenant", watch = "présent pour maintenant."), PracticeQuestion(prompt = "Oppose : avant tu fumais, maintenant tu cours.", expected = listOf("Avant je fumais maintenant je cours.", "Avant, je fumais, maintenant je cours."), focus = "avant/maintenant", watch = "deux temps opposés."), PracticeQuestion(prompt = "Donne la conséquence : c'était fatigant, donc tu as déménagé.", expected = listOf("C'était fatigant donc j'ai déménagé.", "C'était fatigant, donc j'ai déménagé."), focus = "donc", watch = "donc + conséquence."), PracticeQuestion(prompt = "Dis ce que tu préfères et pourquoi.", expected = listOf("Je préfère ma vie actuelle parce que je suis plus libre.", "Je préfère ma vie maintenant."), focus = "parce que", watch = "parce que + cause."))), exercises = listOf(Exercise(id = "fr-b1-antes-ahora-e1", kind = "choice", prompt = "Avant, j'___ en ville. (habiter, imparfait)", options = listOf("habitais", "habite", "ai habité", "habiterai"), answers = listOf("habitais"), explain = "imparfait : -ais."), Exercise(id = "fr-b1-antes-ahora-e2", kind = "gap", prompt = "C'était fatigant, ___ j'ai déménagé. (conséquence)", options = listOf(), answers = listOf("donc"), explain = "donc = conséquence."), Exercise(id = "fr-b1-antes-ahora-e3", kind = "order", prompt = "Oppose : avant je fumais, maintenant je cours.", options = listOf(), answers = listOf("Avant je fumais maintenant je cours"), explain = "avant + imparfait, maintenant + présent."), Exercise(id = "fr-b1-antes-ahora-e4", kind = "written", prompt = "Dis ce qui a changé : maintenant tu travailles de chez toi.", options = listOf(), answers = listOf("maintenant je travaille de chez moi", "maintenant je travaille chez moi"), explain = "maintenant + présent.")), skills = listOf("grammar:used-to", "grammar:connectors", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:used-to"))))
}

object FrFoundationsU18 {
    val unit = CourseUnit(id = "fr-foundations-u18", title = "Raconter des histoires", subtitle = "Récits au passé", level = "B1", themes = listOf(ConversationTheme("le-recit", "Le récit", "Enchaîner les faits", "book", "Course", "Vous racontez votre journée à Lyon : d'abord le train, ensuite le musée, enfin le retour tardif.", 0),
                ConversationTheme("le-rebondissement", "Le rebondissement", "Surprise et réactions", "sparkles", "Course", "Soudain, il s'est avéré que… : l'histoire prend un tour inattendu et vos amis réagissent.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u18-narrer", title = "Ce qui s'est passé", goal = "Enchaîner les faits d'une histoire passée : d'abord, ensuite, enfin.", intro = LessonIntro(explanation = listOf("Pour raconter, on met les faits dans l'ordre : « D'abord, on a pris le train. Ensuite, on a visité le musée. »", "Le passé composé raconte l'action : « j'ai visité » (verbes en -er), « j'ai fait » (participes irréguliers).", "La fin de l'histoire : « Enfin, on est rentrés tard. » — enfin conclut le récit."), examples = listOf(ExampleLine(text = "D'abord, on a pris le train.", meaning = "Le premier fait."), ExampleLine(text = "Ensuite, on a visité le musée.", meaning = "Le fait suivant."), ExampleLine(text = "Puis il a commencé à pleuvoir.", meaning = "puis = ensuite."), ExampleLine(text = "J'ai fait une longue balade.", meaning = "Participe irrégulier : faire → fait."), ExampleLine(text = "Enfin, on est rentrés à minuit.", meaning = "Le dernier fait."))), expressions = listOf(TargetExpression(text = "d'abord", meaning = "Le premier fait.", note = "D'abord, je me suis levé."), TargetExpression(text = "ensuite / puis", meaning = "Le fait suivant.", note = "Ensuite, on a déjeuné."), TargetExpression(text = "enfin", meaning = "Le dernier fait.", note = "Enfin, on est rentrés."), TargetExpression(text = "j'ai visité / regardé", meaning = "Passé composé en -er.", note = "mangé, marché, écouté."), TargetExpression(text = "j'ai fait / vu / pris", meaning = "Participes irréguliers.", note = "faire→fait, voir→vu, prendre→pris.")), situation = "Vous racontez votre journée à Lyon : le train, le musée, la pluie, le retour tardif — chaque chose à sa place.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Commence ton récit : tu as pris le train.", expected = listOf("D'abord, on a pris le train.", "D'abord, j'ai pris le train."), focus = "d'abord", watch = "d'abord ouvre le récit."), PracticeQuestion(prompt = "Continue : vous avez visité le musée.", expected = listOf("Ensuite, on a visité le musée.", "Puis on a visité le musée."), focus = "ensuite", watch = "ensuite ou puis."), PracticeQuestion(prompt = "Raconte la pluie, avec le verbe commencer.", expected = listOf("Puis il a commencé à pleuvoir.", "Ensuite il a commencé à pleuvoir."), focus = "il a commencé", watch = "commencer → commencé."), PracticeQuestion(prompt = "Termine : vous êtes rentrés à minuit.", expected = listOf("Enfin, on est rentrés à minuit.", "Finalement, on est rentrés à minuit."), focus = "enfin", watch = "enfin clôt le récit."), PracticeQuestion(prompt = "Dis ce que tu as fait : visiter la ville.", expected = listOf("J'ai visité la ville.", "On a visité la ville."), focus = "j'ai visité", watch = "avoir + participe."))), exercises = listOf(Exercise(id = "fr-foundations-u18-narrer-e1", kind = "choice", prompt = "___ , on a pris le train. (le premier fait)", options = listOf("D'abord", "Enfin", "Ensuite", "Donc"), answers = listOf("D'abord"), explain = "D'abord annonce le premier fait du récit."), Exercise(id = "fr-foundations-u18-narrer-e2", kind = "gap", prompt = "Ensuite, on a ___ le musée. (verbe : visiter, participe passé)", options = listOf(), answers = listOf("visité", "visite"), explain = "Avoir + participe passé : visité."), Exercise(id = "fr-foundations-u18-narrer-e3", kind = "order", prompt = "Termine ton récit : le retour à minuit.", options = listOf(), answers = listOf("Enfin on est rentrés à minuit"), explain = "Enfin + passé composé : la clôture du récit."), Exercise(id = "fr-foundations-u18-narrer-e4", kind = "written", prompt = "Raconte ton week-end à la mer : le bateau.", options = listOf(), answers = listOf("j'ai fait du bateau", "on a fait du bateau", "j'ai fait une balade en bateau"), explain = "Avoir + fait : le participe irrégulier de faire.")), skills = listOf("function:tell-a-story", "grammar:past-simple-irregular", "grammar:connectors", "grammar:past-simple-regular"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "fr-foundations-u18-surprise", title = "Le rebondissement", goal = "Donner du piquant à l'histoire : soudain, il s'est avéré que…, et personne ne s'y attendait.", intro = LessonIntro(explanation = listOf("Le rebondissement arrive avec « soudain » : « Soudain, le train s'est arrêté. »", "« Il s'est avéré que » révèle la vérité : « Il s'est avéré que c'était le mauvais quai. »", "Pour finir en surprise : « Et devinez ce qui s'est passé ? » « Personne ne s'y attendait ! »"), examples = listOf(ExampleLine(text = "Soudain, le train s'est arrêté.", meaning = "L'événement surprise."), ExampleLine(text = "Il s'est avéré que c'était le mauvais quai.", meaning = "La vérité révélée."), ExampleLine(text = "Tout à coup, il a commencé à pleuvoir.", meaning = "tout à coup = soudain."), ExampleLine(text = "Et devinez qui on a vu là-bas ?", meaning = "Faire monter la tension."), ExampleLine(text = "Personne ne s'y attendait !", meaning = "La réaction de surprise."))), expressions = listOf(TargetExpression(text = "soudain / tout à coup", meaning = "La surprise soudaine.", note = "Soudain, tout a changé."), TargetExpression(text = "il s'est avéré que + phrase", meaning = "La vérité apparaît.", note = "Il s'est avéré qu'il avait raison."), TargetExpression(text = "et devinez … ?", meaning = "Capter l'attention.", note = "Devinez ce qui s'est passé !"), TargetExpression(text = "personne ne s'y attendait", meaning = "La surprise générale.", note = "s'attendre à quelque chose."), TargetExpression(text = "au final", meaning = "Conclure l'histoire.", note = "Au final, tout a bien fini.")), situation = "Votre train s'est arrêté en pleine campagne : soudain, une annonce ; il s'est avéré que… — racontez, vos amis n'en reviennent pas.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Raconte la surprise : le train s'est arrêté (soudain).", expected = listOf("Soudain, le train s'est arrêté.", "Tout à coup, le train s'est arrêté."), focus = "soudain", watch = "soudain casse le rythme du récit."), PracticeQuestion(prompt = "Révèle la vérité : c'était le mauvais quai.", expected = listOf("Il s'est avéré que c'était le mauvais quai.", "Il s'est avéré que c'était le mauvais quai !"), focus = "il s'est avéré que", watch = "la formule du rebondissement."), PracticeQuestion(prompt = "Fais monter la tension avec une question.", expected = listOf("Et devinez ce qui s'est passé ?", "Et devinez qui on a rencontré ?"), focus = "et devinez", watch = "la question qui accroche."), PracticeQuestion(prompt = "Dis la surprise générale.", expected = listOf("Personne ne s'y attendait !", "Personne ne s'y attendait."), focus = "s'y attendre", watch = "ne s'y attendait pas = surprise."), PracticeQuestion(prompt = "Conclus : tout a bien fini.", expected = listOf("Au final, tout a bien fini.", "Finalement, tout a bien fini."), focus = "au final", watch = "au final clôt l'histoire."))), exercises = listOf(Exercise(id = "fr-foundations-u18-surprise-e1", kind = "choice", prompt = "___ , le train s'est arrêté en pleine campagne.", options = listOf("Soudain", "Ensuite", "D'abord", "Enfin"), answers = listOf("Soudain"), explain = "Soudain introduit l'événement surprise du récit."), Exercise(id = "fr-foundations-u18-surprise-e2", kind = "gap", prompt = "Il s'est ___ que le guide parlait chinois. (verbe : s'avérer)", options = listOf(), answers = listOf("avéré", "avere"), explain = "Il s'est avéré que : la formule de la révélation."), Exercise(id = "fr-foundations-u18-surprise-e3", kind = "order", prompt = "Raconte le rebondissement avec la formule de la révélation.", options = listOf(), answers = listOf("Il s'est avéré que c'était le mauvais quai"), explain = "Il s'est avéré que + révélation au passé."), Exercise(id = "fr-foundations-u18-surprise-e4", kind = "written", prompt = "Tes amis n'en reviennent pas : dis la surprise générale.", options = listOf(), answers = listOf("personne ne s'y attendait", "personne ne sy attendait", "personne ne s'y attendait !"), explain = "Personne ne s'y attendait ! : la surprise collective.")), skills = listOf("function:tell-a-story", "grammar:connectors", "grammar:past-simple-irregular", "vocab:social-expressions"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-irregular")),
    Lesson(id = "fr-foundations-u18-anecdotes", title = "L'anecdote de l'été", goal = "Raconter une anecdote et réagir à celle des autres : sans blague !, et puis ?", intro = LessonIntro(explanation = listOf("L'anecdote se lance : « Tu sais ce qui m'est arrivé cet été ? »", "Pour réagir : « Sans blague ! » (c'est vrai ?), « Non mais sérieux ? » — l'étonnement amusé.", "Pour relancer le récit : « Et puis ? » « Et après ? » — on veut la suite."), examples = listOf(ExampleLine(text = "Tu sais ce qui m'est arrivé cet été ?", meaning = "Lancer l'anecdote."), ExampleLine(text = "Sans blague !", meaning = "Réagir avec étonnement."), ExampleLine(text = "Et puis ? Raconte !", meaning = "Demander la suite."), ExampleLine(text = "J'ai rencontré un acteur connu.", meaning = "Le cœur de l'anecdote."), ExampleLine(text = "Non mais sérieux ?", meaning = "Douter en riant."))), expressions = listOf(TargetExpression(text = "tu sais ce qui m'est arrivé ?", meaning = "Ouvrir l'anecdote.", note = "…cet été, à Nice."), TargetExpression(text = "sans blague !", meaning = "C'est incroyable !", note = "réaction très courante."), TargetExpression(text = "et puis ?", meaning = "Relancer le récit.", note = "Et après ?"), TargetExpression(text = "non mais sérieux ?", meaning = "Douter en riant.", note = "sérieusement ?"), TargetExpression(text = "quelle histoire !", meaning = "Commenter la fin.", note = "C'était fou.")), situation = "Au café, vous racontez votre été : la rencontre improbable à Nice — vos amis réagissent : sans blague !, et puis ?", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Lance ton anecdote de l'été.", expected = listOf("Tu sais ce qui m'est arrivé cet été ?", "Tu sais ce qui m'est arrivé ?"), focus = "lancer l'anecdote", watch = "tu sais + ce qui m'est arrivé."), PracticeQuestion(prompt = "Réagis avec étonnement à l'histoire de Karim.", expected = listOf("Sans blague !", "Sans blague ! C'est pas vrai."), focus = "sans blague", watch = "sans blague = c'est vrai ?"), PracticeQuestion(prompt = "Demande la suite de l'histoire.", expected = listOf("Et puis ?", "Et après ? Raconte !"), focus = "et puis", watch = "la relance classique."), PracticeQuestion(prompt = "Doute en riant de son histoire.", expected = listOf("Non mais sérieux ?", "Sérieux ?"), focus = "non mais sérieux", watch = "le doute amusé."), PracticeQuestion(prompt = "Commente la fin : c'était incroyable.", expected = listOf("Quelle histoire !", "Quelle histoire, quand même !"), focus = "quelle histoire", watch = "quelle + nom : l'exclamation."))), exercises = listOf(Exercise(id = "fr-foundations-u18-anecdotes-e1", kind = "choice", prompt = "« ___ ! » Tu n'as pas cru l'histoire de Karim.", options = listOf("Sans blague", "Bonne idée", "Avec plaisir", "Tout à fait"), answers = listOf("Sans blague"), explain = "Sans blague ! : je n'ai pas cru, c'est incroyable."), Exercise(id = "fr-foundations-u18-anecdotes-e2", kind = "gap", prompt = "« Et ___ ? » Tu veux connaître la suite de l'histoire.", options = listOf(), answers = listOf("puis"), explain = "Et puis ? : la relance du récit."), Exercise(id = "fr-foundations-u18-anecdotes-e3", kind = "order", prompt = "Lance ton anecdote de l'été.", options = listOf(), answers = listOf("Tu sais ce qui m'est arrivé cet été"), explain = "Tu sais + ce qui m'est arrivé : l'ouverture type."), Exercise(id = "fr-foundations-u18-anecdotes-e4", kind = "written", prompt = "Commente la fin du récit : c'était incroyable.", options = listOf(), answers = listOf("quelle histoire", "quelle histoire !", "sans blague"), explain = "Quelle histoire ! : le commentaire admiratif.")), skills = listOf("function:tell-a-story", "vocab:social-expressions", "grammar:past-simple-regular", "function:describe-past-events"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-regular"))))
}

object FrFoundationsU21 {
    val unit = CourseUnit(id = "fr-foundations-u21", title = "Le travail", subtitle = "Entretien et projets", level = "B1", themes = listOf(ConversationTheme("l-entretien", "L'entretien", "Expérience et points forts", "briefcase", "Course", "Vous passez un entretien dans une agence de voyage : votre expérience chiffrée, vos points forts, et une conclusion en confiance.", 0),
                ConversationTheme("l-equipe", "L'équipe", "Ambiance et objectifs", "bubble.left.and.text.bubble.right", "Course", "Premier jour dans l'équipe : l'ambiance détendue, les habitudes du vendredi, et vos projets professionnels à vous.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u21-entretien", title = "L'entretien", goal = "Parler de son expérience et de ses points forts en entretien : j'ai travaillé trois ans, je suis rigoureux, donc ce poste est fait pour moi.", intro = LessonIntro(explanation = listOf("L'expérience se chiffre au passé composé : « J'ai travaillé trois ans dans une agence de voyage. »", "Les points forts avec être : « Je suis rigoureux et organisé », et on illustre : « Je suis à l'aise avec les clients. »", "Les connecteurs structurent la réponse : « D'abord j'ai appris le métier, ensuite j'ai géré l'équipe, donc je crois que ce poste est fait pour moi. »"), examples = listOf(ExampleLine(text = "J'ai travaillé trois ans dans une agence de voyage.", meaning = "L'expérience chiffrée."), ExampleLine(text = "J'ai géré les réservations et formé deux stagiaires.", meaning = "La responsabilité concrète."), ExampleLine(text = "Je suis rigoureux et organisé.", meaning = "Les points forts."), ExampleLine(text = "Je suis à l'aise avec les clients.", meaning = "La qualité relationnelle."), ExampleLine(text = "Donc je crois que ce poste est fait pour moi.", meaning = "La conclusion en confiance."))), expressions = listOf(TargetExpression(text = "j'ai travaillé / géré + durée", meaning = "L'expérience chiffrée.", note = "trois ans, deux étés."), TargetExpression(text = "je suis + qualités", meaning = "Les points forts.", note = "rigoureux, organisé, patient."), TargetExpression(text = "être à l'aise avec", meaning = "La compétence relationnelle.", note = "avec les clients."), TargetExpression(text = "d'abord… ensuite…", meaning = "Structurer la réponse.", note = "D'abord j'ai appris, ensuite j'ai géré."), TargetExpression(text = "ce poste est fait pour moi", meaning = "Conclure l'entretien.", note = "donc je postule.")), situation = "Vous êtes en entretien dans une agence de voyage : trois ans d'expérience, les réservations gérées, deux stagiaires formés — et vous concluez avec confiance.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Parle de ton expérience : trois ans dans une agence de voyage.", expected = listOf("J'ai travaillé trois ans dans une agence de voyage.", "J'ai travaille trois ans dans une agence de voyage"), focus = "j'ai travaillé", watch = "passé composé pour l'expérience finie."), PracticeQuestion(prompt = "Cite deux de tes points forts.", expected = listOf("Je suis rigoureux et organisé.", "Je suis organisé et patient."), focus = "je suis", watch = "être + adjectif de qualité."), PracticeQuestion(prompt = "Ta qualité avec les clients ? Dis-le.", expected = listOf("Je suis à l'aise avec les clients.", "Je suis à l'aise avec la clientèle."), focus = "à l'aise", watch = "à l'aise avec = je gère bien."), PracticeQuestion(prompt = "Structure ta réponse : le métier appris, puis l'équipe gérée.", expected = listOf("D'abord j'ai appris le métier, ensuite j'ai géré l'équipe.", "J'ai d'abord appris le métier, puis j'ai géré l'équipe."), focus = "d'abord… ensuite", watch = "les connecteurs donnent le plan."), PracticeQuestion(prompt = "Conclus l'entretien avec confiance.", expected = listOf("Donc je crois que ce poste est fait pour moi.", "Je crois que ce poste est fait pour moi."), focus = "donc", watch = "donc relie les preuves et la conclusion."))), exercises = listOf(Exercise(id = "fr-foundations-u21-entretien-e1", kind = "choice", prompt = "« ___ trois ans dans une agence de voyage. » (votre expérience)", options = listOf("J'ai travaillé", "Je travaille", "Je vais travailler", "Je travaillais"), answers = listOf("J'ai travaillé"), explain = "Passé composé pour l'expérience achevée : j'ai travaillé trois ans."), Exercise(id = "fr-foundations-u21-entretien-e2", kind = "gap", prompt = "Je suis ___ : je vérifie tout deux fois. (un point fort, masculin)", options = listOf(), answers = listOf("rigoureux"), explain = "Rigoureux : qui fait tout avec précision, un point fort recherché."), Exercise(id = "fr-foundations-u21-entretien-e3", kind = "order", prompt = "Conclus l'entretien avec confiance.", options = listOf(), answers = listOf("Donc je crois que ce poste est fait pour moi"), explain = "Donc + conclusion : la dernière phrase attendue du candidat."), Exercise(id = "fr-foundations-u21-entretien-e4", kind = "written", prompt = "Tu as géré les réservations : dis-le au passé.", options = listOf(), answers = listOf("j'ai géré les réservations", "j'ai gere les reservations", "j'ai géré les réservations de l'agence"), explain = "Gérer → géré : avoir + participe, la responsabilité au passé.")), skills = listOf("function:talk-about-work", "vocab:work", "grammar:present-perfect", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-perfect")),
    Lesson(id = "fr-foundations-u21-collègues", title = "Avec les collègues", goal = "Décrire l'ambiance de l'équipe et les collègues : l'ambiance est détendue, on s'entraide, par contre les journées sont longues.", intro = LessonIntro(explanation = listOf("L'ambiance avec être + adjectif : « L'ambiance est détendue. » « L'équipe est soudée. »", "Les habitudes avec on + présent : « On s'entraide quand il y a un problème. » « On déjeune ensemble le vendredi. »", "On nuance avec par contre : « Le travail est intéressant, par contre les journées sont longues. »"), examples = listOf(ExampleLine(text = "L'ambiance est vraiment détendue.", meaning = "L'atmosphère du travail."), ExampleLine(text = "On s'entraide quand il y a un problème.", meaning = "L'entraide de l'équipe."), ExampleLine(text = "Ma collègue Julie est toujours disponible.", meaning = "Décrire une personne."), ExampleLine(text = "On déjeune ensemble le vendredi.", meaning = "L'habitude d'équipe."), ExampleLine(text = "Par contre, les journées sont longues.", meaning = "La nuance."))), expressions = listOf(TargetExpression(text = "l'ambiance est + adjectif", meaning = "L'atmosphère du travail.", note = "détendue, sérieuse, stressante."), TargetExpression(text = "on s'entraide", meaning = "L'équipe qui s'aide.", note = "s'entraider = s'aider."), TargetExpression(text = "on + présent", meaning = "Les habitudes d'équipe.", note = "On déjeune ensemble."), TargetExpression(text = "par contre", meaning = "La nuance, le contraste.", note = "Intéressant, par contre long."), TargetExpression(text = "être disponible / à l'écoute", meaning = "Le collègue fiable.", note = "toujours prêt à aider.")), situation = "Premier jour dans la nouvelle équipe : un collègue vous présente l'ambiance détendue, Julie qui aide toujours tout le monde, le déjeuner du vendredi — et les journées longues.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Décris l'atmosphère : détendue.", expected = listOf("L'ambiance est détendue.", "L'ambiance est vraiment détendue."), focus = "l'ambiance est", watch = "être + adjectif pour l'atmosphère."), PracticeQuestion(prompt = "Dis que l'équipe s'aide.", expected = listOf("On s'entraide.", "L'équipe s'entraide."), focus = "s'entraider", watch = "s'entraide = s'aide."), PracticeQuestion(prompt = "Julie aide toujours : décris-la.", expected = listOf("Julie est toujours disponible.", "Julie est disponible à toute heure."), focus = "disponible", watch = "disponible = prête à aider."), PracticeQuestion(prompt = "L'habitude du vendredi : déjeuner ensemble. Dis-le.", expected = listOf("On déjeune ensemble le vendredi.", "Le vendredi, on déjeune ensemble."), focus = "on + présent", watch = "le présent dit l'habitude."), PracticeQuestion(prompt = "Le travail est intéressant, mais les journées sont longues : nuance avec par contre.", expected = listOf("Le travail est intéressant, par contre les journées sont longues.", "Par contre, les journées sont longues."), focus = "par contre", watch = "par contre pose le contraste."))), exercises = listOf(Exercise(id = "fr-foundations-u21-collègues-e1", kind = "choice", prompt = "L'___ est détendue dans notre équipe.", options = listOf("ambiance", "aventure", "agence", "addition"), answers = listOf("ambiance"), explain = "L'ambiance : l'atmosphère générale du travail."), Exercise(id = "fr-foundations-u21-collègues-e2", kind = "gap", prompt = "On s'___ quand quelqu'un a un problème. (l'équipe s'aide)", options = listOf(), answers = listOf("entraide"), explain = "On s'entraide : chacun aide les autres."), Exercise(id = "fr-foundations-u21-collègues-e3", kind = "order", prompt = "Nuance : le travail est intéressant, mais les journées sont longues (formule : par contre).", options = listOf(), answers = listOf("Le travail est intéressant par contre les journées sont longues"), explain = "Phrase + par contre + contraste : la nuance d'équipe."), Exercise(id = "fr-foundations-u21-collègues-e4", kind = "written", prompt = "Ton collègue écoute bien tout le monde. Dis-le.", options = listOf(), answers = listOf("il est à l'écoute", "il est a l'ecoute", "il est toujours à l'écoute"), explain = "Être à l'écoute : le collègue qui prend le temps d'écouter.")), skills = listOf("function:talk-about-work", "vocab:work", "function:describe-people", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "fr-foundations-u21-buts", title = "Les projets pro", goal = "Parler de ses objectifs professionnels : j'aimerais devenir chef d'équipe, je veux atteindre ce poste, à terme…", intro = LessonIntro(explanation = listOf("L'objectif avec modestie : « J'aimerais devenir chef d'équipe. » — le conditionnel reste poli.", "L'ambition datée avec je veux atteindre : « Je veux atteindre cet objectif dans deux ans. »", "Le plan en étapes : « D'abord je me forme, ensuite je candidate, et à terme je voudrais monter une agence. »"), examples = listOf(ExampleLine(text = "J'aimerais devenir chef d'équipe.", meaning = "L'objectif poli."), ExampleLine(text = "Je veux atteindre cet objectif dans deux ans.", meaning = "L'ambition datée."), ExampleLine(text = "À terme, je voudrais monter une agence.", meaning = "Le projet de long terme."), ExampleLine(text = "D'abord, je me forme au métier.", meaning = "La première étape."), ExampleLine(text = "Ensuite, je candidate en interne.", meaning = "L'étape suivante."))), expressions = listOf(TargetExpression(text = "j'aimerais + infinitif", meaning = "L'objectif avec modestie.", note = "J'aimerais évoluer."), TargetExpression(text = "je veux atteindre + objectif", meaning = "L'ambition claire.", note = "atteindre un poste, un chiffre."), TargetExpression(text = "à terme", meaning = "Dans le long terme.", note = "À terme, je m'installe."), TargetExpression(text = "devenir + métier", meaning = "Le changement de rôle.", note = "devenir chef, devenir formatrice."), TargetExpression(text = "d'abord… ensuite…", meaning = "Les étapes du plan.", note = "D'abord me former, ensuite candidater.")), situation = "Avec votre responsable, vous parlez projet : devenir chef d'équipe, atteindre le poste dans deux ans, et à terme monter une petite agence.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ton objectif avec modestie : devenir chef d'équipe.", expected = listOf("J'aimerais devenir chef d'équipe.", "J'aimerais devenir chef d'equipe"), focus = "j'aimerais", watch = "le conditionnel reste poli."), PracticeQuestion(prompt = "Sois ambitieux : ce poste dans deux ans.", expected = listOf("Je veux atteindre ce poste dans deux ans.", "Je veux atteindre cet objectif dans deux ans."), focus = "je veux atteindre", watch = "atteindre un objectif = y arriver."), PracticeQuestion(prompt = "Le long terme : monter une agence.", expected = listOf("À terme, je voudrais monter une agence.", "À terme je voudrais monter une agence."), focus = "à terme", watch = "à terme = dans quelques années."), PracticeQuestion(prompt = "La première étape : se former.", expected = listOf("D'abord, je me forme au métier.", "D'abord je me forme."), focus = "d'abord", watch = "d'abord ouvre le plan."), PracticeQuestion(prompt = "L'étape suivante : candidater en interne.", expected = listOf("Ensuite, je candidate en interne.", "Ensuite je candidate en interne."), focus = "ensuite", watch = "ensuite enchaîne l'étape."))), exercises = listOf(Exercise(id = "fr-foundations-u21-buts-e1", kind = "choice", prompt = "« ___ , j'aimerais ouvrir ma propre agence. » (le long terme)", options = listOf("À terme", "À peine", "À côté", "À part"), answers = listOf("À terme"), explain = "À terme : dans le long terme, l'horizon du projet."), Exercise(id = "fr-foundations-u21-buts-e2", kind = "gap", prompt = "Je ___ atteindre cet objectif d'ici deux ans. (verbe : vouloir, présent)", options = listOf(), answers = listOf("veux"), explain = "Je veux atteindre : l'ambition claire et datée."), Exercise(id = "fr-foundations-u21-buts-e3", kind = "order", prompt = "Parle de ton projet de long terme (agence).", options = listOf(), answers = listOf("À terme je voudrais monter une agence"), explain = "À terme + conditionnel : le rêve de long terme."), Exercise(id = "fr-foundations-u21-buts-e4", kind = "written", prompt = "Ton plan : d'abord te former. Dis-le.", options = listOf(), answers = listOf("d'abord je me forme", "d'abord je me forme au métier", "d'abord je me forme au metier"), explain = "D'abord, je me forme : la première étape du plan.")), skills = listOf("function:describe-goals", "function:talk-about-work", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors"))))
}

object FrFoundationsU26 {
    val unit = CourseUnit(id = "fr-foundations-u26", title = "La ville que je veux", subtitle = "Opinions et quartier", level = "B1", themes = listOf(ConversationTheme("le-conseil", "Le conseil de quartier", "D'un côté, de l'autre", "building.2", "Course", "Réunion du conseil de quartier : pour ou contre le parking souterrain, chacun argumente et on pèse le pour et le contre.", 0),
                ConversationTheme("la-consommation", "Consommer autrement", "Local et responsable", "leaf", "Course", "Atelier consommation responsable : marché local, zéro déchet, et des propositions concrètes pour le quartier.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u26-opiner", title = "D'un côté, de l'autre", goal = "Donner son opinion et la nuancer : à mon avis, d'un côté… de l'autre…, je ne suis pas d'accord parce que…", intro = LessonIntro(explanation = listOf("L'opinion se pose avec à mon avis / je trouve que : « À mon avis, ce parking est utile. »", "On pèse avec d'un côté… de l'autre… : « D'un côté, ça libère la place ; de l'autre, ça coûte cher. »", "Pour désaccordé poliment : « Je ne suis pas d'accord, parce que les chiffres disent le contraire. »"), examples = listOf(ExampleLine(text = "À mon avis, ce parking est une bonne idée.", meaning = "L'opinion posée."), ExampleLine(text = "Je trouve que la rue a besoin d'air.", meaning = "L'opinion avec trouver."), ExampleLine(text = "D'un côté, ça libère la place du marché.", meaning = "L'argument pour."), ExampleLine(text = "De l'autre, ça va coûter très cher.", meaning = "L'argument contre."), ExampleLine(text = "Je ne suis pas d'accord, parce que…", meaning = "Le désaccord argumenté."), ExampleLine(text = "Tu as raison, mais les chiffres parlent.", meaning = "Concéder puis nuancer."))), expressions = listOf(TargetExpression(text = "à mon avis / je trouve que", meaning = "Poser son opinion.", note = "À mon avis, c'est utile."), TargetExpression(text = "d'un côté… de l'autre…", meaning = "Peser le pour et le contre.", note = "D'un côté oui, de l'autre non."), TargetExpression(text = "je ne suis pas d'accord parce que", meaning = "Le désaccord poli.", note = "…parce que les chiffres parlent."), TargetExpression(text = "tu as raison, mais", meaning = "Concéder puis nuancer.", note = "Tu as raison, mais c'est cher."), TargetExpression(text = "en revanche", meaning = "Le contraste soutenu.", note = "C'est cher, en revanche c'est propre."), TargetExpression(text = "peser le pour et le contre", meaning = "Examiner les deux faces.", note = "avant de voter, on pèse.")), situation = "Conseil de quartier : le parking souterrain divise la salle — avis posés, pour et contre pesés, et chacun nuance sans casser l'ambiance.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Donne ton avis : le parking est utile.", expected = listOf("À mon avis, ce parking est utile.", "Je trouve que ce parking est utile."), focus = "à mon avis", watch = "à mon avis + phrase : l'opinion assumée."), PracticeQuestion(prompt = "Pèse le pour et le contre : place libérée / coût élevé.", expected = listOf("D'un côté ça libère la place, de l'autre ça coûte cher."), focus = "d'un côté… de l'autre", watch = "les deux faces dans une seule phrase."), PracticeQuestion(prompt = "Tu n'es pas d'accord : les chiffres disent le contraire.", expected = listOf("Je ne suis pas d'accord, parce que les chiffres disent le contraire.", "Je ne suis pas d'accord parce que c'est trop cher."), focus = "je ne suis pas d'accord", watch = "parce que + l'argument : le désaccord reste poli."), PracticeQuestion(prompt = "Ton voisin a partiellement raison : concède puis nuance (c'est cher).", expected = listOf("Tu as raison, mais c'est très cher.", "Tu as raison, mais c'est cher."), focus = "tu as raison, mais", watch = "on concède d'abord, on nuance ensuite."), PracticeQuestion(prompt = "Contraste avec en revanche : cher mais propre.", expected = listOf("C'est cher, en revanche c'est propre."), focus = "en revanche", watch = "en revanche pose le contraste fort."))), exercises = listOf(Exercise(id = "fr-foundations-u26-opiner-e1", kind = "choice", prompt = "« ___ , ce parking est une bonne idée. » (poser son opinion)", options = listOf("À mon avis", "Tout à fait", "Bien sûr", "D'accord"), answers = listOf("À mon avis"), explain = "À mon avis + phrase : la marque de l'opinion."), Exercise(id = "fr-foundations-u26-opiner-e2", kind = "gap", prompt = "Je ne suis pas d'accord, ___ les chiffres disent le contraire. (l'argument)", options = listOf(), answers = listOf("parce que", "car"), explain = "Parce que + cause : le désaccord argumenté."), Exercise(id = "fr-foundations-u26-opiner-e3", kind = "order", prompt = "Pèse le pour et le contre (place libérée / coût élevé).", options = listOf(), answers = listOf("D'un côté ça libère la place de l'autre ça coûte cher"), explain = "D'un côté… de l'autre… : les deux faces de l'argument."), Exercise(id = "fr-foundations-u26-opiner-e4", kind = "written", prompt = "Nuance : ton collègue a raison, mais c'est cher.", options = listOf(), answers = listOf("tu as raison mais c'est cher", "tu as raison mais c est cher", "tu as raison mais c'est tres cher"), explain = "Tu as raison, mais : on concède puis on nuance.")), skills = listOf("function:express-opinion", "grammar:connectors", "speaking:justify-opinion", "grammar:comparatives"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "fr-foundations-u26-proposition", title = "Nous proposons de…", goal = "Faire une proposition au quartier : nous proposons de, il faudrait, on pourrait — et conclure concrètement.", intro = LessonIntro(explanation = listOf("La proposition avec nous proposons de + infinitif : « Nous proposons de créer un marché couvert. »", "Les idées au conditionnel : « Il faudrait plus de pistes cyclables. » « On pourrait végétaliser la place. »", "On rend l'idée concrète, puis on ouvre le débat : « Concrètement, ça veut dire dix arbres. Qu'est-ce que vous en pensez ? »"), examples = listOf(ExampleLine(text = "Nous proposons de créer un marché couvert.", meaning = "La proposition officielle."), ExampleLine(text = "Il faudrait plus de pistes cyclables.", meaning = "Le besoin exprimé."), ExampleLine(text = "On pourrait aussi végétaliser la place.", meaning = "L'idée complémentaire."), ExampleLine(text = "Ce serait mieux pour les enfants.", meaning = "L'argument du conditionnel."), ExampleLine(text = "Concrètement, ça veut dire dix arbres.", meaning = "L'idée qui se chiffre."), ExampleLine(text = "Qu'est-ce que vous en pensez ?", meaning = "Ouvrir le débat."))), expressions = listOf(TargetExpression(text = "nous proposons de + infinitif", meaning = "La proposition formelle.", note = "…de créer un marché."), TargetExpression(text = "il faudrait + nom/infinitif", meaning = "Le besoin au conditionnel.", note = "Il faudrait des arbres."), TargetExpression(text = "on pourrait + infinitif", meaning = "L'idée douce.", note = "On pourrait essayer."), TargetExpression(text = "concrètement", meaning = "Passer du rêve au plan.", note = "Concrètement : dix arbres."), TargetExpression(text = "qu'est-ce que vous en pensez ?", meaning = "Inviter la réaction.", note = "le pronom en = de ça."), TargetExpression(text = "ce serait mieux", meaning = "Comparer au conditionnel.", note = "Ce serait mieux pour tout le monde.")), situation = "À la réunion, vous proposez le marché couvert, vous ajoutez pistes cyclables et arbres, vous chiffrez — et vous demandez l'avis de la salle.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Formalisez la proposition : créer un marché couvert.", expected = listOf("Nous proposons de créer un marché couvert."), focus = "nous proposons de", watch = "proposer de + infinitif : la forme formelle."), PracticeQuestion(prompt = "Exprimez le besoin : des pistes cyclables.", expected = listOf("Il faudrait plus de pistes cyclables.", "Il faudrait des pistes cyclables."), focus = "il faudrait", watch = "le conditionnel adoucit la demande."), PracticeQuestion(prompt = "Ajoutez une idée douce : végétaliser la place.", expected = listOf("On pourrait végétaliser la place.", "On pourrait aussi végétaliser la place."), focus = "on pourrait", watch = "pourrait + infinitif : l'idée sans imposition."), PracticeQuestion(prompt = "Rendez l'idée concrète : dix arbres.", expected = listOf("Concrètement, ça veut dire dix arbres."), focus = "concrètement", watch = "concrètement + les chiffres : l'idée devient plan."), PracticeQuestion(prompt = "Ouvrez le débat.", expected = listOf("Qu'est-ce que vous en pensez ?", "Qu'est-ce que vous en pensez"), focus = "vous en pensez", watch = "en = de cette idée."))), exercises = listOf(Exercise(id = "fr-foundations-u26-proposition-e1", kind = "choice", prompt = "« Nous ___ de créer un marché couvert. »", options = listOf("proposons", "pensons", "disons", "voulons"), answers = listOf("proposons"), explain = "Nous proposons de + infinitif : la proposition formelle."), Exercise(id = "fr-foundations-u26-proposition-e2", kind = "gap", prompt = "Il ___ plus de pistes cyclables. (le besoin, conditionnel de falloir)", options = listOf(), answers = listOf("faudrait"), explain = "Il faudrait : le besoin adouci au conditionnel."), Exercise(id = "fr-foundations-u26-proposition-e3", kind = "order", prompt = "Invitez la salle à réagir.", options = listOf(), answers = listOf("Qu'est-ce que vous en pensez"), explain = "Qu'est-ce que vous en pensez ? : la question qui ouvre le débat."), Exercise(id = "fr-foundations-u26-proposition-e4", kind = "written", prompt = "Rendez l'idée concrète : dix arbres.", options = listOf(), answers = listOf("concretement ca veut dire dix arbres", "concrètement ça veut dire dix arbres", "concretement cela veut dire dix arbres"), explain = "Concrètement, ça veut dire + chiffres : du rêve au plan.")), skills = listOf("grammar:connectors", "function:express-opinion", "speaking:justify-opinion", "writing:argument"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "fr-foundations-u26-consommer", title = "Acheter local", goal = "Argumenter pour la consommation responsable : d'abord… ensuite… enfin…, c'est pourquoi, et conclure avec pour conclure.", intro = LessonIntro(explanation = listOf("L'argumentation s'ordonne : « D'abord le prix, ensuite la qualité, enfin l'environnement. »", "On relie cause et conséquence : « Les fruits de saison ont meilleur goût, c'est pourquoi je préfère le marché. »", "La conclusion assumée : « Pour conclure, acheter local, c'est soutenir son quartier. »"), examples = listOf(ExampleLine(text = "Acheter local, c'est soutenir les commerçants.", meaning = "La thèse simple."), ExampleLine(text = "D'abord le prix, ensuite la qualité.", meaning = "Le plan de l'argument."), ExampleLine(text = "Les fruits de saison ont meilleur goût.", meaning = "L'argument du goût."), ExampleLine(text = "C'est pourquoi je préfère le marché.", meaning = "La conséquence logique."), ExampleLine(text = "Au lieu d'acheter neuf, on répare.", meaning = "L'alternative."), ExampleLine(text = "Pour conclure, c'est un choix pour le quartier.", meaning = "La conclusion."))), expressions = listOf(TargetExpression(text = "acheter local", meaning = "La thèse responsable.", note = "Acheter local, c'est voter quartier."), TargetExpression(text = "d'abord… ensuite… enfin…", meaning = "L'argument ordonné.", note = "Enfin, l'environnement."), TargetExpression(text = "c'est pourquoi", meaning = "La conséquence.", note = "…, c'est pourquoi j'y vais."), TargetExpression(text = "au lieu de + infinitif", meaning = "L'alternative.", note = "Au lieu de jeter, on répare."), TargetExpression(text = "pour conclure", meaning = "La conclusion marquée.", note = "Pour conclure, ce choix nous relie."), TargetExpression(text = "de saison", meaning = "Le produit du moment.", note = "les légumes de saison.")), situation = "À l'atelier consommation responsable : vous plaidez pour le marché local — prix, goût, environnement — et vous concluez : acheter local, c'est soutenir son quartier.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pose ta thèse : acheter local = soutenir les commerçants.", expected = listOf("Acheter local, c'est soutenir les commerçants."), focus = "acheter local", watch = "infinitif + c'est : la thèse en une phrase."), PracticeQuestion(prompt = "Ordonne tes arguments : prix, qualité, environnement.", expected = listOf("D'abord le prix, ensuite la qualité, enfin l'environnement."), focus = "d'abord… ensuite… enfin", watch = "les connecteurs structurent l'argumentation."), PracticeQuestion(prompt = "Relie cause et conséquence : meilleur goût, donc le marché.", expected = listOf("Les fruits de saison ont meilleur goût, c'est pourquoi je préfère le marché."), focus = "c'est pourquoi", watch = "c'est pourquoi + conséquence : la logique visible."), PracticeQuestion(prompt = "Propose l'alternative : réparer plutôt que jeter.", expected = listOf("Au lieu de jeter, on répare.", "Au lieu d'acheter neuf, on répare."), focus = "au lieu de", watch = "au lieu de + infinitif : l'alternative assumée."), PracticeQuestion(prompt = "Conclus avec la formule marquée.", expected = listOf("Pour conclure, acheter local, c'est soutenir son quartier.", "Pour conclure, c'est un choix pour le quartier."), focus = "pour conclure", watch = "pour conclure + thèse : la dernière impression compte."))), exercises = listOf(Exercise(id = "fr-foundations-u26-consommer-e1", kind = "choice", prompt = "« Les fruits de saison ont ___ goût. » (comparatif de bon)", options = listOf("meilleur", "plus bon", "mieux", "bien"), answers = listOf("meilleur"), explain = "Bon fait meilleur : le comparatif irrégulier."), Exercise(id = "fr-foundations-u26-consommer-e2", kind = "gap", prompt = "Au ___ de jeter, on répare. (l'alternative)", options = listOf(), answers = listOf("lieu"), explain = "Au lieu de + infinitif : l'alternative qui s'assume."), Exercise(id = "fr-foundations-u26-consommer-e3", kind = "order", prompt = "Reliez l'argument du goût à votre choix (c'est pourquoi).", options = listOf(), answers = listOf("C'est pourquoi je préfère le marché"), explain = "C'est pourquoi + conséquence : l'argument aboutit au choix."), Exercise(id = "fr-foundations-u26-consommer-e4", kind = "written", prompt = "Conclus ton argument pour le marché local.", options = listOf(), answers = listOf("pour conclure acheter local c'est soutenir son quartier", "pour conclure acheter local c'est soutenir le quartier", "en conclusion acheter local soutient le quartier"), explain = "Pour conclure + thèse : la conclusion qui reste.")), skills = listOf("writing:argument", "grammar:connectors", "function:express-opinion", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors"))))
}

object FrFoundationsU7 {
    val unit = CourseUnit(id = "fr-foundations-u7", title = "Opinions et nuances", subtitle = "Si j'avais…", level = "B2", themes = listOf(ConversationTheme("fr-b2-hypothese", "Plans impossibles", "Si j'avais le temps", "sparkles", "Course", "Vous débatez de ce que vous feriez avec du temps infini, puis un vrai compromis.", 0),
                ConversationTheme("fr-b2-marche", "Le marchandage", "Et si on se retrouvait à 50 ?", "handshake", "Course", "Vous négociez un achat d'occasion : offre, conditions, accord.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u7-hypothetique", title = "Si j'avais le temps…", goal = "Opiner sur l'irréel : si + imparfait, puis le conditionnel.", intro = LessonIntro(explanation = listOf("L'hypothèse irréelle : « Si j'avais plus de temps, je voyagerais plus ». Si + imparfait, puis conditionnel (-rais).", "Jamais « si + conditionnel » : on dit « si j'avais », pas « si j'aurais ».", "Pour conseiller avec tact : « À ta place, j'essaierais », « Ce n'est pas que je ne veux pas ; c'est que je ne peux pas »."), examples = listOf(ExampleLine(text = "Si j'avais plus de temps, je voyagerais plus.", meaning = "Irréel du présent."), ExampleLine(text = "À ta place, j'essaierais.", meaning = "Conseil avec tact."), ExampleLine(text = "Si je pouvais, je changerais de travail.", meaning = "pouvoir → pouvais / pourrais."), ExampleLine(text = "Et si on se voyait jeudi ?", meaning = "Proposition douce."), ExampleLine(text = "Ce n'est pas que je ne veux pas ; je ne peux pas.", meaning = "Nuance vouloir/pouvoir."))), expressions = listOf(TargetExpression(text = "si + imparfait, …-rais", meaning = "Hypothèse.", note = "Si j'avais…, je voyagerais."), TargetExpression(text = "avoir → avais", meaning = "Imparfait clé.", note = "Si j'avais le temps."), TargetExpression(text = "pouvoir → pouvais", meaning = "Imparfait clé.", note = "Si je pouvais, je le ferais."), TargetExpression(text = "à ta place, je …-rais", meaning = "Conseil.", note = "…j'essaierais."), TargetExpression(text = "et si + imparfait ?", meaning = "Proposition.", note = "Et si on essayait ?")), situation = "Vous débnez des plans impossibles : plus de temps, un autre métier, une autre ville — puis un vrai compromis pour ce mois-ci.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ton hypothèse : si tu avais plus de temps, tu voyagerais plus.", expected = listOf("Si j'avais plus de temps je voyagerais plus", "Si j'avais plus de temps, je voyagerais plus"), focus = "si + imparfait", watch = "Imparfait puis conditionnel."), PracticeQuestion(prompt = "Conseil avec tact : à ta place, j'essaierais.", expected = listOf("A ta place j'essaierais", "À ta place, j'essaierais", "À ta place j'essaierais"), focus = "à ta place", watch = "À ta place + conditionnel."), PracticeQuestion(prompt = "Dis que si tu pouvais, tu changerais de travail.", expected = listOf("Si je pouvais je changerais de travail", "Si je pouvais, je changerais de travail"), focus = "pouvais/pourrais", watch = "Si je pouvais… je changerais."), PracticeQuestion(prompt = "Propose : et si on se voyait jeudi ?", expected = listOf("Et si on se voyait jeudi", "Et si on se voyait jeudi ?"), focus = "et si… ?", watch = "Et si + imparfait."), PracticeQuestion(prompt = "Nuance : ce n'est pas que je ne veux pas ; c'est que je ne peux pas.", expected = listOf("Ce n'est pas que je ne veux pas c'est que je ne peux pas", "Ce n'est pas que je ne veux pas ; c'est que je ne peux pas"), focus = "ce n'est pas que", watch = "Nuance avec point-virgule."))), exercises = listOf(Exercise(id = "fr-foundations-u7-hypothetique-e1", kind = "choice", prompt = "Si ___ plus de temps, je voyagerais plus.", options = listOf("j'avais", "j'aurais", "j'ai", "j'avais eu"), answers = listOf("j'avais"), explain = "Si + imparfait, jamais si + conditionnel."), Exercise(id = "fr-foundations-u7-hypothetique-e2", kind = "gap", prompt = "Si je pouvais, je ___ de travail. (changer, conditionnel)", options = listOf(), answers = listOf("changerais", "changerais pas"), explain = "Si je pouvais… je changerais."), Exercise(id = "fr-foundations-u7-hypothetique-e3", kind = "order", prompt = "Conseil : à ta place, j'essaierais.", options = listOf(), answers = listOf("À ta place, j'essaierais"), explain = "à ta place + conditionnel."), Exercise(id = "fr-foundations-u7-hypothetique-e4", kind = "written", prompt = "Ton hypothèse : si tu pouvais, tu changerais de travail.", options = listOf(), answers = listOf("si je pouvais je changerais de travail", "si je pouvais, je changerais de travail"), explain = "Si + imparfait + conditionnel.")), skills = listOf("grammar:second-conditional", "function:express-opinion", "speaking:justify-opinion", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:past-simple-irregular", "grammar:connectors")),
    Lesson(id = "fr-foundations-u7-registre", title = "On dit que…", goal = "Rapporter ce que d'autres affirment : l'impersonnel avec « on » et la voix passive.", intro = LessonIntro(explanation = listOf("L'impersonnel : « On dit que le quartier change ». On ne sait pas qui parle.", "La voix passive : « Le concert a été annulé », « Les billets sont épuisés ». Langage des infos.", "La passive monte le registre ; « on » le garde courant."), examples = listOf(ExampleLine(text = "On dit que le quartier va changer.", meaning = "Impersonnel : rumeur."), ExampleLine(text = "Le concert a été annulé à cause de la pluie.", meaning = "Passé composé passif."), ExampleLine(text = "Les billets sont épuisés.", meaning = "Passif d'état."), ExampleLine(text = "Tous les trains ont été supprimés.", meaning = "Info officielle."), ExampleLine(text = "D'après la mairie, les travaux prendront du retard.", meaning = "Source + futur."))), expressions = listOf(TargetExpression(text = "on dit que…", meaning = "Rumeur.", note = "…le quartier va changer."), TargetExpression(text = "a été + participe", meaning = "Passif.", note = "a été annulé."), TargetExpression(text = "est/sont + participe", meaning = "État.", note = "sont épuisés."), TargetExpression(text = "d'après + source", meaning = "Citer.", note = "d'après la mairie."), TargetExpression(text = "il est prévu que…", meaning = "Officiel.", note = "…les travaux…")), situation = "Vous commentez les infos du quartier : ce qu'on dit, ce qui a été décidé et quelle source vous croyez le moins.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Transmets la rumeur : on dit que le quartier va changer.", expected = listOf("On dit que le quartier va changer"), focus = "on dit que", watch = "Impersonnel, pas de sujet."), PracticeQuestion(prompt = "Info : le concert a été annulé à cause de la pluie.", expected = listOf("Le concert a ete annule a cause de la pluie", "Le concert a été annulé à cause de la pluie"), focus = "a été annulé", watch = "Passé composé passif."), PracticeQuestion(prompt = "Dis que les billets sont épuisés.", expected = listOf("Les billets sont epuises", "Les billets sont épuisés"), focus = "sont épuisés", watch = "Passif d'état."), PracticeQuestion(prompt = "Cite la source : d'après la mairie, les travaux prendront du retard.", expected = listOf("D'apres la mairie les travaux prendront du retard", "D'après la mairie, les travaux prendront du retard"), focus = "d'après", watch = "D'après + source."), PracticeQuestion(prompt = "Dis que tous les trains ont été supprimés.", expected = listOf("Tous les trains ont ete supprimes", "Tous les trains ont été supprimés"), focus = "ont été supprimés", watch = "Passif + participe."))), exercises = listOf(Exercise(id = "fr-foundations-u7-registre-e1", kind = "choice", prompt = "___ dit que le quartier va changer.", options = listOf("On", "Il", "Ça", "Ils"), answers = listOf("On"), explain = "Impersonnel : on dit que."), Exercise(id = "fr-foundations-u7-registre-e2", kind = "gap", prompt = "Le concert a été ___ à cause de la pluie. (annuler)", options = listOf(), answers = listOf("annulé", "annule"), explain = "a été + participe passé."), Exercise(id = "fr-foundations-u7-registre-e3", kind = "order", prompt = "Info : tous les trains ont été supprimés.", options = listOf(), answers = listOf("Tous les trains ont été supprimés"), explain = "Passé composé passif."), Exercise(id = "fr-foundations-u7-registre-e4", kind = "written", prompt = "Rumeur : un marché va ouvrir, tu l'as entendu dire.", options = listOf(), answers = listOf("on dit qu'un nouveau marche va ouvrir", "on dit qu'un nouveau marché va ouvrir"), explain = "On dit que + futur proche.")), skills = listOf("grammar:passive-intro", "grammar:present-perfect", "function:express-opinion", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:past-simple-regular", "grammar:verb-be")),
    Lesson(id = "fr-foundations-u7-negocier", title = "Et si on se retrouvait à 50 ?", goal = "Négocier un accord : proposer au conditionnel, poser des conditions, conclure.", intro = LessonIntro(explanation = listOf("Proposer : « Et si on se retrouvait à 50 ? », « Je vous donnerais 60 si vous incluez le transport ».", "Poser des conditions : « Seulement si c'est livré aujourd'hui », « En échange, je veux la garantie ».", "Conclure : « Marché conclu », « D'accord, mais avec une condition »."), examples = listOf(ExampleLine(text = "Et si on se retrouvait à 50 ?", meaning = "Proposition à l'imparfait."), ExampleLine(text = "Je vous donnerais 60 si vous incluez le transport.", meaning = "Conditionnel + si + présent."), ExampleLine(text = "Seulement si c'est livré aujourd'hui.", meaning = "Condition ferme."), ExampleLine(text = "En échange, je veux la garantie.", meaning = "Contre-offre."), ExampleLine(text = "Marché conclu.", meaning = "Conclusion."))), expressions = listOf(TargetExpression(text = "et si + imparfait ?", meaning = "Proposer.", note = "Et si on se retrouvait à… ?"), TargetExpression(text = "je …-rais si + présent", meaning = "Conditions.", note = "je vous donnerais 60 si…"), TargetExpression(text = "seulement si…", meaning = "Condition ferme.", note = "seulement si c'est aujourd'hui."), TargetExpression(text = "en échange, …", meaning = "Contre-offre.", note = "…la garantie."), TargetExpression(text = "marché conclu", meaning = "Conclure.", note = "après l'accord.")), situation = "Vous marchandez une table d'occasion : première offre haute, offres conditionnelles, puis terrain d'entente.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Propose : et si on se retrouvait à 50 ?", expected = listOf("Et si on se retrouvait a 50", "Et si on se retrouvait à 50 ?", "Et si on se retrouvait à 50"), focus = "et si + imparfait", watch = "se retrouvait : proposition."), PracticeQuestion(prompt = "Offre conditionnelle : je vous donnerais 60 si vous incluez le transport.", expected = listOf("Je vous donnerais 60 si vous incluez le transport"), focus = "donnerais si", watch = "Conditionnel + si + présent."), PracticeQuestion(prompt = "Condition ferme : seulement si c'est livré aujourd'hui.", expected = listOf("Seulement si c'est livre aujourd'hui", "Seulement si c'est livré aujourd'hui"), focus = "seulement si", watch = "Si + présent."), PracticeQuestion(prompt = "Contre-offre : en échange, je veux la garantie.", expected = listOf("En echange je veux la garantie", "En échange, je veux la garantie"), focus = "en échange", watch = "En échange + présent."), PracticeQuestion(prompt = "Conclus l'accord.", expected = listOf("Marche conclu", "Marché conclu"), focus = "marché conclu", watch = "Formule fixe."))), exercises = listOf(Exercise(id = "fr-foundations-u7-negocier-e1", kind = "choice", prompt = "Et si on se ___ à 50 ?", options = listOf("retrouvait", "retrouvera", "retrouvé", "retrouver"), answers = listOf("retrouvait"), explain = "Proposition : et si + imparfait."), Exercise(id = "fr-foundations-u7-negocier-e2", kind = "gap", prompt = "Je vous ___ 60 si vous incluez le transport. (donner, conditionnel)", options = listOf(), answers = listOf("donnerais", "donnerai pas"), explain = "Conditionnel présent : donnerais."), Exercise(id = "fr-foundations-u7-negocier-e3", kind = "order", prompt = "Condition : seulement si c'est livré aujourd'hui.", options = listOf(), answers = listOf("Seulement si c'est livré aujourd'hui"), explain = "seulement si + présent."), Exercise(id = "fr-foundations-u7-negocier-e4", kind = "written", prompt = "Concluez, mais avec une réserve.", options = listOf(), answers = listOf("d'accord mais avec une condition", "d'accord, mais avec une condition"), explain = "D'accord, mais…")), skills = listOf("function:negotiate", "grammar:second-conditional", "speaking:negotiate", "grammar:connectors"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors"))))
}

object FrFoundationsU8 {
    val unit = CourseUnit(id = "fr-foundations-u8", title = "Médias et argument", subtitle = "La nouvelle que j'ai lue", level = "B2", themes = listOf(ConversationTheme("fr-b2-actu", "Semaine d'actu", "Ce qui s'est dit", "newspaper", "Course", "Vous résumez la semaine avec des relatives : qui, où, quoi.", 0),
                ConversationTheme("fr-b2-chronique", "Ta chronique", "D'un côté… de l'autre…", "pencil", "Course", "Vous écrivez une chronique sur la piétonnisation du centre.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u7-relatives", title = "La nouvelle que j'ai lue", goal = "Raconter l'actualité avec les relatives : qui, que, où, dont.", intro = LessonIntro(explanation = listOf("La relative précise le nom : « La nouvelle que j'ai lue dit que… », « Le journaliste qui l'a interviewé… ».", "« Où » pour les lieux : « La place où ils ont manifesté ». « Dont » remplit « de + qqch » : « l'affaire dont tout le monde parle ».", "Dans les infos, les relatives compressent : qui, où, quoi."), examples = listOf(ExampleLine(text = "La nouvelle que j'ai lue dit que…", meaning = "Relative objet."), ExampleLine(text = "Le journaliste qui l'a interviewé a démissionné.", meaning = "Relative sujet."), ExampleLine(text = "La place où ils ont manifesté est centrale.", meaning = "où + lieu."), ExampleLine(text = "L'affaire dont tout le monde parle a rebondi.", meaning = "dont = de + ça."), ExampleLine(text = "Tout ce que je sais vient de la radio.", meaning = "tout ce que + verbe."))), expressions = listOf(TargetExpression(text = "le/la que…", meaning = "Relative.", note = "la nouvelle que j'ai lue."), TargetExpression(text = "qui…", meaning = "Sujet/personne.", note = "qui l'a interviewé."), TargetExpression(text = "où…", meaning = "Lieu.", note = "la place où…"), TargetExpression(text = "dont…", meaning = "de + qqch.", note = "l'affaire dont…"), TargetExpression(text = "tout ce que…", meaning = "Généraliser.", note = "tout ce que je sais.")), situation = "Vous résumez une semaine d'actualité : l'histoire qui vous a marqué, la personne qui a parlé et le lieu où c'est arrivé.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Résume : la nouvelle que tu as lue dit que le musée agrandit ses horaires.", expected = listOf("La nouvelle que j'ai lue dit que le musee agrandit ses horaires", "La nouvelle que j'ai lue dit que le musée agrandit ses horaires"), focus = "que j'ai lue", watch = "Relative sur la nouvelle."), PracticeQuestion(prompt = "Dis qui : le journaliste qui l'a interviewé a démissionné.", expected = listOf("Le journaliste qui l'a interviewe a demissionne", "Le journaliste qui l'a interviewé a démissionné"), focus = "qui l'a interviewé", watch = "Relative sujet."), PracticeQuestion(prompt = "Lieu : la place où ils ont manifesté est centrale.", expected = listOf("La place ou ils ont manifeste est centrale", "La place où ils ont manifesté est centrale"), focus = "où", watch = "où + lieu."), PracticeQuestion(prompt = "Dont : l'affaire dont tout le monde parle a rebondi.", expected = listOf("L'affaire dont tout le monde parle a rebondi"), focus = "dont", watch = "dont = de + ça."), PracticeQuestion(prompt = "Généralise : tout ce que je sais vient de la radio.", expected = listOf("Tout ce que je sais vient de la radio"), focus = "tout ce que", watch = "tout ce que + verbe."))), exercises = listOf(Exercise(id = "fr-foundations-u7-relatives-e1", kind = "choice", prompt = "La nouvelle ___ j'ai lue dit que le musée s'agrandit.", options = listOf("que", "qui", "dont", "où"), answers = listOf("que"), explain = "Objet : la nouvelle que j'ai lue."), Exercise(id = "fr-foundations-u7-relatives-e2", kind = "gap", prompt = "La place ___ ils ont manifesté est centrale.", options = listOf(), answers = listOf("où", "ou"), explain = "Lieu : où."), Exercise(id = "fr-foundations-u7-relatives-e3", kind = "order", prompt = "Sujet : le journaliste qui l'a interviewé a démissionné.", options = listOf(), answers = listOf("Le journaliste qui l'a interviewé a démissionné"), explain = "Relative sujet."), Exercise(id = "fr-foundations-u7-relatives-e4", kind = "written", prompt = "Ton info : une rue va fermer (utilise « la nouvelle que j'ai lue »).", options = listOf(), answers = listOf("la nouvelle que j'ai lue dit que la rue fermera", "la nouvelle que j'ai lue dit que la rue va fermer"), explain = "La nouvelle que + passé composé.")), skills = listOf("grammar:relative-clauses", "grammar:present-perfect", "function:express-opinion", "vocab:work"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:present-perfect")),
    Lesson(id = "fr-foundations-u7-argumenter", title = "D'un côté… de l'autre…", goal = "Écrire et défendre une opinion structurée : thèse, arguments, concession, conclusion.", intro = LessonIntro(explanation = listOf("Structure : thèse (« Je pense qu'on devrait piétonniser le centre »), arguments (« d'un côté…, de l'autre… »), concession (« c'est vrai que…, mais… »).", "La concession crédibilise : tu reconnais l'argument adverse avant de le répondre.", "Conclusion avec poids : « Pour tout cela, je défends la mesure »."), examples = listOf(ExampleLine(text = "Je pense qu'on devrait piétonniser le centre.", meaning = "Thèse."), ExampleLine(text = "D'un côté, la pollution baisse.", meaning = "Argument 1."), ExampleLine(text = "De l'autre, le commerce souffre.", meaning = "Argument 2 (contraire)."), ExampleLine(text = "C'est vrai que c'est gênant, mais les chiffres disent autre chose.", meaning = "Concession + réponse."), ExampleLine(text = "Pour tout cela, je défends la mesure.", meaning = "Conclusion."))), expressions = listOf(TargetExpression(text = "je pense qu'on devrait…", meaning = "Thèse.", note = "…piétonniser."), TargetExpression(text = "d'un côté… de l'autre…", meaning = "Arguments.", note = "les deux faces."), TargetExpression(text = "c'est vrai que…, mais…", meaning = "Concession.", note = "reconnaître puis répondre."), TargetExpression(text = "les chiffres disent…", meaning = "Preuve.", note = "argument d'autorité."), TargetExpression(text = "pour tout cela, …", meaning = "Conclusion.", note = "registre soutenu.")), situation = "Vous écrivez une chronique d'opinion sur la piétonnisation du centre : thèse, deux faces, concession et conclusion.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Thèse : je pense qu'on devrait piétonniser le centre.", expected = listOf("Je pense qu'on devrait pietonniser le centre", "Je pense qu'on devrait piétonniser le centre"), focus = "je pense que", watch = "Thèse + devoir."), PracticeQuestion(prompt = "Argument 1 : d'un côté, la pollution baisse.", expected = listOf("D'un cote la pollution baisse", "D'un côté, la pollution baisse"), focus = "d'un côté", watch = "Premier argument."), PracticeQuestion(prompt = "Argument contraire : de l'autre, le commerce souffre.", expected = listOf("De l'autre le commerce souffre", "De l'autre, le commerce souffre"), focus = "de l'autre", watch = "Seconde face."), PracticeQuestion(prompt = "Concède : c'est vrai que c'est gênant, mais les chiffres disent autre chose.", expected = listOf("C'est vrai que c'est genant mais les chiffres disent autre chose", "C'est vrai que c'est gênant, mais les chiffres disent autre chose"), focus = "c'est vrai que", watch = "Concession + mais."), PracticeQuestion(prompt = "Conclus : pour tout cela, je défends la mesure.", expected = listOf("Pour tout cela je defends la mesure", "Pour tout cela, je défends la mesure"), focus = "pour tout cela", watch = "Conclusion formelle."))), exercises = listOf(Exercise(id = "fr-foundations-u7-argumenter-e1", kind = "choice", prompt = "___ un côté, la pollution baisse.", options = listOf("D'", "Pour", "Dans", "Par"), answers = listOf("D'"), explain = "d'un côté = premier argument."), Exercise(id = "fr-foundations-u7-argumenter-e2", kind = "gap", prompt = "C'est vrai que c'est gênant, ___ les chiffres disent autre chose.", options = listOf(), answers = listOf("mais"), explain = "Concession + contraste."), Exercise(id = "fr-foundations-u7-argumenter-e3", kind = "order", prompt = "Conclusion : pour tout cela, je défends la mesure.", options = listOf(), answers = listOf("Pour tout cela, je défends la mesure"), explain = "pour tout cela."), Exercise(id = "fr-foundations-u7-argumenter-e4", kind = "written", prompt = "Ta thèse sur l'extension du tramway.", options = listOf(), answers = listOf("je pense qu'on devrait prolonger le tramway", "je pense qu'on devrait agrandir le tram"), explain = "Je pense qu'on devrait…")), skills = listOf("writing:argument", "grammar:connectors", "function:express-opinion", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors"))))
}

object FrFoundationsU9 {
    val unit = CourseUnit(id = "fr-foundations-u9", title = "Nuances et registres", subtitle = "Le dire mieux", level = "C1", themes = listOf(ConversationTheme("fr-c1-registres", "Les registres", "Soutenu ou familier", "sparkles", "Course", "Vous réécrivez un e-mail trop familier, puis un e-mail trop raide, jusqu'à trouver le ton juste.", 0),
                ConversationTheme("fr-c1-nuancer", "Nuancer", "Plus ou moins", "bubble-left-and-text", "Course", "En réunion, tout le monde tranche ; vous, vous accordez, conditionnez et modulez sans vous contredire.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u9-registre", title = "Comment le dire", goal = "Choisir le bon registre : du e-mail soutenu à la remarque orale, sans fausse note.", intro = LessonIntro(explanation = listOf("Le registre se joue d'abord sur les verbes : « Je me permets de vous écrire » (soutenu) remplace « Je t'envoie un mot » (familier).", "À l'écrit professionnel, le « vous » est la règle et les tournures nommées montent le ton : « bien vouloir », « je vous prie de ».", "Les connecteurs trahissent le registre : « néanmoins », « toutefois », « par ailleurs » tiennent la longueur d'phrase ; « du coup », « genre » la plombent."), examples = listOf(ExampleLine(text = "Je me permets de vous écrire au sujet de votre annonce.", meaning = "Ouverture formelle d'e-mail."), ExampleLine(text = "Je vous prie de bien vouloir me répondre d'ici vendredi.", meaning = "Demande très polie (soutenu)."), ExampleLine(text = "Nous avons toutefois constaté un léger retard.", meaning = "Concession en registre soutenu."), ExampleLine(text = "Par ailleurs, le prix de la livraison a augmenté.", meaning = "Argument supplémentaire (soutenu)."), ExampleLine(text = "Je reste à votre disposition pour toute question.", meaning = "Formule de clôture d'e-mail."))), expressions = listOf(TargetExpression(text = "je me permets de + infinitif", meaning = "Ouvrir un e-mail.", note = "Jamais « je te permets » à un inconnu."), TargetExpression(text = "je vous prie de bien vouloir…", meaning = "Demander avec égards.", note = "…me répondre d'ici vendredi."), TargetExpression(text = "néanmoins / toutefois", meaning = "« Mais » en soutenu.", note = "Nous avons toutefois un doute."), TargetExpression(text = "par ailleurs", meaning = "Ajouter un argument.", note = "Remplace « aussi », « pis »."), TargetExpression(text = "je reste à votre disposition", meaning = "Conclure l'e-mail.", note = "…pour toute question.")), situation = "Vous écrivez au service client pour un colis en retard : votre premier brouillon est trop familier, le deuxième trop raide — vous cherchez le ton juste, professionnel mais humain.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ouvre un e-mail formel pour demander des informations sur l'annonce.", expected = listOf("Je me permets de vous écrire pour demander des informations", "Je me permets de vous ecrire pour demander des informations", "Je vous écris pour demander des informations"), focus = "je me permets de", watch = "« Vous » au destinataire inconnu."), PracticeQuestion(prompt = "Demande avec égards une réponse avant vendredi.", expected = listOf("Je vous prie de bien vouloir me répondre avant vendredi", "Je vous prie de bien vouloir me repondre avant vendredi", "Je vous prie de me répondre avant vendredi"), focus = "bien vouloir", watch = "Prier de + infinitif, jamais « je veux »."), PracticeQuestion(prompt = "Concède en soutenu : le retard est gênant.", expected = listOf("Le retard est néanmoins gênant", "Le retard est neanmoins genant", "Le retard reste toutefois gênant"), focus = "néanmoins", watch = "Connecteur en tête ou après le verbe."), PracticeQuestion(prompt = "Ajoute un second argument en soutenu : le prix de la livraison a augmenté.", expected = listOf("Par ailleurs, le prix de la livraison a augmenté", "Par ailleurs le prix de la livraison a augmente", "Par ailleurs, le prix de la livraison a augmente"), focus = "par ailleurs", watch = "Bannis « du coup » et « en plus »."), PracticeQuestion(prompt = "Termine l'e-mail en restant à la disposition du client.", expected = listOf("Je reste à votre disposition pour toute question", "Je reste a votre disposition pour toute question", "Je reste à votre disposition"), focus = "formule de clôture", watch = "Formule fixe : « pour toute question »."))), exercises = listOf(Exercise(id = "fr-foundations-u9-registre-e1", kind = "choice", prompt = "___ me permets de vous écrire au sujet de votre annonce.", options = listOf("Je", "Tu", "Ça", "On"), answers = listOf("Je"), explain = "E-mail formel : « je me permets », pas de « tu »."), Exercise(id = "fr-foundations-u9-registre-e2", kind = "gap", prompt = "Je vous prie de bien vouloir ___ ma candidature. (verbe : prendre en compte, infinitif)", options = listOf(), answers = listOf("considérer", "considerer"), explain = "Bien vouloir + infinitif : le verbe simple monte le registre."), Exercise(id = "fr-foundations-u9-registre-e3", kind = "choice", prompt = "Nous avons ___ constaté un léger retard. (« mais », en registre soutenu)", options = listOf("néanmoins", "du coup", "genre", "vachement"), answers = listOf("néanmoins"), explain = "Néanmoins : la concession qui tient la distance."), Exercise(id = "fr-foundations-u9-registre-e4", kind = "written", prompt = "Termine l'e-mail : tu restes à la disposition du client.", options = listOf(), answers = listOf("je reste à votre disposition pour toute question", "je reste a votre disposition pour toute question", "je reste à votre disposition"), explain = "Formule de clôture attendue dans tout e-mail soigné.")), skills = listOf("vocab:social-expressions", "function:talk-about-work", "writing:email", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "fr-foundations-u9-nuances", title = "Plus ou moins", goal = "Nuancer son opinion pour éviter le tout-ou-rien : en quelque sorte, d'une certaine manière, à mon sens.", intro = LessonIntro(explanation = listOf("Le C1 module plutôt qu'il ne tranche : « C'est en quelque sorte une seconde chance » dit presque, sans conclure à la place des faits.", "« D'une certaine manière, il a raison » accorde un point vrai sans se rendre prisonnier de toute la thèse adverse.", "« À mon sens » assume la part personnelle du jugement : plus réfléchi que « pour moi », moins raide que « selon moi »."), examples = listOf(ExampleLine(text = "C'est en quelque sorte une seconde chance.", meaning = "Approximation mesurée."), ExampleLine(text = "D'une certaine manière, son projet tient la route.", meaning = "Accord prudent."), ExampleLine(text = "À mon sens, la décision est irréversible.", meaning = "Opinion personnelle assumée."), ExampleLine(text = "J'y suis favorable, moyennant quelques garanties.", meaning = "Accord à condition."), ExampleLine(text = "Ce n'est pas faux, mais c'est plus compliqué que ça.", meaning = "Concession nuancée."))), expressions = listOf(TargetExpression(text = "en quelque sorte", meaning = "Presque, en quelque façon.", note = "Formule figée : pas « en quelque manière »."), TargetExpression(text = "d'une certaine manière", meaning = "Accord partiel.", note = "…il a raison, mais seulement en partie."), TargetExpression(text = "à mon sens", meaning = "Mon jugement réfléchi.", note = "Plus fort que « pour moi »."), TargetExpression(text = "moyennant + nom", meaning = "À condition de.", note = "Moyennant un effort, moyennant des garanties."), TargetExpression(text = "pas tout à fait", meaning = "Négation douce.", note = "Je ne suis pas tout à fait d'accord.")), situation = "En débat d'équipe, tout le monde tranche trop vite : tu apprends à accorder sans tout céder, à conditionner sans te contredire.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Nuance : c'est presque une révolution (formule en « sorte »).", expected = listOf("C'est en quelque sorte une révolution", "C'est en quelque sorte une revolution", "C'est, en quelque sorte, une révolution"), focus = "en quelque sorte", watch = "Formule figée : sorte, pas manière."), PracticeQuestion(prompt = "Accorde prudemment : il a raison (d'une certaine…).", expected = listOf("D'une certaine manière, il a raison", "D'une certaine maniere, il a raison", "D'une certaine manière il a raison"), focus = "d'une certaine manière", watch = "Garde l'article : « une certaine manière »."), PracticeQuestion(prompt = "Donne une opinion réfléchie : ce choix est irréversible.", expected = listOf("À mon sens, ce choix est irréversible", "A mon sens ce choix est irreversible", "À mon sens ce choix est irréversible"), focus = "à mon sens", watch = "Accent grave sur À en tête de phrase."), PracticeQuestion(prompt = "Conditionne ton accord : tu es favorable, avec des garanties.", expected = listOf("J'y suis favorable, moyennant des garanties", "J'y suis favorable moyennant des garanties", "J'y suis favorable, moyennant des garanties."), focus = "moyennant", watch = "Moyennant + nom sans « de »."), PracticeQuestion(prompt = "Négation douce : tu n'es pas complètement d'accord.", expected = listOf("Je ne suis pas tout à fait d'accord", "Je ne suis pas tout a fait d'accord", "Je ne suis pas tout-a-fait d'accord"), focus = "pas tout à fait", watch = "Ne coupe pas « tout à fait »."))), exercises = listOf(Exercise(id = "fr-foundations-u9-nuances-e1", kind = "choice", prompt = "___ mon sens, la mesure arrive trop tôt.", options = listOf("À", "Par", "Dans", "Chez"), answers = listOf("À"), explain = "À mon sens : opinion réfléchie, accent grave."), Exercise(id = "fr-foundations-u9-nuances-e2", kind = "gap", prompt = "D'une certaine ___, son projet tient la route. (synonyme courant : « façon », ici avec accent grave)", options = listOf(), answers = listOf("manière", "maniere"), explain = "D'une certaine manière : formule figée d'accord prudent."), Exercise(id = "fr-foundations-u9-nuances-e3", kind = "choice", prompt = "Nous acceptons le projet, ___ quelques ajustements. (à condition de : un seul mot)", options = listOf("moyennant", "malgré", "pendant", "selon"), answers = listOf("moyennant"), explain = "Moyennant + nom : accord sous condition."), Exercise(id = "fr-foundations-u9-nuances-e4", kind = "written", prompt = "Nuance ton accord : tu es d'accord, mais pas complètement.", options = listOf(), answers = listOf("je suis d'accord mais pas tout à fait", "je suis d'accord, mais pas tout a fait", "je ne suis pas tout à fait d'accord"), explain = "Le C1 pèse son oui : pas tout à fait.")), skills = listOf("function:express-opinion", "speaking:justify-opinion", "grammar:connectors", "vocab:collocations"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "fr-foundations-u9-presenter", title = "Présenter des idées", goal = "Structurer un exposé court : annoncer le plan, enchaîner nettement, conclure par un bilan.", intro = LessonIntro(explanation = listOf("Annoncer le plan, c'est donner la carte : « Pour commencer, le contexte ; ensuite, les chiffres » — l'auditeur sait toujours où il en est.", "Les transitions s'énoncent : « J'en viens maintenant aux résultats » — on prévient le changement de cap au lieu de l'imposer.", "On conclut par un bilan, jamais par un « voilà » : « En résumé, le projet tient ; pour conclure, j'ai besoin de votre feu vert »."), examples = listOf(ExampleLine(text = "Pour commencer, deux mots sur le contexte.", meaning = "Ouverture d'exposé."), ExampleLine(text = "J'en viens maintenant aux résultats du trimestre.", meaning = "Transition annoncée."), ExampleLine(text = "En résumé, le projet est rentable dès la deuxième année.", meaning = "Bilan synthétique."), ExampleLine(text = "Pour conclure, j'ai besoin de votre accord.", meaning = "Demande finale."), ExampleLine(text = "Si vous le permettez, je passerai à vos questions.", meaning = "Étape suivante, poliment."))), expressions = listOf(TargetExpression(text = "pour commencer", meaning = "Ouvrir l'exposé.", note = "…deux mots sur le contexte."), TargetExpression(text = "j'en viens à…", meaning = "Transiter.", note = "J'en viens aux chiffres."), TargetExpression(text = "en résumé", meaning = "Faire le bilan.", note = "…le projet tient."), TargetExpression(text = "pour conclure", meaning = "Finir et décider.", note = "…j'ai besoin de votre accord."), TargetExpression(text = "si vous le permettez", meaning = "Polir l'étape suivante.", note = "…je passe aux questions.")), situation = "Vous présentez votre projet en cinq minutes en réunion : plan annoncé d'entrée, transitions nettes, bilan chiffré — et une conclusion qui obtient l'accord.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ouvre ton exposé : le contexte d'abord.", expected = listOf("Pour commencer, le contexte", "Pour commencer le contexte", "Pour commencer, quelques mots sur le contexte"), focus = "pour commencer", watch = "On annonce, on ne démarre pas en pleine matière."), PracticeQuestion(prompt = "Transition : tu passes maintenant aux résultats.", expected = listOf("J'en viens maintenant aux résultats", "J'en viens maintenant aux resultats", "J'en viens à présent aux résultats"), focus = "j'en viens à", watch = "J'en viens, pas « je viens »."), PracticeQuestion(prompt = "Fais le bilan : le projet est rentable.", expected = listOf("En résumé, le projet est rentable", "En resume le projet est rentable", "En résumé le projet est rentable"), focus = "en résumé", watch = "Accent aigu sur le é final."), PracticeQuestion(prompt = "Conclus en demandant l'accord de la salle.", expected = listOf("Pour conclure, j'ai besoin de votre accord", "Pour conclure j'ai besoin de votre accord", "Pour conclure, j'ai besoin de votre feu vert"), focus = "pour conclure", watch = "Besoin DE votre accord."), PracticeQuestion(prompt = "Demande poliment de passer aux questions.", expected = listOf("Si vous le permettez, je passerai aux questions", "Si vous le permettez je passerai aux questions", "Si vous le permettez, je passe aux questions"), focus = "si vous le permettez", watch = "Subjonctif : que vous le permettiez, sous-entendu."))), exercises = listOf(Exercise(id = "fr-foundations-u9-presenter-e1", kind = "choice", prompt = "___ commencer, deux mots sur le contexte.", options = listOf("Pour", "Par", "Chez", "Vers"), answers = listOf("Pour"), explain = "Pour commencer : ouverture standard d'exposé."), Exercise(id = "fr-foundations-u9-presenter-e2", kind = "gap", prompt = "En ___, le projet est rentable dès la deuxième année. (synonyme de « bilan », avec accent)", options = listOf(), answers = listOf("résumé", "resume"), explain = "En résumé : le bilan avant la conclusion."), Exercise(id = "fr-foundations-u9-presenter-e3", kind = "choice", prompt = "Si vous le ___ , je passerai à vos questions.", options = listOf("permettez", "pouvez", "savez", "voudrez"), answers = listOf("permettez"), explain = "Si vous le permettez : formule figée et polie."), Exercise(id = "fr-foundations-u9-presenter-e4", kind = "written", prompt = "Transition : tu passes maintenant aux chiffres.", options = listOf(), answers = listOf("j'en viens maintenant aux chiffres", "j'en viens a present aux chiffres", "j'en viens à présent aux chiffres"), explain = "J'en viens à : transition qui prévient l'auditeur.")), skills = listOf("speaking:sustained-conversation", "function:talk-about-work", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "fr-foundations-u9-debattre", title = "D'accord pour ne pas être d'accord", goal = "Exprimer un désaccord poli : comprendre l'autre, concéder un point, puis opposer sans casser le dialogue.", intro = LessonIntro(explanation = listOf("Le désaccord poli commence par la reconnaissance : « Je comprends votre point, mais… » — on valide avant d'opposer.", "On module l'opposition : « Je vois les choses autrement » est plus doux que « vous avez tort », que l'on ne prononce jamais au C1.", "Le connecteur porte la nuance : « cela dit », « sans pour autant » concèdent sans abandonner la position ; le doute se dit au subjonctif : « je ne suis pas certain que cet argument tienne »."), examples = listOf(ExampleLine(text = "Je comprends votre point, mais les chiffres disent autre chose.", meaning = "Accorder puis opposer."), ExampleLine(text = "Je vois les choses autrement.", meaning = "Le désaccord sans affrontement."), ExampleLine(text = "Cela dit, l'exemple reste discutable.", meaning = "La concession mesurée."), ExampleLine(text = "Je ne suis pas certain que cet argument tienne.", meaning = "Le doute élégant (subjonctif)."), ExampleLine(text = "Restons d'accord pour ne pas être d'accord.", meaning = "Le désaccord serein."))), expressions = listOf(TargetExpression(text = "je comprends votre point, mais…", meaning = "Valider avant d'opposer.", note = "Jamais « vous avez tort »."), TargetExpression(text = "je vois les choses autrement", meaning = "Désaccorder poliment.", note = "Plus doux que « pas du tout »."), TargetExpression(text = "cela dit", meaning = "Concéder sans céder.", note = "Après un accord partiel."), TargetExpression(text = "je ne suis pas certain que + subjonctif", meaning = "Douter élégamment.", note = "…que cet argument tienne."), TargetExpression(text = "sans pour autant", meaning = "Limiter la portée de son accord.", note = "J'accepte le fond, sans pour autant la forme.")), situation = "En réunion, un collègue défend une réorganisation : vous reprenez son argument, vous concédez un point, puis vous opposez une réserve précise — sans jamais le vexer.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Reconnais l'argument de ton collègue avant de t'y opposer.", expected = listOf("Je comprends votre point, mais…", "Je comprends votre point de vue, mais je garde des réserves"), focus = "je comprends votre point", watch = "on valide, puis le « mais » arrive."), PracticeQuestion(prompt = "Désaccorde-toi sans agressivité.", expected = listOf("Je vois les choses autrement", "Je vois les choses différemment"), focus = "je vois les choses autrement", watch = "autrement : l'adverbe attendu ici."), PracticeQuestion(prompt = "Concède avec « cela dit » : l'idée est séduisante mais chère.", expected = listOf("L'idée est séduisante, cela dit elle est chère", "Cela dit, l'idée reste coûteuse"), focus = "cela dit", watch = "le connecteur ouvre ou suit la phrase."), PracticeQuestion(prompt = "Doute de la solidité d'un argument (verbe tenir).", expected = listOf("Je ne suis pas certain que cet argument tienne", "Je ne suis pas sûr que cet argument tienne"), focus = "subjonctif", watch = "tenir → tienne après « ne pas être certain que »."), PracticeQuestion(prompt = "Accepte le fond mais limite ton accord (formule en « pour »).", expected = listOf("J'accepte le fond, sans pour autant la méthode", "Sans pour autant être convaincu"), focus = "sans pour autant", watch = "formule figée : sans pour autant + nom / infinitif."))), exercises = listOf(Exercise(id = "fr-foundations-u9-debattre-e1", kind = "choice", prompt = "___ votre point, mais le calendrier me semble irréaliste.", options = listOf("Je comprends", "Tu comprends", "On comprendra", "Je comprenais"), answers = listOf("Je comprends"), explain = "« Je comprends votre point » : la reconnaissance standard avant le « mais »."), Exercise(id = "fr-foundations-u9-debattre-e2", kind = "gap", prompt = "Cet argument est séduisant ; ___ dit, il coûte trop cher. (connecteur)", options = listOf(), answers = listOf("cela"), explain = "Cela dit : la concession qui prépare l'objection."), Exercise(id = "fr-foundations-u9-debattre-e3", kind = "choice", prompt = "Je ne suis pas certain que cet argument ___ . (verbe : tenir)", options = listOf("tienne", "tient", "tenait", "tiendrait"), answers = listOf("tienne"), explain = "Après « ne pas être certain que », le subjonctif : tienne."), Exercise(id = "fr-foundations-u9-debattre-e4", kind = "written", prompt = "Ton collègue a raison sur le fond, pas sur la forme. Limite ton accord avec la formule en « pour ».", options = listOf(), answers = listOf("sans pour autant", "j'accepte le fond sans pour autant la forme", "sans pour autant être convaincu"), explain = "Sans pour autant : l'accord borné, précis, diplomatique.")), skills = listOf("function:express-opinion", "speaking:sustained-conversation", "grammar:connectors", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "fr-foundations-u9-ton", title = "Le ton juste", goal = "Ajuster registre et collocations : préférer avoir envie de à vouloir, prendre une décision plutôt que faire, conclure avec autant dire que.", intro = LessonIntro(explanation = listOf("Le ton passe d'abord par le verbe : « J'ai envie de » reste vivant là où « je veux » sonne brutal — « Je n'ai pas envie d'insister » adoucit un refus.", "Les collocations font le naturel : on prend une décision, on prend position ; « faire une décision » se comprend, mais trahit une langue laborieuse.", "À l'écrit argumenté, ces choix comptent double : « Vous avez raison sur le fond ; toutefois, le calendrier est serré » concède avant de nuancer, et « autant dire que » clôt par l'évidence."), examples = listOf(ExampleLine(text = "Je n'ai pas envie d'insister.", meaning = "Refuser sans brusquer."), ExampleLine(text = "Nous devrons prendre une décision d'ici vendredi.", meaning = "La collocation juste."), ExampleLine(text = "J'ai le sentiment que le projet mérite un délai.", meaning = "L'opinion mesurée."), ExampleLine(text = "Vous avez raison sur le fond ; toutefois, le calendrier est serré.", meaning = "Concéder puis nuancer."), ExampleLine(text = "Autant dire que le choix ne sera pas simple.", meaning = "Conclure par l'évidence."))), expressions = listOf(TargetExpression(text = "avoir envie de + infinitif", meaning = "Le désir qui reste doux.", note = "Je n'ai pas envie de trancher."), TargetExpression(text = "prendre une décision / position", meaning = "La collocation du choix.", note = "jamais « faire une décision »."), TargetExpression(text = "avoir le sentiment que + phrase", meaning = "L'opinion mesurée.", note = "plus doux que « je pense que »."), TargetExpression(text = "vous avez raison sur le fond", meaning = "Concéder avant de nuancer.", note = "…; toutefois, …"), TargetExpression(text = "autant dire que", meaning = "Conclure par l'évidence.", note = "Autant dire que c'est tendu.")), situation = "Vous rédigez la réponse à un client mécontent : « je veux » sonne sec et « faire une décision » fait tâche — vous ajustez verbe par verbe jusqu'au ton juste, ferme mais humain.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Adoucis ton refus : tu ne veux plus insister.", expected = listOf("Je n'ai pas envie d'insister.", "Je n'ai pas envie d insister"), focus = "avoir envie de", watch = "avoir envie de reste plus doux que vouloir."), PracticeQuestion(prompt = "Réécris « faire une décision » avec la bonne collocation.", expected = listOf("Prendre une décision.", "Nous devons prendre une décision."), focus = "prendre une décision", watch = "on prend une décision, on ne la fait pas."), PracticeQuestion(prompt = "Ton opinion sur le délai, mesurée.", expected = listOf("J'ai le sentiment que le projet mérite un délai.", "J ai le sentiment que le projet merite un delai"), focus = "avoir le sentiment que", watch = "l'opinion qui ne provoque pas."), PracticeQuestion(prompt = "Concède sur le fond, puis nuance sur le calendrier.", expected = listOf("Vous avez raison sur le fond ; toutefois, le calendrier est serré.", "Vous avez raison sur le fond, toutefois le calendrier est serré."), focus = "sur le fond", watch = "concéder d'abord rend la nuance acceptable."), PracticeQuestion(prompt = "Conclus par l'évidence : le choix sera difficile.", expected = listOf("Autant dire que le choix ne sera pas simple.", "Autant dire que le choix sera difficile."), focus = "autant dire que", watch = "la clôture par l'évidence partagée."))), exercises = listOf(Exercise(id = "fr-foundations-u9-ton-e1", kind = "choice", prompt = "Je n'ai pas ___ d'insister, mais le délai pose problème.", options = listOf("envie", "vouloir", "peur", "idée"), answers = listOf("envie"), explain = "Avoir envie de : le désir adouci, plus habile que « je ne veux pas »."), Exercise(id = "fr-foundations-u9-ton-e2", kind = "gap", prompt = "Le comité ___ une décision d'ici vendredi. (collocation : prendre)", options = listOf(), answers = listOf("prend", "prendra"), explain = "Prendre une décision : la collocation correcte, jamais « faire »."), Exercise(id = "fr-foundations-u9-ton-e3", kind = "choice", prompt = "« ___ votre point de vue ; toutefois, le calendrier est serré. »", options = listOf("Je comprends", "Je marche", "Je cours", "Je saute"), answers = listOf("Je comprends"), explain = "Concéder d'abord (« je comprends ») rend la nuance acceptable."), Exercise(id = "fr-foundations-u9-ton-e4", kind = "written", prompt = "Formule ton opinion mesurée sur le délai du projet (formule : j'ai le sentiment que…).", options = listOf(), answers = listOf("j'ai le sentiment que le projet mérite un délai", "j ai le sentiment que le projet merite un delai", "j'ai le sentiment que le projet mérite un délai."), explain = "J'ai le sentiment que + phrase : l'opinion qui respecte le lecteur.")), skills = listOf("vocab:collocations", "function:express-opinion", "writing:argument", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors"))))
}

object FrWorkU1 {
    val unit = CourseUnit(id = "fr-work-u1", title = "La vie au bureau", subtitle = "Réunions, courriels, entretiens", level = "B1", themes = listOf(ConversationTheme("la-reunion", "En réunion", "Avis et propositions", "person.3", "Course", "Lundi 9 heures, réunion de projet : le planning est trop juste, chacun donne son avis et Léa récapitule les décisions.", 0),
                ConversationTheme("la-candidature", "La candidature", "Courriels et entretien", "envelope", "Course", "Vous visez un nouveau poste : le courriel formel avec le devis en pièce jointe, puis l'entretien où chaque réussite se chiffre.", 1)), lessons = listOf(    Lesson(id = "fr-work-u1-reunions", title = "En réunion", goal = "Donner son avis et proposer en réunion : je pense que, je propose de, et le récapitulatif final.", intro = LessonIntro(explanation = listOf("L'avis avec je pense que / à mon avis : « Je pense que le planning est trop optimiste. »", "La proposition avec je propose de + infinitif : « Je propose de livrer vendredi et de prévenir le client. »", "Le récap fait la décision : « Je récapitule : on livre vendredi, Marta prévient le client. On est d'accord ? »"), examples = listOf(ExampleLine(text = "Je pense que le planning est trop optimiste.", meaning = "L'avis franc."), ExampleLine(text = "Je propose de couper cette fonctionnalité.", meaning = "La proposition concrète."), ExampleLine(text = "D'un côté c'est rapide, de l'autre c'est risqué.", meaning = "Peser en réunion."), ExampleLine(text = "Tu as raison, mais il faut prévenir le client.", meaning = "Le contre-argument poli."), ExampleLine(text = "Qu'en pensez-vous ?", meaning = "Solliciter la salle."), ExampleLine(text = "Je récapitule : on livre vendredi.", meaning = "Verrouiller la décision."))), expressions = listOf(TargetExpression(text = "je pense que + phrase", meaning = "L'avis clair.", note = "…que c'est jouable."), TargetExpression(text = "je propose de + infinitif", meaning = "La proposition actionnable.", note = "…de couper la fonctionnalité."), TargetExpression(text = "qu'en pensez-vous ?", meaning = "Ouvrir la discussion.", note = "en = de cette idée."), TargetExpression(text = "tu as raison, mais", meaning = "Nuancer sans froisser.", note = "…mais prévenons le client."), TargetExpression(text = "je récapitule", meaning = "Verrouiller la décision.", note = "chacun sait quoi faire."), TargetExpression(text = "on est d'accord ?", meaning = "Fermer la discussion.", note = "la question qui valide.")), situation = "Réunion de lundi : le planning est trop juste — vous donnez votre avis, vous proposez de livrer vendredi et vous récapitulez les décisions.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Donne ton avis : le planning est trop optimiste.", expected = listOf("Je pense que le planning est trop optimiste.", "À mon avis, le planning est trop optimiste."), focus = "je pense que", watch = "je pense que + phrase complète."), PracticeQuestion(prompt = "Propose : livrer vendredi.", expected = listOf("Je propose de livrer vendredi."), focus = "je propose de", watch = "proposer de + infinitif : l'action suit l'avis."), PracticeQuestion(prompt = "Ton collègue a raison sur le budget, mais il faut prévenir le client : nuance.", expected = listOf("Tu as raison sur le budget, mais il faut prévenir le client.", "Tu as raison, mais prévenons le client."), focus = "tu as raison, mais", watch = "concéder d'abord, proposer ensuite."), PracticeQuestion(prompt = "Demande l'avis de la salle.", expected = listOf("Qu'en pensez-vous ?", "Qu'est-ce que vous en pensez ?"), focus = "qu'en pensez-vous", watch = "en = de cette proposition."), PracticeQuestion(prompt = "Récapitule : livraison vendredi, Marta prévient le client.", expected = listOf("Je récapitule : on livre vendredi, Marta prévient le client."), focus = "je récapitule", watch = "le récap transforme le débat en décisions."))), exercises = listOf(Exercise(id = "fr-work-u1-reunions-e1", kind = "choice", prompt = "« Je ___ qu'on devrait avancer la réunion. » (donner son avis)", options = listOf("pense", "propose", "récapitule", "demande"), answers = listOf("pense"), explain = "Je pense que + phrase : l'avis de base en réunion."), Exercise(id = "fr-work-u1-reunions-e2", kind = "gap", prompt = "Je ___ de livrer vendredi. (faire une proposition)", options = listOf(), answers = listOf("propose"), explain = "Je propose de + infinitif : l'avis qui devient action."), Exercise(id = "fr-work-u1-reunions-e3", kind = "order", prompt = "Récapitulez la décision : livraison vendredi.", options = listOf(), answers = listOf("Je récapitule on livre vendredi"), explain = "Je récapitule + les décisions : la réunion se termine."), Exercise(id = "fr-work-u1-reunions-e4", kind = "written", prompt = "Nuance : ton collègue a raison, mais prévenez le client.", options = listOf(), answers = listOf("tu as raison mais il faut prevenir le client", "tu as raison mais il faut prévenir le client", "tu as raison mais prevenons le client"), explain = "Tu as raison, mais : le désaccord qui avance.")), skills = listOf("function:talk-about-work", "function:express-opinion", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "fr-work-u1-courriels", title = "Le courriel formel", goal = "Écrire un courriel professionnel : je vous écris au sujet de, pourriez-vous + échéance, et une signature solide.", intro = LessonIntro(explanation = listOf("Le but en première ligne : « Je vous écris au sujet de la réunion de lundi. »", "La demande avec pourriez-vous + échéance : « Pourriez-vous me confirmer d'ici vendredi ? »", "La clôture : « Vous trouverez le rapport ci-joint. Je vous remercie par avance. Cordialement, Léa »"), examples = listOf(ExampleLine(text = "Je vous écris au sujet du budget.", meaning = "Le but en première ligne."), ExampleLine(text = "Pourriez-vous me confirmer d'ici vendredi ?", meaning = "La demande datée."), ExampleLine(text = "Vous trouverez le rapport ci-joint.", meaning = "La pièce jointe annoncée."), ExampleLine(text = "Je reste à votre disposition pour toute question.", meaning = "La formule de service."), ExampleLine(text = "Je vous remercie par avance.", meaning = "Remercier avant la réponse."), ExampleLine(text = "Cordialement, Léa Martin", meaning = "La signature sûre."))), expressions = listOf(TargetExpression(text = "je vous écris au sujet de", meaning = "Ouvrir avec le but.", note = "au sujet de la facture n° 128."), TargetExpression(text = "pourriez-vous + infinitif ?", meaning = "La demande formelle.", note = "Pourriez-vous relire ce mail ?"), TargetExpression(text = "d'ici + date", meaning = "L'échéance claire.", note = "d'ici vendredi, midi."), TargetExpression(text = "ci-joint", meaning = "La pièce jointe.", note = "Vous trouverez le devis ci-joint."), TargetExpression(text = "je vous remercie par avance", meaning = "Remercier avant la réponse.", note = "par avance = d'ores et déjà."), TargetExpression(text = "cordialement", meaning = "La signature passe-partout.", note = "entre collègues comme avec un client.")), situation = "Il manque les chiffres du client : vous écrivez à Madame Dubois — le but en première ligne, la demande datée d'ici vendredi, le devis en pièce jointe.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ouvrez le courriel : le sujet, c'est la facture 128.", expected = listOf("Je vous écris au sujet de la facture 128."), focus = "au sujet de", watch = "le but en première ligne, pas de blabla."), PracticeQuestion(prompt = "Demandez la confirmation : d'ici vendredi.", expected = listOf("Pourriez-vous me confirmer d'ici vendredi ?", "Pourriez-vous me confirmer avant vendredi ?"), focus = "pourriez-vous", watch = "le conditionnel rend la demande impeccable."), PracticeQuestion(prompt = "Annoncez la pièce jointe : le devis.", expected = listOf("Vous trouverez le devis ci-joint.", "Veuillez trouver ci-joint le devis."), focus = "ci-joint", watch = "ci-joint = le fichier est dans le mail."), PracticeQuestion(prompt = "Remerciez avant même la réponse.", expected = listOf("Je vous remercie par avance."), focus = "par avance", watch = "par avance = avant que vous répondiez."), PracticeQuestion(prompt = "Signez avec la formule passe-partout.", expected = listOf("Cordialement, Léa", "Cordialement"), focus = "cordialement", watch = "cordialement marche partout."))), exercises = listOf(Exercise(id = "fr-work-u1-courriels-e1", kind = "choice", prompt = "« Je vous écris au ___ de la réunion de lundi. »", options = listOf("sujet", "thème", "fait", "cas"), answers = listOf("sujet"), explain = "Au sujet de + nom : l'ouverture qui annonce le but."), Exercise(id = "fr-work-u1-courriels-e2", kind = "gap", prompt = "___ vous me confirmer d'ici vendredi ? (la demande formelle)", options = listOf(), answers = listOf("pourriez"), explain = "Pourriez-vous + infinitif : la demande formelle au conditionnel."), Exercise(id = "fr-work-u1-courriels-e3", kind = "order", prompt = "Annoncez la pièce jointe (le devis).", options = listOf(), answers = listOf("Vous trouverez le devis ci joint"), explain = "Vous trouverez + fichier + ci-joint."), Exercise(id = "fr-work-u1-courriels-e4", kind = "written", prompt = "Clôturez avec la signature passe-partout.", options = listOf(), answers = listOf("cordialement", "cordialement lea", "bien cordialement"), explain = "Cordialement : la formule sûre, même à un client.")), skills = listOf("writing:email", "function:make-requests", "vocab:work", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "fr-work-u1-entretiens", title = "Expérience et réussites", goal = "Valoriser son expérience en entretien : des réussites chiffrées au passé composé et des objectifs avec je voudrais.", intro = LessonIntro(explanation = listOf("La réussite se chiffre au passé composé : « J'ai augmenté les ventes de 20 %. » — verbe + chiffre = preuve.", "On relie l'action à la compétence : « J'ai géré cinq clients, ce qui m'a appris à négocier. »", "L'objectif avec je voudrais : « D'ici cinq ans, je voudrais encadrer une petite équipe. »"), examples = listOf(ExampleLine(text = "J'ai piloté trois projets internationaux.", meaning = "L'expérience qui se compte."), ExampleLine(text = "J'ai augmenté les ventes de 20 %.", meaning = "La réussite chiffrée."), ExampleLine(text = "J'ai géré cinq clients, ce qui m'a appris à négocier.", meaning = "L'action devenue compétence."), ExampleLine(text = "Je suis fier d'avoir livré avant la date.", meaning = "La fierté assumée."), ExampleLine(text = "D'ici cinq ans, je voudrais encadrer une équipe.", meaning = "L'objectif daté."), ExampleLine(text = "Ce qui m'anime, c'est résoudre des problèmes concrets.", meaning = "La motivation claire."))), expressions = listOf(TargetExpression(text = "j'ai + participe + chiffre", meaning = "La réussite qui prouve.", note = "j'ai doublé le trafic."), TargetExpression(text = "ce qui m'a appris à + infinitif", meaning = "L'expérience devenue compétence.", note = "…à gérer les urgences."), TargetExpression(text = "je suis fier(e) d'avoir + participe", meaning = "La fierté dosée.", note = "…d'avoir livré à temps."), TargetExpression(text = "d'ici + durée", meaning = "L'objectif dans le temps.", note = "d'ici cinq ans."), TargetExpression(text = "ce qui m'anime, c'est", meaning = "La motivation sincère.", note = "…c'est le travail d'équipe."), TargetExpression(text = "piloter un projet", meaning = "Mener un projet.", note = "j'ai piloté trois projets.")), situation = "Entretien final : trois projets pilotés, les ventes en hausse de 20 %, la négociation apprise sur le terrain — et l'objectif d'encadrer une équipe d'ici cinq ans.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Cite une réussite chiffrée : les ventes + 20 %.", expected = listOf("J'ai augmenté les ventes de 20 %."), focus = "passé composé + chiffre", watch = "le chiffre transforme l'affirmation en preuve."), PracticeQuestion(prompt = "Relie ton expérience à une compétence : cinq clients, et tu as appris à négocier.", expected = listOf("J'ai géré cinq clients, ce qui m'a appris à négocier."), focus = "ce qui m'a appris", watch = "l'action passée nourrit la compétence présente."), PracticeQuestion(prompt = "Exprime ta fierté : livré avant la date.", expected = listOf("Je suis fier d'avoir livré avant la date.", "Je suis fière d'avoir livré avant la date."), focus = "fier d'avoir", watch = "fier de + avoir + participe."), PracticeQuestion(prompt = "Donne ton objectif : encadrer une équipe, d'ici cinq ans.", expected = listOf("D'ici cinq ans, je voudrais encadrer une équipe."), focus = "d'ici", watch = "d'ici + durée : l'objectif se date."), PracticeQuestion(prompt = "Dis ce qui te motive : les problèmes concrets.", expected = listOf("Ce qui m'anime, c'est résoudre des problèmes concrets."), focus = "ce qui m'anime", watch = "c'est + infinitif : la motivation sans détour."))), exercises = listOf(Exercise(id = "fr-work-u1-entretiens-e1", kind = "choice", prompt = "« J'ai ___ les ventes de 20 %. » (la réussite chiffrée)", options = listOf("augmenté", "augmenter", "augmente", "augmentais"), answers = listOf("augmenté"), explain = "J'ai + participe : j'ai augmenté, le passé composé de la réussite."), Exercise(id = "fr-work-u1-entretiens-e2", kind = "gap", prompt = "D'___ cinq ans, je voudrais encadrer une équipe. (l'objectif daté)", options = listOf(), answers = listOf("ici"), explain = "D'ici + durée : l'objectif dans le temps."), Exercise(id = "fr-work-u1-entretiens-e3", kind = "order", prompt = "Reliez l'expérience à la compétence apprise.", options = listOf(), answers = listOf("J'ai géré cinq clients ce qui m'a appris à négocier"), explain = "Ce qui m'a appris à + infinitif : l'action devenue compétence."), Exercise(id = "fr-work-u1-entretiens-e4", kind = "written", prompt = "Dis ta motivation : les problèmes concrets.", options = listOf(), answers = listOf("ce qui m'anime c'est resoudre des problemes concrets", "ce qui m'anime c'est résoudre des problèmes concrets", "ce qui m'anime ce sont les problemes concrets"), explain = "Ce qui m'anime, c'est + infinitif : la motivation en clair.")), skills = listOf("function:talk-about-work", "grammar:present-perfect", "vocab:work", "function:describe-goals"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-perfect"))))
}

object ItFoundationsU1 {
    val unit = CourseUnit(id = "it-foundations-u1", title = "First sentences", subtitle = "Say who you are", level = "A1", themes = listOf(ConversationTheme("lang-exchange", "Language-exchange café", "Meet and greet", "person.2", "Course", "You are at a friendly language-exchange café in Roma. Meet the learner, exchange names, countries and jobs using the verb essere.", 0),
                ConversationTheme("introductions", "Nice to meet you", "Start somewhere small", "hand.wave", "Connection", "Meet the learner for the first time. Learn their interests through natural introductions.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u1-essere", title = "The verb “essere”", goal = "Introduce yourself and say who people are with sono, sei, è, siamo, siete, sono.", intro = LessonIntro(explanation = listOf("Every Italian sentence needs a subject and a verb. The verb for saying who you are is “essere”.", "Six forms: io sono, tu sei, lui/lei è, noi siamo, voi siete, loro sono. Italian often drops the subject: “Sono Ana” already means I am Ana.", "Use essere for identity and origin: “Sono di Roma”, “È insegnante”. Put “di” before a city: “Sono di Roma”."), examples = listOf(ExampleLine(text = "Sono Ana. Sono di Italia.", meaning = "Your name and country."), ExampleLine(text = "Sei il mio migliore amico.", meaning = "A close bond with someone."), ExampleLine(text = "Lei è insegnante.", meaning = "Someone's profession."), ExampleLine(text = "Siamo molto felici oggi.", meaning = "A feeling that defines right now."), ExampleLine(text = "Il caffè è vicino alla stazione.", meaning = "Where a place is."), ExampleLine(text = "Loro sono di Milano.", meaning = "Someone's origin."))), expressions = listOf(TargetExpression(text = "Sono …", meaning = "Introduce yourself.", note = "With your name or job: Sono Ana. Sono insegnante."), TargetExpression(text = "Sono di …", meaning = "Say where you come from.", note = "Never “Sono Italia” — the di is obligatory: Sono di Roma."), TargetExpression(text = "Sei … ?", meaning = "Ask about the other person.", note = "Sei studente? Sei di qui?"), TargetExpression(text = "Sì, lo sono. / No, non lo sono.", meaning = "Short answers to a Sei… ? question.", note = "Repeat the verb through lo."), TargetExpression(text = "È …", meaning = "Say what someone else is.", note = "È medico — jobs often drop the article."), TargetExpression(text = "Piacere di conoscerti.", meaning = "The fixed phrase when you meet someone.", note = "Answer with Piacere mio, or simply Piacere.")), situation = "You meet someone new at a friendly language-exchange café in Roma. Introduce yourselves and ask simple questions with the verb essere.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ciao! Sono Ana. Tu come ti chiami?", expected = listOf("Mi chiamo <name>.", "Sono <name>."), focus = "Mi chiamo / Sono", watch = "Answering only the name: accept it, then recast “Mi chiamo …”."), PracticeQuestion(prompt = "Di dove sei?", expected = listOf("Sono di <city>.", "Vengo da <city>."), focus = "essere + di", watch = "“Sono Roma” — recast “Sono DI Roma”."), PracticeQuestion(prompt = "Sei studente?", expected = listOf("Sì, lo sono.", "No, non lo sono."), focus = "short answers with essere", watch = "One-word “Sì” — recast with the verb."), PracticeQuestion(prompt = "Come stai, oggi?", expected = listOf("Sto bene.", "Sono stanco.", "Sono contento."), focus = "stare for feelings", watch = "“Sono bene” — recast “Sto bene”: feelings take stare here."), PracticeQuestion(prompt = "La tua città, è grande o piccola?", expected = listOf("È grande.", "È piccola.", "La mia città è …"), focus = "è with places", watch = "“La mia città grande” — recast “La mia città È grande”."), PracticeQuestion(prompt = "Ora siamo amici! Di dove è la tua famiglia?", expected = listOf("È di <country>.", "La mia famiglia è di <country>."), focus = "è for a group's origin", watch = "“La mia famiglia di …” — recast with è."))), exercises = listOf(Exercise(id = "it-foundations-u1-essere-e1", kind = "choice", prompt = "Lei ___ insegnante.", options = listOf("è", "sei", "sono", "siamo"), answers = listOf("è"), explain = "With lui/lei, essere becomes è."), Exercise(id = "it-foundations-u1-essere-e2", kind = "gap", prompt = "Noi ___ di Milano.", options = listOf(), answers = listOf("siamo"), explain = "With noi, essere is sempre siamo."), Exercise(id = "it-foundations-u1-essere-e3", kind = "order", prompt = "Say where you are from.", options = listOf(), answers = listOf("Sono di Roma"), explain = "Sono + di + city: Sono di Roma."), Exercise(id = "it-foundations-u1-essere-e4", kind = "written", prompt = "Introduce yourself in one sentence: say your name.", options = listOf(), answers = listOf("Mi chiamo <name>", "Sono <name>"), explain = "Mi chiamo Ana / Sono Ana — the subject can be dropped.")), skills = listOf("grammar:verb-be", "grammar:subject-pronouns", "function:describe-people", "speaking:short-answer"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:verb-be")),
    Lesson(id = "it-foundations-u1-questions", title = "Questions & negatives", goal = "Ask yes/no questions and say what is not true, with Sei… ? and non sono.", intro = LessonIntro(explanation = listOf("Italian asks yes/no questions with rising intonation — same words, same order: “Sei Ana?”", "Question words go first: “Di dove sei?”, “Cosa è questo?” — and they carry their accents: perché, dove.", "To negate, put non before the verb: “Non sono Ana”, “Non siamo amici”. No second part is needed, unlike English."), examples = listOf(ExampleLine(text = "Sei insegnante?", meaning = "A yes/no question with sei."), ExampleLine(text = "Non sono di Milano.", meaning = "A negative with sono."), ExampleLine(text = "Di dove sei?", meaning = "Question word + sei."), ExampleLine(text = "Lui non è mio fratello.", meaning = "A negative about another person."), ExampleLine(text = "Siete vicini di casa?", meaning = "Asking a group."), ExampleLine(text = "Cosa è questo?", meaning = "What is this?"))), expressions = listOf(TargetExpression(text = "Sei … ?", meaning = "Ask a yes/no question.", note = "Just the marks and rising tone."), TargetExpression(text = "Non sono …", meaning = "Say what is not true about you.", note = "Non always goes before the verb."), TargetExpression(text = "Di dove sei?", meaning = "Ask where someone is from.", note = "Di dove, two words."), TargetExpression(text = "Lui non è …", meaning = "Say what someone else is not.", note = "Lui non è il mio capo."), TargetExpression(text = "Vero?", meaning = "Tag a statement to check it.", note = "Sei di qui, vero?"), TargetExpression(text = "Certo.", meaning = "The natural yes in talk.", note = "Also: Esatto.")), situation = "You chat with a new neighbour in the lift in Roma. Ask simple yes/no questions and say what is and isn't true for you.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sei di qui?", expected = listOf("Sì, sono di qui.", "No, non sono di qui."), focus = "short answers", watch = "One-word “Sì” — recast with the verb: Sì, sono di qui."), PracticeQuestion(prompt = "Sei insegnante o studente?", expected = listOf("Sono insegnante.", "Sono studente.", "Sono studentessa."), focus = "choice with essere", watch = "Accept either; the article stays dropped."), PracticeQuestion(prompt = "La tua famiglia è grande?", expected = listOf("Sì, è grande.", "No, non è grande."), focus = "è in questions about others", watch = "“Non è grande” — non before è."), PracticeQuestion(prompt = "Di dove sei, tu?", expected = listOf("Sono di <country>.", "Vengo da <country>."), focus = "di dove + sei", watch = "“Sono a Roma” for origin — recast with di."), PracticeQuestion(prompt = "Dimmi una cosa che non sei.", expected = listOf("Non sono <job>.", "Non sono di <country>."), focus = "negation with non sono", watch = "“Sono non” doesn't exist — non first."), PracticeQuestion(prompt = "Siamo amici, ora?", expected = listOf("Sì, siamo amici.", "Certo, siamo amici."), focus = "siamo in questions", watch = "“Sì, stiamo amici” mixes essere and stare — recast with siamo."))), exercises = listOf(Exercise(id = "it-foundations-u1-questions-e1", kind = "choice", prompt = "___ tu di Bologna?", options = listOf("Sei", "È", "Sono", "Siamo"), answers = listOf("Sei"), explain = "With tu, the question starts with Sei."), Exercise(id = "it-foundations-u1-questions-e2", kind = "gap", prompt = "Lei non ___ mia sorella.", options = listOf(), answers = listOf("è"), explain = "non + è: the negative keeps è."), Exercise(id = "it-foundations-u1-questions-e3", kind = "order", prompt = "Say you are not from Napoli.", options = listOf(), answers = listOf("Non sono di Napoli"), explain = "Non goes first: Non sono di Napoli."), Exercise(id = "it-foundations-u1-questions-e4", kind = "written", prompt = "Make it negative: \"Sono di Firenze.\"", options = listOf(), answers = listOf("Non sono di Firenze"), explain = "non + sono: Non sono di Firenze.")), skills = listOf("grammar:verb-be", "grammar:present-questions", "function:ask-simple-questions", "speaking:short-answer"), prerequisites = listOf("grammar:subject-pronouns")),
    Lesson(id = "it-foundations-u1-introduce", title = "Introducing yourself", goal = "Give a complete self-introduction: name, city, nationality and job.", intro = LessonIntro(explanation = listOf("A full Italian introduction has four pieces: your name, your city, your nationality and your job.", "For the name: “Mi chiamo Ana” or “Sono Ana”. For origin: “Sono di Roma”. Nationalities are lower-case: “sono italiana”.", "Jobs with essere drop the article: “Sono insegnante”. Close with “Piacere” and bounce the question back with “E tu?”"), examples = listOf(ExampleLine(text = "Mi chiamo Ana. Piacere.", meaning = "Your name plus a polite close."), ExampleLine(text = "Sono di Roma, del centro.", meaning = "City inside country."), ExampleLine(text = "Sono italiana, di Roma.", meaning = "Nationality plus city."), ExampleLine(text = "Sono infermiera in un ospedale.", meaning = "Job plus workplace."), ExampleLine(text = "Ho venticinque anni.", meaning = "Your age — with avere, not essere."), ExampleLine(text = "E tu? Che lavoro fai?", meaning = "Bounce the question back."))), expressions = listOf(TargetExpression(text = "Mi chiamo …", meaning = "Give your name.", note = "Literally “I call myself”. Also: Sono …"), TargetExpression(text = "Sono + nationality", meaning = "Say your nationality.", note = "italiana, tedesca, francese — lower-case in Italian."), TargetExpression(text = "Sono di …", meaning = "Say your city or country.", note = "Sono di Roma; Sono di Italia."), TargetExpression(text = "Lavoro in …", meaning = "Say where you work.", note = "Lavoro in un ospedale / in una scuola."), TargetExpression(text = "Piacere.", meaning = "Polite close when you meet someone.", note = "Answer: Piacere mio."), TargetExpression(text = "E tu?", meaning = "Bounce the question back.", note = "—Sono di Roma. E tu?")), situation = "Your first day at a language school in Roma. Present yourself completely to the class: name, city, nationality and job.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Come ti chiami?", expected = listOf("Mi chiamo <name>.", "Sono <name>."), focus = "name formulas", watch = "Both are fine; recast the shorter one as Mi chiamo for variety."), PracticeQuestion(prompt = "Di dove sei?", expected = listOf("Sono di <country>."), focus = "origin", watch = "Never drop di: Sono DI <country>."), PracticeQuestion(prompt = "Che nazionalità hai?", expected = listOf("Sono <nationality>."), focus = "nationality with essere", watch = "Lower-case: sono italiana, not Italiana."), PracticeQuestion(prompt = "Che lavoro fai?", expected = listOf("Sono <job>.", "Faccio <job>."), focus = "jobs without article", watch = "“Sono un insegnante” — recast dropping the article."), PracticeQuestion(prompt = "E dove abiti?", expected = listOf("Abito a <city>."), focus = "abito a", watch = "“Abito a Roma” — a for cities."), PracticeQuestion(prompt = "Piacere! E tu, che fai?", expected = listOf("Sono <job>."), focus = "bounce back and answer", watch = "Recast with Sono + job."))), exercises = listOf(Exercise(id = "it-foundations-u1-introduce-e1", kind = "choice", prompt = "___ Ana. Piacere.", options = listOf("Mi chiamo", "Mi chiamo di", "Chiamo", "Sto"), answers = listOf("Mi chiamo"), explain = "Mi chiamo + name: one piece, no di."), Exercise(id = "it-foundations-u1-introduce-e2", kind = "gap", prompt = "Sono ___ Germania. (nationality)", options = listOf(), answers = listOf("tedesca"), explain = "Nationality is lower-case: tedesca, tedesco."), Exercise(id = "it-foundations-u1-introduce-e3", kind = "order", prompt = "Say your name and city.", options = listOf(), answers = listOf("Sono Ana e sono di Roma"), explain = "Two sono pieces, both with their verb."), Exercise(id = "it-foundations-u1-introduce-e4", kind = "written", prompt = "Give your complete introduction: name and country.", options = listOf(), answers = listOf("Mi chiamo <name> e sono di <country>", "Sono <name> e sono di <country>"), explain = "Name + origin, each with its verb.")), skills = listOf("grammar:verb-be", "function:introduce-yourself", "vocab:introductions", "pron:word-stress"), canDo = listOf("introduce-yourself"))))
}

object ItFoundationsU2 {
    val unit = CourseUnit(id = "it-foundations-u2", title = "La mia giornata", subtitle = "Routine e progetti", level = "A1", themes = listOf(ConversationTheme("mattina-folle", "Mattina folle", "Contro la sveglia", "sunrise", "Course", "Racconti la tua mattina minuto per minuto: ore, abitudini e dimenticanze.", 0),
                ConversationTheme("sabato-insieme", "Sabato insieme", "Cosa facciamo?", "figure.walk", "Course", "Piani per sabato con un amico: mercato, ora e luogo dell'appuntamento.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u2-routine", title = "La mia routine", goal = "Raccontare la giornata al presente con le ore.", intro = LessonIntro(explanation = listOf("Il presente racconta le abitudini: « Mi sveglio alle sette. Faccio colazione. Esco alle otto. »", "I verbi riflessivi portano mi/ti/si : « mi sveglio, mi faccio la doccia, mi addormento » — il pronombre fa parte del verbo.", "Le ore: « alle sette », « alle sette e mezza ». Con a : « alle otto esco »."), examples = listOf(ExampleLine(text = "Mi sveglio alle sette.", meaning = "Il primo verbo."), ExampleLine(text = "Faccio colazione con un caffè.", meaning = "La colazione come verbo."), ExampleLine(text = "Mi faccio la doccia ed esco alle otto.", meaning = "Due azioni di fila."), ExampleLine(text = "La domenica mi sveglio tardi.", meaning = "L'abitudine del weekend."), ExampleLine(text = "Mi addormento verso le undici.", meaning = "La sera, con verso."))), expressions = listOf(TargetExpression(text = "Mi sveglio alle …", meaning = "La sveglia.", note = "mi + sveglio: ins separabili."), TargetExpression(text = "Faccio colazione", meaning = "La colazione.", note = "fare colazione = desayunar."), TargetExpression(text = "Esco di casa alle …", meaning = "L'uscita.", note = "uscire di + luogo."), TargetExpression(text = "La domenica, …", meaning = "L'abitudine.", note = "la + giorno = ogni domenica."), TargetExpression(text = "Mi addormento verso …", meaning = "Il sonno.", note = "verso = sobre las.")), situation = "Racconti la tua mattina a un nuovo amico: sveglia, colazione, doccia, uscita — e come cambia la domenica.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di a che ora ti svegli in settimana.", expected = listOf("Mi sveglio alle <ora> in settimana."), focus = "mi sveglio", watch = "Il riflessivo porta mi: mi sveglio."), PracticeQuestion(prompt = "Di cosa fai colazione.", expected = listOf("Faccio colazione con <cibo>."), focus = "fare colazione", watch = "fare colazione = desayunar."), PracticeQuestion(prompt = "Di a che ora esci di casa.", expected = listOf("Esco di casa alle <ora>."), focus = "uscire di", watch = "uscire DI casa."), PracticeQuestion(prompt = "Di la tua abitudine della domenica.", expected = listOf("La domenica mi sveglio tardi."), focus = "la + giorno", watch = "la domenica = ogni domenica."), PracticeQuestion(prompt = "Di a che ora ti addormenti.", expected = listOf("Mi addormento verso le <ora>."), focus = "mi addormento", watch = "verso = sobre las."))), exercises = listOf(Exercise(id = "it-foundations-u2-routine-e1", kind = "choice", prompt = "Mi ___ alle sette tutti i giorni.", options = listOf("sveglio", "sveglio me", "sveglia", "svegliarmi"), answers = listOf("sveglio"), explain = "Mi sveglio: il pronome va davanti."), Exercise(id = "it-foundations-u2-routine-e2", kind = "gap", prompt = "___ colazione con un caffè. (fare colazione)", options = listOf(), answers = listOf("Faccio", "faccio"), explain = "fare colazione: io faccio."), Exercise(id = "it-foundations-u2-routine-e3", kind = "order", prompt = "Di a che ora esci.", options = listOf(), answers = listOf("Esco di casa alle otto"), explain = "esco di + luogo + alle + ora."), Exercise(id = "it-foundations-u2-routine-e4", kind = "written", prompt = "La tua abitudine della domenica.", options = listOf(), answers = listOf("la domenica mi sveglio tardi", "di domenica faccio colazione tardi"), explain = "la + giorno + presente.")), skills = listOf("grammar:present-simple", "grammar:time-expressions", "vocab:daily-routine", "function:talk-about-routines"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u2-quartiere", title = "Il mio quartiere", goal = "Dire cosa c'è nel tuo quartiere con c'è / ci sono.", intro = LessonIntro(explanation = listOf("C'è per uno, ci sono per tanti: « C'è un bar, ci sono due negozi ». Non cambia per le domande: « C'è una farmacia qui vicino? »", "Negativo: « Non c'è un cinema, mi dispiace ». Con non c'è il nome resta senza articolo.", "Locazioni: davanti a, vicino a, accanto a : « Il bar è davanti al parco ». A si fonde: al, dal, nel."), examples = listOf(ExampleLine(text = "C'è un bar e ci sono due negozi.", meaning = "c'è uno, ci sono tanti."), ExampleLine(text = "C'è una farmacia qui vicino?", meaning = "La domanda utile."), ExampleLine(text = "Non c'è un cinema qui.", meaning = "La negazione."), ExampleLine(text = "Il bar è davanti al parco.", meaning = "davanti al = delante del."), ExampleLine(text = "Tutto è vicino a casa mia.", meaning = "Il riassunto comodo."))), expressions = listOf(TargetExpression(text = "C'è / ci sono + luogo", meaning = "Dire cosa c'è.", note = "c'è uno, ci sono tanti."), TargetExpression(text = "C'è … qui vicino?", meaning = "Chiedere.", note = "…una farmacia?"), TargetExpression(text = "Non c'è …", meaning = "Quello che manca.", note = "Non c'è cinema."), TargetExpression(text = "davanti a / vicino a", meaning = "Situare.", note = "davanti al parco."), TargetExpression(text = "vicino a casa mia", meaning = "La distanza.", note = "tutto è vicino.")), situation = "Un visitatore chiede del tuo quartiere: nomna quattro posti, di' cosa manca e situa il tuo preferito.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Nomina due posti del tuo quartiere.", expected = listOf("C'è <luogo> e ci sono <luoghi>."), focus = "c'è / ci sono", watch = "c'è uno, ci sono tanti."), PracticeQuestion(prompt = "Di' cosa manca. (cinema)", expected = listOf("Non c'è un cinema nel mio quartiere."), focus = "non c'è", watch = "Non c'è + luogo."), PracticeQuestion(prompt = "Chiedi se c'è una farmacia.", expected = listOf("C'è una farmacia qui vicino?"), focus = "qui vicino", watch = "qui vicino = aquí cerca."), PracticeQuestion(prompt = "Situa il tuo posto preferito.", expected = listOf("<Luogo> è davanti a <luogo>."), focus = "davanti a", watch = "davanti A + luogo."), PracticeQuestion(prompt = "Di' che tutto è vicino a casa tua.", expected = listOf("Tutto è vicino a casa mia."), focus = "vicino a", watch = "vicino A casa mia."))), exercises = listOf(Exercise(id = "it-foundations-u2-quartiere-e1", kind = "choice", prompt = "___ un bar e ci sono due negozi.", options = listOf("C'è", "Ci sono", "È", "Sono"), answers = listOf("C'è"), explain = "C'è per uno solo."), Exercise(id = "it-foundations-u2-quartiere-e2", kind = "gap", prompt = "Non ___ un cinema qui. (esiste)", options = listOf(), answers = listOf("c'è"), explain = "Non c'è + luogo."), Exercise(id = "it-foundations-u2-quartiere-e3", kind = "order", prompt = "Chiedi una farmacia.", options = listOf(), answers = listOf("Ce una farmacia qui vicino"), explain = "C'è + luogo + qui vicino?"), Exercise(id = "it-foundations-u2-quartiere-e4", kind = "written", prompt = "Di' cosa c'è davanti a casa tua.", options = listOf(), answers = listOf("ce <luogo> davanti a casa mia", "c'è <luogo> davanti a casa mia"), explain = "C'è + luogo + davanti a.")), skills = listOf("vocab:town", "grammar:there-is-are", "grammar:prepositions-place", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:there-is-are")),
    Lesson(id = "it-foundations-u2-progetti", title = "Piani per sabato", goal = "Proporre piani con si va a e fissare un appuntamento.", intro = LessonIntro(explanation = listOf("Il futuro vicino: andare a + infinito. « Sabato si va al mercato » oppure « noi andiamo al mercato ».", "Proporre: « Andiamo al mercato? », « Vuoi venire? ». Darsi appuntamento: « Ci vediamo alle sei in piazza? »", "Confermare con ora e luogo: « Perfetto, alle sei davanti al parco ». Un piano senza luogo è un desiderio."), examples = listOf(ExampleLine(text = "Sabato andiamo al mercato.", meaning = "Presente con valore di futuro."), ExampleLine(text = "Vuoi venire con noi?", meaning = "L'invito."), ExampleLine(text = "Ci vediamo alle sei in piazza?", meaning = "L'appuntamento."), ExampleLine(text = "Perfetto, ci vediamo lì.", meaning = "La conferma."), ExampleLine(text = "Se piove, lo spostiamo a domenica.", meaning = "Il piano B."))), expressions = listOf(TargetExpression(text = "andiamo a + infinito", meaning = "Il progetto.", note = "andiamo al mercato."), TargetExpression(text = "Vuoi venire?", meaning = "Invitare.", note = "venire con noi."), TargetExpression(text = "Ci vediamo alle … in …", meaning = "L'appuntamento.", note = "ci vediamo = nos vemos."), TargetExpression(text = "Perfetto / D'accordo", meaning = "Confermare.", note = "d'accordo = de acuerdo."), TargetExpression(text = "Se piove, …", meaning = "Il piano B.", note = "se + presente + piano.")), situation = "Organizzi il sabato con un amico: mercato, appuntamento alle sei davanti al parco, e piano B se piove.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Proponi il mercato con noi.", expected = listOf("Sabato andiamo al mercato."), focus = "andiamo", watch = "noi andiamo = presente per il futuro."), PracticeQuestion(prompt = "Invita il tuo amico.", expected = listOf("Vuoi venire con noi?"), focus = "venire", watch = "venire CON noi."), PracticeQuestion(prompt = "Fissa l'appuntamento. (6, piazza)", expected = listOf("Ci vediamo alle sei in piazza?"), focus = "ci vediamo", watch = "ci vediamo alle + ora."), PracticeQuestion(prompt = "Dai il piano B se piove.", expected = listOf("Se piove, lo spostiamo a domenica."), focus = "se + presente", watch = "se + presente + piano."), PracticeQuestion(prompt = "Invita il tuo amico al piano.", expected = listOf("Vuoi venire con noi?"), focus = "venire", watch = "venire CON noi."))), exercises = listOf(Exercise(id = "it-foundations-u2-progetti-e1", kind = "choice", prompt = "Sabato ___ al mercato.", options = listOf("andiamo", "vado", "va", "andare"), answers = listOf("andiamo"), explain = "noi andiamo: presente per il futuro."), Exercise(id = "it-foundations-u2-progetti-e2", kind = "gap", prompt = "Ci ___ alle sei in piazza? (vedersi)", options = listOf(), answers = listOf("vediamo"), explain = "ci vediamo = nos vemos."), Exercise(id = "it-foundations-u2-progetti-e3", kind = "order", prompt = "Fissa l'appuntamento.", options = listOf(), answers = listOf("Ci vediamo alle sei in piazza"), explain = "ci vediamo + alle + ora + in + luogo."), Exercise(id = "it-foundations-u2-progetti-e4", kind = "written", prompt = "Il piano B se piove.", options = listOf(), answers = listOf("se piove lo spostiamo a domenica", "se piove andiamo al cinema"), explain = "se + presente + piano.")), skills = listOf("grammar:going-to", "function:make-future-plans", "vocab:social-expressions", "grammar:present-questions"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to"))))
}

object ItFoundationsU5 {
    val unit = CourseUnit(id = "it-foundations-u5", title = "Al mercato", subtitle = "Compro locale", level = "A1", themes = listOf(ConversationTheme("mercato-quartiere", "Il mercato di quartiere", "Frutta e verdura", "cart", "Course", "Fate la spesa al mercato: frutta, verdura e contatino con il venditore.", 0),
                ConversationTheme("alimentari", "L'alimentari sotto casa", "Quello che manca", "storefront", "Course", "Manca qualcosa per cena: corri dall'alimentari sotto casa.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u5-mercato", title = "Al mercato", goal = "Comprare frutta e verdura: quantità, prezzi e formule educate.", intro = LessonIntro(explanation = listOf("Al mercato si chiede: « Quant'costano i pomodori ? ». « Sono maturi ? »", "Le quantità: « Mezzo chilo di cipolle ». « Un chilo di mele ».", "La formula educata: « Buongiorno, mi metta mezzo chilo di pesche, per favore »."), examples = listOf(ExampleLine(text = "Quant'costano i pomodori ?", meaning = "Il prezzo."), ExampleLine(text = "Me ne metta mezzo chilo.", meaning = "Chiedere quantità."), ExampleLine(text = "Sono maturi ?", meaning = "Qualità."), ExampleLine(text = "Due etti di prosciutto.", meaning = "Peso."), ExampleLine(text = "Vorrei delle mele.", meaning = "Vorrei + prodotto."))), expressions = listOf(TargetExpression(text = "Quant'costano …?", meaning = "Prezzo.", note = "…i pomodori ?"), TargetExpression(text = "Me ne metta + quantità", meaning = "Chiedere.", note = "Me ne metta un chilo."), TargetExpression(text = "Sono maturi/mature ?", meaning = "Qualità.", note = "maturi (m), mature (f)."), TargetExpression(text = "due etti di …", meaning = "200 g.", note = "etto = 100 g."), TargetExpression(text = "Vorrei + prodotto", meaning = "Vorrei.", note = "Vorrei delle mele.")), situation = "Fate la spesa al mercato: mezzo chilo di pomodori, un chilo di mele e chiedete se sono mature.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedete il prezzo dei pomodori.", expected = listOf("Quant costano i pomodori"), focus = "quant'costano", watch = "Quant'costano = ¿a cuánto?"), PracticeQuestion(prompt = "Chiedete mezzo chilo di cipolle.", expected = listOf("Mi metta mezzo chilo di cipolle."), focus = "me ne metta", watch = "Mi metta + cantidad."), PracticeQuestion(prompt = "Chiedete se le mele sono mature.", expected = listOf("Sono mature ?"), focus = "mature", watch = "mature (fem pl) per mele."), PracticeQuestion(prompt = "Dire cosa serve: un chilo di arance.", expected = listOf("Mi servono un chilo di arance."), focus = "mi servono", watch = "mi servono = necesito."), PracticeQuestion(prompt = "Dire che vorreste delle mele.", expected = listOf("Vorrei delle mele."), focus = "vorrei", watch = "Vorrei + prodotto."))), exercises = listOf(Exercise(id = "it-foundations-u5-mercato-e1", kind = "choice", prompt = "___ ___ i pomodori ?", options = listOf("Quant'costano", "Quanto è", "Sono costati", "Come sono"), answers = listOf("Quant'costano"), explain = "Quant'costano = ¿a cuánto?"), Exercise(id = "it-foundations-u5-mercato-e2", kind = "gap", prompt = "___ ___ mezzo chilo di cipolle. (pedir)", options = listOf(), answers = listOf("Mi metta"), explain = "Mi metta + cantidad."), Exercise(id = "it-foundations-u5-mercato-e3", kind = "order", prompt = "Chiedete il prezzo.", options = listOf(), answers = listOf("Quant costano i pomodori"), explain = "Quant' + costare + prodotto."), Exercise(id = "it-foundations-u5-mercato-e4", kind = "written", prompt = "Dire cosa serve: un chilo di arance.", options = listOf(), answers = listOf("mi servono un chilo di arance", "mi serve un chilo di arance"), explain = "Mi servono + cantidad.")), skills = listOf("vocab:food", "grammar:quantities", "vocab:shopping", "function:go-shopping"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u5-alimentari", title = "Dall'alimentari", goal = "Comprare quello che manca: cercare, chiedere e pagare.", intro = LessonIntro(explanation = listOf("All'alimentari: « Avete…? » « Sto cercando… ». Il negoziente risponde: « Sì, eccolo » o « Mi dispiace, è finito ».", "È finito = non c'è più. « Il latte è finito ».", "Il pagamento: « Quanto fa ? » « Fa sette euro »."), examples = listOf(ExampleLine(text = "Avete latte senza lattosio ?", meaning = "Chiedere se hanno."), ExampleLine(text = "Sto cercando il lievito fresco.", meaning = "Cercare qualcosa."), ExampleLine(text = "Mi dispiace, è finito.", meaning = "Non c'è più."), ExampleLine(text = "Quanto fa ?", meaning = "Chiedere il totale."), ExampleLine(text = "Fa sette euro e venti.", meaning = "Il prezzo."))), expressions = listOf(TargetExpression(text = "Avete … ?", meaning = "Chiedere in negozio.", note = "…latte senza lattosio ?"), TargetExpression(text = "Sto cercando …", meaning = "Cercare.", note = "…il lievito fresco."), TargetExpression(text = "è finito / è finita", meaning = "Non c'è più.", note = "il latte è finito."), TargetExpression(text = "Quanto fa ?", meaning = "Totale.", note = "fa + prezzo."), TargetExpression(text = "eccolo / eccola", meaning = "Ecco il prodotto.", note = "Eccolo! = aquí está.")), situation = "Corri dall'alimentari prima che chiuda: cerchi tre cose, due le ha e una è finita.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedere se hanno latte senza lattosio.", expected = listOf("Avete latte senza lattosio ?"), focus = "avete", watch = "Avete + prodotto ?"), PracticeQuestion(prompt = "Dire che cerchi lievito fresco.", expected = listOf("Sto cercando il lievito fresco."), focus = "sto cercando", watch = "sto cercando = estoy buscando."), PracticeQuestion(prompt = "Reagire quando è finito.", expected = listOf("Ah, peccato! Grazie lo stesso."), focus = "peccato", watch = "peccato = lástima."), PracticeQuestion(prompt = "Chiedere il totale.", expected = listOf("Quanto fa ?"), focus = "quanto fa", watch = "Quanto fa ? = ¿cuánto es?"), PracticeQuestion(prompt = "Dire che cercate lievito fresco.", expected = listOf("Sto cercando il lievito fresco."), focus = "sto cercando", watch = "sto cercando = estoy buscando."))), exercises = listOf(Exercise(id = "it-foundations-u5-alimentari-e1", kind = "choice", prompt = "___ latte senza lattosio ?", options = listOf("Avete", "Ci sono", "C'è", "Siete"), answers = listOf("Avete"), explain = "Avete + prodotto ?"), Exercise(id = "it-foundations-u5-alimentari-e2", kind = "gap", prompt = "Sto ___ il lievito fresco. (cercare)", options = listOf(), answers = listOf("cercando"), explain = "sto cercando + producto."), Exercise(id = "it-foundations-u5-alimentari-e3", kind = "order", prompt = "Chiedete il totale.", options = listOf(), answers = listOf("Quanto fa tutto insieme"), explain = "Quanto fa ?"), Exercise(id = "it-foundations-u5-alimentari-e4", kind = "written", prompt = "Dire che cercate lievito fresco.", options = listOf(), answers = listOf("sto cercando lievito fresco", "sto cercando del lievito fresco"), explain = "Sto cercando + prodotto.")), skills = listOf("function:go-shopping", "grammar:present-questions", "vocab:food", "function:solve-problems"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple"))))
}

object ItFoundationsU10 {
    val unit = CourseUnit(id = "it-foundations-u10", title = "Casa mia", subtitle = "Il mio spazio", level = "A1", themes = listOf(ConversationTheme("casa-stanze", "Le stanze di casa", "C'è / ci sono", "house", "Course", "Entri nel tuo appartamento nuovo: descrivi le stanze e i mobili.", 0),
                ConversationTheme("il-mio-spazio", "Le mie cose", "Dov'è ?", "bed", "Course", "Ogni cosa al suo posto: cerchi le tue cose e presenti il coinquilino.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u10-casa", title = "Il mio appartamento", goal = "Descrivere le stanze e i mobili di casa con c'è e ci sono.", intro = LessonIntro(explanation = listOf("Per una cosa usi c'è: « Nella cucina c'è un tavolo ». Per più cose usi ci sono: « Nella cucina ci sono due sedie ».", "La domanda è semplice: « C'è il bagno ? » — « Sì, c'è ». E la negazione: « Non c'è la lavatrice ».", "Le stanze di casa: « la cucina », « la camera da letto », « il bagno », « il soggiorno ». « Il soggiorno è grande e luminoso »."), examples = listOf(ExampleLine(text = "C'è un divano nel soggiorno.", meaning = "Una cosa sola."), ExampleLine(text = "Ci sono due camere.", meaning = "Più cose."), ExampleLine(text = "Non c'è la lavatrice.", meaning = "Negare."), ExampleLine(text = "Il bagno è piccolo ma pulito.", meaning = "Descrivere una stanza."), ExampleLine(text = "La cucina è grande ?", meaning = "Chiedere di una stanza."))), expressions = listOf(TargetExpression(text = "c'è + singolare", meaning = "Una cosa sola.", note = "C'è un tavolo."), TargetExpression(text = "ci sono + plurale", meaning = "Più cose.", note = "Ci sono due sedie."), TargetExpression(text = "non c'è / non ci sono", meaning = "Negare.", note = "Non c'è la lavatrice."), TargetExpression(text = "C'è … ?", meaning = "Chiedere.", note = "C'è il bagno ?"), TargetExpression(text = "la camera da letto", meaning = "La stanza per dormire.", note = "La camera è luminosa.")), situation = "Entri nel tuo appartamento nuovo e lo descrivi a un'amica: la cucina, il soggiorno e le due camere.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dì dove sta il divano: nel soggiorno.", expected = listOf("Nel soggiorno c'è un divano.", "Nel soggiorno c'e un divano.", "In soggiorno c'è un divano."), focus = "c'è", watch = "c'è = hay (una cosa)."), PracticeQuestion(prompt = "Conta i mobili della cucina: due sedie.", expected = listOf("In cucina ci sono due sedie.", "Nella cucina ci sono due sedie."), focus = "ci sono", watch = "ci sono = hay (plurale)."), PracticeQuestion(prompt = "Dì che la lavatrice manca.", expected = listOf("Non c'è la lavatrice.", "Non c'e la lavatrice.", "Non c'è lavatrice."), focus = "non c'è", watch = "non c'è = no hay."), PracticeQuestion(prompt = "Chiedi se la casa ha il bagno.", expected = listOf("C'è il bagno ?", "C'e il bagno ?", "C'è un bagno ?"), focus = "c'è…?", watch = "Domanda con c'è."), PracticeQuestion(prompt = "Descrivi la tua camera: piccola ma luminosa.", expected = listOf("La camera è piccola ma luminosa.", "La mia camera è piccola ma luminosa.", "La camera e piccola ma luminosa."), focus = "essere + aggettivo", watch = "ma = pero."), PracticeQuestion(prompt = "Contiamo le finestre del soggiorno: due.", expected = listOf("Nel soggiorno ci sono due finestre.", "In soggiorno ci sono due finestre."), focus = "ci sono", watch = "Due cose → ci sono."))), exercises = listOf(Exercise(id = "it-foundations-u10-casa-e1", kind = "choice", prompt = "___ un divano nel soggiorno.", options = listOf("C'è", "Ci sono", "Sono", "Hanno"), answers = listOf("C'è"), explain = "Una cosa sola → c'è."), Exercise(id = "it-foundations-u10-casa-e2", kind = "gap", prompt = "Nella cucina ___ due sedie. (essere)", options = listOf(), answers = listOf("ci sono"), explain = "Plurale → ci sono."), Exercise(id = "it-foundations-u10-casa-e3", kind = "order", prompt = "Descrivi il bagno: piccolo, ma pulito.", options = listOf(), answers = listOf("Il bagno è piccolo ma pulito"), explain = "essere + aggettivo."), Exercise(id = "it-foundations-u10-casa-e4", kind = "written", prompt = "Descrivi il soggiorno: una finestra grande.", options = listOf(), answers = listOf("Nel soggiorno c'è una finestra grande.", "Nel soggiorno c'e una finestra grande.", "In soggiorno c'è una finestra grande."), explain = "c'è + una cosa sola.")), skills = listOf("grammar:there-is-are", "grammar:present-simple", "vocab:home", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u10-posti", title = "Dov'è ?", goal = "Dire dov'è una cosa: sopra, sotto, accanto a.", intro = LessonIntro(explanation = listOf("Per chiedere dove sta una cosa: « Dov'è il gatto ? ». La risposta usa il posto: « È sotto il letto ».", "Sopra = sulla superficie: « Il libro è sopra il tavolo ». Sotto = in basso: « Le scarpe sono sotto il letto ».", "Accanto a = di lato: « La lampada è accanto al letto ». Vicino a = non lontano: « Il bagno è vicino alla cucina »."), examples = listOf(ExampleLine(text = "Dov'è il gatto ?", meaning = "Chiedere il posto."), ExampleLine(text = "È sopra il tavolo.", meaning = "Sulla superficie."), ExampleLine(text = "Le chiavi sono sotto il divano.", meaning = "In basso."), ExampleLine(text = "La sedia è accanto al tavolo.", meaning = "Di lato."), ExampleLine(text = "Il bagno è vicino alla cucina.", meaning = "Non lontano."))), expressions = listOf(TargetExpression(text = "Dov'è … ?", meaning = "Chiedere il posto.", note = "Dov'è il gatto ?"), TargetExpression(text = "sopra", meaning = "Sulla superficie.", note = "sopra il tavolo."), TargetExpression(text = "sotto", meaning = "In basso.", note = "sotto il letto."), TargetExpression(text = "accanto a", meaning = "Di lato.", note = "accanto al letto."), TargetExpression(text = "vicino a", meaning = "Non lontano.", note = "vicino alla finestra.")), situation = "Cerchi le tue cose in casa: il libro è sopra il tavolo, le chiavi sono sotto il divano e la lampada è accanto al letto.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dì dove sta il libro: sulla superficie del tavolo.", expected = listOf("Il libro è sopra il tavolo.", "Il libro e sopra il tavolo.", "Sta sopra il tavolo."), focus = "sopra", watch = "sopra = encima de."), PracticeQuestion(prompt = "Dì dove stanno le scarpe: in basso.", expected = listOf("Le scarpe sono sotto il letto.", "Sono sotto il letto."), focus = "sotto", watch = "sotto = debajo de."), PracticeQuestion(prompt = "Chiedi dove sta il gatto.", expected = listOf("Dov'è il gatto ?", "Dov'e il gatto ?", "Dove è il gatto ?"), focus = "dov'è", watch = "Dov'è = dónde está."), PracticeQuestion(prompt = "Dì dove sta la lampada: di lato al letto.", expected = listOf("La lampada è accanto al letto.", "La lampada e accanto al letto."), focus = "accanto a", watch = "accanto a = al lado de."), PracticeQuestion(prompt = "Dì che il bagno non è lontano dalla cucina.", expected = listOf("Il bagno è vicino alla cucina.", "Il bagno e vicino alla cucina."), focus = "vicino a", watch = "vicino a = cerca de."), PracticeQuestion(prompt = "Riassumi: il gatto sta sulla poltrona.", expected = listOf("Il gatto è sopra la poltrona.", "Il gatto e sopra la poltrona."), focus = "sopra", watch = "Ripasso: sopra = encima de."))), exercises = listOf(Exercise(id = "it-foundations-u10-posti-e1", kind = "choice", prompt = "La lampada è ___ al letto, di lato.", options = listOf("accanto", "sopra", "sotto", "dove"), answers = listOf("accanto"), explain = "Di lato → accanto a."), Exercise(id = "it-foundations-u10-posti-e2", kind = "gap", prompt = "La sedia è ___ al tavolo. (di lato)", options = listOf(), answers = listOf("accanto"), explain = "accanto a = di lato."), Exercise(id = "it-foundations-u10-posti-e3", kind = "order", prompt = "Chiedi dove sta il gatto.", options = listOf(), answers = listOf("Dov'è il gatto"), explain = "Dov'è + cosa ?"), Exercise(id = "it-foundations-u10-posti-e4", kind = "written", prompt = "Dì dove stanno le scarpe: in basso, sotto il letto.", options = listOf(), answers = listOf("Le scarpe sono sotto il letto.", "Sono sotto il letto.", "Le scarpe stanno sotto il letto."), explain = "sotto + il letto.")), skills = listOf("grammar:prepositions-place", "grammar:there-is-are", "vocab:home", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u10-coinquilino", title = "Il mio coinquilino", goal = "Descrivere una persona e dire di chi è una cosa: mio, tuo, suo.", intro = LessonIntro(explanation = listOf("I possessivi vanno con l'articolo: « il mio », « il tuo », « il suo ». « Il mio coinquilino è Luca ». « La tua camera è piccola ».", "Mio, tuo, suo si accordano con la cosa, non con la persona: « il suo libro », « le sue chiavi » (di lui o di lei).", "Per descrivere una persona: « Luca è simpatico e ordinato ». E il lavoro: « Luca lavora in un bar »."), examples = listOf(ExampleLine(text = "Il mio coinquilino è Luca.", meaning = "Presentare."), ExampleLine(text = "La sua camera è ordinata.", meaning = "Possessivo."), ExampleLine(text = "Le sue cose sono in bagno.", meaning = "Plurale."), ExampleLine(text = "Luca è simpatico e tranquillo.", meaning = "Carattere."), ExampleLine(text = "Luca lavora in un bar.", meaning = "Lavoro."))), expressions = listOf(TargetExpression(text = "il mio / la mia", meaning = "Di me.", note = "il mio ragazzo, la mia camera."), TargetExpression(text = "il tuo / la tua", meaning = "Di te.", note = "la tua borsa."), TargetExpression(text = "il suo / la sua", meaning = "Di lui o di lei.", note = "il suo libro."), TargetExpression(text = "i miei / le mie", meaning = "Plurale.", note = "le mie chiavi."), TargetExpression(text = "essere + aggettivo", meaning = "Descrivere.", note = "Luca è ordinato.")), situation = "Luca, il tuo coinquilino nuovo, arriva con le sue cose: lo presenti e descrivi la vita in due.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Presenta il coinquilino: Luca.", expected = listOf("Il mio coinquilino è Luca.", "Il mio coinquilino e Luca."), focus = "il mio", watch = "il mio = mi (con articolo)."), PracticeQuestion(prompt = "Dì di chi è la camera: di lei, è ordinata.", expected = listOf("La sua camera è ordinata.", "La sua camera e ordinata."), focus = "la sua", watch = "suo/a = su (di lui o di lei)."), PracticeQuestion(prompt = "Dì che sono le tue chiavi.", expected = listOf("Sono le mie chiavi.", "Le chiavi sono le mie."), focus = "le mie", watch = "mie = mis (plurale)."), PracticeQuestion(prompt = "Descrivi Luca: simpatico e ordinato.", expected = listOf("Luca è simpatico e ordinato.", "Luca e simpatico e ordinato."), focus = "aggettivi", watch = "ordinato = ordenado."), PracticeQuestion(prompt = "Dì dove lavora Luca: in un bar.", expected = listOf("Luca lavora in un bar.", "Lavora in un bar."), focus = "lavora in", watch = "lavorare = trabajar."), PracticeQuestion(prompt = "Hai trovato un libro in salotto: chiedi a chi appartiene.", expected = listOf("Di chi è questo libro ?", "Di chi e questo libro ?", "Di chi è il libro ?"), focus = "di chi è", watch = "di chi è = ¿de quién es?"))), exercises = listOf(Exercise(id = "it-foundations-u10-coinquilino-e1", kind = "choice", prompt = "___ coinquilino è molto ordinato.", options = listOf("Il mio", "Il miei", "La mia", "Le mie"), answers = listOf("Il mio"), explain = "Maschile singolare → il mio."), Exercise(id = "it-foundations-u10-coinquilino-e2", kind = "gap", prompt = "Luca mette le ___ chiavi sul tavolo. (di lui)", options = listOf(), answers = listOf("sue"), explain = "le sue chiavi = sus llaves."), Exercise(id = "it-foundations-u10-coinquilino-e3", kind = "order", prompt = "Dì di chi è la camera ordinata: di lei.", options = listOf(), answers = listOf("La sua camera è ordinata"), explain = "il suo / la sua + cosa."), Exercise(id = "it-foundations-u10-coinquilino-e4", kind = "written", prompt = "Presenta il tuo coinquilino: è simpatico.", options = listOf(), answers = listOf("Il mio coinquilino è simpatico.", "Il mio coinquilino e simpatico.", "Luca è simpatico."), explain = "il mio + persona + aggettivo.")), skills = listOf("grammar:possessives", "function:describe-people", "vocab:home", "grammar:present-simple"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:possessives"))))
}

object ItFoundationsU11 {
    val unit = CourseUnit(id = "it-foundations-u11", title = "Il mio quartiere", subtitle = "Vicino a casa", level = "A1", themes = listOf(ConversationTheme("luoghi-quartiere", "I luoghi del quartiere", "Cosa c'è qui vicino", "map", "Course", "Sei nuovo nel quartiere: cerchi i posti utili e chiedi la strada.", 0),
                ConversationTheme("spesa-frutta", "La frutta del quartiere", "Dal fruttivendolo", "cart", "Course", "Fai la spesa di frutta per la settimana dal fruttivendolo sotto casa.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u11-luoghi", title = "C'è un supermercato ?", goal = "Chiedere se ci sono posti nel quartiere con c'è e ci sono.", intro = LessonIntro(explanation = listOf("Per chiedere un posto: « Scusi, c'è un supermercato qui vicino ? ». La risposta: « Sì, c'è, in via Roma ».", "Per più posti usi ci sono: « Ci sono farmacie in zona ? » — « Sì, due ». E la negazione: « Qui non c'è una banca ».", "I posti del quartiere: « il supermercato », « la farmacia », « la banca », « la fermata dell'autobus », « il parco »."), examples = listOf(ExampleLine(text = "Scusi, c'è un supermercato qui vicino ?", meaning = "Chiedere."), ExampleLine(text = "Sì, c'è, in via Roma.", meaning = "Rispondere."), ExampleLine(text = "Ci sono farmacie in zona ?", meaning = "Plurale."), ExampleLine(text = "Non c'è una banca qui.", meaning = "Negare."), ExampleLine(text = "La fermata è dietro l'angolo.", meaning = "Il posto."))), expressions = listOf(TargetExpression(text = "Scusi, c'è … ?", meaning = "Chiedere educata.", note = "…un supermercato qui vicino ?"), TargetExpression(text = "c'è, in + via/piazza", meaning = "Rispondere.", note = "c'è, in via Roma."), TargetExpression(text = "ci sono + plurale ?", meaning = "Chiedere più posti.", note = "Ci sono farmacie ?"), TargetExpression(text = "non c'è / non ci sono", meaning = "Negare.", note = "Non c'è una banca."), TargetExpression(text = "in zona / qui vicino", meaning = "Qui intorno.", note = "c'è un parco in zona ?")), situation = "Sei nuovo nel quartiere: chiedi a una signora in strada dove stanno supermercato, farmacia e fermata.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedi educatamente se qui intorno si trova un supermercato.", expected = listOf("Scusi, c'è un supermercato qui vicino ?", "Scusi, c'e un supermercato qui vicino ?", "C'è un supermercato qui vicino ?"), focus = "scusi, c'è", watch = "Scusi = pregunta educada."), PracticeQuestion(prompt = "Rispondi: sì, in via Roma.", expected = listOf("Sì, c'è, in via Roma.", "Si, c'e, in via Roma.", "C'è, in via Roma."), focus = "c'è + posto", watch = "Sì, c'è = sí, hay."), PracticeQuestion(prompt = "Chiedi se in zona si trovano farmacie.", expected = listOf("Ci sono farmacie in zona ?", "Ci sono farmacie in zona"), focus = "ci sono…?", watch = "plurale → ci sono."), PracticeQuestion(prompt = "Dì che manca la banca qui.", expected = listOf("Qui non c'è una banca.", "Qui non c'e una banca.", "Non c'è una banca qui."), focus = "non c'è", watch = "non c'è = no hay."), PracticeQuestion(prompt = "Ti serve l'autobus: chiedi il posto della fermata.", expected = listOf("Dov'è la fermata dell'autobus ?", "Dov'e la fermata dell'autobus ?", "Dove è la fermata ?"), focus = "dov'è", watch = "Dov'è = dónde está."), PracticeQuestion(prompt = "Rispondi: il parco sta dietro l'angolo.", expected = listOf("Il parco è dietro l'angolo.", "Il parco e dietro l'angolo."), focus = "è + posto", watch = "dietro l'angolo = a la vuelta."))), exercises = listOf(Exercise(id = "it-foundations-u11-luoghi-e1", kind = "choice", prompt = "Scusi, ___ un supermercato qui vicino ?", options = listOf("c'è", "ci sono", "è", "hanno"), answers = listOf("c'è"), explain = "Singolare → c'è."), Exercise(id = "it-foundations-u11-luoghi-e2", kind = "gap", prompt = "___ due farmacie in zona. (essere)", options = listOf(), answers = listOf("ci sono"), explain = "Plurale → ci sono."), Exercise(id = "it-foundations-u11-luoghi-e3", kind = "order", prompt = "Chiedi educatamente il supermercato.", options = listOf(), answers = listOf("Scusi c'è un supermercato qui vicino"), explain = "Scusi + c'è + posto."), Exercise(id = "it-foundations-u11-luoghi-e4", kind = "written", prompt = "Rispondi che la farmacia qui manca.", options = listOf(), answers = listOf("Non c'è una farmacia qui.", "Non c'e una farmacia qui.", "qui non c'e una farmacia"), explain = "non c'è + posto.")), skills = listOf("grammar:there-is-are", "grammar:present-questions", "vocab:town", "function:ask-simple-questions"), canDo = listOf("ask-for-directions"), prerequisites = listOf("grammar:there-is-are")),
    Lesson(id = "it-foundations-u11-indicazioni", title = "Come arrivo ?", goal = "Chiedere e dare indicazioni semplici: dritto, sinistra, destra, vicino.", intro = LessonIntro(explanation = listOf("Per chiedere la strada: « Scusi, come arrivo al supermercato ? ». La risposta usa vada: « Vada sempre dritto ».", "Per girare: « Alla piazza giri a sinistra ». Poi la distanza: « Il supermercato è lì, vicino al parco ».", "Per ringraziare: « Grazie mille ! ». La risposta: « Prego ! »."), examples = listOf(ExampleLine(text = "Scusi, come arrivo alla stazione ?", meaning = "Chiedere la strada."), ExampleLine(text = "Vada sempre dritto.", meaning = "Indicazione."), ExampleLine(text = "All'angolo giri a sinistra.", meaning = "Indicazione."), ExampleLine(text = "È vicino, cinque minuti a piedi.", meaning = "Distanza."), ExampleLine(text = "Grazie mille ! — Prego !", meaning = "Educate."))), expressions = listOf(TargetExpression(text = "come arrivo a/al/alla … ?", meaning = "Chiedere la strada.", note = "come arrivo al supermercato ?"), TargetExpression(text = "vada sempre dritto", meaning = "Indicazione.", note = "dritto fino alla piazza."), TargetExpression(text = "giri a sinistra/destra", meaning = "Girare.", note = "giri a destra alla farmacia."), TargetExpression(text = "è vicino / è lì", meaning = "Distanza corta.", note = "è lì, vicino al parco."), TargetExpression(text = "grazie mille — prego", meaning = "Educate.", note = "Prego !")), situation = "Cerchi il supermercato: una signora ti spiega la strada e tu ringrazi.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedi la strada per il supermercato.", expected = listOf("Scusi, come arrivo al supermercato ?", "Come arrivo al supermercato ?"), focus = "come arrivo", watch = "come arrivo a…? = ¿cómo llego a…?"), PracticeQuestion(prompt = "Dai l'indicazione: sempre dritto.", expected = listOf("Vada sempre dritto.", "Vada dritto."), focus = "vada dritto", watch = "vada = formal (usted)."), PracticeQuestion(prompt = "Dai l'indicazione: alla piazza, a sinistra.", expected = listOf("Alla piazza giri a sinistra.", "Giri a sinistra alla piazza."), focus = "giri a sinistra", watch = "giri = gire; sinistra = izquierda."), PracticeQuestion(prompt = "Dai la distanza: cinque minuti a piedi.", expected = listOf("È vicino, cinque minuti a piedi.", "E vicino, cinque minuti a piedi."), focus = "è vicino", watch = "vicino = cerca."), PracticeQuestion(prompt = "Ringrazia con forza.", expected = listOf("Grazie mille !", "Grazie mille"), focus = "grazie mille", watch = "mille = mil."), PracticeQuestion(prompt = "Rispondi a un grazie.", expected = listOf("Prego !", "Prego"), focus = "prego", watch = "prego = de nada."))), exercises = listOf(Exercise(id = "it-foundations-u11-indicazioni-e1", kind = "choice", prompt = "Scusi, come arrivo ___ supermercato ?", options = listOf("al", "allo", "a il", "della"), answers = listOf("al"), explain = "a + il → al."), Exercise(id = "it-foundations-u11-indicazioni-e2", kind = "gap", prompt = "Vada sempre ___, poi giri a destra. (avanti, linea retta)", options = listOf(), answers = listOf("dritto"), explain = "andare dritto = seguir recto."), Exercise(id = "it-foundations-u11-indicazioni-e3", kind = "order", prompt = "Dai l'indicazione: dritto.", options = listOf(), answers = listOf("Vada sempre dritto"), explain = "vada + sempre + dritto."), Exercise(id = "it-foundations-u11-indicazioni-e4", kind = "written", prompt = "Dì che il supermercato è a poca distanza: due minuti a piedi.", options = listOf(), answers = listOf("Il supermercato è vicino.", "Il supermercato e vicino.", "È vicino, due minuti a piedi."), explain = "vicino + minuti a piedi.")), skills = listOf("function:ask-for-directions", "vocab:directions", "grammar:present-simple", "vocab:town"), canDo = listOf("ask-for-directions"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u11-fruttivendolo", title = "Dal fruttivendolo", goal = "Comprare frutta: quantità e prezzo dal fruttivendolo del quartiere.", intro = LessonIntro(explanation = listOf("Dal fruttivendolo si ordina con vorrei: « Buongiorno, vorrei delle mele ». È educato e semplice.", "Le quantità: « un chilo di arance », « mezzo chilo di banane », « una mela ».", "Per pagare: « Quanto fa ? » — « Fa tre euro e venti »."), examples = listOf(ExampleLine(text = "Vorrei delle mele.", meaning = "Ordinare."), ExampleLine(text = "Un chilo di arance.", meaning = "Quantità."), ExampleLine(text = "Mezzo chilo di banane.", meaning = "Quantità."), ExampleLine(text = "Quanto fa ?", meaning = "Chiedere il totale."), ExampleLine(text = "Fa tre euro e venti.", meaning = "Il prezzo."))), expressions = listOf(TargetExpression(text = "vorrei + frutta", meaning = "Ordinare educata.", note = "vorrei delle mele."), TargetExpression(text = "un chilo di …", meaning = "1 kg.", note = "un chilo di arance."), TargetExpression(text = "mezzo chilo di …", meaning = "Medio kilo.", note = "mezzo chilo di banane."), TargetExpression(text = "Quanto fa ?", meaning = "Totale.", note = "fa due euro."), TargetExpression(text = "Che altro ?", meaning = "Il venditore chiede.", note = "Sì, grazie.")), situation = "Fai la spesa di frutta dal fruttivendolo sotto casa: un chilo di arance, mezzo chilo di banane e delle mele.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ordina educatamente delle mele.", expected = listOf("Vorrei delle mele.", "vorrei delle mele"), focus = "vorrei", watch = "vorrei = quisiera."), PracticeQuestion(prompt = "Chiedi un chilo di arance.", expected = listOf("Un chilo di arance, per favore.", "Vorrei un chilo di arance."), focus = "un chilo di", watch = "chilo = kilo."), PracticeQuestion(prompt = "Chiedi le banane: la quantità è mezzo chilo.", expected = listOf("Mezzo chilo di banane.", "Vorrei mezzo chilo di banane."), focus = "mezzo chilo", watch = "mezzo = medio."), PracticeQuestion(prompt = "Chiedi il totale.", expected = listOf("Quanto fa ?", "Quanto fa"), focus = "quanto fa", watch = "Quanto fa ? = ¿cuánto es?"), PracticeQuestion(prompt = "Il venditore dice il prezzo: tre euro e venti.", expected = listOf("Fa tre euro e venti.", "Sono tre euro e venti."), focus = "fa + prezzo", watch = "fa = suma/son."), PracticeQuestion(prompt = "Dì che va bene così e ringrazi.", expected = listOf("Tutto qui, grazie.", "Basta così, grazie.", "Basta cosi, grazie."), focus = "chiusura", watch = "Tutto qui = eso es todo."))), exercises = listOf(Exercise(id = "it-foundations-u11-fruttivendolo-e1", kind = "choice", prompt = "Buongiorno, ___ delle mele, per favore.", options = listOf("vorrei", "voglio di", "vorresti", "sono"), answers = listOf("vorrei"), explain = "vorrei = forma educata."), Exercise(id = "it-foundations-u11-fruttivendolo-e2", kind = "gap", prompt = "Vorrei ___ chilo di arance. (1 kg)", options = listOf(), answers = listOf("un"), explain = "un chilo di + frutta."), Exercise(id = "it-foundations-u11-fruttivendolo-e3", kind = "order", prompt = "Chiedi il totale.", options = listOf(), answers = listOf("Quanto fa tutto insieme"), explain = "Quanto fa ?"), Exercise(id = "it-foundations-u11-fruttivendolo-e4", kind = "written", prompt = "Ordina mezzo chilo di banane.", options = listOf(), answers = listOf("Mezzo chilo di banane, per favore.", "Vorrei mezzo chilo di banane."), explain = "mezzo chilo di + frutta.")), skills = listOf("function:go-shopping", "grammar:quantities", "vocab:food", "grammar:present-simple"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple"))))
}

object ItFoundationsU12 {
    val unit = CourseUnit(id = "it-foundations-u12", title = "La mia gente", subtitle = "Famiglia e amici", level = "A1", themes = listOf(ConversationTheme("la-mia-gente-famiglia", "La famiglia", "Ho uno zio", "figure-2", "Course", "Una cena in famiglia: la sorella, i genitori e lo zio di Napoli — e tu presenti le persone.", 0),
                ConversationTheme("la-mia-gente-amici", "Amici e carattere", "È simpatico", "heart", "Course", "Una festa con gli amici: chi è simpatico, chi è timido — e tu descrivi le persone.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u12-famiglia", title = "La mia famiglia", goal = "Presentare la famiglia: i membri, mio/mia e « ho uno zio ».", intro = LessonIntro(explanation = listOf("I membri della famiglia: « il padre, la madre, il fratello, la sorella. » Papà e mamma sono più informali.", "Il possessivo dice di chi è la persona: « mio fratello, mia sorella, i miei genitori, le mie cugine. » Mio per il maschile, mia per il femminile, miei/mie per il plurale.", "Con avere presenti un parente: « Ho due cugini. Ho uno zio a Napoli. » Davanti a z si usa uno: uno zio, uno studente."), examples = listOf(ExampleLine(text = "Questa è mia sorella.", meaning = "mia + persona femminile."), ExampleLine(text = "Mio fratello si chiama Luca.", meaning = "mio + persona maschile."), ExampleLine(text = "I miei genitori abitano a Roma.", meaning = "Plurale: i miei."), ExampleLine(text = "Ho uno zio simpatico.", meaning = "Avere + uno zio."), ExampleLine(text = "Ho due cugine e un cugino.", meaning = "I cugini: maschile e femminile."))), expressions = listOf(TargetExpression(text = "il padre / la madre", meaning = "I genitori.", note = "Papà e mamma, più informali."), TargetExpression(text = "il fratello / la sorella", meaning = "I fratelli.", note = "Plurale: i fratelli, le sorelle."), TargetExpression(text = "mio / mia / miei / mie", meaning = "Il possessivo.", note = "Mio fratello, mia sorella, i miei amici."), TargetExpression(text = "Ho uno zio.", meaning = "Avere + un parente.", note = "Uno davanti a z: uno zio, uno studente."), TargetExpression(text = "il cugino / la cugina", meaning = "I figli di zio e zia.", note = "Plurale: i cugini, le cugine.")), situation = "Una cena di famiglia: presenti la sorella, i genitori e racconti dello zio di Napoli con le foto sul telefono.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Presenta tua sorella: si chiama Giulia.", expected = listOf("Questa è mia sorella, Giulia.", "Questa e mia sorella, Giulia.", "Mia sorella si chiama Giulia."), focus = "mia sorella", watch = "Sorella è femminile: mia."), PracticeQuestion(prompt = "Presenta tuo fratello: si chiama Marco.", expected = listOf("Mio fratello si chiama Marco.", "Mio fratello, Marco, ha ventidue anni."), focus = "mio fratello", watch = "Fratello è maschile: mio."), PracticeQuestion(prompt = "I tuoi genitori abitano a Milano. Dillo.", expected = listOf("I miei genitori abitano a Milano.", "I miei genitori vivono a Milano."), focus = "i miei", watch = "Plurale: i miei genitori."), PracticeQuestion(prompt = "Hai una zia a Firenze. Dillo con ho.", expected = listOf("Ho una zia a Firenze.", "Ho una zia a Firenze, vicino al centro."), focus = "ho una zia", watch = "Zia è femminile: una zia."), PracticeQuestion(prompt = "Hai anche uno zio a Napoli. Dillo.", expected = listOf("Ho uno zio a Napoli.", "Ho uno zio che abita a Napoli."), focus = "uno zio", watch = "Uno davanti a z: uno zio."))), exercises = listOf(Exercise(id = "it-foundations-u12-famiglia-e1", kind = "choice", prompt = "___ sorella abita a Bologna.", options = listOf("Mia", "Mio", "Miei", "Le"), answers = listOf("Mia"), explain = "Sorella è femminile singolare: mia sorella."), Exercise(id = "it-foundations-u12-famiglia-e2", kind = "gap", prompt = "Ho ___ zio molto simpatico.", options = listOf(), answers = listOf("uno"), explain = "Zio inizia con z: uno zio."), Exercise(id = "it-foundations-u12-famiglia-e3", kind = "order", prompt = "Presenta i tuoi genitori e la loro città.", options = listOf(), answers = listOf("I miei genitori abitano a Roma"), explain = "I miei + nome plurale + verbo + luogo."), Exercise(id = "it-foundations-u12-famiglia-e4", kind = "written", prompt = "Presenta tua sorella: si chiama Sara ed è simpatica.", options = listOf(), answers = listOf("Mia sorella si chiama Sara ed è simpatica.", "Mia sorella si chiama Sara ed e simpatica.", "Questa è mia sorella Sara.", "Questa e mia sorella Sara."), explain = "mia + sorella + si chiama + nome.")), skills = listOf("vocab:family", "grammar:possessives", "grammar:present-simple", "function:describe-people"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:possessives")),
    Lesson(id = "it-foundations-u12-amici", title = "Com'è ?", goal = "Descrivere amici e parenti con gli aggettivi: simpatico, timido, lavoratore.", intro = LessonIntro(explanation = listOf("Per descrivere una persona si usa essere + aggettivo: « Marco è simpatico. Giulia è simpatica. » Maschile in -o, femminile in -a.", "Al plurale l'aggettivo cambia: « I miei amici sono simpatici. Le mie amiche sono simpatiche. »", "Aggettivi utili per il carattere: « Luca è timido, non parla molto. Paolo è lavoratore, lavora tanto. » Per chiedere: « Com'è Giulia ? »"), examples = listOf(ExampleLine(text = "Marco è simpatico.", meaning = "Maschile: simpatico."), ExampleLine(text = "Giulia è simpatica.", meaning = "Femminile: simpatica."), ExampleLine(text = "Luca è un po' timido.", meaning = "Timido: non parla molto."), ExampleLine(text = "Paolo è molto lavoratore.", meaning = "Lavoratore: lavora tanto."), ExampleLine(text = "Le mie amiche sono gentili.", meaning = "Plurale femminile: -i / -e."))), expressions = listOf(TargetExpression(text = "Com'è … ?", meaning = "Chiedere il carattere.", note = "Com'è Marco ? È simpatico."), TargetExpression(text = "simpatico / simpatica", meaning = "Gentile, piacevole.", note = "Plurale: simpatici / simpatiche."), TargetExpression(text = "timido / timida", meaning = "Non parla molto.", note = "Mia cugina è timida."), TargetExpression(text = "lavoratore / lavoratrice", meaning = "Lavora molto.", note = "Paolo è molto lavoratore."), TargetExpression(text = "un po' …", meaning = "Un piccolo grado.", note = "È un po' timido.")), situation = "Alla festa di Giulia ci sono amici nuovi: chi è simpatico, chi è timido — e tu descrivi le persone.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Descrivi Marco: piacevole.", expected = listOf("Marco è simpatico.", "Marco e simpatico."), focus = "simpatico", watch = "Maschile: simpatico."), PracticeQuestion(prompt = "Descrivi Anna: piacevole.", expected = listOf("Anna è simpatica.", "Anna e simpatica."), focus = "simpatica", watch = "Femminile: simpatica."), PracticeQuestion(prompt = "Luca non parla molto. Descrivilo.", expected = listOf("Luca è timido.", "Luca e timido.", "Luca è un po' timido."), focus = "timido", watch = "Timido = persona riservata."), PracticeQuestion(prompt = "Paolo lavora tanto. Descrivilo.", expected = listOf("Paolo è lavoratore.", "Paolo e lavoratore."), focus = "lavoratore", watch = "Lavoratore = lavora molto."), PracticeQuestion(prompt = "Chiedi il carattere di Giulia.", expected = listOf("Com'è Giulia ?", "Com'e Giulia ?"), focus = "com'è", watch = "Com'è = come + è."))), exercises = listOf(Exercise(id = "it-foundations-u12-amici-e1", kind = "choice", prompt = "Giulia parla con tutti: è molto ___.", options = listOf("simpatica", "simpatico", "simpatici", "simpatiche"), answers = listOf("simpatica"), explain = "Giulia è femminile singolare: simpatica."), Exercise(id = "it-foundations-u12-amici-e2", kind = "gap", prompt = "Luca non parla molto: è ___.", options = listOf(), answers = listOf("timido"), explain = "Timido = persona riservata, che parla poco."), Exercise(id = "it-foundations-u12-amici-e3", kind = "order", prompt = "Descrivi due amici simpatici.", options = listOf(), answers = listOf("Marco e Anna sono simpatici"), explain = "Nome + essere + aggettivo plurale."), Exercise(id = "it-foundations-u12-amici-e4", kind = "written", prompt = "Descrivi il tuo amico Marco: simpatico e un po' timido.", options = listOf(), answers = listOf("Marco è simpatico e un po' timido.", "Marco e simpatico e un po timido.", "Marco e simpatico e un po' timido."), explain = "essere + due aggettivi per il carattere.")), skills = listOf("function:describe-people", "grammar:present-simple", "vocab:feelings", "function:ask-simple-questions"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u12-chiamata", title = "Una telefonata", goal = "Telefonare: pronto ?, c'è … ? e il richiamo dopo.", intro = LessonIntro(explanation = listOf("Al telefono si inizia con « Pronto ? » e ci si presenta: « Pronto, sono Luca. »", "Per chiedere di una persona si usa c'è: « C'è Anna ? » Le risposte: « Sì, un momento » oppure « No, non c'è. »", "Se la persona non c'è, si lascia un messaggio e si richiama: « Posso lasciare un messaggio ? Richiamo dopo. »"), examples = listOf(ExampleLine(text = "Pronto ? Sono Luca.", meaning = "Ci si presenta al telefono."), ExampleLine(text = "C'è Maria, per favore ?", meaning = "Chiedere di una persona."), ExampleLine(text = "No, non c'è.", meaning = "La persona non è presente."), ExampleLine(text = "Un momento, la chiamo.", meaning = "Chiamare la persona."), ExampleLine(text = "Richiamo dopo, grazie.", meaning = "Chiamare più tardi."))), expressions = listOf(TargetExpression(text = "Pronto ?", meaning = "La prima parola al telefono.", note = "Pronto, sono Carlo."), TargetExpression(text = "C'è … ?", meaning = "Chiedere di una persona.", note = "C'è Maria, per favore ?"), TargetExpression(text = "Non c'è.", meaning = "La persona non c'è.", note = "È uscita."), TargetExpression(text = "Richiamo dopo.", meaning = "Chiamo più tardi.", note = "Richiamo tra dieci minuti."), TargetExpression(text = "Posso lasciare un messaggio ?", meaning = "Chiedere di lasciare un messaggio.", note = "Sì, certo.")), situation = "Telefoni a Giulia ma non c'è: sua madre risponde e tu lasci un messaggio e richiami dopo.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Rispondi al telefono.", expected = listOf("Pronto ?", "Pronto, chi è ?", "Pronto, chi e ?"), focus = "pronto", watch = "Pronto: la prima parola."), PracticeQuestion(prompt = "Anna è a casa ? Chiedi al telefono.", expected = listOf("C'è Anna ?", "C'e Anna ?", "Pronto, c'e Anna ?"), focus = "c'è", watch = "C'è + nome della persona."), PracticeQuestion(prompt = "Anna non è a casa. Dillo.", expected = listOf("Non c'è.", "Non c'e.", "Anna non c'e."), focus = "non c'è", watch = "Non c'è = persona assente."), PracticeQuestion(prompt = "Dì che chiami più tardi.", expected = listOf("Richiamo dopo.", "Richiamo più tardi.", "Richiamo piu tardi."), focus = "richiamo", watch = "Richiamare = chiamare di nuovo."), PracticeQuestion(prompt = "Chiedi di lasciare un messaggio.", expected = listOf("Posso lasciare un messaggio ?", "Le lascio un messaggio.", "Un messaggio per Giulia."), focus = "messaggio", watch = "Lasciare un messaggio."))), exercises = listOf(Exercise(id = "it-foundations-u12-chiamata-e1", kind = "choice", prompt = "Il telefono suona. Cosa dici per primo ?", options = listOf("Pronto", "Grazie", "Piacere", "Scusa"), answers = listOf("Pronto"), explain = "Pronto è la prima parola al telefono."), Exercise(id = "it-foundations-u12-chiamata-e2", kind = "gap", prompt = "C'___ Anna, per favore ?", options = listOf(), answers = listOf("è", "e"), explain = "C'è = ci + è: si scrive con l'accento."), Exercise(id = "it-foundations-u12-chiamata-e3", kind = "order", prompt = "Anna non c'è. Dì che richiami dopo.", options = listOf(), answers = listOf("La richiamo dopo, grazie"), explain = "Richiamare = chiamare di nuovo più tardi."), Exercise(id = "it-foundations-u12-chiamata-e4", kind = "written", prompt = "Lascia un messaggio per Maria: tu sei Luca e richiami.", options = listOf(), answers = listOf("Sono Luca, richiamo dopo.", "Sono Luca, richiamo dopo, grazie.", "Sono Luca e richiamo dopo."), explain = "Sono + nome + richiamo dopo.")), skills = listOf("vocab:social-expressions", "grammar:present-questions", "function:ask-simple-questions", "grammar:present-simple"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:present-simple"))))
}

object ItFoundationsU13 {
    val unit = CourseUnit(id = "it-foundations-u13", title = "Il tempo", subtitle = "Giorni e meteo", level = "A1", themes = listOf(ConversationTheme("il-tempo-settimana", "La settimana", "Sempre, spesso, mai", "sun.max", "Course", "Una giornata tipo: il caffè sempre la mattina, il lavoro, e la sera — qualche volta un film, mai sport.", 0),
                ConversationTheme("il-tempo-meteo", "Il meteo", "Che tempo fa ?", "cloud.rain", "Course", "Sabato piove, ma domenica c'è il sole: si decide il weekend guardando il cielo.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u13-routine", title = "Dal mattino alla sera", goal = "Raccontare la giornata con sempre, spesso, qualche volta, mai.", intro = LessonIntro(explanation = listOf("La routine si racconta al presente: « La mattina faccio colazione alle sette e vado al lavoro. »", "Gli avverbi di frequenza dicono quante volte: « Bevo sempre un caffè » (ogni giorno), « Spesso torno tardi » (molte volte), « Qualche volta leggo » (a volte), « Non lavoro mai la domenica » (zero volte).", "Posizione: con essere l'avverbio sta dopo, con gli altri verbi prima: « Sono sempre in ufficio alle nove. Esco sempre alle sei. »"), examples = listOf(ExampleLine(text = "La mattina faccio colazione alle sette.", meaning = "La routine al presente."), ExampleLine(text = "Bevo sempre un caffè al bar.", meaning = "Sempre: ogni giorno."), ExampleLine(text = "Spesso torno a casa tardi.", meaning = "Spesso: molte volte."), ExampleLine(text = "Qualche volta leggo la sera.", meaning = "Qualche volta: a volte."), ExampleLine(text = "La domenica non lavoro mai.", meaning = "Mai: zero volte."))), expressions = listOf(TargetExpression(text = "sempre", meaning = "Ogni volta, il 100%.", note = "Bevo sempre un caffè."), TargetExpression(text = "spesso", meaning = "Molte volte.", note = "Spesso vado in bici."), TargetExpression(text = "qualche volta", meaning = "A volte.", note = "Qualche volta guardo la TV."), TargetExpression(text = "(non) … mai", meaning = "Zero volte.", note = "Non mangio mai la carne."), TargetExpression(text = "di mattina / di sera", meaning = "Le parti della giornata.", note = "Di sera ceno alle otto.")), situation = "Una giornata tipo: sempre il caffè alle sette, spesso in bici, e la sera qualche volta un film, mai sport.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di' la tua routine della mattina: sveglia alle sette.", expected = listOf("Mi sveglio alle sette.", "Mi alzo alle sette.", "Faccio colazione alle sette."), focus = "routine", watch = "Presente + ora: alle sette."), PracticeQuestion(prompt = "Bevi un caffè ogni giorno. Rispondi con sempre.", expected = listOf("Sì, bevo sempre un caffè.", "Si, bevo sempre un caffe.", "Bevo sempre un caffe."), focus = "sempre", watch = "Sempre = ogni giorno."), PracticeQuestion(prompt = "Non mangi la carne. Di' la frase con mai.", expected = listOf("Non mangio mai la carne.", "Mai la carne.", "La carne non la mangio mai."), focus = "non … mai", watch = "Non … mai insieme."), PracticeQuestion(prompt = "A volte vai al cinema. Di' con qualche volta.", expected = listOf("Qualche volta vado al cinema.", "Qualche volta vado al cinema con amici."), focus = "qualche volta", watch = "Qualche volta = a volte."), PracticeQuestion(prompt = "La domenica ? Zero lavoro. Di' con mai.", expected = listOf("La domenica non lavoro mai.", "Domenica non lavoro mai.", "La domenica non studio mai."), focus = "la domenica", watch = "La domenica + non … mai."))), exercises = listOf(Exercise(id = "it-foundations-u13-routine-e1", kind = "choice", prompt = "Bevo ___ un caffè la mattina: ogni giorno !", options = listOf("sempre", "mai", "spesso", "qualche volta"), answers = listOf("sempre"), explain = "Ogni giorno = sempre, il 100% delle volte."), Exercise(id = "it-foundations-u13-routine-e2", kind = "gap", prompt = "La domenica non lavoro ___.", options = listOf(), answers = listOf("mai"), explain = "Non … mai = zero volte."), Exercise(id = "it-foundations-u13-routine-e3", kind = "order", prompt = "Racconta cosa fai spesso la sera.", options = listOf(), answers = listOf("Spesso guardo la televisione la sera"), explain = "Avverbio + verbo + complemento."), Exercise(id = "it-foundations-u13-routine-e4", kind = "written", prompt = "Di' la tua giornata: sveglia alle sette e colazione.", options = listOf(), answers = listOf("Mi sveglio alle sette e faccio colazione.", "Mi alzo alle sette e faccio colazione.", "Faccio colazione alle sette."), explain = "Presente + ore per la routine.")), skills = listOf("grammar:frequency-adverbs", "function:talk-about-routines", "vocab:daily-routine", "grammar:present-simple"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u13-meteo", title = "Che tempo fa ?", goal = "Parlare del tempo e delle stagioni: fa caldo, piove, in estate.", intro = LessonIntro(explanation = listOf("Per chiedere: « Che tempo fa ? » Per rispondere si usa fa + aggettivo: « Fa caldo. Fa freddo. Fa bel tempo. »", "Pioggia e neve hanno verbi propri: « Piove, prendi l'ombrello. In inverno nevica. » Con il sole si dice « c'è il sole ».", "Le stagioni: la primavera, l'estate, l'autunno, l'inverno. Con in: « In estate fa caldo. In inverno fa freddo. »"), examples = listOf(ExampleLine(text = "Oggi fa bel tempo.", meaning = "Una bella giornata."), ExampleLine(text = "Fa freddo oggi !", meaning = "Temperatura bassa."), ExampleLine(text = "Piove, prendi l'ombrello.", meaning = "Il verbo piovere."), ExampleLine(text = "In estate fa caldo.", meaning = "La stagione con in."), ExampleLine(text = "In inverno nevica in montagna.", meaning = "Il verbo nevicare."))), expressions = listOf(TargetExpression(text = "Che tempo fa ?", meaning = "La domanda sul meteo.", note = "Fa bello !"), TargetExpression(text = "fa caldo / fa freddo", meaning = "La temperatura.", note = "Oggi fa molto caldo."), TargetExpression(text = "piove / nevica", meaning = "La pioggia e la neve.", note = "Piove da stamattina."), TargetExpression(text = "c'è il sole", meaning = "Una giornata soleggiata.", note = "C'è il sole, usciamo ?"), TargetExpression(text = "in estate / in inverno", meaning = "Le stagioni.", note = "In inverno nevica in montagna.")), situation = "Sabato piove e fa freddo: ombrello e un film a casa. Domenica c'è il sole — si esce !", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedi del tempo a un amico.", expected = listOf("Che tempo fa ?", "Che tempo fa oggi ?"), focus = "che tempo fa", watch = "Fa + tempo."), PracticeQuestion(prompt = "Gennaio, zero gradi. Di' il tempo.", expected = listOf("Fa freddo.", "Fa molto freddo."), focus = "fa freddo", watch = "Fa + freddo."), PracticeQuestion(prompt = "Prendi l'ombrello. Perché ? Di' il tempo.", expected = listOf("Piove.", "Piove molto.", "Piove, per questo."), focus = "piove", watch = "Piove = cade la pioggia."), PracticeQuestion(prompt = "Agosto al mare: trenta gradi. Di' il tempo.", expected = listOf("Fa caldo.", "Fa molto caldo.", "Fa caldo al mare."), focus = "fa caldo", watch = "Fa + caldo."), PracticeQuestion(prompt = "In quale stagione nevica ? Rispondi.", expected = listOf("Nevica in inverno.", "In inverno nevica.", "Nevica d'inverno."), focus = "in inverno", watch = "Le stagioni con in."))), exercises = listOf(Exercise(id = "it-foundations-u13-meteo-e1", kind = "choice", prompt = "Che ___ fa oggi ?", options = listOf("tempo", "caldo", "vento", "freddo"), answers = listOf("tempo"), explain = "Che tempo fa ? è la domanda sul meteo."), Exercise(id = "it-foundations-u13-meteo-e2", kind = "gap", prompt = "Prendi l'ombrello: oggi ___.", options = listOf(), answers = listOf("piove"), explain = "Piove = cade la pioggia."), Exercise(id = "it-foundations-u13-meteo-e3", kind = "order", prompt = "Dì il tempo di agosto.", options = listOf(), answers = listOf("In estate fa molto caldo"), explain = "In estate + fa + caldo."), Exercise(id = "it-foundations-u13-meteo-e4", kind = "written", prompt = "Di' il tempo di oggi: fa freddo e cade la neve.", options = listOf(), answers = listOf("Fa freddo e nevica.", "Oggi fa freddo e nevica.", "Fa freddo e nevica oggi."), explain = "Fa freddo + nevica: due frasi del meteo.")), skills = listOf("function:talk-about-weather", "vocab:weather", "grammar:present-simple", "function:ask-simple-questions"), canDo = listOf("talk-about-weather"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u13-gusti", title = "Cosa mi piace", goal = "Dire cosa ti piace: mi piace + infinito o sostantivo.", intro = LessonIntro(explanation = listOf("Per le attività si usa mi piace + infinito: « Mi piace leggere. Mi piace cucinare. »", "Con un sostantivo singolare: « Mi piace il caffè. » Con un sostantivo plurale si usa mi piacciono: « Mi piacciono i film. »", "La negazione è non mi piace: « Non mi piace il freddo. » Per rafforzare: « Mi piace molto nuotare. »"), examples = listOf(ExampleLine(text = "Mi piace leggere la sera.", meaning = "Piace + infinito."), ExampleLine(text = "Mi piace il gelato.", meaning = "Piace + singolare."), ExampleLine(text = "Mi piacciono i film italiani.", meaning = "Plurale: mi piacciono."), ExampleLine(text = "Non mi piace il freddo.", meaning = "La negazione."), ExampleLine(text = "Mi piace molto nuotare.", meaning = "Molto rafforza il gusto."))), expressions = listOf(TargetExpression(text = "mi piace + infinito", meaning = "Le attività.", note = "Mi piace camminare."), TargetExpression(text = "mi piace + singolare", meaning = "Una cosa.", note = "Mi piace la musica."), TargetExpression(text = "mi piacciono + plurale", meaning = "Più cose.", note = "Mi piacciono i libri."), TargetExpression(text = "non mi piace …", meaning = "La cosa che non ti piace.", note = "Non mi piace il freddo."), TargetExpression(text = "anche a me", meaning = "Essere d'accordo.", note = "Mi piace il cinema. — Anche a me !")), situation = "Il weekend si avvicina: ti piace leggere e cucinare, ma il freddo no — e con gli amici sei d'accordo.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di' che ti piace leggere.", expected = listOf("Mi piace leggere.", "Mi piace leggere la sera."), focus = "mi piace", watch = "Mi piace + infinito."), PracticeQuestion(prompt = "Di' che ti piace la pizza.", expected = listOf("Mi piace la pizza.", "A me piace la pizza."), focus = "mi piace", watch = "Mi piace + singolare."), PracticeQuestion(prompt = "Ti piacciono i film. Di' con piacciono.", expected = listOf("Mi piacciono i film.", "Mi piacciono i film italiani."), focus = "mi piacciono", watch = "Plurale: mi piacciono."), PracticeQuestion(prompt = "Non ti piace il freddo. Di' la negazione.", expected = listOf("Non mi piace il freddo.", "Non mi piace il freddo d'inverno."), focus = "non mi piace", watch = "Non + mi piace."), PracticeQuestion(prompt = "Il tuo amico dice: mi piace il cinema. Concorda.", expected = listOf("Anche a me !", "Anche a me piace il cinema."), focus = "anche a me", watch = "Anche a me = sono d'accordo."))), exercises = listOf(Exercise(id = "it-foundations-u13-gusti-e1", kind = "choice", prompt = "Mi ___ il caffè, tanto !", options = listOf("piace", "piacciono", "piaccio", "piacere"), answers = listOf("piace"), explain = "Il caffè è singolare: mi piace."), Exercise(id = "it-foundations-u13-gusti-e2", kind = "gap", prompt = "Mi ___ i gatti e i cani.", options = listOf(), answers = listOf("piacciono"), explain = "Plurale: mi piacciono i gatti."), Exercise(id = "it-foundations-u13-gusti-e3", kind = "order", prompt = "Di' che ti piace fare una cosa la sera.", options = listOf(), answers = listOf("Mi piace leggere la sera"), explain = "Mi piace + infinito + tempo."), Exercise(id = "it-foundations-u13-gusti-e4", kind = "written", prompt = "Di' due cose che ti piace fare nel weekend.", options = listOf(), answers = listOf("Mi piace leggere e cucinare.", "Mi piace nuotare e camminare.", "Mi piace guardare i film e camminare."), explain = "Mi piace + due infiniti.")), skills = listOf("vocab:hobbies", "grammar:present-simple", "function:talk-about-routines", "vocab:social-expressions"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple"))))
}

object ItFoundationsU14 {
    val unit = CourseUnit(id = "it-foundations-u14", title = "In movimento", subtitle = "Metro, bus e treno", level = "A1", themes = listOf(ConversationTheme("in-movimento-trasporti", "I trasporti", "Prendo la metro", "bus", "Course", "In città: la metro, il bus e i piedi — scegli il mezzo e vai.", 0),
                ConversationTheme("in-movimento-orari", "Gli orari", "Alle otto e mezza", "tram", "Course", "Alla stazione: il treno parte alle nove e mezza — chiedi l'orario e guarda il tabellone.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u14-trasporti", title = "Come vado", goal = "Dire come ti sposti in città: prendo la metro, vado in bus, vado a piedi.", intro = LessonIntro(explanation = listOf("Per i trasporti si usa prendere: « Prendo la metro. Prendo il bus. Prendo il treno. » Prendere = viaggiare con quel mezzo.", "Con i mezzi si usa in: « Vado al lavoro in metro. Vado in centro in bus. » Con la bicicletta si dice in bici.", "A piedi è senza mezzo: « L'ufficio è vicino: vado a piedi. » Per chiedere: « Come vai al lavoro ? »"), examples = listOf(ExampleLine(text = "Prendo la metro ogni mattina.", meaning = "Prendere + mezzo."), ExampleLine(text = "Vado al lavoro in bus.", meaning = "in + mezzo."), ExampleLine(text = "Il centro è vicino: vado a piedi.", meaning = "A piedi = cammino."), ExampleLine(text = "Come vai in ufficio ?", meaning = "Domanda con come."), ExampleLine(text = "Luisa va a scuola in bici.", meaning = "In bici = in bicicletta."))), expressions = listOf(TargetExpression(text = "prendo la metro", meaning = "Uso la metro.", note = "Anche: prendo il bus, prendo il treno."), TargetExpression(text = "vado a piedi", meaning = "Cammino.", note = "Senza mezzo: il posto è vicino."), TargetExpression(text = "in metro / in bus / in treno", meaning = "Con i mezzi si usa in.", note = "Vado in centro in metro."), TargetExpression(text = "Come vai a … ?", meaning = "Chiedere il mezzo.", note = "Come vai al lavoro ?"), TargetExpression(text = "in bici", meaning = "Con la bicicletta.", note = "Bici = bicicletta, parola corta.")), situation = "Un giorno tipo in città: la metro al mattino, il bus quando piove e a piedi quando il centro è vicino.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Prendi la metro ogni giorno. Dillo.", expected = listOf("Prendo la metro ogni giorno.", "La mattina prendo la metro."), focus = "prendo", watch = "Io prendo, tu prendi."), PracticeQuestion(prompt = "L'ufficio è vicino. Dì che vai camminando.", expected = listOf("Vado a piedi.", "Vado all'ufficio a piedi."), focus = "a piedi", watch = "A piedi = senza mezzo."), PracticeQuestion(prompt = "Chiedi a Paolo come va al lavoro.", expected = listOf("Come vai al lavoro ?", "Paolo, come vai al lavoro ?"), focus = "come vai", watch = "Domanda con come + tu vai."), PracticeQuestion(prompt = "Dì che vai in centro con il bus.", expected = listOf("Vado in centro in bus.", "Prendo il bus per il centro."), focus = "in bus", watch = "Con i mezzi si usa in: in bus."), PracticeQuestion(prompt = "La scuola è lontana. Dì che prendi il treno.", expected = listOf("Prendo il treno.", "Vado a scuola in treno."), focus = "il treno", watch = "Treno: per le distanze lunghe."), PracticeQuestion(prompt = "Il mercato è vicino. Dì che ci vai in bici.", expected = listOf("Vado in bici.", "Vado al mercato in bici."), focus = "in bici", watch = "In bici = in bicicletta."))), exercises = listOf(Exercise(id = "it-foundations-u14-trasporti-e1", kind = "choice", prompt = "Il lavoro è lontano: ___ il bus.", options = listOf("prendo", "vado", "sono", "faccio"), answers = listOf("prendo"), explain = "Con i mezzi si usa prendere: prendo il bus."), Exercise(id = "it-foundations-u14-trasporti-e2", kind = "gap", prompt = "Il centro è vicino: vado ___.", options = listOf(), answers = listOf("a piedi"), explain = "A piedi = cammino, senza mezzo."), Exercise(id = "it-foundations-u14-trasporti-e3", kind = "order", prompt = "Dì che ogni mattina usi la metro.", options = listOf(), answers = listOf("Prendo la metro ogni mattina"), explain = "Prendere + mezzo + tempo."), Exercise(id = "it-foundations-u14-trasporti-e4", kind = "written", prompt = "Come vai al lavoro ? Rispondi: usi la metro.", options = listOf(), answers = listOf("Vado al lavoro in metro.", "Vado al lavoro con la metro.", "Prendo la metro."), explain = "in + mezzo: vado al lavoro in metro.")), skills = listOf("vocab:transport", "grammar:present-simple", "function:ask-simple-questions", "vocab:town"), canDo = listOf("use-transport"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u14-orari", title = "A che ora parte ?", goal = "Chiedere e dire l'ora e gli orari: sono le otto, il treno parte alle nove.", intro = LessonIntro(explanation = listOf("Per chiedere l'ora: « Che ora è ? » La risposta va con essere: « È l'una. Sono le due. »", "Per gli orari dei mezzi si usa alle: « Il treno parte alle nove. La metro parte alle otto e mezza. »", "L'una è speciale: è l'una, alle una. Dalle due in poi è plurale: sono le due, alle due."), examples = listOf(ExampleLine(text = "Che ora è ?", meaning = "Chiedere l'ora."), ExampleLine(text = "È l'una.", meaning = "Una: singolare."), ExampleLine(text = "Sono le tre e mezza.", meaning = "Mezza = trenta minuti."), ExampleLine(text = "Il treno parte alle nove.", meaning = "alle + ora."), ExampleLine(text = "La metro parte alle otto e un quarto.", meaning = "Un quarto = quindici minuti."))), expressions = listOf(TargetExpression(text = "Che ora è ?", meaning = "Chiedere l'ora.", note = "Risposta: sono le otto."), TargetExpression(text = "È l'una.", meaning = "Una soltanto: l'una.", note = "Alle una, non alle uno."), TargetExpression(text = "Sono le due / le tre …", meaning = "Dalle due in poi: plurale.", note = "Sono le cinque."), TargetExpression(text = "alle … e mezza", meaning = "Trenta minuti dopo l'ora.", note = "Alle nove e mezza."), TargetExpression(text = "parte alle …", meaning = "L'orario del mezzo.", note = "Il bus parte alle dieci.")), situation = "Alla stazione con Luca: che ora è ?, il treno parte alle nove e mezza — si legge il tabellone.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedi l'ora a Luca.", expected = listOf("Che ora è ?", "Che ora e ?", "Luca, che ora e ?"), focus = "che ora", watch = "È con l'accento: che ora è ?"), PracticeQuestion(prompt = "L'orologio segna le 13:00. Dì l'ora.", expected = listOf("È l'una.", "E l'una.", "E l'una in punto."), focus = "l'una", watch = "Una è singolare: l'una."), PracticeQuestion(prompt = "L'orologio segna le 15:00. Dì l'ora.", expected = listOf("Sono le tre.", "E le tre.", "Sono le tre in punto."), focus = "le tre", watch = "Tre è plurale: sono le tre."), PracticeQuestion(prompt = "Il treno parte alle 9:30. Dì l'orario completo.", expected = listOf("Il treno parte alle nove e mezza.", "Il treno parte alle nove e trenta."), focus = "nove e mezza", watch = "Mezza = trenta minuti."), PracticeQuestion(prompt = "Vuoi sapere l'orario della metro. Chiedi.", expected = listOf("A che ora parte la metro ?", "A che ora parte la metro"), focus = "a che ora", watch = "A che ora + verbo: parte."), PracticeQuestion(prompt = "Il bus parte alle 8:15. Dillo.", expected = listOf("Il bus parte alle otto e un quarto.", "Il bus parte alle otto e quindici."), focus = "un quarto", watch = "Un quarto = quindici minuti."))), exercises = listOf(Exercise(id = "it-foundations-u14-orari-e1", kind = "choice", prompt = "Una sola ora: ___ l'una.", options = listOf("È", "E", "Sono", "Hanno"), answers = listOf("È"), explain = "L'una è singolare: è l'una, con è."), Exercise(id = "it-foundations-u14-orari-e2", kind = "gap", prompt = "Il treno parte ___ nove.", options = listOf(), answers = listOf("alle"), explain = "Con l'orario si usa alle: alle nove."), Exercise(id = "it-foundations-u14-orari-e3", kind = "order", prompt = "Chiedi l'orario della metro.", options = listOf(), answers = listOf("A che ora parte la metro"), explain = "A che ora + parte + soggetto."), Exercise(id = "it-foundations-u14-orari-e4", kind = "written", prompt = "Sono le 4:30. Dì l'ora.", options = listOf(), answers = listOf("Sono le quattro e mezza.", "Sono le quattro e trenta.", "Le quattro e mezza."), explain = "Mezza = trenta minuti dopo l'ora.")), skills = listOf("function:tell-time", "vocab:transport", "grammar:present-questions", "grammar:present-simple"), canDo = listOf("tell-time"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u14-biglietto", title = "Un biglietto, per favore", goal = "Comprare i biglietti: uno o due, quanto costa, pagare con la carta.", intro = LessonIntro(explanation = listOf("Al chiosco la richiesta è con per favore: « Un biglietto, per favore. Due biglietti per Milano, per favore. »", "Per il prezzo: « Quanto costa ? » — « Costa due euro e cinquanta. » Con due biglietti: « Costano cinque euro. »", "Le quantità: un biglietto, due biglietti, tre biglietti. Euro non cambia: un euro, due euro."), examples = listOf(ExampleLine(text = "Un biglietto, per favore.", meaning = "Chiedere un biglietto."), ExampleLine(text = "Due biglietti per Roma, per favore.", meaning = "Numero + biglietti + per."), ExampleLine(text = "Quanto costa ?", meaning = "Chiedere il prezzo."), ExampleLine(text = "Costa due euro e cinquanta.", meaning = "Il prezzo in euro."), ExampleLine(text = "Posso pagare con la carta ?", meaning = "Chiedere il pagamento."))), expressions = listOf(TargetExpression(text = "un biglietto, per favore", meaning = "La richiesta al chiosco.", note = "Con il numero: due biglietti."), TargetExpression(text = "per + città", meaning = "La destinazione.", note = "Un biglietto per Napoli."), TargetExpression(text = "Quanto costa ?", meaning = "Chiedere il prezzo.", note = "Costa tre euro."), TargetExpression(text = "due euro e cinquanta", meaning = "Il prezzo con i centesimi.", note = "Cinquanta = 50 centesimi."), TargetExpression(text = "Posso pagare con la carta ?", meaning = "Pagare con la carta.", note = "Oppure: in contanti.")), situation = "Al chiosco della stazione: due biglietti per Roma, due euro e cinquanta — e si paga con la carta.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sei al chiosco. Chiedi un biglietto, gentile.", expected = listOf("Un biglietto, per favore.", "Un biglietto per favore."), focus = "per favore", watch = "Per favore rende gentile la richiesta."), PracticeQuestion(prompt = "Sei al chiosco, vuoi andare nella capitale. Chiedi due biglietti, gentile.", expected = listOf("Due biglietti per Roma, per favore.", "Due biglietti per Roma."), focus = "due biglietti", watch = "Plurale: due biglietti."), PracticeQuestion(prompt = "Non vedi il prezzo. Chiedilo.", expected = listOf("Quanto costa ?", "Quanto costa il biglietto ?"), focus = "quanto costa", watch = "Biglietto singolare: costa."), PracticeQuestion(prompt = "Il biglietto costa 2,50 €. Dì il prezzo.", expected = listOf("Costa due euro e cinquanta.", "Due euro e cinquanta.", "Costa due euro e cinquanta centesimi."), focus = "due euro", watch = "Euro non cambia: due euro."), PracticeQuestion(prompt = "Chiedi se puoi pagare con la carta.", expected = listOf("Posso pagare con la carta ?", "Posso pagare con la carta"), focus = "posso", watch = "Posso + infinito: posso pagare."))), exercises = listOf(Exercise(id = "it-foundations-u14-biglietto-e1", kind = "choice", prompt = "Per chiedere gentile si aggiunge: « Un biglietto, ___ ».", options = listOf("per favore", "grazie mille", "buongiorno", "scusa"), answers = listOf("per favore"), explain = "Per favore rende gentile la richiesta."), Exercise(id = "it-foundations-u14-biglietto-e2", kind = "gap", prompt = "Quanto ___ il biglietto ? — Tre euro.", options = listOf(), answers = listOf("costa"), explain = "Prezzo singolare: costa."), Exercise(id = "it-foundations-u14-biglietto-e3", kind = "order", prompt = "Al chiosco, chiedi gentilmente un biglietto per Napoli.", options = listOf(), answers = listOf("Un biglietto per Napoli, per favore"), explain = "Un biglietto + per + città + per favore."), Exercise(id = "it-foundations-u14-biglietto-e4", kind = "written", prompt = "Il biglietto costa 3,50 €. Dì il prezzo.", options = listOf(), answers = listOf("Costa tre euro e cinquanta.", "Tre euro e cinquanta.", "Costa tre euro e cinquanta centesimi."), explain = "Euro + e + centesimi: tre euro e cinquanta.")), skills = listOf("function:go-shopping", "function:make-requests", "vocab:transport", "grammar:quantities"), canDo = listOf("use-transport"), prerequisites = listOf("grammar:present-simple"))))
}

object ItFoundationsU15 {
    val unit = CourseUnit(id = "it-foundations-u15", title = "Mi sento bene", subtitle = "Salute di base", level = "A1", themes = listOf(ConversationTheme("mi-sento-bene-salute", "La salute", "Mi fa male la testa", "cross.case", "Course", "Un raffreddore: la febbre, la testa che fa male — e racconti come ti senti.", 0),
                ConversationTheme("mi-sento-bene-abitudini", "Le abitudini", "Sempre o mai ?", "pills", "Course", "La settimana sana: colazione sempre la mattina, molta acqua, otto ore di sonno.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u15-sintomi", title = "Non mi sento bene", goal = "Dire come stai: ho la febbre, mi fa male la testa.", intro = LessonIntro(explanation = listOf("I sintomi vanno con avere: « Ho la febbre. Ho la tosse. Ho mal di testa. »", "Il dolore si dice con mi fa male: « Mi fa male la testa. Mi fa male la gola. » Al plurale: « Mi fanno male i piedi. »", "Per lo stato generale: « Non mi sento bene. Sono malato / malata. » Per chiedere: « Come ti senti ? »"), examples = listOf(ExampleLine(text = "Non mi sento bene.", meaning = "Lo stato generale."), ExampleLine(text = "Ho la febbre.", meaning = "Avere + sintomo."), ExampleLine(text = "Mi fa male la testa.", meaning = "Il dolore alla testa."), ExampleLine(text = "Ho mal di gola.", meaning = "mal di + parte del corpo."), ExampleLine(text = "Sono malata oggi.", meaning = "Malata: donna. Malato: uomo."))), expressions = listOf(TargetExpression(text = "Non mi sento bene.", meaning = "Dire che stai male.", note = "Oppure: sto male."), TargetExpression(text = "ho la febbre", meaning = "Calore nel corpo, 38-39.", note = "Ho la febbre alta."), TargetExpression(text = "mi fa male …", meaning = "Il dolore.", note = "Mi fa male la testa."), TargetExpression(text = "mal di testa / di gola / di pancia", meaning = "Le parti che fanno male.", note = "Mal di testa: la testa fa male."), TargetExpression(text = "Come ti senti ?", meaning = "Chiedere lo stato.", note = "Non mi sento bene.")), situation = "Martedì mattina, a casa: la febbre, la testa che fa male — e racconti come ti senti.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "La temperatura è 38,5. Dì cosa hai.", expected = listOf("Ho la febbre.", "Ho febbre.", "Ho la febbre alta."), focus = "ho la febbre", watch = "Avere + la febbre."), PracticeQuestion(prompt = "La testa fa male. Dillo.", expected = listOf("Mi fa male la testa.", "La testa mi fa male."), focus = "mi fa male", watch = "Mi fa male + parte del corpo."), PracticeQuestion(prompt = "Vuoi sapere come sta Anna. Chiedi.", expected = listOf("Come ti senti ?", "Come stai ?", "Anna, come ti senti ?"), focus = "come ti senti", watch = "Domanda con tu: ti senti."), PracticeQuestion(prompt = "La gola fa male. Dillo in due modi.", expected = listOf("Ho mal di gola.", "Mi fa male la gola."), focus = "mal di gola", watch = "Mal di + parte del corpo."), PracticeQuestion(prompt = "Oggi stai male. Dillo.", expected = listOf("Oggi non mi sento bene.", "Non mi sento bene oggi.", "Oggi sono malata."), focus = "non mi sento bene", watch = "Io sento: non mi sento bene."))), exercises = listOf(Exercise(id = "it-foundations-u15-sintomi-e1", kind = "choice", prompt = "Temperatura 39 °C: ho la ___.", options = listOf("febbre", "fame", "sete", "sonno"), answers = listOf("febbre"), explain = "Temperatura alta: ho la febbre."), Exercise(id = "it-foundations-u15-sintomi-e2", kind = "gap", prompt = "Mi ___ male la testa.", options = listOf(), answers = listOf("fa"), explain = "Mi fa male + parte del corpo: fa male."), Exercise(id = "it-foundations-u15-sintomi-e3", kind = "order", prompt = "Dì che hai mal di gola.", options = listOf(), answers = listOf("Ho mal di gola"), explain = "Avere + mal di + parte del corpo."), Exercise(id = "it-foundations-u15-sintomi-e4", kind = "written", prompt = "Hai 38 di febbre e la testa che fa male. Scrivi come ti senti.", options = listOf(), answers = listOf("Ho la febbre e mi fa male la testa.", "Ho la febbre e ho mal di testa.", "Ho febbre e mal di testa."), explain = "Avere + sintomi: la descrizione del malato.")), skills = listOf("function:talk-about-health", "vocab:health", "grammar:present-simple", "function:ask-simple-questions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u15-farmacia", title = "In farmacia", goal = "In farmacia: chiedere qualcosa per il dolore e capire la dose.", intro = LessonIntro(explanation = listOf("In farmacia si chiede: « Ha qualcosa per la testa ? » Oppure: « Vorrei qualcosa per la febbre. »", "Il farmacista dà la dose: « Due compresse al giorno. Questo sciroppo è per la tosse. »", "Si paga come al negozio: « Quanto costano ? » — « Sette euro. Posso pagare con la carta ? »"), examples = listOf(ExampleLine(text = "Ha qualcosa per la testa ?", meaning = "Chiedere un farmaco."), ExampleLine(text = "Vorrei qualcosa per la tosse.", meaning = "Vorrei = richiesta gentile."), ExampleLine(text = "Due compresse al giorno.", meaning = "La dose."), ExampleLine(text = "Questo sciroppo è per la tosse.", meaning = "Sciroppo: farmaco liquido."), ExampleLine(text = "Quanto costano ?", meaning = "Il prezzo al plurale."))), expressions = listOf(TargetExpression(text = "Ha qualcosa per … ?", meaning = "Chiedere un farmaco.", note = "Ha qualcosa per la febbre ?"), TargetExpression(text = "Vorrei qualcosa per …", meaning = "Richiesta gentile.", note = "Vorrei qualcosa per dormire."), TargetExpression(text = "due compresse al giorno", meaning = "Quante volte al giorno.", note = "Una la mattina, una la sera."), TargetExpression(text = "la compressa / lo sciroppo", meaning = "I tipi di farmaco.", note = "Lo sciroppo per i bambini."), TargetExpression(text = "Quanto costano ?", meaning = "Chiedere il prezzo.", note = "Costano sette euro.")), situation = "In farmacia sotto casa: qualcosa per la febbre, due compresse al giorno e sette euro.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sei in farmacia. Chiedi qualcosa per la testa.", expected = listOf("Ha qualcosa per la testa ?", "Vorrei qualcosa per la testa."), focus = "qualcosa per", watch = "Qualcosa per + dolore."), PracticeQuestion(prompt = "Chiedi qualcosa per la tosse, in modo gentile.", expected = listOf("Vorrei qualcosa per la tosse.", "Vorrei qualcosa contro la tosse."), focus = "vorrei", watch = "Vorrei = voglio, ma gentile."), PracticeQuestion(prompt = "Il farmacista dice: 2 compresse ogni giorno. Ripeti la dose.", expected = listOf("Due compresse al giorno.", "Prendo due compresse al giorno."), focus = "al giorno", watch = "Al giorno = ogni giorno."), PracticeQuestion(prompt = "Chiedi il prezzo delle compresse.", expected = listOf("Quanto costano ?", "Quanto costano le compresse ?"), focus = "quanto costano", watch = "Compresse plurale: costano."), PracticeQuestion(prompt = "Vuoi pagare con la carta. Chiedi.", expected = listOf("Posso pagare con la carta ?", "Posso pagare con la carta"), focus = "posso pagare", watch = "Posso + infinito: posso pagare."))), exercises = listOf(Exercise(id = "it-foundations-u15-farmacia-e1", kind = "choice", prompt = "In farmacia chiedi: « ___ qualcosa per la febbre ? »", options = listOf("Ha", "È", "Fa", "Va"), answers = listOf("Ha"), explain = "Ha qualcosa per … : la domanda al farmacista."), Exercise(id = "it-foundations-u15-farmacia-e2", kind = "gap", prompt = "Prenda due ___ al giorno.", options = listOf(), answers = listOf("compresse"), explain = "La dose: due compresse al giorno."), Exercise(id = "it-foundations-u15-farmacia-e3", kind = "order", prompt = "Chiedi gentilmente qualcosa per la tosse.", options = listOf(), answers = listOf("Vorrei qualcosa per la tosse"), explain = "Vorrei + qualcosa + per + sintomo."), Exercise(id = "it-foundations-u15-farmacia-e4", kind = "written", prompt = "Il farmacista dà lo sciroppo: 2 cucchiai ogni giorno. Scrivi la dose.", options = listOf(), answers = listOf("Due cucchiai al giorno.", "Prendo due cucchiai al giorno.", "Due cucchiai al giorno, la mattina e la sera."), explain = "Numero + dose + al giorno.")), skills = listOf("function:go-shopping", "vocab:health", "function:make-requests", "grammar:present-simple"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u15-abitudini", title = "Vita sana", goal = "Raccontare la vita sana con gli avverbi: sempre, spesso, mai.", intro = LessonIntro(explanation = listOf("Gli avverbi di frequenza: sempre (100 %), spesso, a volte, mai (0 %).", "Sempre e mai stanno col verbo: « Faccio sempre colazione. Non fumo mai. » Mai vuole non: non … mai.", "La vita sana: « Bevo molta acqua. Dormo otto ore. Vado a piedi al lavoro. »"), examples = listOf(ExampleLine(text = "Faccio sempre colazione.", meaning = "Sempre: ogni giorno."), ExampleLine(text = "Non fumo mai.", meaning = "Mai va con non."), ExampleLine(text = "Spesso vado a piedi.", meaning = "Spesso: molte volte."), ExampleLine(text = "Bevo molta acqua.", meaning = "Molta: quantità grande."), ExampleLine(text = "Dormo otto ore la notte.", meaning = "Le ore di sonno."))), expressions = listOf(TargetExpression(text = "sempre", meaning = "Ogni volta, 100 %.", note = "Faccio sempre colazione."), TargetExpression(text = "non … mai", meaning = "Non + verbo + mai: 0 %.", note = "Non mangio mai dolci."), TargetExpression(text = "spesso / a volte", meaning = "Frequenza media.", note = "A volte corro al parco."), TargetExpression(text = "dormire otto ore", meaning = "Le ore di sonno.", note = "Dormo otto ore la notte."), TargetExpression(text = "bere molta acqua", meaning = "Abitudine sana.", note = "Bevo molta acqua al giorno.")), situation = "Colazione sempre alle sette, otto ore di sonno e il bus mai: a piedi — la settimana sana.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Fai colazione ogni giorno. Dillo con sempre.", expected = listOf("Faccio sempre colazione.", "La mattina faccio sempre colazione."), focus = "sempre", watch = "Sempre sta col verbo: faccio sempre."), PracticeQuestion(prompt = "Non mangi dolci. Mai. Dillo.", expected = listOf("Non mangio mai dolci.", "Non mangio mai i dolci."), focus = "non … mai", watch = "Non e mai stanno insieme."), PracticeQuestion(prompt = "Bevi molta acqua ogni giorno. Dillo con sempre.", expected = listOf("Bevo sempre molta acqua.", "Bevo sempre molta acqua al giorno."), focus = "bevo sempre", watch = "Verbo + sempre: bevo sempre."), PracticeQuestion(prompt = "Dormi otto ore la notte. Dillo.", expected = listOf("Dormo otto ore la notte.", "Dormo otto ore.", "Ogni notte dormo otto ore."), focus = "otto ore", watch = "Otto ore: la quantità di sonno."), PracticeQuestion(prompt = "Non fai sport. Mai. Dillo.", expected = listOf("Non faccio mai sport.", "Io non faccio mai sport."), focus = "non faccio mai", watch = "Non + faccio + mai."), PracticeQuestion(prompt = "Spesso vai a piedi al lavoro. Dillo.", expected = listOf("Spesso vado a piedi al lavoro.", "Vado spesso a piedi al lavoro."), focus = "spesso", watch = "Spesso = molte volte."))), exercises = listOf(Exercise(id = "it-foundations-u15-abitudini-e1", kind = "choice", prompt = "Mangio ___ verdura: ogni giorno.", options = listOf("sempre", "mai", "a volte", "domani"), answers = listOf("sempre"), explain = "Ogni giorno = sempre, 100 %."), Exercise(id = "it-foundations-u15-abitudini-e2", kind = "gap", prompt = "Fumo zero volte: non fumo ___.", options = listOf(), answers = listOf("mai"), explain = "Non + verbo + mai: frequenza zero."), Exercise(id = "it-foundations-u15-abitudini-e3", kind = "order", prompt = "Dì che fai colazione la mattina, tutti i giorni: usa sempre.", options = listOf(), answers = listOf("La mattina faccio sempre colazione"), explain = "Tempo + verbo + sempre + oggetto."), Exercise(id = "it-foundations-u15-abitudini-e4", kind = "written", prompt = "Descrivi una tua abitudine sana: usa sempre o mai.", options = listOf(), answers = listOf("Faccio sempre colazione.", "Non fumo mai.", "Bevo sempre molta acqua.", "Non mangio mai dolci."), explain = "Verbo + sempre oppure non + verbo + mai.")), skills = listOf("grammar:frequency-adverbs", "function:talk-about-routines", "vocab:health", "vocab:daily-routine"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:frequency-adverbs"))))
}

object ItFoundationsU16 {
    val unit = CourseUnit(id = "it-foundations-u16", title = "A tavola", subtitle = "Mangiare fuori", level = "A1", themes = listOf(ConversationTheme("al-ristorante", "Al ristorante", "Vorrei…", "fork.knife", "Course", "Siete al ristorante: ordinate antipasto, primo e da bere, con cortesia.", 0),
                ConversationTheme("menu-e-conto", "Il menù e il conto", "Quanto fa ?", "takeout.bag", "Course", "Leggete il menù, chiedete cosa c’è e pagate il conto con gli amici.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u16-ristorante", title = "Al ristorante", goal = "Ordinare al ristorante con vorrei e prendere, con cortesia.", intro = LessonIntro(explanation = listOf("Per ordinare usa vorrei + piatto: « Vorrei le tagliatelle, per favore ». È gentile e non suona come un ordine.", "Altro modo comune: prendere. « Io prendo la pizza ». Il cameriere chiede: « Che cosa prende ? ».", "Vuoi un consiglio ? Chiedi: « Cosa mi consiglia ? ». E la cortesia chiude sempre: « per favore » e « grazie »."), examples = listOf(ExampleLine(text = "Vorrei le tagliatelle, per favore.", meaning = "Ordinare con cortesia."), ExampleLine(text = "Io prendo la pizza.", meaning = "Altro modo di ordinare: prendere."), ExampleLine(text = "Che cosa prende ?", meaning = "Il cameriere chiede."), ExampleLine(text = "Cosa mi consiglia ?", meaning = "Chiedere un consiglio."), ExampleLine(text = "Per me, solo un primo.", meaning = "Ordinare per due: per me / per lui."))), expressions = listOf(TargetExpression(text = "Vorrei …", meaning = "Ordinare con cortesia.", note = "Vorrei un caffè."), TargetExpression(text = "Prendo …", meaning = "Altro modo: prendere.", note = "Prendo il pesce."), TargetExpression(text = "Che cosa prende ?", meaning = "Il cameriere chiede.", note = "Che cosa prende, signora ?"), TargetExpression(text = "Cosa mi consiglia ?", meaning = "Chiedere un consiglio.", note = "Cosa mi consiglia di dolce ?"), TargetExpression(text = "per favore / grazie", meaning = "La cortesia a tavola.", note = "Un caffè, per favore.")), situation = "Sei al ristorante con un’amica: il cameriere arriva, ordinate antipasto, primo e da bere.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ordina con cortesia: le tagliatelle.", expected = listOf("Vorrei le tagliatelle, per favore.", "Vorrei le tagliatelle.", "Io vorrei le tagliatelle."), focus = "vorrei", watch = "vorrei = quisiera."), PracticeQuestion(prompt = "Il cameriere ti chiede: rispondi che prendi la pizza.", expected = listOf("Prendo la pizza.", "Io prendo la pizza."), focus = "prendo", watch = "prendere = tomar."), PracticeQuestion(prompt = "Chiedi un consiglio al cameriere.", expected = listOf("Cosa mi consiglia ?", "Che cosa mi consiglia ?"), focus = "consiglia", watch = "consigliare = recomendar."), PracticeQuestion(prompt = "Dì cosa prende il tuo amico: lui, il pesce.", expected = listOf("Lui prende il pesce.", "Il mio amico prende il pesce."), focus = "lui prende", watch = "terza persona: prende."), PracticeQuestion(prompt = "Ordina da bere: un’acqua naturale.", expected = listOf("Vorrei un’acqua naturale.", "Prendo un’acqua naturale.", "Un’acqua naturale, per favore."), focus = "vorrei + bere", watch = "un’acqua: elisione."), PracticeQuestion(prompt = "Chiedi gentilmente il menù.", expected = listOf("Il menù, per favore.", "Vorrei il menù, per favore."), focus = "per favore", watch = "la cortesia chiude la frase."))), exercises = listOf(Exercise(id = "it-foundations-u16-ristorante-e1", kind = "choice", prompt = "___ le tagliatelle, per favore.", options = listOf("Vorrei", "Voglio", "Vuoi", "Devo"), answers = listOf("Vorrei"), explain = "Ordinare con cortesia: vorrei + piatto."), Exercise(id = "it-foundations-u16-ristorante-e2", kind = "gap", prompt = "Io ___ la pizza margherita. (prendere, io)", options = listOf(), answers = listOf("prendo"), explain = "prendere: io prendo."), Exercise(id = "it-foundations-u16-ristorante-e3", kind = "order", prompt = "Chiedi un consiglio al cameriere.", options = listOf(), answers = listOf("Cosa mi consiglia"), explain = "Cosa + mi + consiglia."), Exercise(id = "it-foundations-u16-ristorante-e4", kind = "written", prompt = "Ordina un caffè con cortesia.", options = listOf(), answers = listOf("vorrei un caffè per favore", "vorrei un caffè", "prendo un caffè per favore"), explain = "vorrei + piatto + per favore.")), skills = listOf("function:order-food", "vocab:food", "grammar:present-simple", "function:ask-simple-questions"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u16-menu", title = "Il menù", goal = "Leggere il menù: piatti, bevande e chiedere cosa c’è.", intro = LessonIntro(explanation = listOf("Nel menù i piatti seguono un ordine: « antipasto », « primo », « secondo », « dolce ». « Come primo prendo le penne ».", "Le bevande: « un’acqua naturale » (senza gas) o « frizzante » (con gas). « Per bere, un’acqua frizzante ».", "Per chiedere cosa hanno: « Cosa c’è come dolce ? ». La risposta: « C’è il tiramisù » o « Ci sono le lasagne »."), examples = listOf(ExampleLine(text = "Cosa c’è come primo ?", meaning = "Chiedere i piatti."), ExampleLine(text = "Ci sono le lasagne.", meaning = "Rispondere al plurale."), ExampleLine(text = "Come secondo, il pesce.", meaning = "Ordinare per portata."), ExampleLine(text = "Per bere, un’acqua frizzante.", meaning = "Ordinare da bere."), ExampleLine(text = "C’è anche il tiramisù.", meaning = "I dolci di oggi."))), expressions = listOf(TargetExpression(text = "l’antipasto / il primo", meaning = "I piatti in ordine.", note = "Come primo, le penne."), TargetExpression(text = "il secondo / il dolce", meaning = "Dopo il primo.", note = "Come secondo, il pesce."), TargetExpression(text = "Cosa c’è … ?", meaning = "Chiedere cosa hanno.", note = "Cosa c’è come dolce ?"), TargetExpression(text = "un’acqua naturale / frizzante", meaning = "Senza o con gas.", note = "Un’acqua naturale, per favore."), TargetExpression(text = "per bere / per mangiare", meaning = "Da bere / da mangiare.", note = "Per bere, il vino.")), situation = "Leggi il menù con Marco: chiedete cosa c’è come primo, come secondo e da bere.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedi al cameriere quali primi ci sono.", expected = listOf("Cosa c’è come primo ?", "Che cosa c’è come primo ?", "Cosa c’e come primo ?"), focus = "cosa c’è", watch = "c’è = hay."), PracticeQuestion(prompt = "Dì cosa c’è come primo: le lasagne.", expected = listOf("Ci sono le lasagne.", "Ci sono lasagne."), focus = "ci sono", watch = "plurale → ci sono."), PracticeQuestion(prompt = "Ordina da bere: acqua con gas.", expected = listOf("Un’acqua frizzante, per favore.", "Vorrei un’acqua frizzante.", "Un’acqua frizzante."), focus = "frizzante", watch = "frizzante = con gas."), PracticeQuestion(prompt = "Dì cosa prendi come secondo: il pesce.", expected = listOf("Come secondo prendo il pesce.", "Prendo il pesce come secondo."), focus = "come secondo", watch = "secondo = plato principal."), PracticeQuestion(prompt = "Chiedi quali dolci sono disponibili.", expected = listOf("Cosa c’è come dolce ?", "Cosa c’e come dolce ?"), focus = "dolce", watch = "dolce = postre."), PracticeQuestion(prompt = "Di’ al tuo amico che oggi, tra i dolci, c’è il tiramisù.", expected = listOf("C’è anche il tiramisù.", "Oggi c’è il tiramisù.", "Ce anche il tiramisu."), focus = "c’è anche", watch = "anche = también."))), exercises = listOf(Exercise(id = "it-foundations-u16-menu-e1", kind = "choice", prompt = "Bevi senza gas: un’acqua ___.", options = listOf("naturale", "frizzante", "gassata", "dolce"), answers = listOf("naturale"), explain = "Acqua naturale = senza gas."), Exercise(id = "it-foundations-u16-menu-e2", kind = "gap", prompt = "Come primo ___ le lasagne. (prendere, noi)", options = listOf(), answers = listOf("prendiamo"), explain = "prendere, noi: prendiamo."), Exercise(id = "it-foundations-u16-menu-e3", kind = "order", prompt = "Chiedi cosa hanno come primo.", options = listOf(), answers = listOf("Cosa c’è come primo"), explain = "Cosa c’è + come + piatto."), Exercise(id = "it-foundations-u16-menu-e4", kind = "written", prompt = "Ordina da bere: un’acqua naturale.", options = listOf(), answers = listOf("un’acqua naturale per favore", "un acqua naturale per favore", "vorrei un’acqua naturale"), explain = "un’acqua + naturale, con per favore.")), skills = listOf("function:order-food", "vocab:food", "grammar:present-questions", "grammar:present-simple"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u16-conto", title = "Il conto", goal = "Chiedere il conto, pagare e lasciare la mancia.", intro = LessonIntro(explanation = listOf("Per pagare chiami il cameriere: « Il conto, per favore ». E chiedi il totale: « Quanto fa ? ».", "Paghi « in contanti » o « con la carta ». Chiedi: « Posso pagare con la carta ? » — « Certo, signore ».", "La mancia in Italia è piccola e facoltativa: « Tenga il resto ». E tra amici: « Oggi offro io ! »."), examples = listOf(ExampleLine(text = "Il conto, per favore.", meaning = "Chiedere di pagare."), ExampleLine(text = "Quanto fa ?", meaning = "Chiedere il totale."), ExampleLine(text = "Posso pagare con la carta ?", meaning = "Chiedere il metodo di pagamento."), ExampleLine(text = "Tenga il resto.", meaning = "Lasciare la mancia."), ExampleLine(text = "Oggi offro io !", meaning = "Pagare per tutti."))), expressions = listOf(TargetExpression(text = "Il conto, per favore.", meaning = "Chiedere di pagare.", note = "Il conto, per favore !"), TargetExpression(text = "Quanto fa ?", meaning = "Qual è il totale ?", note = "Quanto fa in tutto ?"), TargetExpression(text = "in contanti / con la carta", meaning = "Due modi di pagare.", note = "Pago con la carta."), TargetExpression(text = "Tenga il resto.", meaning = "La mancia: il resto è suo.", note = "Tenga il resto, grazie."), TargetExpression(text = "Oggi offro io.", meaning = "Pagare per gli amici.", note = "Oggi offro io, festeggio !")), situation = "Finite la cena con Luca: chiedi il conto, chiedi quanto fa e Luca lascia una piccola mancia.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiama il cameriere per pagare.", expected = listOf("Il conto, per favore.", "Il conto per favore.", "Posso avere il conto ?"), focus = "il conto", watch = "conto = la cuenta."), PracticeQuestion(prompt = "Chiedi quanto è in totale.", expected = listOf("Quanto fa ?", "Quanto fa in tutto ?", "Quanto costa ?"), focus = "quanto fa", watch = "quanto fa = cuánto es."), PracticeQuestion(prompt = "Chiedi se puoi pagare con la carta.", expected = listOf("Posso pagare con la carta ?", "Posso pagare con la carta ?"), focus = "posso", watch = "posso = puedo."), PracticeQuestion(prompt = "Dì che paghi in contanti.", expected = listOf("Pago in contanti.", "Io pago in contanti."), focus = "in contanti", watch = "contanti = efectivo."), PracticeQuestion(prompt = "Lascia la mancia: il resto per il cameriere.", expected = listOf("Tenga il resto.", "Tenga il resto, grazie."), focus = "tenga", watch = "tenga = quédese con ello (formal)."), PracticeQuestion(prompt = "Dì che oggi paghi tu per tutti.", expected = listOf("Oggi offro io !", "Oggi offro io."), focus = "offro", watch = "offrire = invitar a pagar."))), exercises = listOf(Exercise(id = "it-foundations-u16-conto-e1", kind = "choice", prompt = "Chiami il cameriere: « ___, per favore ! »", options = listOf("Il conto", "Il menù", "La mancia", "Il resto"), answers = listOf("Il conto"), explain = "Per pagare si chiede il conto."), Exercise(id = "it-foundations-u16-conto-e2", kind = "gap", prompt = "Quanto ___ in tutto ? (fare, 3ª persona)", options = listOf(), answers = listOf("fa"), explain = "Quanto fa ? chiede il totale."), Exercise(id = "it-foundations-u16-conto-e3", kind = "order", prompt = "Chiedi di pagare con la carta.", options = listOf(), answers = listOf("Posso pagare con la carta"), explain = "Posso + infinito + con la carta."), Exercise(id = "it-foundations-u16-conto-e4", kind = "written", prompt = "Lascia la mancia: il resto è per il cameriere.", options = listOf(), answers = listOf("tenga il resto", "tenga il resto grazie", "tienia il resto"), explain = "Tenga il resto = la mancia.")), skills = listOf("function:order-food", "grammar:quantities", "vocab:food", "vocab:social-expressions"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple"))))
}

object ItFoundationsU19 {
    val unit = CourseUnit(id = "it-foundations-u19", title = "Una visita", subtitle = "Ospiti e cortesia", level = "A1", themes = listOf(ConversationTheme("l-arrivo", "Posso entrare ?", "Per favore…", "door.left.open", "Course", "Un amico arriva: chiedete di entrare, fate sentire l’ospite a casa e offrite qualcosa.", 0),
                ConversationTheme("la-piccola-cortesia", "Una piccola cosa", "Porto…", "gift", "Course", "Portate un piccolo dono a chi vi ospita e offrite caffè e dolci agli ospiti.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u19-visita", title = "Posso entrare ?", goal = "Chiedere il permesso con posso e accogliere un ospite con cortesia.", intro = LessonIntro(explanation = listOf("Per chiedere il permesso usa posso + infinito: « Posso entrare ? ». La risposta gentile: « Certo, entra ! ».", "Accogli l’ospite con frasi brevi: « Togliti la giacca », « Siediti, per favore ». Fanno sentire tutti a casa.", "Poi offri qualcosa: « Vuoi un caffè ? », « Posso portarti qualcosa ? ». E l’ospite ringrazia: « Grazie ! »."), examples = listOf(ExampleLine(text = "Posso entrare ?", meaning = "Chiedere il permesso."), ExampleLine(text = "Certo, entra !", meaning = "Accogliere con calore."), ExampleLine(text = "Togliti la giacca.", meaning = "Far sentire a casa."), ExampleLine(text = "Siediti sul divano.", meaning = "Offrire un posto."), ExampleLine(text = "Posso portarti qualcosa ?", meaning = "Offrire qualcosa."))), expressions = listOf(TargetExpression(text = "Posso… ?", meaning = "Chiedere il permesso.", note = "Posso entrare ?"), TargetExpression(text = "Certo, entra !", meaning = "Accogliere l’ospite.", note = "Certo, entra, dai !"), TargetExpression(text = "Togliti la giacca", meaning = "Far sentire a casa.", note = "Togliti la giacca, fa caldo."), TargetExpression(text = "Siediti", meaning = "Offrire un posto.", note = "Siediti, per favore."), TargetExpression(text = "Fai come a casa tua", meaning = "La formula di benvenuto.", note = "Fai come a casa tua !")), situation = "Un amico suona alla porta: fate entrare, toglietevi la giacca, sedetevi e offrite un caffè.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedi il permesso di entrare.", expected = listOf("Posso entrare ?", "Posso entrare, per favore ?"), focus = "posso", watch = "posso + infinito = pedir permiso."), PracticeQuestion(prompt = "Accogli Luca: dì che può entrare.", expected = listOf("Certo, entra !", "Dai, entra !"), focus = "entra", watch = "l’imperativo tu: entra."), PracticeQuestion(prompt = "Dì all’ospite di togliersi la giacca.", expected = listOf("Togliti la giacca.", "Togliti la giacca, per favore."), focus = "togliti", watch = "togliersi: togliti."), PracticeQuestion(prompt = "Offri un posto: l’ospite può sedersi.", expected = listOf("Siediti, per favore.", "Siediti qui."), focus = "siediti", watch = "sedersi: siediti."), PracticeQuestion(prompt = "Chiedi se puoi aiutare in cucina.", expected = listOf("Posso aiutare in cucina ?", "Posso aiutare ?"), focus = "posso", watch = "posso + infinito."), PracticeQuestion(prompt = "Chiedi a un ospite se vuole un caffè.", expected = listOf("Vuoi un caffè ?", "Posso portarti un caffè ?", "Ti va un caffè ?"), focus = "vuoi", watch = "offrire con vuoi / ti va."))), exercises = listOf(Exercise(id = "it-foundations-u19-visita-e1", kind = "choice", prompt = "___ entrare ? Grazie !", options = listOf("Posso", "Voglio", "Devo", "Faccio"), answers = listOf("Posso"), explain = "Il permesso: posso + infinito."), Exercise(id = "it-foundations-u19-visita-e2", kind = "gap", prompt = "Luca, ___ la giacca e mettila qui. (tu)", options = listOf(), answers = listOf("togli"), explain = "togliersi: tu togli."), Exercise(id = "it-foundations-u19-visita-e3", kind = "order", prompt = "Chiedi a un ospite di sedersi, con gentilezza.", options = listOf(), answers = listOf("Siediti qui per favore"), explain = "Siediti + luogo + per favore."), Exercise(id = "it-foundations-u19-visita-e4", kind = "written", prompt = "Chiedi il permesso di aprire la finestra.", options = listOf(), answers = listOf("posso aprire la finestra", "posso aprire la finestra per favore"), explain = "posso + infinito: la richiesta gentile.")), skills = listOf("grammar:can", "function:make-requests", "vocab:social-expressions", "grammar:present-simple"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u19-piccolo", title = "Porto una piccola cosa", goal = "Offrire qualcosa agli ospiti e portare un piccolo dono a chi vi invita.", intro = LessonIntro(explanation = listOf("Quando vai a cena da qualcuno, porti una piccola cosa: « Porto una bottiglia di vino », « Porto i dolci ». È un’abitudine gentile.", "Per offrire agli ospiti: « Vuoi… ? », « Prendi… ? », « Ti va… ? ». « Prendi un caffè ? » è l’offerta più comune.", "L’ospite risponde: « Volentieri ! » se accetta, « Grazie, ma no » se rifiuta con gentilezza."), examples = listOf(ExampleLine(text = "Porto una bottiglia di vino.", meaning = "Il piccolo dono."), ExampleLine(text = "Cosa porto: i dolci o il vino ?", meaning = "Chiedere cosa portare."), ExampleLine(text = "Prendi un caffè ?", meaning = "Offrire agli ospiti."), ExampleLine(text = "Ti va della torta ?", meaning = "Offrire con gentilezza."), ExampleLine(text = "Volentieri !", meaning = "Accettare con piacere."))), expressions = listOf(TargetExpression(text = "Porto…", meaning = "Portare qualcosa a chi ospita.", note = "Porto una bottiglia di vino."), TargetExpression(text = "Prendi… ?", meaning = "Offrire agli ospiti.", note = "Prendi un caffè ?"), TargetExpression(text = "Ti va… ?", meaning = "Offrire con gentilezza.", note = "Ti va della torta ?"), TargetExpression(text = "Volentieri !", meaning = "Accettare con piacere.", note = "Volentieri, grazie !"), TargetExpression(text = "Grazie, ma no", meaning = "Rifiutare con gentilezza.", note = "Grazie, ma no, grazie.")), situation = "Andate a cena da amici: decidete cosa portare e, a casa loro, offrite caffè e dolci.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dì cosa porti alla cena: una bottiglia di vino.", expected = listOf("Porto una bottiglia di vino.", "Io porto una bottiglia di vino."), focus = "porto", watch = "porto = traigo."), PracticeQuestion(prompt = "Chiedi a Anna cosa può portare.", expected = listOf("Cosa porti ?", "Che cosa porti ?"), focus = "porti", watch = "tu porti."), PracticeQuestion(prompt = "Offri un caffè a un ospite.", expected = listOf("Prendi un caffè ?", "Vuoi un caffè ?"), focus = "prendi", watch = "offrire con prendere."), PracticeQuestion(prompt = "Offri della torta, con gentilezza.", expected = listOf("Ti va della torta ?", "Vuoi della torta ?"), focus = "ti va", watch = "ti va + di."), PracticeQuestion(prompt = "Accetta l’offerta con piacere.", expected = listOf("Volentieri !", "Volentieri, grazie !"), focus = "volentieri", watch = "volentieri = con gusto."), PracticeQuestion(prompt = "Rifiuta il vino, con gentilezza.", expected = listOf("Grazie, ma no, grazie.", "Grazie, ma non bevo."), focus = "grazie, ma no", watch = "il no gentile."))), exercises = listOf(Exercise(id = "it-foundations-u19-piccolo-e1", kind = "choice", prompt = "Alla cena ___ i dolci: è la mia abitudine.", options = listOf("porto", "porti", "porta", "portano"), answers = listOf("porto"), explain = "Io porto: il piccolo dono."), Exercise(id = "it-foundations-u19-piccolo-e2", kind = "gap", prompt = "___ un caffè, Marta ? (offrire, tu)", options = listOf(), answers = listOf("prendi"), explain = "Offrire con prendere: tu prendi."), Exercise(id = "it-foundations-u19-piccolo-e3", kind = "order", prompt = "Offri della torta a un ospite.", options = listOf(), answers = listOf("Ti va della torta"), explain = "Ti va + di + cosa: offrire."), Exercise(id = "it-foundations-u19-piccolo-e4", kind = "written", prompt = "Dì cosa porti alla cena: i dolci.", options = listOf(), answers = listOf("porto i dolci", "io porto i dolci", "porto i dolci per la cena"), explain = "Io + porto + i dolci.")), skills = listOf("function:make-requests", "vocab:food", "vocab:social-expressions", "function:order-food"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u19-addio", title = "Alla prossima", goal = "Salutare alla fine di una visita e ringraziare per la serata.", intro = LessonIntro(explanation = listOf("Alla fine della visita l’ospite ringrazia: « Grazie per la serata ! », « È stato bello ! ». Chi ospita risponde: « Grazie a te ! ».", "L’ospite chiede il permesso di andare: « È tardi, devo andare ». E promette: « Ti chiamo ! ».", "I saluti: « Ciao ! » tra amici, « Arrivederci » con persone che non conosci bene. Per la prossima volta: « Alla prossima ! », « A presto ! »."), examples = listOf(ExampleLine(text = "Grazie per la serata !", meaning = "Ringraziare chi ospita."), ExampleLine(text = "È stato bello, grazie mille.", meaning = "Dire che ti è piaciuto."), ExampleLine(text = "È tardi: devo andare.", meaning = "Prendere congedo."), ExampleLine(text = "Grazie a te, alla prossima !", meaning = "Rispondere e salutare."), ExampleLine(text = "A presto !", meaning = "Salutare per presto."))), expressions = listOf(TargetExpression(text = "Grazie per la serata", meaning = "Ringraziare alla fine.", note = "Grazie per la serata, era bellissima."), TargetExpression(text = "È stato bello", meaning = "Dire che ti è piaciuto.", note = "È stato bello vedervi."), TargetExpression(text = "Devo andare", meaning = "Prendere congedo.", note = "È tardi, devo andare."), TargetExpression(text = "Alla prossima !", meaning = "Saluto per la volta dopo.", note = "Ciao, alla prossima !"), TargetExpression(text = "Grazie a te", meaning = "Rispondere a un grazie.", note = "Grazie a te per il vino !")), situation = "La serata finisce: l’ospite ringrazia, dice che deve andare e vi salutate fino alla prossima volta.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ringrazia per la serata.", expected = listOf("Grazie per la serata !", "Grazie per la bella serata !"), focus = "grazie per", watch = "grazie per + cosa."), PracticeQuestion(prompt = "Dì che è stato bello.", expected = listOf("È stato bello, grazie !", "E stato bello, grazie !"), focus = "è stato", watch = "essere + participio."), PracticeQuestion(prompt = "Dì che è tardi e devi andare.", expected = listOf("È tardi, devo andare.", "E tardi, devo andare."), focus = "devo andare", watch = "devo + infinito."), PracticeQuestion(prompt = "Rispondi al grazie e saluta per la prossima volta.", expected = listOf("Grazie a te, alla prossima !", "Grazie a te !"), focus = "grazie a te", watch = "grazie a te = gracias a ti."), PracticeQuestion(prompt = "Saluta un amico, per presto.", expected = listOf("A presto !", "Ciao, a presto !"), focus = "a presto", watch = "a presto = hasta pronto."), PracticeQuestion(prompt = "Prometti di chiamare.", expected = listOf("Ti chiamo !", "Ti chiamo domani !"), focus = "ti chiamo", watch = "chiamare qualcuno."))), exercises = listOf(Exercise(id = "it-foundations-u19-addio-e1", kind = "choice", prompt = "___ per la serata: è stato bellissimo !", options = listOf("Grazie", "Scusa", "Prego", "Per favore"), answers = listOf("Grazie"), explain = "Ringraziare: grazie per + cosa."), Exercise(id = "it-foundations-u19-addio-e2", kind = "gap", prompt = "È tardi: devo ___.", options = listOf(), answers = listOf("andare", "andare via", "andarmene"), explain = "devo + infinito: andare."), Exercise(id = "it-foundations-u19-addio-e3", kind = "order", prompt = "Rispondi al grazie e saluta per la prossima volta.", options = listOf(), answers = listOf("Grazie a te alla prossima"), explain = "Grazie a te + alla prossima."), Exercise(id = "it-foundations-u19-addio-e4", kind = "written", prompt = "Ringrazia chi ti ha ospitato per la serata.", options = listOf(), answers = listOf("grazie per la serata", "grazie per la serata era bellissima", "e stata una bella serata grazie"), explain = "grazie per + la serata.")), skills = listOf("vocab:social-expressions", "grammar:present-simple", "function:ask-simple-questions", "grammar:can"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple"))))
}

object ItFoundationsU22 {
    val unit = CourseUnit(id = "it-foundations-u22", title = "Festa !", subtitle = "Inviti e auguri", level = "A1", themes = listOf(ConversationTheme("l-invito", "Vieni alla festa ?", "Ti va sabato ?", "party.popper", "Course", "Organizzate una festa: invitate gli amici, decidete il giorno e l’ora e dite chi porta cosa.", 0),
                ConversationTheme("auguri-e-regali", "Tanti auguri", "Il regalo perfetto", "birthday.cake", "Course", "È il compleanno di Giulia: scegliete il regalo parlando dei suoi gusti, poi fate gli auguri sulla torta.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u22-festa", title = "Vieni alla festa ?", goal = "Invitare un amico a una festa e decidere giorno e ora.", intro = LessonIntro(explanation = listOf("Per invitare: vuoi + infinito. « Vuoi venire alla festa ? ». È l’invito semplice e diretto.", "Oppure proponi con ti va di + infinito: « Ti va di venire sabato ? ». La risposta contenta: « Volentieri ! ».", "Poi fate i dettagli: « A che ora inizia ? », « Dov’è ? ». E la risposta: « Alle otto, a casa di Marco »."), examples = listOf(ExampleLine(text = "Vuoi venire alla festa ?", meaning = "Invitare un amico."), ExampleLine(text = "Ti va di venire sabato ?", meaning = "Proporre il giorno."), ExampleLine(text = "Volentieri, grazie !", meaning = "Accettare l’invito."), ExampleLine(text = "A che ora inizia ?", meaning = "Chiedere l’ora."), ExampleLine(text = "Sabato alle otto, a casa di Marco.", meaning = "Dare i dettagli."))), expressions = listOf(TargetExpression(text = "Vuoi venire… ?", meaning = "L’invito semplice.", note = "Vuoi venire alla festa ?"), TargetExpression(text = "Ti va di… ?", meaning = "La proposta gentile.", note = "Ti va di venire sabato ?"), TargetExpression(text = "Volentieri !", meaning = "Accettare con piacere.", note = "Volentieri, grazie !"), TargetExpression(text = "A che ora ?", meaning = "Chiedere l’ora.", note = "A che ora inizia la festa ?"), TargetExpression(text = "a casa di…", meaning = "Il luogo della festa.", note = "A casa di Marco, alle otto.")), situation = "Marco invita Giulia alla sua festa: lei accetta con piacere e chiede il giorno, l’ora e il luogo.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Invita Luca alla festa.", expected = listOf("Vuoi venire alla festa ?", "Vuoi venire alla mia festa ?"), focus = "vuoi + infinito", watch = "vuoi venire = ¿quieres venir? (l’invito semplice)."), PracticeQuestion(prompt = "Proponi il sabato, con gentilezza.", expected = listOf("Ti va di venire sabato ?", "Ti va sabato ?"), focus = "ti va di", watch = "ti va di + infinito = la proposta gentile."), PracticeQuestion(prompt = "Accetta l’invito con piacere.", expected = listOf("Volentieri !", "Volentieri, grazie !", "Si, volentieri !"), focus = "volentieri", watch = "volentieri = con gusto (sí, encantado)."), PracticeQuestion(prompt = "Chiedi a che ora inizia la festa.", expected = listOf("A che ora inizia ?", "A che ora inizia la festa ?"), focus = "a che ora", watch = "a che ora + verbo: la domanda sull’ora."), PracticeQuestion(prompt = "Dì dove è la festa: a casa di Marco.", expected = listOf("È a casa di Marco.", "La festa è a casa di Marco.", "E a casa di Marco."), focus = "a casa di", watch = "a casa di + nome = en casa de."), PracticeQuestion(prompt = "Chiedi chi viene alla festa.", expected = listOf("Chi viene ?", "Chi viene alla festa ?"), focus = "chi", watch = "chi + verbo: « Chi viene ? »."))), exercises = listOf(Exercise(id = "it-foundations-u22-festa-e1", kind = "choice", prompt = "___ venire alla festa sabato ?", options = listOf("Vuoi", "Vai", "Vuole", "Vieni"), answers = listOf("Vuoi"), explain = "L’invito: vuoi + infinito (tu)."), Exercise(id = "it-foundations-u22-festa-e2", kind = "gap", prompt = "___ va di venire al cinema ? (proposta gentile)", options = listOf(), answers = listOf("ti"), explain = "Ti va di + infinito: la proposta gentile."), Exercise(id = "it-foundations-u22-festa-e3", kind = "order", prompt = "Chiedi l’ora della festa.", options = listOf(), answers = listOf("A che ora inizia"), explain = "A che ora + verbo: la domanda sull’ora."), Exercise(id = "it-foundations-u22-festa-e4", kind = "written", prompt = "Accetta un invito con piacere.", options = listOf(), answers = listOf("volentieri", "volentieri grazie", "si volentieri"), explain = "Volentieri: il sì contento.")), skills = listOf("vocab:social-expressions", "grammar:present-simple", "function:make-suggestions", "function:ask-simple-questions"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u22-regalo", title = "Il regalo", goal = "Chiedere e dire che regalo comprare, parlando dei gusti.", intro = LessonIntro(explanation = listOf("Per chiedere un’idea: « Cosa compriamo per Giulia ? ». Compriamo = noi, adesso decidiamo insieme.", "I gusti si dicono con piacere: « A Giulia piacciono i libri », « Le piace la musica ». Piacciono per le più cose, piace per una.", "Poi decidi: « Le compro un libro », « Prendiamo i fiori ». Le = a lei, il regalo è per lei."), examples = listOf(ExampleLine(text = "Cosa compriamo per Giulia ?", meaning = "Chiedere un’idea."), ExampleLine(text = "A Giulia piacciono i libri.", meaning = "I suoi gusti, al plurale."), ExampleLine(text = "Le piace la musica.", meaning = "Una cosa sola."), ExampleLine(text = "Le compro un libro.", meaning = "Il regalo deciso."), ExampleLine(text = "Quanto costa questo libro ?", meaning = "Chiedere il prezzo."))), expressions = listOf(TargetExpression(text = "Cosa compriamo… ?", meaning = "Chiedere un’idea regalo.", note = "Cosa compriamo per Anna ?"), TargetExpression(text = "piace / piacciono", meaning = "I gusti di qualcuno.", note = "Le piacciono i libri."), TargetExpression(text = "Le compro…", meaning = "Il regalo deciso.", note = "Le compro un libro."), TargetExpression(text = "prendiamo", meaning = "Decidere insieme.", note = "Prendiamo i fiori ?"), TargetExpression(text = "Quanto costa ?", meaning = "Chiedere il prezzo.", note = "Quanto costa questo libro ?")), situation = "Cercate un regalo per il compleanno di Giulia: parlate dei suoi gusti, guardate i prezzi e decidete insieme.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedi a Marco cosa comprare per Giulia.", expected = listOf("Cosa compriamo per Giulia ?", "Che cosa compriamo per Giulia ?", "Cosa compriamo ?"), focus = "compriamo", watch = "compriamo = compramos (noi, adesso)."), PracticeQuestion(prompt = "Dì i gusti di Giulia: i libri.", expected = listOf("A Giulia piacciono i libri.", "Le piacciono i libri.", "A Giulia piacciono libri."), focus = "piacciono", watch = "piacciono = più cose; piace = una sola."), PracticeQuestion(prompt = "Dì che a Giulia piace la musica.", expected = listOf("Le piace la musica.", "A Giulia piace la musica.", "Le piace musica."), focus = "piace", watch = "piace + cosa singolare."), PracticeQuestion(prompt = "Dì la tua idea: compri un libro per lei.", expected = listOf("Le compro un libro.", "Io le compro un libro.", "Le compro libro."), focus = "le compro", watch = "le = a ella: le compro."), PracticeQuestion(prompt = "Chiedi il prezzo di questo libro.", expected = listOf("Quanto costa questo libro ?", "Quanto costa ?"), focus = "quanto costa", watch = "quanto costa + cosa singolare."), PracticeQuestion(prompt = "Proponi di prendere i fiori.", expected = listOf("Prendiamo i fiori ?", "Prendiamo dei fiori."), focus = "prendiamo", watch = "prendiamo = propuesta: ¡tomemos!"))), exercises = listOf(Exercise(id = "it-foundations-u22-regalo-e1", kind = "choice", prompt = "A Giulia ___ i fiori.", options = listOf("piacciono", "piace", "vogliono", "amano"), answers = listOf("piacciono"), explain = "I fiori = plurale: piacciono."), Exercise(id = "it-foundations-u22-regalo-e2", kind = "gap", prompt = "Le ___ un libro per il compleanno. (comprare, noi)", options = listOf(), answers = listOf("compriamo"), explain = "Noi compriamo: la decisione insieme."), Exercise(id = "it-foundations-u22-regalo-e3", kind = "order", prompt = "Chiedi il prezzo di questo libro.", options = listOf(), answers = listOf("Quanto costa questo libro"), explain = "Quanto costa + la cosa."), Exercise(id = "it-foundations-u22-regalo-e4", kind = "written", prompt = "Dì i gusti di Marco: i film.", options = listOf(), answers = listOf("a marco piacciono i film", "piacciono i film", "gli piacciono i film"), explain = "A + nome + piacciono + plurale.")), skills = listOf("function:go-shopping", "vocab:social-expressions", "grammar:present-questions", "grammar:present-simple"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u22-auguri", title = "Fare gli auguri", goal = "Fare gli auguri per un compleanno, organizzare la sorpresa e reagire con emozione.", intro = LessonIntro(explanation = listOf("Gli auguri classici: « Tanti auguri ! », « Buon compleanno ! ». E l’augurio lungo: « Cento di questi giorni ! ».", "Con la torta: « Fai un desiderio ! ». E il ringraziamento con emozione: « Grazie a tutti, sono felice ! ».", "Per la sorpresa proponi insieme: « Facciamo una torta ? », « Organizziamo una festa a sorpresa ! »."), examples = listOf(ExampleLine(text = "Tanti auguri, Giulia !", meaning = "L’augurio semplice."), ExampleLine(text = "Buon compleanno !", meaning = "L’augurio del giorno."), ExampleLine(text = "Cento di questi giorni !", meaning = "L’augurio dei cento anni."), ExampleLine(text = "Fai un desiderio !", meaning = "Prima delle candeline."), ExampleLine(text = "Grazie a tutti, sono felice !", meaning = "Ringraziare con emozione."))), expressions = listOf(TargetExpression(text = "Tanti auguri", meaning = "L’augurio universale.", note = "Tanti auguri, Marco !"), TargetExpression(text = "Buon compleanno", meaning = "L’augurio per il giorno.", note = "Buon compleanno a te !"), TargetExpression(text = "Cento di questi giorni", meaning = "Il classico augurio italiano.", note = "Cento di questi giorni !"), TargetExpression(text = "Fai un desiderio", meaning = "Prima delle candeline.", note = "Soffia e fai un desiderio !"), TargetExpression(text = "di cuore", meaning = "L’augurio sentito.", note = "Tanti auguri di cuore.")), situation = "Giulia spegne le candeline: tutti cantano, fanno gli auguri, propongono la sorpresa e lei ringrazia con emozione.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Fai gli auguri a Giulia per il compleanno.", expected = listOf("Tanti auguri, Giulia !", "Buon compleanno, Giulia !", "Tanti auguri Giulia"), focus = "tanti auguri", watch = "tanti auguri = ¡feliz cumpleaños!"), PracticeQuestion(prompt = "Fai l’augurio classico italiano: cento anni.", expected = listOf("Cento di questi giorni !", "Cento di questi giorni"), focus = "cento", watch = "l’augurio dei cento anni."), PracticeQuestion(prompt = "Dì a Giulia di fare un desiderio.", expected = listOf("Fai un desiderio !", "Fai un desiderio"), focus = "fai", watch = "l’imperativo tu: fai."), PracticeQuestion(prompt = "Fai un augurio sentito, di cuore.", expected = listOf("Tanti auguri di cuore.", "Auguri di cuore"), focus = "di cuore", watch = "di cuore = de corazón."), PracticeQuestion(prompt = "Giulia ringrazia ed è felice.", expected = listOf("Grazie a tutti, sono felice !", "Grazie, sono molto felice.", "Grazie a tutti sono felice"), focus = "sono felice", watch = "essere + emozione."), PracticeQuestion(prompt = "Proponi di organizzare una sorpresa.", expected = listOf("Organizziamo una festa a sorpresa !", "Facciamo una festa a sorpresa ?"), focus = "organizziamo", watch = "organizziamo / facciamo = proponemos."))), exercises = listOf(Exercise(id = "it-foundations-u22-auguri-e1", kind = "choice", prompt = "___ auguri, Anna ! Buon compleanno !", options = listOf("Tanti", "Tanto", "Tante", "Molto"), answers = listOf("Tanti"), explain = "Tanti auguri: l’augurio classico."), Exercise(id = "it-foundations-u22-auguri-e2", kind = "gap", prompt = "___ un desiderio, Giulia ! (tu)", options = listOf(), answers = listOf("fai"), explain = "L’imperativo tu: fai un desiderio."), Exercise(id = "it-foundations-u22-auguri-e3", kind = "order", prompt = "Fai l’augurio classico: cento anni.", options = listOf(), answers = listOf("Cento di questi giorni"), explain = "Cento di questi giorni: cent’anni di vita."), Exercise(id = "it-foundations-u22-auguri-e4", kind = "written", prompt = "Ringrazia gli amici: sei felice.", options = listOf(), answers = listOf("grazie a tutti sono felice", "grazie sono felice", "grazie a tutti sono molto felice"), explain = "Grazie + essere + emozione.")), skills = listOf("vocab:social-expressions", "function:make-suggestions", "grammar:present-simple", "vocab:feelings"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple"))))
}

object ItFoundationsU23 {
    val unit = CourseUnit(id = "it-foundations-u23", title = "Vestiti e taglie", subtitle = "In negozio", level = "A1", themes = listOf(ConversationTheme("il-negozio", "In negozio", "Cerco una maglietta", "tshirt", "Course", "In un negozio di vestiti: cercate un capo, chiedete colore e taglia e provate tutto al camerino.", 0),
                ConversationTheme("alla-cassa", "Troppo caro", "Pago così", "bag", "Course", "Alla cassa il prezzo convince poco: si chiede lo sconto, si paga e si prende la busta.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u23-negozio", title = "In negozio", goal = "Chiedere un capo, la taglia, il colore e la quantità in un negozio di vestiti.", intro = LessonIntro(explanation = listOf("Per iniziare: « Buongiorno, cerco una maglietta ». Poi chiedi: « Avete anche il nero ? », « Che taglia è ? ».", "Le taglie: la S è piccola, la M media, la L grande. E i colori: « Avete il blu ? ».", "Per comprare più di una cosa: ne + prendo + numero. « Le magliette ? Ne prendo due »."), examples = listOf(ExampleLine(text = "Buongiorno, cerco una maglietta.", meaning = "Aprire la conversazione."), ExampleLine(text = "Avete anche il nero ?", meaning = "Chiedere il colore."), ExampleLine(text = "Che taglia è ?", meaning = "Chiedere la taglia."), ExampleLine(text = "Ne prendo due.", meaning = "Due cose: ne + prendo."), ExampleLine(text = "La taglia è giusta.", meaning = "Il capo va bene."))), expressions = listOf(TargetExpression(text = "cerco…", meaning = "Dire cosa vuoi comprare.", note = "Cerco una camicia."), TargetExpression(text = "Avete… ?", meaning = "Chiedere se c’è.", note = "Avete la taglia M ?"), TargetExpression(text = "che taglia ?", meaning = "La domanda sulla misura.", note = "Che taglia è ?"), TargetExpression(text = "ne prendo due", meaning = "Comprare più di una.", note = "Ne prendo due, grazie."), TargetExpression(text = "in nero / in blu", meaning = "Il colore del capo.", note = "La stessa in nero, per favore.")), situation = "In un negozio del centro: cerchi una maglietta, chiedi colore e taglia e alla fine ne prendi due.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dì al commesso cosa cerchi: una maglietta.", expected = listOf("Cerco una maglietta.", "Buongiorno, cerco una maglietta."), focus = "cerco", watch = "cerco = busco."), PracticeQuestion(prompt = "Chiedi se hanno la taglia M.", expected = listOf("Avete la taglia M ?", "Avete la M ?"), focus = "avete", watch = "avete = ustedes tienen (voi)."), PracticeQuestion(prompt = "Chiedi la taglia di quella maglietta.", expected = listOf("Che taglia è ?", "Che taglia è quella ?"), focus = "che taglia", watch = "che taglia = ¿qué talla?"), PracticeQuestion(prompt = "Chiedi la maglietta in nero.", expected = listOf("Avete anche il nero ?", "Avete in nero ?", "La volevo in nero."), focus = "il nero", watch = "i colori: il nero, il blu."), PracticeQuestion(prompt = "Dì che prendi due magliette.", expected = listOf("Ne prendo due.", "Ne prendo due, grazie."), focus = "ne prendo", watch = "ne = de ellas: ne prendo due."), PracticeQuestion(prompt = "Dì che la taglia è giusta per te.", expected = listOf("La taglia è giusta.", "È giusta per me."), focus = "giusta", watch = "giusto / giusta = correcto."))), exercises = listOf(Exercise(id = "it-foundations-u23-negozio-e1", kind = "choice", prompt = "Buongiorno, ___ una camicia bianca.", options = listOf("cerco", "cerca", "cerchi", "cercate"), answers = listOf("cerco"), explain = "Io cerco + la cosa."), Exercise(id = "it-foundations-u23-negozio-e2", kind = "gap", prompt = "___ la taglia M, per favore ? (avere, voi)", options = listOf(), answers = listOf("avete"), explain = "Avete = voi: la domanda al negozio."), Exercise(id = "it-foundations-u23-negozio-e3", kind = "order", prompt = "Dì che prendi due magliette.", options = listOf(), answers = listOf("Ne prendo due"), explain = "Ne + prendo + numero: due magliette."), Exercise(id = "it-foundations-u23-negozio-e4", kind = "written", prompt = "Chiedi se hanno il colore nero.", options = listOf(), answers = listOf("avete il nero", "avete anche il nero", "avete in nero"), explain = "Avete + il colore: la domanda al negozio.")), skills = listOf("function:go-shopping", "vocab:shopping", "grammar:quantities", "grammar:present-simple"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "it-foundations-u23-camerino", title = "Il camerino", goal = "Chiedere di provare un capo e dire se va bene o no.", intro = LessonIntro(explanation = listOf("Per provare: posso + infinito. « Posso provarla ? ». Provarla = la maglietta, provarlo = il pantalone.", "Poi il conto del vestito: « È troppo grande », « È un po’ stretta ». Si dice con essere.", "Chiedi un’altra taglia: « Avete una taglia più piccola ? ». E quando è giusta: « Questa va bene, la prendo »."), examples = listOf(ExampleLine(text = "Posso provarla ?", meaning = "Chiedere di provare."), ExampleLine(text = "Dov’è il camerino ?", meaning = "Chiedere il luogo."), ExampleLine(text = "È troppo grande.", meaning = "Il capo non va bene."), ExampleLine(text = "È un po’ stretta.", meaning = "Piccola, ma solo un po’."), ExampleLine(text = "Questa va bene, la prendo.", meaning = "La decisione finale."))), expressions = listOf(TargetExpression(text = "posso provarlo / provarla", meaning = "Chiedere di provare.", note = "Posso provarla, per favore ?"), TargetExpression(text = "il camerino", meaning = "Il piccolo spogliatoio.", note = "Dov’è il camerino ?"), TargetExpression(text = "troppo grande / piccola", meaning = "Il capo non va bene.", note = "È troppo grande per me."), TargetExpression(text = "un po’ stretto / stretta", meaning = "Piccolo, un po’.", note = "È un po’ stretta."), TargetExpression(text = "va bene", meaning = "Il capo è giusto.", note = "Questa va bene, la prendo.")), situation = "Nel camerino provi la maglietta: prima è grande, poi stretta, e alla fine la taglia giusta va bene.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedi di provare la maglietta.", expected = listOf("Posso provarla ?", "Posso provarla, per favore ?"), focus = "posso provarla", watch = "provarla = probarla (la maglietta)."), PracticeQuestion(prompt = "Chiedi dov’è il camerino.", expected = listOf("Dov’è il camerino ?", "Scusi, dov’è il camerino ?"), focus = "dov’è", watch = "dov’è = ¿dónde está?"), PracticeQuestion(prompt = "Dì che la maglietta è troppo grande.", expected = listOf("È troppo grande.", "Questa è troppo grande.", "E troppo grande."), focus = "troppo grande", watch = "essere + troppo + aggettivo."), PracticeQuestion(prompt = "Dì che il pantalone è un po’ stretto.", expected = listOf("È un po’ stretto.", "Il pantalone è un po’ stretto."), focus = "stretto", watch = "stretto = ajustado."), PracticeQuestion(prompt = "Chiedi la taglia più piccola.", expected = listOf("Avete una taglia più piccola ?", "Posso provare la S ?"), focus = "più piccola", watch = "più + aggettivo: la taglia sotto."), PracticeQuestion(prompt = "Dì che questa va bene e la prendi.", expected = listOf("Questa va bene, la prendo.", "Questa va bene."), focus = "va bene", watch = "va bene = queda bien."))), exercises = listOf(Exercise(id = "it-foundations-u23-camerino-e1", kind = "choice", prompt = "___ provarla, per favore ?", options = listOf("Posso", "Devo", "Sono", "Faccio"), answers = listOf("Posso"), explain = "Il permesso: posso + infinito."), Exercise(id = "it-foundations-u23-camerino-e2", kind = "gap", prompt = "Il pantalone è un po’ ___. (non entra)", options = listOf(), answers = listOf("stretto", "stretta"), explain = "stretto = troppo piccolo per te."), Exercise(id = "it-foundations-u23-camerino-e3", kind = "order", prompt = "Chiedi il permesso di provare il pantalone.", options = listOf(), answers = listOf("Posso provarlo per favore"), explain = "Provarlo = il pantalone (maschile)."), Exercise(id = "it-foundations-u23-camerino-e4", kind = "written", prompt = "Dì che questa maglietta va bene e la prendi.", options = listOf(), answers = listOf("questa va bene la prendo", "va bene la prendo", "questa va bene"), explain = "Va bene + la prendo: la decisione.")), skills = listOf("function:make-requests", "function:go-shopping", "grammar:can", "vocab:shopping"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:can")),
    Lesson(id = "it-foundations-u23-cassa", title = "Troppo caro", goal = "Reagire al prezzo, chiedere lo sconto e pagare alla cassa.", intro = LessonIntro(explanation = listOf("Il prezzo si chiede alla cassa: « Quant’è ? », « Quanto fa ? ». E se è alto: « È troppo caro ! ».", "Si prova lo sconto: « C’è uno sconto ? ». Oppure si cerca il prezzo ridotto: « È in saldo ? ».", "Si paga: « Pago con la carta », « In contanti ». E si prende la busta: « Una busta, grazie »."), examples = listOf(ExampleLine(text = "Quant’è ?", meaning = "Chiedere il totale."), ExampleLine(text = "È troppo caro per me.", meaning = "Reagire al prezzo."), ExampleLine(text = "C’è uno sconto ?", meaning = "Chiedere il prezzo giù."), ExampleLine(text = "Pago con la carta.", meaning = "Il modo di pagare."), ExampleLine(text = "In contanti, grazie.", meaning = "L’altro modo di pagare."))), expressions = listOf(TargetExpression(text = "Quant’è ?", meaning = "Chiedere il totale.", note = "Quant’è, per favore ?"), TargetExpression(text = "troppo caro", meaning = "Il prezzo eccessivo.", note = "È troppo caro !"), TargetExpression(text = "c’è uno sconto ?", meaning = "Chiedere il prezzo giù.", note = "C’è uno sconto su questo ?"), TargetExpression(text = "in saldo", meaning = "Il prezzo ridotto.", note = "È in saldo, meno trenta."), TargetExpression(text = "pago con la carta / in contanti", meaning = "I due modi di pagare.", note = "Pago in contanti."), TargetExpression(text = "la busta", meaning = "La busta degli acquisti.", note = "Una busta, grazie.")), situation = "Alla cassa: chiedi il totale, il prezzo è alto, chiedi lo sconto, paghi con la carta e prendi la busta.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedi il totale alla cassa.", expected = listOf("Quant’è ?", "Quanto fa ?", "Quant’è, per favore ?"), focus = "quant’è", watch = "quant’è = ¿cuánto es?"), PracticeQuestion(prompt = "Dì che il prezzo è troppo alto.", expected = listOf("È troppo caro.", "È troppo caro per me.", "E troppo caro."), focus = "troppo caro", watch = "caro = de precio."), PracticeQuestion(prompt = "Chiedi se c’è uno sconto.", expected = listOf("C’è uno sconto ?", "C’è uno sconto su questo ?", "Ce uno sconto"), focus = "sconto", watch = "sconto = descuento."), PracticeQuestion(prompt = "Dì che paghi con la carta.", expected = listOf("Pago con la carta.", "Posso pagare con la carta ?"), focus = "la carta", watch = "con la carta = con tarjeta."), PracticeQuestion(prompt = "Dì che paghi in contanti.", expected = listOf("Pago in contanti.", "In contanti, grazie."), focus = "contanti", watch = "in contanti = en efectivo."), PracticeQuestion(prompt = "Chiedi la busta.", expected = listOf("Una busta, grazie.", "Posso avere una busta ?"), focus = "busta", watch = "busta = bolsa."))), exercises = listOf(Exercise(id = "it-foundations-u23-cassa-e1", kind = "choice", prompt = "___ ? Sono trenta euro.", options = listOf("Quant’è", "Chi è", "Dov’è", "Com’è"), answers = listOf("Quant’è"), explain = "Quant’è: la domanda sul prezzo totale."), Exercise(id = "it-foundations-u23-cassa-e2", kind = "gap", prompt = "È troppo ___, non lo prendo. (prezzo alto)", options = listOf(), answers = listOf("caro", "cara"), explain = "caro = prezzo alto."), Exercise(id = "it-foundations-u23-cassa-e3", kind = "order", prompt = "Dì come paghi alla cassa: carta.", options = listOf(), answers = listOf("Pago con la carta"), explain = "Pagare con la carta: il modo moderno."), Exercise(id = "it-foundations-u23-cassa-e4", kind = "written", prompt = "Alla cassa paghi senza carta: come lo dici ?", options = listOf(), answers = listOf("pago in contanti", "in contanti", "pago in contanti grazie"), explain = "In contanti: con monedas y billetes.")), skills = listOf("function:go-shopping", "grammar:quantities", "vocab:shopping", "vocab:social-expressions"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple"))))
}

object ItFoundationsU27 {
    val unit = CourseUnit(id = "it-foundations-u27", title = "Al bar", subtitle = "Caffè, cornetti ed euro", level = "A1", themes = listOf(ConversationTheme("u27-al-bancone", "Al bancone", "Ordinare al bar", "takeout.bag", "Course", "Sei al bar la mattina: ordini al bancone, chiedi se c'è il cornetto integrale e scambi due parole con il barista.", 0),
                ConversationTheme("u27-quanto-costa", "Quanto costa?", "Numeri ed euro", "creditcard", "Course", "Alla cassa chiedi il prezzo, paghi in contanti e controlli il resto.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u27-bancone", title = "Al bancone", goal = "Ordinare al bar con vorrei, prendere e prego, come un italiano vero.", intro = LessonIntro(explanation = listOf("Al bar si ordina con vorrei + la cosa: « Vorrei un caffè, per favore ». È gentile e va bene sempre.", "La scelta rapida è prendo + la cosa: « Prendo un cornetto alla crema ». Suona deciso, da clienti abituali.", "Per sapere se una cosa esiste: « C'è il cornetto integrale? ». La risposta breve: « Sì, c'è » oppure « No, non c'è ».", "Il barista serve e dice « Prego! ». E tu rispondi « Grazie! »: prego è la risposta, non il ringraziamento."), examples = listOf(ExampleLine(text = "Vorrei un caffè, per favore.", meaning = "Il modo gentile di ordinare."), ExampleLine(text = "Prendo anche un cornetto.", meaning = "La scelta rapida al bancone."), ExampleLine(text = "C'è il cornetto integrale?", meaning = "La domanda con c'è."), ExampleLine(text = "Prego, signora!", meaning = "Il barista offre."), ExampleLine(text = "Grazie mille. — Prego!", meaning = "Grazie e la sua risposta."))), expressions = listOf(TargetExpression(text = "vorrei + …", meaning = "Ordino con gentilezza.", note = "Vorrei un cappuccino."), TargetExpression(text = "prendo + …", meaning = "La scelta al bancone.", note = "Prendo anche un'acqua."), TargetExpression(text = "C'è… ?", meaning = "Chiedo se esiste.", note = "C'è il latte di soia?"), TargetExpression(text = "prego", meaning = "La risposta del barista.", note = "Ecco il caffè, prego!"), TargetExpression(text = "per favore / grazie", meaning = "Le parole magiche.", note = "Un caffè, per favore. Grazie!")), situation = "È sabato mattina: entri al bar sotto casa, ordini un caffè e un cornetto, chiedi se c'è il cornetto integrale e ringrazi il barista.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ordina gentilmente un caffè.", expected = listOf("Vorrei un caffè, per favore.", "Vorrei un caffè per favore"), focus = "vorrei", watch = "vorrei + la cosa: è il modo gentile di ordinare."), PracticeQuestion(prompt = "Dì che prendi anche un cornetto alla crema.", expected = listOf("Prendo anche un cornetto alla crema.", "E prendo un cornetto alla crema."), focus = "prendo", watch = "prendo + la cosa: la scelta rapida."), PracticeQuestion(prompt = "Chiedi se c'è il cornetto integrale.", expected = listOf("C'è il cornetto integrale?", "C'e il cornetto integrale?"), focus = "c'è", watch = "c'è si scrive con l'accento: c'è, non c'e."), PracticeQuestion(prompt = "Il barista ti dà il caffè: che parola usa?", expected = listOf("Prego!", "Prego", "Ecco il caffè, prego!"), focus = "prego", watch = "prego = la risposta quando si serve."), PracticeQuestion(prompt = "Ringrazia il barista con entusiasmo.", expected = listOf("Grazie mille!", "Grazie mille", "Mille grazie!"), focus = "grazie mille", watch = "grazie mille è più forte di grazie."), PracticeQuestion(prompt = "Chiedi al barista se c'è il latte di soia.", expected = listOf("C'è il latte di soia?", "C'e il latte di soia?"), focus = "c'è", watch = "c'è + singolare: una cosa sola."))), exercises = listOf(Exercise(id = "it-foundations-u27-bancone-e1", kind = "choice", prompt = "Per ordinare con gentilezza al bar, dici: « ___ un caffè, per favore ».", options = listOf("Vorrei", "Voglio", "Sono", "Faccio"), answers = listOf("Vorrei"), explain = "Vorrei + la cosa: è il modo gentile e sicuro di ordinare al bar."), Exercise(id = "it-foundations-u27-bancone-e2", kind = "gap", prompt = "Il barista mette il cappuccino sul bancone e dice: « ___! » (la risposta a grazie)", options = listOf(), answers = listOf("Prego", "prego", "Prego!", "prego!"), explain = "Prego è la risposta tipica del barista quando serve al bancone."), Exercise(id = "it-foundations-u27-bancone-e3", kind = "order", prompt = "Metti in ordine la domanda: chiedi se il cornetto integrale è disponibile.", options = listOf(), answers = listOf("C'è il cornetto integrale"), explain = "c'è + la cosa: la domanda breve per sapere se esiste."), Exercise(id = "it-foundations-u27-bancone-e4", kind = "written", prompt = "Ordina anche l'acqua naturale.", options = listOf(), answers = listOf("Prendo anche un'acqua", "Vorrei anche un'acqua", "Prendo anche un acqua", "Prendo un'acqua"), explain = "prendo / vorrei + la cosa: anche aggiunge un secondo ordine.")), skills = listOf("function:order-food", "vocab:food", "grammar:present-simple", "vocab:social-expressions"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple", "vocab:food")),
    Lesson(id = "it-foundations-u27-costo", title = "Quanto costa?", goal = "Chiedere il prezzo, capire i numeri e pagare in euro alla cassa.", intro = LessonIntro(explanation = listOf("Per il prezzo si chiede « Quanto costa? » per una cosa e « Quanto costano? » per più cose: « Quanto costa il cappuccino? ».", "La risposta usa il verbo essere: « Sono due euro e cinquanta ». In italiano il plurale è euro, mai « euri ».", "Alla cassa si chiede: « Posso pagare con la carta? ». La risposta: « Sì » oppure « Solo contanti »."), examples = listOf(ExampleLine(text = "Quanto costa il cappuccino?", meaning = "Una cosa: costa."), ExampleLine(text = "Quanto costano i cornetti?", meaning = "Più cose: costano."), ExampleLine(text = "Sono un euro e venti.", meaning = "Il prezzo con e."), ExampleLine(text = "Posso pagare con la carta?", meaning = "La domanda alla cassa."), ExampleLine(text = "Ecco dieci euro. — Ecco il resto.", meaning = "Contanti e resto."))), expressions = listOf(TargetExpression(text = "Quanto costa… ?", meaning = "Il prezzo di una cosa.", note = "Quanto costa il caffè?"), TargetExpression(text = "Quanto costano… ?", meaning = "Il prezzo di più cose.", note = "Quanto costano le brioche?"), TargetExpression(text = "sono … euro", meaning = "La risposta col prezzo.", note = "Sono due euro e cinquanta."), TargetExpression(text = "posso pagare… ?", meaning = "Carta o contanti.", note = "Posso pagare in contanti?"), TargetExpression(text = "il resto", meaning = "I soldi che tornano.", note = "Ecco il resto, grazie!")), situation = "Prendi due cornetti e un cappuccino: alla cassa chiedi il prezzo, paghi con dieci euro e ricevi il resto.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedi il prezzo del cappuccino.", expected = listOf("Quanto costa il cappuccino?", "Quanto costa il cappuccino"), focus = "quanto costa", watch = "una cosa sola: quanto costa."), PracticeQuestion(prompt = "Chiedi il prezzo dei cornetti, in due.", expected = listOf("Quanto costano i cornetti?", "Quanto costano i cornetti"), focus = "quanto costano", watch = "più cose: quanto costano."), PracticeQuestion(prompt = "Dì il prezzo: 1 euro e 20.", expected = listOf("Sono un euro e venti.", "Sono 1 euro e 20", "Un euro e venti."), focus = "sono … euro", watch = "il plurale è euro, non euri."), PracticeQuestion(prompt = "Alla cassa, chiedi se puoi pagare con la carta.", expected = listOf("Posso pagare con la carta?", "Posso pagare con la carta", "Posso pagare con la carta?"), focus = "posso", watch = "posso + infinito: chiedo il permesso."), PracticeQuestion(prompt = "Paghi dieci euro per un caffè da due: come si chiamano gli otto euro che il barista ti dà?", expected = listOf("Il resto", "il resto", "Resto"), focus = "il resto", watch = "il resto = i soldi che tornano."), PracticeQuestion(prompt = "Dì il prezzo totale: 2 euro e 50.", expected = listOf("Sono due euro e cinquanta.", "Sono 2 euro e 50", "Due euro e cinquanta."), focus = "sono … euro", watch = "cinquanta, non cinquanti."))), exercises = listOf(Exercise(id = "it-foundations-u27-costo-e1", kind = "choice", prompt = "___ costa il cappuccino?", options = listOf("Quanto", "Che", "Dove", "Quando"), answers = listOf("Quanto"), explain = "Quanto costa…? è la domanda per il prezzo di una cosa."), Exercise(id = "it-foundations-u27-costo-e2", kind = "gap", prompt = "Chiedi il prezzo dei cornetti: ___ costano i cornetti? (il plurale della domanda)", options = listOf(), answers = listOf("Quanto", "quanto"), explain = "Per più cose il verbo va al plurale: quanto costano."), Exercise(id = "it-foundations-u27-costo-e3", kind = "order", prompt = "Chiedi se la carta è accettata alla cassa.", options = listOf(), answers = listOf("Posso pagare con la carta"), explain = "posso + infinito: la domanda gentile per il pagamento."), Exercise(id = "it-foundations-u27-costo-e4", kind = "written", prompt = "Dì il prezzo: 2 euro e 50 centesimi.", options = listOf(), answers = listOf("sono due euro 