    val unit = CourseUnit(id = "it-foundations-u17", title = "Stare bene insieme", subtitle = "Inviti e sorprese", level = "A2", themes = listOf(ConversationTheme("proposte-inviti", "Vieni o preferisci… ?", "Facciamo… ?", "calendar.badge.clock", "Course", "Organizzate il weekend: proposte, inviti accettati e rifiutati con gentilezza.", 0),
                ConversationTheme("il-regalo", "Il regalo perfetto", "Andiamo a comprare…", "gift", "Course", "Preparate una sorpresa per il compleanno di un’amica: regalo, torta e festa.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u17-proposte", title = "Vieni o preferisci… ?", goal = "Fare proposte con facciamo e ti va di, e rispondere.", intro = LessonIntro(explanation = listOf("Per proporre un’attività: facciamo / andiamo + attività. « Facciamo una passeggiata ? » propone e chiede insieme.", "Più gentile: ti va di + infinito. « Ti va di venire al cinema ? ». Per la scelta: « Preferisci il sabato ? ».", "Per rispondere: « Volentieri ! » è un sì contento, « Va bene » è un sì tranquillo. E i progetti: « Domani andiamo a visitare il museo »."), examples = listOf(ExampleLine(text = "Facciamo una passeggiata ?", meaning = "Proporre un’attività."), ExampleLine(text = "Ti va di venire al cinema ?", meaning = "Proposta gentile."), ExampleLine(text = "Preferisci il sabato o la domenica ?", meaning = "Chiedere la scelta."), ExampleLine(text = "Volentieri !", meaning = "Accettare con piacere."), ExampleLine(text = "Domani andiamo a pranzo da me.", meaning = "Progetto: andare a + infinito."))), expressions = listOf(TargetExpression(text = "Facciamo … ?", meaning = "Proporre insieme.", note = "Facciamo una pizza ?"), TargetExpression(text = "Ti va di… ?", meaning = "Proposta gentile.", note = "Ti va di uscire ?"), TargetExpression(text = "Preferisci … ?", meaning = "Chiedere la scelta.", note = "Preferisci sabato ?"), TargetExpression(text = "Volentieri !", meaning = "Sì, con piacere.", note = "Volentieri, alle otto !"), TargetExpression(text = "andare a + infinito", meaning = "Progetti per domani.", note = "Andiamo a vedere il museo.")), situation = "Organizzate il weekend in quattro messaggi: Giulia propone, tu accetti e fissate un orario.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Proponi una passeggiata.", expected = listOf("Facciamo una passeggiata ?", "Facciamo una passeggiata ?"), focus = "facciamo", watch = "facciamo… ? = ¿lo hacemos?"), PracticeQuestion(prompt = "Proponi gentilmente di andare al cinema.", expected = listOf("Ti va di andare al cinema ?", "Ti va di venire al cinema ?"), focus = "ti va di", watch = "ti va di + infinito."), PracticeQuestion(prompt = "Accetta con entusiasmo.", expected = listOf("Volentieri !"), focus = "volentieri", watch = "volentieri = con gusto."), PracticeQuestion(prompt = "Chiedi se preferisce sabato.", expected = listOf("Preferisci sabato ?", "Preferisci il sabato ?"), focus = "preferisci", watch = "preferire = preferir."), PracticeQuestion(prompt = "Dì il tuo progetto: domani, visitare il museo.", expected = listOf("Domani andiamo a visitare il museo.", "Domani vado a visitare il museo."), focus = "andare a", watch = "andare a + infinito = plan."), PracticeQuestion(prompt = "Accetta e fissa l’ora: alle otto.", expected = listOf("Va bene, alle otto !", "Volentieri, alle otto !"), focus = "va bene", watch = "va bene = está bien."))), exercises = listOf(Exercise(id = "it-foundations-u17-proposte-e1", kind = "choice", prompt = "___ una pizza stasera ?", options = listOf("Facciamo", "Faccio", "Fate", "Stiamo"), answers = listOf("Facciamo"), explain = "Proporre con noi: facciamo… ?"), Exercise(id = "it-foundations-u17-proposte-e2", kind = "gap", prompt = "Ti ___ di venire al mare ? (andare bene, a te)", options = listOf(), answers = listOf("va"), explain = "ti va di + infinito."), Exercise(id = "it-foundations-u17-proposte-e3", kind = "order", prompt = "Accetta e fissa l’ora: alle nove.", options = listOf(), answers = listOf("Va bene alle nove"), explain = "Va bene + ora."), Exercise(id = "it-foundations-u17-proposte-e4", kind = "written", prompt = "Dì il tuo progetto per domani: andare a nuotare.", options = listOf(), answers = listOf("domani vado a nuotare", "domani andiamo a nuotare"), explain = "andare a + infinito per i progetti.")), skills = listOf("function:make-suggestions", "grammar:going-to", "vocab:social-expressions", "grammar:present-simple"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "it-foundations-u17-scusa", title = "Peccato, non posso", goal = "Accettare e rifiutare inviti con gentilezza, con una scusa.", intro = LessonIntro(explanation = listOf("Accetti con piacere: « Volentieri, vengo ! ». Rifiuti con gentilezza: « Peccato, non posso ».", "La scusa ammorbidisce il no: « Devo lavorare », « Ho un impegno ». Poi ripari: « Facciamo domenica ? ».", "I connettivi tengono il messaggio insieme: « vengo, però arrivo in ritardo », « non posso, quindi facciamo dopo »."), examples = listOf(ExampleLine(text = "Peccato, non posso.", meaning = "Rifiutare con dispiacere."), ExampleLine(text = "Devo lavorare sabato.", meaning = "Scusa semplice."), ExampleLine(text = "Facciamo domenica prossima ?", meaning = "Riparare il no."), ExampleLine(text = "Grazie, vengo !", meaning = "Accettare l’invito."), ExampleLine(text = "Vengo, però arrivo in ritardo.", meaning = "Sì con una condizione."))), expressions = listOf(TargetExpression(text = "Peccato !", meaning = "Che dispiacere.", note = "Peccato, devo studiare."), TargetExpression(text = "non posso", meaning = "Rifiutare.", note = "Non posso, ho un impegno."), TargetExpression(text = "ho un impegno", meaning = "Scusa generica.", note = "Ho un impegno di lavoro."), TargetExpression(text = "la settimana prossima", meaning = "Riparare più tardi.", note = "Facciamola la settimana prossima ?"), TargetExpression(text = "però / quindi", meaning = "Connettivi semplici.", note = "Vengo, però tardi.")), situation = "Paolo ti invita a una cena ma devi rifiutare: scusati, dai un motivo e proponete un altro giorno.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Rifiuta con dispiacere.", expected = listOf("Peccato, non posso.", "Che peccato, non posso."), focus = "peccato", watch = "peccato = lástima."), PracticeQuestion(prompt = "Dai una scusa di lavoro.", expected = listOf("Non posso, devo lavorare.", "Devo lavorare sabato.", "Peccato, devo lavorare."), focus = "devo", watch = "dovere = deber."), PracticeQuestion(prompt = "Ripara: proponi la domenica.", expected = listOf("Facciamo domenica ?", "E se facciamo la domenica ?"), focus = "facciamo… ?", watch = "ripari con una proposta."), PracticeQuestion(prompt = "Accetta l’invito.", expected = listOf("Grazie, vengo !", "Volentieri, vengo !"), focus = "vengo", watch = "vengo = acepto."), PracticeQuestion(prompt = "Accetta ma avvisa: arrivi in ritardo.", expected = listOf("Vengo, però arrivo in ritardo.", "Vengo, ma arrivo in ritardo."), focus = "però", watch = "però = pero (contraste)."), PracticeQuestion(prompt = "Di’ che è un dispiacere ma hai un impegno.", expected = listOf("Peccato, ho un impegno.", "Che peccato, ho un impegno."), focus = "ho un impegno", watch = "scusa generica."))), exercises = listOf(Exercise(id = "it-foundations-u17-scusa-e1", kind = "choice", prompt = "___, non posso: devo lavorare.", options = listOf("Peccato", "Volentieri", "Ci vediamo", "Grazie mille"), answers = listOf("Peccato"), explain = "Peccato introduce il dispiacere."), Exercise(id = "it-foundations-u17-scusa-e2", kind = "gap", prompt = "Vengo, ___ arrivo un po’ in ritardo. (contrasto)", options = listOf(), answers = listOf("però", "pero"), explain = "però = contrasto."), Exercise(id = "it-foundations-u17-scusa-e3", kind = "order", prompt = "Rifiuta e dai la scusa: devi studiare.", options = listOf(), answers = listOf("Peccato devo studiare"), explain = "Peccato + scusa."), Exercise(id = "it-foundations-u17-scusa-e4", kind = "written", prompt = "Ripara il no: proponi la settimana prossima.", options = listOf(), answers = listOf("facciamo la settimana prossima", "e se facciamo la settimana prossima", "facciamola la settimana prossima"), explain = "Ripari con una proposta nuova.")), skills = listOf("vocab:social-expressions", "function:make-suggestions", "grammar:present-simple", "grammar:connectors"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "it-foundations-u17-regalo", title = "Il regalo perfetto", goal = "Parlare di progetti di regalo con andare a + infinito.", intro = LessonIntro(explanation = listOf("I progetti già decisi usano andare a + infinito: « Domani vado a comprare il regalo ».", "La domanda: « Che cosa le vai a regalare ? ». Per i gusti: « Le piace la fotografia ».", "Si organizza: « Vado a cercare un libro di foto », « Luca va a preparare la torta », « Le facciamo una sorpresa »."), examples = listOf(ExampleLine(text = "Domani andiamo a comprare il regalo.", meaning = "Progetto deciso."), ExampleLine(text = "Che cosa le vai a regalare ?", meaning = "Chiedere il progetto."), ExampleLine(text = "Le piace la fotografia.", meaning = "I gusti di lei."), ExampleLine(text = "Vado a cercare un libro di foto.", meaning = "Progetto: cercare."), ExampleLine(text = "Luca va a preparare la torta.", meaning = "Il progetto di Luca."))), expressions = listOf(TargetExpression(text = "andare a + infinito", meaning = "Progetto già deciso.", note = "Vado a comprare il regalo."), TargetExpression(text = "Che cosa vai a… ?", meaning = "Chiedere i progetti.", note = "Che cosa vai a regalare ?"), TargetExpression(text = "Le piace…", meaning = "I gusti di lei.", note = "Le piace la musica."), TargetExpression(text = "andare a cercare", meaning = "Progetto di ricerca.", note = "Vado a cercare un libro."), TargetExpression(text = "fare una sorpresa", meaning = "Regalo segreto.", note = "Le facciamo una sorpresa.")), situation = "Per il compleanno di Sara: decidete il regalo, guardate i negozi e organizzate la sorpresa per sabato.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dì il tuo progetto: comprare il regalo domani.", expected = listOf("Domani vado a comprare il regalo.", "Vado a comprare il regalo domani."), focus = "vado a", watch = "andare a + infinito."), PracticeQuestion(prompt = "Chiedi a Marco che cosa va a regalare.", expected = listOf("Che cosa vai a regalare ?", "Che cosa le vai a regalare ?"), focus = "vai a", watch = "domanda: che cosa + vai a… ?"), PracticeQuestion(prompt = "Dì i gusti di Sara: la fotografia.", expected = listOf("Le piace la fotografia.", "A Sara piace la fotografia."), focus = "le piace", watch = "piacere: le piace."), PracticeQuestion(prompt = "Dì il tuo progetto: cercare un libro di foto.", expected = listOf("Vado a cercare un libro di foto.", "Vado a cercare un libro di fotografia."), focus = "vado a cercare", watch = "cercare = buscar."), PracticeQuestion(prompt = "Dì il progetto di Luca: preparare la torta.", expected = listOf("Luca va a preparare la torta."), focus = "va a", watch = "terza persona: va a."), PracticeQuestion(prompt = "Proponi la sorpresa a Sara.", expected = listOf("Le facciamo una sorpresa.", "Facciamo una sorpresa a Sara."), focus = "fare una sorpresa", watch = "sorpresa = sorpresa."))), exercises = listOf(Exercise(id = "it-foundations-u17-regalo-e1", kind = "choice", prompt = "Domani ___ a comprare il regalo.", options = listOf("vado", "vada", "andare", "vanno"), answers = listOf("vado"), explain = "Io + andare a + infinito: vado a."), Exercise(id = "it-foundations-u17-regalo-e2", kind = "gap", prompt = "Che cosa ___ a regalare a Sara ? (tu)", options = listOf(), answers = listOf("vai"), explain = "tu vai a + infinito."), Exercise(id = "it-foundations-u17-regalo-e3", kind = "order", prompt = "Dì i gusti di Sara: la fotografia.", options = listOf(), answers = listOf("Le piace la fotografia"), explain = "Le piace + cosa."), Exercise(id = "it-foundations-u17-regalo-e4", kind = "written", prompt = "Dì il tuo progetto: cercare un regalo per lei.", options = listOf(), answers = listOf("vado a cercare un regalo per lei", "vado a cercarle un regalo"), explain = "vado a cercare + oggetto.")), skills = listOf("grammar:going-to", "function:make-future-plans", "vocab:social-expressions", "function:go-shopping"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to"))))
}

object ItFoundationsU20 {
    val unit = CourseUnit(id = "it-foundations-u20", title = "I guai quotidiani", subtitle = "Problemi e soluzioni", level = "A2", themes = listOf(ConversationTheme("il-guasto", "Si è rotto", "Che disastro !", "wrench.and.screwdriver", "Course", "Raccontate i guasti della settimana: il telefono si è rotto, la macchina non parte.", 0),
                ConversationTheme("il-reclamo", "Un reclamo tranquillo", "Vorrei segnalare…", "phone.badge.checkmark", "Course", "Telefonate al negozio: qualcosa non funziona e chiedete una soluzione con educazione.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u20-guasto", title = "Si è rotto", goal = "Raccontare un guasto al passato prossimo e reagire.", intro = LessonIntro(explanation = listOf("Il guasto si racconta al passato prossimo: « Il telefono si è rotto », « La macchina non è partita ».", "Con alcuni verbi si usa essere: rompersi, partirsi. Con gli altri, avere: « Ho perso le chiavi », « Ho chiamato il tecnico ».", "Poi reagisci: « Che disastro ! » quando va male, « Meno male ! » quando finisce bene."), examples = listOf(ExampleLine(text = "Il telefono si è rotto.", meaning = "Raccontare il guasto."), ExampleLine(text = "La macchina non è partita.", meaning = "Essere + participio."), ExampleLine(text = "Ho perso le chiavi di casa.", meaning = "Avere + participio."), ExampleLine(text = "Ho chiamato un tecnico.", meaning = "Chiedere aiuto."), ExampleLine(text = "Meno male che funziona !", meaning = "Reagire quando va bene."))), expressions = listOf(TargetExpression(text = "si è rotto / si è rotta", meaning = "Non funziona più.", note = "Lo zaino si è rotto."), TargetExpression(text = "non è partita", meaning = "Non ha funzionato.", note = "La macchina non è partita."), TargetExpression(text = "ho perso", meaning = "perdere → perso.", note = "Ho perso le chiavi."), TargetExpression(text = "chiamare un tecnico", meaning = "Chiedere aiuto.", note = "Ho chiamato un tecnico."), TargetExpression(text = "Che disastro !", meaning = "Reagire al guasto.", note = "Che disastro, la mia settimana !")), situation = "Una settimana nera: il telefono si è rotto, la macchina non è partita e hai perso le chiavi. Racconti tutto a un amico.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Racconta il guasto: il telefono, rotto.", expected = listOf("Il telefono si è rotto.", "Il telefono si e rotto."), focus = "si è rotto", watch = "rompersi: si è rotto."), PracticeQuestion(prompt = "La macchina, ieri, non partita.", expected = listOf("La macchina non è partita.", "La macchina non e partita."), focus = "non è partita", watch = "essere + participio."), PracticeQuestion(prompt = "Racconta: hai perso le chiavi.", expected = listOf("Ho perso le chiavi.", "Ho perso le chiavi di casa."), focus = "ho perso", watch = "perdere → perso."), PracticeQuestion(prompt = "Dì la soluzione: il tecnico, chiamato.", expected = listOf("Ho chiamato un tecnico.", "Ho chiamato il tecnico."), focus = "ho chiamato", watch = "chiamare → chiamato."), PracticeQuestion(prompt = "Reagisci al guasto di Luca: è un disastro.", expected = listOf("Che disastro !", "Che disastro, Luca !"), focus = "che disastro", watch = "reazione simpatica."), PracticeQuestion(prompt = "Il problema è finito bene: reagisci con sollievo.", expected = listOf("Meno male !", "Meno male che funziona !"), focus = "meno male", watch = "meno male = menos mal."))), exercises = listOf(Exercise(id = "it-foundations-u20-guasto-e1", kind = "choice", prompt = "Il caricatore ___ rotto.", options = listOf("si è", "ha", "è", "fa"), answers = listOf("si è"), explain = "Rompersi: si è + participio."), Exercise(id = "it-foundations-u20-guasto-e2", kind = "gap", prompt = "La macchina non ___ partita. (essere)", options = listOf(), answers = listOf("è", "e"), explain = "Essere + participio: non è partita."), Exercise(id = "it-foundations-u20-guasto-e3", kind = "order", prompt = "Racconta il guasto: le chiavi, perse ieri.", options = listOf(), answers = listOf("Ho perso le chiavi ieri"), explain = "Avere + participio: ho perso."), Exercise(id = "it-foundations-u20-guasto-e4", kind = "written", prompt = "Dì la soluzione: il tecnico, chiamato ieri.", options = listOf(), answers = listOf("ho chiamato il tecnico", "ieri ho chiamato il tecnico"), explain = "Avere + participio: ho chiamato.")), skills = listOf("function:solve-problems", "grammar:past-simple-regular", "grammar:past-simple-irregular", "function:describe-past-events"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "it-foundations-u20-soluzione", title = "Cosa faccio ?", goal = "Chiedere e dare soluzioni semplici con se, devi, puoi.", intro = LessonIntro(explanation = listOf("Per chiedere aiuto: « Cosa faccio ? », « Cosa devo fare ? ». Sono le domande più comuni davanti a un problema.", "Per dare una soluzione: « Devi… », « Puoi… », « Prova a… ». « Devi chiamare il tecnico », « Prova a riavviare ».", "Il se collega problema e soluzione: « Se non funziona, riavvia », « Se è rotto, lo compri nuovo »."), examples = listOf(ExampleLine(text = "Cosa faccio ?", meaning = "Chiedere una soluzione."), ExampleLine(text = "Devi chiamare il tecnico.", meaning = "Il consiglio con devo."), ExampleLine(text = "Puoi comprare un cavo nuovo.", meaning = "La possibilità con potere."), ExampleLine(text = "Prova a spegnere e riaccendere.", meaning = "Il primo consiglio."), ExampleLine(text = "Se non funziona, riavvia.", meaning = "Se + soluzione."))), expressions = listOf(TargetExpression(text = "Cosa faccio ?", meaning = "Chiedere aiuto.", note = "Non funziona: cosa faccio ?"), TargetExpression(text = "devi + infinito", meaning = "Il consiglio forte.", note = "Devi chiamare il tecnico."), TargetExpression(text = "puoi + infinito", meaning = "La possibilità.", note = "Puoi comprare un cavo nuovo."), TargetExpression(text = "prova a + infinito", meaning = "Il consiglio morbido.", note = "Prova a riavviare."), TargetExpression(text = "se… , …", meaning = "Problema e soluzione insieme.", note = "Se è rotto, lo cambi.")), situation = "Il telefono di un amico non funziona: vi fate domande, provate soluzioni e trovate il rimedio giusto.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedi aiuto: non sai cosa fare.", expected = listOf("Cosa faccio ?", "Cosa devo fare ?"), focus = "cosa faccio", watch = "la domanda del problema."), PracticeQuestion(prompt = "Consiglia a Luca: chiamare il tecnico.", expected = listOf("Devi chiamare il tecnico.", "Luca, devi chiamare il tecnico."), focus = "devi", watch = "devi + infinito."), PracticeQuestion(prompt = "Dì a Anna che può comprare un cavo nuovo.", expected = listOf("Puoi comprare un cavo nuovo.", "Anna, puoi comprare un cavo nuovo."), focus = "puoi", watch = "puoi + infinito."), PracticeQuestion(prompt = "Dai il consiglio classico: provare a riavviare.", expected = listOf("Prova a riavviare.", "Prova a spegnere e riaccendere."), focus = "prova a", watch = "prova a + infinito."), PracticeQuestion(prompt = "Collega problema e soluzione: non funziona → riavvia.", expected = listOf("Se non funziona, riavvia.", "Se non funziona, prova a riavviare."), focus = "se", watch = "se + presente, imperativo."), PracticeQuestion(prompt = "Consiglia di chiedere a un amico.", expected = listOf("Devi chiedere a un amico.", "Puoi chiedere a un amico."), focus = "chiedere a", watch = "chiedere a qualcuno."))), exercises = listOf(Exercise(id = "it-foundations-u20-soluzione-e1", kind = "choice", prompt = "Non funziona: ___ devo fare ?", options = listOf("cosa", "chi", "dove", "quando"), answers = listOf("cosa"), explain = "Chiedere la soluzione: cosa devo fare ?"), Exercise(id = "it-foundations-u20-soluzione-e2", kind = "gap", prompt = "Se è rotto, ___ comprare un cavo nuovo. (tu, potere)", options = listOf(), answers = listOf("puoi"), explain = "puoi + infinito: la possibilità."), Exercise(id = "it-foundations-u20-soluzione-e3", kind = "order", prompt = "Consiglia a Luca: chiamare il tecnico.", options = listOf(), answers = listOf("Devi chiamare il tecnico Luca"), explain = "Devi + infinito: il consiglio."), Exercise(id = "it-foundations-u20-soluzione-e4", kind = "written", prompt = "Dai il consiglio: provare a riavviare il telefono.", options = listOf(), answers = listOf("prova a riavviare il telefono", "prova a riavviarlo", "devi riavviare il telefono"), explain = "prova a / devi + infinito.")), skills = listOf("function:solve-problems", "function:make-requests", "grammar:connectors", "vocab:social-expressions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "it-foundations-u20-reclamo", title = "Un reclamo tranquillo", goal = "Segnalare un problema con educazione e chiedere una soluzione.", intro = LessonIntro(explanation = listOf("Il reclamo gentile comincia con una formula: « Scusi, c’è un problema », « Vorrei segnalare un problema ».", "Poi spieghi il fatto al passato prossimo: « Ho comprato questa macchina, ma non funziona », « Ho ricevuto la fattura sbagliata ».", "Infine chiedi la soluzione: « È possibile cambiare ? », « Che cosa si può fare ? ». E chiudi: « Grazie per la pazienza »."), examples = listOf(ExampleLine(text = "Scusi, c’è un problema.", meaning = "Aprire il reclamo."), ExampleLine(text = "Ho comprato questa macchina, ma non funziona.", meaning = "Il fatto al passato prossimo."), ExampleLine(text = "Ho ricevuto la fattura sbagliata.", meaning = "Segnalare l’errore."), ExampleLine(text = "È possibile cambiare il prodotto ?", meaning = "Chiedere la soluzione."), ExampleLine(text = "Grazie per la pazienza.", meaning = "Chiudere con gentilezza."))), expressions = listOf(TargetExpression(text = "Vorrei segnalare…", meaning = "Aprire il reclamo.", note = "Vorrei segnalare un problema."), TargetExpression(text = "non funziona", meaning = "Il problema adesso.", note = "La stampante non funziona."), TargetExpression(text = "la fattura sbagliata", meaning = "L’errore nei documenti.", note = "Hanno mandato la fattura sbagliata."), TargetExpression(text = "È possibile… ?", meaning = "Chiedere la soluzione.", note = "È possibile cambiare il prodotto ?"), TargetExpression(text = "Grazie per la pazienza", meaning = "Chiudere il reclamo.", note = "Grazie per la pazienza !")), situation = "Al telefono con il negozio: segnalate una fattura sbagliata e una macchina guasta, e chiedete una soluzione.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Apri un reclamo con gentilezza.", expected = listOf("Scusi, c’è un problema.", "Scusi, c’e un problema.", "Vorrei segnalare un problema."), focus = "scusi", watch = "Lei: scusi, gentile."), PracticeQuestion(prompt = "Segnala: la stampante, comprata ieri, non funziona.", expected = listOf("Ho comprato questa stampante ma non funziona.", "Ieri ho comprato una stampante ma non funziona."), focus = "ho comprato", watch = "comprare → comprato."), PracticeQuestion(prompt = "Segnala l’errore: la fattura, sbagliata.", expected = listOf("Ho ricevuto la fattura sbagliata.", "La fattura è sbagliata.", "La fattura e sbagliata."), focus = "ho ricevuto", watch = "ricevere → ricevuto."), PracticeQuestion(prompt = "Chiedi di cambiare il prodotto, con gentilezza.", expected = listOf("È possibile cambiare il prodotto ?", "E possibile cambiare il prodotto ?", "Posso cambiare il prodotto ?"), focus = "è possibile", watch = "è possibile + infinito."), PracticeQuestion(prompt = "Chiedi che cosa si può fare.", expected = listOf("Che cosa si può fare ?", "Che cosa si puo fare ?", "Cosa si può fare ?", "Cosa si puo fare ?"), focus = "si può", watch = "si può = se puede."), PracticeQuestion(prompt = "Chiudi il reclamo ringraziando.", expected = listOf("Grazie per la pazienza.", "Grazie per l’aiuto."), focus = "grazie per", watch = "la chiusura gentile."))), exercises = listOf(Exercise(id = "it-foundations-u20-reclamo-e1", kind = "choice", prompt = "___ segnalare un problema con la fattura.", options = listOf("Vorrei", "Voglio", "Devo", "Faccio"), answers = listOf("Vorrei"), explain = "Vorrei: apertura gentile del reclamo."), Exercise(id = "it-foundations-u20-reclamo-e2", kind = "gap", prompt = "Ho ___ la fattura sbagliata. (ricevere, participio)", options = listOf(), answers = listOf("ricevuto"), explain = "ricevere → ricevuto."), Exercise(id = "it-foundations-u20-reclamo-e3", kind = "order", prompt = "Chiedi di cambiare il prodotto, con gentilezza.", options = listOf(), answers = listOf("È possibile cambiare il prodotto"), explain = "È possibile + infinito: la richiesta gentile."), Exercise(id = "it-foundations-u20-reclamo-e4", kind = "written", prompt = "Chiudi il reclamo con un ringraziamento.", options = listOf(), answers = listOf("grazie per la pazienza", "grazie mille per la pazienza", "grazie per l’aiuto"), explain = "Grazie per + cosa: la chiusura gentile.")), skills = listOf("function:solve-problems", "grammar:present-questions", "vocab:social-expressions", "grammar:connectors"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors"))))
}

object ItFoundationsU24 {
    val unit = CourseUnit(id = "it-foundations-u24", title = "Grandi acquisti", subtitle = "Confrontare e decidere", level = "A2", themes = listOf(ConversationTheme("il-confronto", "Quale conviene ?", "Più o meno", "cart", "Course", "Due telefoni, due prezzi: confrontate peso, prezzo e qualità e scegliete quello che conviene.", 0),
                ConversationTheme("dopo-l-acquisto", "Dopo l’acquisto", "Restituire e rate", "creditcard", "Course", "L’acquisto non convince: si restituisce con lo scontrino oppure si paga a rate, con calma.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u24-confrontare", title = "Quale conviene ?", goal = "Confrontare due prodotti con i comparativi e scegliere quello che conviene.", intro = LessonIntro(explanation = listOf("Il confronto si fa con più (o meno) + aggettivo + di: « Questo telefono è più leggero di quello ».", "Due comparativi sono irregolari: buono → meglio, cattivo → peggio. « Questo funziona meglio dell’altro ».", "Il massimo si dice con il più + aggettivo: « È il più economico dei due ». E la scelta: « Prendo questo, conviene »."), examples = listOf(ExampleLine(text = "Questo modello è più leggero di quello.", meaning = "Il confronto in su."), ExampleLine(text = "È meno costoso dell’altro.", meaning = "Il confronto in giù."), ExampleLine(text = "Questo funziona meglio.", meaning = "Il comparativo irregolare."), ExampleLine(text = "È il più economico dei due.", meaning = "Il massimo."), ExampleLine(text = "Prendo questo, conviene.", meaning = "La decisione."))), expressions = listOf(TargetExpression(text = "più… di…", meaning = "Il confronto in su.", note = "Più veloce di quello."), TargetExpression(text = "meno… di…", meaning = "Il confronto in giù.", note = "Meno caro dell’altro."), TargetExpression(text = "meglio / peggio", meaning = "I comparativi irregolari.", note = "Questo va meglio."), TargetExpression(text = "il più… dei…", meaning = "Il massimo del gruppo.", note = "Il più leggero dei due."), TargetExpression(text = "conviene", meaning = "Vale il prezzo.", note = "Prendo questo, conviene.")), situation = "In negozio confronti due telefoni: peso, prezzo, fotocamera. Alla fine scegli quello che conviene.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Confronta: questo telefono è veloce, quello no.", expected = listOf("Questo telefono è più veloce di quello.", "È più veloce di quello.", "Questo telefono e piu veloce di quello"), focus = "più… di", watch = "più + aggettivo + di."), PracticeQuestion(prompt = "Dì che questo costa meno.", expected = listOf("Questo è meno costoso dell’altro.", "Costa meno dell’altro."), focus = "meno… di", watch = "meno = menos."), PracticeQuestion(prompt = "Dì che questo funziona meglio.", expected = listOf("Questo funziona meglio.", "Questo funziona meglio dell’altro."), focus = "meglio", watch = "buono → meglio (irregolare)."), PracticeQuestion(prompt = "Dì che è il più leggero dei due.", expected = listOf("È il più leggero dei due.", "Questo è il più leggero.", "E il piu leggero dei due"), focus = "il più", watch = "il più + aggettivo: el más."), PracticeQuestion(prompt = "Dì che conviene prendere questo.", expected = listOf("Conviene prendere questo.", "Prendo questo, conviene."), focus = "conviene", watch = "conviene = vale la pena."), PracticeQuestion(prompt = "Chiedi quale dei due è meglio.", expected = listOf("Quale dei due è meglio ?", "Quale è meglio ?", "Quale dei due e meglio"), focus = "quale", watch = "quale dei due = ¿cuál de los dos?"))), exercises = listOf(Exercise(id = "it-foundations-u24-confrontare-e1", kind = "choice", prompt = "Questo modello è ___ economico di quello.", options = listOf("più", "peggio", "molto", "tanto"), answers = listOf("più"), explain = "più + aggettivo + di: il confronto."), Exercise(id = "it-foundations-u24-confrontare-e2", kind = "gap", prompt = "Questo telefono funziona ___ di quello. (buono, comparativo)", options = listOf(), answers = listOf("meglio"), explain = "buono → meglio: comparativo irregolare."), Exercise(id = "it-foundations-u24-confrontare-e3", kind = "order", prompt = "Fai il confronto di prezzo tra i due telefoni.", options = listOf(), answers = listOf("Questo costa meno di quello"), explain = "meno… di: il confronto in giù."), Exercise(id = "it-foundations-u24-confrontare-e4", kind = "written", prompt = "Dì che conviene: prendi questo.", options = listOf(), answers = listOf("conviene prendere questo", "prendo questo conviene", "prendo questo perche conviene", "prendo questo perché conviene"), explain = "conviene + infinito: la scelta pratica.")), skills = listOf("grammar:comparatives", "function:go-shopping", "grammar:superlatives", "vocab:shopping"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:comparatives")),
    Lesson(id = "it-foundations-u24-restituire", title = "Restituire", goal = "Restituire un acquisto che non va bene e chiedere il cambio, raccontando al passato.", intro = LessonIntro(explanation = listOf("La storia si racconta al passato prossimo: « Ho comprato questa giacca due giorni fa », « L’ho usata una volta ».", "Con i verbi regolari il participio finisce in -ato, -uto, -ito: comprato, usato, ricevuto, restituito.", "Al negozio chiedi: « Vorrei restituirla », « Posso cambiarla con una M ? ». Lo scontrino serve: « Ecco lo scontrino »."), examples = listOf(ExampleLine(text = "Ho comprato questa giacca due giorni fa.", meaning = "L’acquisto al passato."), ExampleLine(text = "L’ho usata una volta.", meaning = "Avere + usato."), ExampleLine(text = "Vorrei restituirla.", meaning = "La richiesta."), ExampleLine(text = "Ecco lo scontrino.", meaning = "La prova dell’acquisto."), ExampleLine(text = "Posso cambiarla con una M ?", meaning = "Chiedere il cambio."))), expressions = listOf(TargetExpression(text = "ho comprato", meaning = "L’acquisto raccontato.", note = "Ho comprato un cappotto."), TargetExpression(text = "l’ho usato / usata", meaning = "Il participio di usare.", note = "L’ho usata una volta."), TargetExpression(text = "vorrei restituirla", meaning = "Chiedere il rimborso.", note = "Vorrei restituirla, per favore."), TargetExpression(text = "lo scontrino", meaning = "La prova dello shopping.", note = "Ho lo scontrino qui."), TargetExpression(text = "posso cambiarla ?", meaning = "Chiedere il cambio.", note = "Posso cambiarla con la taglia M ?")), situation = "La giacca comprata due giorni fa è piccola: torni in negozio con lo scontrino, racconti e chiedi il cambio.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Racconta: hai comprato la giacca due giorni fa.", expected = listOf("Ho comprato la giacca due giorni fa.", "La giacca l’ho comprata due giorni fa."), focus = "ho comprato", watch = "due giorni fa + passato prossimo."), PracticeQuestion(prompt = "Dì che l’hai usata una volta.", expected = listOf("L’ho usata una volta.", "L’ho usata solo una volta."), focus = "usata", watch = "usare → usato; con la giacca: usata."), PracticeQuestion(prompt = "Chiedi di restituirla.", expected = listOf("Vorrei restituirla.", "Voglio restituirla, per favore."), focus = "restituire", watch = "restituire = devolver."), PracticeQuestion(prompt = "Dì che hai lo scontrino.", expected = listOf("Ecco lo scontrino.", "Ho lo scontrino."), focus = "scontrino", watch = "scontrino = ticket de compra."), PracticeQuestion(prompt = "Chiedi il cambio con la taglia M.", expected = listOf("Posso cambiarla con una M ?", "Posso cambiarla con la taglia M ?"), focus = "cambiarla", watch = "cambiare = cambiar."), PracticeQuestion(prompt = "Prima dì il problema: la giacca è piccola.", expected = listOf("È piccola.", "È piccola, non va bene.", "E piccola"), focus = "il problema", watch = "prima il problema, poi la richiesta."))), exercises = listOf(Exercise(id = "it-foundations-u24-restituire-e1", kind = "choice", prompt = "Due giorni fa ___ questa giacca.", options = listOf("ho comprato", "compro", "compravo", "sono comprato"), answers = listOf("ho comprato"), explain = "Due giorni fa + passato prossimo: ho comprato."), Exercise(id = "it-foundations-u24-restituire-e2", kind = "gap", prompt = "L’___ una volta sola. (usare, participio)", options = listOf(), answers = listOf("usata"), explain = "usare → usato; giacca femminile: usata."), Exercise(id = "it-foundations-u24-restituire-e3", kind = "order", prompt = "Chiedi di restituire la giacca, con gentilezza.", options = listOf(), answers = listOf("Vorrei restituirla per favore"), explain = "Vorrei + infinito: la richiesta gentile."), Exercise(id = "it-foundations-u24-restituire-e4", kind = "written", prompt = "Chiedi il cambio con la taglia M.", options = listOf(), answers = listOf("posso cambiarla con la m", "posso cambiarla con la taglia m", "posso cambiarla con una m"), explain = "Posso cambiarla + con: il cambio.")), skills = listOf("function:solve-problems", "grammar:past-simple-regular", "function:make-requests", "vocab:shopping"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "it-foundations-u24-rate", title = "Pagare a rate", goal = "Parlare di come pagare un acquisto grande, con i connettivi però, quindi e allora.", intro = LessonIntro(explanation = listOf("I prezzi grandi si pagano a rate: « Posso pagare a rate ? », « Cinquanta euro al mese ».", "I connettivi tengono insieme le frasi: « Costa molto, però conviene », « Non ho i contanti, quindi pago con la carta ».", "La decisione si apre con allora: « Allora lo prendo a rate ». E il fatto che conferma: « Infatti è in saldo »."), examples = listOf(ExampleLine(text = "Posso pagare a rate ?", meaning = "Chiedere la possibilità."), ExampleLine(text = "Cinquanta euro al mese, per dodici mesi.", meaning = "La rata."), ExampleLine(text = "Costa molto, però conviene.", meaning = "però: la contraddizione."), ExampleLine(text = "Non ho la carta, quindi pago in contanti.", meaning = "quindi: la conseguenza."), ExampleLine(text = "Allora lo prendo.", meaning = "allora: la decisione."))), expressions = listOf(TargetExpression(text = "pagare a rate", meaning = "Pagare in pezzetti mensili.", note = "Lo pago in tre rate."), TargetExpression(text = "al mese", meaning = "La frequenza della rata.", note = "Cinquanta euro al mese."), TargetExpression(text = "però", meaning = "La contraddizione gentile.", note = "Costa poco, però è lento."), TargetExpression(text = "quindi", meaning = "La conseguenza.", note = "È in saldo, quindi lo prendo."), TargetExpression(text = "allora", meaning = "La decisione finale.", note = "Allora lo prendo io.")), situation = "Vuoi una bici elettrica che costa tanto: chiedi le rate, pesi pro e contro con però e quindi, e decidi con allora.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedi se puoi pagare a rate.", expected = listOf("Posso pagare a rate ?", "Si può pagare a rate ?"), focus = "a rate", watch = "a rate = en cuotas."), PracticeQuestion(prompt = "Dì la rata: cinquanta euro al mese.", expected = listOf("Cinquanta euro al mese.", "Sono cinquanta euro al mese."), focus = "al mese", watch = "al mese = al mes."), PracticeQuestion(prompt = "Dì un pro e un contro con però.", expected = listOf("È costoso, però è buona.", "Costa molto, però conviene.", "E costoso pero e buona"), focus = "però", watch = "però = pero (contraste)."), PracticeQuestion(prompt = "Collega causa ed effetto con quindi.", expected = listOf("È in saldo, quindi lo prendo.", "Conviene, quindi lo compro."), focus = "quindi", watch = "quindi = así que."), PracticeQuestion(prompt = "Prendi la decisione con allora.", expected = listOf("Allora lo prendo.", "Allora lo prendo a rate."), focus = "allora", watch = "allora = entonces."), PracticeQuestion(prompt = "Chiedi se si può pagare con la carta.", expected = listOf("Posso pagare con la carta ?", "Si può pagare con la carta ?"), focus = "la carta", watch = "con la carta = con tarjeta."))), exercises = listOf(Exercise(id = "it-foundations-u24-rate-e1", kind = "choice", prompt = "Non ho i contanti, ___ pago con la carta.", options = listOf("quindi", "però", "anche", "cioè"), answers = listOf("quindi"), explain = "quindi: la conseguenza logica."), Exercise(id = "it-foundations-u24-rate-e2", kind = "gap", prompt = "Costa poco, ___ è lento. (contrasto)", options = listOf(), answers = listOf("però", "pero"), explain = "però: la contrapposizione."), Exercise(id = "it-foundations-u24-rate-e3", kind = "order", prompt = "Chiedi se puoi pagare a rate.", options = listOf(), answers = listOf("Posso pagare a rate"), explain = "Potere + pagare a rate."), Exercise(id = "it-foundations-u24-rate-e4", kind = "written", prompt = "Dì la tua decisione con allora: prendi la bici.", options = listOf(), answers = listOf("allora prendo la bici", "allora la prendo", "allora prendo la bici a rate"), explain = "allora + la decisione.")), skills = listOf("function:go-shopping", "grammar:connectors", "vocab:shopping", "vocab:social-expressions"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:connectors"))))
}

object ItFoundationsU25 {
    val unit = CourseUnit(id = "it-foundations-u25", title = "Prepara il viaggio", subtitle = "Valigia e biglietti", level = "A2", themes = listOf(ConversationTheme("valigia-e-documenti", "Valigia e documenti", "Non dimenticare…", "suitcase", "Course", "Il viaggio è deciso: si controllano i documenti, si fa la lista e si chiude la valigia.", 0),
                ConversationTheme("prenotare-e-partire", "Si parte", "Biglietti e vigilia", "airplane", "Course", "Si prenota il volo, si scelgono i posti e la vigilia si controlla tutto un’ultima volta.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u25-valigia", title = "Valigia e documenti", goal = "Preparare la valigia e controllare i documenti con i piani per il futuro.", intro = LessonIntro(explanation = listOf("I piani già decisi si dicono al presente: « Sabato parto per Lisbona ». È il futuro dell’organizzato.", "Per l’azione imminente: sto per + infinito. « Sto per chiudere la valigia ». Per il progetto: « Domani vado a comprare l’adattatore ».", "Prima si controlla: passaporto, biglietto, assicurazione. « Ho già i biglietti, mi manca solo il passaporto »."), examples = listOf(ExampleLine(text = "Sabato parto per Lisbona.", meaning = "Il presente per i piani."), ExampleLine(text = "Sto per chiudere la valigia.", meaning = "Il futuro immediato."), ExampleLine(text = "Mi manca solo il caricatore.", meaning = "Quello che non c’è ancora."), ExampleLine(text = "Ho già preparato i documenti.", meaning = "Già: fatto."), ExampleLine(text = "Prima i documenti, poi i vestiti.", meaning = "L’ordine con prima… poi."))), expressions = listOf(TargetExpression(text = "parto / partiamo", meaning = "Il futuro già deciso.", note = "Partiamo venerdì sera."), TargetExpression(text = "sto per + infinito", meaning = "Sta succedendo adesso.", note = "Sto per finire la valigia."), TargetExpression(text = "mi manca…", meaning = "Non c’è ancora.", note = "Mi manca solo il passaporto."), TargetExpression(text = "già / non ancora", meaning = "Fatto / da fare.", note = "Ho già il biglietto."), TargetExpression(text = "non dimenticare…", meaning = "Il promemoria.", note = "Non dimenticare l’adattatore.")), situation = "Tra due giorni parti: controlli i documenti, fai la lista della valigia e chiudi tutto prima di dormire.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dì il tuo piano: sabato parti per Lisbona.", expected = listOf("Sabato parto per Lisbona.", "Parto sabato per Lisbona."), focus = "presente per il futuro", watch = "i piani certi si dicono al presente."), PracticeQuestion(prompt = "Dì che stai per chiudere la valigia.", expected = listOf("Sto per chiudere la valigia.", "Sto per chiudere la valigia adesso."), focus = "sto per", watch = "sto per + infinito = futuro inmediato."), PracticeQuestion(prompt = "Dì che ti manca solo il caricatore.", expected = listOf("Mi manca solo il caricatore.", "Mi manca il caricatore."), focus = "mancare", watch = "mi manca = me falta."), PracticeQuestion(prompt = "Dì che hai già i biglietti.", expected = listOf("Ho già i biglietti.", "I biglietti li ho già."), focus = "già", watch = "già = ya."), PracticeQuestion(prompt = "Dai il promemoria: l’adattatore.", expected = listOf("Non dimenticare l’adattatore.", "Non dimenticarti l’adattatore."), focus = "non dimenticare", watch = "non dimenticare = no olvides."), PracticeQuestion(prompt = "Dì l’ordine: prima i documenti, poi i vestiti.", expected = listOf("Prima i documenti, poi i vestiti.", "Prima i documenti e poi i vestiti."), focus = "prima… poi", watch = "prima… poi = primero… después."))), exercises = listOf(Exercise(id = "it-foundations-u25-valigia-e1", kind = "choice", prompt = "Il mio volo ___ alle nove.", options = listOf("parte", "parti", "partiamo", "partite"), answers = listOf("parte"), explain = "Il volo (lui) parte: presente per gli orari e i piani."), Exercise(id = "it-foundations-u25-valigia-e2", kind = "gap", prompt = "___ per uscire: chiudo la valigia. (stare per, io)", options = listOf(), answers = listOf("sto"), explain = "sto per + infinito: azione imminente."), Exercise(id = "it-foundations-u25-valigia-e3", kind = "order", prompt = "Dì l’ordine: documenti prima, vestiti dopo.", options = listOf(), answers = listOf("Prima i documenti poi i vestiti"), explain = "prima… poi: l’ordine delle cose."), Exercise(id = "it-foundations-u25-valigia-e4", kind = "written", prompt = "Dì cosa ti manca: solo il passaporto.", options = listOf(), answers = listOf("mi manca solo il passaporto", "mi manca il passaporto", "mi manca solo passaporto"), explain = "mi manca + la cosa che non c’è.")), skills = listOf("grammar:going-to", "vocab:travel", "function:make-future-plans", "grammar:connectors"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "it-foundations-u25-prenotare", title = "Prenotare", goal = "Prenotare un volo al telefono e chiedere orari e posti con gentilezza.", intro = LessonIntro(explanation = listOf("La richiesta gentile al telefono: vorrei + infinito. « Vorrei prenotare un volo per Barcellona ».", "Le domande utili: « A che ora parte il volo ? », « C’è un volo diretto ? », « Quanto dura ? ».", "Le scelte: « Prendo il posto finestrino », « Un’andata e ritorno ». E la conferma: « Può confermarmi la prenotazione ? »."), examples = listOf(ExampleLine(text = "Vorrei prenotare un volo per Barcellona.", meaning = "La richiesta gentile."), ExampleLine(text = "A che ora parte il volo ?", meaning = "Chiedere l’orario."), ExampleLine(text = "C’è un volo diretto ?", meaning = "Senza scali."), ExampleLine(text = "Prendo il posto finestrino.", meaning = "La scelta del posto."), ExampleLine(text = "Può confermarmi la prenotazione ?", meaning = "Chiedere la conferma."))), expressions = listOf(TargetExpression(text = "vorrei + infinito", meaning = "La richiesta al Lei.", note = "Vorrei due biglietti."), TargetExpression(text = "volo diretto", meaning = "Senza scalo.", note = "C’è un volo diretto ?"), TargetExpression(text = "finestrino / corridoio", meaning = "I due posti in aereo.", note = "Il finestrino, per favore."), TargetExpression(text = "andata e ritorno", meaning = "Il biglietto doppio.", note = "Un’andata e ritorno, per favore."), TargetExpression(text = "può confermarmi… ?", meaning = "Chiedere la conferma.", note = "Può confermarmi l’orario ?")), situation = "Chiami la compagnia: prenoti il volo per Barcellona, chiedi orari e posti e ottieni la conferma per email.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Prenota gentilmente un volo per Barcellona.", expected = listOf("Vorrei prenotare un volo per Barcellona.", "Vorrei prenotare un volo."), focus = "vorrei", watch = "vorrei + infinito: con Lei, gentile."), PracticeQuestion(prompt = "Chiedi l’orario di partenza.", expected = listOf("A che ora parte il volo ?", "A che ora parte ?"), focus = "a che ora", watch = "a che ora + presente."), PracticeQuestion(prompt = "Chiedi se c’è un volo diretto.", expected = listOf("C’è un volo diretto ?", "C’è un volo diretto per Barcellona ?", "Ce un volo diretto"), focus = "diretto", watch = "diretto = sin escalas."), PracticeQuestion(prompt = "Scegli il posto: finestrino.", expected = listOf("Prendo il posto finestrino.", "Il finestrino, per favore.", "Vorrei il posto finestrino."), focus = "finestrino", watch = "finestrino = ventanilla."), PracticeQuestion(prompt = "Chiedi un biglietto di andata e ritorno.", expected = listOf("Vorrei un’andata e ritorno.", "Un’andata e ritorno, per favore."), focus = "andata e ritorno", watch = "andata e ritorno = ida y vuelta."), PracticeQuestion(prompt = "Chiedi la conferma della prenotazione.", expected = listOf("Può confermarmi la prenotazione ?", "Mi può confermare la prenotazione ?"), focus = "può confermarmi", watch = "può + infinito: la richiesta al Lei."))), exercises = listOf(Exercise(id = "it-foundations-u25-prenotare-e1", kind = "choice", prompt = "Buongiorno, ___ prenotare un volo per Roma.", options = listOf("vorrei", "sono", "sto", "faccio"), answers = listOf("vorrei"), explain = "Buongiorno + vorrei: la formula gentile del telefono."), Exercise(id = "it-foundations-u25-prenotare-e2", kind = "gap", prompt = "Il posto al ___ è il mio preferito. (vicino alla finestra)", options = listOf(), answers = listOf("finestrino"), explain = "Il posto finestrino, vicino alla finestra."), Exercise(id = "it-foundations-u25-prenotare-e3", kind = "order", prompt = "Chiedi gentilmente un posto finestrino.", options = listOf(), answers = listOf("Vorrei il posto finestrino per favore"), explain = "vorrei + il posto + per favore."), Exercise(id = "it-foundations-u25-prenotare-e4", kind = "written", prompt = "Chiedi al commesso di confermarti l’orario.", options = listOf(), answers = listOf("può confermarmi l’orario", "puo confermarmi l’orario", "mi può confermare l’orario", "mi puo confermare l orario"), explain = "può confermarmi + la cosa: la richiesta al Lei.")), skills = listOf("function:make-requests", "vocab:travel", "grammar:going-to", "vocab:transport"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "it-foundations-u25-vigilia", title = "La vigilia", goal = "Organizzare la vigilia della partenza con i connettivi, i mezzi e gli orari.", intro = LessonIntro(explanation = listOf("La vigilia si organizza in ordine: « Prima faccio la valigia, poi controllo i documenti ».", "I mezzi e gli orari: « Il volo parte alle nove », « Prendo il treno per l’aeroporto ». E il margine: « Due ore prima ».", "La conseguenza si collega con quindi: « Tutto è pronto, quindi stasera vado a letto presto »."), examples = listOf(ExampleLine(text = "Prima faccio la valigia, poi controllo i documenti.", meaning = "L’ordine della vigilia."), ExampleLine(text = "Il volo parte alle nove.", meaning = "L’orario del volo."), ExampleLine(text = "Prendo il treno per l’aeroporto.", meaning = "Il mezzo per arrivare."), ExampleLine(text = "Devo essere lì due ore prima.", meaning = "Il margine di sicurezza."), ExampleLine(text = "Quindi stasera vado a letto presto.", meaning = "La conseguenza."))), expressions = listOf(TargetExpression(text = "prima… poi…", meaning = "L’ordine delle azioni.", note = "Prima pranzo, poi parto."), TargetExpression(text = "fare il check-in", meaning = "Il registro del volo.", note = "Faccio il check-in online."), TargetExpression(text = "prendere il treno / l’autobus", meaning = "Il mezzo che si prende.", note = "Prendo l’autobus numero otto."), TargetExpression(text = "due ore prima", meaning = "Il margine al volo.", note = "Arrivo due ore prima."), TargetExpression(text = "quindi", meaning = "La conseguenza logica.", note = "È tutto pronto, quindi dormo tranquilla.")), situation = "È la vigilia: fai la valigia, il check-in online, controlli come arrivare all’aeroporto e vai a letto presto.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dì l’ordine: prima la valigia, poi i documenti.", expected = listOf("Prima faccio la valigia, poi controllo i documenti.", "Prima la valigia, poi i documenti."), focus = "prima… poi", watch = "prima… poi = primero… luego."), PracticeQuestion(prompt = "Dì l’orario del volo: alle nove.", expected = listOf("Il volo parte alle nove.", "Parte alle nove.", "Il volo parte alle 9"), focus = "parte alle", watch = "parte alle + ora."), PracticeQuestion(prompt = "Dì il mezzo: prendi il treno per l’aeroporto.", expected = listOf("Prendo il treno per l’aeroporto.", "Domani prendo il treno per l’aeroporto."), focus = "prendo il treno", watch = "prendere il treno = coger el tren."), PracticeQuestion(prompt = "Dì a che ora devi essere all’aeroporto: due ore prima.", expected = listOf("Devo essere all’aeroporto due ore prima.", "Devo arrivare due ore prima."), focus = "due ore prima", watch = "devo + infinito: la necesidad."), PracticeQuestion(prompt = "Fai il check-in online stanotte.", expected = listOf("Stasera faccio il check-in online.", "Faccio il check-in online."), focus = "check-in", watch = "fare il check-in = facturar."), PracticeQuestion(prompt = "Collega con quindi: tutto pronto, vai a letto.", expected = listOf("Tutto è pronto, quindi vado a letto presto.", "La valigia è pronta, quindi dormo tranquilla."), focus = "quindi", watch = "quindi = así que."))), exercises = listOf(Exercise(id = "it-foundations-u25-vigilia-e1", kind = "choice", prompt = "Prima faccio il check-in, ___ vado a letto.", options = listOf("poi", "prima", "pero", "anzi"), answers = listOf("poi"), explain = "prima… poi: la coppia dell’ordine."), Exercise(id = "it-foundations-u25-vigilia-e2", kind = "gap", prompt = "Il volo ___ alle nove e dieci. (partire)", options = listOf(), answers = listOf("parte"), explain = "Il volo (lui) parte."), Exercise(id = "it-foundations-u25-vigilia-e3", kind = "order", prompt = "Dì l’orario del volo: nove.", options = listOf(), answers = listOf("Il volo parte alle nove"), explain = "Il volo + parte alle + ora."), Exercise(id = "it-foundations-u25-vigilia-e4", kind = "written", prompt = "Dì che devi arrivare due ore prima.", options = listOf(), answers = listOf("devo arrivare due ore prima", "devo essere la due ore prima", "devo essere li due ore prima"), explain = "devo + infinito + due ore prima.")), skills = listOf("grammar:connectors", "vocab:transport", "function:make-future-plans", "vocab:travel"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "it-foundations-u25-aeroporto", title = "All'aeroporto", goal = "Muoversi all'aeroporto: leggere gli annunci, trovare il gate e reagire a un volo in ritardo.", intro = LessonIntro(explanation = listOf("L'aeroporto ha le sue parole: il check-in, il gate, l'imbarco. « Il gate chiude alle nove e mezza ».", "Negli annunci si sente il presente: « Il volo imbarca al gate quindici ». Il volo fa le azioni, non tu.", "Per il problema classico: « Il volo è in ritardo di quaranta minuti ». E la soluzione si chiede con devo: « Devo cambiare il biglietto? »."), examples = listOf(ExampleLine(text = "Dov'è il check-in?", meaning = "Il primo punto."), ExampleLine(text = "Il gate chiude alle nove e mezza.", meaning = "L'ora limite."), ExampleLine(text = "Il volo imbarca al gate quindici.", meaning = "L'annuncio tipico."), ExampleLine(text = "Il volo è in ritardo di quaranta minuti.", meaning = "Il problema classico."), ExampleLine(text = "Devo cambiare il biglietto?", meaning = "La soluzione chiesta."))), expressions = listOf(TargetExpression(text = "il gate / l'imbarco", meaning = "Le parole dell'aeroporto.", note = "Il gate chiude presto."), TargetExpression(text = "il volo è in ritardo", meaning = "Il problema.", note = "Il volo è in ritardo di un'ora."), TargetExpression(text = "un ritardo di + tempo", meaning = "Quanto aspetti.", note = "Un ritardo di trenta minuti."), TargetExpression(text = "dovere essere a…", meaning = "L'obbligo del posto.", note = "Devo essere al gate alle nove."), TargetExpression(text = "cambiare il biglietto", meaning = "La soluzione.", note = "Devo cambiare il biglietto?")), situation = "Sei all'aeroporto: trovi il check-in, ascolti gli annunci, scopri che il volo è in ritardo e chiedi che cosa fare.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedi dov'è il check-in.", expected = listOf("Dov'è il check-in?", "Dov'è il check in?", "Dove è il check-in?"), focus = "dov'è", watch = "dov'è = dove + è, con l'apostrofo."), PracticeQuestion(prompt = "Dì che il tuo volo ha quaranta minuti di ritardo.", expected = listOf("Il volo è in ritardo di quaranta minuti.", "Il volo ha quaranta minuti di ritardo."), focus = "in ritardo di", watch = "in ritardo di + tempo."), PracticeQuestion(prompt = "Dì l'obbligo: dovete essere al gate alle nove.", expected = listOf("Dovete essere al gate alle nove.", "Dovete essere al gate alle 9"), focus = "dovere essere a", watch = "dovere + essere al posto: l'obbligo del posto."), PracticeQuestion(prompt = "Chiedi se devi cambiare il biglietto.", expected = listOf("Devo cambiare il biglietto?", "Devo cambiare il biglietto"), focus = "devo", watch = "devo + infinito: chiedo la soluzione."), PracticeQuestion(prompt = "Dì l'ora limite: il gate, nove e mezza.", expected = listOf("Il gate chiude alle nove e mezza.", "Il gate chiude alle 9 e 30"), focus = "chiudere", watch = "il gate chiude: il presente degli annunci."))), exercises = listOf(Exercise(id = "it-foundations-u25-aeroporto-e1", kind = "choice", prompt = "Il volo ___ al gate quindici.", options = listOf("imbarca", "imbarchi", "imbarco", "imbarcate"), answers = listOf("imbarca"), explain = "Il volo (lui) imbarca: il presente degli annunci ufficiali."), Exercise(id = "it-foundations-u25-aeroporto-e2", kind = "gap", prompt = "Il volo è in ___ di trenta minuti.", options = listOf(), answers = listOf("ritardo"), explain = "il ritardo di + tempo: la durata dell'attesa."), Exercise(id = "it-foundations-u25-aeroporto-e3", kind = "order", prompt = "Dì l'obbligo del gate: appuntamento alle nove.", options = listOf(), answers = listOf("Dovete essere al gate alle nove"), explain = "dovete + essere a + il posto + l'ora: l'obbligo annunciato."), Exercise(id = "it-foundations-u25-aeroporto-e4", kind = "written", prompt = "Dì l'ora di chiusura del gate (9:30).", options = listOf(), answers = listOf("il gate chiude alle nove e mezza", "il gate chiude alle 9 e 30", "chiude alle nove e mezza"), explain = "il gate chiude alle + l'ora: l'informazione che conta.")), skills = listOf("vocab:travel", "grammar:modal-must-have-to", "function:solve-problems", "grammar:time-expressions"), canDo = listOf("use-transport"), prerequisites = listOf("vocab:travel", "grammar:modal-must-have-to"))))
}

object ItFoundationsU28 {
    val unit = CourseUnit(id = "it-foundations-u28", title = "Il trasloco", subtitle = "Scatole e nuova casa", level = "A2", themes = listOf(ConversationTheme("u28-scatole-e-ordine", "Scatole e ordine", "Imballare casa", "house", "Course", "Il trasloco è deciso: si imballano le scatole, si fa la lista di che cosa portare e si organizza il furgone.", 0),
                ConversationTheme("u28-aiuto-e-arrivo", "Aiuto e arrivo", "Vicini e prima notte", "handshake", "Course", "Chiedi aiuto ai vicini, arrivi nella casa nuova e sistemi la prima notte tra scatole e lampade.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u28-scatole", title = "Scatole e ordine", goal = "Dire che cosa devi fare durante il trasloco con devo, devi e bisogna.", intro = LessonIntro(explanation = listOf("Per gli obblighi c'è devo + infinito: « Devo imballare i libri ». Devo, devi, deve funziona come un interruttore: obbligo acceso.", "La regola generale è bisogna + infinito, senza soggetto: « Bisogna comprare le scatole ». Non dice chi fa l'azione.", "Per dire che qualcosa non è necessario: « Non devo portare i mobili ». Non devo spegne l'interruttore."), examples = listOf(ExampleLine(text = "Devo imballare la cucina.", meaning = "L'obbligo al io."), ExampleLine(text = "Devi chiudere le scatole col nastro.", meaning = "L'obbligo al tu."), ExampleLine(text = "Bisogna comprare più scatole.", meaning = "La regola impersonale."), ExampleLine(text = "Non devo fare i pacchi dei vestiti.", meaning = "Non è necessario."), ExampleLine(text = "Devo chiamare il furgone per le nove.", meaning = "Obbligo con l'ora."))), expressions = listOf(TargetExpression(text = "devo + infinito", meaning = "L'obbligo al io.", note = "Devo preparare le scatole."), TargetExpression(text = "devi + infinito", meaning = "L'obbligo al tu.", note = "Devi portare giù le biciclette?"), TargetExpression(text = "bisogna + infinito", meaning = "Serve in generale.", note = "Bisogna prenotare il furgone."), TargetExpression(text = "non devo…", meaning = "Nessun obbligo.", note = "Non devo portare il divano."), TargetExpression(text = "mi servono…", meaning = "La quantità necessaria.", note = "Mi servono dieci scatole grandi.")), situation = "Sabato traslochi: fai la lista delle cose da fare, dai ordini a Marco con devi e spieghi che cosa non serve fare.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dì il tuo obbligo: imballi la cucina.", expected = listOf("Devo imballare la cucina.", "Devo imballare la cucina"), focus = "devo", watch = "devo + infinito: l'obbligo al io."), PracticeQuestion(prompt = "Dai l'ordine a Marco: chiudere le scatole col nastro.", expected = listOf("Devi chiudere le scatole col nastro.", "Tu devi chiudere le scatole col nastro."), focus = "devi", watch = "devi + infinito: l'obbligo al tu."), PracticeQuestion(prompt = "Dì la regola generale: comprare le scatole.", expected = listOf("Bisogna comprare le scatole.", "Bisogna comprare le scatole"), focus = "bisogna", watch = "bisogna + infinito: senza soggetto."), PracticeQuestion(prompt = "Dì che non è necessario: i mobili non li porti tu.", expected = listOf("Non devo portare i mobili.", "Non devo portare io i mobili"), focus = "non devo", watch = "non devo = non è necessario."), PracticeQuestion(prompt = "Dì quante scatole ti servono: dieci grandi.", expected = listOf("Mi servono dieci scatole grandi.", "Mi servono 10 scatole grandi"), focus = "mi servono", watch = "mi servono + plurale: la quantità."), PracticeQuestion(prompt = "Dì il tuo obbligo con l'ora: chiamare il furgone per le nove.", expected = listOf("Devo chiamare il furgone per le nove.", "Devo chiamare il furgone alle nove."), focus = "devo + ora", watch = "per le nove = entro le nove."))), exercises = listOf(Exercise(id = "it-foundations-u28-scatole-e1", kind = "choice", prompt = "Io ___ imballare tutta la cucina sabato.", options = listOf("devo", "devi", "deve", "bisogno"), answers = listOf("devo"), explain = "Io devo + infinito: l'obbligo alla prima persona."), Exercise(id = "it-foundations-u28-scatole-e2", kind = "gap", prompt = "___ comprare il nastro adesivo: è la regola del trasloco.", options = listOf(), answers = listOf("Bisogna", "bisogna"), explain = "bisogna + infinito: l'obbligo impersonale, non dice chi fa."), Exercise(id = "it-foundations-u28-scatole-e3", kind = "order", prompt = "Dai l'ordine a Marco: le biciclette devono scendere.", options = listOf(), answers = listOf("Devi portare giù le biciclette"), explain = "devi + infinito: l'obbligo al tu, con portare giù."), Exercise(id = "it-foundations-u28-scatole-e4", kind = "written", prompt = "Dì che non è necessario: il divano resta qui.", options = listOf(), answers = listOf("non devo portare il divano", "non devo portare io il divano", "non e necessario portare il divano", "non è necessario portare il divano"), explain = "non devo + infinito: l'obbligo assente.")), skills = listOf("grammar:modal-must-have-to", "vocab:home", "function:solve-problems", "grammar:quantities"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:modal-must-have-to", "vocab:home")),
    Lesson(id = "it-foundations-u28-aiuto", title = "Chiedere aiuto", goal = "Chiedere una mano ai vicini con puoi, mi presti e l'imperativo gentile.", intro = LessonIntro(explanation = listOf("La richiesta gentile parte con puoi + infinito: « Puoi darmi una mano sabato? ». È una domanda, non un ordine.", "Per gli oggetti si chiede mi presti + la cosa: « Mi presti il furgone? ». È il tu gentile dei vicini.", "L'imperativo informale serve per le istruzioni: « Prendi quella scatola ». Il negativo al tu è non + infinito: « Non preoccuparti »."), examples = listOf(ExampleLine(text = "Puoi darmi una mano sabato?", meaning = "La richiesta con puoi."), ExampleLine(text = "Mi presti il furgone?", meaning = "L'oggetto prestato."), ExampleLine(text = "Prendi quella scatola, per favore.", meaning = "L'istruzione al tu."), ExampleLine(text = "Non preoccuparti, ci sto io.", meaning = "Il tu negativo."), ExampleLine(text = "Grazie mille, sei gentilissimo!", meaning = "Il ringraziamento forte."))), expressions = listOf(TargetExpression(text = "puoi… ?", meaning = "La richiesta gentile.", note = "Puoi aiutarmi sabato?"), TargetExpression(text = "mi presti… ?", meaning = "Chiedo l'oggetto.", note = "Mi presti il carrello?"), TargetExpression(text = "darmi una mano", meaning = "Aiutarmi.", note = "Puoi darmi una mano?"), TargetExpression(text = "non preoccuparti", meaning = "Il tu negativo.", note = "Non preoccuparti, va tutto bene."), TargetExpression(text = "sei gentilissimo!", meaning = "Il ringraziamento forte.", note = "Grazie mille, sei gentilissimo!")), situation = "Chiedi a Giulia di darti una mano, le chiedi il furgone e le spieghi che cosa deve prendere, senza dimenticare i ringraziamenti.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedi a Giulia una mano per sabato.", expected = listOf("Puoi darmi una mano sabato?", "Puoi darmi una mano sabato"), focus = "puoi", watch = "puoi + infinito: la richiesta gentile."), PracticeQuestion(prompt = "Chiedi a Giulia il furgone.", expected = listOf("Mi presti il furgone?", "Mi presti il furgone"), focus = "mi presti", watch = "mi presti + la cosa: chiedi un prestito."), PracticeQuestion(prompt = "Dai l'istruzione: quella scatola va al piano di sopra.", expected = listOf("Prendi quella scatola, per favore.", "Prendi quella scatola per favore"), focus = "imperativo", watch = "al tu: prendi, porta, sali."), PracticeQuestion(prompt = "Tranquillizza Giulia al negativo: non serve preoccuparsi.", expected = listOf("Non preoccuparti.", "Non preoccuparti, va tutto bene.", "Non ti preoccupare."), focus = "non preoccuparti", watch = "il tu negativo: non + infinito."), PracticeQuestion(prompt = "Ringrazia Giulia al massimo.", expected = listOf("Grazie mille, sei gentilissima!", "Grazie mille sei gentilissima", "Grazie mille, gentilissima!"), focus = "grazie mille", watch = "gentilissima per una donna, gentilissimo per un uomo."), PracticeQuestion(prompt = "Chiedi a Giulia di aiutarti a salire le scatole.", expected = listOf("Puoi aiutarmi a salire le scatole?", "Mi aiuti a salire le scatole?"), focus = "puoi", watch = "aiutarmi = aiutare + me."))), exercises = listOf(Exercise(id = "it-foundations-u28-aiuto-e1", kind = "choice", prompt = "___ darmi una mano sabato mattina?", options = listOf("Puoi", "Devo", "Sono", "Vado"), answers = listOf("Puoi"), explain = "Puoi + infinito: la richiesta gentile al tu."), Exercise(id = "it-foundations-u28-aiuto-e2", kind = "gap", prompt = "___ il carrello per le scatole pesanti? (prestare, tu)", options = listOf(), answers = listOf("Mi presti", "mi presti"), explain = "mi presti + la cosa: il prestito chiesto con gentilezza."), Exercise(id = "it-foundations-u28-aiuto-e3", kind = "order", prompt = "Istruisci Giulia sui libri: quella scatola deve salire.", options = listOf(), answers = listOf("Prendi la scatola dei libri"), explain = "l'imperativo al tu: prendi, un'istruzione chiara."), Exercise(id = "it-foundations-u28-aiuto-e4", kind = "written", prompt = "Tranquillizza Giulia: nessun obbligo, tutto va bene.", options = listOf(), answers = listOf("non preoccuparti", "non ti preoccupare", "non preoccuparti va tutto bene"), explain = "non + infinito al tu: non preoccuparti, la forma negativa dell'imperativo.")), skills = listOf("grammar:imperatives", "function:make-requests", "grammar:can", "vocab:social-expressions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:imperatives", "grammar:can")),
    Lesson(id = "it-foundations-u28-prima-notte", title = "La prima notte", goal = "Descrivere la casa nuova con c'è e ci sono, e dire che cosa stai sistemando.", intro = LessonIntro(explanation = listOf("Per descrivere: c'è + una cosa, ci sono + molte: « C'è una lampada nuova », « Ci sono ancora scatole ovunque ».", "Il negativo e la domanda: « Non c'è il tavolo », « C'è l'ascensore? ». Sono le due frasi che servono davvero in casa nuova.", "Per l'azione in corso: sto + gerundio: « Sto sistemando i libri ». Lo usi come un blocco: sto facendo, sto sistemando."), examples = listOf(ExampleLine(text = "C'è una lampada nuova in salotto.", meaning = "Una cosa: c'è."), ExampleLine(text = "Ci sono ancora dieci scatole.", meaning = "Molte cose: ci sono."), ExampleLine(text = "Non c'è il divano, arriva venerdì.", meaning = "Il negativo singolare."), ExampleLine(text = "C'è l'ascensore? No, non c'è.", meaning = "La domanda utile."), ExampleLine(text = "Sto sistemando la camera da letto.", meaning = "L'azione adesso."))), expressions = listOf(TargetExpression(text = "c'è + singolare", meaning = "Una cosa esiste.", note = "C'è un balcone grande."), TargetExpression(text = "ci sono + plurale", meaning = "Molte cose esistono.", note = "Ci sono due bagni."), TargetExpression(text = "non c'è / non ci sono", meaning = "La mancanza.", note = "Non ci sono le tende."), TargetExpression(text = "c'è… ?", meaning = "La domanda veloce.", note = "C'è l'ascensore?"), TargetExpression(text = "sto + gerundio", meaning = "L'azione adesso.", note = "Sto sistemando i libri.")), situation = "Prima notte nella casa nuova: spieghi a un amico che cosa c'è, che cosa manca e che cosa stai sistemando adesso.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dì che in salotto c'è una lampada nuova.", expected = listOf("In salotto c'è una lampada nuova.", "C'è una lampada nuova in salotto."), focus = "c'è", watch = "una cosa sola: c'è."), PracticeQuestion(prompt = "Dì che ci sono ancora dieci scatole.", expected = listOf("Ci sono ancora dieci scatole.", "Ci sono ancora 10 scatole."), focus = "ci sono", watch = "più cose: ci sono."), PracticeQuestion(prompt = "Dì che manca il divano, arriva venerdì.", expected = listOf("Non c'è il divano, arriva venerdì.", "Non c'è il divano."), focus = "non c'è", watch = "non c'è + singolare: la mancanza."), PracticeQuestion(prompt = "Chiedi a un amico se c'è l'ascensore.", expected = listOf("C'è l'ascensore?", "C'e l'ascensore?"), focus = "c'è… ?", watch = "c'è si scrive con l'accento."), PracticeQuestion(prompt = "Dì che in questo momento sistemi i libri.", expected = listOf("Sto sistemando i libri.", "Sto sistemando i libri adesso."), focus = "sto + gerundio", watch = "sto + -ando: l'azione in corso."), PracticeQuestion(prompt = "Dì che mancano le tende.", expected = listOf("Non ci sono le tende.", "Mancano le tende."), focus = "non ci sono", watch = "non ci sono + plurale."))), exercises = listOf(Exercise(id = "it-foundations-u28-prima-notte-e1", kind = "choice", prompt = "In cucina ___ un forno nuovo.", options = listOf("c'è", "ci sono", "sono", "hanno"), answers = listOf("c'è"), explain = "Una cosa sola: c'è + singolare."), Exercise(id = "it-foundations-u28-prima-notte-e2", kind = "gap", prompt = "___ ancora tre scatole in corridoio. (plurale)", options = listOf(), answers = listOf("Ci sono", "ci sono"), explain = "Più cose: ci sono + plurale."), Exercise(id = "it-foundations-u28-prima-notte-e3", kind = "order", prompt = "Chiedi all'amico come si sale: senza scale.", options = listOf(), answers = listOf("C'è l'ascensore nel palazzo"), explain = "c'è + la cosa: la domanda per sapere se esiste."), Exercise(id = "it-foundations-u28-prima-notte-e4", kind = "written", prompt = "Dì che in questo momento sistemi la camera da letto.", options = listOf(), answers = listOf("sto sistemando la camera da letto", "sto sistemando la camera", "sto sistemando la camera da letto adesso"), explain = "sto + gerundio: l'azione che sta succedendo adesso.")), skills = listOf("grammar:there-is-are", "vocab:home", "grammar:present-continuous", "function:solve-problems"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:there-is-are", "vocab:home"))))
}

object ItFoundationsU6 {
    val unit = CourseUnit(id = "it-foundations-u6", title = "Esperienze e cambiamenti", subtitle = "Già o mai", level = "B1", themes = listOf(ConversationTheme("it-b1-viaggio", "Il viaggio indimenticabile", "Già visto", "airplane", "Course", "Parlate di viaggi e prime volte: già stato, mai visto, e una storia indimenticabile.", 0),
                ConversationTheme("it-b1-cambio", "Il cambio di vita", "Prima / adesso", "arrow-up-forward", "Course", "Confrontate la vita di prima e di oggi e spiegate cosa è cambiato.", 1)), lessons = listOf(    Lesson(id = "it-b1-experiencias", title = "L'hai mai fatto ?", goal = "Raccontare esperienze con il passato prossimo e già/mai.", intro = LessonIntro(explanation = listOf("L'esperienza: « Sei mai stato a Lisbona ? » — « Sì, ci sono stato l'anno scorso. »", "già = almeno una volta. « Ho già assaggiato quel piatto ». mai = zero volte. « Non ho mai sciato ».", "I participi irregolari tornano: « ho visto », « ho fatto », « sono stato »."), examples = listOf(ExampleLine(text = "Sei mai stato a Lisbona ?", meaning = "Domanda di esperienza."), ExampleLine(text = "Non ho mai sciato.", meaning = "mai = zero volte."), ExampleLine(text = "Ho già assaggiato la paella.", meaning = "già = almeno una volta."), ExampleLine(text = "Era la prima volta.", meaning = "Prima volta."), ExampleLine(text = "Cosa hai fatto laggiù ?", meaning = "Rilanciare."))), expressions = listOf(TargetExpression(text = "Sei mai stato/a … ?", meaning = "Esperienza.", note = "Sei mai stato a Roma ?"), TargetExpression(text = "Non ho mai + participio", meaning = "mai.", note = "Non ho mai visto così."), TargetExpression(text = "visto / fatto / stato", meaning = "Participi chiave.", note = "vedere→visto, fare→fatto."), TargetExpression(text = "la prima volta che…", meaning = "Prima volta.", note = "È la prima volta che…"), TargetExpression(text = "e tu ?", meaning = "Rilanciare.", note = "E tu, sei mai… ?")), situation = "Parlate di viaggi: chi è già stato in aereo, chi non ha mai campeggiato, e una prima volta indimenticabile.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Chiedi se il tuo amico è mai stato a Lisbona.", expected = listOf("Sei mai stato a Lisbona ?", "Sei mai stata a Lisbona ?"), focus = "mai", watch = "Sei mai stato/a ?"), PracticeQuestion(prompt = "Di che non hai mai sciato.", expected = listOf("Non ho mai sciato."), focus = "non… mai", watch = "non + ho + mai + participio."), PracticeQuestion(prompt = "Di che hai già assaggiato la paella.", expected = listOf("Ho già assaggiato la paella."), focus = "già", watch = "Ho già + participio."), PracticeQuestion(prompt = "Di che era la tua prima volta.", expected = listOf("Era la prima volta."), focus = "prima volta", watch = "imperfetto per il quadro."), PracticeQuestion(prompt = "Rilancia: e tu ?", expected = listOf("E tu ?", "E tu, sei mai andato in surf ?"), focus = "e tu", watch = "e tu rilancia."))), exercises = listOf(Exercise(id = "it-b1-experiencias-e1", kind = "choice", prompt = "Sei mai ___ a Roma ?", options = listOf("stato", "stata solo al femminile", "andato con avere", "sii"), answers = listOf("stato"), explain = "andare → essere: sei mai stato/a."), Exercise(id = "it-b1-experiencias-e2", kind = "gap", prompt = "Non ho ___ sciato. (mai)", options = listOf(), answers = listOf("mai"), explain = "non… mai attorno all'ausiliare."), Exercise(id = "it-b1-experiencias-e3", kind = "order", prompt = "Chiedi l'esperienza: hai già mangiato le lumache ?", options = listOf(), answers = listOf("Hai già mangiato le lumache"), explain = "Hai già + participio + oggetto ?"), Exercise(id = "it-b1-experiencias-e4", kind = "written", prompt = "Di un'esperienza: hai già visto questo film.", options = listOf(), answers = listOf("ho gia visto questo film", "ho già visto questo film"), explain = "Ho già + participio.")), skills = listOf("grammar:present-perfect", "grammar:past-simple-irregular", "function:describe-past-events"), canDo = listOf("describe-past-events"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "it-b1-antes-ahora", title = "Prima e adesso", goal = "Contrastare passato e presente con l'imperfetto e i connettivi.", intro = LessonIntro(explanation = listOf("L'imperfetto dipinge il passato abituale: « Prima vivevo in città ».", "Il contrasto: « Prima… adesso… ». « Prima fumavo, adesso corro ».", "I connettivi: « ma », « perché », « quindi ». « Era stancante, quindi mi sono trasferito »."), examples = listOf(ExampleLine(text = "Prima vivevo in città.", meaning = "imperfetto del passato."), ExampleLine(text = "Adesso vivo in campagna.", meaning = "presente in contrasto."), ExampleLine(text = "Prima fumavo, adesso corro.", meaning = "Cambio di vita."), ExampleLine(text = "Era stancante, quindi mi sono trasferito.", meaning = "quindi = conseguenza."), ExampleLine(text = "Preferisco la vita di adesso, perché…", meaning = "perché = causa."))), expressions = listOf(TargetExpression(text = "Prima, …-avo/-evo", meaning = "imperfetto.", note = "vivevo, facevo."), TargetExpression(text = "adesso, …", meaning = "presente.", note = "adesso vivo…"), TargetExpression(text = "ma / quindi / perché", meaning = "Connettivi.", note = "ma = contrasto."), TargetExpression(text = "preferisco …", meaning = "Opinione.", note = "preferisco la vita…"), TargetExpression(text = "Era + aggettivo", meaning = "Quadro al passato.", note = "Era tranquillo.")), situation = "Confrontate la vita di prima e di oggi: città e campagna, lavoro e tempo libero, e perché avete cambiato.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di che prima vivevi in città.", expected = listOf("Prima vivevo in città.", "Prima, vivevo in città."), focus = "imperfetto", watch = "-evo: vivevo."), PracticeQuestion(prompt = "Di che adesso vivi in campagna.", expected = listOf("Adesso vivo in campagna."), focus = "adesso", watch = "presente per adesso."), PracticeQuestion(prompt = "Contrasta: prima fumavi, adesso corri.", expected = listOf("Prima fumavo adesso corro.", "Prima fumavo, adesso corro."), focus = "prima/adesso", watch = "due tempi opposti."), PracticeQuestion(prompt = "Dai la conseguenza: era stancante, quindi ti sei trasferito.", expected = listOf("Era stancante quindi mi sono trasferito.", "Era stancante, quindi mi sono trasferito."), focus = "quindi", watch = "quindi + conseguenza."), PracticeQuestion(prompt = "Di cosa preferisci e perché.", expected = listOf("Preferisco la vita di adesso perché sono più libero.", "Preferisco la vita di adesso."), focus = "perché", watch = "perché + causa."))), exercises = listOf(Exercise(id = "it-b1-antes-ahora-e1", kind = "choice", prompt = "Prima, ___ in città. (vivere, imperfetto)", options = listOf("vivevo", "vivo", "ho vissuto", "viverò"), answers = listOf("vivevo"), explain = "imperfetto: -evo."), Exercise(id = "it-b1-antes-ahora-e2", kind = "gap", prompt = "Era stancante, ___ mi sono trasferito. (conseguenza)", options = listOf(), answers = listOf("quindi"), explain = "quindi = conseguenza."), Exercise(id = "it-b1-antes-ahora-e3", kind = "order", prompt = "Contrasta: prima fumavi, adesso corri.", options = listOf(), answers = listOf("Prima fumavo adesso corro"), explain = "prima + imperfetto, adesso + presente."), Exercise(id = "it-b1-antes-ahora-e4", kind = "written", prompt = "Di cosa è cambiato: adesso lavori da casa.", options = listOf(), answers = listOf("adesso lavoro da casa"), explain = "adesso + presente.")), skills = listOf("grammar:used-to", "grammar:connectors", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:used-to"))))
}

object ItFoundationsU18 {
    val unit = CourseUnit(id = "it-foundations-u18", title = "Raccontare storie", subtitle = "Fatti in fila", level = "B1", themes = listOf(ConversationTheme("fatti-in-ordine", "Quello che è successo", "Prima, poi, alla fine", "book", "Course", "Raccontate una giornata disastrosa: i fatti in ordine, dal treno perso all’arrivo in ritardo.", 0),
                ConversationTheme("la-svolta", "La svolta inaspettata", "All’improvviso…", "sparkles", "Course", "Un aneddoto con un colpo di scena: sorprendete e fatevi sorprendere.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u18-narrare", title = "Quello che è successo", goal = "Collegare i fatti passati con prima, poi, dopo, alla fine.", intro = LessonIntro(explanation = listOf("Per raccontare metti i fatti in fila: « prima » apre, « poi » e « dopo » continuano, « alla fine » chiude. « Prima ho perso il treno, poi ho preso il bus ».", "I fatti vanno al passato prossimo: « ho perso », « abbiamo chiamato », « sono arrivato ».", "Alcuni participi sono irregolari: « ho fatto », « ho letto », « ho bevuto ». « Prima ho bevuto un caffè, poi ho letto il giornale »."), examples = listOf(ExampleLine(text = "Prima ho perso il treno.", meaning = "Il primo fatto."), ExampleLine(text = "Poi ho chiamato Luca.", meaning = "Il secondo fatto."), ExampleLine(text = "Dopo abbiamo preso un taxi.", meaning = "Ancora un fatto."), ExampleLine(text = "Alla fine sono arrivato in ritardo.", meaning = "Il risultato."), ExampleLine(text = "Che disastro !", meaning = "Commento alla storia."))), expressions = listOf(TargetExpression(text = "prima", meaning = "Il primo fatto.", note = "Prima ho mangiato."), TargetExpression(text = "poi / dopo", meaning = "Il fatto successivo.", note = "Poi sono uscito."), TargetExpression(text = "alla fine", meaning = "Il risultato.", note = "Alla fine ho vinto."), TargetExpression(text = "ho perso / ho preso", meaning = "Participi irregolari.", note = "perdere→perso, prendere→preso."), TargetExpression(text = "Che disastro !", meaning = "Reagire alla storia.", note = "Che disastro, il mio giorno !")), situation = "Racconti la tua mattina disastrosa: treno perso, bus preso, taxi e arrivo in ritardo al lavoro.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Inizia la storia: prima, il treno perso.", expected = listOf("Prima ho perso il treno."), focus = "prima", watch = "prima = primer hecho."), PracticeQuestion(prompt = "Continua: poi, la chiamata a Luca.", expected = listOf("Poi ho chiamato Luca."), focus = "poi", watch = "poi = después."), PracticeQuestion(prompt = "Ancora un fatto: dopo, il taxi preso insieme.", expected = listOf("Dopo abbiamo preso un taxi."), focus = "dopo", watch = "dopo = luego."), PracticeQuestion(prompt = "Chiudi: l’arrivo in ritardo.", expected = listOf("Alla fine sono arrivato in ritardo.", "Alla fine sono arrivata in ritardo."), focus = "alla fine", watch = "alla fine ciude la storia."), PracticeQuestion(prompt = "Racconta due fatti: prima il caffè, poi il giornale.", expected = listOf("Prima ho bevuto il caffè, poi ho letto il giornale.", "Prima ho bevuto un caffè e poi ho letto il giornale."), focus = "prima… poi", watch = "due fatti in ordine."), PracticeQuestion(prompt = "Reagisci alla storia di Luca: è un disastro.", expected = listOf("Che disastro !", "Che disastro, Luca !"), focus = "che disastro", watch = "reazione simpatica."))), exercises = listOf(Exercise(id = "it-foundations-u18-narrare-e1", kind = "choice", prompt = "___ ho perso il treno, poi ho preso il bus.", options = listOf("Prima", "Alla fine", "Poi", "Dopo"), answers = listOf("Prima"), explain = "Il primo fatto → prima."), Exercise(id = "it-foundations-u18-narrare-e2", kind = "gap", prompt = "Ho ___ il treno. (perdere, participio)", options = listOf(), answers = listOf("perso"), explain = "perdere → perso."), Exercise(id = "it-foundations-u18-narrare-e3", kind = "order", prompt = "Chiudi la storia: l’arrivo in ritardo.", options = listOf(), answers = listOf("Alla fine sono arrivato in ritardo"), explain = "Alla fine + risultato."), Exercise(id = "it-foundations-u18-narrare-e4", kind = "written", prompt = "Racconta il secondo fatto: dopo, la pizza mangiata.", options = listOf(), answers = listOf("dopo ho mangiato una pizza", "poi ho mangiato una pizza", "dopo ho mangiato pizza"), explain = "dopo/poi + passato prossimo.")), skills = listOf("function:tell-a-story", "grammar:past-simple-irregular", "grammar:connectors", "grammar:past-simple-regular"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "it-foundations-u18-sorpresa", title = "La svolta inaspettata", goal = "Raccontare con sorpresa: all’improvviso, si è scoperto che.", intro = LessonIntro(explanation = listOf("La svolta si annuncia con « all’improvviso »: « Parlavamo tranquilli quando, all’improvviso, è entrato il capo ».", "« Si è scoperto che » rivela il segreto: « Si è scoperto che era il suo compleanno ».", "Le reazioni tengono viva la storia: « Non ci credo ! », « Sul serio ? », « E poi che è successo ? »."), examples = listOf(ExampleLine(text = "Parlavamo quando, all’improvviso, è suonato il telefono.", meaning = "La svolta."), ExampleLine(text = "Si è scoperto che era il suo compleanno.", meaning = "Il segreto rivelato."), ExampleLine(text = "Non ci credo !", meaning = "Reazione forte."), ExampleLine(text = "Sul serio ?", meaning = "Chiedere conferma."), ExampleLine(text = "E poi che è successo ?", meaning = "Rilanciare la storia."))), expressions = listOf(TargetExpression(text = "all’improvviso", meaning = "La svolta, senza preavviso.", note = "All’improvviso è piovuto."), TargetExpression(text = "si è scoperto che…", meaning = "Il segreto rivelato.", note = "Si è scoperto che era lui."), TargetExpression(text = "Non ci credo !", meaning = "Reazione di sorpresa.", note = "Non ci credo, sul serio !"), TargetExpression(text = "sul serio", meaning = "Davvero ?", note = "Sul serio ? Non è possibile !"), TargetExpression(text = "che è successo ?", meaning = "Chiedere il seguito.", note = "E poi che è successo ?")), situation = "Racconti la festa a sorpresa per Elena: una scusa inventata, poi la svolta e la reazione di tutti.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Racconta la scena: parlavate, e poi è entrato il capo.", expected = listOf("Parlavamo quando è entrato il capo.", "Stavamo parlando quando è entrato il capo."), focus = "quando", watch = "il contesto all’imperfetto + il fatto improvviso."), PracticeQuestion(prompt = "Aggiungi la svolta: la pioggia, di colpo.", expected = listOf("All’improvviso è piovuto.", "E all’improvviso è piovuto."), focus = "all’improvviso", watch = "all’improvviso = de repente."), PracticeQuestion(prompt = "Rivela: il compleanno di Elena, scoperto da tutti.", expected = listOf("Si è scoperto che era il suo compleanno."), focus = "si è scoperto", watch = "si è scoperto che + frase."), PracticeQuestion(prompt = "Reagisci con sorpresa forte.", expected = listOf("Non ci credo !", "Ma non ci credo !"), focus = "non ci credo", watch = "reazione di sorpresa."), PracticeQuestion(prompt = "Chiedi conferma, in due parole.", expected = listOf("Sul serio ?", "Davvero ?"), focus = "sul serio", watch = "sul serio = ¿en serio?"), PracticeQuestion(prompt = "Chiedi il seguito della storia.", expected = listOf("E poi che è successo ?", "Che è successo dopo ?"), focus = "che è successo", watch = "chiedere il seguito."))), exercises = listOf(Exercise(id = "it-foundations-u18-sorpresa-e1", kind = "choice", prompt = "Parlavamo quando, ___, è entrato Luca.", options = listOf("all’improvviso", "alla fine", "prima", "per caso"), answers = listOf("all’improvviso"), explain = "La svolta inaspettata → all’improvviso."), Exercise(id = "it-foundations-u18-sorpresa-e2", kind = "gap", prompt = "Si ___ scoperto che il regalo era per Marco. (essere)", options = listOf(), answers = listOf("è", "e"), explain = "si è scoperto che + frase."), Exercise(id = "it-foundations-u18-sorpresa-e3", kind = "order", prompt = "Reagisci con sorpresa e chiedi conferma.", options = listOf(), answers = listOf("Non ci credo sul serio"), explain = "Non ci credo + sul serio."), Exercise(id = "it-foundations-u18-sorpresa-e4", kind = "written", prompt = "Rivela il segreto con la formula che contiene « scoperto »: Luca organizzava la festa.", options = listOf(), answers = listOf("si è scoperto che luca organizzava la festa", "si e scoperto che luca organizzava la festa"), explain = "si è scoperto che + frase al passato.")), skills = listOf("function:tell-a-story", "grammar:connectors", "grammar:past-simple-irregular", "vocab:social-expressions"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-irregular")),
    Lesson(id = "it-foundations-u18-aneddoti", title = "L’aneddoto dell’estate", goal = "Raccontare un aneddoto e reagire a quello di un amico.", intro = LessonIntro(explanation = listOf("L’aneddoto è una storia vera e divertente: apri con tempo e luogo. « Quest’estate, al mare, è successa una cosa incredibile ».", "Chi ascolta reagisce: « Non mi dire ! » chiede di continuare, « E poi ? » chiede il seguito.", "Si chiude con un commento: « Che figura ! », « Meno male che c’era Luca »."), examples = listOf(ExampleLine(text = "Quest’estate, al mare, è successa una cosa incredibile.", meaning = "Aprire l’aneddoto."), ExampleLine(text = "Non mi dire !", meaning = "Reazione: continua !"), ExampleLine(text = "E poi ?", meaning = "Chiedere il seguito."), ExampleLine(text = "Che figura !", meaning = "Reazione simpatica."), ExampleLine(text = "Meno male che c’era Luca.", meaning = "Chiusa con sollievo."))), expressions = listOf(TargetExpression(text = "è successa una cosa incredibile", meaning = "Aprire l’aneddoto.", note = "È successa una cosa incredibile."), TargetExpression(text = "Non mi dire !", meaning = "Sorpresa: continua !", note = "Non mi dire, e poi ?"), TargetExpression(text = "E poi ?", meaning = "Chiedere il seguito.", note = "E poi che hai fatto ?"), TargetExpression(text = "Che figura !", meaning = "Reazione simpatica.", note = "Che figura, quel tuffo !"), TargetExpression(text = "meno male che…", meaning = "Sollievo alla fine.", note = "Meno male che c’era il cellulare.")), situation = "Al bar racconti il tuffo goffo dell’estate; Marco reagisce con sorpresa e poi ti chiede il seguito.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Apri l’aneddoto: quest’estate, al mare, qualcosa d’incredibile.", expected = listOf("Quest’estate al mare è successa una cosa incredibile.", "Quest’estate, al mare, è successa una cosa incredibile."), focus = "è successa", watch = "apri con tempo e luogo."), PracticeQuestion(prompt = "Reagisci alla storia di Marco: continua !", expected = listOf("Non mi dire !", "Non mi dire, continua !"), focus = "non mi dire", watch = "non mi dire = ¡no me digas!"), PracticeQuestion(prompt = "Chiedi il seguito.", expected = listOf("E poi ?", "E poi che hai fatto ?", "E dopo ?"), focus = "e poi", watch = "e poi = ¿y luego?"), PracticeQuestion(prompt = "Reagisci a una figura.", expected = listOf("Che figura !", "Che figura, Marco !"), focus = "che figura", watch = "che figura = qué vergüenza."), PracticeQuestion(prompt = "Chiusa con sollievo: il cellulare c’era.", expected = listOf("Meno male che c’era il cellulare.", "Meno male che avevo il cellulare."), focus = "meno male che", watch = "meno male = menos mal."), PracticeQuestion(prompt = "Racconta il fatto: il tuffo goffo.", expected = listOf("Ho fatto un tuffo goffo.", "Ho fatto un tuffo ridicolo."), focus = "ho fatto", watch = "fare → fatto."))), exercises = listOf(Exercise(id = "it-foundations-u18-aneddoti-e1", kind = "choice", prompt = "« ___ ! Continua, ti prego. »", options = listOf("Non mi dire", "Lo so già", "Taci", "Non raccontare"), answers = listOf("Non mi dire"), explain = "Reazione che chiede di continuare."), Exercise(id = "it-foundations-u18-aneddoti-e2", kind = "gap", prompt = "E ___, che hai fatto ? (dopo)", options = listOf(), answers = listOf("poi"), explain = "E poi ? chiede il seguito."), Exercise(id = "it-foundations-u18-aneddoti-e3", kind = "order", prompt = "Apri l’aneddoto dell’estate: al mare, qualcosa d’incredibile.", options = listOf(), answers = listOf("Quest’estate al mare è successa una cosa incredibile"), explain = "Tempo + luogo + è successa."), Exercise(id = "it-foundations-u18-aneddoti-e4", kind = "written", prompt = "Chiusa con sollievo: il cellulare c’era.", options = listOf(), answers = listOf("meno male che c’era il cellulare", "meno male che c era il cellulare", "meno male che avevo il cellulare"), explain = "meno male che + sollievo.")), skills = listOf("function:tell-a-story", "vocab:social-expressions", "grammar:past-simple-regular", "function:describe-past-events"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-regular"))))
}

object ItFoundationsU21 {
    val unit = CourseUnit(id = "it-foundations-u21", title = "Il lavoro", subtitle = "Esperienza e obiettivi", level = "B1", themes = listOf(ConversationTheme("il-colloquio", "Il colloquio", "La mia esperienza", "briefcase", "Course", "Raccontate esperienza, punti di forza e motivazione in un colloquio.", 0),
                ConversationTheme("clima-e-mete", "In ufficio", "Secondo me…", "bubble.left.and.text.bubble.right", "Course", "Parlate del clima in ufficio, dei colleghi e dei vostri obiettivi di lavoro.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u21-colloquio", title = "Il colloquio", goal = "Parlare di esperienza e punti di forza in un colloquio.", intro = LessonIntro(explanation = listOf("Nel colloquio racconti l’esperienza con il passato prossimo: « Ho lavorato tre anni nel marketing », « Ho gestito un piccolo team ».", "I punti di forza si presentano con semplicità: « Sono una persona organizzata », « Imparo in fretta », « Lavoro bene in gruppo ».", "I connettivi danno ordine al percorso: « Prima ho studiato, poi ho lavorato all’estero, ora cerco una nuova sfida »."), examples = listOf(ExampleLine(text = "Ho lavorato tre anni nel marketing.", meaning = "L’esperienza."), ExampleLine(text = "Ho gestito un team di cinque persone.", meaning = "Una responsabilità."), ExampleLine(text = "Sono una persona organizzata.", meaning = "Un punto di forza."), ExampleLine(text = "Prima ho studiato, poi ho lavorato all’estero.", meaning = "Il percorso in ordine."), ExampleLine(text = "Ora cerco una nuova sfida.", meaning = "Il perché del colloquio."))), expressions = listOf(TargetExpression(text = "Ho lavorato…", meaning = "Raccontare l’esperienza.", note = "Ho lavorato tre anni a Milano."), TargetExpression(text = "ho gestito", meaning = "Avere responsabilità.", note = "Ho gestito un piccolo team."), TargetExpression(text = "sono una persona…", meaning = "Presentare un punto di forza.", note = "Sono una persona affidabile."), TargetExpression(text = "imparo in fretta", meaning = "Il punto di forza classico.", note = "Imparo in fretta."), TargetExpression(text = "una nuova sfida", meaning = "Il motivo del cambio.", note = "Cerco una nuova sfida.")), situation = "Preparate un colloquio: raccontate il percorso, presentate i punti di forza e spiegate perché cercate il cambiamento.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dì la tua esperienza: tre anni nel marketing.", expected = listOf("Ho lavorato tre anni nel marketing.", "Ho lavorato per tre anni nel marketing."), focus = "ho lavorato", watch = "lavorare → lavorato."), PracticeQuestion(prompt = "Dì che hai gestito un piccolo team.", expected = listOf("Ho gestito un piccolo team.", "Ho gestito un team di cinque persone."), focus = "ho gestito", watch = "gestire → gestito."), PracticeQuestion(prompt = "Presenta un punto di forza: sei organizzata.", expected = listOf("Sono una persona organizzata.", "Sono organizzata."), focus = "sono una persona", watch = "sono una persona + aggettivo."), PracticeQuestion(prompt = "Dì che impari in fretta.", expected = listOf("Imparo in fretta.", "Imparo in fretta e con piacere."), focus = "imparo", watch = "imparare in fretta."), PracticeQuestion(prompt = "Racconta il percorso: prima lo studio, poi il lavoro all’estero.", expected = listOf("Prima ho studiato, poi ho lavorato all’estero.", "Prima ho studiato e poi ho lavorato all’estero."), focus = "prima… poi", watch = "i connettivi ordinano il discorso."), PracticeQuestion(prompt = "Dì perché cerchi il cambiamento.", expected = listOf("Ora cerco una nuova sfida.", "Cerco una nuova sfida professionale."), focus = "nuova sfida", watch = "la motivazione."))), exercises = listOf(Exercise(id = "it-foundations-u21-colloquio-e1", kind = "choice", prompt = "___ lavorato tre anni nel settore.", options = listOf("Ho", "Sono", "Faccio", "Sto"), answers = listOf("Ho"), explain = "Avere + participio: ho lavorato."), Exercise(id = "it-foundations-u21-colloquio-e2", kind = "gap", prompt = "Ho ___ un piccolo team di sei persone. (gestire, participio)", options = listOf(), answers = listOf("gestito"), explain = "gestire → gestito."), Exercise(id = "it-foundations-u21-colloquio-e3", kind = "order", prompt = "Presenta il percorso: prima lo studio, poi il lavoro.", options = listOf(), answers = listOf("Prima ho studiato poi ho lavorato"), explain = "prima… poi: l’ordine del percorso."), Exercise(id = "it-foundations-u21-colloquio-e4", kind = "written", prompt = "Dì il tuo punto di forza: sei una persona affidabile.", options = listOf(), answers = listOf("sono una persona affidabile", "sono affidabile"), explain = "sono una persona + aggettivo.")), skills = listOf("function:talk-about-work", "vocab:work", "grammar:present-perfect", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-perfect")),
    Lesson(id = "it-foundations-u21-colleghi", title = "Con i colleghi", goal = "Descrivere il clima di lavoro e i colleghi, con opinioni e confronti.", intro = LessonIntro(explanation = listOf("Il clima si descrive con aggettivi: « L’ambiente è rilassato », « Il ritmo è intenso », « L’atmosfera è collaborativa ».", "I colleghi si descrivono con i fatti: « Il mio capo ascolta le idee », « I colleghi si aiutano volentieri ».", "Poi dai la tua opinione e confronti: « Secondo me è un buon ambiente », « È più tranquillo del vecchio ufficio »."), examples = listOf(ExampleLine(text = "L’ambiente è rilassato ma serio.", meaning = "Il clima di lavoro."), ExampleLine(text = "Il mio capo ascolta le idee di tutti.", meaning = "Un buon capo."), ExampleLine(text = "I colleghi si aiutano volentieri.", meaning = "Un team collaborativo."), ExampleLine(text = "Secondo me è un buon ambiente.", meaning = "Dare un’opinione."), ExampleLine(text = "È più tranquillo del vecchio ufficio.", meaning = "Confrontare due lavori."))), expressions = listOf(TargetExpression(text = "l’ambiente di lavoro", meaning = "Il clima in ufficio.", note = "L’ambiente di lavoro è rilassato."), TargetExpression(text = "il capo ascolta", meaning = "Un segno di rispetto.", note = "Il mio capo ascolta le idee."), TargetExpression(text = "aiutarsi tra colleghi", meaning = "La collaborazione.", note = "Qui i colleghi si aiutano."), TargetExpression(text = "Secondo me…", meaning = "Dare un’opinione.", note = "Secondo me è un buon team."), TargetExpression(text = "più… di…", meaning = "Confrontare.", note = "È più tranquillo del vecchio lavoro.")), situation = "In pausa caffè raccontate il nuovo ufficio: com’è il clima, come sono il capo e i colleghi, e confrontate col vecchio lavoro.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Descrivi il clima: ambiente rilassato.", expected = listOf("L’ambiente è rilassato.", "L’ambiente di lavoro è rilassato.", "L’ambiente e rilassato."), focus = "l’ambiente", watch = "ambiente + aggettivo."), PracticeQuestion(prompt = "Dì una cosa buona del tuo capo: ascolta.", expected = listOf("Il mio capo ascolta le idee di tutti.", "Il mio capo ascolta."), focus = "il capo", watch = "il capo = el jefe."), PracticeQuestion(prompt = "Descrivi il team: l’aiuto tra colleghi.", expected = listOf("I colleghi si aiutano.", "I miei colleghi si aiutano volentieri."), focus = "si aiutano", watch = "riflessivo plurale."), PracticeQuestion(prompt = "Dai la tua opinione sull’ambiente.", expected = listOf("Secondo me è un buon ambiente.", "Secondo me l’ambiente è ottimo.", "Secondo me l’ambiente e ottimo."), focus = "secondo me", watch = "secondo me = en mi opinión."), PracticeQuestion(prompt = "Confronta: questo ufficio, più tranquillo del vecchio.", expected = listOf("Questo ufficio è più tranquillo del vecchio.", "Questo ufficio e piu tranquillo del vecchio.", "È più tranquillo del vecchio ufficio.", "E piu tranquillo del vecchio ufficio."), focus = "più… di", watch = "il confronto."), PracticeQuestion(prompt = "Descrivi un ritmo intenso.", expected = listOf("Il ritmo è intenso.", "Il ritmo e intenso.", "Qui il ritmo di lavoro è intenso.", "Qui il ritmo di lavoro e intenso."), focus = "il ritmo", watch = "ritmo + aggettivo."))), exercises = listOf(Exercise(id = "it-foundations-u21-colleghi-e1", kind = "choice", prompt = "Secondo me, l’ambiente ___ molto collaborativo.", options = listOf("è", "ha", "sono", "fa"), answers = listOf("è"), explain = "Essere + aggettivo: descrivere il clima."), Exercise(id = "it-foundations-u21-colleghi-e2", kind = "gap", prompt = "I colleghi si ___ volentieri. (aiutare)", options = listOf(), answers = listOf("aiutano"), explain = "Riflessivo plurale: si aiutano."), Exercise(id = "it-foundations-u21-colleghi-e3", kind = "order", prompt = "Dì una cosa buona del tuo capo.", options = listOf(), answers = listOf("Il mio capo ascolta le idee"), explain = "Il capo + ascoltare: rispetto."), Exercise(id = "it-foundations-u21-colleghi-e4", kind = "written", prompt = "Confronta: questo ufficio e il vecchio lavoro.", options = listOf(), answers = listOf("questo ufficio è più tranquillo del vecchio", "questo ufficio e piu tranquillo del vecchio", "è più tranquillo del vecchio lavoro", "e piu tranquillo del vecchio lavoro"), explain = "più… di: il confronto.")), skills = listOf("function:talk-about-work", "vocab:work", "function:describe-people", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "it-foundations-u21-obiettivi", title = "Obiettivi di lavoro", goal = "Parlare di piani e mete professionali: voglio riuscire a, mi piacerebbe.", intro = LessonIntro(explanation = listOf("Le mete si presentano con voglio riuscire a + infinito: « Voglio riuscire a diventare capo di progetto ».", "Più morbido: mi piacerebbe + infinito. « Mi piacerebbe lavorare all’estero », « Mi piacerebbe aprire un’attività ».", "I piani concreti: « Ho intenzione di fare un corso », « L’anno prossimo cambierò lavoro »."), examples = listOf(ExampleLine(text = "Voglio riuscire a diventare capo di progetto.", meaning = "La meta chiara."), ExampleLine(text = "Mi piacerebbe lavorare all’estero.", meaning = "Il desiderio, con tatto."), ExampleLine(text = "Ho intenzione di fare un corso.", meaning = "Il piano concreto."), ExampleLine(text = "L’anno prossimo cambierò lavoro.", meaning = "Il progetto nel futuro."), ExampleLine(text = "Passo per passo, senza fretta.", meaning = "L’atteggiamento."))), expressions = listOf(TargetExpression(text = "voglio riuscire a + infinito", meaning = "La meta con determinazione.", note = "Voglio riuscire a aprire un’attività."), TargetExpression(text = "mi piacerebbe + infinito", meaning = "Il desiderio gentile.", note = "Mi piacerebbe lavorare all’estero."), TargetExpression(text = "avere intenzione di", meaning = "Il piano deciso.", note = "Ho intenzione di cambiare lavoro."), TargetExpression(text = "diventare", meaning = "La meta professionale.", note = "Voglio diventare capo di progetto."), TargetExpression(text = "a lungo termine", meaning = "Il futuro lontano.", note = "A lungo termine vorrei una mia équipe.")), situation = "A pranzo parlate di futuro: le mete di ognuno, i desideri con tatto e i piani concreti per l’anno prossimo.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dì la tua meta: riuscire a diventare capo di progetto.", expected = listOf("Voglio riuscire a diventare capo di progetto.", "Voglio diventare capo di progetto."), focus = "voglio riuscire a", watch = "la meta con determinazione."), PracticeQuestion(prompt = "Esprimi il desiderio: lavorare all’estero.", expected = listOf("Mi piacerebbe lavorare all’estero.", "Mi piacerebbe lavorare all’estero un anno."), focus = "mi piacerebbe", watch = "mi piacerebbe + infinito."), PracticeQuestion(prompt = "Dì il piano deciso: un corso di inglese.", expected = listOf("Ho intenzione di fare un corso di inglese.", "Ho intenzione di fare un corso."), focus = "ho intenzione di", watch = "avere intenzione di + infinito."), PracticeQuestion(prompt = "Dì il progetto nel futuro: l’anno prossimo, cambiare lavoro.", expected = listOf("L’anno prossimo cambierò lavoro.", "L’anno prossimo cambiero lavoro.", "L’anno prossimo cambio lavoro."), focus = "cambierò", watch = "il futuro."), PracticeQuestion(prompt = "Dì la meta di Marco: diventare direttore.", expected = listOf("Marco vuole diventare direttore.", "Vuole diventare direttore."), focus = "vuole", watch = "volere + infinito."), PracticeQuestion(prompt = "Il desiderio di Anna: aprire un’attività.", expected = listOf("Ad Anna piacerebbe aprire un’attività.", "Le piacerebbe aprire un’attività."), focus = "piacerebbe", watch = "il desiderio di lei."))), exercises = listOf(Exercise(id = "it-foundations-u21-obiettivi-e1", kind = "choice", prompt = "___ riuscire a diventare capo di progetto.", options = listOf("Voglio", "Volevo", "Volere", "Vorrà"), answers = listOf("Voglio"), explain = "voglio riuscire a: la meta con determinazione."), Exercise(id = "it-foundations-u21-obiettivi-e2", kind = "gap", prompt = "Mi ___ lavorare all’estero. (piacere, condizionale)", options = listOf(), answers = listOf("piacerebbe"), explain = "mi piacerebbe + infinito."), Exercise(id = "it-foundations-u21-obiettivi-e3", kind = "order", prompt = "Dì il tuo piano: intenzione di cambiare lavoro.", options = listOf(), answers = listOf("Ho intenzione di cambiare lavoro"), explain = "avere intenzione di + infinito."), Exercise(id = "it-foundations-u21-obiettivi-e4", kind = "written", prompt = "Dì la meta di Marco: il sogno di diventare direttore.", options = listOf(), answers = listOf("marco vuole diventare direttore", "vuole diventare direttore"), explain = "volere + infinito: la meta.")), skills = listOf("function:describe-goals", "function:talk-about-work", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors"))))
}

object ItFoundationsU26 {
    val unit = CourseUnit(id = "it-foundations-u26", title = "La città che voglio", subtitle = "Opinioni e proposte", level = "B1", themes = listOf(ConversationTheme("la-citta-in-discussione", "Da un lato… dall’altro…", "Che ne pensi ?", "building.2", "Course", "Riunione di quartiere: sulla nuova zona pedonale ognuno dice la sua, con pro e contro sul tavolo.", 0),
                ConversationTheme("proposte-e-consumo", "Proposte concrete", "Meno, ma meglio", "leaf", "Course", "Dalle parole ai fatti: più verde nel quartiere e un modo di comprare più responsabile.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u26-opinare", title = "Da un lato… dall’altro…", goal = "Dare la propria opinione su una questione urbana, pesare pro e contro e giustificarla.", intro = LessonIntro(explanation = listOf("L’opinione si apre con le formule: « Secondo me… », « A mio parere… », « Io direi che… ». Poi arrivi al punto.", "Per pesare i due lati: « Da un lato… dall’altro… ». Per concordare: « Sono d’accordo », « Concordo »; per dissentire: « Vedo le cose diversamente ».", "La giustificazione arriva subito dopo: « Perché il traffico cala », « Infatti la piazza è più viva di prima »."), examples = listOf(ExampleLine(text = "Secondo me la zona pedonale è una buona idea.", meaning = "L’opinione chiara."), ExampleLine(text = "Da un lato più silenzio, dall’altro meno parcheggi.", meaning = "Pro e contro insieme."), ExampleLine(text = "Sono d’accordo con Marco.", meaning = "Concordare."), ExampleLine(text = "Vedo le cose diversamente.", meaning = "Dissentire con rispetto."), ExampleLine(text = "Il traffico cala, infatti l’aria è più pulita.", meaning = "La giustificazione."))), expressions = listOf(TargetExpression(text = "secondo me / a mio parere", meaning = "Aprire l’opinione.", note = "A mio parere conviene."), TargetExpression(text = "da un lato… dall’altro…", meaning = "I due lati della questione.", note = "Da un lato è comoda, dall’altro carica."), TargetExpression(text = "sono d’accordo", meaning = "Concordare.", note = "Sono d’accordo con te."), TargetExpression(text = "vedo le cose diversamente", meaning = "Dissentire con tatto.", note = "Vedo le cose diversamente, però ascolto."), TargetExpression(text = "infatti", meaning = "La conferma con un fatto.", note = "Infatti i dati lo dicono.")), situation = "Riunione di quartiere: sulla nuova zona pedonale tutti hanno un parere. Tu pesi pro e contro e ti giustifichi.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dai la tua opinione sulla zona pedonale.", expected = listOf("Secondo me la zona pedonale è una buona idea.", "A mio parere è una buona idea.", "Secondo me la zona pedonale e una buona idea"), focus = "secondo me", watch = "secondo me / a mio parere = en mi opinión."), PracticeQuestion(prompt = "Pesa pro e contro con la formula dei due lati.", expected = listOf("Da un lato c’è più silenzio, dall’altro meno parcheggi.", "Da un lato è comoda, dall’altro toglie parcheggi."), focus = "da un lato… dall’altro", watch = "i due lati: pro e contro."), PracticeQuestion(prompt = "Dì che sei d’accordo con Sara.", expected = listOf("Sono d’accordo con Sara.", "Concordo con Sara."), focus = "d’accordo", watch = "essere d’accordo = estar de acuerdo."), PracticeQuestion(prompt = "Dissentisci con rispetto.", expected = listOf("Vedo le cose diversamente.", "Non sono del tutto d’accordo."), focus = "dissentire", watch = "il dissenso gentile, senza « hai torto »."), PracticeQuestion(prompt = "Giustifica: il traffico cala, l’aria è più pulita.", expected = listOf("Il traffico cala, infatti l’aria è più pulita.", "Perché il traffico cala, l’aria è più pulita."), focus = "giustificare", watch = "dopo l’opinione, il perché."), PracticeQuestion(prompt = "Confronta: la piazza è più viva di prima.", expected = listOf("La piazza è più viva di prima.", "Ora la piazza è più viva che prima."), focus = "più… di", watch = "il comparativo nella discussione."))), exercises = listOf(Exercise(id = "it-foundations-u26-opinare-e1", kind = "choice", prompt = "___ me, la zona pedonale conviene.", options = listOf("Secondo", "Per", "Nella", "Con"), answers = listOf("Secondo"), explain = "Secondo me: la formula dell’opinione."), Exercise(id = "it-foundations-u26-opinare-e2", kind = "gap", prompt = "___ un lato è comoda. (prima parte della formula)", options = listOf(), answers = listOf("da"), explain = "Da un lato… dall’altro…: i due lati della questione."), Exercise(id = "it-foundations-u26-opinare-e3", kind = "order", prompt = "Dì che non concordi, con tatto.", options = listOf(), answers = listOf("Vedo le cose diversamente"), explain = "Il dissenso gentile: vedo le cose diversamente."), Exercise(id = "it-foundations-u26-opinare-e4", kind = "written", prompt = "Dai la tua opinione sul mercato del sabato e giustificala.", options = listOf(), answers = listOf("secondo me il mercato del sabato conviene perché è fresco", "secondo me il mercato del sabato conviene perche e fresco", "a mio parere il mercato conviene perché è vicino", "a mio parere il mercato conviene perche e vicino"), explain = "L’opinione + perché + il fatto: la giustificazione.")), skills = listOf("function:express-opinion", "grammar:connectors", "speaking:justify-opinion", "grammar:comparatives"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "it-foundations-u26-proposta", title = "Proposte di quartiere", goal = "Proporre cambiamenti concreti per il quartiere e difenderli con gli argomenti.", intro = LessonIntro(explanation = listOf("La proposta si presenta così: « Propongo più alberi in via Roma », « Sarebbe utile una pista ciclabile ».", "L’argomento si costruisce: il problema (« Oggi la strada è invivibile »), il beneficio (« Con più alberi si sta meglio »), la conclusione (« Quindi il quartiere guadagna »).", "Si chiude con la richiesta: « Vi chiediamo di firmare la proposta », « Firmate anche voi »."), examples = listOf(ExampleLine(text = "Propongo più spazi verdi vicino alla scuola.", meaning = "La proposta concreta."), ExampleLine(text = "Sarebbe utile una pista ciclabile.", meaning = "Il beneficio per tutti."), ExampleLine(text = "Oggi il traffico rende la strada invivibile.", meaning = "Il problema attuale."), ExampleLine(text = "Con più alberi, d’estate si sta meglio.", meaning = "L’argomento del confronto."), ExampleLine(text = "Vi chiediamo di firmare la proposta.", meaning = "La richiesta finale."))), expressions = listOf(TargetExpression(text = "propongo…", meaning = "Presentare la proposta.", note = "Propongo un mercato coperto."), TargetExpression(text = "sarebbe utile…", meaning = "Il beneficio ipotizzato.", note = "Sarebbe utile più panchine."), TargetExpression(text = "invivibile / vivibile", meaning = "Il problema e la meta.", note = "Questa strada è invivibile."), TargetExpression(text = "il quartiere guadagna", meaning = "L’argomento del beneficio.", note = "Il quartiere guadagna in salute."), TargetExpression(text = "firmare la proposta", meaning = "Il gesto che conta.", note = "Firmate anche voi.")), situation = "Comitato di quartiere: proponi più verde e una pista ciclabile, porti i fatti e chiedi le firme.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Proponi più spazi verdi.", expected = listOf("Propongo più spazi verdi.", "Propongo più spazi verdi vicino alla scuola."), focus = "propongo", watch = "propongo + la cosa concreta."), PracticeQuestion(prompt = "Dì che sarebbe utile una pista ciclabile.", expected = listOf("Sarebbe utile una pista ciclabile.", "Sarebbe utile una pista ciclabile in via Roma."), focus = "sarebbe utile", watch = "sarebbe + utile: la proposta morbida."), PracticeQuestion(prompt = "Descrivi il problema: la strada è invivibile.", expected = listOf("Oggi questa strada è invivibile.", "La strada è invivibile per il traffico."), focus = "invivibile", watch = "in- + vivibile: il problema."), PracticeQuestion(prompt = "Argomenta: con più alberi si sta meglio.", expected = listOf("Con più alberi si sta meglio d’estate.", "Con più alberi il quartiere è più fresco."), focus = "l’argomento", watch = "il fatto + il confronto."), PracticeQuestion(prompt = "Chiedi di firmare la proposta.", expected = listOf("Vi chiediamo di firmare la proposta.", "Firmate anche voi, per favore."), focus = "firmare", watch = "firmare = firmar."), PracticeQuestion(prompt = "Riassumi con quindi: più verde, quartiere migliore.", expected = listOf("C’è più verde, quindi si sta meglio.", "Il traffico cala, quindi il quartiere guadagna."), focus = "quindi", watch = "quindi: la conclusione dell’argomento."))), exercises = listOf(Exercise(id = "it-foundations-u26-proposta-e1", kind = "choice", prompt = "___ più panchine nella piazza.", options = listOf("Propongo", "Proporre", "Proposta", "Proponi di"), answers = listOf("Propongo"), explain = "Propongo + la cosa: la prima persona della proposta."), Exercise(id = "it-foundations-u26-proposta-e2", kind = "gap", prompt = "___ utile una pista ciclabile per la scuola. (essere, condizionale)", options = listOf(), answers = listOf("sarebbe"), explain = "sarebbe utile + la cosa: la proposta."), Exercise(id = "it-foundations-u26-proposta-e3", kind = "order", prompt = "Chiedi al comitato di firmare.", options = listOf(), answers = listOf("Vi chiediamo di firmare la proposta"), explain = "chiedere a qualcuno di + infinito."), Exercise(id = "it-foundations-u26-proposta-e4", kind = "written", prompt = "Argomenta la pista ciclabile: oggi il traffico è invivibile.", options = listOf(), answers = listOf("oggi il traffico è invivibile quindi serve la pista ciclabile", "oggi il traffico e invivibile quindi serve la pista ciclabile", "il traffico è invivibile quindi propongo la pista ciclabile", "il traffico e invivibile quindi propongo la pista ciclabile"), explain = "Il problema + quindi + la proposta: l’argomento.")), skills = listOf("grammar:comparatives", "writing:argument", "function:express-opinion", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "it-foundations-u26-consumo", title = "Consumare responsabile", goal = "Discutere di consumo responsabile e costruire un’argomentazione breve: idea, motivo, esempio.", intro = LessonIntro(explanation = listOf("Il tema: comprare meno ma meglio. « Compro meno cose, ma scelgo meglio ». È il consumo responsabile in due parole.", "L’argomentazione breve ha tre passi: l’idea (« Per me il riutilizzo conta più del riciclo »), il motivo (« Ogni oggetto usato è un rifiuto in meno »), l’esempio (« Infatti compro usato da un anno »).", "Le domande aprono il dibattito: « Secondo te conviene riparare o comprare nuovo ? ». E per dissentire: « Capisco, però i dati dicono altro »."), examples = listOf(ExampleLine(text = "Compro meno cose, ma scelgo meglio.", meaning = "Il principio."), ExampleLine(text = "Per me il riutilizzo conta più del riciclo.", meaning = "L’opinione con il confronto."), ExampleLine(text = "Ogni oggetto usato è un rifiuto in meno.", meaning = "Il motivo."), ExampleLine(text = "Io compro usato da un anno, infatti spendo meno.", meaning = "L’esempio personale."), ExampleLine(text = "Secondo te conviene riparare o comprare nuovo ?", meaning = "La domanda del dibattito."))), expressions = listOf(TargetExpression(text = "comprare meno, ma meglio", meaning = "Il consumo responsabile in breve.", note = "Meno cose, ma meglio."), TargetExpression(text = "il riutilizzo", meaning = "Usare di nuovo.", note = "Il riutilizzo viene prima del riciclo."), TargetExpression(text = "un rifiuto in meno", meaning = "Il beneficio che si conta.", note = "Un rifiuto in meno, ogni volta."), TargetExpression(text = "spendere meno", meaning = "Il portafoglio ringrazia.", note = "Comprando usato spendo meno."), TargetExpression(text = "riparare o comprare nuovo ?", meaning = "Il dilemma del dibattito.", note = "Conviene riparare ?")), situation = "Al dibattito del quartiere sul consumo: difendi comprare usato con idea, motivo ed esempio, e chiudi con una domanda.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dì il principio: compri meno ma meglio.", expected = listOf("Compro meno cose, ma scelgo meglio.", "Compro meno, ma meglio."), focus = "il principio", watch = "meno… ma meglio: la sintesi."), PracticeQuestion(prompt = "Dai la tua opinione: il riutilizzo conta più del riciclo.", expected = listOf("Per me il riutilizzo conta più del riciclo.", "Secondo me il riutilizzo conta più del riciclo."), focus = "più di", watch = "il comparativo nelle idee."), PracticeQuestion(prompt = "Dai il motivo: un rifiuto in meno.", expected = listOf("Ogni oggetto usato è un rifiuto in meno.", "Perché ogni oggetto usato è un rifiuto in meno."), focus = "il motivo", watch = "perché + la causa."), PracticeQuestion(prompt = "Porta l’esempio personale: compri usato da un anno.", expected = listOf("Io compro usato da un anno, infatti spendo meno.", "Compro usato da un anno e spendo meno."), focus = "l’esempio", watch = "infatti + il fatto reale."), PracticeQuestion(prompt = "Apri il dibattito: riparare o comprare nuovo ?", expected = listOf("Secondo te conviene riparare o comprare nuovo ?", "Conviene riparare o comprare nuovo ?"), focus = "la domanda", watch = "o / oppure: le alternative."), PracticeQuestion(prompt = "Dissentisci con i dati, con gentilezza.", expected = listOf("Vedo le cose diversamente: i numeri dicono altro.", "Capisco, però i dati dicono altro."), focus = "il dissenso", watch = "prima il riconoscimento, poi il dato."))), exercises = listOf(Exercise(id = "it-foundations-u26-consumo-e1", kind = "choice", prompt = "Compro usato, ___ spendo meno.", options = listOf("infatti", "però", "nonostante", "affinché"), answers = listOf("infatti"), explain = "infatti: il fatto che conferma l’idea."), Exercise(id = "it-foundations-u26-consumo-e2", kind = "gap", prompt = "Il riutilizzo viene ___ del riciclo. (prima)", options = listOf(), answers = listOf("prima"), explain = "venire prima di: l’ordine delle priorità."), Exercise(id = "it-foundations-u26-consumo-e3", kind = "order", prompt = "Apri il dibattito con la domanda sulle alternative.", options = listOf(), answers = listOf("Conviene riparare o comprare nuovo"), explain = "La domanda con due alternative."), Exercise(id = "it-foundations-u26-consumo-e4", kind = "written", prompt = "Scrivi la tua argomentazione: idea, motivo, esempio (comprare usato).", options = listOf(), answers = listOf("compro usato perché è un rifiuto in meno e spendo meno", "compro usato perche e un rifiuto in meno e spendo meno", "per me comprare usato conta perché è un rifiuto in meno", "per me comprare usato conta perche e un rifiuto in meno"), explain = "L’idea + perché + il fatto: l’argomentazione breve.")), skills = listOf("writing:argument", "function:express-opinion", "grammar:connectors", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors"))))
}

