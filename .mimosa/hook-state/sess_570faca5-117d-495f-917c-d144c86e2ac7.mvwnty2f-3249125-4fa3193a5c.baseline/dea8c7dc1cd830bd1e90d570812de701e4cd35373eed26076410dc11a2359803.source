    val unit = CourseUnit(id = "pt-foundations-u11", title = "Meu bairro", subtitle = "Perto de casa", level = "A1", themes = listOf(ConversationTheme("bairro-lugares", "No bairro", "O que tem perto", "map", "Course", "Chegam ao bairro novo e perguntam o que tem perto: mercado, farmácia e uma praça.", 0),
                ConversationTheme("bairro-compras", "Compras perto", "Fruta do bairro", "cart", "Course", "Na quitanda da esquina: compram fruta fresca e conversam com o dono.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u11-lugares", title = "Tem um supermercado ?", goal = "Perguntar o que tem no bairro com tem e há.", intro = LessonIntro(explanation = listOf("Perguntar por lugares: « Tem um supermercado aqui perto ? ». A resposta: « Tem, é perto » ou « Não tem ».", "Outra forma: « há ». « Há uma praça no centro ». No dia a dia, « tem » é mais comum.", "Lugares do bairro: « o supermercado, a farmácia, a padaria, a praça, o ponto de ônibus »."), examples = listOf(ExampleLine(text = "Tem um supermercado aqui perto ?", meaning = "Perguntar por lugar."), ExampleLine(text = "Tem, é na esquina.", meaning = "Confirmar."), ExampleLine(text = "Não tem farmácia na rua.", meaning = "Negar."), ExampleLine(text = "Há uma praça pequena aqui.", meaning = "há = hay."), ExampleLine(text = "Tem um ponto de ônibus em frente.", meaning = "Lugar perto."))), expressions = listOf(TargetExpression(text = "Tem … aqui perto ?", meaning = "Perguntar por lugar.", note = "…um supermercado ?"), TargetExpression(text = "tem / não tem", meaning = "Confirmar ou negar.", note = "Tem, é perto."), TargetExpression(text = "há", meaning = "Forma neutra de tem.", note = "Há uma praça aqui."), TargetExpression(text = "aqui perto", meaning = "Lugar próximo.", note = "Moro aqui perto."), TargetExpression(text = "na esquina", meaning = "Onde as ruas se cruzam.", note = "A padaria é na esquina.")), situation = "Chegam ao bairro novo: procuram supermercado, farmácia e um lugar para tomar café.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pergunte por um supermercado próximo.", expected = listOf("Tem um supermercado perto ?", "tem um supermercado aqui perto"), focus = "tem … perto ?", watch = "Tem + lugar ?"), PracticeQuestion(prompt = "Diga que tem uma padaria na esquina.", expected = listOf("Tem uma padaria na esquina.", "tem uma padaria na esquina"), focus = "tem + lugar", watch = "na esquina = en la esquina."), PracticeQuestion(prompt = "Diga que não tem farmácia aqui.", expected = listOf("Não tem farmácia aqui.", "nao tem farmacia aqui"), focus = "não tem", watch = "não tem = no hay."), PracticeQuestion(prompt = "Diga que há uma praça no bairro.", expected = listOf("Há uma praça no bairro.", "ha uma praca no bairro"), focus = "há", watch = "há = hay (formal)."), PracticeQuestion(prompt = "Pergunte o lugar do ponto de ônibus.", expected = listOf("Onde é o ponto de ônibus ?", "onde e o ponto de onibus"), focus = "onde é", watch = "Onde é + lugar fixo."))), exercises = listOf(Exercise(id = "pt-foundations-u11-lugares-e1", kind = "choice", prompt = "___ um supermercado aqui perto ?", options = listOf("Tem", "Está", "É", "Vai"), answers = listOf("Tem"), explain = "Tem + lugar ? = ¿hay…?"), Exercise(id = "pt-foundations-u11-lugares-e2", kind = "gap", prompt = "___ uma padaria antiga nesta rua.", options = listOf(), answers = listOf("Tem"), explain = "tem = hay no dia a dia."), Exercise(id = "pt-foundations-u11-lugares-e3", kind = "order", prompt = "O vizinho pergunta pela farmácia. Responda.", options = listOf(), answers = listOf("A farmacia e perto"), explain = "ser + perto: lugar perto."), Exercise(id = "pt-foundations-u11-lugares-e4", kind = "written", prompt = "Você precisa de mercado. Pergunte para o vizinho.", options = listOf(), answers = listOf("Tem um mercado aqui perto ?", "tem mercado por aqui ?"), explain = "Tem + lugar ? para perguntar.")), skills = listOf("grammar:there-is-are", "grammar:present-questions", "vocab:town", "function:ask-simple-questions"), canDo = listOf("ask-for-directions"), prerequisites = listOf("grammar:there-is-are")),
    Lesson(id = "pt-foundations-u11-caminho", title = "Como eu chego ?", goal = "Dar e pedir direções simples: siga em frente, vire à esquerda, é perto.", intro = LessonIntro(explanation = listOf("Pedir direção: « Como eu chego à praça ? » « É longe ? »", "Direções: « Siga em frente ». « Vire à esquerda ». « Vire à direita na segunda rua ».", "Distância: « É perto, pode ir a pé ». « É longe, melhor de ônibus »."), examples = listOf(ExampleLine(text = "Como eu chego à praça ?", meaning = "Pedir direção."), ExampleLine(text = "Siga em frente duas quadras.", meaning = "Seguir reto."), ExampleLine(text = "Vire à esquerda na esquina.", meaning = "Girar a la izquierda."), ExampleLine(text = "É perto, pode ir a pé.", meaning = "Distância curta."), ExampleLine(text = "É longe, melhor de ônibus.", meaning = "Distância longa."))), expressions = listOf(TargetExpression(text = "Como eu chego a … ?", meaning = "Pedir direção.", note = "…à praça ?"), TargetExpression(text = "siga em frente", meaning = "Seguir reto.", note = "Siga em frente duas quadras."), TargetExpression(text = "vire à esquerda / à direita", meaning = "Girar.", note = "Vire à direita ali."), TargetExpression(text = "é perto / é longe", meaning = "Distância.", note = "É perto mesmo."), TargetExpression(text = "a pé", meaning = "Andando.", note = "Pode ir a pé.")), situation = "Querem ir à feira do bairro: perguntam o caminho e chegam a pé em dez minutos.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pergunte o caminho até a praça.", expected = listOf("Como eu chego à praça ?", "como eu chego a praca"), focus = "como eu chego", watch = "eu chego = yo llego."), PracticeQuestion(prompt = "Diga para seguir reto.", expected = listOf("Siga em frente.", "siga em frente duas quadras"), focus = "siga em frente", watch = "imperativo de seguir."), PracticeQuestion(prompt = "Diga para girar à direita.", expected = listOf("Vire à direita.", "vire a direita"), focus = "vire à", watch = "vire à direita = gire a la derecha."), PracticeQuestion(prompt = "Diga que pode ir caminhando porque é perto.", expected = listOf("É perto, pode ir a pé.", "e perto pode ir a pe"), focus = "a pé", watch = "a pé = a pie."), PracticeQuestion(prompt = "Diga que é longe e recomende o ônibus.", expected = listOf("É longe, melhor de ônibus.", "e longe melhor de onibus"), focus = "é longe", watch = "melhor de + transporte."))), exercises = listOf(Exercise(id = "pt-foundations-u11-caminho-e1", kind = "choice", prompt = "Como eu ___ à farmácia ?", options = listOf("chego", "chega", "chegue", "chegamos"), answers = listOf("chego"), explain = "eu chego: a pessoa eu + o verbo."), Exercise(id = "pt-foundations-u11-caminho-e2", kind = "gap", prompt = "___ em frente e o mercado fica na terceira quadra.", options = listOf(), answers = listOf("Siga"), explain = "siga em frente = seguir reto."), Exercise(id = "pt-foundations-u11-caminho-e3", kind = "order", prompt = "O turista pergunta pelo caminho. Diga a ele a direção.", options = listOf(), answers = listOf("Vire a esquerda na esquina"), explain = "vire à esquerda + na esquina."), Exercise(id = "pt-foundations-u11-caminho-e4", kind = "written", prompt = "O lugar fica perto. Diga como a pessoa pode ir.", options = listOf(), answers = listOf("É perto, pode ir a pé.", "e perto pode ir a pe"), explain = "é perto + a pé.")), skills = listOf("function:ask-for-directions", "vocab:directions", "grammar:present-simple", "vocab:town"), canDo = listOf("ask-for-directions"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u11-quitanda", title = "Na quitanda", goal = "Comprar fruta na quitanda do bairro: quantidades e preços.", intro = LessonIntro(explanation = listOf("A quitanda vende fruta e verdura. « Queria um quilo de laranjas ». « As bananas estão maduras ? »", "As quantidades: « meio quilo de uvas », « duas dúzias de bananas », « um abacaxi ».", "O pagamento: « Quanto fica ? » « Fica doze reais ». « Pode ser no cartão ? »"), examples = listOf(ExampleLine(text = "Bom dia! Queria um quilo de laranjas.", meaning = "Cumprimentar e pedir."), ExampleLine(text = "As bananas estão maduras ?", meaning = "Perguntar a qualidade."), ExampleLine(text = "Meio quilo de uvas, por favor.", meaning = "Quantidade."), ExampleLine(text = "Quanto fica ?", meaning = "Perguntar o total."), ExampleLine(text = "Fica doze reais.", meaning = "O preço."))), expressions = listOf(TargetExpression(text = "Queria + quantidade", meaning = "Pedir educado.", note = "Queria um quilo de laranjas."), TargetExpression(text = "estão maduras ?", meaning = "Qualidade da fruta.", note = "As bananas estão maduras ?"), TargetExpression(text = "meio quilo de …", meaning = "Peso menor.", note = "…uvas."), TargetExpression(text = "uma dúzia de …", meaning = "Doze unidades.", note = "uma dúzia de bananas."), TargetExpression(text = "Quanto fica ?", meaning = "Total da compra.", note = "Fica doze reais.")), situation = "Sábado de manhã: compram laranjas, bananas e uvas na quitanda da esquina e pagam no cartão.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Peça um quilo de laranjas, com educação.", expected = listOf("Queria um quilo de laranjas.", "queria um quilo de laranjas"), focus = "queria", watch = "queria = educado."), PracticeQuestion(prompt = "Pergunte a qualidade das bananas.", expected = listOf("As bananas estão maduras ?", "as bananas estao maduras"), focus = "estão maduras", watch = "maduras (fem pl)."), PracticeQuestion(prompt = "Peça meio quilo de uvas.", expected = listOf("Queria meio quilo de uvas.", "meio quilo de uvas"), focus = "meio quilo", watch = "meio quilo = medio kilo."), PracticeQuestion(prompt = "Pergunte se pode pagar com cartão.", expected = listOf("Pode ser no cartão ?", "Posso pagar no cartão ?", "pode ser no cartao"), focus = "no cartão", watch = "no cartão = con tarjeta."), PracticeQuestion(prompt = "Diga o total: dez reais.", expected = listOf("Fica dez reais.", "fica dez reais"), focus = "fica + preço", watch = "fica = queda en."))), exercises = listOf(Exercise(id = "pt-foundations-u11-quitanda-e1", kind = "choice", prompt = "Queria um quilo de ___.", options = listOf("laranjas", "cadernos", "toalhas", "chaves"), answers = listOf("laranjas"), explain = "Na quitanda se compra fruta."), Exercise(id = "pt-foundations-u11-quitanda-e2", kind = "gap", prompt = "___ fica ?", options = listOf(), answers = listOf("Quanto"), explain = "Quanto fica ? = total da compra."), Exercise(id = "pt-foundations-u11-quitanda-e3", kind = "order", prompt = "Peça um quilo de bananas.", options = listOf(), answers = listOf("Queria um quilo de bananas"), explain = "Queria + quantidade."), Exercise(id = "pt-foundations-u11-quitanda-e4", kind = "written", prompt = "Peça duas dúzias de bananas, com educação.", options = listOf(), answers = listOf("Queria duas dúzias de bananas.", "queria duas duzias de bananas", "duas duzias de bananas, por favor"), explain = "duas dúzias de + fruta.")), skills = listOf("function:go-shopping", "grammar:quantities", "vocab:food", "grammar:present-simple"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple"))))
}

object PtFoundationsU12 {
    val unit = CourseUnit(id = "pt-foundations-u12", title = "Minha gente", subtitle = "Família e amigos", level = "A1", themes = listOf(ConversationTheme("gente-familia", "A família", "Quem é quem", "figure-2", "Course", "A Ana mostra as fotos do celular: o avô, os primos e um tio que mora longe.", 0),
                ConversationTheme("gente-amigos", "Os amigos", "Como eles são ?", "heart", "Course", "O grupo dos amigos conversa: quem é tímido, quem é simpático e quem trabalha muito.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u12-familia", title = "Minha família", goal = "Falar dos membros da família com meu/minha: tenho um tio muito simpático.", intro = LessonIntro(explanation = listOf("A família próxima: « o pai, a mãe, o irmão, a irmã, o avô, a avó ». « Meu avô mora com a gente ».", "Mais membros: « o tio, a tia, o primo, a prima ». « Tenho um tio que mora longe ».", "Possessivos com a família: « meu pai, minha mãe, meus primos ». « Minha tia é professora »."), examples = listOf(ExampleLine(text = "Minha irmã tem vinte anos.", meaning = "minha + feminino."), ExampleLine(text = "Meu avô é muito simpático.", meaning = "meu + masculino."), ExampleLine(text = "Tenho dois primos e uma prima.", meaning = "ter + família."), ExampleLine(text = "Minha tia mora perto.", meaning = "mora = vive."), ExampleLine(text = "Os meus pais trabalham muito.", meaning = "os meus pais = mis padres."))), expressions = listOf(TargetExpression(text = "meu / minha", meaning = "Possessivo com a família.", note = "meu pai, minha mãe."), TargetExpression(text = "tenho um tio", meaning = "Falar dos parentes.", note = "Tenho um tio no Rio."), TargetExpression(text = "o avô / a avó", meaning = "Avô (masc) e avó (fem).", note = "Minha avó faz bolo."), TargetExpression(text = "os meus pais", meaning = "O pai e a mãe.", note = "Os meus pais moram aqui."), TargetExpression(text = "mora perto", meaning = "Falar do lugar.", note = "Meu tio mora perto.")), situation = "A Ana mostra as fotos do celular: o avô, os primos e um tio que mora longe.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga que a sua irmã tem vinte anos. (use minha)", expected = listOf("Minha irmã tem vinte anos.", "minha irma tem vinte anos"), focus = "minha", watch = "minha + palavra feminina."), PracticeQuestion(prompt = "Diga que tem um tio simpático.", expected = listOf("Tenho um tio simpático.", "tenho um tio simpatico"), focus = "tenho", watch = "tenho = tengo."), PracticeQuestion(prompt = "Diga que o seu avô mora perto. (use meu)", expected = listOf("Meu avô mora perto.", "meu avo mora perto"), focus = "meu", watch = "meu + palavra masculina."), PracticeQuestion(prompt = "Pergunte se a colega tem primos.", expected = listOf("Você tem primos ?", "Tem primos ?", "voce tem primos"), focus = "ter", watch = "Você + tem."), PracticeQuestion(prompt = "Diga que os seus pais trabalham muito.", expected = listOf("Os meus pais trabalham muito.", "os meus pais trabalham muito"), focus = "os meus pais", watch = "pais = padres, não países."))), exercises = listOf(Exercise(id = "pt-foundations-u12-familia-e1", kind = "choice", prompt = "Minha ___ é a mãe do meu pai.", options = listOf("avó", "tia", "prima", "irmã"), answers = listOf("avó"), explain = "A mãe do pai ou da mãe é a avó."), Exercise(id = "pt-foundations-u12-familia-e2", kind = "gap", prompt = "Meu ___ é o pai da minha mãe.", options = listOf(), answers = listOf("avô", "avo"), explain = "O pai da mãe ou do pai é o avô."), Exercise(id = "pt-foundations-u12-familia-e3", kind = "order", prompt = "Diga o que a sua avó faz aos domingos. (bolo)", options = listOf(), answers = listOf("A avo faz bolo aos domingos"), explain = "A avó + faz + bolo: rotina da família."), Exercise(id = "pt-foundations-u12-familia-e4", kind = "written", prompt = "Diga quantos primos você tem: dois.", options = listOf(), answers = listOf("Tenho dois primos.", "tenho dois primos"), explain = "tenho + número + parente.")), skills = listOf("vocab:family", "grammar:possessives", "grammar:present-simple", "function:describe-people"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:possessives")),
    Lesson(id = "pt-foundations-u12-amigos", title = "Como ele é ?", goal = "Descrever as pessoas com adjetivos: simpático, tímido, trabalhador.", intro = LessonIntro(explanation = listOf("Descrever com « ser »: « Ele é simpático ». « Ela é tímida ». O adjetivo concorda: tímido/tímida.", "Adjetivos úteis: « simpático » (amable), « tímido » (reservado), « trabalhador » (trabaja mucho).", "Perguntar: « Como ele é ? » — a resposta usa « é »: « É muito simpático »."), examples = listOf(ExampleLine(text = "Como é o seu irmão ?", meaning = "Perguntar a descrição."), ExampleLine(text = "Ele é simpático e divertido.", meaning = "ser + adjetivo."), ExampleLine(text = "Minha prima é tímida.", meaning = "fem: tímida."), ExampleLine(text = "O Rafael é muito trabalhador.", meaning = "muito + adjetivo."), ExampleLine(text = "Ela não é tímida, é extrovertida.", meaning = "não é + adjetivo."))), expressions = listOf(TargetExpression(text = "Como ele é ?", meaning = "Perguntar a descrição.", note = "Como é a sua amiga ?"), TargetExpression(text = "simpático / simpática", meaning = "Amable.", note = "O vizinho é simpático."), TargetExpression(text = "tímido / tímida", meaning = "Reservado.", note = "A Ana é tímida."), TargetExpression(text = "trabalhador / trabalhadora", meaning = "Trabaja mucho.", note = "Meu pai é trabalhador."), TargetExpression(text = "muito + adjetivo", meaning = "Intensidade.", note = "muito simpático.")), situation = "A Bia pergunta do irmão novo da Ana: ele é tímido, mas muito simpático.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Descreva o seu irmão: simpático.", expected = listOf("Meu irmão é simpático.", "meu irmao e simpatico"), focus = "ser + adjetivo", watch = "simpático com acento."), PracticeQuestion(prompt = "Diga que a sua prima é tímida.", expected = listOf("Minha prima é tímida.", "minha prima e timida"), focus = "tímida", watch = "fem: tímida."), PracticeQuestion(prompt = "Pergunte como é o amigo novo.", expected = listOf("Como é o amigo novo ?", "como e o amigo novo"), focus = "Como é … ?", watch = "Como + é."), PracticeQuestion(prompt = "Diga que o Pedro é muito trabalhador.", expected = listOf("O Pedro é muito trabalhador.", "o pedro e muito trabalhador"), focus = "muito + adjetivo", watch = "muito antes do adjetivo."), PracticeQuestion(prompt = "Diga que a Ana não é tímida.", expected = listOf("A Ana não é tímida.", "a ana nao e timida"), focus = "não é", watch = "não é = no es."))), exercises = listOf(Exercise(id = "pt-foundations-u12-amigos-e1", kind = "choice", prompt = "O meu primo é muito ___. Ele fala com todo o mundo.", options = listOf("extrovertido", "tímido", "quieto", "triste"), answers = listOf("extrovertido"), explain = "Quem fala com todo o mundo é extrovertido; é o contrário de tímido."), Exercise(id = "pt-foundations-u12-amigos-e2", kind = "gap", prompt = "A minha colega é ___. Ela estuda e trabalha muito.", options = listOf(), answers = listOf("trabalhadora"), explain = "Ela trabalha muito: trabalhadora (fem)."), Exercise(id = "pt-foundations-u12-amigos-e3", kind = "order", prompt = "Pergunte a descrição do irmão dela.", options = listOf(), answers = listOf("Como e o irmao dela"), explain = "Como + é + pessoa: pergunta de descrição."), Exercise(id = "pt-foundations-u12-amigos-e4", kind = "written", prompt = "Descreva a sua amiga: simpática e inteligente.", options = listOf(), answers = listOf("A minha amiga é simpática e inteligente.", "minha amiga e simpatica e inteligente"), explain = "ser + dois adjetivos no feminino.")), skills = listOf("function:describe-people", "grammar:present-simple", "vocab:feelings", "function:ask-simple-questions"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u12-ligacao", title = "Uma ligação", goal = "Falar ao telefone: Está… ?, não está, ligo mais tarde.", intro = LessonIntro(explanation = listOf("Ao telefone: « Está o Pedro ? ». A resposta: « Ele não está agora. Quer deixar recado ? ».", "Perguntas com o verbo no começo: « Onde você está ? », « Você pode falar agora ? ».", "Soluções: « Ligo mais tarde » (llamo más tarde) ou « Manda mensagem para ele »."), examples = listOf(ExampleLine(text = "Alô ? Está a Marina ?", meaning = "Atender e perguntar."), ExampleLine(text = "Ela não está agora.", meaning = "não está = no está."), ExampleLine(text = "Onde você está ?", meaning = "Perguntar o lugar."), ExampleLine(text = "Eu ligo mais tarde.", meaning = "ligo = llamo."), ExampleLine(text = "Quer deixar um recado ?", meaning = "Oferecer ajuda."))), expressions = listOf(TargetExpression(text = "Alô ?", meaning = "Atender o telefone.", note = "Alô ? Quem fala ?"), TargetExpression(text = "Está … ?", meaning = "Perguntar se a pessoa está.", note = "Está o Pedro ?"), TargetExpression(text = "não está", meaning = "A pessoa não está.", note = "Ele não está agora."), TargetExpression(text = "ligo mais tarde", meaning = "Llamo después.", note = "Ligo mais tarde, obrigado."), TargetExpression(text = "deixar um recado", meaning = "Dejar un mensaje.", note = "Quer deixar recado ?")), situation = "A Ana liga para o Rafa, mas ele não está: a mãe atende e ela liga mais tarde.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Atenda o telefone.", expected = listOf("Alô ?", "alo"), focus = "alô", watch = "Alô com acento."), PracticeQuestion(prompt = "Pergunte se o Pedro está.", expected = listOf("Está o Pedro ?", "O Pedro está ?", "esta o pedro"), focus = "Está … ?", watch = "Está no começo da pergunta."), PracticeQuestion(prompt = "Diga que a Marina não está agora.", expected = listOf("A Marina não está agora.", "a marina nao esta agora"), focus = "não está", watch = "não está = no está."), PracticeQuestion(prompt = "Diga que você liga mais tarde.", expected = listOf("Eu ligo mais tarde.", "Ligo mais tarde.", "eu ligo mais tarde"), focus = "ligo mais tarde", watch = "ligo = llamo."), PracticeQuestion(prompt = "Pergunte se a pessoa quer deixar um recado.", expected = listOf("Quer deixar um recado ?", "quer deixar recado"), focus = "deixar recado", watch = "recado = mensaje."))), exercises = listOf(Exercise(id = "pt-foundations-u12-ligacao-e1", kind = "choice", prompt = "Alô ? ___ o Rafa ?", options = listOf("Está", "É", "Faz", "Vai"), answers = listOf("Está"), explain = "Ao telefone: Está o Rafa ? — pergunta com « está » no começo."), Exercise(id = "pt-foundations-u12-ligacao-e2", kind = "gap", prompt = "O Pedro não ___ agora. Ele volta às seis.", options = listOf(), answers = listOf("está", "esta"), explain = "não está = no está agora."), Exercise(id = "pt-foundations-u12-ligacao-e3", kind = "order", prompt = "Diga que você chama de volta depois.", options = listOf(), answers = listOf("Eu ligo mais tarde"), explain = "ligo + mais tarde: voltar a ligar."), Exercise(id = "pt-foundations-u12-ligacao-e4", kind = "written", prompt = "Pergunte sobre um recado para a Marina.", options = listOf(), answers = listOf("Quer deixar um recado ?", "quer deixar um recado"), explain = "Quer + deixar + recado ?")), skills = listOf("vocab:social-expressions", "grammar:present-questions", "function:ask-simple-questions", "grammar:present-simple"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:present-simple"))))
}

object PtFoundationsU13 {
    val unit = CourseUnit(id = "pt-foundations-u13", title = "O tempo", subtitle = "Dias e clima", level = "A1", themes = listOf(ConversationTheme("tempo-dias", "O dia a dia", "Rotina e hábitos", "sun.max", "Course", "O Leo conta o dia dele: acorda cedo, toma café com pressa e nunca chega tarde.", 0),
                ConversationTheme("tempo-clima", "O clima", "Sol, chuva e estações", "cloud.rain", "Course", "Chove no sábado: o grupo troca o passeio pelo chocolate quente em casa.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u13-rotina", title = "Da manhã à noite", goal = "Falar da rotina com sempre, muitas vezes, às vezes e nunca.", intro = LessonIntro(explanation = listOf("A rotina no presente: « Eu acordo às sete. Tomo café às oito. Trabalho de manhã ».", "Frequência: « sempre » (100%), « muitas vezes » (muchas veces), « às vezes » (a veces), « nunca » (0%).", "O advérbio vai antes do verbo: « Sempre tomo café », « Nunca como tarde »."), examples = listOf(ExampleLine(text = "Eu acordo às sete.", meaning = "acordar = despertar."), ExampleLine(text = "Sempre tomo café de manhã.", meaning = "sempre = siempre."), ExampleLine(text = "Muitas vezes almoço em casa.", meaning = "muitas vezes = muchas veces."), ExampleLine(text = "Às vezes leio à noite.", meaning = "às vezes = a veces."), ExampleLine(text = "Nunca como tarde.", meaning = "nunca = 0%."))), expressions = listOf(TargetExpression(text = "sempre", meaning = "100% das vezes.", note = "Sempre tomo café."), TargetExpression(text = "muitas vezes", meaning = "Muchas veces.", note = "Muitas vezes como em casa."), TargetExpression(text = "às vezes", meaning = "A veces.", note = "Às vezes saio à noite."), TargetExpression(text = "nunca", meaning = "0%, jamás.", note = "Nunca como tarde."), TargetExpression(text = "acordar", meaning = "Despertar.", note = "Acordo às sete.")), situation = "O Leo conta o dia dele: acorda cedo, toma café com pressa e nunca chega tarde.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga que você sempre toma café de manhã.", expected = listOf("Sempre tomo café de manhã.", "sempre tomo cafe da manha"), focus = "sempre", watch = "sempre antes do verbo."), PracticeQuestion(prompt = "Diga que você nunca janta tarde.", expected = listOf("Nunca janto tarde.", "nunca janto tarde"), focus = "nunca", watch = "nunca + verbo, sem « não »."), PracticeQuestion(prompt = "Diga que às vezes você lê à noite.", expected = listOf("Às vezes leio à noite.", "as vezes leio a noite"), focus = "às vezes", watch = "às vezes = a veces."), PracticeQuestion(prompt = "Diga a que horas você acorda: às sete.", expected = listOf("Acordo às sete.", "acordo as sete"), focus = "acordar", watch = "às + hora."), PracticeQuestion(prompt = "Diga que muitas vezes você almoça em casa.", expected = listOf("Muitas vezes almoço em casa.", "muitas vezes almoco em casa"), focus = "muitas vezes", watch = "muitas vezes = muchas veces."))), exercises = listOf(Exercise(id = "pt-foundations-u13-rotina-e1", kind = "choice", prompt = "Eu ___ como tarde: é ruim dormir cheio.", options = listOf("nunca", "sempre", "muitas vezes"), answers = listOf("nunca"), explain = "nunca = 0%: a pessoa não come tarde."), Exercise(id = "pt-foundations-u13-rotina-e2", kind = "gap", prompt = "Eu acordo às sete e ___ tomo café. (100%)", options = listOf(), answers = listOf("sempre"), explain = "100% das vezes = sempre."), Exercise(id = "pt-foundations-u13-rotina-e3", kind = "order", prompt = "Diga o que você nunca faz com o jantar.", options = listOf(), answers = listOf("Eu nunca como tarde"), explain = "nunca + como + tarde: frequência zero."), Exercise(id = "pt-foundations-u13-rotina-e4", kind = "written", prompt = "Conte a sua manhã: acordar às sete e tomar café.", options = listOf(), answers = listOf("Acordo às sete e tomo café.", "acordo as sete e tomo cafe"), explain = "Duas ações da rotina no presente.")), skills = listOf("grammar:frequency-adverbs", "function:talk-about-routines", "vocab:daily-routine", "grammar:present-simple"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u13-clima", title = "Que tempo faz ?", goal = "Falar do clima e das estações: faz calor, chove, neva.", intro = LessonIntro(explanation = listOf("Perguntar o tempo: « Como está o tempo ? ». Responder com « está »: « Está quente », « Está frio ».", "Verbos do clima: « chove » (llueve), « neva » (nieva), « faz calor/frio ». « Hoje chove muito ».", "As estações: « o verão, o outono, o inverno, a primavera ». « No inverno faz frio »."), examples = listOf(ExampleLine(text = "Como está o tempo hoje ?", meaning = "Perguntar."), ExampleLine(text = "Está quente e ensolarado.", meaning = "está + tempo."), ExampleLine(text = "Hoje chove em São Paulo.", meaning = "chove = llueve."), ExampleLine(text = "No inverno faz frio.", meaning = "faz frio = hace frío."), ExampleLine(text = "No verão vou à praia.", meaning = "a estação quente."))), expressions = listOf(TargetExpression(text = "Como está o tempo ?", meaning = "Perguntar el clima.", note = "Como está o tempo hoje ?"), TargetExpression(text = "faz calor / faz frio", meaning = "Hace calor / frío.", note = "Hoje faz calor."), TargetExpression(text = "chove / neva", meaning = "Llueve / nieva.", note = "Chove muito em abril."), TargetExpression(text = "está quente / frio", meaning = "Temperatura agora.", note = "A água está fria."), TargetExpression(text = "as estações", meaning = "Las estaciones del año.", note = "verão, outono, inverno, primavera.")), situation = "Chove no sábado: o grupo do passeio decide ficar em casa e ver um filme.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pergunte o tempo de hoje.", expected = listOf("Como está o tempo hoje ?", "como esta o tempo hoje"), focus = "Como está o tempo ?", watch = "está com acento."), PracticeQuestion(prompt = "Diga que hoje faz calor.", expected = listOf("Hoje faz calor.", "hoje faz calor"), focus = "faz calor", watch = "faz calor = hace calor."), PracticeQuestion(prompt = "Diga que chove muito hoje.", expected = listOf("Hoje chove muito.", "chove muito hoje"), focus = "chove", watch = "chove = llueve."), PracticeQuestion(prompt = "Diga que no inverno faz frio.", expected = listOf("No inverno faz frio.", "no inverno faz frio"), focus = "faz frio", watch = "no inverno = en invierno."), PracticeQuestion(prompt = "Pergunte se está frio hoje.", expected = listOf("Está frio hoje ?", "esta frio hoje"), focus = "está + frio", watch = "pergunta com « está » no começo."))), exercises = listOf(Exercise(id = "pt-foundations-u13-clima-e1", kind = "choice", prompt = "No verão ___ muito calor no Rio de Janeiro.", options = listOf("faz", "chove", "neva"), answers = listOf("faz"), explain = "faz calor = hace calor: expressão fixa do clima."), Exercise(id = "pt-foundations-u13-clima-e2", kind = "gap", prompt = "Hoje ___ muito: pega o guarda-chuva.", options = listOf(), answers = listOf("chove"), explain = "Água do céu: chove."), Exercise(id = "pt-foundations-u13-clima-e3", kind = "order", prompt = "Diga o clima do inverno aqui. (frio)", options = listOf(), answers = listOf("No inverno faz frio aqui"), explain = "No + inverno + faz frio: estação + clima."), Exercise(id = "pt-foundations-u13-clima-e4", kind = "written", prompt = "Diga o tempo de hoje: quente e ensolarado.", options = listOf(), answers = listOf("Hoje está quente e ensolarado.", "hoje esta quente e ensolarado"), explain = "Hoje + está + dois adjetivos do clima.")), skills = listOf("function:talk-about-weather", "vocab:weather", "grammar:present-simple", "function:ask-simple-questions"), canDo = listOf("talk-about-weather"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u13-gostos", title = "O que eu gosto", goal = "Dizer o que você gosta: gosto de + infinitivo ou substantivo.", intro = LessonIntro(explanation = listOf("« Gostar » pede « de »: « Eu gosto de música ». « Gosto de dançar » (bailar).", "Depois de « de », verbo no infinitivo: « gosto de ler, de cozinhar, de caminhar ».", "Negativo: « Não gosto de frio ». Perguntar: « O que você gosta de fazer ? »."), examples = listOf(ExampleLine(text = "Eu gosto de música brasileira.", meaning = "gosto de + substantivo."), ExampleLine(text = "Gosto de ler à noite.", meaning = "gosto de + infinitivo."), ExampleLine(text = "Minha irmã gosta de cozinhar.", meaning = "gosta (ela)."), ExampleLine(text = "Não gosto de frio.", meaning = "não gosto de."), ExampleLine(text = "O que você gosta de fazer ?", meaning = "Perguntar gostos."))), expressions = listOf(TargetExpression(text = "gosto de …", meaning = "Me gusta…", note = "Gosto de praia."), TargetExpression(text = "não gosto de …", meaning = "No me gusta…", note = "Não gosto de frio."), TargetExpression(text = "gosta de … ?", meaning = "Perguntar o gosto dele/dela.", note = "O que ela gosta de fazer ?"), TargetExpression(text = "ler", meaning = "Leer.", note = "Gosto de ler."), TargetExpression(text = "caminhar", meaning = "Caminar.", note = "Gosto de caminhar no parque.")), situation = "Cada amigo do grupo conta o que gosta de fazer no tempo livre: ler, cozinhar, caminhar.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga que você gosta de música.", expected = listOf("Gosto de música.", "gosto de musica"), focus = "gosto de", watch = "gosto + de."), PracticeQuestion(prompt = "Diga que você gosta de ler à noite.", expected = listOf("Gosto de ler à noite.", "gosto de ler a noite"), focus = "gosto de + infinitivo", watch = "ler = leer."), PracticeQuestion(prompt = "Diga que a sua irmã gosta de cozinhar.", expected = listOf("Minha irmã gosta de cozinhar.", "minha irma gosta de cozinhar"), focus = "gosta de", watch = "ela gosta."), PracticeQuestion(prompt = "Diga que você não gosta de frio.", expected = listOf("Não gosto de frio.", "nao gosto de frio"), focus = "não gosto de", watch = "não antes do verbo."), PracticeQuestion(prompt = "Pergunte o que a amiga gosta de fazer.", expected = listOf("O que você gosta de fazer ?", "o que voce gosta de fazer"), focus = "gosta de fazer", watch = "o que + gosta de."))), exercises = listOf(Exercise(id = "pt-foundations-u13-gostos-e1", kind = "choice", prompt = "___ gosto muito de música. (eu)", options = listOf("Gosto", "Gosta", "Gostam", "Gostamos"), answers = listOf("Gosto"), explain = "Eu gosto: 1ª pessoa do singular."), Exercise(id = "pt-foundations-u13-gostos-e2", kind = "gap", prompt = "Ela não gosta ___ esperar.", options = listOf(), answers = listOf("de"), explain = "gostar de: gosta de + infinitivo."), Exercise(id = "pt-foundations-u13-gostos-e3", kind = "order", prompt = "Diga um gosto seu. (música)", options = listOf(), answers = listOf("Eu gosto de musica"), explain = "gosto de + substantivo."), Exercise(id = "pt-foundations-u13-gostos-e4", kind = "written", prompt = "Fale dos seus gostos: música e ler.", options = listOf(), answers = listOf("Gosto de música e de ler.", "gosto de musica e de ler"), explain = "Dois gostos com gosto de + substantivo e infinitivo.")), skills = listOf("vocab:hobbies", "grammar:present-simple", "function:talk-about-routines", "vocab:social-expressions"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple"))))
}

