 oder lieber ins cafe"), explain = "oder lieber … ? stellt die Alternative.")), skills = listOf("function:make-suggestions", "grammar:going-to", "vocab:social-expressions", "grammar:present-simple"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "de-foundations-u17-entschuldigung", title = "Schade, ich kann nicht", goal = "Einladungen annehmen und höflich ablehnen — mit Grund (weil/denn) und Alternative.", intro = LessonIntro(explanation = listOf("Zusagen geht kurz und warm: « Ja, gerne ! » oder « Ich bin dabei. »", "Absagen mit Bedauern: « Schade, ich kann nicht. » Höflich bleibt die Absage mit Grund: « Ich kann leider nicht, weil ich arbeiten muss. »", "Der Grund: weil + Verb am Ende, denn + normale Reihenfolge: « …, denn ich habe keine Zeit. » Danach eine Alternative: « Geht Sonntag auch ? »"), examples = listOf(ExampleLine(text = "Ja, gerne ! Ich bin dabei.", meaning = "Die Zusage."), ExampleLine(text = "Schade, ich kann nicht.", meaning = "Die kurze Absage."), ExampleLine(text = "Ich kann leider nicht, weil ich arbeiten muss.", meaning = "weil + Verb am Ende."), ExampleLine(text = "Ich habe keine Zeit, denn ich lerne für die Prüfung.", meaning = "denn + normale Reihenfolge."), ExampleLine(text = "Geht es am Sonntag auch ?", meaning = "Alternative anbieten."))), expressions = listOf(TargetExpression(text = "Ich bin dabei !", meaning = "Zusagen.", note = "auch: gerne !"), TargetExpression(text = "Schade !", meaning = "Bedauern.", note = "Schade, vielleicht nächstes Mal."), TargetExpression(text = "…, weil … muss", meaning = "Grund mit weil.", note = "weil ich arbeiten muss"), TargetExpression(text = "…, denn …", meaning = "Grund mit denn.", note = "denn ich habe keine Zeit"), TargetExpression(text = "Geht … auch ?", meaning = "Alternative.", note = "Geht Sonntag auch ?")), situation = "Paul ist eingeladen, aber er arbeitet am Samstag. Er sagt höflich ab, nennt den Grund mit weil und fragt nach einer Alternative am Sonntag.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sag zu, mit Begeisterung.", expected = listOf("Ja, gerne !", "ja gerne", "Ich bin dabei !", "ich bin dabei"), focus = "ja gerne", watch = "Zusagen: Ja, gerne !"), PracticeQuestion(prompt = "Sag ab, kurz und mit Bedauern.", expected = listOf("Schade, ich kann nicht.", "schade ich kann nicht", "Schade, ich kann leider nicht."), focus = "schade", watch = "Schade + ich kann (leider) nicht."), PracticeQuestion(prompt = "Gib den Grund mit weil: du musst arbeiten.", expected = listOf("Ich kann nicht, weil ich arbeiten muss.", "ich kann nicht weil ich arbeiten muss"), focus = "weil", watch = "weil + Verb am Ende."), PracticeQuestion(prompt = "Gib den Grund mit denn: du lernst.", expected = listOf("Ich habe keine Zeit, denn ich lerne.", "ich habe keine zeit denn ich lerne"), focus = "denn", watch = "denn + normale Reihenfolge."), PracticeQuestion(prompt = "Biete Sonntag als Alternative an.", expected = listOf("Geht es am Sonntag auch ?", "geht es am sonntag auch", "Geht Sonntag auch ?"), focus = "geht es … auch", watch = "Alternative: Geht Sonntag auch ?"))), exercises = listOf(Exercise(id = "de-foundations-u17-entschuldigung-e1", kind = "choice", prompt = "« Schade, ich ___ leider nicht. »", options = listOf("kann", "will", "mag", "darf"), answers = listOf("kann"), explain = "Die Absage: ich kann leider nicht."), Exercise(id = "de-foundations-u17-entschuldigung-e2", kind = "gap", prompt = "Ich kann nicht, ___ ich arbeiten muss.", options = listOf(), answers = listOf("weil"), explain = "weil + Nebensatz: das Verb steht am Ende."), Exercise(id = "de-foundations-u17-entschuldigung-e3", kind = "order", prompt = "Lehne ab und nenne den Grund mit weil: du hast eine Prüfung.", options = listOf(), answers = listOf("Ich kann nicht weil ich eine Prüfung habe"), explain = "Erst die Absage, dann der Grund mit weil."), Exercise(id = "de-foundations-u17-entschuldigung-e4", kind = "written", prompt = "Sag ab und biete eine Alternative am Sonntag.", options = listOf(), answers = listOf("schade geht es am sonntag auch", "ich kann nicht geht es am sonntag auch", "ich kann leider nicht am sonntag"), explain = "Erst Absage, dann Alternative: Geht es am Sonntag auch ?")), skills = listOf("vocab:social-expressions", "function:make-suggestions", "grammar:present-simple", "grammar:connectors"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "de-foundations-u17-geschenk", title = "Das perfekte Geschenk", goal = "Geschenkpläne mit werden + Infinitiv sagen: was ihr verschenkt und kauft.", intro = LessonIntro(explanation = listOf("Pläne mit werden + Infinitiv: « Ich werde ihr ein Buch schenken. » Der Infinitiv steht am Satzende.", "Fragen: « Was wirst du Emma schenken ? » — « Ich werde ihr eine Kette kaufen. » ihr/ihm = für sie/ihn (Dativ).", "Geschenkverben mit werden: verschenken, kaufen, bestellen, einpacken: « Wir werden alles rechtzeitig bestellen. »"), examples = listOf(ExampleLine(text = "Ich werde ihr ein Buch schenken.", meaning = "Plan: werden + Infinitiv am Ende."), ExampleLine(text = "Was wirst du Emma schenken ?", meaning = "Frage nach dem Geschenk."), ExampleLine(text = "Er wird ihr Blumen kaufen.", meaning = "kaufen im Futur."), ExampleLine(text = "Wir werden eine Party organisieren.", meaning = "wir werden + Infinitiv."), ExampleLine(text = "Ich packe das Geschenk später ein.", meaning = "einpacken: trennbares Verb."))), expressions = listOf(TargetExpression(text = "werden + Infinitiv", meaning = "Pläne für die Zukunft.", note = "ich werde, du wirst, er wird"), TargetExpression(text = "schenken / kaufen / bestellen", meaning = "Geschenkverben.", note = "Ich werde ein Buch schenken."), TargetExpression(text = "Was wirst du … schenken ?", meaning = "Nach dem Geschenk fragen.", note = "ihm/ihr = Dativ"), TargetExpression(text = "eine Idee haben", meaning = "Den Plan geben.", note = "Ich habe eine Idee: ein Kochbuch !"), TargetExpression(text = "rechtzeitig", meaning = "pünktlich genug.", note = "Wir bestellen rechtzeitig.")), situation = "Emma wird zwanzig. Ihr plant: Paul wird ihr ein Kochbuch schenken, Mia wird Kerzen kaufen, und ihr werdet den Kuchen übernehmen.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sag deinen Geschenkplan: ein Buch für Emma.", expected = listOf("Ich werde Emma ein Buch schenken.", "ich werde emma ein buch schenken", "Ich werde ihr ein Buch schenken."), focus = "ich werde", watch = "werden + Infinitiv am Ende."), PracticeQuestion(prompt = "Frag Paul, was er Emma schenkt. (werden)", expected = listOf("Was wirst du Emma schenken ?", "was wirst du emma schenken", "Was wirst du ihr schenken ?"), focus = "wirst du", watch = "du wirst: Frage nach dem Plan."), PracticeQuestion(prompt = "Sag, dass Mia Kerzen kaufen wird.", expected = listOf("Mia wird Kerzen kaufen.", "mia wird kerzen kaufen"), focus = "mia wird", watch = "er/sie wird + Infinitiv."), PracticeQuestion(prompt = "Sagt euren Plan: ihr organisiert die Party.", expected = listOf("Wir werden eine Party organisieren.", "wir werden eine party organisieren"), focus = "wir werden", watch = "wir werden + Infinitiv."), PracticeQuestion(prompt = "Sag, dass du rechtzeitig bestellst. (werden)", expected = listOf("Ich werde rechtzeitig bestellen.", "ich werde rechtzeitig bestellen"), focus = "rechtzeitig", watch = "rechtzeitig bestellen = nicht zu spät."))), exercises = listOf(Exercise(id = "de-foundations-u17-geschenk-e1", kind = "choice", prompt = "Emma hat Geburtstag. Ich ___ ihr ein Buch schenken.", options = listOf("werde", "will", "möchte", "habe"), answers = listOf("werde"), explain = "werden + Infinitiv am Ende: ich werde schenken."), Exercise(id = "de-foundations-u17-geschenk-e2", kind = "gap", prompt = "Was ___ du ihm schenken ?", options = listOf(), answers = listOf("wirst"), explain = "du wirst: die Frage nach dem Geschenkplan."), Exercise(id = "de-foundations-u17-geschenk-e3", kind = "order", prompt = "Sagt euren Plan: ihr kauft Blumen für die Party.", options = listOf(), answers = listOf("Wir werden Blumen für die Party kaufen"), explain = "werden + Infinitiv am Ende: so sagt man den Plan."), Exercise(id = "de-foundations-u17-geschenk-e4", kind = "written", prompt = "Sag, was du zum Geburtstag planst. (Konzertkarten)", options = listOf(), answers = listOf("ich werde konzertkarten kaufen", "ich werde ihr konzertkarten kaufen", "ich werde meiner mutter konzertkarten kaufen"), explain = "Plan mit werden: ich werde … kaufen.")), skills = listOf("grammar:going-to", "function:make-future-plans", "vocab:social-expressions", "function:go-shopping"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to"))))
}

object DeFoundationsU20 {
    val unit = CourseUnit(id = "de-foundations-u20", title = "Alltagsprobleme", subtitle = "Kaputt und gelöst", level = "A2", themes = listOf(ConversationTheme("die-panne", "Die Panne", "Es ist kaputtgegangen", "wrench.and.screwdriver", "Course", "Die Lampe geht nicht mehr, das Handy war im Wasser: Was ist passiert ? Ihr erzählt Pannen im Perfekt.", 0),
                ConversationTheme("die-reklamation", "Die Reklamation", "Höflich reklamieren", "phone.badge.checkmark", "Course", "Der Wasserkocher ist kaputt: Anruf im Laden, Rechnung bereithalten, freundlich eine Lösung finden.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u20-defekt", title = "Es ist kaputtgegangen", goal = "Eine Panne im Perfekt erzählen: Was ist kaputtgegangen, was hast du gemacht ?", intro = LessonIntro(explanation = listOf("Pannen erzählt man im Perfekt: « Mein Handy ist kaputtgegangen. », « Die Lampe hat nicht mehr funktioniert. »", "sein oder haben ? Bewegung und Veränderung mit sein: « Das Glas ist runtergefallen. » Alles andere mit haben: « Ich habe die Schlüssel verloren. »", "Regelmäßige Partizipien auf -t: gemacht, gekauft, passiert — unregelmäßige: gegangen, verloren, gefunden."), examples = listOf(ExampleLine(text = "Mein Handy ist kaputtgegangen.", meaning = "sein + Partizip: Veränderung."), ExampleLine(text = "Die Lampe hat nicht mehr funktioniert.", meaning = "haben + Partizip."), ExampleLine(text = "Das Glas ist runtergefallen.", meaning = "Bewegung: runterfallen → ist."), ExampleLine(text = "Ich habe meine Schlüssel verloren.", meaning = "verlieren → verloren."), ExampleLine(text = "Was ist passiert ?", meaning = "Nach der Panne fragen."))), expressions = listOf(TargetExpression(text = "kaputtgehen → ist kaputtgegangen", meaning = "Defekt.", note = "Der Drucker ist kaputtgegangen."), TargetExpression(text = "Was ist passiert ?", meaning = "Nachfragen.", note = "Erzähl mal, was passiert ist."), TargetExpression(text = "nicht mehr funktionieren", meaning = "Defekt, sachlich.", note = "Der Drucker funktioniert nicht mehr."), TargetExpression(text = "verlieren → verloren", meaning = "Unregelmäßig.", note = "Ich habe meinen Schlüssel verloren."), TargetExpression(text = "runterfallen → ist runtergefallen", meaning = "sein + Partizip.", note = "Die Tasse ist runtergefallen.")), situation = "Mia erzählt ihre Panne vom Dienstag: Das Handy ist ins Wasser gefallen und ist kaputtgegangen. Paul fragt: « Was hast du dann gemacht ? » — sie hat es sofort ausgemacht.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Erzähle: dein Handy ist kaputtgegangen.", expected = listOf("Mein Handy ist kaputtgegangen.", "mein handy ist kaputtgegangen", "mein handy ist kaputt gegangen"), focus = "ist kaputtgegangen", watch = "sein + Partizip."), PracticeQuestion(prompt = "Frag nach der Panne.", expected = listOf("Was ist passiert ?", "was ist passiert"), focus = "was ist passiert", watch = "Feste Frage: Was ist passiert ?"), PracticeQuestion(prompt = "Erzähle im Perfekt: die Lampe funktioniert nicht mehr.", expected = listOf("Die Lampe hat nicht mehr funktioniert.", "die lampe hat nicht mehr funktioniert"), focus = "hat funktioniert", watch = "haben + Partizip."), PracticeQuestion(prompt = "Sag: du hast deine Schlüssel verloren.", expected = listOf("Ich habe meine Schlüssel verloren.", "ich habe meine schlüssel verloren", "Ich habe den Schlüssel verloren."), focus = "verloren", watch = "verlieren → verloren."), PracticeQuestion(prompt = "Erzähle die Panne mit der Tasse. (runterfallen)", expected = listOf("Die Tasse ist runtergefallen.", "die tasse ist runtergefallen", "die tasse ist runter gefallen"), focus = "ist runtergefallen", watch = "Bewegung: sein + Partizip."))), exercises = listOf(Exercise(id = "de-foundations-u20-defekt-e1", kind = "choice", prompt = "« Mein Handy ___ kaputtgegangen. »", options = listOf("ist", "hat", "bin", "wird"), answers = listOf("ist"), explain = "kaputtgehen mit sein: ist kaputtgegangen."), Exercise(id = "de-foundations-u20-defekt-e2", kind = "gap", prompt = "Ich ___ meine Brille verloren. (haben)", options = listOf(), answers = listOf("habe"), explain = "Perfekt mit haben: ich habe verloren."), Exercise(id = "de-foundations-u20-defekt-e3", kind = "order", prompt = "Erzähle die Panne: das Glas, runterfallen.", options = listOf(), answers = listOf("Das Glas ist runtergefallen"), explain = "sein + Partizip bei Bewegung: ist runtergefallen."), Exercise(id = "de-foundations-u20-defekt-e4", kind = "written", prompt = "Frag deinen Freund, was gestern passiert ist.", options = listOf(), answers = listOf("was ist passiert", "was ist gestern passiert", "was war los"), explain = "Die Frage nach der Panne: Was ist passiert ?")), skills = listOf("function:solve-problems", "grammar:past-simple-regular", "grammar:past-simple-irregular", "function:describe-past-events"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "de-foundations-u20-loesung", title = "Was soll ich tun ?", goal = "Um einfache Lösungen bitten und welche geben: Was soll ich tun ? — Zuerst …, dann …", intro = LessonIntro(explanation = listOf("Um Rat bitten: « Was soll ich tun ? » oder « Was kann ich machen ? » — so fragt man nach einer Lösung.", "Die Lösung kommt in Schritten: « Zuerst ausschalten, dann wieder einschalten. » danach und am Ende ordnen weitere Schritte.", "Eine Lösung anbieten: « Versuch es nochmal ! », « Du kannst den Kundendienst anrufen. » — und die Rückmeldung: « Das hat geholfen. »"), examples = listOf(ExampleLine(text = "Was soll ich tun ?", meaning = "Um Rat bitten."), ExampleLine(text = "Zuerst ausschalten, dann wieder einschalten.", meaning = "Die Lösung in Schritten."), ExampleLine(text = "Versuch es nochmal.", meaning = "Ein erster Tipp."), ExampleLine(text = "Du kannst den Kundendienst anrufen.", meaning = "Lösung mit können."), ExampleLine(text = "Danach hat es wieder funktioniert.", meaning = "danach ordnet die Schritte."))), expressions = listOf(TargetExpression(text = "Was soll ich tun ?", meaning = "Um Rat bitten.", note = "auch: Was kann ich machen ?"), TargetExpression(text = "zuerst …, dann …", meaning = "Schritte ordnen.", note = "Zuerst ausschalten, dann einschalten."), TargetExpression(text = "Versuch es nochmal.", meaning = "Erster Tipp.", note = "auch: Probier es nochmal !"), TargetExpression(text = "Du kannst … anrufen.", meaning = "Lösung anbieten.", note = "den Kundendienst, den Notdienst"), TargetExpression(text = "Das hat geholfen.", meaning = "Die Lösung war gut.", note = "Danach hat alles funktioniert.")), situation = "Kim kann das WLAN nicht einschalten. Paul fragt: « Was hast du gemacht ? » Kim: « Ich weiß nicht, was ich tun soll. » Paul: « Zuerst den Router ausschalten, dann wieder einschalten. » — danach hat es funktioniert.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Frag deinen Kollegen um Rat.", expected = listOf("Was soll ich tun ?", "was soll ich tun", "Was kann ich machen ?"), focus = "was soll ich", watch = "Um Rat bitten: Was soll ich tun ?"), PracticeQuestion(prompt = "Gib den ersten Schritt: ausschalten.", expected = listOf("Zuerst ausschalten.", "zuerst ausschalten", "Zuerst den Router ausschalten."), focus = "zuerst", watch = "zuerst = Schritt eins."), PracticeQuestion(prompt = "Gib den zweiten Schritt: wieder einschalten.", expected = listOf("Dann wieder einschalten.", "dann wieder einschalten", "Danach wieder einschalten."), focus = "dann", watch = "dann = der nächste Schritt."), PracticeQuestion(prompt = "Empfiehl deinem Freund, den Kundendienst anzurufen. (können)", expected = listOf("Du kannst den Kundendienst anrufen.", "du kannst den kundendienst anrufen"), focus = "du kannst", watch = "Lösung: Du kannst … anrufen."), PracticeQuestion(prompt = "Sag, dass es danach funktioniert hat.", expected = listOf("Danach hat es funktioniert.", "danach hat es funktioniert", "Danach hat es wieder funktioniert."), focus = "danach", watch = "danach + Perfekt."))), exercises = listOf(Exercise(id = "de-foundations-u20-loesung-e1", kind = "choice", prompt = "« Was ___ ich tun ? » (um Rat bitten)", options = listOf("soll", "will", "mag", "hat"), answers = listOf("soll"), explain = "Um Rat bitten: Was soll ich tun ?"), Exercise(id = "de-foundations-u20-loesung-e2", kind = "gap", prompt = "___ den Router ausschalten, dann wieder einschalten.", options = listOf(), answers = listOf("Zuerst"), explain = "Schritt eins: zuerst."), Exercise(id = "de-foundations-u20-loesung-e3", kind = "order", prompt = "Biete als Lösung an: dein Freund ruft den Kundendienst an.", options = listOf(), answers = listOf("Du kannst den Kundendienst anrufen"), explain = "Lösung anbieten mit können: Du kannst … anrufen."), Exercise(id = "de-foundations-u20-loesung-e4", kind = "written", prompt = "Frag um Rat, weil du nicht weiterweißt.", options = listOf(), answers = listOf("was soll ich tun", "was kann ich machen", "was soll ich machen"), explain = "Was soll ich tun ? — die Frage nach der Lösung.")), skills = listOf("function:solve-problems", "function:make-requests", "grammar:connectors", "vocab:social-expressions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "de-foundations-u20-reklamation", title = "Eine freundliche Reklamation", goal = "Etwas Kaputtes höflich reklamieren: Problem sagen, Rechnung nennen, eine Lösung fragen.", intro = LessonIntro(explanation = listOf("Höflich einleiten: « Es tut mir leid, aber der Wasserkocher funktioniert nicht mehr. » — aber verbindet Höflichkeit und Problem.", "Fakten nennen: « Ich habe ihn letzte Woche gekauft, hier ist die Rechnung. » deshalb verbindet Grund und Forderung: « Deshalb möchte ich ihn umtauschen. »", "Nach der Lösung fragen: « Kann ich ihn umtauschen ? » oder « Kann ich mein Geld zurückbekommen ? »"), examples = listOf(ExampleLine(text = "Es tut mir leid, aber das Gerät funktioniert nicht.", meaning = "Höflich reklamieren."), ExampleLine(text = "Ich habe es letzte Woche gekauft.", meaning = "Fakt im Perfekt."), ExampleLine(text = "Hier ist die Rechnung.", meaning = "Der Beleg."), ExampleLine(text = "Deshalb möchte ich es umtauschen.", meaning = "deshalb + Forderung."), ExampleLine(text = "Kann ich mein Geld zurückbekommen ?", meaning = "Nach der Lösung fragen."))), expressions = listOf(TargetExpression(text = "Es tut mir leid, aber …", meaning = "Höflich einleiten.", note = "… es funktioniert nicht."), TargetExpression(text = "funktioniert nicht mehr", meaning = "Das Problem.", note = "Das Gerät funktioniert nicht mehr."), TargetExpression(text = "die Rechnung / der Beleg", meaning = "Der Beweis.", note = "Hier ist die Rechnung."), TargetExpression(text = "umtauschen / zurückgeben", meaning = "Die Lösung fragen.", note = "Kann ich es umtauschen ?"), TargetExpression(text = "deshalb", meaning = "Grund + Forderung.", note = "Deshalb rufe ich an.")), situation = "Anna ruft im Laden an: « Es tut mir leid, aber der Wasserkocher funktioniert nicht mehr. Ich habe ihn letzte Woche gekauft — hier ist die Rechnung. Kann ich ihn umtauschen ? » — « Natürlich, bringen Sie ihn mit der Rechnung vorbei. »", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Reklamiere höflich: das Gerät funktioniert nicht.", expected = listOf("Es tut mir leid, aber das Gerät funktioniert nicht.", "es tut mir leid aber das gerät funktioniert nicht", "es tut mir leid aber das geraet funktioniert nicht"), focus = "es tut mir leid", watch = "Höflich: Es tut mir leid, aber …"), PracticeQuestion(prompt = "Sag, wann du es gekauft hast: letzte Woche.", expected = listOf("Ich habe es letzte Woche gekauft.", "ich habe es letzte woche gekauft"), focus = "habe gekauft", watch = "Perfekt: habe gekauft."), PracticeQuestion(prompt = "Zeig auf die Rechnung.", expected = listOf("Hier ist die Rechnung.", "hier ist die rechnung"), focus = "die rechnung", watch = "die Rechnung = der Beleg."), PracticeQuestion(prompt = "Frag, ob du es umtauschen kannst.", expected = listOf("Kann ich es umtauschen ?", "kann ich es umtauschen"), focus = "umtauschen", watch = "umtauschen = ein anderes bekommen."), PracticeQuestion(prompt = "Frag nach dem Geld zurück.", expected = listOf("Kann ich mein Geld zurückbekommen ?", "kann ich mein geld zurückbekommen", "kann ich mein geld zurueckbekommen"), focus = "zurückbekommen", watch = "zurückbekommen: Geld zurück."))), exercises = listOf(Exercise(id = "de-foundations-u20-reklamation-e1", kind = "choice", prompt = "« Es tut mir ___, aber das Gerät funktioniert nicht. »", options = listOf("leid", "schade", "gut", "schlecht"), answers = listOf("leid"), explain = "Die feste Formel: Es tut mir leid."), Exercise(id = "de-foundations-u20-reklamation-e2", kind = "gap", prompt = "Ich habe ihn letzte Woche gekauft, ___ möchte ich ihn umtauschen.", options = listOf(), answers = listOf("deshalb"), explain = "deshalb verbindet Grund und Forderung."), Exercise(id = "de-foundations-u20-reklamation-e3", kind = "order", prompt = "Frag im Laden nach dem Geld zurück.", options = listOf(), answers = listOf("Kann ich mein Geld zurückbekommen"), explain = "Nach der Lösung fragen: Geld zurückbekommen."), Exercise(id = "de-foundations-u20-reklamation-e4", kind = "written", prompt = "Sag höflich, dass der Drucker nicht mehr funktioniert.", options = listOf(), answers = listOf("es tut mir leid aber der drucker funktioniert nicht", "es tut mir leid, aber der drucker funktioniert nicht mehr", "der drucker funktioniert leider nicht mehr"), explain = "Höflich: Es tut mir leid, aber … funktioniert nicht mehr.")), skills = listOf("function:solve-problems", "grammar:present-questions", "vocab:social-expressions", "grammar:connectors"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors"))))
}

object DeFoundationsU24 {
    val unit = CourseUnit(id = "de-foundations-u24", title = "Große Einkäufe", subtitle = "Vergleichen und entscheiden", level = "A2", themes = listOf(ConversationTheme("der-vergleich", "Der Vergleich", "Besser oder am besten ?", "cart", "Course", "Sofa, Laptop, Fernseher: günstiger als, am teuersten — der Warenkorb wird mit dem Kopf gefüllt.", 0),
                ConversationTheme("die-ratenzahlung", "Auf Raten", "Bezahlen ohne alles auf einmal", "creditcard", "Course", "600 Euro auf einmal ? Geht nicht — geht doch: in Raten, mit Begründung und Plan.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u24-vergleichen", title = "Besser oder am besten ?", goal = "Produkte vergleichen: günstiger als, am günstigsten — so findest du das beste Angebot.", intro = LessonIntro(explanation = listOf("Vergleichen mit als: « Dieses Sofa ist günstiger als das andere. » — Adjektiv + -er + als.", "Der Spitzenreiter mit am + -sten: « Dieser Laptop ist am teuersten. » — unregelmäßig: gut → besser → am besten.", "Meinung mit finden: « Ich finde dieses Modell besser — es hat mehr Speicher. »"), examples = listOf(ExampleLine(text = "Dieses Sofa ist günstiger als das andere.", meaning = "Vergleich mit als."), ExampleLine(text = "Der Tisch ist größer und schwerer.", meaning = "Kurze Adjektive: + er."), ExampleLine(text = "Dieser Laptop ist am teuersten.", meaning = "Die Spitze mit am + -sten."), ExampleLine(text = "Aber er ist auch am besten.", meaning = "gut → besser → am besten."), ExampleLine(text = "Ich finde das Modell besser.", meaning = "Meinung + Vergleich."))), expressions = listOf(TargetExpression(text = "… -er als", meaning = "Vergleichen.", note = "günstiger als, größer als"), TargetExpression(text = "am … -sten", meaning = "Die Spitze.", note = "am billigsten, am schnellsten"), TargetExpression(text = "gut → besser → am besten", meaning = "Unregelmäßig.", note = "Dieses Angebot ist am besten."), TargetExpression(text = "viel → mehr", meaning = "Auch unregelmäßig.", note = "Er hat mehr Speicher."), TargetExpression(text = "Ich finde … besser", meaning = "Meinung + Vergleich.", note = "Ich finde Variante A besser.")), situation = "Lena sucht ein Sofa. Das erste ist billig aber klein, das zweite ist teuer. Online vergleicht sie: « Dieses hier ist günstiger als das rote — und am bequemsten. Ich nehme es ! »", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Vergleiche: das grüne Sofa ist günstiger als das rote.", expected = listOf("Das grüne Sofa ist günstiger als das rote.", "das grüne sofa ist günstiger als das rote", "das gruene sofa ist guenstiger als das rote"), focus = "günstiger als", watch = "Adjektiv + -er + als."), PracticeQuestion(prompt = "Sag: dieser Laptop ist der teuerste.", expected = listOf("Dieser Laptop ist am teuersten.", "dieser laptop ist am teuersten", "Das ist der teuerste Laptop."), focus = "am teuersten", watch = "Spitze: am + Adjektiv + -sten."), PracticeQuestion(prompt = "Sag: dieses Angebot ist das beste.", expected = listOf("Dieses Angebot ist am besten.", "dieses angebot ist am besten", "Das Angebot ist das beste."), focus = "am besten", watch = "gut → besser → am besten."), PracticeQuestion(prompt = "Sag deine Meinung: Modell A gefällt dir besser.", expected = listOf("Ich finde Modell A besser.", "ich finde modell a besser", "Modell A ist besser."), focus = "ich finde", watch = "finden + Komparativ."), PracticeQuestion(prompt = "Sag: der neue Fernseher hat mehr Speicher.", expected = listOf("Der neue Fernseher hat mehr Speicher.", "der neue fernseher hat mehr speicher"), focus = "mehr", watch = "viel → mehr."))), exercises = listOf(Exercise(id = "de-foundations-u24-vergleichen-e1", kind = "choice", prompt = "« Dieser Tisch ist ___ als der alte. »", options = listOf("kleiner", "am kleinsten", "klein", "so klein"), answers = listOf("kleiner"), explain = "Vergleich mit als: Adjektiv + -er."), Exercise(id = "de-foundations-u24-vergleichen-e2", kind = "gap", prompt = "Von allen ist dieses Angebot am ___. (gut)", options = listOf(), answers = listOf("besten"), explain = "unregelmäßig: gut → am besten."), Exercise(id = "de-foundations-u24-vergleichen-e3", kind = "order", prompt = "Vergleiche das Sofa mit dem Stuhl. (bequem)", options = listOf(), answers = listOf("Das Sofa ist bequemer als der Stuhl"), explain = "bequem → bequemer + als."), Exercise(id = "de-foundations-u24-vergleichen-e4", kind = "written", prompt = "Vergleiche zwei Handys: eines ist günstiger.", options = listOf(), answers = listOf("das eine ist günstiger als das andere", "das eine ist guenstiger als das andere", "eins ist billiger als das andere", "dieses handy ist günstiger als das andere", "dieses handy ist guenstiger als das andere"), explain = "Vergleichssatz: … -er als …")), skills = listOf("grammar:comparatives", "function:go-shopping", "grammar:superlatives", "vocab:shopping"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:comparatives")),
    Lesson(id = "de-foundations-u24-rueckgabe", title = "Zurückgeben", goal = "Probleme im Laden lösen: im Perfekt sagen, was du gekauft hast — und umtauschen.", intro = LessonIntro(explanation = listOf("Was war ? Perfekt: « Ich habe die Jacke gestern gekauft. », « Sie hat nicht funktioniert. » — haben + Partizip.", "Die Bitte: « Ich möchte die Jacke zurückgeben. » oder « Kann ich sie umtauschen ? »", "Ohne Quittung geht nichts: « Haben Sie die Quittung ? » — « Ja, zum Glück noch. »"), examples = listOf(ExampleLine(text = "Ich habe diese Maschine letzte Woche gekauft.", meaning = "Perfekt mit haben."), ExampleLine(text = "Sie hat nicht funktioniert.", meaning = "Das Problem im Perfekt."), ExampleLine(text = "Ich möchte das Geld zurück.", meaning = "Die Rückgabe."), ExampleLine(text = "Kann ich sie umtauschen ?", meaning = "Gegen etwas anderes tauschen."), ExampleLine(text = "Haben Sie die Quittung dabei ?", meaning = "Der Beweis."))), expressions = listOf(TargetExpression(text = "Ich habe … gekauft.", meaning = "Perfekt + Einkauf.", note = "… die Schuhe am Montag gekauft."), TargetExpression(text = "Es hat nicht funktioniert.", meaning = "Das Problem sagen.", note = "Das Gerät war kaputt."), TargetExpression(text = "… zurückgeben", meaning = "Zurück zum Laden.", note = "Ich möchte es zurückgeben."), TargetExpression(text = "… umtauschen", meaning = "Gegen Neues tauschen.", note = "Kann ich die Größe umtauschen ?"), TargetExpression(text = "die Quittung", meaning = "Der Beleg.", note = "Ohne Quittung keine Rückgabe.")), situation = "Paul hat gestern einen Drucker gekauft — er hat nicht funktioniert. Im Laden zeigt er die Quittung: « Ich möchte das Geld zurück. » Er bekommt es und bestellt eine andere Marke.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Erzähl: du hast gestern eine Jacke gekauft. (Perfekt)", expected = listOf("Ich habe gestern eine Jacke gekauft.", "ich habe gestern eine jacke gekauft"), focus = "habe gekauft", watch = "Perfekt: haben + gekauft."), PracticeQuestion(prompt = "Sag das Problem: der Drucker hat nicht funktioniert.", expected = listOf("Der Drucker hat nicht funktioniert.", "der drucker hat nicht funktioniert", "Er hat nicht funktioniert."), focus = "hat funktioniert", watch = "Perfekt mit haben."), PracticeQuestion(prompt = "Gib die Jacke zurück.", expected = listOf("Ich möchte die Jacke zurückgeben.", "ich möchte die jacke zurückgeben", "Ich will die Jacke zurückgeben."), focus = "zurückgeben", watch = "trennbar: zurück + geben."), PracticeQuestion(prompt = "Frag, ob du sie umtauschen kannst.", expected = listOf("Kann ich sie umtauschen ?", "kann ich sie umtauschen", "Kann ich die Jacke umtauschen ?"), focus = "umtauschen", watch = "umtauschen = gegen etwas anderes tauschen."), PracticeQuestion(prompt = "Frag die Kundin nach ihrer Quittung.", expected = listOf("Haben Sie die Quittung ?", "haben sie die quittung", "Haben Sie die Quittung dabei ?"), focus = "die quittung", watch = "Ohne Quittung keine Rückgabe."))), exercises = listOf(Exercise(id = "de-foundations-u24-rueckgabe-e1", kind = "choice", prompt = "« Ich ___ die Jacke gestern gekauft. »", options = listOf("habe", "bin", "war", "hatte"), answers = listOf("habe"), explain = "Perfekt mit haben: habe gekauft."), Exercise(id = "de-foundations-u24-rueckgabe-e2", kind = "gap", prompt = "Die Maschine hat nicht ___. (funktionieren)", options = listOf(), answers = listOf("funktioniert"), explain = "Partizip: hat funktioniert."), Exercise(id = "de-foundations-u24-rueckgabe-e3", kind = "order", prompt = "Sag: du willst das Geld zurück.", options = listOf(), answers = listOf("Ich möchte das Geld zurück"), explain = "Rückgabe: das Geld zurück (bekommen)."), Exercise(id = "de-foundations-u24-rueckgabe-e4", kind = "written", prompt = "Frag, ob du den Pullover umtauschen kannst.", options = listOf(), answers = listOf("kann ich den pullover umtauschen", "kann ich den pulli umtauschen", "kann ich ihn umtauschen"), explain = "umtauschen: Kann ich … umtauschen ?")), skills = listOf("function:solve-problems", "grammar:past-simple-regular", "function:make-requests", "vocab:shopping"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "de-foundations-u24-raten", title = "In Raten zahlen", goal = "Große Käufe planen: deshalb und denn begründen, zuerst und dann ordnen — und in Raten zahlen.", intro = LessonIntro(explanation = listOf("Preise begründen mit denn und deshalb: « Der Fernseher ist teuer, denn er hat viel Technik. » — « Deshalb zahle ich in Raten. »", "Planen mit zuerst … dann: « Zuerst zahle ich mehr, dann jeden Monat 50 Euro. »", "Raten fragen: « Kann ich in Raten zahlen ? », « Wie viel ist es pro Monat ? »"), examples = listOf(ExampleLine(text = "Kann ich in Raten zahlen ?", meaning = "Die Frage beim großen Kauf."), ExampleLine(text = "600 Euro, in Raten 50 pro Monat.", meaning = "Der Ratenplan."), ExampleLine(text = "Der Fernseher ist teuer, deshalb zahle ich in Raten.", meaning = "deshalb begründet die Folge."), ExampleLine(text = "Zuerst zahle ich mehr, dann weniger.", meaning = "Reihenfolge mit dann."), ExampleLine(text = "Ich nehme ihn, denn der Preis passt.", meaning = "denn begründet nebenbei."))), expressions = listOf(TargetExpression(text = "in Raten zahlen", meaning = "Monat für Monat zahlen.", note = "12 Raten à 50 Euro"), TargetExpression(text = "deshalb", meaning = "Begründen.", note = "Teuer, deshalb in Raten."), TargetExpression(text = "denn", meaning = "Begründen, nebenbei.", note = "Ich zahle in Raten, denn ich spare."), TargetExpression(text = "zuerst … dann …", meaning = "Reihenfolge.", note = "Zuerst Anzahlung, dann Raten."), TargetExpression(text = "pro Monat", meaning = "Der Monatspreis.", note = "50 Euro pro Monat")), situation = "Lena kauft einen Fernseher für 600 Euro. « Kann ich in Raten zahlen ? » — Ja: 12 Raten à 50 Euro. Sie sagt ja, denn so bleibt Geld für den Umzug übrig.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Frag im Geschäft, ob du in Raten zahlen kannst.", expected = listOf("Kann ich in Raten zahlen ?", "kann ich in raten zahlen"), focus = "in raten", watch = "in Raten = jeden Monat ein Stück."), PracticeQuestion(prompt = "Begründe mit deshalb: der Fernseher ist teuer, du zahlst in Raten.", expected = listOf("Der Fernseher ist teuer, deshalb zahle ich in Raten.", "der fernseher ist teuer deshalb zahle ich in raten", "Er ist teuer, deshalb zahle ich in Raten."), focus = "deshalb", watch = "deshalb + Verb an Position 2."), PracticeQuestion(prompt = "Begründe mit denn: du nimmst ihn, der Preis passt.", expected = listOf("Ich nehme ihn, denn der Preis passt.", "ich nehme ihn denn der preis passt"), focus = "denn", watch = "denn + Hauptsatz: kein neuer Verbplatz."), PracticeQuestion(prompt = "Sag die Reihenfolge: zuerst Anzahlung, dann Raten.", expected = listOf("Zuerst zahle ich die Anzahlung, dann die Raten.", "zuerst zahle ich die anzahlung dann die raten", "Zuerst die Anzahlung, dann die Raten."), focus = "zuerst dann", watch = "zuerst … dann … ordnet den Plan."), PracticeQuestion(prompt = "Frag nach dem Monatspreis: 50 Euro.", expected = listOf("Wie viel ist es pro Monat ?", "wie viel ist es pro monat", "Sind es 50 Euro pro Monat ?"), focus = "pro monat", watch = "pro Monat = jeden Monat."))), exercises = listOf(Exercise(id = "de-foundations-u24-raten-e1", kind = "choice", prompt = "« Der Fernseher ist teuer, ___ zahle ich in Raten. »", options = listOf("deshalb", "denn", "aber", "oder"), answers = listOf("deshalb"), explain = "deshalb + Verb an Position 2: die Begründung."), Exercise(id = "de-foundations-u24-raten-e2", kind = "gap", prompt = "Ich zahle 50 Euro pro ___. (jeden Monat)", options = listOf(), answers = listOf("Monat"), explain = "pro Monat = jeden Monat."), Exercise(id = "de-foundations-u24-raten-e3", kind = "order", prompt = "Frag, ob Ratenzahlung möglich ist.", options = listOf(), answers = listOf("Kann ich in Raten zahlen"), explain = "Kann ich in Raten zahlen ? — die Standardfrage."), Exercise(id = "de-foundations-u24-raten-e4", kind = "written", prompt = "Begründe mit denn: du kaufst das Sofa, es ist günstig.", options = listOf(), answers = listOf("ich kaufe das sofa denn es ist günstig", "ich kaufe das sofa denn es ist guenstig", "ich nehme das sofa denn es ist günstig", "ich nehme das sofa denn es ist guenstig"), explain = "denn begründet im selben Satz.")), skills = listOf("function:go-shopping", "grammar:connectors", "vocab:shopping", "vocab:social-expressions"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:connectors"))))
}

object DeFoundationsU25 {
    val unit = CourseUnit(id = "de-foundations-u25", title = "Reise vorbereiten", subtitle = "Koffer, Buchung, Abreise", level = "A2", themes = listOf(ConversationTheme("der-koffer", "Der Koffer", "Packen mit Plan", "suitcase", "Course", "Was kommt mit — und was kommt in die Handtasche ? Reisepass, Ticket, Adapter: Nina packt mit Liste.", 0),
                ConversationTheme("die-abreise", "Die Abreise", "Buchen und losfahren", "airplane", "Course", "Flug um neun, Taxi um sieben: am Vortag wird geplant, gebucht und zweimal kontrolliert.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u25-koffer", title = "Koffer und Dokumente", goal = "Packen mit werden: Ich werde den Reisepass einpacken — so planst du deinen Koffer.", intro = LessonIntro(explanation = listOf("Futur mit werden: « Ich werde nur das Wichtigste einpacken. » — werden + Infinitiv am Satzende.", "Dokumente zuerst: « Der Reisepass kommt in die Handtasche. » — Reisepass, Ausweis, Buchungsbestätigung.", "Bitten beim Packen: « Kannst du mir den Adapter geben ? » — kurz und konkret."), examples = listOf(ExampleLine(text = "Ich werde den Koffer heute Abend packen.", meaning = "Futur: werden + Infinitiv."), ExampleLine(text = "Du wirst alles Nötige finden.", meaning = "du wirst + Infinitiv."), ExampleLine(text = "Der Reisepass kommt in die Handtasche.", meaning = "Dokumente sicher verstauen."), ExampleLine(text = "Brauche ich ein Visum ?", meaning = "Vor der Reise nachfragen."), ExampleLine(text = "Kannst du mir den Adapter geben ?", meaning = "Die Bitte beim Packen."))), expressions = listOf(TargetExpression(text = "ich werde … + Infinitiv", meaning = "Futur planen.", note = "Ich werde früh packen."), TargetExpression(text = "der Reisepass / der Ausweis", meaning = "Die Dokumente.", note = "Ohne Pass keine Reise."), TargetExpression(text = "die Buchungsbestätigung", meaning = "Der Beleg fürs Hotel.", note = "auf dem Handy und gedruckt"), TargetExpression(text = "packen / einpacken", meaning = "In den Koffer.", note = "Ich packe den Koffer."), TargetExpression(text = "der Stecker-Adapter", meaning = "Fürs Ausland.", note = "Brauche ich einen Adapter ?")), situation = "Nina packt mit Liste: « Ich werde nur das Wichtigste mitnehmen. » Der Reisepass kommt in die Handtasche, der Adapter in den Koffer — und Ben gibt ihr die Buchungsbestätigung.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sag deinen Pack-Plan: du packst heute Abend. (werden)", expected = listOf("Ich werde den Koffer heute Abend packen.", "ich werde den koffer heute abend packen", "Ich werde heute Abend packen."), focus = "werde packen", watch = "werden + Infinitiv am Ende."), PracticeQuestion(prompt = "Sag: der Pass kommt in die Handtasche.", expected = listOf("Der Reisepass kommt in die Handtasche.", "der reisepass kommt in die handtasche", "Der Pass kommt in die Handtasche."), focus = "der reisepass", watch = "Dokumente in die Handtasche."), PracticeQuestion(prompt = "Frag, ob du ein Visum brauchst.", expected = listOf("Brauche ich ein Visum ?", "brauche ich ein visum", "Muss ich ein Visum haben ?"), focus = "visum", watch = "Brauche ich … ? für Dokumente."), PracticeQuestion(prompt = "Bitt deinen Mitreisenden um den Adapter.", expected = listOf("Kannst du mir den Adapter geben ?", "kannst du mir den adapter geben", "Gibst du mir den Adapter ?"), focus = "kannst du", watch = "Bitte: Kannst du mir … geben ?"), PracticeQuestion(prompt = "Sag mit werden: du nimmst nur das Wichtigste mit.", expected = listOf("Ich werde nur das Wichtigste mitnehmen.", "ich werde nur das wichtigste mitnehmen", "Ich werde nur Wichtiges einpacken."), focus = "werde mitnehmen", watch = "trennbar: werde … mitnehmen."))), exercises = listOf(Exercise(id = "de-foundations-u25-koffer-e1", kind = "choice", prompt = "« Ich ___ morgen den Koffer packen. »", options = listOf("werde", "will", "möchte", "habe"), answers = listOf("werde"), explain = "Futur: werde + Infinitiv (packen)."), Exercise(id = "de-foundations-u25-koffer-e2", kind = "gap", prompt = "Du ___ alles Nötige finden. (werden, du-Form)", options = listOf(), answers = listOf("wirst"), explain = "du wirst + Infinitiv."), Exercise(id = "de-foundations-u25-koffer-e3", kind = "order", prompt = "Sag, wo der Reisepass hingeht.", options = listOf(), answers = listOf("Der Reisepass kommt in die Handtasche"), explain = "kommen in + Akkusativ: der Ort."), Exercise(id = "de-foundations-u25-koffer-e4", kind = "written", prompt = "Frag, ob du ein Visum brauchst.", options = listOf(), answers = listOf("brauche ich ein visum", "muss ich ein visum haben"), explain = "Brauche ich … ? — die Dokumentenfrage.")), skills = listOf("grammar:going-to", "vocab:travel", "function:make-requests", "grammar:connectors"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "de-foundations-u25-buchen", title = "Buchen", goal = "Reise buchen mit werden: Ich werde den Flug buchen — und den Plan mit zuerst … dann erklären.", intro = LessonIntro(explanation = listOf("Pläne mit werden: « Ich werde den Flug heute buchen. », « Wir werden am Freitag fliegen. »", "Reihenfolge mit zuerst … dann: « Zuerst buche ich den Flug, dann das Hotel. »", "Fragen zum Plan: « Wann wirst du buchen ? », « Wie viel wirst du zahlen ? »"), examples = listOf(ExampleLine(text = "Ich werde den Flug heute Abend buchen.", meaning = "Der Plan mit werden."), ExampleLine(text = "Wir werden am Freitag fliegen.", meaning = "wir werden + Infinitiv."), ExampleLine(text = "Zuerst der Flug, dann das Hotel.", meaning = "Reihenfolge mit dann."), ExampleLine(text = "Wann wirst du buchen ?", meaning = "Die Frage zum Plan."), ExampleLine(text = "Ich werde online reservieren.", meaning = "reservieren = fest halten."))), expressions = listOf(TargetExpression(text = "buchen / reservieren", meaning = "Fest machen.", note = "Ich buche einen Flug."), TargetExpression(text = "ich werde … buchen", meaning = "Plan in die Zukunft.", note = "Ich werde morgen buchen."), TargetExpression(text = "zuerst … dann …", meaning = "Reihenfolge planen.", note = "Zuerst Flug, dann Hotel."), TargetExpression(text = "ein Hotelzimmer", meaning = "Die Nacht bleiben.", note = "ein Zimmer für zwei Nächte"), TargetExpression(text = "Wann wirst du … ?", meaning = "Nach Plänen fragen.", note = "Wann wirst du buchen ?")), situation = "Nina und Ben planen die Reise: Nina wird den Flug buchen, Ben reserviert das Hotel. « Zuerst der Flug, dann das Hotel » — so machen sie es, denn am Freitag geht es los.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sag deinen Plan: du buchst heute Abend den Flug. (werden)", expected = listOf("Ich werde heute Abend den Flug buchen.", "ich werde heute abend den flug buchen", "Ich werde den Flug heute buchen."), focus = "werde buchen", watch =