do."), PracticeQuestion(prompt = "Perguntem se as maçãs estão maduras.", expected = listOf("Estão maduras ?"), focus = "maduras", watch = "maduras (fem pl) para maçãs."), PracticeQuestion(prompt = "Digam o que precisam: um quilo de laranjas.", expected = listOf("Queria um quilo de laranjas."), focus = "queria + quant", watch = "queria + quantidade + produto."), PracticeQuestion(prompt = "Respondam ao vendedor: nada mais, obrigado.", expected = listOf("Nada mais obrigado.", "Só isso obrigado."), focus = "quer mais alguma coisa", watch = "Só isso = solo eso."))), exercises = listOf(Exercise(id = "pt-foundations-u5-feira-e1", kind = "choice", prompt = "A ___ ___ o tomate ?", options = listOf("quanto está", "quanto é", "muito custa", "que preço"), answers = listOf("quanto está"), explain = "A quanto está = ¿a cuánto está?"), Exercise(id = "pt-foundations-u5-feira-e2", kind = "gap", prompt = "___ um quilo de maçãs. (querer educado)", options = listOf(), answers = listOf("Queria"), explain = "queria = educado."), Exercise(id = "pt-foundations-u5-feira-e3", kind = "order", prompt = "Peçam um quilo de maçãs.", options = listOf(), answers = listOf("Queria um quilo de macas"), explain = "Queria + quantidade."), Exercise(id = "pt-foundations-u5-feira-e4", kind = "written", prompt = "Reaccione cuando las peras no estén buenas: no están buenas.", options = listOf(), answers = listOf("están maduras", "no están maduras"), explain = "maduras (fem pl) para peras.")), skills = listOf("vocab:food", "grammar:quantities", "vocab:shopping", "function:go-shopping"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u5-padaria", title = "Na padaria", goal = "Comprar o que falta: procurar, perguntar e pagar.", intro = LessonIntro(explanation = listOf("Na padaria: « Tem pão integral ? » « Estou procurando fermento fresco ».", "Não tem = esgotado. « Não tem ? Tudo bem, obrigado mesmo assim ».", "O pagamento: « Quanto fica ? » « Fica sete reais »."), examples = listOf(ExampleLine(text = "Tem pão integral ?", meaning = "Perguntar se têm."), ExampleLine(text = "Estou procurando fermento fresco.", meaning = "Procurar."), ExampleLine(text = "Não tem ? Tudo bem, obrigado mesmo assim.", meaning = "Aceitar o não."), ExampleLine(text = "Quanto fica ?", meaning = "Perguntar o total."), ExampleLine(text = "Fica sete reais.", meaning = "O preço."))), expressions = listOf(TargetExpression(text = "Tem … ?", meaning = "Perguntar em loja.", note = "…pão integral ?"), TargetExpression(text = "Estou procurando …", meaning = "Procurar.", note = "…fermento fresco."), TargetExpression(text = "Não tem / está esgotado", meaning = "Não há mais.", note = "Tudo bem = está bien."), TargetExpression(text = "Quanto fica ?", meaning = "Total.", note = "fica + preço."), TargetExpression(text = "Obrigado mesmo assim.", meaning = "Agradecer mesmo sem comprar.", note = "mesmo assim = igualmente.")), situation = "Correm à padaria antes de fechar: procuram três coisas, duas têm e uma está esgotada.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Perguntar se têm pão integral.", expected = listOf("Tem pão integral ?"), focus = "tem", watch = "Tem + produto ?"), PracticeQuestion(prompt = "Dizer o que procuram.", expected = listOf("Estou procurando fermento fresco."), focus = "procurando", watch = "estar + gerúndio."), PracticeQuestion(prompt = "Aceitar quando não tem.", expected = listOf("Tudo bem, obrigado mesmo assim."), focus = "aceitar o não", watch = "mesmo assim = igualmente."), PracticeQuestion(prompt = "Perguntar o total.", expected = listOf("Quanto fica ?"), focus = "total", watch = "Quanto fica ?"), PracticeQuestion(prompt = "Pergunte se pode pagar com cartão.", expected = listOf("Pode ser no cartão ?", "Posso pagar no cartão ?"), focus = "cartão", watch = "no cartão = con tarjeta."))), exercises = listOf(Exercise(id = "pt-foundations-u5-padaria-e1", kind = "choice", prompt = "___ pão integral ?", options = listOf("Tem", "Tem-se", "Há", "Está"), answers = listOf("Tem"), explain = "Tem + produto ?"), Exercise(id = "pt-foundations-u5-padaria-e2", kind = "gap", prompt = "Estou ___ fermento fresco. (procurar)", options = listOf(), answers = listOf("procurando"), explain = "estar + gerúndio."), Exercise(id = "pt-foundations-u5-padaria-e3", kind = "order", prompt = "Pergunte o total de tudo.", options = listOf(), answers = listOf("Quanto fica tudo junto"), explain = "Quanto fica + tudo junto ?"), Exercise(id = "pt-foundations-u5-padaria-e4", kind = "written", prompt = "Diga o que procura: fermento fresco.", options = listOf(), answers = listOf("estou procurando fermento fresco", "procurando fermento fresco"), explain = "Estou procurando + produto.")), skills = listOf("function:go-shopping", "grammar:present-questions", "vocab:food", "function:solve-problems"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple"))))
