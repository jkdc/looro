    val unit = CourseUnit(id = "it-foundations-u8", title = "Media e argomenti", subtitle = "La notizia che ho letto", level = "B2", themes = listOf(ConversationTheme("it-b2-notizie", "Settimana di notizie", "Quello che si è detto", "newspaper", "Course", "Riassumete la settimana con i relativi: chi, dove, cosa.", 0),
                ConversationTheme("it-b2-colonna", "La tua colonna", "Da un lato… dall'altro…", "pencil", "Course", "Scrivete una colonna sulla pedonalizzazione del centro.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u7-relativi", title = "La notizia che ho letto", goal = "Raccontare notizie con i relativi: che, chi, dove, il cui.", intro = LessonIntro(explanation = listOf("Il relativo spiega il nome: « La notizia che ho letto dice che… », « Il giornalista che l'ha intervistata… ».", "« Dove » per i luoghi: « La piazza dove hanno manifestato ». « Il cui » per il possesso: « l'azienda il cui direttore si è dimesso ».", "Nelle notizie i relativi comprimono: chi, dove, cosa."), examples = listOf(ExampleLine(text = "La notizia che ho letto dice che…", meaning = "Relativo oggetto."), ExampleLine(text = "Il giornalista che l'ha intervistata si è dimesso.", meaning = "Relativo soggetto."), ExampleLine(text = "La piazza dove hanno manifestato è centrale.", meaning = "dove + luogo."), ExampleLine(text = "L'azienda il cui direttore si è dimesso ha reagito.", meaning = "il cui = possesso."), ExampleLine(text = "Tutto ciò che so viene dalla radio.", meaning = "tutto ciò che + verbo."))), expressions = listOf(TargetExpression(text = "il/la che…", meaning = "Relativo.", note = "la notizia che ho letto."), TargetExpression(text = "chi…", meaning = "Persona.", note = "chi l'ha intervistata."), TargetExpression(text = "dove…", meaning = "Luogo.", note = "la piazza dove…"), TargetExpression(text = "il cui / la cui", meaning = "Possesso.", note = "l'azienda il cui direttore…"), TargetExpression(text = "tutto ciò che…", meaning = "Generalizzare.", note = "tutto ciò che so.")), situation = "Riassumete una settimana di notizie: la storia che vi ha colpito, la persona che ha parlato e il luogo dove è successo.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Riassumi: la notizia che ho letto dice che il museo allarga gli orari.", expected = listOf("La notizia che ho letto dice che il museo allarga gli orari"), focus = "che ho letto", watch = "Relativo sulla notizia."), PracticeQuestion(prompt = "Di chi: il giornalista che l'ha intervistata si è dimesso.", expected = listOf("Il giornalista che l'ha intervistata si e dimesso", "Il giornalista che l'ha intervistata si è dimesso"), focus = "che l'ha intervistata", watch = "Relativo soggetto."), PracticeQuestion(prompt = "Luogo: la piazza dove hanno manifestato è centrale.", expected = listOf("La piazza dove hanno manifestato e centrale", "La piazza dove hanno manifestato è centrale"), focus = "dove", watch = "dove + luogo."), PracticeQuestion(prompt = "Possesso: l'azienda il cui direttore si è dimesso ha reagito.", expected = listOf("L'azienda il cui direttore si e dimesso ha reagito", "L'azienda il cui direttore si è dimesso ha reagito"), focus = "il cui", watch = "il cui + sostantivo."), PracticeQuestion(prompt = "Generalizza: tutto ciò che so viene dalla radio.", expected = listOf("Tutto cio che so viene dalla radio", "Tutto ciò che so viene dalla radio"), focus = "tutto ciò che", watch = "tutto ciò che + verbo."))), exercises = listOf(Exercise(id = "it-foundations-u7-relativi-e1", kind = "choice", prompt = "La notizia ___ ho letto dice che il museo si allarga.", options = listOf("che", "chi", "il cui", "dove"), answers = listOf("che"), explain = "Cosa: la notizia che ho letto."), Exercise(id = "it-foundations-u7-relativi-e2", kind = "gap", prompt = "La piazza ___ hanno manifestato è centrale.", options = listOf(), answers = listOf("dove"), explain = "Luogo: dove."), Exercise(id = "it-foundations-u7-relativi-e3", kind = "order", prompt = "Soggetto: il giornalista che l'ha intervistata si è dimesso.", options = listOf(), answers = listOf("Il giornalista che l'ha intervistata si è dimesso"), explain = "Relativo soggetto."), Exercise(id = "it-foundations-u7-relativi-e4", kind = "written", prompt = "La tua notizia: una strada chiuderà (usa « la notizia che ho letto »).", options = listOf(), answers = listOf("la notizia che ho letto dice che chiuderanno la strada"), explain = "La notizia che + passato prossimo.")), skills = listOf("grammar:relative-clauses", "grammar:present-perfect", "function:express-opinion", "vocab:work"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:present-perfect")),
    Lesson(id = "it-foundations-u7-argomentare", title = "Da un lato… dall'altro…", goal = "Scrivere e difendere un'opinione strutturata: tesi, argomenti, concessione, conclusione.", intro = LessonIntro(explanation = listOf("Struttura: tesi (« Penso che dovremmo pedonalizzare il centro »), argomenti (« da un lato…, dall'altro… »), concessione (« è vero che…, ma… »).", "La concessione dà credibilità: riconosci la parte avversa prima di rispondere.", "Conclusione con peso: « Per tutto questo, difendo la misura »."), examples = listOf(ExampleLine(text = "Penso che dovremmo pedonalizzare il centro.", meaning = "Tesi."), ExampleLine(text = "Da un lato, cala l'inquinamento.", meaning = "Argomento 1."), ExampleLine(text = "Dall'altro, il commercio ne risente.", meaning = "Argomento 2 (contrario)."), ExampleLine(text = "È vero che è scomodo, ma i numeri dicono altro.", meaning = "Concessione + risposta."), ExampleLine(text = "Per tutto questo, difendo la misura.", meaning = "Conclusione."))), expressions = listOf(TargetExpression(text = "penso che + congiuntivo", meaning = "Tesi.", note = "…dovremmo pedonalizzare."), TargetExpression(text = "da un lato… dall'altro…", meaning = "Argomenti.", note = "le due facce."), TargetExpression(text = "è vero che…, ma…", meaning = "Concessione.", note = "riconoscere e rispondere."), TargetExpression(text = "i numeri dicono…", meaning = "Prova.", note = "argomento d'autorità."), TargetExpression(text = "per tutto questo, …", meaning = "Conclusione.", note = "registro alto.")), situation = "Scrivete una colonnina d'opinione sulla pedonalizzazione del centro: tesi, due facce, concessione e chiusura.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Tesi: penso che dovremmo pedonalizzare il centro.", expected = listOf("Penso che dovremmo pedonalizzare il centro"), focus = "penso che", watch = "Tesi + dovere."), PracticeQuestion(prompt = "Argomento 1: da un lato, cala l'inquinamento.", expected = listOf("Da un lato cala l'inquinamento", "Da un lato, cala l'inquinamento"), focus = "da un lato", watch = "Primo argomento."), PracticeQuestion(prompt = "Argomento contrario: dall'altro, il commercio ne risente.", expected = listOf("Dall'altro il commercio ne risente", "Dall'altro, il commercio ne risente"), focus = "dall'altro", watch = "Seconda faccia."), PracticeQuestion(prompt = "Concedi: è vero che è scomodo, ma i numeri dicono altro.", expected = listOf("E vero che e scomodo ma i numeri dicono altro", "È vero che è scomodo, ma i numeri dicono altro"), focus = "è vero che", watch = "Concessione + ma."), PracticeQuestion(prompt = "Chiudi: per tutto questo, difendo la misura.", expected = listOf("Per tutto questo difendo la misura", "Per tutto questo, difendo la misura"), focus = "per tutto questo", watch = "Conclusione formale."))), exercises = listOf(Exercise(id = "it-foundations-u7-argomentare-e1", kind = "choice", prompt = "___ un lato, cala l'inquinamento.", options = listOf("Da", "Per", "In", "Con"), answers = listOf("Da"), explain = "da un lato = primo argomento."), Exercise(id = "it-foundations-u7-argomentare-e2", kind = "gap", prompt = "È vero che è scomodo, ___ i numeri dicono altro.", options = listOf(), answers = listOf("ma"), explain = "Concessione + contrasto."), Exercise(id = "it-foundations-u7-argomentare-e3", kind = "order", prompt = "Conclusione: per tutto questo, difendo la misura.", options = listOf(), answers = listOf("Per tutto questo, difendo la misura"), explain = "per tutto questo."), Exercise(id = "it-foundations-u7-argomentare-e4", kind = "written", prompt = "La tua tesi sul prolungamento del tram.", options = listOf(), answers = listOf("penso che dovremmo allungare il tram", "penso che dovremmo prolungare la tramvia"), explain = "Penso che + dovremmo.")), skills = listOf("writing:argument", "grammar:connectors", "function:express-opinion", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors"))))
}

object ItFoundationsU9 {
    val unit = CourseUnit(id = "it-foundations-u9", title = "Sfumature e registri", subtitle = "Dirlo meglio", level = "C1", themes = listOf(ConversationTheme("it-c1-registro", "Come lo dico", "Formale o colloquiale", "bubble-left-and-text", "Course", "Riscrivete la stessa notizia in due registri: email alla dirigenza e messaggio al collega.", 0),
                ConversationTheme("it-c1-sfumature", "Più o meno", "Sfumare le opinioni", "sparkles", "Course", "Valutate una proposta con tatto: accordo parziale, rilievo gentile, chiusura chiara.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u9-registro", title = "Come lo dico", goal = "Dire la stessa cosa in due registri: l'email formale alla dirigenza e il messaggio al collega.", intro = LessonIntro(explanation = listOf("Il registro è la veste della lingua: « Le scrivo per informarLa che la riunione è stata rinviata » e « Ehi, la riunione è slittata » dicono la stessa cosa in due mondi diversi.", "Nel formale: Lei con la maiuscola, forme piene, nessuna elisione (« Le invio », « in allegato », « La ringrazio in anticipo »). Nel colloquiale: tu, elisioni (« ti mando », « facciamo »), battute brevi.", "I connettivi tengono insieme i due mondi: « pertanto » e « tuttavia » reggono la relazione; « comunque » e « infatti » la chat."), examples = listOf(ExampleLine(text = "Le scrivo per informarLa che la riunione è stata rinviata a giovedì.", meaning = "Email formale: Lei + passivo."), ExampleLine(text = "Ehi, la riunione è slittata a giovedì.", meaning = "Stessa notizia in chat, registro colloquiale."), ExampleLine(text = "La ringrazio in anticipo per la Sua disponibilità.", meaning = "Chiusura formale, prima della risposta."), ExampleLine(text = "Ti ringrazio mille, mi hai tolto un peso!", meaning = "Ringraziamento caloroso tra pari."), ExampleLine(text = "Pertanto, La invito a confermare la Sua partecipazione entro venerdì.", meaning = "Connettivo formale + richiesta precisa."))), expressions = listOf(TargetExpression(text = "Le scrivo per…", meaning = "Apertura formale di email.", note = "Le scrivo per confermare la riunione."), TargetExpression(text = "in allegato", meaning = "Trasmettere un file.", note = "In allegato Le invio il preventivo."), TargetExpression(text = "La ringrazio in anticipo", meaning = "Chiusura cortese.", note = "Si usa prima di ricevere la risposta."), TargetExpression(text = "slittare", meaning = "Posticiparsi (di un impegno).", note = "La riunione è slittata di una settimana."), TargetExpression(text = "pertanto", meaning = "Connettivo formale di conclusione.", note = "Pertanto Le chiedo una conferma.")), situation = "Riscrivete la stessa notizia due volte: un'email alla dirigenza e un messaggio al collega di fiducia. Poi leggete le due versioni ad alta voce e confrontate i registri.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Apri un'email formale per confermare la tua presenza alla riunione.", expected = listOf("le scrivo per confermare la mia presenza di giovedì", "le scrivo per confermare la mia presenza di giovedi", "le confermo la mia presenza"), focus = "Le + verbo pieno", watch = "Mai « Ciao »; Lei con la maiuscola nell'email."), PracticeQuestion(prompt = "Comunica in modo formale che il documento richiesto è allegato.", expected = listOf("in allegato le invio il documento", "le invio in allegato il documento richiesto", "allego il documento richiesto"), focus = "in allegato", watch = "« allegato » singolare per un solo file."), PracticeQuestion(prompt = "Rendi colloquiale la notizia che l'incontro è stato posticipato.", expected = listOf("l'incontro è slittato", "l'incontro e slittato", "la riunione è slittata"), focus = "slittare", watch = "Colloquiale: « slittare » invece di « rinviare »."), PracticeQuestion(prompt = "Chiudi l'email ringraziando prima ancora di ricevere la risposta.", expected = listOf("la ringrazio in anticipo", "la ringrazio in anticipo per la disponibilità", "ringrazio sin d'ora per l'attenzione"), focus = "in anticipo", watch = "« in anticipo » si usa prima del ricevimento."), PracticeQuestion(prompt = "Chiedi formalmente una conferma entro venerdì, aprendo col connettivo conclusivo che vale « per questo motivo ».", expected = listOf("pertanto le chiedo una conferma entro venerdì", "pertanto le chiedo una conferma entro venerdi", "quindi le chiediamo conferma entro venerdì"), focus = "pertanto / quindi", watch = "Pertanto apre la frase e regge l'indicativo."))), exercises = listOf(Exercise(id = "it-foundations-u9-registro-e1", kind = "choice", prompt = "Formale: « ___ scrivo per confermare l'appuntamento di giovedì. »", options = listOf("Le", "Ti", "Vi", "Ce"), answers = listOf("Le"), explain = "Email formale: pronome di cortesia Lei."), Exercise(id = "it-foundations-u9-registro-e2", kind = "gap", prompt = "Chiusura cortese: La ringrazio ___ della Sua disponibilità. (si scrive prima ancora di ricevere qualcosa)", options = listOf(), answers = listOf("in anticipo"), explain = "Formula fissa: ringraziare in anticipo."), Exercise(id = "it-foundations-u9-registro-e3", kind = "written", prompt = "Riformula in registro colloquiale l'idea che l'incontro è stato posticipato (verbo: la riunione « scivola » in avanti).", options = listOf(), answers = listOf("l'incontro è slittato", "l'incontro e slittato", "la riunione è slittata"), explain = "Colloquiale: slittare invece di rinviare."), Exercise(id = "it-foundations-u9-registro-e4", kind = "written", prompt = "Chiudi un'email formale ricordando una scadenza: apri la frase col connettivo che vale « per questo motivo ».", options = listOf(), answers = listOf("pertanto le chiedo una conferma entro venerdì", "pertanto le chiedo una conferma entro venerdi", "quindi la invito a confermare entro venerdì"), explain = "Pertanto / quindi + richiesta con Lei.")), skills = listOf("vocab:social-expressions", "function:talk-about-work", "writing:email", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "it-foundations-u9-sfumature", title = "Più o meno", goal = "Sfumare opinioni e giudizi per discutere senza scontri: distacco, concessione, morbidezza.", intro = LessonIntro(explanation = listOf("Per non suonare categorici, l'italiano professionale sfuma: « in un certo senso, è una buona base di lavoro » accorda senza chiudere la discussione.", "« Per così dire » ammorbidisce una parola forte: « è una soluzione, per così dire, provvisoria » avverte senza offendere.", "« A mio avviso » separa l'opinione dalla persona: si discute l'idea, non chi l'ha proposta."), examples = listOf(ExampleLine(text = "In un certo senso, la proposta regge.", meaning = "Accordo parziale, non totale."), ExampleLine(text = "È un promemoria, per così dire, informale.", meaning = "Ammorbidisce il giudizio."), ExampleLine(text = "A mio avviso, va rifinita la parte finale.", meaning = "Opinione personale, tono professionale."), ExampleLine(text = "Direi quasi che è pronta; manca solo la sintesi.", meaning = "Sfuma senza negare."), ExampleLine(text = "Sotto certi aspetti sì, sotto altri no.", meaning = "Opinione divisa, senza scontro."))), expressions = listOf(TargetExpression(text = "in un certo senso", meaning = "Accordo parziale.", note = "In un certo senso, sì; però servono dati."), TargetExpression(text = "per così dire", meaning = "Ammorbidire una parola.", note = "È un registro, per così dire, medio."), TargetExpression(text = "a mio avviso", meaning = "Opinione con distacco.", note = "A mio avviso, conviene rivederla."), TargetExpression(text = "direi quasi", meaning = "Sfumare un'affermazione.", note = "Direi quasi che ci siamo."), TargetExpression(text = "sotto certi aspetti", meaning = "Concessione.", note = "Sotto certi aspetti ha ragione lui.")), situation = "Valutate il progetto di un collega: applaudite con misura, criticate con tatto e chiudete sempre con una proposta, non con un giudizio a secco.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Concorda in parte con la proposta del collega (locuzione di tre parole con « senso »).", expected = listOf("in un certo senso sono d'accordo", "in un certo senso la proposta regge", "in un certo senso hai ragione"), focus = "in un certo senso", watch = "Non « in certo senso »: serve l'articolo."), PracticeQuestion(prompt = "Ammorbidisci il giudizio che la relazione è incompleta (locuzione con « così »).", expected = listOf("la relazione è per così dire ancora una bozza", "è per così dire incompleta", "per così dire è un primo passo"), focus = "per così dire", watch = "Si incornicia tra due virgole."), PracticeQuestion(prompt = "Dai la tua opinione professionale su quale parte rifinire (formula con « avviso »).", expected = listOf("a mio avviso va rifinita la conclusione", "a mio avviso manca solo la sintesi", "a mio avviso il capitolo finale è il più debole"), focus = "a mio avviso", watch = "Regge l'indicativo: « a mio avviso va… »."), PracticeQuestion(prompt = "Dì che il progetto è quasi pronto senza escludere i difetti (formula con « quasi »).", expected = listOf("direi quasi che è pronto", "direi quasi che il progetto è pronto", "direi quasi di sì"), focus = "direi quasi", watch = "Sfuma senza negare."), PracticeQuestion(prompt = "Riconosci un merito parziale all'altro prima del tuo rilievo (locuzione con « aspetti »).", expected = listOf("sotto certi aspetti ha ragione", "sotto certi aspetti la sua analisi funziona", "hai ragione sotto certi aspetti"), focus = "sotto certi aspetti", watch = "Prima la concessione, poi il rilievo."))), exercises = listOf(Exercise(id = "it-foundations-u9-sfumature-e1", kind = "choice", prompt = "« ___ avviso, la proposta merita attenzione. »", options = listOf("A mio", "Al mio", "In mio", "Per mio"), answers = listOf("A mio"), explain = "Formula fissa di distacco: a mio avviso."), Exercise(id = "it-foundations-u9-sfumature-e2", kind = "gap", prompt = "La relazione è, ___, ancora una bozza. (locuzione di tre parole che ammorbidisce)", options = listOf(), answers = listOf("per così dire"), explain = "Per così dire incornicia il giudizio."), Exercise(id = "it-foundations-u9-sfumature-e3", kind = "written", prompt = "Concorda con tatto con l'idea del collega e chiedi una rifinitura: apri con la locuzione che contiene « senso ».", options = listOf(), answers = listOf("in un certo senso l'idea funziona ma va rifinita", "in un certo senso sono d'accordo però chiederei una rifinitura", "in un certo senso sono d'accordo pero chiederei una rifinitura"), explain = "In un certo senso + concessione + richiesta."), Exercise(id = "it-foundations-u9-sfumature-e4", kind = "written", prompt = "Giustifica in tono professionale perché preferisci lavorare in team: apri con la formula che contiene « avviso ».", options = listOf(), answers = listOf("a mio avviso il team aiuta a vedere i punti ciechi", "a mio avviso lavorare in team riduce gli errori", "a mio avviso il team rende le decisioni più solide"), explain = "A mio avviso + motivo professionale.")), skills = listOf("function:express-opinion", "speaking:justify-opinion", "grammar:connectors", "vocab:collocations"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "it-foundations-u9-presentare", title = "Presentare le idee", goal = "Strutturare un intervento breve in riunione: apertura, transizione, sintesi e chiusura.", intro = LessonIntro(explanation = listOf("Un intervento breve ha tre mosse: aprire con « per iniziare », sviluppare i punti, chiudere con « per concludere ».", "« In sintesi » comprime: due frasi al massimo, poi si passa alla proposta concreta.", "Se cambiate argomento, annunciatelo: « venendo ai costi », « passo ai tempi » tengono il filo e non perdono la sala."), examples = listOf(ExampleLine(text = "Per iniziare, un dato: le iscrizioni sono cresciute.", meaning = "Apertura con un dato."), ExampleLine(text = "Venendo ai costi, restiamo nel budget.", meaning = "Transizione annunciata."), ExampleLine(text = "In sintesi, la prova ha funzionato.", meaning = "Comprime i punti in una frase."), ExampleLine(text = "Per concludere, chiediamo due settimane per il prototipo.", meaning = "Chiusura con richiesta precisa."), ExampleLine(text = "Se posso aggiungere una sfumatura, il campione è ancora grezzo.", meaning = "Entra nel dibattito con garbo."))), expressions = listOf(TargetExpression(text = "per iniziare", meaning = "Aprire l'intervento.", note = "Per iniziare, ringrazio i relatori."), TargetExpression(text = "venendo a…", meaning = "Cambiare punto.", note = "Venendo ai tempi, servono otto settimane."), TargetExpression(text = "in sintesi", meaning = "Comprimere.", note = "In sintesi: sì, ma con risorse."), TargetExpression(text = "per concludere", meaning = "Chiudere.", note = "Per concludere, vi chiedo un feedback."), TargetExpression(text = "se posso aggiungere…", meaning = "Intervenire con garbo.", note = "Se posso aggiungere una sfumatura…")), situation = "Presentate al team una proposta in un minuto: aprite con un dato, sviluppate due argomenti e chiudete con una richiesta precisa, con cosa e quando.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Apri il tuo intervento con un dato sulle iscrizioni (locuzione d'apertura di due parole).", expected = listOf("per iniziare un dato le iscrizioni sono cresciute", "per iniziare ecco un dato sulle iscrizioni", "per iniziare le iscrizioni crescono"), focus = "per iniziare", watch = "Un solo dato, poi si sviluppa."), PracticeQuestion(prompt = "Annuncia che passi ai costi (formula di transizione).", expected = listOf("venendo ai costi", "venendo ai costi restiamo nel budget", "passo ora ai costi"), focus = "venendo a", watch = "« Venendo ai » + plurale."), PracticeQuestion(prompt = "Comprimi in una frase l'esito positivo della prova (formula di sintesi).", expected = listOf("in sintesi la prova ha funzionato", "in sintesi siamo nel budget e nei tempi", "in sintesi il bilancio è positivo"), focus = "in sintesi", watch = "Due frasi al massimo, poi la proposta."), PracticeQuestion(prompt = "Chiudi chiedendo un feedback entro venerdì (locuzione di chiusura).", expected = listOf("per concludere vi chiedo un feedback entro venerdì", "per concludere attendiamo il vostro feedback entro venerdi", "chiudo chiedendovi un feedback entro venerdì"), focus = "per concludere", watch = "La richiesta è precisa: cosa e quando."), PracticeQuestion(prompt = "Entra nel dibattito con garbo per aggiungere una riserva (formula cortese con « se posso »).", expected = listOf("se posso aggiungere una sfumatura il campione è ancora grezzo", "se posso aggiungere qualcosa servono più test", "se posso aggiungere una riserva i tempi sono stretti"), focus = "se posso aggiungere", watch = "La cortesia prima del contenuto."))), exercises = listOf(Exercise(id = "it-foundations-u9-presentare-e1", kind = "choice", prompt = "« ___ iniziare, un dato: le iscrizioni sono cresciute. »", options = listOf("Per", "In", "A", "Da"), answers = listOf("Per"), explain = "Locuzione d'apertura: per iniziare."), Exercise(id = "it-foundations-u9-presentare-e2", kind = "gap", prompt = "___ sintesi, il bilancio della prova è positivo. (preposizione semplice)", options = listOf(), answers = listOf("In"), explain = "In sintesi comprime i punti."), Exercise(id = "it-foundations-u9-presentare-e3", kind = "written", prompt = "Apri il tuo intervento sulle vendite con la locuzione d'apertura seguita da un dato.", options = listOf(), answers = listOf("per iniziare ecco i dati sulle vendite", "per iniziare un dato le vendite sono cresciute", "per iniziare le vendite sono cresciute del dieci per cento"), explain = "Per iniziare + dato."), Exercise(id = "it-foundations-u9-presentare-e4", kind = "written", prompt = "Chiudi il tuo intervento chiedendo due settimane per il prototipo: apri con la locuzione di chiusura.", options = listOf(), answers = listOf("per concludere chiediamo due settimane per il prototipo", "per concludere vi chiedo due settimane per il prototipo", "per concludere servono due settimane per il prototipo"), explain = "Per concludere + richiesta precisa.")), skills = listOf("speaking:sustained-conversation", "function:talk-about-work", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "it-foundations-u9-dibattere", title = "D’accordo nel disaccordo", goal = "Dissentire con tatto: riconoscere il punto dell’altro e restare nella propria posizione.", intro = LessonIntro(explanation = listOf("Il dissenso con tatto riconosce prima e obietta poi: « Capisco il suo punto, però i dati dicono altro ».", "« Sono d’accordo in parte » divide la posizione: « Sì alla forma, no ai tempi ». « Quanto ai costi » isola il dissenso in un punto solo.", "« Pur + gerundio » concede senza cedere: « Pur condividendo l’obiettivo, la strada mi sembra diversa ». Poi si chiude: « Cerchiamo un punto comune »."), examples = listOf(ExampleLine(text = "Capisco il suo punto, però i dati dicono altro.", meaning = "Riconoscere, poi dissentire."), ExampleLine(text = "Sono d’accordo in parte: la forma sì, i tempi no.", meaning = "Accordo parziale."), ExampleLine(text = "Quanto ai costi, resto della mia idea.", meaning = "Limitare il dissenso a un punto."), ExampleLine(text = "Pur condividendo l’obiettivo, la strada mi sembra diversa.", meaning = "Concessione + dissenso."), ExampleLine(text = "Proviamo a trovare un punto comune.", meaning = "Chiudere in modo costruttivo."))), expressions = listOf(TargetExpression(text = "capisco il suo punto", meaning = "Riconoscere l’altro.", note = "Capisco il suo punto, però…"), TargetExpression(text = "sono d’accordo in parte", meaning = "Accordo parziale.", note = "Sì alla forma, no ai tempi."), TargetExpression(text = "quanto a…", meaning = "Limitare al punto.", note = "Quanto ai costi, ho riserve."), TargetExpression(text = "pur + gerundio", meaning = "Concedere senza cedere.", note = "Pur condividendo, mi fermo."), TargetExpression(text = "un punto comune", meaning = "Chiudere insieme.", note = "Cerchiamo un punto comune.")), situation = "In riunione un collega propone di tagliare i test: riconosci i suoi motivi, dissentite con tatto e chiudete con una proposta condivisa.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Riconosci il punto del collega prima di obiettare (formula con « punto »).", expected = listOf("capisco il suo punto però i tempi sono stretti", "capisco il suo punto ma servono dati", "capisco il suo punto però resto scettico"), focus = "capisco il suo punto", watch = "Prima il riconoscimento, poi il però."), PracticeQuestion(prompt = "Dai un accordo parziale: la forma sì, i tempi no (formula con « in parte »).", expected = listOf("sono d’accordo in parte la forma sì i tempi no", "sono d’accordo in parte pero i tempi no"), focus = "in parte", watch = "Accordo parziale, non totale."), PracticeQuestion(prompt = "Limita il tuo dissenso ai costi (formula con « quanto »).", expected = listOf("quanto ai costi non sono convinto", "quanto ai costi esprimo riserve"), focus = "quanto a", watch = "Quanto a + tema: isola il dissenso."), PracticeQuestion(prompt = "Concedi l’obiettivo ma dissentisci sulla strada (formula con « pur »).", expected = listOf("pur condividendo l’obiettivo la strada mi sembra diversa", "pur condividendo l’obiettivo preferisco un’altra strada"), focus = "pur + gerundio", watch = "Pur condividendo = aunque comparto."), PracticeQuestion(prompt = "Chiudi cercando una base condivisa (formula con « comune »).", expected = listOf("proviamo a trovare un punto comune", "cerchiamo un punto comune sui test"), focus = "punto comune", watch = "La chiusura evita lo scontro."))), exercises = listOf(Exercise(id = "it-foundations-u9-dibattere-e1", kind = "choice", prompt = "« Capisco ___ punto, però i dati dicono altro. »", options = listOf("il suo", "il mio", "il loro", "di lui"), answers = listOf("il suo"), explain = "Riconoscere la posizione dell’altro: il suo punto."), Exercise(id = "it-foundations-u9-dibattere-e2", kind = "gap", prompt = "Sono d’accordo ___: la forma sì, i tempi no.", options = listOf(), answers = listOf("in parte"), explain = "Accordo parziale: in parte."), Exercise(id = "it-foundations-u9-dibattere-e3", kind = "written", prompt = "Concedi l’obiettivo ma dissentisci sulla strada: apri con « pur ».", options = listOf(), answers = listOf("pur condividendo l’obiettivo la strada mi sembra diversa", "pur condividendo l’obiettivo preferisco un’altra strada"), explain = "Pur + gerundio = concessione, poi il dissenso."), Exercise(id = "it-foundations-u9-dibattere-e4", kind = "written", prompt = "Chiudi il dibattito cercando una base condivisa (formula con « punto »).", options = listOf(), answers = listOf("proviamo a trovare un punto comune", "cerchiamo un punto comune", "cerchiamo un punto comune sui tempi"), explain = "Punto comune = chiusura costruttiva.")), skills = listOf("function:express-opinion", "speaking:sustained-conversation", "grammar:connectors", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "it-foundations-u9-tono", title = "Il tono esatto", goal = "Regolare il tono di un testo: collocazioni esatte, verbi del dire e connettivi che tengono il registro.", intro = LessonIntro(explanation = listOf("Il tono nasce dalle collocazioni: si prende una decisione e non la si fa, si ha voglia di leggere e non la voglia. Le parole giuste viaggiano in coppia.", "Regolare il tono vuol dire pesare i verbi del dire: sostenere una tesi è neutro, asserire suona distante, rivendicare suona da battaglia.", "I connettivi reggono il registro: tuttavia e pertanto tengono alto il tono, comunque e insomma lo abbassano. E in definitiva chiude l'argomentazione, dando spazio alla tua opinione."), examples = listOf(ExampleLine(text = "Il consiglio deve prendere una decisione entro venerdì.", meaning = "Collocazione esatta."), ExampleLine(text = "Gli studenti hanno voglia di chiarezza, non di promesse.", meaning = "avere voglia di + nome."), ExampleLine(text = "Il relatore ha sostenuto la tesi con tre dati.", meaning = "sostenere: registro neutro."), ExampleLine(text = "Tuttavia, i numeri presentati non convincono tutti.", meaning = "Connettivo alto."), ExampleLine(text = "In definitiva, propongo di valutare la proposta.", meaning = "Chiusura del saggio."))), expressions = listOf(TargetExpression(text = "prendere una decisione", meaning = "Collocazione: decidere.", note = "Prendere una decisione difficile."), TargetExpression(text = "avere voglia di", meaning = "Collocazione: il desiderio.", note = "Non ho voglia di polemizzare."), TargetExpression(text = "sostenere una tesi", meaning = "Il verbo del dire, neutro.", note = "Sostiene una tesi costosa."), TargetExpression(text = "tuttavia / pertanto", meaning = "Connettivi del registro alto.", note = "Tuttavia, il dato resta."), TargetExpression(text = "in definitiva", meaning = "Chiudere l'argomentazione.", note = "In definitiva, condivido la proposta.")), situation = "Prendete un paragrafo scritto « giusto » e rendetelo esatto: collocazioni in coppia, verbi del dire pesati, connettivi che tengono il tono fino alla chiusura.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Completa la collocazione: il verbo naturale che accompagna « decisione ».", expected = listOf("prendere una decisione", "prendere una decisione difficile"), focus = "prendere", watch = "Si dice prendere, non fare una decisione."), PracticeQuestion(prompt = "Dì che non hai alcun desiderio di polemizzare, con la collocazione con « voglia ».", expected = listOf("non ho voglia di polemizzare", "non ho voglia di polemizzare oggi"), focus = "avere voglia di", watch = "avere voglia di + infinito."), PracticeQuestion(prompt = "Sostituisci « dire » con il verbo accademico per la tesi.", expected = listOf("sostenere una tesi", "ha sostenuto la tesi"), focus = "sostenere", watch = "« asserire » suona distante; « sostenere » è neutro."), PracticeQuestion(prompt = "Apri la frase col connettivo alto che vale « però ».", expected = listOf("tuttavia i dati non convincono tutti", "tuttavia i numeri non convincono"), focus = "tuttavia", watch = "« però » è parlato; « tuttavia » tiene il registro."), PracticeQuestion(prompt = "Chiudi il saggio col connettivo che sintetizza (« in sintesi, alla fine »), dando la tua opinione.", expected = listOf("in definitiva propongo di valutare la proposta", "in definitiva condivido la proposta"), focus = "in definitiva", watch = "in definitiva chiude l'argomentazione."))), exercises = listOf(Exercise(id = "it-foundations-u9-tono-e1", kind = "choice", prompt = "Formale: il consiglio deve ___ una decisione entro venerdì.", options = listOf("prendere", "fare", "dare", "mettere"), answers = listOf("prendere"), explain = "Collocazione esatta: prendere una decisione."), Exercise(id = "it-foundations-u9-tono-e2", kind = "gap", prompt = "Non ___ voglia di polemizzare: chiudo qui. (io)", options = listOf(), answers = listOf("ho"), explain = "Collocazione: avere voglia di."), Exercise(id = "it-foundations-u9-tono-e3", kind = "written", prompt = "Sostituisci il verbo « dire » con uno di registro accademico: il relatore ha ___ la tesi con tre dati.", options = listOf(), answers = listOf("sostenuto"), explain = "sostenere: verbo del dire, registro neutro."), Exercise(id = "it-foundations-u9-tono-e4", kind = "written", prompt = "Riscrivi la frase sostituendo « Però » col connettivo alto equivalente: Però i dati non convincono tutti.", options = listOf(), answers = listOf("tuttavia i dati non convincono tutti", "tuttavia i dati non convincono"), explain = "« tuttavia » regge il registro formale al posto di « però ».")), skills = listOf("vocab:collocations", "function:express-opinion", "writing:argument", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors"))))
}

object ItWorkU1 {
    val unit = CourseUnit(id = "it-work-u1", title = "La giornata di lavoro", subtitle = "Riunioni, email, colloqui", level = "B1", themes = listOf(ConversationTheme("la-riunione-del-lunedi", "La riunione del lunedì", "Il mio parere", "bubble.left.and.text.bubble.right", "Course", "Nella riunione del lunedì racconti i progressi, dai il tuo parere e proponi una soluzione.", 0),
                ConversationTheme("scrivere-e-presentarsi", "Email e colloqui", "Scrivere e convincere", "person.badge.key", "Course", "La mail formale al cliente e la preparazione del colloquio: richieste gentili ed esperienza raccontata bene.", 1)), lessons = listOf(    Lesson(id = "it-work-u1-riunioni", title = "In riunione", goal = "Dare il proprio parere in riunione e proporre una soluzione.", intro = LessonIntro(explanation = listOf("Il parere in sala si presenta con calma: « Secondo me… », « A mio avviso… ». Poi arriva la proposta: « Propongo di rimandare la scadenza ».", "I connettivi tengono il discorso insieme: « Da un lato funziona, dall’altro costa troppo », « Quindi suggerisco un test di un mese ».", "Per dissentire senza rompere: « Capisco il punto, però i dati dicono altro ». Prima riconosci, poi porti i numeri."), examples = listOf(ExampleLine(text = "Secondo me la campagna va rimandata.", meaning = "L’opinione chiara."), ExampleLine(text = "Propongo di fare un test di un mese.", meaning = "La proposta concreta."), ExampleLine(text = "Da un lato funziona, dall’altro costa troppo.", meaning = "Pro e contro."), ExampleLine(text = "Capisco il punto, però i numeri dicono altro.", meaning = "Il dissenso con i dati."), ExampleLine(text = "Quindi suggerisco di partire piccolo.", meaning = "La conseguenza e la proposta."))), expressions = listOf(TargetExpression(text = "a mio avviso", meaning = "L’opinione formale.", note = "A mio avviso conviene rimandare."), TargetExpression(text = "propongo di + infinito", meaning = "La proposta in sala.", note = "Propongo di dividere il progetto."), TargetExpression(text = "da un lato… dall’altro…", meaning = "I due lati della questione.", note = "Da un lato è rapido, dall’altro rischioso."), TargetExpression(text = "capisco, però…", meaning = "Il dissenso professionale.", note = "Capisco, però i dati dicono altro."), TargetExpression(text = "suggerisco…", meaning = "La proposta morbida.", note = "Suggerisco una seconda opzione.")), situation = "Riunione del lunedì: il progetto va in ritardo. Dai il tuo parere, pesi pro e contro e proponi un test di un mese.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Dai il tuo parere: la campagna va rimandata.", expected = listOf("Secondo me la campagna va rimandata.", "A mio avviso va rimandata."), focus = "secondo me", watch = "prima la formula, poi il punto."), PracticeQuestion(prompt = "Proponi un test di un mese.", expected = listOf("Propongo di fare un test di un mese.", "Propongo un test di un mese."), focus = "propongo di", watch = "propongo di + infinito."), PracticeQuestion(prompt = "Pesa pro e contro della proposta.", expected = listOf("Da un lato funziona, dall’altro costa troppo.", "Da un lato è rapida, dall’altro rischia poco."), focus = "i due lati", watch = "da un lato… dall’altro…: il bilancio."), PracticeQuestion(prompt = "Dissentisci con i dati, con gentilezza.", expected = listOf("Capisco il punto, però i dati dicono altro.", "Vedo le cose in modo diverso."), focus = "il dissenso", watch = "prima riconosci, poi porti i numeri."), PracticeQuestion(prompt = "Chiudi con la conseguenza: quindi, test.", expected = listOf("Quindi suggerisco di partire con un test.", "Quindi propongo il test."), focus = "quindi", watch = "quindi: la conclusione che porta a casa."), PracticeQuestion(prompt = "Chiedi il parere di un collega.", expected = listOf("Che ne pensi, Luca ?", "Qual è la tua opinione ?", "Tu che ne dici ?"), focus = "chiedere il parere", watch = "che ne pensi: la domanda che apre la sala."))), exercises = listOf(Exercise(id = "it-work-u1-riunioni-e1", kind = "choice", prompt = "___ mio avviso, la scadenza è irrealistica.", options = listOf("A", "In", "Su", "Da"), answers = listOf("A"), explain = "A mio avviso: la formula formale del parere."), Exercise(id = "it-work-u1-riunioni-e2", kind = "gap", prompt = "___ propongo di fare un test. (la conseguenza)", options = listOf(), answers = listOf("quindi"), explain = "quindi: la conseguenza prima della proposta."), Exercise(id = "it-work-u1-riunioni-e3", kind = "order", prompt = "Chiudi con la conseguenza e la proposta del test.", options = listOf(), answers = listOf("Quindi suggerisco di partire con un test"), explain = "quindi + suggerisco: la conclusione operativa."), Exercise(id = "it-work-u1-riunioni-e4", kind = "written", prompt = "Proponi di dividere il progetto in due fasi.", options = listOf(), answers = listOf("propongo di dividere il progetto in due fasi", "propongo di dividere il progetto", "suggerisco di dividere il progetto in due fasi"), explain = "propongo di + infinito: la proposta in sala.")), skills = listOf("function:talk-about-work", "function:express-opinion", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "it-work-u1-email", title = "La mail formale", goal = "Scrivere una mail formale: saluto, richiesta gentile e chiusura.", intro = LessonIntro(explanation = listOf("La struttura della mail di lavoro: il saluto (« Gentile Dottoressa Rossi, »), il corpo con la richiesta, la chiusura (« Cordiali saluti »).", "La richiesta si ammorbidisce: « Le scrivo per chiederle… », « Potrebbe cortesemente inviarmelo entro venerdì ? ».", "I connettivi ordinano il testo: « In allegato trova il documento », « Inoltre le confermo la riunione di giovedì »."), examples = listOf(ExampleLine(text = "Gentile Dottoressa Rossi,", meaning = "Il saluto al Lei."), ExampleLine(text = "Le scrivo per chiederle il preventivo aggiornato.", meaning = "Il motivo della mail."), ExampleLine(text = "Potrebbe cortesemente inviarlo entro venerdì ?", meaning = "La richiesta gentile."), ExampleLine(text = "In allegato trova le specifiche.", meaning = "Il rinvio agli allegati."), ExampleLine(text = "Cordiali saluti, Marco Bianchi", meaning = "La chiusura standard."))), expressions = listOf(TargetExpression(text = "Gentile… / Spett.le…", meaning = "Il saluto formale.", note = "Gentile Sig. Rossi,"), TargetExpression(text = "Le scrivo per…", meaning = "Il motivo della mail.", note = "Le scrivo per confermare l’appuntamento."), TargetExpression(text = "potrebbe cortesemente… ?", meaning = "La richiesta al Lei.", note = "Potrebbe cortesemente rispondermi ?"), TargetExpression(text = "in allegato", meaning = "Il documento allegato.", note = "In allegato trova il preventivo."), TargetExpression(text = "resto a disposizione", meaning = "La frase di servizio.", note = "Resto a disposizione per chiarimenti."), TargetExpression(text = "cordiali saluti", meaning = "La chiusura di lavoro.", note = "Cordiali saluti, Marco Bianchi")), situation = "Scrivi al cliente: chiedi il preventivo aggiornato, confermi la riunione di giovedì e chiudi con cordiali saluti.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Apri la mail alla Dottoressa Rossi.", expected = listOf("Gentile Dottoressa Rossi,", "Gentile Dott.ssa Rossi,"), focus = "il saluto", watch = "Gentile + titolo: la mail al Lei."), PracticeQuestion(prompt = "Dì il motivo: chiedi il preventivo aggiornato.", expected = listOf("Le scrivo per chiederle il preventivo aggiornato.", "Le scrivo per il preventivo aggiornato."), focus = "le scrivo per", watch = "Le = a Lei (a usted)."), PracticeQuestion(prompt = "Chiedi con cortesia di inviarlo entro venerdì.", expected = listOf("Potrebbe cortesemente inviarlo entro venerdì ?", "Le chiederei gentilmente di inviarlo entro venerdì."), focus = "potrebbe", watch = "potrebbe + infinito: la richiesta morbida."), PracticeQuestion(prompt = "Rimanda agli allegati.", expected = listOf("In allegato trova le specifiche.", "In allegato il documento."), focus = "in allegato", watch = "in allegato = adjunto."), PracticeQuestion(prompt = "Conferma la riunione di giovedì, in più.", expected = listOf("Inoltre le confermo la riunione di giovedì.", "Le confermo inoltre la riunione di giovedì."), focus = "inoltre", watch = "inoltre: aggiunge un punto."), PracticeQuestion(prompt = "Chiudi la mail in forma standard.", expected = listOf("Cordiali saluti, Marco Bianchi", "Cordiali saluti"), focus = "cordiali saluti", watch = "cordiali saluti = saludos cordiales."))), exercises = listOf(Exercise(id = "it-work-u1-email-e1", kind = "choice", prompt = "___ scrivo per chiederle un aggiornamento.", options = listOf("Le", "La", "Gli", "Ti"), answers = listOf("Le"), explain = "Le = a Lei: il destinatario formale."), Exercise(id = "it-work-u1-email-e2", kind = "gap", prompt = "In ___ trova il preventivo firmato. (viaggia con la mail)", options = listOf(), answers = listOf("allegato"), explain = "in allegato: il documento che viaggia con la mail."), Exercise(id = "it-work-u1-email-e3", kind = "order", prompt = "Chiudi la mail in forma formale.", options = listOf(), answers = listOf("Cordiali saluti Marco Bianchi"), explain = "Cordiali saluti + nome: la chiusura standard."), Exercise(id = "it-work-u1-email-e4", kind = "written", prompt = "Chiedi gentilmente al cliente di confermare l’appuntamento.", options = listOf(), answers = listOf("potrebbe cortesemente confermare l’appuntamento", "potrebbe cortesemente confermare l appuntamento", "le chiederei di confermare l’appuntamento", "potrebbe confermare l’appuntamento per favore"), explain = "potrebbe + infinito: la richiesta al Lei.")), skills = listOf("writing:email", "function:make-requests", "vocab:work", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "it-work-u1-colloqui", title = "Il colloquio", goal = "Raccontare esperienza e successi al colloquio con il passato prossimo e le mete.", intro = LessonIntro(explanation = listOf("L’esperienza si racconta al passato prossimo: « Ho lavorato cinque anni nel settore », « Mi sono occupata dei clienti chiave ».", "I successi si misurano: « Ho ridotto i costi del dieci per cento », « Il progetto è arrivato in tempo e in budget ».", "Le mete chiudono il colloquio: « Ho intenzione di crescere nel ruolo », « A lungo termine vorrei gestire un team »."), examples = listOf(ExampleLine(text = "Ho lavorato cinque anni nella logistica.", meaning = "L’esperienza."), ExampleLine(text = "Mi sono occupata dei clienti chiave.", meaning = "La responsabilità."), ExampleLine(text = "Ho ridotto i costi del dieci per cento.", meaning = "Il successo misurato."), ExampleLine(text = "Il progetto è arrivato in tempo e in budget.", meaning = "Il risultato."), ExampleLine(text = "Ho intenzione di crescere in questo ruolo.", meaning = "La meta."))), expressions = listOf(TargetExpression(text = "mi sono occupato / occupata di…", meaning = "La responsabilità raccontata.", note = "Mi sono occupato del cliente chiave."), TargetExpression(text = "ho ridotto / aumentato…", meaning = "Il successo misurato.", note = "Ho ridotto i costi del dieci per cento."), TargetExpression(text = "in tempo e in budget", meaning = "Il doppio risultato.", note = "Il progetto è arrivato in tempo e in budget."), TargetExpression(text = "ho intenzione di…", meaning = "Il piano di crescita.", note = "Ho intenzione di fare un master."), TargetExpression(text = "a lungo termine", meaning = "Il futuro lontano.", note = "A lungo termine vorrei un team mio.")), situation = "Colloquio per il ruolo di coordinatore: racconti il percorso, un successo misurato e la meta a lungo termine.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Racconta l’esperienza: cinque anni nella logistica.", expected = listOf("Ho lavorato cinque anni nella logistica.", "Ho lavorato per cinque anni nella logistica."), focus = "ho lavorato", watch = "lavorare → lavorato."), PracticeQuestion(prompt = "Dì la responsabilità: i clienti chiave.", expected = listOf("Mi sono occupata dei clienti chiave.", "Mi sono occupato dei clienti chiave."), focus = "mi sono occupato/a", watch = "occuparsi di + la cosa; il participio concorda."), PracticeQuestion(prompt = "Dì il successo: costi giù del dieci per cento.", expected = listOf("Ho ridotto i costi del dieci per cento.", "Ho ridotto i costi del 10 %."), focus = "ridurre", watch = "ridurre → ridotto + del + percentuale."), PracticeQuestion(prompt = "Dì che il progetto è arrivato in tempo e in budget.", expected = listOf("Il progetto è arrivato in tempo e in budget.", "È arrivato in tempo e in budget.", "E arrivato in tempo e in budget"), focus = "il risultato", watch = "essere + arrivato: il risultato finale."), PracticeQuestion(prompt = "Dì il piano: intenzione di crescere nel ruolo.", expected = listOf("Ho intenzione di crescere in questo ruolo.", "Ho intenzione di crescere professionalmente."), focus = "ho intenzione di", watch = "avere intenzione di + infinito."), PracticeQuestion(prompt = "Dì la meta a lungo termine: gestire un team.", expected = listOf("A lungo termine vorrei gestire un team.", "A lungo termine voglio gestire un team."), focus = "a lungo termine", watch = "la meta lontana, con calma."))), exercises = listOf(Exercise(id = "it-work-u1-colloqui-e1", kind = "choice", prompt = "___ ridotto i costi del dieci per cento.", options = listOf("Ho", "Sono", "Sto", "Faccio"), answers = listOf("Ho"), explain = "Avere + ridotto: il successo al passato prossimo."), Exercise(id = "it-work-u1-colloqui-e2", kind = "gap", prompt = "Mi sono ___ dei clienti chiave per due anni. (occuparsi, participio maschile)", options = listOf(), answers = listOf("occupato"), explain = "occuparsi → mi sono occupato (femminile: occupata)."), Exercise(id = "it-work-u1-colloqui-e3", kind = "order", prompt = "Dì il successo misurato: costi giù del dieci per cento.", options = listOf(), answers = listOf("Ho ridotto i costi del dieci per cento"), explain = "ridurre → ridotto + del + percentuale."), Exercise(id = "it-work-u1-colloqui-e4", kind = "written", prompt = "Dì la meta a lungo termine: gestire un team.", options = listOf(), answers = listOf("a lungo termine vorrei gestire un team", "a lungo termine voglio gestire un team", "a lungo termine mi piacerebbe gestire un team"), explain = "a lungo termine + vorrei / voglio + infinito.")), skills = listOf("function:talk-about-work", "grammar:present-perfect", "vocab:work", "function:describe-goals"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-perfect"))))
}

object PtFoundationsU1 {
    val unit = CourseUnit(id = "pt-foundations-u1", title = "First sentences", subtitle = "Say who you are", level = "A1", themes = listOf(ConversationTheme("lang-exchange", "Language-exchange café", "Meet and greet", "person.2", "Course", "You are at a friendly language-exchange café in São Paulo. Meet the learner, exchange names, countries and jobs using the verb ser.", 0),
                ConversationTheme("introductions", "Nice to meet you", "Start somewhere small", "hand.wave", "Connection", "Meet the learner for the first time. Learn their interests through natural introductions.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u1-ser", title = "The verb “ser”", goal = "Introduce yourself and say who people are with eu sou, você é, ele é, nós somos, eles são.", intro = LessonIntro(explanation = listOf("Every Portuguese sentence needs a subject and a verb. The verb for saying who you are is “ser”.", "Brazilian forms: eu sou, você é, ele/ela é, nós somos, eles/elas são. In Brazil you will hear “a gente é” for we are in casual talk.", "Use ser for identity and origin: “Eu sou a Ana”, “Sou do Brasil”, “Ele é professor”. Origin takes de: “Sou de São Paulo”."), examples = listOf(ExampleLine(text = "Eu sou a Ana. Sou do Brasil.", meaning = "Your name and country."), ExampleLine(text = "Você é meu melhor amigo.", meaning = "A close bond with someone."), ExampleLine(text = "Ela é professora.", meaning = "Someone's profession."), ExampleLine(text = "A gente é muito feliz hoje.", meaning = "A feeling that defines right now (casual we)."), ExampleLine(text = "O café é perto da estação.", meaning = "Where a place is."), ExampleLine(text = "Eles são de São Paulo.", meaning = "Someone's origin."))), expressions = listOf(TargetExpression(text = "Eu sou …", meaning = "Introduce yourself.", note = "With your name or job: Eu sou a Ana. Sou professora."), TargetExpression(text = "Sou do / Sou da …", meaning = "Say where you come from.", note = "Masculine do, feminine da: Sou do Brasil. Sou da Espanha."), TargetExpression(text = "Você é … ?", meaning = "Ask about the other person.", note = "Você é professora? Você é daqui?"), TargetExpression(text = "Sou, sim. / Não, não sou.", meaning = "Short answers to a Você é… ? question.", note = "The sim repeats the verb: Sou, sim."), TargetExpression(text = "Ele é / Ela é …", meaning = "Say what someone else is.", note = "Ele é médico — no article with jobs."), TargetExpression(text = "Prazer em conhecer você.", meaning = "The fixed phrase when you meet someone.", note = "Short and natural: Prazer!")), situation = "You meet someone new at a friendly language-exchange café in São Paulo. Introduce yourselves and ask simple questions with the verb ser.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Oi! Eu sou a Ana. Como você se chama?", expected = listOf("Meu nome é <name>.", "Eu sou o <name>.", "Eu sou a <name>.", "Me chamo <name>."), focus = "Meu nome é / Me chamo", watch = "Answering only the name: accept it, then recast “Meu nome é …”."), PracticeQuestion(prompt = "De onde você é?", expected = listOf("Sou do <country>.", "Sou da <country>.", "Sou de <city>."), focus = "ser + de", watch = "“Sou Brasil” — recast “Sou DO Brasil”: the article joins de."), PracticeQuestion(prompt = "Você é estudante?", expected = listOf("Sou, sim.", "Não, não sou."), focus = "short answers with ser", watch = "One-word “Sim” — recast with the verb: Sou, sim."), PracticeQuestion(prompt = "Como você está hoje?", expected = listOf("Estou bem.", "Estou cansado.", "Estou feliz."), focus = "estar for feelings", watch = "“Sou cansado” — recast “Estou cansado”: feelings take estar."), PracticeQuestion(prompt = "Sua cidade é grande ou pequena?", expected = listOf("É grande.", "É pequena.", "Minha cidade é …"), focus = "é with places", watch = "“Minha cidade grande” — recast “Minha cidade É grande”."), PracticeQuestion(prompt = "Agora somos amigos! De onde é sua família?", expected = listOf("É do <country>.", "Minha família é do <country>.", "É da <country>."), focus = "é for a group's origin", watch = "“Minha família de …” — recast with é."))), exercises = listOf(Exercise(id = "pt-foundations-u1-ser-e1", kind = "choice", prompt = "Ela ___ professora.", options = listOf("é", "és", "sou", "somos"), answers = listOf("é"), explain = "With ele/ela/você, ser becomes é."), Exercise(id = "pt-foundations-u1-ser-e2", kind = "gap", prompt = "Nós ___ de São Paulo.", options = listOf(), answers = listOf("somos"), explain = "With nós, ser é sempre somos."), Exercise(id = "pt-foundations-u1-ser-e3", kind = "order", prompt = "Say where you are from.", options = listOf(), answers = listOf("Sou do Brasil"), explain = "Sou + do/da + country: Sou do Brasil."), Exercise(id = "pt-foundations-u1-ser-e4", kind = "written", prompt = "Introduce yourself in one sentence: say your name.", options = listOf(), answers = listOf("Meu nome é <name>", "Me chamo <name>", "Eu sou <name>"), explain = "Meu nome é Ana / Me chamo Ana — the verb is never dropped.")), skills = listOf("grammar:verb-be", "grammar:subject-pronouns", "function:describe-people", "speaking:short-answer"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:verb-be")),
    Lesson(id = "pt-foundations-u1-questions", title = "Questions & negatives", goal = "Ask yes/no questions and say what is not true, with Você é… ? and não sou.", intro = LessonIntro(explanation = listOf("Brazilian Portuguese asks yes/no questions with rising intonation — same words, same order: “Você é a Ana?” You can also add é at the end: “Você é a Ana, né?”", "Question words go first: “De onde você é?”, “O que é isso?” — and they stay in one piece: onde, o que.", "To negate, put não before the verb: “Não sou a Ana”, “Não somos amigos”. In short answers the verb answers alone: “Sou, sim.”"), examples = listOf(ExampleLine(text = "Você é professora?", meaning = "A yes/no question with é."), ExampleLine(text = "Não sou de São Paulo.", meaning = "A negative with sou."), ExampleLine(text = "De onde você é?", meaning = "Question word + é."), ExampleLine(text = "Ele não é meu irmão.", meaning = "A negative about another person."), ExampleLine(text = "Vocês são vizinhos?", meaning = "Asking a group."), ExampleLine(text = "O que é isso?", meaning = "What is this?"))), expressions = listOf(TargetExpression(text = "Você é … ?", meaning = "Ask a yes/no question.", note = "Add né? at the end in casual talk."), TargetExpression(text = "Não sou …", meaning = "Say what is not true about you.", note = "Não always goes before the verb."), TargetExpression(text = "De onde você é?", meaning = "Ask where someone is from.", note = "De onde, two words."), TargetExpression(text = "Ele não é …", meaning = "Say what someone else is not.", note = "Ele não é meu chefe."), TargetExpression(text = "…, né?", meaning = "Tag a statement to check it.", note = "Você é daqui, né? = ¿verdad?"), TargetExpression(text = "Claro.", meaning = "The natural yes in talk.", note = "Also: Com certeza.")), situation = "You chat with a new neighbour in the lift in São Paulo. Ask simple yes/no questions and say what is and isn't true for you.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Você é daqui?", expected = listOf("Sou, sim.", "Não, não sou daqui."), focus = "short answers", watch = "One-word “Sim” — recast with the verb: Sou, sim."), PracticeQuestion(prompt = "Você é professor ou estudante?", expected = listOf("Sou professor.", "Sou estudante.", "Sou professora."), focus = "choice with ser", watch = "Accept either; the article stays dropped."), PracticeQuestion(prompt = "Sua família é grande?", expected = listOf("É, sim.", "Não, não é grande."), focus = "é in questions about others", watch = "“Não é grande” — não before é."), PracticeQuestion(prompt = "De onde você é, exatamente?", expected = listOf("Sou do <country>.", "Sou da <country>.", "Sou de <city>."), focus = "de onde + sou", watch = "“Sou em São Paulo” — recast with de."), PracticeQuestion(prompt = "Me diga uma coisa que você não é.", expected = listOf("Não sou <job>.", "Não sou do <country>."), focus = "negation with não sou", watch = "“Sou não” doesn't work here — não first."), PracticeQuestion(prompt = "A gente é amigo, né?", expected = listOf("É, a gente é amigo.", "Somos, sim."), focus = "a gente é", watch = "“A gente somos” is wrong — a gente takes é."))), exercises = listOf(Exercise(id = "pt-foundations-u1-questions-e1", kind = "choice", prompt = "___ você de Ribeirão?", options = listOf("É", "És", "Sou", "Somos"), answers = listOf("É"), explain = "With você, the question starts with É."), Exercise(id = "pt-foundations-u1-questions-e2", kind = "gap", prompt = "Ela não é ___ irmã.", options = listOf(), answers = listOf("minha"), explain = "minha for feminine things: minha irmã."), Exercise(id = "pt-foundations-u1-questions-e3", kind = "order", prompt = "Say you are not from Rio.", options = listOf(), answers = listOf("Não sou do Rio"), explain = "Não goes first: Não sou do Rio."), Exercise(id = "pt-foundations-u1-questions-e4", kind = "written", prompt = "Make it negative: \"Sou de Curitiba.\"", options = listOf(), answers = listOf("Não sou de Curitiba"), explain = "não + sou: Não sou de Curitiba.")), skills = listOf("grammar:verb-be", "grammar:present-questions", "function:ask-simple-questions", "speaking:short-answer"), prerequisites = listOf("grammar:subject-pronouns")),
    Lesson(id = "pt-foundations-u1-introduce", title = "Introducing yourself", goal = "Give a complete self-introduction: name, city, nationality and job.", intro = LessonIntro(explanation = listOf("A full Brazilian introduction has four pieces: your name, your city, your nationality and your job.", "For the name: “Meu nome é Ana”, “Me chamo Ana” or “Eu sou a Ana”. For origin: “Sou de São Paulo” — do joins the article: do Brasil, da Espanha.", "Nationalities are lower-case: “sou brasileira”. Jobs with ser drop the article: “sou professora”. Close with “Prazer!” and bounce the question back with “E você?”"), examples = listOf(ExampleLine(text = "Meu nome é Ana. Prazer!", meaning = "Your name plus a polite close."), ExampleLine(text = "Sou de São Paulo, capital.", meaning = "City inside country."), ExampleLine(text = "Sou brasileira, de São Paulo.", meaning = "Nationality plus city."), ExampleLine(text = "Sou enfermeira num hospital.", meaning = "Job plus workplace."), ExampleLine(text = "Tenho vinte e cinco anos.", meaning = "Your age — with ter, not ser."), ExampleLine(text = "E você? O que você faz?", meaning = "Bounce the question back."))), expressions = listOf(TargetExpression(text = "Meu nome é …", meaning = "Give your name.", note = "Also: Me chamo … or Eu sou a/o …"), TargetExpression(text = "Sou + nationality", meaning = "Say your nationality.", note = "brasileira, argentina, portuguesa — lower-case in Portuguese."), TargetExpression(text = "Sou do / da …", meaning = "Say your city or country.", note = "do for masculine, da for feminine: do Brasil, da Espanha."), TargetExpression(text = "Trabalho em …", meaning = "Say where you work.", note = "Trabalho num hospital / numa escola."), TargetExpression(text = "Prazer!", meaning = "Polite close when you meet someone.", note = "Answer: Prazer! or O prazer é meu."), TargetExpression(text = "E você?", meaning = "Bounce the question back.", note = "—Sou de São Paulo. E você?")), situation = "Your first day at a language school in São Paulo. Present yourself completely to the class: name, city, nationality and job.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Como você se chama?", expected = listOf("Meu nome é <name>.", "Me chamo <name>."), focus = "name formulas", watch = "Both are fine; recast the shorter one as Meu nome é for variety."), PracticeQuestion(prompt = "De onde você é?", expected = listOf("Sou do <country>.", "Sou da <country>."), focus = "origin with do/da", watch = "The article joins de: DO Brasil, DA Espanha."), PracticeQuestion(prompt = "Qual é a sua nacionalidade?", expected = listOf("Sou <nationality>."), focus = "nationality with ser", watch = "Lower-case: sou brasileira, not Brasileira."), PracticeQuestion(prompt = "O que você faz?", expected = listOf("Sou <job>.", "Trabalho como <job>."), focus = "jobs without article", watch = "“Sou uma professora” — recast dropping the article."), PracticeQuestion(prompt = "E onde você mora?", expected = listOf("Moro em <city>."), focus = "moro em", watch = "“Moro em São Paulo” — em for cities."), PracticeQuestion(prompt = "Prazer! E você, o que faz?", expected = listOf("Sou <job>."), focus = "bounce back and answer", watch = "Recast with Sou + job."))), exercises = listOf(Exercise(id = "pt-foundations-u1-introduce-e1", kind = "choice", prompt = "___ Ana. Prazer!", options = listOf("Meu nome é", "Meu nome de", "Me chamo em", "Estou"), answers = listOf("Meu nome é"), explain = "Meu nome é + name: one piece."), Exercise(id = "pt-foundations-u1-introduce-e2", kind = "gap", prompt = "Sou ___ Itália. (nationality)", options = listOf(), answers = listOf("italiana"), explain = "Nationality is lower-case: italiana, italiano."), Exercise(id = "pt-foundations-u1-introduce-e3", kind = "order", prompt = "Say your name and city.", options = listOf(), answers = listOf("Sou a Ana e sou de São Paulo"), explain = "Two sou pieces, both with their verb."), Exercise(id = "pt-foundations-u1-introduce-e4", kind = "written", prompt = "Give your complete introduction: name and country.", options = listOf(), answers = listOf("Meu nome é <name> e sou do <country>", "Meu nome é <name> e sou da <country>", "Me chamo <name> e sou do <country>"), explain = "Name + origin, each with its verb.")), skills = listOf("grammar:verb-be", "function:introduce-yourself", "vocab:introductions", "pron:word-stress"), canDo = listOf("introduce-yourself"))))
}

object PtFoundationsU2 {
    val unit = CourseUnit(id = "pt-foundations-u2", title = "Meu dia a dia", subtitle = "Rotina e planos", level = "A1", themes = listOf(ConversationTheme("manha-agitada", "Manhã agitada", "Contra o relógio", "sunrise", "Course", "Você conta a sua manhã minuto a minuto: horas, hábitos e esquecimentos.", 0),
                ConversationTheme("sabado-juntos", "Sábado juntos", "O que vamos fazer?", "figure.walk", "Course", "Planos para sábado com um amigo: feira, hora e lugar do encontro.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u2-rotina", title = "Minha rotina", goal = "Contar o seu dia no presente com as horas.", intro = LessonIntro(explanation = listOf("O presente conta as rotinas: « Acordo às sete. Tomo café com pão de queijo. Saio de casa às oito. »", "Os dias da semana com plural = toda semana: « aos sábados acordo tarde ».", "As horas com às : « às oito », « às oito e meia ». Com a: « a noite eu fico em casa »."), examples = listOf(ExampleLine(text = "Acordo às sete.", meaning = "O primeiro verbo do dia."), ExampleLine(text = "Tomo café com pão de queijo.", meaning = "O café da manhã."), ExampleLine(text = "Saio de casa às oito.", meaning = "A saída."), ExampleLine(text = "Aos sábados acordo tarde.", meaning = "O hábito do fim de semana."), ExampleLine(text = "Vou para a cama às onze.", meaning = "A hora de dormir."))), expressions = listOf(TargetExpression(text = "Acordo às …", meaning = "Acorde.", note = "acordar às + hora."), TargetExpression(text = "Tomo café …", meaning = "O desjejum.", note = "tomar café da manhã."), TargetExpression(text = "Saio de casa às …", meaning = "A saída.", note = "sair DE casa."), TargetExpression(text = "Aos sábados …", meaning = "O hábito.", note = "aos + dia = todos os."), TargetExpression(text = "Vou para a cama às …", meaning = "Dormir.", note = "ir para a cama.")), situation = "Você conta a sua manhã para um amigo novo: hora de acordar, café, saída — e como muda no sábado.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga a que hora você acorda na semana.", expected = listOf("Acordo às <hora> na semana."), focus = "acordar às", watch = "acordar ÀS + hora."), PracticeQuestion(prompt = "Diga o que você toma no café da manhã.", expected = listOf("Tomo <comida> e <comida>."), focus = "tomar", watch = "tomar café da manhã."), PracticeQuestion(prompt = "Diga a que hora sai de casa.", expected = listOf("Saio de casa às <hora>."), focus = "sair de", watch = "sair DE casa."), PracticeQuestion(prompt = "Diga o hábito do sábado.", expected = listOf("Aos sábados acordo tarde."), focus = "aos + dia", watch = "aos sábados = todos os sábados."), PracticeQuestion(prompt = "Diga a que hora vai para a cama.", expected = listOf("Vou para a cama às <hora>."), focus = "ir para a cama", watch = "ir PARA a cama."))), exercises = listOf(Exercise(id = "pt-foundations-u2-rotina-e1", kind = "choice", prompt = "___ às sete todos os dias.", options = listOf("Acordo", "Acordo me", "Acorda", "Acordar"), answers = listOf("Acordo"), explain = "Eu acordo: sem pronome solto."), Exercise(id = "pt-foundations-u2-rotina-e2", kind = "gap", prompt = "___ café com pão de queijo. (tomar café)", options = listOf(), answers = listOf("Tomo", "tomo"), explain = "eu tomo café."), Exercise(id = "pt-foundations-u2-rotina-e3", kind = "order", prompt = "Diga a hora de sair.", options = listOf(), answers = listOf("Saio de casa as oito"), explain = "saio de + lugar + às + hora."), Exercise(id = "pt-foundations-u2-rotina-e4", kind = "written", prompt = "O hábito do sábado.", options = listOf(), answers = listOf("aos sabados acordo tarde", "no sabado acordo tarde"), explain = "aos + dia + presente.")), skills = listOf("grammar:present-simple", "grammar:time-expressions", "vocab:daily-routine", "function:talk-about-routines"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u2-bairro", title = "Meu bairro", goal = "Dizer o que tem no seu bairro com tem / existe.", intro = LessonIntro(explanation = listOf("No Brasil informal, tem para tudo: « Tem um bar, dois mercado e uma praça ». Formal: existe / há.", "Perguntar: « Tem uma farmácia perto daqui? ». Negar: « Não tem cinema, desculpa ».", "Localizar: em frente a, do lado de, perto de : « A feira fica em frente ao parque »."), examples = listOf(ExampleLine(text = "Tem um bar e dois mercados.", meaning = "tem não muda com plural."), ExampleLine(text = "Tem uma farmácia perto daqui?", meaning = "A pergunta útil."), ExampleLine(text = "Não tem cinema no meu bairro.", meaning = "A negação."), ExampleLine(text = "A feira fica em frente ao parque.", meaning = "A localização."), ExampleLine(text = "Tudo fica perto de casa.", meaning = "O resumo."))), expressions = listOf(TargetExpression(text = "Tem + lugar", meaning = "Dizer o que existe.", note = "Tem uma padaria."), TargetExpression(text = "Tem … perto daqui?", meaning = "Perguntar.", note = "…uma farmácia?"), TargetExpression(text = "Não tem …", meaning = "O que falta.", note = "Não tem cinema."), TargetExpression(text = "fica em frente a / do lado de", meaning = "Localizar.", note = "em frente ao parque."), TargetExpression(text = "perto de casa", meaning = "A distância.", note = "tudo é perto.")), situation = "Um visitante pergunta do seu bairro: nomeie quatro lugares, diga o que falta e localize o seu preferido.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga dois lugares do seu bairro.", expected = listOf("Tem <lugar> e <lugar>."), focus = "tem", watch = "tem não muda: tem um, tem dois."), PracticeQuestion(prompt = "Diga o que não tem. (cinema)", expected = listOf("Não tem cinema no meu bairro."), focus = "não tem", watch = "Não tem + lugar."), PracticeQuestion(prompt = "Pergunte se tem farmácia perto.", expected = listOf("Tem uma farmácia perto daqui?"), focus = "perto daqui", watch = "perto daqui = aquí cerca."), PracticeQuestion(prompt = "Localize o seu lugar favorito.", expected = listOf("<Lugar> fica em frente a <lugar>."), focus = "em frente a", watch = "em frente A + lugar."), PracticeQuestion(prompt = "Diga que tudo fica perto da sua casa.", expected = listOf("Tudo fica perto de casa."), focus = "perto de", watch = "perto DE casa."))), exercises = listOf(Exercise(id = "pt-foundations-u2-bairro-e1", kind = "choice", prompt = "___ um bar e dois mercados.", options = listOf("Tem", "Há também", "São", "Estão"), answers = listOf("Tem"), explain = "Tem para dizer o que existe (Brasil informal)."), Exercise(id = "pt-foundations-u2-bairro-e2", kind = "gap", prompt = "Não ___ cinema no meu bairro.", options = listOf(), answers = listOf("tem"), explain = "Não tem + lugar."), Exercise(id = "pt-foundations-u2-bairro-e3", kind = "order", prompt = "Pergunte por uma farmácia.", options = listOf(), answers = listOf("Tem uma farmacia perto daqui"), explain = "Tem + lugar + perto daqui?"), Exercise(id = "pt-foundations-u2-bairro-e4", kind = "written", prompt = "Diga o que tem em frente à sua casa.", options = listOf(), answers = listOf("tem <lugar> em frente a minha casa", "tem um mercado em frente"), explain = "Tem + lugar + em frente a.")), skills = listOf("vocab:town", "grammar:there-is-are", "grammar:prepositions-place", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:there-is-are")),
    Lesson(id = "pt-foundations-u2-planos", title = "Planos para sábado", goal = "Propor planos com vamos e combinar hora e lugar.", intro = LessonIntro(explanation = listOf("O futuro próximo: ir + infinitivo. « No sábado vamos à feira ». O ir conjuga, o segundo verbo fica no infinitivo.", "Propor: « Vamos à feira? », « Você quer vir? ». Combinar: « Nos vemos às seis na praça? »", "Confirmar com hora e lugar: « Fechado, às seis na praça ». Plano sem lugar é desejo."), examples = listOf(ExampleLine(text = "No sábado vamos à feira.", meaning = "ir + infinitivo."), ExampleLine(text = "Você quer vir com a gente?", meaning = "O convite."), ExampleLine(text = "Nos vemos às seis na praça?", meaning = "A hora e o lugar."), ExampleLine(text = "Fechado, até sábado!", meaning = "A confirmação."), ExampleLine(text = "Se chover, marcamos para domingo.", meaning = "O plano B."))), expressions = listOf(TargetExpression(text = "vamos a + lugar / ir + infinitivo", meaning = "O plano.", note = "vamos à feira."), TargetExpression(text = "Você quer vir?", meaning = "Convidar.", note = "vir com a gente."), TargetExpression(text = "Nos vemos às … , …", meaning = "O encontro.", note = "às + hora + em + lugar."), TargetExpression(text = "Fechado / Combinado", meaning = "Confirmar.", note = "fechado = quedamos."), TargetExpression(text = "Se chover, …", meaning = "O plano B.", note = "se + presente + plano.")), situation = "Você organiza o sábado com um amigo: feira, encontro às seis na praça e plano B se chover.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Proponha a feira no sábado.", expected = listOf("No sábado vamos à feira."), focus = "vamos a", watch = "vamos A + lugar (a + a = à)."), PracticeQuestion(prompt = "Convide o seu amigo.", expected = listOf("Você quer vir com a gente?"), focus = "vir", watch = "vir COM a gente."), PracticeQuestion(prompt = "Combine o encontro. (6, praça)", expected = listOf("Nos vemos às seis na praça?"), focus = "nos vemos", watch = "nos vemos ÀS + hora."), PracticeQuestion(prompt = "Dê o plano B se chover.", expected = listOf("Se chover, marcamos para domingo."), focus = "se + presente", watch = "se + presente + plano."), PracticeQuestion(prompt = "Convide o seu amigo para o plano.", expected = listOf("Você quer vir com a gente?"), focus = "vir", watch = "vir COM a gente."))), exercises = listOf(Exercise(id = "pt-foundations-u2-planos-e1", kind = "choice", prompt = "No sábado vamos ___ feira.", options = listOf("à", "a", "para a", "na"), answers = listOf("à"), explain = "vamos A + A feira = vamos À feira."), Exercise(id = "pt-foundations-u2-planos-e2", kind = "gap", prompt = "___ vemos às seis na praça? (encontro)", options = listOf(), answers = listOf("Nos"), explain = "Nos vemos = nos vemos."), Exercise(id = "pt-foundations-u2-planos-e3", kind = "order", prompt = "Combine o encontro.", options = listOf(), answers = listOf("Nos vemos as seis na praca"), explain = "nos vemos + às + hora + em + lugar."), Exercise(id = "pt-foundations-u2-planos-e4", kind = "written", prompt = "O plano B se chover.", options = listOf(), answers = listOf("se chover marcamos para domingo", "se chover vamos ao cinema"), explain = "se + presente + plano.")), skills = listOf("grammar:going-to", "function:make-future-plans", "vocab:social-expressions", "grammar:present-questions"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to"))))
}

object PtFoundationsU5 {
