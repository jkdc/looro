    val unit = CourseUnit(id = "pt-foundations-u14", title = "Em movimento", subtitle = "Metrô, ônibus e trem", level = "A1", themes = listOf(ConversationTheme("mover-transporte", "O transporte", "Como eu vou", "bus", "Course", "O Leo mostra como vai para o trabalho: pega o metrô, o ônibus e às vezes vai a pé.", 0),
                ConversationTheme("mover-horarios", "Os horários", "Horas e passagens", "tram", "Course", "Na estação, o grupo pergunta as horas, compra passagens e pega o trem certo.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u14-transporte", title = "Como eu vou", goal = "Falar do transporte do dia a dia: pego o metrô, pego o ônibus, vou a pé.", intro = LessonIntro(explanation = listOf("Meios de transporte: « o metrô, o ônibus, o trem, o carro, a bicicleta ». « Eu pego o metrô todo dia ».", "Usar « pegar » com o transporte: « Pego o ônibus às sete ». Sem veículo é « vou a pé »: « Vou a pé para o trabalho ».", "Perguntar como a pessoa vai: « Como você vai para o trabalho ? ». A resposta usa « pego » ou « vou »: « Pego o trem »."), examples = listOf(ExampleLine(text = "Eu pego o metrô todo dia.", meaning = "pegar + transporte."), ExampleLine(text = "Pego o ônibus às sete.", meaning = "hora + transporte."), ExampleLine(text = "Vou a pé para o trabalho.", meaning = "a pé = caminhando."), ExampleLine(text = "Ela vai de bicicleta para a escola.", meaning = "de + transporte."), ExampleLine(text = "Como você vai para o trabalho ?", meaning = "Perguntar o meio."))), expressions = listOf(TargetExpression(text = "pego o metrô", meaning = "Uso o metrô.", note = "Pego o metrô às oito."), TargetExpression(text = "pega o ônibus", meaning = "Uso o ônibus.", note = "Ele pega o ônibus."), TargetExpression(text = "vou a pé", meaning = "Caminho.", note = "Vou a pé para a escola."), TargetExpression(text = "de trem / de bicicleta", meaning = "Meio de transporte.", note = "Ela vai de bicicleta."), TargetExpression(text = "Como você vai ?", meaning = "Perguntar o transporte.", note = "Como você vai para casa ?")), situation = "O Leo mostra como vai para o trabalho: pega o metrô, o ônibus e às vezes vai a pé.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga que você pega o metrô todo dia.", expected = listOf("Eu pego o metrô todo dia.", "eu pego