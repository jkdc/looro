object DeFoundationsU12 {
    val unit = CourseUnit(id = "de-foundations-u12", title = "Meine Leute", subtitle = "Familie und Freunde", level = "A1", themes = listOf(ConversationTheme("meine-familie", "Meine Familie", "Wer ist das ?", "figure-2", "Course", "Nadia zeigt Fotos: ihre Mutter, ihr Bruder, ihr Onkel — wer ist wer ?", 0),
                ConversationTheme("gute-freunde", "Gute Freunde", "Wie ist er ?", "heart", "Course", "Ihr beschreibt eure Freunde: nett, schüchtern, fleißig. Und dann klingelt das Telefon.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u12-familie", title = "Meine Familie", goal = "Familienmitglieder nennen und mit mein und haben sagen, wer zu dir gehört.", intro = LessonIntro(explanation = listOf("Die Familie: die Mutter, der Vater, die Schwester, der Bruder, die Oma, der Opa. Beispiel: „Das ist meine Schwester.“", "mein + Person: „mein Bruder“ (der), „meine Mutter“ (die). Beispiel: „Meine Oma wohnt in Berlin.“", "haben + einen/eine: „Ich habe einen Bruder.“ „Ich habe eine Schwester.“ Beispiel: „Ich habe auch einen Onkel.“"), examples = listOf(ExampleLine(text = "Das ist meine Familie.", meaning = "Was du zeigst: meine Familie."), ExampleLine(text = "Ich habe einen Bruder und eine Schwester.", meaning = "haben + einen (der) / eine (die)."), ExampleLine(text = "Meine Oma ist 80 Jahre alt.", meaning = "meine + die Oma."), ExampleLine(text = "Mein Onkel heißt Karim.", meaning = "mein + der Onkel."), ExampleLine(text = "Hast du Geschwister ?", meaning = "Frage nach der Familie."))), expressions = listOf(TargetExpression(text = "die Mutter / der Vater", meaning = "Die Eltern.", note = "Meine Mutter kocht gut."), TargetExpression(text = "die Schwester / der Bruder", meaning = "Geschwister.", note = "Ich habe einen Bruder."), TargetExpression(text = "die Oma / der Opa", meaning = "Die Großeltern.", note = "Mein Opa ist 85."), TargetExpression(text = "die Tante / der Onkel", meaning = "Weitere Familie.", note = "mein Onkel aus Wien"), TargetExpression(text = "Ich habe …", meaning = "Sagen, wer zu dir gehört.", note = "haben + einen / eine: Ich habe eine Tante.")), situation = "Nadia zeigt ein Familienfoto: Mutter, Vater, Bruder, Oma — und einen Onkel aus Wien.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Zeigst deine Mutter vor.", expected = listOf("Das ist meine Mutter.", "das ist meine mutter"), focus = "das ist mein …", watch = "die Mutter: meine Mutter."), PracticeQuestion(prompt = "Sagt, wen du hast. (ein Bruder)", expected = listOf("Ich habe einen Bruder.", "ich habe einen bruder"), focus = "haben + einen", watch = "der Bruder: einen Bruder."), PracticeQuestion(prompt = "Sagt, wen du hast. (eine Schwester)", expected = listOf("Ich habe eine Schwester.", "ich habe eine schwester"), focus = "haben + eine", watch = "die Schwester: eine Schwester."), PracticeQuestion(prompt = "Fragst, ob jemand Geschwister hat.", expected = listOf("Hast du Geschwister ?", "hast du geschwister"), focus = "hast du … ?", watch = "du + haben = hast."), PracticeQuestion(prompt = "Sagt, wen du hast. (eine Tante)", expected = listOf("Ich habe eine Tante.", "ich habe eine tante"), focus = "die Tante", watch = "die Tante: eine Tante."))), exercises = listOf(Exercise(id = "de-foundations-u12-familie-e1", kind = "choice", prompt = "Ich habe ___ Bruder.", options = listOf("einen", "eine", "ein", "kein"), answers = listOf("einen"), explain = "haben + Akkusativ Maskulin: einen Bruder."), Exercise(id = "de-foundations-u12-familie-e2", kind = "gap", prompt = "Die Schwester von meinem Vater ist meine ___.", options = listOf(), answers = listOf("tante", "Tante"), explain = "Familienvokabel: die Schwester vom Vater ist die Tante."), Exercise(id = "de-foundations-u12-familie-e3", kind = "order", prompt = "Sagt, wen du hast. (Onkel)", options = listOf(), answers = listOf("Ich habe einen Onkel"), explain = "haben + einen Onkel: so sagt man, wer zu dir gehört."), Exercise(id = "de-foundations-u12-familie-e4", kind = "written", prompt = "Schreib einen Satz über deine Oma. (kochen)", options = listOf(), answers = listOf("meine oma kocht gut", "meine oma kocht gern", "meine oma kocht"), explain = "meine + die Oma: meine Oma kocht.")), skills = listOf("vocab:family", "grammar:possessives", "grammar:present-simple", "function:describe-people"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:possessives")),
    Lesson(id = "de-foundations-u12-freunde", title = "Wie ist er ?", goal = "Freunde mit Adjektiven beschreiben und fragen: Wie ist er ? Wie ist sie ?", intro = LessonIntro(explanation = listOf("Adjektive für Leute: nett, lustig, schüchtern, fleißig, sportlich. Beispiel: „Mia ist nett.“", "sein + Adjektiv: „Er ist lustig.“ „Sie ist schüchtern.“ So beschreibt man Leute.", "Frage: „Wie ist er ?“ — „Er ist sehr nett.“ Beispiel: „Und Lisa ? Sie ist fleißig.“"), examples = listOf(ExampleLine(text = "Mein Freund Jonas ist sehr nett.", meaning = "Beschreibung: sein + nett."), ExampleLine(text = "Er ist schüchtern, aber sehr fleißig.", meaning = "aber: zwei Adjektive, auch Gegensätze."), ExampleLine(text = "Wie ist deine Schwester ?", meaning = "Nach einer Person fragen."), ExampleLine(text = "Sie ist lustig und sportlich.", meaning = "und: zwei Adjektive zusammen."), ExampleLine(text = "Unser Lehrer ist immer freundlich.", meaning = "Adjektiv nach ist: keine Endung."))), expressions = listOf(TargetExpression(text = "nett / freundlich", meaning = "Positive Leute.", note = "Jonas ist nett."), TargetExpression(text = "schüchtern", meaning = "Nicht viel sprechen vor neuen Leuten.", note = "Sie ist schüchtern."), TargetExpression(text = "fleißig", meaning = "Viel arbeiten und lernen.", note = "Er ist fleißig."), TargetExpression(text = "lustig", meaning = "Man lacht viel.", note = "Mia ist lustig."), TargetExpression(text = "Wie ist er / sie ?", meaning = "Nach einer Person fragen.", note = "Wie ist dein Bruder ?")), situation = "Ben und Lena beschreiben ihre Freunde: Jonas ist schüchtern, aber fleißig. Mia ist lustig.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Fragst nach Bens Bruder.", expected = listOf("Wie ist Bens Bruder ?", "Wie ist er ?", "wie ist er"), focus = "wie ist … ?", watch = "Frage mit wie + sein."), PracticeQuestion(prompt = "Sagt, wie Jonas ist. (nett)", expected = listOf("Er ist nett.", "er ist nett", "er ist sehr nett"), focus = "sein + Adjektiv", watch = "Nach er: ist + Adjektiv."), PracticeQuestion(prompt = "Sagt, wie Lisa ist. (schüchtern)", expected = listOf("Sie ist schüchtern.", "sie ist schuechtern"), focus = "schüchtern", watch = "ü = ue: schuechtern."), PracticeQuestion(prompt = "Zwei Adjektive: Jonas ist fleißig und nett.", expected = listOf("Er ist fleißig und nett.", "er ist fleissig und nett"), focus = "ß = ss", watch = "fleißig: fleissig ohne ß."), PracticeQuestion(prompt = "Sagt, wie deine Mutter ist. (freundlich)", expected = listOf("Meine Mutter ist freundlich.", "meine mutter ist freundlich"), focus = "meine + Person", watch = "die Mutter: meine Mutter."))), exercises = listOf(Exercise(id = "de-foundations-u12-freunde-e1", kind = "choice", prompt = "Jonas ist sehr ___. Er hilft allen.", options = listOf("nett", "teuer", "leer", "neu"), answers = listOf("nett"), explain = "nett passt zu Personen: Jonas hilft allen."), Exercise(id = "de-foundations-u12-freunde-e2", kind = "gap", prompt = "Lisa ist sehr ___. Sie lernt jeden Tag.", options = listOf(), answers = listOf("fleissig", "fleißig"), explain = "Wer viel lernt, ist fleißig."), Exercise(id = "de-foundations-u12-freunde-e3", kind = "order", prompt = "Fragst nach Lena.", options = listOf(), answers = listOf("Wie ist Lena"), explain = "Frage nach einer Person: Wie ist sie ?"), Exercise(id = "de-foundations-u12-freunde-e4", kind = "written", prompt = "Beschreibst Mia. (lustig und sportlich)", options = listOf(), answers = listOf("mia ist lustig und sportlich", "Mia ist lustig und sportlich."), explain = "sein + zwei Adjektive mit und.")), skills = listOf("function:describe-people", "grammar:present-simple", "vocab:feelings", "function:ask-simple-questions"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u12-anruf", title = "Ein Anruf", goal = "Am Telefon fragen, ob jemand da ist, und sagen, dass du später anrufst.", intro = LessonIntro(explanation = listOf("Am Telefon: „Hallo, hier ist Nadia.“ So sagt man, wer du bist.", "Frage: „Ist Papa da ?“ — „Nein, er ist nicht da.“ So fragt man, ob jemand da ist.", "anrufen: „Ich rufe später an.“ Beispiel: „Rufst du morgen an ?“"), examples = listOf(ExampleLine(text = "Hallo, hier ist Nadia.", meaning = "Am Telefon: dein Name."), ExampleLine(text = "Ist dein Vater da ?", meaning = "Frage: Ist … da ?"), ExampleLine(text = "Nein, er ist nicht da.", meaning = "Negative Antwort: nicht da."), ExampleLine(text = "Wann ist er wieder da ?", meaning = "Nach der Zeit fragen."), ExampleLine(text = "Ich rufe später an.", meaning = "anrufen: ich rufe … an."))), expressions = listOf(TargetExpression(text = "Hallo, hier ist …", meaning = "Sich am Telefon melden.", note = "hier ist + Name"), TargetExpression(text = "Ist … da ?", meaning = "Fragen, ob jemand da ist.", note = "Ist Mama da ?"), TargetExpression(text = "Er / sie ist nicht da.", meaning = "Sagen, dass jemand weg ist.", note = "Sie ist nicht zu Hause."), TargetExpression(text = "Ich rufe später an.", meaning = "Sagen, dass du noch einmal anrufst.", note = "anrufen: ich rufe an"), TargetExpression(text = "Bis dann!", meaning = "Am Telefon verabschieden.", note = "auch: Tschüss!")), situation = "Nadia ruft zu Hause an. Papa ist nicht da — sie ruft später noch einmal an.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Meldest dich am Telefon. (Nadia)", expected = listOf("Hallo, hier ist Nadia.", "hallo hier ist nadia"), focus = "hier ist …", watch = "Am Telefon sagt man: hier ist + Name."), PracticeQuestion(prompt = "Fragst, ob Papa da ist.", expected = listOf("Ist Papa da ?", "ist papa da"), focus = "ist … da ?", watch = "Frage: Ist + Person + da ?"), PracticeQuestion(prompt = "Sagst, dass Mama nicht da ist.", expected = listOf("Mama ist nicht da.", "Sie ist nicht da.", "mama ist nicht da"), focus = "nicht da", watch = "Verneinung mit nicht."), PracticeQuestion(prompt = "Sagst, dass du später anrufst.", expected = listOf("Ich rufe später an.", "ich rufe spaeter an"), focus = "anrufen", watch = "später = spaeter; ich rufe … an."), PracticeQuestion(prompt = "Verabschiedest dich am Telefon.", expected = listOf("Bis dann!", "Tschüss!", "tschuess"), focus = "Verabschiedung", watch = "Tschüss: tschuess ohne Ü."))), exercises = listOf(Exercise(id = "de-foundations-u12-anruf-e1", kind = "choice", prompt = "Am Telefon: „Hallo, ___ Nadia.“", options = listOf("hier ist", "ist hier", "da ist", "ich bin"), answers = listOf("hier ist"), explain = "So meldet man sich: Hallo, hier ist + Name."), Exercise(id = "de-foundations-u12-anruf-e2", kind = "gap", prompt = "Ist deine Schwester ___ ? — Nein, sie ist nicht zu Hause.", options = listOf(), answers = listOf("da"), explain = "Ist … da ? fragt, ob jemand da ist."), Exercise(id = "de-foundations-u12-anruf-e3", kind = "order", prompt = "Sagst, dass du später anrufst.", options = listOf(), answers = listOf("Ich rufe später an"), explain = "anrufen: ich rufe später an."), Exercise(id = "de-foundations-u12-anruf-e4", kind = "written", prompt = "Fragst, wann dein Vater wieder da ist.", options = listOf(), answers = listOf("wann ist er wieder da", "wann ist mein vater wieder da"), explain = "Frage mit wann: Wann ist er wieder da ?")), skills = listOf("vocab:social-expressions", "grammar:present-questions", "function:ask-simple-questions", "grammar:present-simple"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:present-simple"))))
}

object DeFoundationsU13 {
    val unit = CourseUnit(id = "de-foundations-u13", title = "Die Zeit", subtitle = "Tage und Wetter", level = "A1", themes = listOf(ConversationTheme("die-woche", "Die Woche", "Immer, oft, manchmal", "sun.max", "Course", "Von morgens bis abends: Was machst du immer, was nur manchmal ?", 0),
                ConversationTheme("wetter-jahreszeiten", "Wetter und Jahreszeiten", "Es regnet", "cloud.rain", "Course", "Wie ist das Wetter heute ? Und was macht man gern bei Regen ?", 1)), lessons = listOf(    Lesson(id = "de-foundations-u13-routine", title = "Von morgens bis abends", goal = "Deine Woche mit immer, oft, manchmal und nie beschreiben.", intro = LessonIntro(explanation = listOf("Häufigkeit: immer (100 %), oft, manchmal, nie (0 %). Beispiel: „Ich trinke immer Kaffee.“", "Das Adverb steht nach dem Verb: „Ich gehe oft ins Kino.“ Beispiel: „Er ist nie müde.“", "Wann: „am Morgen“, „am Abend“, „am Wochenende“. Beispiel: „Am Wochenende koche ich.“"), examples = listOf(ExampleLine(text = "Ich trinke immer Kaffee am Morgen.", meaning = "immer: jeden Tag."), ExampleLine(text = "Sie geht oft ins Kino.", meaning = "oft: viele Male."), ExampleLine(text = "Wir spielen manchmal Karten.", meaning = "manchmal: nicht oft, nicht nie."), ExampleLine(text = "Er isst nie Fleisch.", meaning = "nie: 0 %."), ExampleLine(text = "Am Abend lese ich ein Buch.", meaning = "Wann: am Abend."))), expressions = listOf(TargetExpression(text = "immer", meaning = "Jedes Mal.", note = "Ich trinke immer Tee."), TargetExpression(text = "oft", meaning = "Viele Male.", note = "Sie geht oft schwimmen."), TargetExpression(text = "manchmal", meaning = "Nicht oft.", note = "Manchmal koche ich."), TargetExpression(text = "nie", meaning = "Kein Mal.", note = "Er ist nie müde."), TargetExpression(text = "am Morgen / am Abend", meaning = "Wann: Tageszeit.", note = "Am Morgen arbeite ich.")), situation = "Kim erzählt ihre Woche: immer Kaffee am Morgen, oft Kino, manchmal Karten — nie Fleisch.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sagt, was du jeden Morgen trinkst. (Kaffee)", expected = listOf("Ich trinke immer Kaffee.", "ich trinke immer kaffee"), focus = "immer", watch = "immer = jeden Tag; nach dem Verb: trinke immer."), PracticeQuestion(prompt = "Sagt, wie oft du ins Kino gehst. (oft)", expected = listOf("Ich gehe oft ins Kino.", "ich gehe oft ins kino"), focus = "oft", watch = "Verb zuerst: gehe oft."), PracticeQuestion(prompt = "Sagt, dass du nie Fleisch isst.", expected = listOf("Ich esse nie Fleisch.", "ich esse nie fleisch"), focus = "nie", watch = "nie = 0 %."), PracticeQuestion(prompt = "Sagt, was du manchmal machst. (Karten spielen)", expected = listOf("Ich spiele manchmal Karten.", "ich spiele manchmal karten"), focus = "manchmal", watch = "manchmal: nach dem Verb."), PracticeQuestion(prompt = "Sagt, was du am Abend machst. (lesen)", expected = listOf("Am Abend lese ich.", "Ich lese am Abend.", "am abend lese ich"), focus = "am Abend", watch = "am + Tageszeit."))), exercises = listOf(Exercise(id = "de-foundations-u13-routine-e1", kind = "choice", prompt = "Ich gehe ___ ins Kino — zweimal in der Woche.", options = listOf("oft", "nie", "immer", "morgen"), answers = listOf("oft"), explain = "oft = viele Male: zweimal in der Woche."), Exercise(id = "de-foundations-u13-routine-e2", kind = "gap", prompt = "Er isst ___ Fleisch. Er ist Vegetarier.", options = listOf(), answers = listOf("nie"), explain = "Vegetarier essen nie Fleisch: 0 %."), Exercise(id = "de-foundations-u13-routine-e3", kind = "order", prompt = "Sagt, was du jeden Tag trinkst. (Kaffee)", options = listOf(), answers = listOf("Ich trinke immer Kaffee"), explain = "immer + Verb: die tägliche Routine."), Exercise(id = "de-foundations-u13-routine-e4", kind = "written", prompt = "Schreib über deinen Morgen. (am Morgen, immer, Tee)", options = listOf(), answers = listOf("am morgen trinke ich immer tee", "ich trinke am morgen immer tee"), explain = "am Morgen + immer: die Routine.")), skills = listOf("grammar:frequency-adverbs", "function:talk-about-routines", "vocab:daily-routine", "grammar:present-simple"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u13-wetter", title = "Wie ist das Wetter ?", goal = "Wetter und Jahreszeiten beschreiben: Es regnet. Im Sommer ist es warm.", intro = LessonIntro(explanation = listOf("Wetter: „Es ist sonnig / warm / kalt.“ „Es regnet.“ „Es schneit.“ Beispiel: „Heute regnet es.“", "Jahreszeiten: der Frühling, der Sommer, der Herbst, der Winter. Beispiel: „Im Sommer ist es heiß.“", "Frage: „Wie ist das Wetter ?“ — „Es ist sonnig und warm.“"), examples = listOf(ExampleLine(text = "Wie ist das Wetter heute ?", meaning = "Die Wetterfrage."), ExampleLine(text = "Es ist sonnig und warm.", meaning = "es ist + Adjektiv."), ExampleLine(text = "Es regnet in Berlin.", meaning = "Es regnet: Wasser vom Himmel."), ExampleLine(text = "Im Winter schneit es oft.", meaning = "Jahreszeit + im."), ExampleLine(text = "Im Frühling sind die Tage warm.", meaning = "der Frühling: die Jahreszeit nach dem Winter."))), expressions = listOf(TargetExpression(text = "Wie ist das Wetter ?", meaning = "Nach dem Wetter fragen.", note = "Antwort: Es ist …"), TargetExpression(text = "Es regnet. / Es schneit.", meaning = "Wasser oder Schnee vom Himmel.", note = "Heute regnet es."), TargetExpression(text = "sonnig / warm / kalt", meaning = "Wetter-Adjektive.", note = "Es ist kalt im Januar."), TargetExpression(text = "der Frühling / der Sommer / der Herbst / der Winter", meaning = "Die vier Jahreszeiten.", note = "im Sommer, im Winter"), TargetExpression(text = "Im Sommer ist es heiß.", meaning = "Jahreszeit + Adjektiv.", note = "der Sommer: im Sommer")), situation = "Sam fragt: Wie ist das Wetter ? Kim sagt: Es regnet. Im Sommer ist es oft heiß.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Fragst nach dem Wetter.", expected = listOf("Wie ist das Wetter ?", "wie ist das wetter", "wie ist das wetter heute"), focus = "wie ist das Wetter ?", watch = "Feste Frage: Wie ist das Wetter ?"), PracticeQuestion(prompt = "Sagt, was heute vom Himmel fällt. (regnen)", expected = listOf("Es regnet.", "es regnet", "es regnet heute"), focus = "es regnet", watch = "es regnet: ohne Person."), PracticeQuestion(prompt = "Sagt, wie das Wetter ist. (sonnig, warm)", expected = listOf("Es ist sonnig und warm.", "es ist sonnig und warm"), focus = "es ist + Adjektiv", watch = "sonnig kommt von die Sonne."), PracticeQuestion(prompt = "Sagt, wie es im Winter ist. (kalt)", expected = listOf("Im Winter ist es kalt.", "im winter ist es kalt"), focus = "im Winter", watch = "der Winter: im Winter."), PracticeQuestion(prompt = "Sagt, was es im Frühling oft macht. (regnen)", expected = listOf("Im Frühling regnet es oft.", "im fruehling regnet es oft"), focus = "im Frühling", watch = "ü = ue: Fruehling."))), exercises = listOf(Exercise(id = "de-foundations-u13-wetter-e1", kind = "choice", prompt = "___ schneit es oft.", options = listOf("Im Winter", "Im Sommer", "Am Montag", "Um acht"), answers = listOf("Im Winter"), explain = "Schnee gibt es im Winter."), Exercise(id = "de-foundations-u13-wetter-e2", kind = "gap", prompt = "Die Sonne scheint. Es ist sehr ___.", options = listOf(), answers = listOf("warm", "heiß", "heiss"), explain = "Bei Sonne ist es warm oder heiß."), Exercise(id = "de-foundations-u13-wetter-e3", kind = "order", prompt = "Fragst nach dem Wetter heute.", options = listOf(), answers = listOf("Wie ist das Wetter heute"), explain = "Die Wetterfrage mit wie."), Exercise(id = "de-foundations-u13-wetter-e4", kind = "written", prompt = "Sagt, wie das Wetter bei euch im Sommer ist. (heiß)", options = listOf(), answers = listOf("im sommer ist es heiß", "im sommer ist es heiss", "es ist heiss im sommer"), explain = "im Sommer + es ist + Adjektiv.")), skills = listOf("function:talk-about-weather", "vocab:weather", "grammar:present-simple", "function:ask-simple-questions"), canDo = listOf("talk-about-weather"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u13-lust", title = "Was ich gern mache", goal = "Sagen, was du magst und was du gern machst.", intro = LessonIntro(explanation = listOf("mag + Nomen: „Ich mag Musik.“ „Sie mag Kino.“ So sagt man, was du gut findest.", "gern + Verb: „Ich lese gern.“ „Er kocht gern.“ gern steht nach dem Verb.", "nicht gern: „Ich warte nicht gern.“ Beispiel: „Ich spiele nicht gern Computer.“"), examples = listOf(ExampleLine(text = "Ich mag Musik.", meaning = "mag + Nomen."), ExampleLine(text = "Ich spiele gern Fußball.", meaning = "gern nach dem Verb."), ExampleLine(text = "Sie kocht gern für Freunde.", meaning = "gern: mit Freude."), ExampleLine(text = "Ich warte nicht gern.", meaning = "Verneinung: nicht gern."), ExampleLine(text = "Was machst du gern ?", meaning = "Frage nach Hobbys."))), expressions = listOf(TargetExpression(text = "Ich mag …", meaning = "Sagen, was du gut findest.", note = "Ich mag Kaffee."), TargetExpression(text = "gern + Verb", meaning = "Sagen, was du mit Freude machst.", note = "Ich lese gern."), TargetExpression(text = "nicht gern", meaning = "Sagen, was du nicht magst.", note = "Ich warte nicht gern."), TargetExpression(text = "Was machst du gern ?", meaning = "Nach Hobbys fragen.", note = "Antwort: Ich … gern."), TargetExpression(text = "Hobbys: Sport, Musik, Lesen", meaning = "Themen für „gern“.", note = "Ich höre gern Musik.")), situation = "Kim und Sam fragen: Was macht ihr gern ? Kim liest gern, Sam spielt gern Fußball. Bei Regen kochen beide gern.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sagt, was du magst. (Musik)", expected = listOf("Ich mag Musik.", "ich mag musik"), focus = "ich mag …", watch = "mag + Nomen: Musik, Kino, Kaffee."), PracticeQuestion(prompt = "Sagt, was du gern machst. (Fußball spielen)", expected = listOf("Ich spiele gern Fußball.", "ich spiele gern fussball"), focus = "gern + Verb", watch = "ü = ue: Fussball; gern nach dem Verb."), PracticeQuestion(prompt = "Fragst Kim nach ihren Hobbys.", expected = listOf("Was machst du gern ?", "was machst du gern"), focus = "Was machst du gern ?", watch = "Frage: was + machst + du + gern."), PracticeQuestion(prompt = "Sagt, was du nicht gern machst. (warten)", expected = listOf("Ich warte nicht gern.", "Ich warte nicht so gern."), focus = "nicht gern", watch = "Verneinung: nicht vor gern."), PracticeQuestion(prompt = "Sagt, was ihr bei Regen macht. (kochen)", expected = listOf("Wir kochen gern.", "Wir kochen gern bei Regen.", "wir kochen gern"), focus = "wir + gern", watch = "Bei Regen: drinnen kochen."))), exercises = listOf(Exercise(id = "de-foundations-u13-lust-e1", kind = "choice", prompt = "Ich ___ Musik — ich höre jeden Tag CDs.", options = listOf("mag", "magst", "mögen", "spielt"), answers = listOf("mag"), explain = "mag + Nomen: ich mag."), Exercise(id = "de-foundations-u13-lust-e2", kind = "gap", prompt = "Ich lese ___. Es ist mein Hobby.", options = listOf(), answers = listOf("gern"), explain = "gern nach dem Verb: Ich lese gern."), Exercise(id = "de-foundations-u13-lust-e3", kind = "order", prompt = "Fragst Sam nach seinen Hobbys.", options = listOf(), answers = listOf("Was machst du gern"), explain = "Die Hobbyfrage: Was machst du gern ?"), Exercise(id = "de-foundations-u13-lust-e4", kind = "written", prompt = "Sagt, was du gern machst. (Musik hören)", options = listOf(), answers = listOf("ich höre gern musik", "ich hoere gern musik", "ich mag musik"), explain = "gern + Verb: Ich höre gern Musik.")), skills = listOf("vocab:hobbies", "grammar:present-simple", "function:talk-about-routines", "vocab:social-expressions"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple"))))
}

object DeFoundationsU14 {
    val unit = CourseUnit(id = "de-foundations-u14", title = "Unterwegs", subtitle = "U-Bahn, Bus und Bahn", level = "A1", themes = listOf(ConversationTheme("unterwegs-stadt", "Mit Bus und Bahn", "Wie ich hinkomme", "bus", "Course", "Sam ist neu in der Stadt: U-Bahn, Bus oder zu Fuß — wie kommst du zur Arbeit ?", 0),
                ConversationTheme("fahrkarten", "Fahrkarten", "Eine Fahrkarte, bitte", "tram", "Course", "Am Schalter: eine Fahrkarte nach Bonn, hin und zurück — und der Zug fährt von Gleis 3.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u14-verkehr", title = "Wie ich hinkomme", goal = "Sagen, wie du zur Arbeit, zur Schule oder in die Stadt kommst.", intro = LessonIntro(explanation = listOf("nehmen + Verkehrsmittel: „Ich nehme die U-Bahn.“ „Ich nehme den Bus.“ Beispiel: „Ich nehme das Fahrrad.“", "zu Fuß gehen = laufen, ohne Bus und Auto: „Ich gehe zu Fuß.“ Beispiel: „Ich gehe zu Fuß ins Büro.“", "Frage: „Wie kommst du zur Arbeit ?“ — „Mit dem Bus.“ Beispiel: „Ich fahre mit dem Bus.“"), examples = listOf(ExampleLine(text = "Ich nehme die U-Bahn.", meaning = "nehmen + die U-Bahn."), ExampleLine(text = "Ich nehme den Bus zur Arbeit.", meaning = "der Bus → den Bus."), ExampleLine(text = "Ich gehe zu Fuß.", meaning = "Laufen, ohne Bus und Auto."), ExampleLine(text = "Wie kommst du zur Schule ?", meaning = "Nach dem Weg fragen."), ExampleLine(text = "Sie fährt mit dem Fahrrad.", meaning = "fahren mit + dem."))), expressions = listOf(TargetExpression(text = "die U-Bahn / der Bus", meaning = "Verkehr in der Stadt.", note = "Ich nehme die U-Bahn."), TargetExpression(text = "zu Fuß", meaning = "Ohne Bus, ohne Auto.", note = "Ich gehe zu Fuß."), TargetExpression(text = "das Fahrrad / das Auto", meaning = "Weitere Verkehrsmittel.", note = "Ich fahre mit dem Fahrrad."), TargetExpression(text = "Ich nehme …", meaning = "Sagen, welches Verkehrsmittel du nimmst.", note = "Ich nehme den Bus."), TargetExpression(text = "Wie kommst du … ?", meaning = "Nach dem Weg fragen.", note = "Wie kommst du zur Schule ?")), situation = "Sam ist neu in der Stadt: Er fragt Kim, wie sie zur Arbeit kommt — mit der U-Bahn, mit dem Bus oder zu Fuß.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sagst, wie du zur Arbeit fährst. (die U-Bahn)", expected = listOf("Ich nehme die U-Bahn.", "ich nehme die u-bahn"), focus = "nehmen + die", watch = "die U-Bahn: die bleibt die."), PracticeQuestion(prompt = "Sagst, wie du fährst. (der Bus)", expected = listOf("Ich nehme den Bus.", "ich nehme den bus"), focus = "der → den", watch = "der Bus: ich nehme den Bus."), PracticeQuestion(prompt = "Du hast kein Auto. Sagst, dass du läufst.", expected = listOf("Ich gehe zu Fuß.", "ich gehe zu fuss"), focus = "zu Fuß gehen", watch = "ß = ss: zu Fuss."), PracticeQuestion(prompt = "Fragst Sam, wie er zur Schule kommt.", expected = listOf("Wie kommst du zur Schule ?", "wie kommst du zur schule"), focus = "Wie kommst du … ?", watch = "Frage mit wie + kommen."), PracticeQuestion(prompt = "Sagst, wie Mia fährt. (das Fahrrad)", expected = listOf("Sie fährt mit dem Fahrrad.", "sie faehrt mit dem fahrrad"), focus = "fahren mit + dem", watch = "fahren: sie fährt; ä = ae."))), exercises = listOf(Exercise(id = "de-foundations-u14-verkehr-e1", kind = "choice", prompt = "Ich ___ den Bus.", options = listOf("nehme", "nimmst", "nimm", "nehmen"), answers = listOf("nehme"), explain = "ich + nehmen = ich nehme den Bus."), Exercise(id = "de-foundations-u14-verkehr-e2", kind = "gap", prompt = "Du hast kein Auto. Du gehst ___.", options = listOf(), answers = listOf("zu fuss", "zu Fuß"), explain = "zu Fuß gehen: laufen, ohne Bus und Auto."), Exercise(id = "de-foundations-u14-verkehr-e3", kind = "order", prompt = "Sagst, wie du zur Arbeit fährst. (die U-Bahn)", options = listOf(), answers = listOf("Ich nehme die U-Bahn"), explain = "nehmen + die U-Bahn: so sagst du, wie du fährst."), Exercise(id = "de-foundations-u14-verkehr-e4", kind = "written", prompt = "Fragst, wie Lena zur Arbeit kommt.", options = listOf(), answers = listOf("wie kommt lena zur arbeit", "Wie kommt Lena zur Arbeit ?"), explain = "Frage mit wie: Wie kommt sie zur Arbeit ?")), skills = listOf("vocab:transport", "grammar:present-simple", "function:ask-simple-questions", "vocab:town"), canDo = listOf("use-transport"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u14-fahrplan", title = "Wann fährt er ab ?", goal = "Uhrzeiten sagen und im Fahrplan lesen: wann fährt der Bus oder Zug ?", intro = LessonIntro(explanation = listOf("Uhrzeit: „Es ist neun Uhr.“ „Es ist halb neun.“ Beispiel: „Es ist Viertel nach acht.“", "fahren ab = starten, ankommen = am Ziel sein: „Der Zug fährt um 9 Uhr ab.“ Beispiel: „Der Bus kommt um halb zehn an.“", "Frage mit wann: „Wann fährt der Bus ab ?“ — „Um 8:15 Uhr.“ Beispiel: „Wann kommt der Zug an ?“"), examples = listOf(ExampleLine(text = "Es ist Viertel nach acht.", meaning = "8:15 Uhr."), ExampleLine(text = "Der Zug fährt um 9 Uhr ab.", meaning = "fahren ab + um + Zeit."), ExampleLine(text = "Wann fährt der Bus ab ?", meaning = "Frage nach der Zeit."), ExampleLine(text = "Der Bus kommt um halb zehn an.", meaning = "halb zehn = 9:30 Uhr."), ExampleLine(text = "Die letzte Bahn fährt um 23 Uhr.", meaning = "der letzte Bus / die letzte Bahn."))), expressions = listOf(TargetExpression(text = "um wie viel Uhr ?", meaning = "Nach der genauen Zeit fragen.", note = "Um wie viel Uhr fährt der Zug ?"), TargetExpression(text = "fahren ab", meaning = "Der Bus oder Zug startet.", note = "Der Zug fährt um 9 Uhr ab."), TargetExpression(text = "ankommen", meaning = "Du bist am Ziel.", note = "Der Bus kommt um 9 Uhr an."), TargetExpression(text = "halb zehn", meaning = "9:30 Uhr.", note = "Es ist halb zehn."), TargetExpression(text = "der Fahrplan", meaning = "Hier stehen alle Zeiten.", note = "Ich sehe im Fahrplan nach.")), situation = "Kim und Sam stehen am Bahnsteig: Die nächste Bahn fährt erst um Viertel nach zehn — der Fahrplan hilft.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sagst die Uhrzeit. (8:15)", expected = listOf("Es ist Viertel nach acht.", "es ist viertel nach acht", "es ist acht uhr funfzehn"), focus = "Viertel nach", watch = "8:15: Viertel nach acht."), PracticeQuestion(prompt = "Fragst, wann der Zug startet.", expected = listOf("Wann fährt der Zug ab ?", "wann faehrt der zug ab"), focus = "wann … ab ?", watch = "fahren: er fährt; ä = ae."), PracticeQuestion(prompt = "Sagst, wann der Bus am Ziel ist. (halb neun)", expected = listOf("Der Bus kommt um halb neun an.", "der bus kommt um halb neun an"), focus = "ankommen", watch = "halb neun = 8:30 Uhr."), PracticeQuestion(prompt = "Sagst, wann dein Zug startet. (um 9 Uhr)", expected = listOf("Mein Zug fährt um 9 Uhr ab.", "mein zug faehrt um neun uhr ab"), focus = "fahren ab", watch = "fährt = faehrt."), PracticeQuestion(prompt = "Fragst nach der genauen Zeit des Buses.", expected = listOf("Um wie viel Uhr fährt der Bus ?", "um wie viel uhr faehrt der bus"), focus = "um wie viel Uhr ?", watch = "Frage mit um wie viel Uhr."))), exercises = listOf(Exercise(id = "de-foundations-u14-fahrplan-e1", kind = "choice", prompt = "Der Zug fährt um 9 Uhr ___.", options = listOf("ab", "an", "auf", "aus"), answers = listOf("ab"), explain = "fahren ab = starten: Der Zug fährt um 9 Uhr ab."), Exercise(id = "de-foundations-u14-fahrplan-e2", kind = "gap", prompt = "Es ist 9:30 Uhr — es ist ___ neun.", options = listOf(), answers = listOf("halb"), explain = "halb neun = 8:30 Uhr: in Deutschland zählt halb rückwärts."), Exercise(id = "de-foundations-u14-fahrplan-e3", kind = "order", prompt = "Fragst nach der Abfahrt des Buses.", options = listOf(), answers = listOf("Wann fährt der Bus ab"), explain = "Frage nach der Zeit: wann + fährt + ab."), Exercise(id = "de-foundations-u14-fahrplan-e4", kind = "written", prompt = "Sagst die Uhrzeit. (9:15 Uhr)", options = listOf(), answers = listOf("es ist viertel nach neun", "Es ist Viertel nach neun.", "es ist neun uhr funfzehn"), explain = "9:15: Viertel nach neun oder neun Uhr fünfzehn.")), skills = listOf("function:tell-time", "vocab:transport", "grammar:present-questions", "grammar:present-simple"), canDo = listOf("tell-time"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u14-ticket", title = "Eine Fahrkarte, bitte", goal = "Am Schalter oder am Automaten Fahrkarten kaufen: möchte, Preis, hin und zurück.", intro = LessonIntro(explanation = listOf("möchte + Bestellung: „Ich möchte eine Fahrkarte nach Bonn.“ Beispiel: „Wir möchten zwei Fahrkarten.“", "eine Fahrkarte — zwei Fahrkarten: Beispiel: „Zwei Fahrkarten nach Köln, bitte.“", "Preis und Fahrt: „Das kostet 4 Euro 50.“ Beispiel: „Hin und zurück, bitte.“"), examples = listOf(ExampleLine(text = "Eine Fahrkarte nach Bonn, bitte.", meaning = "Höflich bestellen."), ExampleLine(text = "Ich möchte zwei Fahrkarten.", meaning = "Mehrzahl: zwei Fahrkarten."), ExampleLine(text = "Einzeln oder hin und zurück ?", meaning = "Frage am Schalter."), ExampleLine(text = "Das kostet 4 Euro 50.", meaning = "Der Preis."), ExampleLine(text = "Der Zug fährt von Gleis 3.", meaning = "das Gleis: Wo der Zug startet."))), expressions = listOf(TargetExpression(text = "Eine Fahrkarte, bitte.", meaning = "Höflich kaufen.", note = "Eine Fahrkarte nach Bonn, bitte."), TargetExpression(text = "einzel / hin und zurück", meaning = "Ein Weg — oder beide Wege.", note = "Hin und zurück, bitte."), TargetExpression(text = "Ich möchte …", meaning = "Sagen, was du kaufst.", note = "Ich möchte eine Fahrkarte."), TargetExpression(text = "Das kostet …", meaning = "Den Preis sagen.", note = "Das kostet 3 Euro 50."), TargetExpression(text = "das Gleis", meaning = "Wo der Zug abfährt.", note = "Der Zug fährt von Gleis 3.")), situation = "Sam kauft am Schalter eine Fahrkarte nach Bonn — einzeln oder hin und zurück ? Und von welchem Gleis ?", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Bestellst eine Fahrkarte nach Bonn.", expected = listOf("Eine Fahrkarte nach Bonn, bitte.", "ich möchte eine fahrkarte nach bonn", "ich moechte eine fahrkarte nach bonn"), focus = "möchte", watch = "ö = oe: moechte."), PracticeQuestion(prompt = "Sagst, was du möchtest. (zwei Fahrkarten)", expected = listOf("Ich möchte zwei Fahrkarten.", "ich moechte zwei fahrkarten"), focus = "möchte + Mehrzahl", watch = "eine Fahrkarte — zwei Fahrkarten."), PracticeQuestion(prompt = "Sagst, dass du beide Wege fährst.", expected = listOf("Hin und zurück, bitte.", "hin und zurück bitte"), focus = "hin und zurück", watch = "Beide Wege: hin und zurück."), PracticeQuestion(prompt = "Sagst den Preis. (7 Euro 80)", expected = listOf("Das kostet 7 Euro 80.", "das kostet 7 euro 80"), focus = "Das kostet …", watch = "Preis: 7 Euro 80."), PracticeQuestion(prompt = "Fragst, wo der Zug startet.", expected = listOf("Von welchem Gleis fährt der Zug ?", "von welchem gleis faehrt der zug"), focus = "das Gleis", watch = "das Gleis: Wo der Zug abfährt."))), exercises = listOf(Exercise(id = "de-foundations-u14-ticket-e1", kind = "choice", prompt = "Ich möchte eine Fahrkarte ___ Bonn.", options = listOf("nach", "zu", "in", "auf"), answers = listOf("nach"), explain = "nach + Stadtname: nach Bonn, nach Berlin."), Exercise(id = "de-foundations-u14-ticket-e2", kind = "gap", prompt = "Hin ___ zurück, bitte.", options = listOf(), answers = listOf("und"), explain = "hin und zurück = beide Wege: hin fahren und zurück fahren."), Exercise(id = "de-foundations-u14-ticket-e3", kind = "order", prompt = "Bestellst zwei Fahrkarten.", options = listOf(), answers = listOf("Ich möchte zwei Fahrkarten"), explain = "möchte + zwei Fahrkarten: so bestellst du höflich."), Exercise(id = "de-foundations-u14-ticket-e4", kind = "written", prompt = "Der Schalter fragt: ein Weg oder zwei Wege ?", options = listOf(), answers = listOf("Einzeln oder hin und zurück ?", "einzeln oder hin und zurueck"), explain = "Am Schalter fragt man: Einzeln oder hin und zurück ?")), skills = listOf("function:go-shopping", "function:make-requests", "vocab:transport", "grammar:quantities"), canDo = listOf("use-transport"), prerequisites = listOf("grammar:present-simple"))))
