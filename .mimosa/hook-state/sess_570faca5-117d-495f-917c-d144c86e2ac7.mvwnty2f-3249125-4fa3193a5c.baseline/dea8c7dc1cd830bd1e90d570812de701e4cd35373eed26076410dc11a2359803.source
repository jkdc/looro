theke?"), focus = "gibt es", watch = "Gibt es + Akkusativ?"), PracticeQuestion(prompt = "Beschreibe deinen Lieblingsort.", expected = listOf("<Ort> ist gegenüber vom <Ort>."), focus = "gegenüber von", watch = "gegenüber vom + Dativ."), PracticeQuestion(prompt = "Sag, dass alles in der Nähe ist.", expected = listOf("Alles ist in der Nähe."), focus = "in der Nähe", watch = "in der Nähe von + Ort."))), exercises = listOf(Exercise(id = "de-foundations-u2-viertel-e1", kind = "choice", prompt = "___ einen Markt und zwei Cafés.", options = listOf("Es gibt", "Sie sind", "Das ist", "Es hat"), answers = listOf("Es gibt"), explain = "es gibt + Akkusativ."), Exercise(id = "de-foundations-u2-viertel-e2", kind = "gap", prompt = "Es gibt ___ Bahnhof hier. (negación, masculino)", options = listOf(), answers = listOf("keinen"), explain = "Verneinung: keinen (Akkusativ)."), Exercise(id = "de-foundations-u2-viertel-e3", kind = "order", prompt = "Frag nach einer Apotheke.", options = listOf(), answers = listOf("Gibt es hier eine Apotheke"), explain = "Gibt es + Akkusativ?"), Exercise(id = "de-foundations-u2-viertel-e4", kind = "written", prompt = "Sag, was es bei dir gibt.", options = listOf(), answers = listOf("es gibt <ort> in der nahe", "es gibt einen park"), explain = "es gibt + Ort.")), skills = listOf("vocab:town", "grammar:there-is-are", "grammar:prepositions-place", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:there-is-are")),
    Lesson(id = "de-foundations-u2-plaene", title = "Pläne für Samstag", goal = "Pläne machen mit wir wollen und einen Treffpunkt vereinbaren.", intro = LessonIntro(explanation = listOf("Pläne mit wollen: „Wollen wir zum Markt gehen?“ oder „Wir gehen samstags zum Markt“ — Präsens mit Zeitangabe.", "Vorschlagen: „Gehen wir zum Markt?“, „Willst du mitkommen?“. Treffpunkt: „Treffen wir uns um sechs am Park?“", "Bestätigen mit Ort und Zeit: „Perfekt, um sechs, vor dem Park.“ Ein Plan ohne Ort bleibt ein Wunsch."), examples = listOf(ExampleLine(text = "Samstag gehen wir zum Markt.", meaning = "Präsens + Zeit = Zukunft."), ExampleLine(text = "Willst du mitkommen?", meaning = "Die Einladung."), ExampleLine(text = "Treffen wir uns um sechs am Park?", meaning = "Der Treffpunkt."), ExampleLine(text = "Perfekt, bis dann!", meaning = "Die Bestätigung."), ExampleLine(text = "Wenn es regnet, verschieben wir auf Sonntag.", meaning = "Plan B."))), expressions = listOf(TargetExpression(text = "wir gehen + Zeitangabe", meaning = "Zukunft im Präsens.", note = "morgen / samstags + Präsens."), TargetExpression(text = "Willst du mitkommen?", meaning = "Einladen.", note = "mitkommen = venir."), TargetExpression(text = "Wir treffen uns um … am …", meaning = "Treffpunkt.", note = "sich treffen = vernos."), TargetExpression(text = "Perfekt / Bis dann!", meaning = "Bestätigen.", note = "bis dann = hasta luego."), TargetExpression(text = "Wenn es regnet, …", meaning = "Plan B.", note = "wenn + Presente + plan.")), situation = "Du planst den Samstag mit einem Freund: Markt, Treffen um sechs am Park, und Plan B bei Regen.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Schlage den Markt mit wir vor.", expected = listOf("Samstag gehen wir zum Markt."), focus = "Präsens + Zeit", watch = "Präsens + Zeitangabe = Zukunft."), PracticeQuestion(prompt = "Lade deinen Freund ein.", expected = listOf("Willst du mitkommen?"), focus = "mitkommen", watch = "mitkommen = venir junto."), PracticeQuestion(prompt = "Vereinbare den Treffpunkt. (6 Uhr, Park)", expected = listOf("Treffen wir uns um sechs am Park?"), focus = "sich treffen", watch = "Wir treffen uns + Zeit + Ort."), PracticeQuestion(prompt = "Gib den Plan B bei Regen.", expected = listOf("Wenn es regnet, verschieben wir auf Sonntag."), focus = "wenn + Plan", watch = "wenn + Presente + plan."), PracticeQuestion(prompt = "Lade deinen Freund ein.", expected = listOf("Willst du mitkommen?"), focus = "mitkommen", watch = "mitkommen = venir junto."))), exercises = listOf(Exercise(id = "de-foundations-u2-plaene-e1", kind = "choice", prompt = "Samstag ___ wir zum Markt.", options = listOf("gehen", "gehen wir", "gehen zu", "gehen im"), answers = listOf("gehen"), explain = "Präsens + Zeitangabe = Zukunft."), Exercise(id = "de-foundations-u2-plaene-e2", kind = "gap", prompt = "Treffen ___ uns um sechs? (reflexiv)", options = listOf(), answers = listOf("wir"), explain = "Wir treffen uns = nos vemos."), Exercise(id = "de-foundations-u2-plaene-e3", kind = "order", prompt = "Vereinbare den Treffpunkt.", options = listOf(), answers = listOf("Treffen wir uns um sechs am Park"), explain = "Treffen wir uns + Zeit + Ort?"), Exercise(id = "de-foundations-u2-plaene-e4", kind = "written", prompt = "Plan B bei Regen.", options = listOf(), answers = listOf("wenn es regnet verschieben wir auf sonntag", "wenn es regnet gehen wir ins kino"), explain = "wenn + Presente + plan.")), skills = listOf("grammar:going-to", "function:make-future-plans", "vocab:social-expressions", "grammar:present-questions"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to"))))
}

object DeFoundationsU5 {
    val unit = CourseUnit(id = "de-foundations-u5", title = "Einkaufen", subtitle = "Lokal einkaufen", level = "A1", themes = listOf(ConversationTheme("markttag", "Markttag", "Obst und Gemüse", "cart", "Course", "Ihr kauft auf dem Wochenmarkt: Obst, Gemüse und Kontakt mit dem Verkäufer.", 0),
                ConversationTheme("laden-um-ecke", "Der Laden um die Ecke", "Was fehlt", "storefront", "Course", "Etwas fehlt zum Abendessen: ihr rennt zum Laden um die Ecke.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u5-markt", title = "Auf dem Markt", goal = "Obst und Gemüse kaufen: Mengen, Preise und höfliche Formeln.", intro = LessonIntro(explanation = listOf("Auf dem Markt: „Was kosten die Tomaten?“ „Sind die reif?“", "Mengen: „Ein Pfund Zwiebeln.“ „Zwei Kilo Äpfel.“ „Zweihundert Gramm Schinken.“", "Höflich einkaufen: „Ich hätte gern ein Kilo Äpfel.“ — hätte = höfliche Form von haben."), examples = listOf(ExampleLine(text = "Was kosten die Tomaten ?", meaning = "Der Preis."), ExampleLine(text = "Ich hätte gern ein Kilo Äpfel.", meaning = "Höflich einkaufen."), ExampleLine(text = "Sind die reif ?", meaning = "Nach der Qualität fragen."), ExampleLine(text = "Zweihundert Gramm Schinken.", meaning = "Gewicht."), ExampleLine(text = "Sonst noch etwas ?", meaning = "Der Verkäufer fragt."))), expressions = listOf(TargetExpression(text = "Was kosten …?", meaning = "Preis fragen.", note = "…die Tomaten ?"), TargetExpression(text = "Ich hätte gern …", meaning = "Höflich kaufen.", note = "hätte = Konjunktiv von haben."), TargetExpression(text = "ein Pfund / ein Kilo von …", meaning = "Gewicht.", note = "ein Pfund = 500 g."), TargetExpression(text = "Sind die reif ?", meaning = "Qualität.", note = "reif = maduro."), TargetExpression(text = "Sonst noch etwas ?", meaning = "Der Verkäufer fragt.", note = "Nein, das ist alles.")), situation = "Ihr kauft auf dem Wochenmarkt: ein Kilo Äpfel, ein Pfund Zwiebeln und fragt nach der Qualität.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Fragt den Preis der Tomaten.", expected = listOf("Was kosten die Tomaten ?"), focus = "was kosten", watch = "Was kosten + Plural."), PracticeQuestion(prompt = "Kauft ein Kilo Äpfel (höflich).", expected = listOf("Ich hätte gern ein Kilo Äpfel."), focus = "hätte gern", watch = "hätte gern + Akkusativ."), PracticeQuestion(prompt = "Fragt nach der Qualität. (reif)", expected = listOf("Sind die Äpfel reif ?"), focus = "reif", watch = "reif = maduro."), PracticeQuestion(prompt = "Sagt was ihr kauft: 200 g Schinken.", expected = listOf("Ich nehme zweihundert Gramm Schinken."), focus = "ich nehme", watch = "nehmen = tomar/elegir."), PracticeQuestion(prompt = "Responde al vendedor: nada más, gracias.", expected = listOf("Nichts sonst danke.", "Sonst nichts danke.", "Das war's danke."), focus = "sonst noch etwas", watch = "Sonst nichts, danke = nada más."))), exercises = listOf(Exercise(id = "de-foundations-u5-markt-e1", kind = "choice", prompt = "___ ___ die Tomaten ?", options = listOf("Was kosten", "Was sind", "Wie viel ist", "Was ist"), answers = listOf("Was kosten"), explain = "Was kosten + Plural."), Exercise(id = "de-foundations-u5-markt-e2", kind = "gap", prompt = "Ich ___ gern ein Kilo Äpfel. (höflich)", options = listOf(), answers = listOf("hätte"), explain = "hätte gern + Akkusativ."), Exercise(id = "de-foundations-u5-markt-e3", kind = "order", prompt = "Kauft ein Kilo Äpfel.", options = listOf(), answers = listOf("Ich hätte gern ein Kilo Apfel"), explain = "hätte gern + Menge."), Exercise(id = "de-foundations-u5-markt-e4", kind = "written", prompt = "Fragt nach der Qualität.", options = listOf(), answers = listOf("sind die apfel reif", "sind die äpfel reif"), explain = "Sind die … reif ?")), skills = listOf("vocab:food", "grammar:quantities", "vocab:shopping", "function:go-shopping"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u5-laden", title = "Der Laden um die Ecke", goal = "Kaufen was fehlt: suchen, fragen und bezahlen.", intro = LessonIntro(explanation = listOf("Im Laden: „Haben Sie…?“ „Ich suche…“. Der Verkäufer: „Ja, hier bitte“ oder „Tut mir leid, ist ausverkauft“.", "Ausverkauft = es gibt nicht mehr. „Der Laden ist ausverkauft“ (alle Tickets) vs „Das Produkt ist ausverkauft“.", "Bezahlen: „Was macht das ?“ „Das macht fünf Euro.“ „Bar oder mit Karte ?“"), examples = listOf(ExampleLine(text = "Haben Sie Vollkornbrot ?", meaning = "Fragen ob vorhanden."), ExampleLine(text = "Ich suche frische Hefe.", meaning = "Suchen."), ExampleLine(text = "Tut mir leid, ist ausverkauft.", meaning = "Nicht mehr da."), ExampleLine(text = "Was macht das ?", meaning = "Total fragen."), ExampleLine(text = "Das macht fünf Euro.", meaning = "Der Preis."))), expressions = listOf(TargetExpression(text = "Haben Sie … ?", meaning = "Fragen.", note = "…Vollkornbrot ?"), TargetExpression(text = "Ich suche …", meaning = "Suchen.", note = "…frische Hefe."), TargetExpression(text = "ausverkauft", meaning = "Nicht mehr verfügbar.", note = "aus + verkauft."), TargetExpression(text = "Was macht das ?", meaning = "Total.", note = "Das macht + Preis."), TargetExpression(text = "Bar oder mit Karte ?", meaning = "Zahlungsart.", note = "bar = efectivo.")), situation = "Ihr rennt zum Laden bevor er schließt: ihr sucht drei Sachen, zwei hat er und eine ist ausverkauft.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Fragen nach Vollkornbrot.", expected = listOf("Haben Sie Vollkornbrot ?"), focus = "haben Sie", watch = "Haben Sie + Produkt ?"), PracticeQuestion(prompt = "Sagen was ihr sucht. (frische Hefe)", expected = listOf("Ich suche frische Hefe."), focus = "ich suche", watch = "ich suche + Produkt."), PracticeQuestion(prompt = "Reagieren wenn ausverkauft.", expected = listOf("Schade! Danke trotzdem."), focus = "schade", watch = "Schade = lástima."), PracticeQuestion(prompt = "Fragen nach dem Total.", expected = listOf("Was macht das ?"), focus = "total", watch = "Was macht das ? = ¿cuánto es?"), PracticeQuestion(prompt = "Pregunta cómo puedes pagar.", expected = listOf("Bar oder mit Karte ?", "Kann ich mit Karte zahlen ?"), focus = "bar oder karte", watch = "Bar = efectivo."))), exercises = listOf(Exercise(id = "de-foundations-u5-laden-e1", kind = "choice", prompt = "___ Sie Vollkornbrot ?", options = listOf("Haben", "Sind", "Es gibt", "Gibt"), answers = listOf("Haben"), explain = "Haben Sie + Produkt ?"), Exercise(id = "de-foundations-u5-laden-e2", kind = "gap", prompt = "Ich ___ frische Hefe. (suchen)", options = listOf(), answers = listOf("suche"), explain = "ich suche + Produkt."), Exercise(id = "de-foundations-u5-laden-e3", kind = "order", prompt = "Fragt nach dem Total.", options = listOf(), answers = listOf("Was macht das"), explain = "Was macht das ?"), Exercise(id = "de-foundations-u5-laden-e4", kind = "written", prompt = "Sagt was ihr sucht: frische Hefe.", options = listOf(), answers = listOf("ich suche frische hefe"), explain = "Ich suche + Produkt.")), skills = listOf("function:go-shopping", "grammar:present-questions", "vocab:food", "function:solve-problems"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple"))))
}

object DeFoundationsU10 {
    val unit = CourseUnit(id = "de-foundations-u10", title = "Meine Wohnung", subtitle = "Mein Raum", level = "A1", themes = listOf(ConversationTheme("meine-wohnung", "Meine Wohnung", "Zimmer und Möbel", "house", "Course", "Lena zeigt ihre neue Wohnung: zwei Zimmer, eine Küche, ein Bad.", 0),
                ConversationTheme("im-zimmer", "Im Zimmer", "Wo ist das ?", "bed", "Course", "Wo ist mein Schlüssel, wo ist sein Schrank ? Ihr beschreibt euer Zuhause.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u10-wohnung", title = "Meine Wohnung", goal = "Zimmer und Möbel nennen und mit es gibt beschreiben.", intro = LessonIntro(explanation = listOf("Die Wohnung: das Zimmer, die Küche, das Bad, der Balkon. Möbel: das Bett, der Tisch, das Sofa.", "es gibt + Akkusativ: „Es gibt eine Küche.“ „Es gibt zwei Zimmer.“ So sagt man, was da ist.", "Frage: „Gibt es einen Balkon ?“ — „Ja, es gibt einen kleinen Balkon.“"), examples = listOf(ExampleLine(text = "Meine Wohnung ist klein, aber schön.", meaning = "Beschreibung: klein + schön."), ExampleLine(text = "Es gibt eine Küche und ein Bad.", meaning = "Was da ist: es gibt + Akkusativ."), ExampleLine(text = "Gibt es einen Balkon ?", meaning = "Frage mit Gibt es … ?"), ExampleLine(text = "Im Wohnzimmer gibt es ein Sofa.", meaning = "Wo genau: im Wohnzimmer."), ExampleLine(text = "Wie viele Zimmer gibt es ?", meaning = "Nach der Zahl fragen."))), expressions = listOf(TargetExpression(text = "Es gibt …", meaning = "Sagen was da ist.", note = "es gibt + Akkusativ: einen Tisch"), TargetExpression(text = "Gibt es … ?", meaning = "Fragen ob etwas da ist.", note = "Gibt es einen Aufzug ?"), TargetExpression(text = "das Zimmer / die Küche / das Bad", meaning = "Räume in der Wohnung.", note = "die Küche = la cocina"), TargetExpression(text = "das Bett / der Tisch / das Sofa", meaning = "Möbel.", note = "die Möbel = Plural"), TargetExpression(text = "Wie viele … ?", meaning = "Nach der Anzahl fragen.", note = "Wie viele Zimmer ?")), situation = "Lena zieht ein: sie zeigt ihre Wohnung — zwei Zimmer, eine Küche, ein kleines Bad, kein Balkon.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Beschreibt die Wohnung. (klein, schön)", expected = listOf("Meine Wohnung ist klein, aber schön.", "Meine Wohnung ist klein und schön."), focus = "meine wohnung", watch = "mein + Wohnung (f) = meine"), PracticeQuestion(prompt = "Sagt was es gibt: eine Küche und ein Bad.", expected = listOf("Es gibt eine Küche und ein Bad.", "es gibt eine kueche und ein bad"), focus = "es gibt", watch = "es gibt + Akkusativ"), PracticeQuestion(prompt = "Fragt nach einem Balkon.", expected = listOf("Gibt es einen Balkon ?", "gibt es einen balkon"), focus = "gibt es", watch = "einen: der Balkon ist Maskulin"), PracticeQuestion(prompt = "Sagt was es im Wohnzimmer gibt. (ein Sofa)", expected = listOf("Im Wohnzimmer gibt es ein Sofa.", "Es gibt ein Sofa im Wohnzimmer."), focus = "im wohnzimmer", watch = "im = in dem (Dativ)"), PracticeQuestion(prompt = "Fragt wie viele Zimmer es gibt.", expected = listOf("Wie viele Zimmer gibt es ?", "Wie viele Zimmer sind es ?"), focus = "wie viele", watch = "das Zimmer: Neutrum, immer gleich"))), exercises = listOf(Exercise(id = "de-foundations-u10-wohnung-e1", kind = "choice", prompt = "___ ___ eine Küche und ein Bad.", options = listOf("Es gibt", "Es ist", "Gibt es", "Sie sind"), answers = listOf("Es gibt"), explain = "es gibt + Akkusativ: was da ist."), Exercise(id = "de-foundations-u10-wohnung-e2", kind = "gap", prompt = "Im Bad ___ es eine Dusche.", options = listOf(), answers = listOf("gibt"), explain = "es gibt + Akkusativ: eine Dusche."), Exercise(id = "de-foundations-u10-wohnung-e3", kind = "order", prompt = "Beschreibt die Wohnung. (zwei Zimmer, eine Küche)", options = listOf(), answers = listOf("Es gibt zwei Zimmer und eine Küche"), explain = "es gibt + Akkusativ: zwei Zimmer."), Exercise(id = "de-foundations-u10-wohnung-e4", kind = "written", prompt = "Sagt wie die Wohnung ist. (schön)", options = listOf(), answers = listOf("die wohnung ist schön", "die wohnung ist schoen", "meine wohnung ist schön"), explain = "Beschreibung mit sein: ist + Adjektiv.")), skills = listOf("grammar:there-is-are", "grammar:present-simple", "vocab:home", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u10-orte", title = "Wo ist das ?", goal = "Sagen und fragen wo Dinge sind: auf, unter, neben.", intro = LessonIntro(explanation = listOf("Wo ist der Schlüssel ? — Auf dem Tisch. Fragen mit „Wo ist … ?“ und „Wo sind … ?“", "auf = encima de, unter = debajo de, neben = al lado de. Alle drei + Dativ: dem.", "Im Zimmer gibt es ein Bett und einen Schrank. in + Dativ: im Zimmer, in der Küche."), examples = listOf(ExampleLine(text = "Wo ist mein Buch ? — Auf dem Tisch.", meaning = "Frage und Antwort mit Wo."), ExampleLine(text = "Die Schuhe sind unter dem Bett.", meaning = "unter + Dativ."), ExampleLine(text = "Der Stuhl steht neben dem Fenster.", meaning = "neben + Dativ."), ExampleLine(text = "Ist die Lampe auf dem Schreibtisch ?", meaning = "Ja-Nein-Frage mit auf."), ExampleLine(text = "Im Zimmer gibt es ein Bett.", meaning = "Wo etwas ist: im + Dativ."))), expressions = listOf(TargetExpression(text = "Wo ist … ? / Wo sind … ?", meaning = "Nach dem Ort fragen.", note = "eine Sache: ist, zwei: sind"), TargetExpression(text = "auf dem Tisch", meaning = "Oben drauf.", note = "auf + Dativ: dem"), TargetExpression(text = "unter dem Bett", meaning = "Unten.", note = "unter + Dativ"), TargetExpression(text = "neben dem Sofa", meaning = "An der Seite.", note = "neben + Dativ"), TargetExpression(text = "im Zimmer / in der Küche", meaning = "Wo etwas ist.", note = "im = in dem")), situation = "Lena sucht ihren Schlüssel: er ist auf dem Tisch, unter einer Zeitschrift. Jonas hilft ihr.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Fragt wo das Buch ist.", expected = listOf("Wo ist das Buch ?", "wo ist das buch"), focus = "wo ist", watch = "Wo ist + eine Sache"), PracticeQuestion(prompt = "Sagt wo die Schuhe sind: unter dem Bett.", expected = listOf("Die Schuhe sind unter dem Bett.", "Sie sind unter dem Bett."), focus = "unter", watch = "unter + dem (Dativ)"), PracticeQuestion(prompt = "Sagt wo der Stuhl steht: neben dem Fenster.", expected = listOf("Der Stuhl steht neben dem Fenster.", "Der Stuhl ist neben dem Fenster."), focus = "neben", watch = "neben + dem Fenster"), PracticeQuestion(prompt = "Fragt ob die Lampe auf dem Tisch ist.", expected = listOf("Ist die Lampe auf dem Tisch ?", "ist die lampe auf dem tisch"), focus = "ist die lampe", watch = "Ja-Nein-Frage: das Verb kommt zuerst"), PracticeQuestion(prompt = "Sagt was es in der Küche gibt. (ein Tisch)", expected = listOf("In der Küche gibt es einen Tisch.", "Es gibt einen Tisch in der Küche."), focus = "in der kueche", watch = "in der Küche (f): Dativ"))), exercises = listOf(Exercise(id = "de-foundations-u10-orte-e1", kind = "choice", prompt = "Das Buch ist ___ dem Tisch.", options = listOf("auf", "im", "am", "zu"), answers = listOf("auf"), explain = "auf + Dativ: auf dem Tisch."), Exercise(id = "de-foundations-u10-orte-e2", kind = "gap", prompt = "Die Katze schläft ___ dem Bett. (unten)", options = listOf(), answers = listOf("unter"), explain = "unter + Dativ: unter dem Bett."), Exercise(id = "de-foundations-u10-orte-e3", kind = "order", prompt = "Sagt wo der Stuhl steht. (neben dem Fenster)", options = listOf(), answers = listOf("Der Stuhl steht neben dem Fenster"), explain = "neben + Dativ: dem Fenster."), Exercise(id = "de-foundations-u10-orte-e4", kind = "written", prompt = "Fragt wo die Lampe ist.", options = listOf(), answers = listOf("wo ist die lampe", "Wo ist die Lampe ?"), explain = "Fragen nach dem Ort: Wo ist … ?")), skills = listOf("grammar:prepositions-place", "grammar:there-is-are", "vocab:home", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "de-foundations-u10-mitbewohner", title = "Mein Mitbewohner", goal = "Über Menschen in der Wohnung sprechen: mein, dein, sein.", intro = LessonIntro(explanation = listOf("Personen: der Mitbewohner, die Mitbewohnerin. „Er heißt Jonas.“ „Sie ist nett.“", "Possessivartikel: mein (ich), dein (du), sein (er), ihr (sie). „Das ist mein Zimmer.“", "Beschreiben: „Er ist nett und ruhig.“ „Er kocht gern.“"), examples = listOf(ExampleLine(text = "Das ist Jonas. Er ist mein Mitbewohner.", meaning = "mein = von mir."), ExampleLine(text = "Sein Zimmer ist klein, aber schön.", meaning = "sein = von er."), ExampleLine(text = "Ist das dein Mantel ? — Nein, das ist sein Mantel.", meaning = "dein = von du."), ExampleLine(text = "Wo ist mein Schlüssel ?", meaning = "mein + Schlüssel."), ExampleLine(text = "Er ist nett und sehr ruhig.", meaning = "Person beschreiben."))), expressions = listOf(TargetExpression(text = "mein / dein / sein", meaning = "ich / du / er.", note = "mein Schlüssel, dein Zimmer"), TargetExpression(text = "der Mitbewohner / die Mitbewohnerin", meaning = "Person, die mit euch wohnt.", note = "mit + wohnen"), TargetExpression(text = "Er heißt …", meaning = "Den Namen sagen.", note = "Er heißt Jonas."), TargetExpression(text = "nett / ruhig / freundlich", meaning = "Positive Eigenschaften.", note = "nett = simpático"), TargetExpression(text = "Er kocht gern.", meaning = "Was er tut.", note = "gern = con gusto")), situation = "Jonas, der Mitbewohner von Lena, kocht heute: er ist ruhig, aber er kocht sehr gern und gut.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Stellt euren Mitbewohner vor. (Name: Jonas)", expected = listOf("Das ist mein Mitbewohner. Er heißt Jonas.", "Mein Mitbewohner heißt Jonas."), focus = "mein mitbewohner", watch = "der Mitbewohner ist Maskulin: mein"), PracticeQuestion(prompt = "Sagt wessen Zimmer es ist. (Jonas, klein)", expected = listOf("Sein Zimmer ist klein.", "sein zimmer ist klein"), focus = "sein zimmer", watch = "sein = von er"), PracticeQuestion(prompt = "Fragt nach eurem Schlüssel.", expected = listOf("Wo ist mein Schlüssel ?", "wo ist mein schluessel"), focus = "mein schlüssel", watch = "Der Schlüssel gehört dir: mein"), PracticeQuestion(prompt = "Beschreibt Jonas. (nett, ruhig)", expected = listOf("Er ist nett und ruhig.", "er ist nett und ruhig"), focus = "er ist", watch = "Eigenschaften mit sein"), PracticeQuestion(prompt = "Fragt einen Freund, ob das sein Mantel ist.", expected = listOf("Ist das dein Mantel ?", "ist das dein mantel"), focus = "ist das dein", watch = "Zu einem Freund sagst du dein"))), exercises = listOf(Exercise(id = "de-foundations-u10-mitbewohner-e1", kind = "choice", prompt = "Das ist ___ Mitbewohner. (ich)", options = listOf("mein", "dein", "sein", "ihr"), answers = listOf("mein"), explain = "mein = von ich: mein Mitbewohner."), Exercise(id = "de-foundations-u10-mitbewohner-e2", kind = "gap", prompt = "Das ist Jonas und das ist ___ Zimmer. (er)", options = listOf(), answers = listOf("sein"), explain = "sein = von er: sein Zimmer."), Exercise(id = "de-foundations-u10-mitbewohner-e3", kind = "order", prompt = "Beschreibt das Zimmer von Jonas. (klein, aber schön)", options = listOf(), answers = listOf("Sein Zimmer ist klein, aber schön"), explain = "sein + Zimmer: das Zimmer von er."), Exercise(id = "de-foundations-u10-mitbewohner-e4", kind = "written", prompt = "Beschreibt euren Mitbewohner. (nett und ruhig)", options = listOf(), answers = listOf("er ist nett und ruhig", "Er ist nett und ruhig."), explain = "Person beschreiben: er ist + Adjektiv.")), skills = listOf("grammar:possessives", "function:describe-people", "vocab:home", "grammar:present-simple"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:possessives"))))
}

object DeFoundationsU11 {
    val unit = CourseUnit(id = "de-foundations-u11", title = "Mein Viertel", subtitle = "In der Nähe", level = "A1", themes = listOf(ConversationTheme("in-der-naehe", "In der Nähe", "Orte im Viertel", "map", "Course", "Miguel ist neu im Viertel und sucht Orte: Supermarkt, Bäckerei, Park.", 0),
