, "ich werde das hotel online reservieren"), explain = "werden + Infinitiv: der Plan.")), skills = listOf("grammar:going-to", "function:make-future-plans", "vocab:travel", "grammar:connectors"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "de-foundations-u25-vortag", title = "Der Vortag", goal = "Am Tag vor der Reise: mit werden planen und mit deshalb und dann handeln.", intro = LessonIntro(explanation = listOf("Der Abend vorher: « Morgen fliegen wir — ich werde früh aufstehen. » — werden zeigt: es ist der Plan.", "Gründe mit deshalb: « Der Flug geht um neun, deshalb fahren wir um sieben los. » — Verb an Position 2.", "Check mit dann: « Zuerst die Dokumente, dann der Koffer — dann können wir los. »"), examples = listOf(ExampleLine(text = "Ich werde um sechs Uhr aufstehen.", meaning = "Der Plan für morgen."), ExampleLine(text = "Der Flug geht um neun, deshalb fahren wir früh los.", meaning = "deshalb + Verb Position 2."), ExampleLine(text = "Ich werde ein Taxi zum Flughafen bestellen.", meaning = "trennbar: bestellen."), ExampleLine(text = "Zuerst die Dokumente, dann der Koffer.", meaning = "Checkliste mit dann."), ExampleLine(text = "Das Wetter wird schön.", meaning = "werden ohne Infinitiv: Zustand."))), expressions = listOf(TargetExpression(text = "ich werde … aufstehen", meaning = "Morgen-Plan.", note = "trennbar: aufstehen → werde … aufstehen"), TargetExpression(text = "deshalb", meaning = "Grund → Folge.", note = "Später Flug, deshalb später los."), TargetExpression(text = "ein Taxi bestellen", meaning = "Zum Flughafen.", note = "Ich bestelle es für sieben."), TargetExpression(text = "losfahren", meaning = "Der Start.", note = "Wir fahren um sieben los."), TargetExpression(text = "vorher / danach", meaning = "Vor und nach.", note = "Vorher packen, danach schlafen.")), situation = "Abend vor dem Flug: Nina checkt die Liste, Ben wird um sechs aufstehen und ein Taxi bestellen, denn der Flug geht um neun. « Zuerst die Dokumente, dann der Koffer — dann ist alles fertig. »", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sag deinen Plan: du stehst früh auf. (werden)", expected = listOf("Ich werde früh aufstehen.", "ich werde früh aufstehen", "Ich werde um sechs Uhr aufstehen."), focus = "werde aufstehen", watch = "trennbar: werde … aufstehen."), PracticeQuestion(prompt = "Begründe mit deshalb: der Flug geht um neun, ihr fahrt um sieben los.", expected = listOf("Der Flug geht um neun, deshalb fahren wir um sieben los.", "der flug geht um neun deshalb fahren wir um sieben los", "Der Flug geht um neun, deshalb fahren wir früh los."), focus = "deshalb", watch = "deshalb + Verb an Position 2."), PracticeQuestion(prompt = "Sag: du wirst ein Taxi bestellen.", expected = listOf("Ich werde ein Taxi bestellen.", "ich werde ein taxi bestellen", "Ich werde ein Taxi zum Flughafen bestellen."), focus = "taxi bestellen", watch = "bestellen = rufen und organisieren."), PracticeQuestion(prompt = "Sag die Reihenfolge: erst Dokumente, dann Koffer.", expected = listOf("Zuerst die Dokumente, dann der Koffer.", "zuerst die dokumente dann der koffer", "Zuerst checke ich die Dokumente, dann den Koffer."), focus = "zuerst dann", watch = "Checkliste: zuerst … dann."), PracticeQuestion(prompt = "Sag: das Wetter wird morgen schön.", expected = listOf("Das Wetter wird morgen schön.", "das wetter wird morgen schön", "das wetter wird morgen schoen", "Morgen wird das Wetter schön."), focus = "wird schön", watch = "werden + Adjektiv: Zustand in der Zukunft."))), exercises = listOf(Exercise(id = "de-foundations-u25-vortag-e1", kind = "choice", prompt = "« Ich ___ morgen um sechs aufstehen. »", options = listOf("werde", "werdest", "willst", "würde"), answers = listOf("werde"), explain = "Futur: ich werde + Infinitiv."), Exercise(id = "de-foundations-u25-vortag-e2", kind = "gap", prompt = "Der Flug geht um neun, ___ fahren wir um sieben los.", options = listOf(), answers = listOf("deshalb"), explain = "Grund → Folge: deshalb + Verb Position 2."), Exercise(id = "de-foundations-u25-vortag-e3", kind = "order", prompt = "Sag: du bestellst ein Taxi zum Flughafen. (werden)", options = listOf(), answers = listOf("Ich werde ein Taxi zum Flughafen bestellen"), explain = "werde + Infinitiv am Ende."), Exercise(id = "de-foundations-u25-vortag-e4", kind = "written", prompt = "Sag, wie das Wetter morgen wird: schön.", options = listOf(), answers = listOf("das wetter wird morgen schön", "das wetter wird morgen schoen", "morgen wird das wetter schön", "morgen wird das wetter schoen"), explain = "werden + Adjektiv: Das Wetter wird schön.")), skills = listOf("grammar:going-to", "grammar:connectors", "vocab:transport", "function:make-future-plans"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "de-foundations-u25-flughafen", title = "Am Flughafen", goal = "Check-in und Gate: Ich möchte einchecken — so kommst du ans Gate und in den Flieger.", intro = LessonIntro(explanation = listOf("möchte + Infinitiv: « Ich möchte einchecken. » — höflicher als wollen.", "Am Schalter: « Hier ist mein Reisepass. », « Ich habe nur Handgepäck. » — kurz und klar.", "Fragen nach Zeit und Ort: « Wann beginnt das Boarding ? », « Von welchem Gate fliegt der Flug ? »"), examples = listOf(ExampleLine(text = "Ich möchte einchecken.", meaning = "möchte: höflich planen."), ExampleLine(text = "Hier ist mein Reisepass.", meaning = "Die Dokumente am Schalter."), ExampleLine(text = "Wann beginnt das Boarding ?", meaning = "Boarding = das Einsteigen."), ExampleLine(text = "Von welchem Gate fliegt der Flug ?", meaning = "Nach dem Gate fragen."), ExampleLine(text = "Ich habe nur Handgepäck.", meaning = "Handgepäck: der kleine Koffer für die Kabine."))), expressions = listOf(TargetExpression(text = "möchte + Infinitiv", meaning = "Höflich sagen, was du willst.", note = "Ich möchte einen Platz am Fenster."), TargetExpression(text = "das Boarding", meaning = "Das Einsteigen.", note = "Das Boarding beginnt um 8:30."), TargetExpression(text = "das Gate", meaning = "Der Weg zum Flieger.", note = "Gate B 12, bitte."), TargetExpression(text = "das Handgepäck", meaning = "Kommt in die Kabine.", note = "Nur ein Handgepäckstück."), TargetExpression(text = "pünktlich / verspätet", meaning = "Die Anzeige am Flughafen.", note = "Unser Flug ist pünktlich.")), situation = "Flughafen, halb acht: Nina steht am Schalter. « Guten Morgen, ich möchte einchecken. Hier ist mein Reisepass. » — « Nur Handgepäck ? » — « Ja. Wann beginnt das Boarding ? » — « Um 8:30, Gate B 12. Der Flug ist pünktlich. »", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sag am Schalter höflich: einchecken.", expected = listOf("Ich möchte einchecken.", "ich moechte einchecken", "Ich möchte bitte einchecken."), focus = "möchte einchecken", watch = "möchte + Infinitiv am Ende."), PracticeQuestion(prompt = "Gib dem Personal deinen Pass.", expected = listOf("Hier ist mein Reisepass.", "hier ist mein reisepass", "Hier ist mein Pass."), focus = "reisepass", watch = "Hier ist mein … ."), PracticeQuestion(prompt = "Frag nach der Zeit fürs Boarding.", expected = listOf("Wann beginnt das Boarding ?", "wann beginnt das boarding", "Wann startet das Boarding ?"), focus = "wann beginnt", watch = "Wann + Verb an Position 2."), PracticeQuestion(prompt = "Frag nach deinem Gate.", expected = listOf("Von welchem Gate fliegt der Flug ?", "von welchem gate fliegt der flug", "Welches Gate habe ich ?"), focus = "welches gate", watch = "welch- + Gate: welches."), PracticeQuestion(prompt = "Sag: nur der kleine Koffer für die Kabine.", expected = listOf("Ich habe nur Handgepäck.", "ich habe nur handgepäck", "ich habe nur handgepaeck"), focus = "handgepäck", watch = "Handgepäck: in die Kabine."))), exercises = listOf(Exercise(id = "de-foundations-u25-flughafen-e1", kind = "choice", prompt = "« Ich ___ einen Platz am Fenster. »", options = listOf("möchte", "möchte zu", "will zu", "mögen"), answers = listOf("möchte"), explain = "möchte + Akkusativ/Infinitiv: höflich am Schalter."), Exercise(id = "de-foundations-u25-flughafen-e2", kind = "gap", prompt = "Wann ___ das Boarding ? (beginnen, 3. Person)", options = listOf(), answers = listOf("beginnt"), explain = "das Boarding beginnt: 3. Person Singular mit -t."), Exercise(id = "de-foundations-u25-flughafen-e3", kind = "order", prompt = "Frag nach dem Abflug-Gate.", options = listOf(), answers = listOf("Von welchem Gate fliegt der Flug"), explain = "welch- fragt nach dem Gate: Von welchem Gate … ?"), Exercise(id = "de-foundations-u25-flughafen-e4", kind = "written", prompt = "Sag, was du an Gepäck hast: nur der kleine Koffer.", options = listOf(), answers = listOf("ich habe nur handgepaeck", "ich habe nur handgepäck"), explain = "Handgepäck: nur der kleine Koffer in der Kabine.")), skills = listOf("vocab:travel", "function:ask-simple-questions", "grammar:present-questions"), canDo = listOf("use-transport"), prerequisites = listOf("grammar:present-questions"))))
}

object DeFoundationsU28 {
    val unit = CourseUnit(id = "de-foundations-u28", title = "Der Umzug", subtitle = "Neue Wohnung, neue Stadt", level = "A2", themes = listOf(ConversationTheme("die-wohnungssuche", "Die Wohnungssuche", "Inserate und Besichtigung", "house", "Course", "Anna sucht eine Zwei-Zimmer-Wohnung: Inserate vergleichen, anrufen, einen Termin für die Besichtigung machen.", 0),
                ConversationTheme("der-umzugstag", "Der Umzugstag", "Kisten, Freunde, Ankommen", "door.left.open", "Course", "Umzugstag: Freunde helfen, Kisten wandern nach oben — am Abend steht der erste Kaffee in der neuen Küche.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u28-suche", title = "Wohnungsinserate verstehen", goal = "Inserate lesen und sagen, was nötig ist: Ich muss bis Ende des Monats umziehen — die Miete darf nicht zu hoch sein.", intro = LessonIntro(explanation = listOf("müssen + Infinitiv am Ende: « Ich muss bis Ende des Monats umziehen. » — so sagst du, was nötig ist.", "dürfen mit nicht: « Die Miete darf nicht über 900 Euro liegen. » — so setzt du deine Grenze.", "Inserate-Sprache: « 2 Zi., 62 m², 3. OG, mit Balkon » — Zi. = Zimmer, OG = Stockwerk (Etage)."), examples = listOf(ExampleLine(text = "Ich muss bis Ende des Monats umziehen.", meaning = "müssen + Infinitiv am Satzende."), ExampleLine(text = "Die Miete darf nicht zu hoch sein.", meaning = "dürfen nicht: die Grenze."), ExampleLine(text = "Ich suche eine Wohnung mit Balkon.", meaning = "mit + das Wunschkriterium."), ExampleLine(text = "Wie hoch ist die Miete ?", meaning = "Nach dem Preis fragen."), ExampleLine(text = "Die Wohnung liegt in der dritten Etage.", meaning = "OG = Obergeschoss: die Etage."))), expressions = listOf(TargetExpression(text = "müssen + Infinitiv", meaning = "Was nötig ist.", note = "Ich muss morgen anrufen."), TargetExpression(text = "die Miete / die Kaution", meaning = "Monatlich zahlen / einmalig hinterlegen.", note = "Zwei Monatsmieten als Kaution."), TargetExpression(text = "dürfen nicht + Infinitiv", meaning = "Die Grenze.", note = "Sie darf nicht zu hoch sein."), TargetExpression(text = "2 Zi., 60 m², 3. OG", meaning = "Die Kürzel im Inserat.", note = "Drei Zimmer, drittes Stockwerk."), TargetExpression(text = "die Besichtigung", meaning = "Die Wohnung anschauen.", note = "Ich mache einen Besichtigungstermin.")), situation = "Anna liest Inserate: « Ich muss bis Ende des Monats umziehen. » Zwei Zimmer, Balkon, dritte Etage — und die Miete darf nicht über 900 Euro liegen. Sie zirkelt die besten Anzeigen und ruft gleich an.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sag mit müssen: umziehen, bis Ende des Monats.", expected = listOf("Ich muss bis Ende des Monats umziehen.", "ich muss bis ende des monats umziehen"), focus = "muss umziehen", watch = "müssen + Infinitiv am Satzende."), PracticeQuestion(prompt = "Sag mit dürfen: die Miete, nicht über 900 Euro.", expected = listOf("Die Miete darf nicht über 900 Euro liegen.", "die miete darf nicht über 900 euro liegen", "die miete darf nicht ueber 900 euro liegen"), focus = "darf nicht", watch = "dürfen nicht = die Grenze."), PracticeQuestion(prompt = "Sag, was du suchst: eine Wohnung, mit Balkon.", expected = listOf("Ich suche eine Wohnung mit Balkon.", "ich suche eine wohnung mit balkon"), focus = "mit balkon", watch = "mit + das Kriterium."), PracticeQuestion(prompt = "Frag nach der Höhe der Miete.", expected = listOf("Wie hoch ist die Miete ?", "wie hoch ist die miete"), focus = "wie hoch", watch = "Wie hoch + Miete oder Preis."), PracticeQuestion(prompt = "Mach einen Termin: die Wohnung besichtigen, morgen um 17 Uhr.", expected = listOf("Kann ich die Wohnung morgen um 17 Uhr besichtigen ?", "Ich möchte einen Besichtigungstermin morgen um 17 Uhr.", "Können wir morgen um 17 Uhr kommen ?"), focus = "besichtigen", watch = "besichtigen = die Wohnung anschauen."))), exercises = listOf(Exercise(id = "de-foundations-u28-suche-e1", kind = "choice", prompt = "« Ich ___ bis Freitag antworten. » (nötig)", options = listOf("muss", "darf", "kann", "mag"), answers = listOf("muss"), explain = "müssen: nötig — muss + Infinitiv am Ende."), Exercise(id = "de-foundations-u28-suche-e2", kind = "gap", prompt = "Die Miete ___ nicht über 1 000 Euro liegen. (dürfen)", options = listOf(), answers = listOf("darf"), explain = "dürfen nicht: die Grenze bei der Miete."), Exercise(id = "de-foundations-u28-suche-e3", kind = "order", prompt = "Sag deinen Plan mit müssen: der Vermieter, anrufen, morgen.", options = listOf(), answers = listOf("Ich muss morgen den Vermieter anrufen"), explain = "müssen an Position 2, der Infinitiv anruft am Ende."), Exercise(id = "de-foundations-u28-suche-e4", kind = "written", prompt = "Sag mit suchen, was du brauchst: Wohnung plus Balkon.", options = listOf(), answers = listOf("ich suche eine wohnung mit balkon", "ich suche eine wohnung mit einem balkon"), explain = "suchen + mit: das Wunschkriterium im Inserat.")), skills = listOf("grammar:modal-must-have-to", "vocab:home", "function:solve-problems", "grammar:present-questions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:modal-must-have-to")),
    Lesson(id = "de-foundations-u28-besichtigung", title = "Die Besichtigung", goal = "Bei der Besichtigung fragen: Kann ich die Wohnung besichtigen ? — Wie hoch sind die Nebenkosten ?", intro = LessonIntro(explanation = listOf("Höflich fragen mit können: « Kann ich die Wohnung besichtigen ? », « Können Sie mir mehr sagen ? »", "Nach Details fragen: « Wie hoch sind die Nebenkosten ? » — Plural: sind.", "Termine machen: « Passt es Ihnen am Dienstag um 18 Uhr ? » — der höfliche Vorschlag."), examples = listOf(ExampleLine(text = "Kann ich die Wohnung besichtigen ?", meaning = "Die Terminfrage."), ExampleLine(text = "Wie hoch sind die Nebenkosten ?", meaning = "Nebenkosten: Strom, Wasser, Heizung."), ExampleLine(text = "Ist die Küche im Preis dabei ?", meaning = "dabei = inklusive."), ExampleLine(text = "Passt es Ihnen am Dienstag um 18 Uhr ?", meaning = "Der Terminvorschlag mit Sie."), ExampleLine(text = "Wann kann ich einziehen ?", meaning = "einziehen: in die Wohnung kommen."))), expressions = listOf(TargetExpression(text = "Kann ich … ? / Können Sie … ?", meaning = "Höflich fragen.", note = "Kann ich nochmal vorbeikommen ?"), TargetExpression(text = "die Nebenkosten", meaning = "Strom, Wasser, Heizung.", note = "Wie hoch sind die Nebenkosten ?"), TargetExpression(text = "im Preis dabei", meaning = "Inklusive.", note = "Ist der Keller dabei ?"), TargetExpression(text = "Passt es Ihnen … ?", meaning = "Den Termin fragen.", note = "Passt es Ihnen um 18 Uhr ?"), TargetExpression(text = "einziehen / ausziehen", meaning = "In die Wohnung rein — raus.", note = "Ich ziehe am 1. Mai ein.")), situation = "Anna besichtigt die Wohnung in der Lindenstraße. « Wie hoch sind die Nebenkosten ? » — « 180 Euro, Heizung dabei. » — « Ist die Küche im Preis dabei ? » — « Leider nicht. » — « Passt es Ihnen am Dienstag um 18 Uhr ? Dann nehme ich sie. »", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Frag, ob du die Wohnung besichtigen kannst.", expected = listOf("Kann ich die Wohnung besichtigen ?", "kann ich die wohnung besichtigen"), focus = "kann ich", watch = "Kann ich … ? — die höfliche Frage."), PracticeQuestion(prompt = "Frag nach den Nebenkosten.", expected = listOf("Wie hoch sind die Nebenkosten ?", "wie hoch sind die nebenkosten"), focus = "nebenkosten", watch = "Plural: die Nebenkosten sind."), PracticeQuestion(prompt = "Frag, ob die Küche inklusive ist.", expected = listOf("Ist die Küche im Preis dabei ?", "ist die kueche im preis dabei", "Ist die Küche dabei ?"), focus = "im preis dabei", watch = "dabei = inklusive."), PracticeQuestion(prompt = "Schlag Dienstag um 18 Uhr als Termin vor (Sie-Form).", expected = listOf("Passt es Ihnen am Dienstag um 18 Uhr ?", "passt es ihnen am dienstag um 18 uhr", "Passt es Ihnen am Dienstag ?"), focus = "passt es ihnen", watch = "Passt es Ihnen … ? — der Vorschlag."), PracticeQuestion(prompt = "Frag, wann du einziehen kannst.", expected = listOf("Wann kann ich einziehen ?", "wann kann ich einziehen"), focus = "einziehen", watch = "trennbar: ich ziehe … ein."))), exercises = listOf(Exercise(id = "de-foundations-u28-besichtigung-e1", kind = "choice", prompt = "« ___ ich die Wohnung morgen sehen ? »", options = listOf("Kann", "Muss", "Darf", "Bin"), answers = listOf("Kann"), explain = "Kann ich … ? — die höfliche Frage bei der Besichtigung."), Exercise(id = "de-foundations-u28-besichtigung-e2", kind = "gap", prompt = "Wie hoch ___ die Nebenkosten ? (sein, Plural)", options = listOf(), answers = listOf("sind"), explain = "Plural: die Nebenkosten sind."), Exercise(id = "de-foundations-u28-besichtigung-e3", kind = "order", prompt = "Frag, ob die Küche inklusive ist.", options = listOf(), answers = listOf("Ist die Küche im Preis dabei"), explain = "Im Preis dabei = inklusive — die Küchenfrage."), Exercise(id = "de-foundations-u28-besichtigung-e4", kind = "written", prompt = "Mach einen Terminvorschlag für Montag um 17 Uhr (Sie-Form).", options = listOf(), answers = listOf("passt es ihnen montag um 17 uhr", "passt es ihnen am montag um 17 uhr"), explain = "Passt es Ihnen + Zeit — der Terminvorschlag.")), skills = listOf("grammar:can", "grammar:present-questions", "function:make-requests", "vocab:home"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:can")),
    Lesson(id = "de-foundations-u28-umzug", title = "Der Umzugstag", goal = "Helfen und Anweisungen geben: Trag die Kiste hoch ! — Kannst du mir helfen ?", intro = LessonIntro(explanation = listOf("Imperativ mit du: « Trag die Kiste hoch ! » — ohne du, das Verb steht zuerst.", "helfen + mir/dir (Dativ): « Kannst du mir helfen ? », « Ich helfe dir. »", "Für mehrere: « Tragt schnell ! » — ihr-Form; mit Sie: « Tragen Sie bitte vorsichtig. »"), examples = listOf(ExampleLine(text = "Trag die Kiste hoch !", meaning = "du-Imperativ: das Verb zuerst."), ExampleLine(text = "Kannst du mir helfen ?", meaning = "helfen + mir: Dativ."), ExampleLine(text = "Ich helfe dir beim Packen.", meaning = "du → dir."), ExampleLine(text = "Tragt die Stühle vorsichtig !", meaning = "ihr-Imperativ: Endung -t."), ExampleLine(text = "Warte bitte kurz unten !", meaning = "bitte macht den Imperativ höflich."))), expressions = listOf(TargetExpression(text = "Trag … ! / Hol … !", meaning = "Der du-Imperativ.", note = "Hol den Kistenwagen !"), TargetExpression(text = "mir / dir (Dativ)", meaning = "helfen + Dativ.", note = "Ich helfe dir, hilfst du mir ?"), TargetExpression(text = "die Kiste / der Karton", meaning = "Beim Umzug.", note = "Der Karton ist schwer."), TargetExpression(text = "hochtragen / einräumen", meaning = "Trennbare Verben.", note = "Trag den Tisch hoch !"), TargetExpression(text = "Willkommen in der neuen Wohnung !", meaning = "Ankommen.", note = "Kaffee geht immer !")), situation = "Umzugstag bei Anna: Ben und Lena helfen. « Kannst du mir helfen ? » — « Klar, ich helfe dir. Trag die Kiste hoch, ich hol den Tisch ! » Am Abend: der erste Kaffee in der neuen Küche — Willkommen !", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Bitt Ben um Hilfe.", expected = listOf("Kannst du mir helfen ?", "kannst du mir helfen", "Kannst du mir bitte helfen ?"), focus = "kannst du mir", watch = "helfen + mir (Dativ)."), PracticeQuestion(prompt = "Sag zu Ben: die Kiste, hochtragen (du-Imperativ).", expected = listOf("Trag die Kiste hoch !", "trag die kiste hoch", "Trag die Kiste bitte hoch !"), focus = "trag hoch", watch = "Verb zuerst: Trag … hoch !"), PracticeQuestion(prompt = "Sag, dass du ihm hilfst.", expected = listOf("Ich helfe dir.", "ich helfe dir", "Ich helfe dir gern."), focus = "ich helfe dir", watch = "helfen + dir."), PracticeQuestion(prompt = "Gib zwei Leuten den Auftrag: die Stühle, vorsichtig (ihr).", expected = listOf("Tragt die Stühle vorsichtig !", "tragt die stuehle vorsichtig", "Tragt die Stühle bitte vorsichtig !"), focus = "tragt", watch = "ihr-Imperativ: Endung -t."), PracticeQuestion(prompt = "Sag Ben, er soll kurz unten warten (mit bitte).", expected = listOf("Warte bitte kurz unten !", "warte bitte kurz unten", "Warte kurz unten, bitte."), focus = "warte", watch = "warten → Warte ! ohne du."))), exercises = listOf(Exercise(id = "de-foundations-u28-umzug-e1", kind = "choice", prompt = "« ___ bitte die Tür auf ! » (du)", options = listOf("Mach", "Machen", "Macht", "Machst"), answers = listOf("Mach"), explain = "du-Imperativ: Verb zuerst, ohne du."), Exercise(id = "de-foundations-u28-umzug-e2", kind = "gap", prompt = "Kannst du ___ helfen ? (ich, Dativ)", options = listOf(), answers = listOf("mir"), explain = "helfen + Dativ: hilf mir."), Exercise(id = "de-foundations-u28-umzug-e3", kind = "order", prompt = "Sag Lena und Ben, sie sollen den Tisch hochtragen (ihr).", options = listOf(), answers = listOf("Tragt den Tisch hoch"), explain = "ihr-Imperativ: Tragt … hoch !"), Exercise(id = "de-foundations-u28-umzug-e4", kind = "written", prompt = "Bitt eine Freundin um Hilfe beim Packen.", options = listOf(), answers = listOf("kannst du mir beim packen helfen", "kannst du mir bitte helfen", "kannst du mir helfen"), explain = "Kannst du mir (beim Packen) helfen ? — die Bitte.")), skills = listOf("grammar:imperatives", "grammar:object-pronouns", "function:make-requests", "vocab:home"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:imperatives"))))
}

object DeFoundationsU6 {
    val unit = CourseUnit(id = "de-foundations-u6", title = "Erlebnisse und Veränderungen", subtitle = "Schon mal?", level = "B1", themes = listOf(ConversationTheme("de-b1-reise", "Die unvergessliche Reise", "Schon gesehen", "airplane", "Course", "Ihr sprecht über Reisen und erste Male: schon mal dort, noch nie gesehen, eine unvergessliche Geschichte.", 0),
                ConversationTheme("de-b1-wandel", "Der Lebenswandel", "Früher / heute", "arrow-up-forward", "Course", "Ihr vergleicht euer Leben früher und heute und erklärt, was sich geändert hat.", 1)), lessons = listOf(    Lesson(id = "de-b1-experiencias", title = "Schon mal gemacht ?", goal = "Von Erfahrungen erzählen mit dem Perfekt und schon/mal/nie.", intro = LessonIntro(explanation = listOf("Die Erfahrung: « Warst du schon mal in Lissabon ? » — « Ja, letztes Jahr war ich dort. »", "schon mal = mindestens einmal. « Ich habe Paella schon mal probiert. » nie = nullmal. « Ich bin noch nie Ski gefahren. »", "Die starken Partizipien bleiben: « gesehen », « gemacht », « gewesen »."), examples = listOf(ExampleLine(text = "Warst du schon mal in Lissabon ?", meaning = "Erfahrungsfrage."), ExampleLine(text = "Ich bin noch nie Ski gefahren.", meaning = "nie = nullmal."), ExampleLine(text = "Ich habe Paella schon mal probiert.", meaning = "schon mal = einmal."), ExampleLine(text = "Das war das erste Mal.", meaning = "Erstes Mal."), ExampleLine(text = "Was hast du dort gemacht ?", meaning = "Nachfragen."))), expressions = listOf(TargetExpression(text = "Warst du schon mal … ?", meaning = "Erfahrung.", note = "Warst du schon mal in Rom ?"), TargetExpression(text = "Ich bin noch nie …", meaning = "nie.", note = "…gefahren/gesehen."), TargetExpression(text = "gesehen / gemacht / gewesen", meaning = "starke Partizipien.", note = "sehen→gesehen."), TargetExpression(text = "das erste Mal", meaning = "Erstes Mal.", note = "Das war das erste Mal."), TargetExpression(text = "und du ?", meaning = "Zurückfragen.", note = "Und du, warst du… ?")), situation = "Ihr sprecht über Reisen: wer schon mal geflogen ist, wer noch nie gezeltet hat, und ein unvergessliches erstes Mal.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Frag, ob dein Freund schon mal in Lissabon war.", expected = listOf("Warst du schon mal in Lissabon ?"), focus = "schon mal", watch = "Warst du schon mal … ?"), PracticeQuestion(prompt = "Sag, dass du noch nie Ski gefahren bist.", expected = listOf("Ich bin noch nie Ski gefahren."), focus = "noch nie", watch = "noch nie + Partizip am Ende."), PracticeQuestion(prompt = "Sag, dass du Paella schon mal probiert hast.", expected = listOf("Ich habe Paella schon mal probiert."), focus = "schon mal", watch = "schon mal + Partizip."), PracticeQuestion(prompt = "Sag, dass es dein erstes Mal war.", expected = listOf("Das war mein erstes Mal.", "Das war das erste Mal."), focus = "erstes Mal", watch = "Präteritum war."), PracticeQuestion(prompt = "Frag zurück: und du ?", expected = listOf("Und du ?", "Und du, warst du schon mal surfen ?"), focus = "und du", watch = "und du fragt zurück."))), exercises = listOf(Exercise(id = "de-b1-experiencias-e1", kind = "choice", prompt = "Warst du schon mal ___ Rom ?", options = listOf("in", "nach", "zu", "an"), answers = listOf("in"), explain = "in + Stadt (wo)."), Exercise(id = "de-b1-experiencias-e2", kind = "gap", prompt = "Ich bin noch nie Ski ___. (fahren)", options = listOf(), answers = listOf("gefahren"), explain = "fahren → gefahren (sein)."), Exercise(id = "de-b1-experiencias-e3", kind = "order", prompt = "Frag die Erfahrung: hast du schon mal Schnecken gegessen ?", options = listOf(), answers = listOf("Hast du schon mal Schnecken gegessen"), explain = "Hast du schon mal + … + Partizip ?"), Exercise(id = "de-b1-experiencias-e4", kind = "written", prompt = "Sag eine Erfahrung: du hast diesen Film schon gesehen.", options = listOf(), answers = listOf("ich habe diesen film schon gesehen"), explain = "habe … + Partizip am Ende.")), skills = listOf("grammar:present-perfect", "grammar:past-simple-irregular", "function:describe-past-events"), canDo = listOf("describe-past-events"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "de-b1-antes-ahora", title = "Früher und heute", goal = "Vergangenheit und Gegenwart mit Präteritum und Konnektoren gegenüberstellen.", intro = LessonIntro(explanation = listOf("Das Präteritum erzählt Gewohntes: « Früher habe ich in der Stadt gewohnt. »", "Der Kontrast: « Früher… heute… ». « Früher habe ich geraucht, heute laufe ich. »", "Die Konnektoren: « aber », « weil », « also ». « Es war anstrengend, also bin ich umgezogen. »"), examples = listOf(ExampleLine(text = "Früher habe ich in der Stadt gewohnt.", meaning = "Vergangenheit."), ExampleLine(text = "Heute wohne ich auf dem Land.", meaning = "Gegenwart im Kontrast."), ExampleLine(text = "Früher habe ich geraucht, heute laufe ich.", meaning = "Lebenswandel."), ExampleLine(text = "Es war anstrengend, also bin ich umgezogen.", meaning = "also = Folge."), ExampleLine(text = "Ich finde das heutige Leben besser, weil…", meaning = "weil = Grund."))), expressions = listOf(TargetExpression(text = "Früher habe ich …", meaning = "Perfekt.", note = "…gewohnt/gemacht."), TargetExpression(text = "heute …", meaning = "Präsens.", note = "heute wohne ich…"), TargetExpression(text = "aber / weil / also", meaning = "Konnektoren.", note = "aber = Kontrast."), TargetExpression(text = "ich finde … besser", meaning = "Meinung.", note = "ich finde…"), TargetExpression(text = "Es war + Adjektiv", meaning = "Rahmen.", note = "Es war ruhig.")), situation = "Ihr vergleicht das Leben früher und heute: Stadt und Land, Arbeit und Freizeit, und warum ihr umgezogen seid.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sag, dass du früher in der Stadt gewohnt hast.", expected = listOf("Früher habe ich in der Stadt gewohnt."), focus = "Früher", watch = "Früher + Perfekt."), PracticeQuestion(prompt = "Sag, dass du heute auf dem Land wohnst.", expected = listOf("Heute wohne ich auf dem Land."), focus = "heute", watch = "heute + Präsens."), PracticeQuestion(prompt = "Gegenüber: früher geraucht, heute läufst du.", expected = listOf("Früher habe ich geraucht heute laufe ich.", "Früher habe ich geraucht, heute laufe ich."), focus = "früher/heute", watch = "zwei Zeiten."), PracticeQuestion(prompt = "Nenne die Folge: es war anstrengend, also bist du umgezogen.", expected = listOf("Es war anstrengend also bin ich umgezogen.", "Es war anstrengend, also bin ich umgezogen."), focus = "also", watch = "also + Folge."), PracticeQuestion(prompt = "Sag, was dir besser gefällt und warum.", expected = listOf("Ich finde das heutige Leben besser weil ich freier bin.", "Ich finde das heutige Leben besser."), focus = "weil", watch = "weil + Grund."))), exercises = listOf(Exercise(id = "de-b1-antes-ahora-e1", kind = "choice", prompt = "Früher ___ ich in der Stadt gewohnt.", options = listOf("habe", "bin", "war", "hatte"), answers = listOf("habe"), explain = "wohnen → haben: habe gewohnt."), Exercise(id = "de-b1-antes-ahora-e2", kind = "gap", prompt = "Es war anstrengend, ___ bin ich umgezogen. (Folge)", options = listOf(), answers = listOf("also"), explain = "also = Folge."), Exercise(id = "de-b1-antes-ahora-e3", kind = "order", prompt = "Gegenüber: früher geraucht, heute gelaufen.", options = listOf(), answers = listOf("Früher habe ich geraucht heute laufe ich"), explain = "Früher + Perfekt, heute + Präsens."), Exercise(id = "de-b1-antes-ahora-e4", kind = "written", prompt = "Sag, was sich geändert hat: heute arbeitest du von zu Hause.", options = listOf(), answers = listOf("heute arbeite ich von zu hause"), explain = "heute + Präsens.")), skills = listOf("grammar:used-to", "grammar:connectors", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:used-to"))))
}

object DeFoundationsU18 {
    val unit = CourseUnit(id = "de-foundations-u18", title = "Geschichten erzählen", subtitle = "Erlebt und erzählt", level = "B1", themes = listOf(ConversationTheme("de-b1-was-passiert-ist", "Was passiert ist", "Zuerst, dann, am Ende", "book", "Course", "Ihr erzählt vom Wochenende in Berlin: wer zuerst losfuhr, was dann passierte und wie es am Ende ausging.", 0),
                ConversationTheme("de-b1-die-wendung", "Die Wendung", "Plötzlich…", "sparkles", "Course", "Eine Geschichte wird spannend: plötzlich klingelte es, und es stellte sich heraus… Ihr übt den Überraschungsmoment.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u18-erzaehlen", title = "Was passiert ist", goal = "Erlebtes erzählen: Fakten in der Reihenfolge verbinden — zuerst, dann, am Ende.", intro = LessonIntro(explanation = listOf("Die Erzählzeit ist das Präteritum: « Ich fuhr nach Berlin. Ich traf Lara. » Regelmäßige Verben enden auf -te: ich machte, sie wohnte.", "Die Reihenfolge liefern die Konnektoren: zuerst → dann → danach → am Ende: « Zuerst fuhr ich los, dann regnete es, am Ende schien die Sonne. »", "Kurze Fakten nebeneinander klingen wie ein Bericht: « Der Zug kam um acht. Ich wartete am Bahnsteig. Nichts passierte. »"), examples = listOf(ExampleLine(text = "Zuerst fuhr ich nach Berlin.", meaning = "fahren → fuhr (stark)."), ExampleLine(text = "Dann traf ich Lara am Bahnhof.", meaning = "treffen → traf."), ExampleLine(text = "Danach gingen wir ins Museum.", meaning = "gehen → gingen."), ExampleLine(text = "Am Ende war alles gut.", meaning = "war: das Erzähl-Verb."), ExampleLine(text = "Es regnete den ganzen Tag.", meaning = "regnen → regnete (regelmäßig)."))), expressions = listOf(TargetExpression(text = "zuerst", meaning = "Schritt eins.", note = "Zuerst fuhr ich los."), TargetExpression(text = "dann / danach", meaning = "Der nächste Schritt.", note = "Dann kam der Bus."), TargetExpression(text = "am Ende", meaning = "Der Ausgang.", note = "Am Ende war alles gut."), TargetExpression(text = "fuhr / traf / kam", meaning = "Starke Präterita.", note = "fahren→fuhr, treffen→traf"), TargetExpression(text = "machte / wohnte / regnete", meaning = "Schwache Präterita auf -te.", note = "ich machte es gestern.")), situation = "Ihr erzählt euer Berlin-Wochenende: zuerst die Fahrt, dann der Regen, danach das Museum — und am Ende ein Sonnentag.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Erzähle Schritt eins: du fuhst nach Berlin.", expected = listOf("Zuerst fuhr ich nach Berlin.", "zuerst fuhr ich nach berlin", "Ich fuhr zuerst nach Berlin."), focus = "zuerst", watch = "fahren → fuhr."), PracticeQuestion(prompt = "Erzähle weiter: du trafst Lara.", expected = listOf("Dann traf ich Lara.", "dann traf ich lara"), focus = "dann", watch = "treffen → traf."), PracticeQuestion(prompt = "Sag, dass ihr danach ins Museum gingt.", expected = listOf("Danach gingen wir ins Museum.", "danach gingen wir ins museum"), focus = "danach", watch = "gehen → gingen."), PracticeQuestion(prompt = "Erzähle den Ausgang: alles war gut.", expected = listOf("Am Ende war alles gut.", "am ende war alles gut"), focus = "am ende", watch = "am Ende + Präteritum."), PracticeQuestion(prompt = "Erzähle das Wetter: es regnete den ganzen Tag.", expected = listOf("Es regnete den ganzen Tag.", "es regnete den ganzen tag", "Danach regnete es."), focus = "regnete", watch = "regnen → regnete (regelmäßig)."))), exercises = listOf(Exercise(id = "de-foundations-u18-erzaehlen-e1", kind = "choice", prompt = "___ fuhr ich nach Berlin.", options = listOf("Zuerst", "Am Ende", "Danach", "Plötzlich"), answers = listOf("Zuerst"), explain = "Zuerst markiert Schritt eins der Erzählung."), Exercise(id = "de-foundations-u18-erzaehlen-e2", kind = "gap", prompt = "Ich ___ Lara am Bahnhof. (treffen, Präteritum)", options = listOf(), answers = listOf("traf"), explain = "treffen → traf: starkes Präteritum."), Exercise(id = "de-foundations-u18-erzaehlen-e3", kind = "order", prompt = "Erzähle den Ausgang der Geschichte.", options = listOf(), answers = listOf("Am Ende war alles gut"), explain = "am Ende + Präteritum: so schließt man die Geschichte."), Exercise(id = "de-foundations-u18-erzaehlen-e4", kind = "written", prompt = "Erzähle: du gingst danach ins Museum.", options = listOf(), answers = listOf("danach ging ich ins museum", "danach gingen wir ins museum"), explain = "gehen → ging/gingen im Präteritum.")), skills = listOf("function:tell-a-story", "grammar:past-simple-irregular", "grammar:connectors", "grammar:past-simple-regular"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "de-foundations-u18-ueberraschung", title = "Die überraschende Wendung", goal = "Spannend erzählen: den Überraschungsmoment mit plötzlich und es stellte sich heraus bauen.", intro = LessonIntro(explanation = listOf("Der Wendepunkt kommt mit plötzlich oder auf einmal: « Plötzlich stand er vor der Tür. »", "Die Auflösung liefert die feste Formel es stellte sich heraus, dass … = später erfuhr man die Wahrheit: « Es stellte sich heraus, dass er mein neuer Nachbar war. »", "Spannung entsteht mit kurzen Sätzen im Präteritum: « Das Telefon klingelte. Niemand ging ran. »"), examples = listOf(ExampleLine(text = "Plötzlich stand er vor der Tür.", meaning = "stehen → stand."), ExampleLine(text = "Auf einmal begann es zu regnen.", meaning = "beginnen → begann."), ExampleLine(text = "Es stellte sich heraus, dass sie Geschwister waren.", meaning = "Die Auflösung."), ExampleLine(text = "Das Telefon klingelte. Niemand ging ran.", meaning = "Kurze Sätze bauen Spannung."), ExampleLine(text = "Ich traute meinen Augen nicht.", meaning = "glauben-artig regelmäßig: traute."))), expressions = listOf(TargetExpression(text = "plötzlich / auf einmal", meaning = "Der Wendepunkt.", note = "Plötzlich klingelte es."), TargetExpression(text = "es stellte sich heraus, dass…", meaning = "Die Auflösung.", note = "…dass alles anders war."), TargetExpression(text = "stand / begann / ging", meaning = "Starke Präterita.", note = "stehen→stand, beginnen→begann"), TargetExpression(text = "Ich traute meinen Augen nicht.", meaning = "Staunen.", note = "traute: regelmäßig."), TargetExpression(text = "und dann ?", meaning = "Spannung aufbauen.", note = "Und dann kam der Clou.")), situation = "Ihr erzählt die Geschichte mit dem Fremden an der Tür: erst Stille, dann klingelte es plötzlich — und es stellte sich heraus, dass er der neue Nachbar war.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Erzähle den Wendepunkt: das Telefon klingelte.", expected = listOf("Plötzlich klingelte das Telefon.", "plotzlich klingelte das telefon", "Auf einmal klingelte das Telefon."), focus = "plötzlich", watch = "plötzlich / auf einmal + Präteritum."), PracticeQuestion(prompt = "Sag die Auflösung: er war dein neuer Nachbar.", expected = listOf("Es stellte sich heraus, dass er mein neuer Nachbar war.", "es stellte sich heraus dass er mein neuer nachbar war"), focus = "es stellte sich heraus", watch = "Die feste Formel mit dass."), PracticeQuestion(prompt = "Erzähle: es begann zu regnen. (auf einmal)", expected = listOf("Auf einmal begann es zu regnen.", "auf einmal begann es zu regnen"), focus = "auf einmal", watch = "beginnen → begann."), PracticeQuestion(prompt = "Sag, dass du deinen Augen nicht traust.", expected = listOf("Ich traute meinen Augen nicht.", "ich traute meinen augen nicht"), focus = "traute", watch = "trauen → traute (regelmäßig)."), PracticeQuestion(prompt = "Frag gespannt weiter.", expected = listOf("Und dann ?", "und dann", "Wie ging es weiter ?"), focus = "und dann", watch = "Und dann ? hält die Erzählung in Gang."))), exercises = listOf(Exercise(id = "de-foundations-u18-ueberraschung-e1", kind = "choice", prompt = "« ___ stellte sich heraus, dass er mein Nachbar war. »", options = listOf("Es", "Er", "Da", "Man"), answers = listOf("Es"), explain = "Die feste Formel: es stellte sich heraus, dass…"), Exercise(id = "de-foundations-u18-ueberraschung-e2", kind = "gap", prompt = "Plötzlich ___ er vor der Tür. (stehen, Präteritum)", options = listOf(), answers = listOf("stand"), explain = "stehen → stand: der Wendepunkt."), Exercise(id = "de-foundations-u18-ueberraschung-e3", kind = "order", prompt = "Erzähle den Überraschungsmoment: das Telefon.", options = listOf(), answers = listOf("Plötzlich klingelte das Telefon"), explain = "plötzlich + Präteritum: Spannung in einem Satz."), Exercise(id = "de-foundations-u18-ueberraschung-e4", kind = "written", prompt = "Sag die Auflösung: der Fremde war Emmas Bruder.", options = listOf(), answers = listOf("es stellte sich heraus dass der fremde emmas bruder war", "es stellte sich heraus, dass der fremde emmas bruder war"), explain = "es stellte sich heraus, dass… bringt die Auflösung.")), skills = listOf("function:tell-a-story", "grammar:connectors", "grammar:past-simple-irregular", "vocab:social-expressions"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-irregular")),
    Lesson(id = "de-foundations-u18-anekdoten", title = "Die Sommerepisode", goal = "Anekdoten erzählen und reagieren: nicht zu fassen, und dann ?", intro = LessonIntro(explanation = listOf("Die Anekdote ist ein kurzes Erlebnis, lustig erzählt: « Im Sommer arbeitete ich in einem Café. Ein Gast bestellte elfmal Cappuccino. »", "Reagieren hält die Geschichte am Laufen: « Nicht zu fassen ! », « Und dann ? », « Wie ging es aus ? »", "Der Schluss gehört dazu: « Am Ende lachte nur noch jeder. » — so endet die Anekdote."), examples = listOf(ExampleLine(text = "Im Sommer arbeitete ich in einem Café.", meaning = "arbeiten → arbeitete (regelmäßig)."), ExampleLine(text = "Ein Gast bestellte elfmal Cappuccino.", meaning = "bestellen → bestellte."), ExampleLine(text = "Nicht zu fassen !", meaning = "Ungläubig reagieren."), ExampleLine(text = "Und dann ? Was machte der Gast ?", meaning = "Nachfragen hält die Spannung."), ExampleLine(text = "Am Ende lachte nur noch jeder.", meaning = "Der Ausgang."))), expressions = listOf(TargetExpression(text = "Nicht zu fassen !", meaning = "Ungläubigkeit.", note = "auch: Unglaublich !"), TargetExpression(text = "Und dann ?", meaning = "Weiter erzählen lassen.", note = "gespannt nachhaken"), TargetExpression(text = "Wie ging es aus ?", meaning = "Nach dem Ausgang fragen.", note = "ausgehen → es ging gut aus"), TargetExpression(text = "das Beste kommt noch", meaning = "Ankündigung.", note = "Aber das Beste kommt noch."), TargetExpression(text = "Am Ende …", meaning = "Der Schluss.", note = "Am Ende lachten alle.")), situation = "Tim erzählt die Sommerepisode vom Café: der Gast mit den elf Cappuccinos. Kim hört gespannt zu und reagiert: « Nicht zu fassen ! Und dann ? »", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Erzähle den Anfang: du arbeitetest im Sommer im Café.", expected = listOf("Im Sommer arbeitete ich in einem Café.", "im sommer arbeitete ich in einem cafe"), focus = "arbeitete", watch = "arbeiten → arbeitete."), PracticeQuestion(prompt = "Erzähle das Kuriosum: elfmal Cappuccino.", expected = listOf("Ein Gast bestellte elfmal Cappuccino.", "ein gast bestellte elfmal cappuccino"), focus = "bestellte", watch = "bestellen → bestellte."), PracticeQuestion(prompt = "Reagiere ungläubig.", expected = listOf("Nicht zu fassen !", "nicht zu fassen", "Unglaublich !"), focus = "nicht zu fassen", watch = "Nicht zu fassen ! = unglaublich !"), PracticeQuestion(prompt = "Frag gespannt nach dem Ausgang.", expected = listOf("Wie ging es aus ?", "wie ging es aus", "Und dann ?"), focus = "wie ging es aus", watch = "Wie ging es aus ?"), PracticeQuestion(prompt = "Erzähle den Schluss: alle lachten.", expected = listOf("Am Ende lachte nur noch jeder.", "am ende lachte jeder", "Alle lachten am Ende."), focus = "am ende", watch = "Der Ausgang mit am Ende."))), exercises = listOf(Exercise(id = "de-foundations-u18-anekdoten-e1", kind = "choice", prompt = "« ___ zu fassen ! » (Ungläubigkeit)", options = listOf("Nicht", "Kein", "Nie", "Niemals"), answers = listOf("Nicht"), explain = "Die Reaktion: Nicht zu fassen !"), Exercise(id = "de-foundations-u18-anekdoten-e2", kind = "gap", prompt = "Im Sommer ___ ich in einem Café. (arbeiten, Präteritum)", options = listOf(), answers = listOf("arbeitete"), explain = "arbeiten → arbeitete: regelmäßig auf -te."), Exercise(id = "de-foundations-u18-anekdoten-e3", kind = "order", prompt = "Erzähle das Kuriosum: der Gast, elfmal Cappuccino.", options = listOf(), answers = listOf("Ein Gast bestellte elfmal Cappuccino"), explain = "bestellte: das Präteritum des Kuriosums."), Exercise(id = "de-foundations-u18-anekdoten-e4", kind = "written", prompt = "Frag nach dem Ausgang der Geschichte.", options = listOf(), answers = listOf("wie ging es aus", "wie ist es ausgegangen"), explain = "Wie ging es aus ? — so fragt man nach dem Ausgang.")), skills = listOf("function:tell-a-story", "vocab:social-expressions", "grammar:past-simple-regular", "function:describe-past-events"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-regular"))))
}

object DeFoundationsU21 {
    val unit = CourseUnit(id = "de-foundations-u21", title = "Die Arbeit", subtitle = "Beruf und Ziele", level = "B1", themes = listOf(ConversationTheme("de-b1-vorstellung", "Das Vorstellungsgespräch", "Erfahrung und Stärken", "briefcase", "Course", "Lena bewirbt sich als Projektkoordinatorin: drei Jahre Erfahrung, gern im Team — aber warum genau dieses Unternehmen ?", 0),
                ConversationTheme("de-b1-im-team", "Im Team", "Klima und Ziele", "bubble.left.and.text.bubble.right", "Course", "Wie ist die Atmosphäre bei der neuen Arbeit ? Und wo will man in fünf Jahren sein ? Kollegen und Ziele im Gespräch.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u21-vorstellung", title = "Das Vorstellungsgespräch", goal = "Im Vorstellungsgespräch über Erfahrung und Stärken sprechen — mit Beispielen und Konnektoren.", intro = LessonIntro(explanation = listOf("Erfahrung mit Perfekt: « Ich habe drei Jahre als Projektkoordinatorin gearbeitet. » außerdem fügt Beispiele hinzu.", "Stärken konkret nennen und belegen: « Meine größte Stärke ist Organisationstalent — dabei habe ich zehn Projekte gleichzeitig betreut. »", "Warum dieses Unternehmen ? Mit deshalb begründen: « Deshalb habe ich mich bei Ihnen beworben. »"), examples = listOf(ExampleLine(text = "Ich habe drei Jahre in einem Startup gearbeitet.", meaning = "Erfahrung im Perfekt."), ExampleLine(text = "Außerdem habe ich ein kleines Team geleitet.", meaning = "außerdem fügt hinzu."), ExampleLine(text = "Meine Stärke ist Organisationstalent.", meaning = "Stärke nennen."), ExampleLine(text = "Ich arbeite gern im Team, kann aber auch allein arbeiten.", meaning = "aber balanciert zwei Seiten."), ExampleLine(text = "Deshalb habe ich mich bei Ihnen beworben.", meaning = "Begründung mit deshalb."))), expressions = listOf(TargetExpression(text = "Ich habe … als … gearbeitet.", meaning = "Erfahrung sagen.", note = "… zwei Jahre als Verkäufer."), TargetExpression(text = "meine Stärke ist …", meaning = "Stärken nennen.", note = "… Organisationstalent."), TargetExpression(text = "außerdem", meaning = "Hinzufügen.", note = "Außerdem spreche ich Spanisch."), TargetExpression(text = "deshalb", meaning = "Begründen.", note = "Deshalb bewerbe ich mich."), TargetExpression(text = "sich bewerben bei", meaning = "Um die Stelle fragen.", note = "Ich habe mich bei Ihnen beworben.")), situation = "Lena sitzt im Vorstellungsgespräch: erst die Erfahrung im Perfekt, dann die Stärken mit Beispielen — und am Ende die Begründung, warum genau dieses Unternehmen.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Erzähle deine Erfahrung: drei Jahre in einem Startup. (Perfekt)", expected = listOf("Ich habe drei Jahre in einem Startup gearbeitet.", "ich habe drei jahre in einem startup gearbeitet"), focus = "habe gearbeitet", watch = "Perfekt: habe gearbeitet."), PracticeQuestion(prompt = "Füge hinzu: du sprichst außerdem Spanisch.", expected = listOf("Außerdem spreche ich Spanisch.", "außerdem spreche ich spanisch", "Ausserdem spreche ich Spanisch."), focus = "außerdem", watch = "außerdem + Hauptsatz."), PracticeQuestion(prompt = "Nenne deine Stärke: Organisationstalent.", expected = listOf("Meine Stärke ist Organisationstalent.", "meine stärke ist organisationstalent", "Meine größte Stärke ist Organisationstalent."), focus = "meine stärke", watch = "Stärke nennen + Beispiel."), PracticeQuestion(prompt = "Sag, dass du gern im Team arbeitest.", expected = listOf("Ich arbeite gern im Team.", "ich arbeite gern im team"), focus = "arbeite gern", watch = "gern + Verb."), PracticeQuestion(prompt = "Begründe deine Bewerbung mit deshalb.", expected = listOf("Deshalb habe ich mich bei Ihnen beworben.", "deshalb habe ich mich bei ihnen beworben", "Deshalb bewerbe ich mich."), focus = "deshalb", watch = "deshalb + Verb an Position 2."))), exercises = listOf(Exercise(id = "de-foundations-u21-vorstellung-e1", kind = "choice", prompt = "« Ich ___ drei Jahre in einer Agentur gearbeitet. »", options = listOf("habe", "bin", "war", "hat"), answers = listOf("habe"), explain = "Perfekt mit haben: habe gearbeitet."), Exercise(id = "de-foundations-u21-vorstellung-e2", kind = "gap", prompt = "Ich arbeite gern im Team, ___ kann ich auch allein arbeiten.", options = listOf(), answers = listOf("aber"), explain = "aber verbindet beide Seiten der Stärke."), Exercise(id = "de-foundations-u21-vorstellung-e3", kind = "order", prompt = "Begründe im Gespräch deine Bewerbung mit deshalb.", options = listOf(), answers = listOf("Deshalb habe ich mich bei Ihnen beworben"), explain = "deshalb + Verb an Position 2: die Begründung."), Exercise(id = "de-foundations-u21-vorstellung-e4", kind = "written", prompt = "Nenne eine Stärke und belege sie kurz.", options = listOf(), answers = listOf("meine stärke ist organisationstalent", "meine staerke ist organisationstalent", "ich arbeite gern im team und bin zuverlässig", "ich arbeite gern im team und bin zuverlaessig"), explain = "Stärke nennen + Beispiel: so klingt man überzeugend.")), skills = listOf("function:talk-about-work", "vocab:work", "grammar:present-perfect", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-perfect")),
    Lesson(id = "de-foundations-u21-kollegen", title = "Mit den Kollegen", goal = "Die Arbeitsatmosphäre beschreiben: das Team, den Chef und den Umgang miteinander.", intro = LessonIntro(explanation = listOf("Atmosphäre mit Adjektiven: entspannt, kollegial, fordernd — « Die Atmosphäre im Team ist sehr kollegial. »", "Umgang beschreiben: « Wir helfen uns gegenseitig », « Mit meinem Chef verstehe ich mich gut. »", "Auch Kritik geht höflich mit aber/allerdings: « Der Job ist spannend, allerdings ist der Stress vor Deadlines groß. »"), examples = listOf(ExampleLine(text = "Die Atmosphäre im Team ist sehr kollegial.", meaning = "Adjektiv + Atmosphäre."), ExampleLine(text = "Wir helfen uns gegenseitig.", meaning = "gegenseitig = alle helfen allen."), ExampleLine(text = "Mit meinem Chef verstehe ich mich gut.", meaning = "sich verstehen mit + Dativ."), ExampleLine(text = "Manchmal gibt es Stress, aber wir lachen viel.", meaning = "aber relativiert."), ExampleLine(text = "Der Job ist spannend, allerdings sehr fordernd.", meaning = "allerdings: formeller Kontrast."))), expressions = listOf(TargetExpression(text = "die Atmosphäre / das Klima", meaning = "Wie es im Team ist.", note = "entspannt, kollegial, fordernd"), TargetExpression(text = "Wir helfen uns gegenseitig.", meaning = "Zusammenarbeit.", note = "auch: wir unterstützen uns."), TargetExpression(text = "sich verstehen mit + Dativ", meaning = "Beziehungen.", note = "Ich verstehe mich gut mit allen."), TargetExpression(text = "kollegial / entspannt / fordernd", meaning = "Adjektive fürs Klima.", note = "ein kollegiales Team"), TargetExpression(text = "allerdings", meaning = "Formeller Kontrast.", note = "spannend, allerdings fordernd")), situation = "Lena erzählt ihrer Freundin vom neuen Job: Das Team ist klein und kollegial, alle helfen sich gegenseitig — nur vor Deadlines gibt es manchmal Stress, wie überall.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Beschreibe das Klima: sehr kollegial.", expected = listOf("Das Klima im Team ist sehr kollegial.", "das klima ist sehr kollegial", "Die Atmosphäre ist sehr kollegial."), focus = "kollegial", watch = "Adjektiv + Klima/Atmosphäre."), PracticeQuestion(prompt = "Sag, dass ihr euch gegenseitig helft.", expected = listOf("Wir helfen uns gegenseitig.", "wir helfen uns gegenseitig", "Wir unterstützen uns gegenseitig."), focus = "gegenseitig", watch = "gegenseitig = alle allen."), PracticeQuestion(prompt = "Sag, dass du dich mit deinem Chef gut verstehst.", expected = listOf("Mit meinem Chef verstehe ich mich gut.", "ich verstehe mich gut mit meinem chef"), focus = "verstehe mich", watch = "sich verstehen mit + Dativ."), PracticeQuestion(prompt = "Relativiere: Stress gibt es manchmal, aber ihr lacht viel.", expected = listOf("Manchmal gibt es Stress, aber wir lachen viel.", "manchmal gibt es stress aber wir lachen viel", "Es gibt Stress, aber die Stimmung ist gut."), focus = "aber", watch = "aber relativiert die Kritik."), PracticeQuestion(prompt = "Sage es formeller mit allerdings: spannend, aber fordernd.", expected = listOf("Der Job ist spannend, allerdings fordernd.", "der job ist spannend allerdings fordernd", "Der Job ist spannend, allerdings sehr fordernd."), focus = "allerdings", watch = "allerdings: formeller Kontrast."))), exercises = listOf(Exercise(id = "de-foundations-u21-kollegen-e1", kind = "choice", prompt = "« Die ___ im Team ist sehr entspannt. »", options = listOf("Atmosphäre", "Erfahrung", "Bewerbung", "Entschuldigung"), answers = listOf("Atmosphäre"), explain = "Atmosphäre/Klima: so beschreibt man das Teamgefühl."), Exercise(id = "de-foundations-u21-kollegen-e2", kind = "gap", prompt = "Wir helfen uns ___, wenn viel zu tun ist.", options = listOf(), answers = listOf("gegenseitig"), explain = "gegenseitig: alle helfen allen."), Exercise(id = "de-foundations-u21-kollegen-e3", kind = "order", prompt = "Beschreibe das Verhältnis zu deinem Chef: gut verstehen.", options = listOf(), answers = listOf("Mit meinem Chef verstehe ich mich gut"), explain = "sich verstehen mit + Dativ."), Exercise(id = "de-foundations-u21-kollegen-e4", kind = "written", prompt = "Beschreibe die Atmosphäre an deiner Arbeit: positiv, aber mit einem Minus.", options = listOf(), answers = listOf("die atmosphäre ist gut aber manchmal stressig", "die atmosphaere ist gut aber manchmal stressig", "das team ist entspannt allerdings fordernd"), explain = "Positiv + aber/allerdings + Minus: die ehrliche Beschreibung.")), skills = listOf("function:talk-about-work", "vocab:work", "function:describe-people", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "de-foundations-u21-ziele", title = "Berufsziele", goal = "Pläne und Ziele formulieren: mein Ziel ist es, … zu werden, ich würde gern, ich will … erreichen.", intro = LessonIntro(explanation = listOf("Ziele fest benennen: « Mein Ziel ist es, Teamleiterin zu werden. » — es + zu + Infinitiv am Ende.", "Wünsche klingen weicher mit würde gern: « Ich würde gern ein eigenes Projekt leiten. »", "Erreichen braucht einen Weg: « Dafür muss ich noch viel lernen » — dafür verbindet Ziel und Weg."), examples = listOf(ExampleLine(text = "Mein Ziel ist es, Teamleiterin zu werden.", meaning = "Ziel mit es + zu + Infinitiv."), ExampleLine(text = "Diese Position will ich in fünf Jahren erreichen.", meaning = "erreichen + Ziel."), ExampleLine(text = "Ich würde gern ein eigenes Projekt leiten.", meaning = "würde gern: der weiche Wunsch."), ExampleLine(text = "Dafür muss ich noch einiges lernen.", meaning = "dafür verbindet Ziel und Weg."), ExampleLine(text = "In fünf Jahren sehe ich mich in einer Führungsrolle.", meaning = "Blick in die Zukunft."))), expressions = listOf(TargetExpression(text = "Mein Ziel ist es, … zu + Infinitiv", meaning = "Ziel benennen.", note = "… Teamleiterin zu werden."), TargetExpression(text = "ich würde gern …", meaning = "Wunsch, weich.", note = "Ich würde gern ein Projekt leiten."), TargetExpression(text = "… erreichen", meaning = "Das Ziel erreichen.", note = "Diese Position will ich erreichen."), TargetExpression(text = "dafür", meaning = "Ziel + Weg verbinden.", note = "Dafür lerne ich weiter."), TargetExpression(text = "in fünf Jahren", meaning = "Zeithorizont.", note = "In fünf Jahren sehe ich mich …")), situation = "Auf die Frage nach fünf Jahren antwortet Lena ruhig: ihr Ziel ist eine Führungsrolle, sie würde gern ein eigenes Projekt leiten — dafür nimmt sie noch ein Weiterbildungsseminar.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Benenne dein Ziel: Teamleiterin werden.", expected = listOf("Mein Ziel ist es, Teamleiterin zu werden.", "mein ziel ist es teamleiterin zu werden"), focus = "mein ziel", watch = "es + zu + Infinitiv."), PracticeQuestion(prompt = "Sag deinen Wunsch weich: ein eigenes Projekt leiten.", expected = listOf("Ich würde gern ein eigenes Projekt leiten.", "ich würde gern ein eigenes projekt leiten", "ich wuerde gern ein eigenes projekt leiten"), focus = "würde gern", watch = "würde gern + Infinitiv."), PracticeQuestion(prompt = "Sag, welche Position du erreichen willst: diese Position.", expected = listOf("Ich will diese Position erreichen.", "ich will diese position erreichen", "Ich möchte diese Position erreichen."), focus = "erreichen", watch = "erreichen = das Ziel bekommen."), PracticeQuestion(prompt = "Verbinde Ziel und Weg: dafür musst du lernen.", expected = listOf("Dafür muss ich noch viel lernen.", "dafür muss ich noch viel lernen", "Dafür lerne ich weiter."), focus = "dafür", watch = "dafür = für dieses Ziel."), PracticeQuestion(prompt = "Sag, wo du in fünf Jahren sein willst: in einer Führungsrolle.", expected = listOf("In fünf Jahren sehe ich mich in einer Führungsrolle.", "in fünf jahren sehe ich mich in einer führungsrolle", "In fünf Jahren will ich eine Führungsrolle haben."), focus = "in fünf Jahren", watch = "Zeithorizont + Zukunft."))), exercises = listOf(Exercise(id = "de-foundations-u21-ziele-e1", kind = "choice", prompt = "« Mein ___ ist es, Projektmanagerin zu werden. »", options = listOf("Ziel", "Beruf", "Gehalt", "Chef"), answers = listOf("Ziel"), explain = "Das Ziel: Mein Ziel ist es, … zu werden."), Exercise(id = "de-foundations-u21-ziele-e2", kind = "gap", prompt = "Ich ___ gern ein eigenes Team leiten.", options = listOf(), answers = listOf("würde"), explain = "würde gern + Infinitiv: der weiche Wunsch."), Exercise(id = "de-foundations-u21-ziele-e3", kind = "order", prompt = "Sag deinen Wunsch: du möchtest ein eigenes Projekt leiten. (würde gern)", options = listOf(), answers = listOf("Ich würde gern ein eigenes Projekt leiten"), explain = "würde gern + Infinitiv am Satzende."), Exercise(id = "de-foundations-u21-ziele-e4", kind = "written", prompt = "Nenne dein Berufsziel für die nächsten fünf Jahre.", options = listOf(), answers = listOf("in fünf jahren will ich teamleiterin sein", "in funf jahren will ich teamleiter sein", "ich will eine führungsrolle erreichen", "ich will eine fuhrungsrolle erreichen"), explain = "Ziel + Zeithorizont: so antwortet man im Gespräch.")), skills = listOf("function:describe-goals", "function:talk-about-work", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors"))))
}

object DeFoundationsU26 {
    val unit = CourseUnit(id = "de-foundations-u26", title = "Die Stadt, die ich will", subtitle = "Meinungen zum Viertel", level = "B1", themes = listOf(ConversationTheme("mein-traumviertel", "Mein Traumviertel", "Was fehlt der Stadt ?", "building.2", "Course", "Verkehr, Miete, Lärm: Marla und Jonas diskutieren, welches Viertel lebenswerter werden könnte.", 0),
                ConversationTheme("gruen-im-viertel", "Grün im Viertel", "Bäume statt Parkplätze", "leaf", "Course", "Ein Park statt eines Parkhauses ? Bewusst einkaufen, weniger Müll — Argumente fürs Viertel.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u26-meinung", title = "Einerseits … andererseits", goal = "Differenziert Meinung sagen: mit einerseits/andererseits zeigst du beide Seiten eines Arguments.", intro = LessonIntro(explanation = listOf("Beide Seiten sehen: « Einerseits ist der Verkehr praktisch, andererseits ist er laut. » — so klingt deine Meinung ausgewogen.", "Position klar sagen: « Meiner Meinung nach braucht das Viertel mehr Grün. » — nach + Dativ, danach Hauptsatz.", "Begründen mit dass: « Ich finde, dass man den Verkehr beruhigen sollte. » — das Verb steht ganz am Ende."), examples = listOf(ExampleLine(text = "Einerseits praktisch, andererseits laut.", meaning = "Beide Seiten in einem Satz."), ExampleLine(text = "Meiner Meinung nach fehlt hier Grün.", meaning = "Position mit Dativ."), ExampleLine(text = "Ich bin der Meinung, dass das Viertel lebenswerter werden kann.", meaning = "Die formelle Meinung."), ExampleLine(text = "Ich finde, dass die Straßen zu voll sind.", meaning = "dass + Verb am Ende."), ExampleLine(text = "Da bin ich anderer Meinung.", meaning = "Höflich widersprechen."))), expressions = listOf(TargetExpression(text = "einerseits … andererseits …", meaning = "Zwei Seiten, ein Satz.", note = "Einerseits teuer, andererseits zentral."), TargetExpression(text = "meiner Meinung nach", meaning = "Position zeigen.", note = "nach + Dativ: meiner Meinung nach"), TargetExpression(text = "Ich bin der Meinung, dass …", meaning = "Klare Position.", note = "Verb am Satzende"), TargetExpression(text = "Ich finde, dass …", meaning = "Persönliche Sicht.", note = "Ich finde, dass es passt."), TargetExpression(text = "Da bin ich anderer Meinung.", meaning = "Widersprechen, höflich.", note = "Dann kommt dein Grund.")), situation = "Stadtteilrunde: Marla findet das Viertel lebendig, aber zu laut. « Einerseits habe ich alles um die Ecke, andererseits schlafe ich bei offenem Fenster schlecht. » Jonas widerspricht höflich — und nennt seine Gründe.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Zeig beide Seiten: praktisch, aber laut. (einerseits/andererseits)", expected = listOf("Einerseits ist es praktisch, andererseits ist es laut.", "einerseits ist es praktisch andererseits ist es laut", "Einerseits praktisch, andererseits laut."), focus = "einerseits andererseits", watch = "Zwei Seiten in einem Satz."), PracticeQuestion(prompt = "Sag deine Position: das Viertel braucht mehr Grün. (meiner Meinung nach)", expected = listOf("Meiner Meinung nach braucht das Viertel mehr Grün.", "meiner meinung nach braucht das viertel mehr grün", "meiner meinung nach braucht das viertel mehr gruen", "Meiner Meinung nach fehlt hier Grün."), focus = "meiner meinung nach", watch = "nach + Dativ: meiner Meinung nach."), PracticeQuestion(prompt = "Sag mit dass: die Straßen sind zu voll.", expected = listOf("Ich finde, dass die Straßen zu voll sind.", "ich finde dass die strassen zu voll sind", "ich finde dass die straßen zu voll sind"), focus = "dass", watch = "dass-Satz: Verb ganz am Ende."), PracticeQuestion(prompt = "Widersprich höflich.", expected = listOf("Da bin ich anderer Meinung.", "da bin ich anderer meinung", "Ich sehe das anders."), focus = "anderer meinung", watch = "Höflich widersprechen + Grund."), PracticeQuestion(prompt = "Formuliere formell: das Bezirksamt soll handeln. (Meinung, dass)", expected = listOf("Ich bin der Meinung, dass das Bezirksamt handeln sollte.", "ich bin der meinung dass das bezirksamt handeln sollte", "Ich bin der Meinung, dass die Stadt handeln sollte."), focus = "der meinung dass", watch = "dass-Satz: Verb am Ende."))), exercises = listOf(Exercise(id = "de-foundations-u26-meinung-e1", kind = "choice", prompt = "« Einerseits zentral, ___ sehr laut. »", options = listOf("andererseits", "anderseits", "andersseits", "anderenfalls"), answers = listOf("andererseits"), explain = "einerseits … andererseits: die zwei Seiten."), Exercise(id = "de-foundations-u26-meinung-e2", kind = "gap", prompt = "Meiner Meinung ___ fehlt hier Grün.", options = listOf(), answers = listOf("nach"), explain = "meiner Meinung nach + Hauptsatz."), Exercise(id = "de-foundations-u26-meinung-e3", kind = "order", prompt = "Sag mit dass: der Verkehr sollte beruhigt werden.", options = listOf(), answers = listOf("Ich finde dass der Verkehr beruhigt werden sollte"), explain = "dass-Satz: Verb ganz am Ende."), Exercise(id = "de-foundations-u26-meinung-e4", kind = "written", prompt = "Nenne deine Meinung zum Viertel mit einer Begründung.", options = listOf(), answers = listOf("meiner meinung nach braucht das viertel mehr grün", "meiner meinung nach braucht das viertel mehr gruen", "ich finde dass die straßen zu voll sind", "ich finde dass die strassen zu voll sind", "meiner meinung nach fehlt hier grün", "meiner meinung nach fehlt hier gruen"), explain = "Position + Grund: so klingt eine überzeugende Meinung.")), skills = listOf("grammar:connectors", "function:express-opinion", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "de-foundations-u26-vorschlag", title = "Vorschläge fürs Viertel", goal = "Vorschläge machen: Man sollte … — mit Vergleich und Begründung überzeugst du die Runde.", intro = LessonIntro(explanation = listOf("Vorschläge mit sollte: « Man sollte mehr Radwege bauen. » — sollte + Infinitiv am Ende, klingt konstruktiv.", "Offiziell vorschlagen: « Ich schlage vor, dass wir einen Markttag starten. » — dass + Verb ganz am Ende.", "Vergleichen, um zu überzeugen: « Ein Park wäre besser als ein Parkhaus. » — wäre ist der weiche Konjunktiv."), examples = listOf(ExampleLine(text = "Man sollte mehr Bäume pflanzen.", meaning = "Der Vorschlag mit sollte."), ExampleLine(text = "Die Stadt sollte den Verkehr beruhigen.", meaning = "sollte + Infinitiv am Ende."), ExampleLine(text = "Ich schlage vor, dass wir einen Markttag starten.", meaning = "Vorschlag mit dass."), ExampleLine(text = "Ein Park wäre besser als ein Parkhaus.", meaning = "Vergleich mit wäre."), ExampleLine(text = "Warum genau ein Park ?", meaning = "Nachfragen und stärken."))), expressions = listOf(TargetExpression(text = "Man sollte …", meaning = "Der Grund-Vorschlag.", note = "Man sollte mehr Grün schaffen."), TargetExpression(text = "Ich schlage vor, dass …", meaning = "Offiziell vorschlagen.", note = "dass + Verb am Ende"), TargetExpression(text = "… wäre besser als …", meaning = "Vergleich, weich.", note = "Ein Park wäre günstiger."), TargetExpression(text = "Warum genau … ?", meaning = "Nachfragen.", note = "Warum genau ein Park ?"), TargetExpression(text = "Einverstanden !", meaning = "Zustimmen.", note = "Dann planen wir weiter.")), situation = "Jonas will den alten Parkplatz in einen Park verwandeln. « Ich schlage vor, dass die Stadt dort Bäume und Bänke baut — ein Park wäre besser als ein Parkhaus. » Marla ist einverstanden, fragt aber nach den Kosten.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Schlage vor: mehr Radwege bauen. (man sollte)", expected = listOf("Man sollte mehr Radwege bauen.", "man sollte mehr radwege bauen"), focus = "man sollte", watch = "sollte + Infinitiv am Ende."), PracticeQuestion(prompt = "Schlage vor: die Stadt saniert den Markt. (ich schlage vor, dass)", expected = listOf("Ich schlage vor, dass die Stadt den Markt saniert.", "ich schlage vor dass die stadt den markt saniert"), focus = "ich schlage vor", watch = "trennbar: schlage … vor + dass."), PracticeQuestion(prompt = "Vergleiche weich: ein Park ist besser als ein Parkhaus. (wäre)", expected = listOf("Ein Park wäre besser als ein Parkhaus.", "ein park wäre besser als ein parkhaus", "Ein Park wäre schöner als ein Parkhaus.", "ein park wäre schoener als ein parkhaus"), focus = "wäre", watch = "wäre: der weiche Vergleich im Konjunktiv."), PracticeQuestion(prompt = "Frag nach dem Grund: genau ein Park ?", expected = listOf("Warum genau ein Park ?", "warum genau ein park", "Warum genau dort ?"), focus = "warum genau", watch = "Nachfragen zeigt Interesse."), PracticeQuestion(prompt = "Stimme dem Vorschlag zu.", expected = listOf("Einverstanden.", "einverstanden", "Einverstanden, machen wir !"), focus = "einverstanden", watch = "Einverstanden = ich stimme zu."))), exercises = listOf(Exercise(id = "de-foundations-u26-vorschlag-e1", kind = "choice", prompt = "« Man ___ hier mehr Bäume pflanzen. »", options = listOf("sollte", "soll", "will", "mag"), answers = listOf("sollte"), explain = "Vorschlag: man sollte + Infinitiv."), Exercise(id = "de-foundations-u26-vorschlag-e2", kind = "gap", prompt = "Ich schlage ___, dass wir einen Markttag starten.", options = listOf(), answers = listOf("vor"), explain = "trennbar: vorschlagen → schlage … vor."), Exercise(id = "de-foundations-u26-vorschlag-e3", kind = "order", prompt = "Sag weich: der Park ist besser als das Parkhaus. (wäre)", options = listOf(), answers = listOf("Ein Park wäre besser als ein Parkhaus"), explain = "wäre + Komparativ + als."), Exercise(id = "de-foundations-u26-vorschlag-e4", kind = "written", prompt = "Mach einen Vorschlag für dein Viertel.", options = listOf(), answers = listOf("man sollte mehr bänke aufstellen", "man sollte mehr baenke aufstellen", "ich schlage vor dass wir einen markttag starten", "man sollte den verkehr beruhigen"), explain = "Vorschlag + Begründung: Man sollte …")), skills = listOf("function:express-opinion", "grammar:connectors", "speaking:justify-opinion", "grammar:comparatives"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "de-foundations-u26-konsum", title = "Bewusst konsumieren", goal = "Argumentieren beim Konsum: erstens, außerdem, insgesamt — schriftlich und mündlich überzeugen.", intro = LessonIntro(explanation = listOf("Argumente gliedern: « Erstens spart man Geld, außerdem produziert man weniger Müll. » — so baut man einen Text auf.", "Vergleiche als Beleg: « Gebrauchte Möbel sind oft besser verarbeitet. » — der Komparativ macht das Argument konkret.", "Fazit mit insgesamt: « Insgesamt ist Second-Hand die bessere Wahl. » — so schließt man ab."), examples = listOf(ExampleLine(text = "Ich kaufe bewusst Second-Hand.", meaning = "Der bewusste Konsum."), ExampleLine(text = "Erstens spart man Geld.", meaning = "Das erste Argument."), ExampleLine(text = "Außerdem produziert man weniger Müll.", meaning = "Das nächste Argument."), ExampleLine(text = "Gebrauchte Möbel sind oft besser verarbeitet.", meaning = "Beleg mit Vergleich."), ExampleLine(text = "Insgesamt ist das die bessere Wahl.", meaning = "Das Fazit."))), expressions = listOf(TargetExpression(text = "bewusst konsumieren", meaning = "Mit Absicht kaufen.", note = "Weniger, aber besser."), TargetExpression(text = "erstens / zweitens", meaning = "Argumente ordnen.", note = "Erstens Zeit, zweitens Geld."), TargetExpression(text = "außerdem", meaning = "Hinzufügen.", note = "Außerdem spart man Ressourcen."), TargetExpression(text = "insgesamt", meaning = "Das Fazit.", note = "Insgesamt überwiegen die Vorteile."), TargetExpression(text = "die bessere Wahl", meaning = "Vergleich als Urteil.", note = "Second-Hand ist die bessere Wahl.")), situation = "Fürs Stadtteilblatt schreibt Marla einen Text: Reparatur-Café statt Kaufhauskette. « Erstens Geld, außerdem Müll, insgesamt: die bessere Wahl » — ihre drei Schritte im Argument.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Nenn dein erstes Argument: man spart Geld. (erstens)", expected = listOf("Erstens spart man Geld.", "erstens spart man geld", "Erstens: man spart Geld."), focus = "erstens", watch = "erstens ordnet das erste Argument."), PracticeQuestion(prompt = "Füge hinzu: man produziert weniger Müll. (außerdem)", expected = listOf("Außerdem produziert man weniger Müll.", "außerdem produziert man weniger müll", "ausserdem produziert man weniger muell"), focus = "außerdem", watch = "außerdem fügt das nächste Argument an."), PracticeQuestion(prompt = "Belege mit einem Vergleich: gebrauchte Möbel, gut verarbeitet.", expected = listOf("Gebrauchte Möbel sind oft besser verarbeitet.", "gebrauchte möbel sind oft besser verarbeitet", "Second-Hand ist oft besser verarbeitet."), focus = "besser verarbeitet", watch = "Komparativ als Beleg."), PracticeQuestion(prompt = "Fasse zusammen: Second-Hand ist die bessere Wahl. (insgesamt)", expected = listOf("Insgesamt ist Second-Hand die bessere Wahl.", "insgesamt ist second-hand die bessere wahl", "Insgesamt ist Second Hand die bessere Wahl."), focus = "insgesamt", watch = "insgesamt leitet das Fazit ein."), PracticeQuestion(prompt = "Sag den Satz komplett: du kaufst bewusst Second-Hand.", expected = listOf("Ich kaufe bewusst Second-Hand.", "ich kaufe bewusst second-hand", "Ich kaufe bewusst gebrauchte Sachen."), focus = "bewusst", watch = "bewusst = mit Absicht."))), exercises = listOf(Exercise(id = "de-foundations-u26-konsum-e1", kind = "choice", prompt = "« ___ produziert man weniger Müll. »", options = listOf("Außerdem", "Gegenüber", "Während", "Dennoch"), answers = listOf("Außerdem"), explain = "außerdem fügt ein weiteres Argument hinzu."), Exercise(id = "de-foundations-u26-konsum-e2", kind = "gap", prompt = "Erstens ___ man Geld, zweitens Zeit.", options = listOf(), answers = listOf("spart"), explain = "Argument + Verb: erstens spart man …"), Exercise(id = "de-foundations-u26-konsum-e3", kind = "order", prompt = "Leite dein Fazit ein: Second-Hand ist die bessere Wahl. (insgesamt)", options = listOf(), answers = listOf("Insgesamt ist Second-Hand die bessere Wahl"), explain = "insgesamt + Fazitsatz."), Exercise(id = "de-foundations-u26-konsum-e4", kind = "written", prompt = "Schreib einen Argumentsatz für bewussten Konsum.", options = listOf(), answers = listOf("gebrauchte sachen sind günstiger und nachhaltiger", "gebrauchte sachen sind guenstiger und nachhaltiger", "man sollte weniger und bewusster kaufen", "second-hand spart geld und schützt die umwelt", "second-hand spart geld und schuetzt die umwelt"), explain = "Argument + Beleg: so startet ein Text.")), skills = listOf("writing:argument", "function:express-opinion", "grammar:connectors", "grammar:comparatives"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors"))))
}

object DeFoundationsU7 {
    val unit = CourseUnit(id = "de-foundations-u7", title = "Meinungen und Nuancen", subtitle = "Wenn ich hätte…", level = "B2", themes = listOf(ConversationTheme("de-b2-hypothese", "Unmögliche Pläne", "Wenn ich Zeit hätte", "sparkles", "Course", "Ihr debattiert, was ihr mit unendlich viel Zeit machen würdet, dann ein echter Kompromiss.", 0),
                ConversationTheme("de-b2-handel", "Das Feilschen", "Wären Sie bei 50 dabei ?", "handshake", "Course", "Ihr verhandelt einen Gebrauchtkauf: Angebot, Bedingungen, Abschluss.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u7-hypothetisch", title = "Wenn ich Zeit hätte…", goal = "Über das Irreale sprechen: wenn + Konjunktiv II (hätte/käme), dann würde + Infinitiv.", intro = LessonIntro(explanation = listOf("Die irrealen Bedingung: « Wenn ich mehr Zeit hätte, würde ich mehr reisen ». wenn + Konjunktiv II (hätte), dann würde + Infinitiv.", "Bei haben/sein oft ohne würde: « Wenn ich Zeit hätte… », « Wenn ich dort wäre… ».", "So klingen Ratschläge höflich: « An deiner Stelle würde ich es versuchen »."), examples = listOf(ExampleLine(text = "Wenn ich mehr Zeit hätte, würde ich mehr reisen.", meaning = "Irrealis der Gegenwart."), ExampleLine(text = "An deiner Stelle würde ich es versuchen.", meaning = "Höflicher Rat."), ExampleLine(text = "Wenn ich könnte, würde ich den Job wechseln.", meaning = "können → könnte."), ExampleLine(text = "Würdest du dich am Freitag treffen ?", meaning = "Vorsichtiger Vorschlag."), ExampleLine(text = "Nicht, dass ich nicht will – ich könnte nicht.", meaning = "Nuance wollen/können."))), expressions = listOf(TargetExpression(text = "wenn … hätte/käme, …", meaning = "Irrealis.", note = "Wenn ich Zeit hätte…"), TargetExpression(text = "würde + Infinitiv", meaning = "Konjunktiv II.", note = "…würde ich reisen."), TargetExpression(text = "könnte / wäre / hätte", meaning = "starke Formen.", note = "Wenn ich könnte…"), TargetExpression(text = "an deiner Stelle würde ich…", meaning = "Rat.", note = "…es versuchen."), TargetExpression(text = "wenn wir…-en … ?", meaning = "Vorschlag.", note = "Wenn wir es probierten ?")), situation = "Ihr debattiert unmögliche Pläne: mehr Zeit, ein anderer Job, eine andere Stadt – dann ein echter Kompromiss für diesen Monat.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Deine Hypothese: wenn du mehr Zeit hättest, würdest du mehr reisen.", expected = listOf("Wenn ich mehr Zeit hatte wurde ich mehr reisen", "Wenn ich mehr Zeit hätte, würde ich mehr reisen"), focus = "wenn + Konjunktiv II", watch = "hätte… würde + Infinitiv."), PracticeQuestion(prompt = "Höflicher Rat: an deiner Stelle würde ich es versuchen.", expected = listOf("An deiner Stelle wurde ich es versuchen", "An deiner Stelle würde ich es versuchen"), focus = "an deiner Stelle", watch = "…würde ich + Infinitiv."), PracticeQuestion(prompt = "Sag, dass du, wenn du könntest, den Job wechseln würdest.", expected = listOf("Wenn ich konnte wurde ich den Job wechseln", "Wenn ich könnte, würde ich den Job wechseln"), focus = "könnte/würde", watch = "Wenn ich könnte… würde ich…"), PracticeQuestion(prompt = "Vorschlag: würdest du dich am Freitag treffen ?", expected = listOf("Wurdest du dich am Freitag treffen", "Würdest du dich am Freitag treffen ?"), focus = "würdest du", watch = "Frage mit Konjunktiv II."), PracticeQuestion(prompt = "Nuance: nicht, dass ich nicht will – ich könnte nicht.", expected = listOf("Nicht dass ich nicht will ich konnte nicht", "Nicht, dass ich nicht will – ich könnte nicht"), focus = "nicht, dass", watch = "Kontrast wollen/können."))), exercises = listOf(Exercise(id = "de-foundations-u7-hypothetisch-e1", kind = "choice", prompt = "Wenn ich mehr Zeit ___, würde ich mehr reisen.", options = listOf("hätte", "habe", "hatte", "haben würde"), answers = listOf("hätte"), explain = "Konjunktiv II von haben: hätte."), Exercise(id = "de-foundations-u7-hypothetisch-e2", kind = "gap", prompt = "Wenn ich könnte, ___ ich den Job wechseln. (werden)", options = listOf(), answers = listOf("würde", "wuerde"), explain = "würde + Infinitiv am Satzende-Bereich."), Exercise(id = "de-foundations-u7-hypothetisch-e3", kind = "order", prompt = "Rat: an deiner Stelle würde ich es versuchen.", options = listOf(), answers = listOf("An deiner Stelle würde ich es versuchen"), explain = "an deiner Stelle + würde."), Exercise(id = "de-foundations-u7-hypothetisch-e4", kind = "written", prompt = "Deine Hypothese: wenn du könntest, würdest du den Job wechseln.", options = listOf(), answers = listOf("wenn ich konnte wurde ich den job wechseln", "wenn ich könnte, würde ich den job wechseln", "wenn ich konnte wurde ich den job wechseln"), explain = "Wenn + Konjunktiv II + würde.")), skills = listOf("grammar:second-conditional", "function:express-opinion", "speaking:justify-opinion", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:past-simple-irregular", "grammar:connectors")),
    Lesson(id = "de-foundations-u7-register", title = "Man sagt…", goal = "Wiedergeben, was andere behaupten: unpersönlich mit « man » und Passiv mit « werden ».", intro = LessonIntro(explanation = listOf("Unpersönlich: « Man sagt, dass sich das Viertel ändert ». Niemand tritt als Quelle auf.", "Passiv: « Das Konzert wurde abgesagt », « Die Tickets sind ausverkauft ». Sprach der Nachrichten.", "Das Passiv (wurde + Partizip II) hebt das Register; « man » bleibt Alltag."), examples = listOf(ExampleLine(text = "Man sagt, dass sich das Viertel ändert.", meaning = "Unpersönlich: Gerücht."), ExampleLine(text = "Das Konzert wurde wegen des Regens abgesagt.", meaning = "Passiv Präteritum."), ExampleLine(text = "Die Tickets sind ausverkauft.", meaning = "Zustandspassiv (sein)."), ExampleLine(text = "Alle Züge wurden gestrichen.", meaning = "Offizielle Meldung."), ExampleLine(text = "Laut Rathaus verzögern sich die Bauarbeiten.", meaning = "Quelle + Verb."))), expressions = listOf(TargetExpression(text = "man sagt, dass…", meaning = "Gerücht.", note = "…sich das Viertel ändert."), TargetExpression(text = "wurde + Partizip II", meaning = "Passiv.", note = "wurde abgesagt."), TargetExpression(text = "sind + Partizip II", meaning = "Zustand.", note = "sind ausverkauft."), TargetExpression(text = "laut + Quelle", meaning = "Zitieren.", note = "laut Rathaus."), TargetExpression(text = "es heißt, …", meaning = "Offiziell.", note = "es heißt, der Bau…")), situation = "Ihr besprecht die Nachrichten im Viertel: was man sagt, was beschlossen wurde und welcher Quelle ihr weniger vertraut.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Gib das Gerücht weiter: man sagt, dass sich das Viertel ändert.", expected = listOf("Man sagt dass sich das Viertel andert", "Man sagt, dass sich das Viertel ändert"), focus = "man sagt", watch = "Unpersönlich, kein Subjekt."), PracticeQuestion(prompt = "Meldung: das Konzert wurde wegen des Regens abgesagt.", expected = listOf("Das Konzert wurde wegen des Regens abgesagt"), focus = "wurde abgesagt", watch = "Passiv Präteritum."), PracticeQuestion(prompt = "Sag, dass die Tickets ausverkauft sind.", expected = listOf("Die Tickets sind ausverkauft"), focus = "sind ausverkauft", watch = "Zustandspassiv."), PracticeQuestion(prompt = "Nenne die Quelle: laut Rathaus verzögern sich die Bauarbeiten.", expected = listOf("Laut Rathaus verzogern sich die Bauarbeiten", "Laut Rathaus verzögern sich die Bauarbeiten"), focus = "laut", watch = "laut + Quelle."), PracticeQuestion(prompt = "Sag, dass alle Züge gestrichen wurden.", expected = listOf("Alle Zuge wurden gestrichen", "Alle Züge wurden gestrichen"), focus = "wurden gestrichen", watch = "Passiv Plural."))), exercises = listOf(Exercise(id = "de-foundations-u7-register-e1", kind = "choice", prompt = "___ sagt, dass sich das Viertel ändert.", options = listOf("Man", "Es", "Sie", "Das"), answers = listOf("Man"), explain = "Unpersönlich: man sagt."), Exercise(id = "de-foundations-u7-register-e2", kind = "gap", prompt = "Das Konzert wurde wegen des Regens ___. (absagen)", options = listOf(), answers = listOf("abgesagt"), explain = "wurde + Partizip II: abgesagt."), Exercise(id = "de-foundations-u7-register-e3", kind = "order", prompt = "Meldung: alle Züge wurden gestrichen.", options = listOf(), answers = listOf("Alle Züge wurden gestrichen"), explain = "Passiv Präteritum."), Exercise(id = "de-foundations-u7-register-e4", kind = "written", prompt = "Gerücht über den neuen Markt: du hast es gehört.", options = listOf(), answers = listOf("man sagt dass ein neuer markt aufmacht", "man sagt, dass ein neuer markt aufmacht"), explain = "Man sagt, dass…")), skills = listOf("grammar:passive-intro", "grammar:present-perfect", "function:express-opinion", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:past-simple-regular", "grammar:verb-be")),
    Lesson(id = "de-foundations-u7-verhandeln", title = "Wären Sie bei 50 dabei ?", goal = "Ein Abkommen verhandeln: vorschlagen mit Konjunktiv II, Bedingungen stellen, abschließen.", intro = LessonIntro(explanation = listOf("Vorschlagen: « Wären Sie bei 50 dabei ? », « Ich würde Ihnen 60 geben, wenn Sie den Transport übernehmen ».", "Bedingungen: « Nur wenn es heute geliefert wird », « Im Gegenzug möchte ich die Garantie ».", "Abschließen: « Abgemacht », « Einverstanden – aber unter einer Bedingung »."), examples = listOf(ExampleLine(text = "Wären Sie bei 50 dabei ?", meaning = "Vorschlag mit Konjunktiv."), ExampleLine(text = "Ich würde 60 geben, wenn Sie transportieren.", meaning = "würde + wenn + Gegenwart."), ExampleLine(text = "Nur wenn es heute kommt.", meaning = "Harte Bedingung."), ExampleLine(text = "Im Gegenzug die Garantie.", meaning = "Gegenvorschlag."), ExampleLine(text = "Abgemacht.", meaning = "Abschluss."))), expressions = listOf(TargetExpression(text = "wären Sie bei … dabei ?", meaning = "Vorschlagen.", note = "…bei 50 ?"), TargetExpression(text = "ich würde …, wenn …", meaning = "Bedingungen.", note = "…60 geben, wenn…"), TargetExpression(text = "nur wenn…", meaning = "Harte Bedingung.", note = "nur wenn heute."), TargetExpression(text = "im Gegenzug, …", meaning = "Gegenvorschlag.", note = "…die Garantie."), TargetExpression(text = "abgemacht", meaning = "Abschließen.", note = "nach der Einigung.")), situation = "Ihr feilscht um einen Gebrauchtisch: hoher Auftakt, Bedingungen, Treffpunkt in der Mitte.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Schlage vor: wären Sie bei 50 dabei ?", expected = listOf("Waren Sie bei 50 dabei", "Wären Sie bei 50 dabei ?"), focus = "wären Sie", watch = "Konjunktiv II: wären."), PracticeQuestion(prompt = "Bedingtes Angebot: ich würde Ihnen 60 geben, wenn Sie den Transport übernehmen.", expected = listOf("Ich wurde ihnen 60 geben wenn sie den transport ubernehmen", "Ich würde Ihnen 60 geben, wenn Sie den Transport übernehmen"), focus = "würde…wenn", watch = "würde + wenn + Gegenwart."), PracticeQuestion(prompt = "Harte Bedingung: nur wenn es heute geliefert wird.", expected = listOf("Nur wenn es heute geliefert wird"), focus = "nur wenn", watch = "nur wenn + Passiv."), PracticeQuestion(prompt = "Gegenvorschlag: im Gegenzug möchte ich die Garantie.", expected = listOf("Im Gegenzug mochte ich die garantie", "Im Gegenzug möchte ich die Garantie"), focus = "im Gegenzug", watch = "Im Gegenzug + wollen."), PracticeQuestion(prompt = "Schließt den Deal ab.", expected = listOf("Abgemacht", "Abgemacht !", "Abgemacht."), focus = "abgemacht", watch = "Feste Abschlussformel."))), exercises = listOf(Exercise(id = "de-foundations-u7-verhandeln-e1", kind = "choice", prompt = "___ Sie bei 50 dabei ?", options = listOf("Wären", "Sind", "Waren", "Werden"), answers = listOf("Wären"), explain = "Konjunktiv II von sein: wären."), Exercise(id = "de-foundations-u7-verhandeln-e2", kind = "gap", prompt = "Ich ___ Ihnen 60 geben, wenn Sie transportieren. (werden)", options = listOf(), answers = listOf("würde", "wuerde"), explain = "würde + Infinitiv."), Exercise(id = "de-foundations-u7-verhandeln-e3", kind = "order", prompt = "Bedingung: nur wenn es heute geliefert wird.", options = listOf(), answers = listOf("Nur wenn es heute geliefert wird"), explain = "nur wenn + Passiv."), Exercise(id = "de-foundations-u7-verhandeln-e4", kind = "written", prompt = "Schließt den Deal ab, aber mit Vorbehalt.", options = listOf(), answers = listOf("einverstanden aber unter einer bedingung", "einverstanden, aber unter einer bedingung"), explain = "Einverstanden, aber…")), skills = listOf("function:negotiate", "grammar:second-conditional", "speaking:negotiate", "grammar:connectors"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors"))))
}

object DeFoundationsU8 {
    val unit = CourseUnit(id = "de-foundations-u8", title = "Medien und Argument", subtitle = "Die Nachricht, die…", level = "B2", themes = listOf(ConversationTheme("de-b2-nachrichten", "Nachrichtenwoche", "Was gesagt wurde", "newspaper", "Course", "Ihr fasst die Woche mit Relativsätzen zusammen: wer, wo, was.", 0),
                ConversationTheme("de-b2-kolumne", "Deine Kolumne", "Einerseits… andererseits…", "pencil", "Course", "Ihr schreibt eine Kolumne über die autofreie Innenstadt.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u7-relativsaetze", title = "Die Nachricht, die ich gelesen habe", goal = "Nachrichten mit Relativsätzen erzählen: der/die/das, wo, deren.", intro = LessonIntro(explanation = listOf("Der Relativsatz passt sich an: « Die Nachricht, die ich gelesen habe… », « Der Journalist, der ihn interviewt hat… ».", "« Wo » für Orte: « Der Platz, wo sie demonstriert haben ». « Deren » für Besitz: « Die Firma, deren Chef zurückgetreten ist ».", "In Nachrichten verdichten Relativsätze: wer, wo, was."), examples = listOf(ExampleLine(text = "Die Nachricht, die ich gelesen habe, sagt…", meaning = "Relativsatz (Objekt)."), ExampleLine(text = "Der Journalist, der ihn interviewt hat, trat zurück.", meaning = "Relativsatz (Subjekt)."), ExampleLine(text = "Der Platz, wo sie demonstriert haben, ist zentral.", meaning = "wo + Ort."), ExampleLine(text = "Die Firma, deren Chef zurücktrat, reagierte.", meaning = "deren = Besitz."), ExampleLine(text = "Alles, was ich weiß, kommt vom Radio.", meaning = "alles, was + Verb."))), expressions = listOf(TargetExpression(text = "der/die/das … , der/die/das …", meaning = "Relativpronomen.", note = "die Nachricht, die…"), TargetExpression(text = "… , wo …", meaning = "Ort.", note = "der Platz, wo…"), TargetExpression(text = "deren + Nomen", meaning = "Besitz.", note = "die Firma, deren Chef…"), TargetExpression(text = "alles, was…", meaning = "Verallgemeinern.", note = "alles, was ich weiß."), TargetExpression(text = "Komma vor Relativsatz", meaning = "Rechtschreibung.", note = "immer mit Komma.")), situation = "Ihr fasst eine Nachrichtewoche zusammen: die Story, die euch traf, die Person, die sprach, und der Ort, wo es passierte.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Fasse zusammen: die Nachricht, die ich gelesen habe, sagt, dass das Museum longer öffnet.", expected = listOf("Die Nachricht die ich gelesen habe sagt dass das museum langer offnet", "Die Nachricht, die ich gelesen habe, sagt, dass das Museum länger öffnet"), focus = "die ich gelesen habe", watch = "Relativsatz zur Nachricht."), PracticeQuestion(prompt = "Wer: der Journalist, der ihn interviewt hat, trat zurück.", expected = listOf("Der Journalist der ihn interviewt hat trat zuruck", "Der Journalist, der ihn interviewt hat, trat zurück"), focus = "der ihn interviewt hat", watch = "Relativsatz Subjekt."), PracticeQuestion(prompt = "Ort: der Platz, wo sie demonstriert haben, ist zentral.", expected = listOf("Der Platz wo sie demonstriert haben ist zentral", "Der Platz, wo sie demonstriert haben, ist zentral"), focus = "wo", watch = "wo + Ort."), PracticeQuestion(prompt = "Besitz: die Firma, deren Chef zurücktrat, reagierte.", expected = listOf("Die Firma deren Chef zurucktrat reagierte", "Die Firma, deren Chef zurücktrat, reagierte"), focus = "deren", watch = "deren + Nomen."), PracticeQuestion(prompt = "Verallgemeinere: alles, was ich weiß, kommt vom Radio.", expected = listOf("Alles was ich weiss kommt vom radio", "Alles, was ich weiß, kommt vom Radio"), focus = "alles, was", watch = "alles, was + Verb."))), exercises = listOf(Exercise(id = "de-foundations-u7-relativsaetze-e1", kind = "choice", prompt = "Die Nachricht, ___ ich gelesen habe, ist wichtig.", options = listOf("die", "der", "das", "den"), answers = listOf("die"), explain = "die Nachricht (fem): die."), Exercise(id = "de-foundations-u7-relativsaetze-e2", kind = "gap", prompt = "Der Platz, ___ sie demonstriert haben, ist zentral.", options = listOf(), answers = listOf("wo"), explain = "Ort: wo + Relativsatz, immer mit Komma davor."), Exercise(id = "de-foundations-u7-relativsaetze-e3", kind = "order", prompt = "Subjekt: der Journalist, der ihn interviewt hat, trat zurück.", options = listOf(), answers = listOf("Der Journalist, der ihn interviewt hat, trat zurück"), explain = "Relativsatz Subjekt."), Exercise(id = "de-foundations-u7-relativsaetze-e4", kind = "written", prompt = "Deine Nachricht: die Nachricht, die ich gelesen habe, sagt, dass die Straße geschlossen wird.", options = listOf(), answers = listOf("die nachricht die ich gelesen habe sagt dass die strasse geschlossen wird", "die nachricht, die ich gelesen habe, sagt, dass die strasse geschlossen wird"), explain = "Relativsatz + Passiv.")), skills = listOf("grammar:relative-clauses", "grammar:present-perfect", "function:express-opinion", "vocab:work"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:present-perfect")),
    Lesson(id = "de-foundations-u7-argumentieren", title = "Einerseits… andererseits…", goal = "Eine Meinung strukturiert schreiben und verteidigen: These, Argumente, Einräumung, Schluss.", intro = LessonIntro(explanation = listOf("Struktur: These (« Ich finde, wir sollten die Innenstadt autofrei machen »), Argumente (« einerseits…, andererseits… »), Einräumung (« es stimmt, dass…, aber… »).", "Die Einräumung schafft Glaubwürdigkeit: du erkennst die Gegenseite an, bevor du antwortest.", "Schluss mit Gewicht: « Aus all dem verteidige ich die Maßnahme »."), examples = listOf(ExampleLine(text = "Ich finde, wir sollten die Innenstadt autofrei machen.", meaning = "These."), ExampleLine(text = "Einerseits sinkt die Verschmutzung.", meaning = "Argument 1."), ExampleLine(text = "Andererseits leidet der Handel.", meaning = "Argument 2 (gegen)."), ExampleLine(text = "Es stimmt, dass es unbequem ist, aber die Zahlen sagen etwas anderes.", meaning = "Einräumung + Antwort."), ExampleLine(text = "Aus all dem verteidige ich die Maßnahme.", meaning = "Schluss."))), expressions = listOf(TargetExpression(text = "ich finde, wir sollten…", meaning = "These.", note = "…autofrei machen."), TargetExpression(text = "einerseits… andererseits…", meaning = "Argumente.", note = "die zwei Seiten."), TargetExpression(text = "es stimmt, dass…, aber…", meaning = "Einräumung.", note = "anerkennen und antworten."), TargetExpression(text = "die Zahlen sagen…", meaning = "Beweis.", note = "Autoritätsargument."), TargetExpression(text = "aus all dem, …", meaning = "Schluss.", note = "formeller Abschluss.")), situation = "Ihr schreibt eine Meinungskolumne über die autofreie Innenstadt: These, zwei Seiten, Einräumung, Schluss.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "These: ich finde, wir sollten die Innenstadt autofrei machen.", expected = listOf("Ich finde wir sollten die innenstadt autofrei machen", "Ich finde, wir sollten die Innenstadt autofrei machen"), focus = "ich finde", watch = "These + sollen."), PracticeQuestion(prompt = "Argument 1: einerseits sinkt die Verschmutzung.", expected = listOf("Einerseits sinkt die verschmutzung", "Einerseits sinkt die Verschmutzung"), focus = "einerseits", watch = "Erstes Argument."), PracticeQuestion(prompt = "Gegenargument: andererseits leidet der Handel.", expected = listOf("Andererseits leidet der handel", "Andererseits leidet der Handel"), focus = "andererseits", watch = "Zweite Seite."), PracticeQuestion(prompt = "Räum ein: es stimmt, dass es unbequem ist, aber die Zahlen sagen etwas anderes.", expected = listOf("Es stimmt dass es unbequem ist aber die zahlen sagen etwas anderes", "Es stimmt, dass es unbequem ist, aber die Zahlen sagen etwas anderes"), focus = "es stimmt, dass", watch = "Einräumung + aber."), PracticeQuestion(prompt = "Schließe: aus all dem verteidige ich die Maßnahme.", expected = listOf("Aus all dem verteidige ich die massnahme", "Aus all dem verteidige ich die Maßnahme"), focus = "aus all dem", watch = "Formeller Schluss."))), exercises = listOf(Exercise(id = "de-foundations-u7-argumentieren-e1", kind = "choice", prompt = "___ sinkt die Verschmutzung; ___ leidet der Handel.", options = listOf("Einerseits / andererseits", "Erstens / zweitens", "Vor / nach", "Weil / aber"), answers = listOf("Einerseits / andererseits"), explain = "Die zwei Seiten."), Exercise(id = "de-foundations-u7-argumentieren-e2", kind = "gap", prompt = "Es stimmt, dass es unbequem ist, ___ die Zahlen sagen etwas anderes.", options = listOf(), answers = listOf("aber", "doch"), explain = "Einräumung + Kontrast."), Exercise(id = "de-foundations-u7-argumentieren-e3", kind = "order", prompt = "Schluss: aus all dem verteidige ich die Maßnahme.", options = listOf(), answers = listOf("Aus all dem verteidige ich die Maßnahme"), explain = "aus all dem."), Exercise(id = "de-foundations-u7-argumentieren-e4", kind = "written", prompt = "Deine These zum ÖPNV-Ausbau (Straßenbahn).", options = listOf(), answers = listOf("ich finde wir sollten die strassenbahn verlangern", "ich finde, wir sollten die straßenbahn verlängern"), explain = "Ich finde, wir sollten…")), skills = listOf("writing:argument", "grammar:connectors", "function:express-opinion", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors"))))
}

object DeFoundationsU9 {
    val unit = CourseUnit(id = "de-foundations-u9", title = "Nuancen und Register", subtitle = "Es besser sagen", level = "C1", themes = listOf(ConversationTheme("de-c1-register", "Formell oder locker ?", "Wie man es sagt", "sparkles", "Course", "Sie schreiben dieselbe Nachricht zweimal: einmal an die Projektleitung, einmal an Ihre WG – und justieren Ton und Wörter.", 0),
                ConversationTheme("de-c1-nuancen", "Fein justiert", "Mehr oder weniger", "bubble-left-and-text", "Course", "Ihr bewertet Vorschläge im Team: abschwächen, einräumen, schärfen – bis jede Aussage genau das sagt, was sie soll.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u9-register", title = "Wie man es sagt", goal = "Zwischen den Registern wechseln: dieselbe Idee einmal formell, einmal umgangssprachlich – und dabei Wort für Wort treffen.", intro = LessonIntro(explanation = listOf("Dasselbe Anliegen, zwei Ebenen: « Ich wollte mich erkundigen, ob der Termin noch passt » klingt formell, « Sag mal, passt der Termin noch ? » umgangssprachlich.", "Formelle Ersatzwörter heben das Register: erhalten statt kriegen, mitteilen statt Bescheid sagen, « Ich muss Ihnen leider mitteilen, dass sich alles verschiebt ».", "Im Brief veredeln Konnektoren den Ton: « Da ich noch auf die Zusage warte, wäre ein früherer Termin hilfreich » – begründen und bitten in einem Atemzug."), examples = listOf(ExampleLine(text = "Ich wollte mich erkundigen, ob der Termin noch passt.", meaning = "Formelle Nachfrage statt « Sag mal »."), ExampleLine(text = "Ich muss Ihnen leider mitteilen, dass sich alles verschiebt.", meaning = "Schlechte Nachricht, formell verpackt."), ExampleLine(text = "Du kriegst die Unterlagen später.", meaning = "Umgangssprachlich: kriegen = erhalten."), ExampleLine(text = "Wäre es Ihnen möglich, früher zu antworten ?", meaning = "Höfliche Bitte mit Konjunktiv II."), ExampleLine(text = "Sag mal, kannst du mir kurz aushelfen ?", meaning = "Locker, unter Kollegen mit Du."))), expressions = listOf(TargetExpression(text = "ich wollte mich erkundigen, ob…", meaning = "Formell nachfragen.", note = "…der Termin noch passt."), TargetExpression(text = "ich muss Ihnen mitteilen, dass…", meaning = "Formell informieren.", note = "…sich alles verschiebt."), TargetExpression(text = "wäre es Ihnen möglich, … ?", meaning = "Höfliche Bitte.", note = "…früher zu antworten ?"), TargetExpression(text = "kriegen / Bescheid sagen", meaning = "Umgangssprachliche Ebene.", note = "formell: erhalten / mitteilen."), TargetExpression(text = "da ich …, wäre … hilfreich", meaning = "Begründung + Bitte verbinden.", note = "Da ich warte, wäre ein Termin hilfreich.")), situation = "Sie formulieren dieselbe Nachricht zweimal: einmal an die Projektleitung, einmal an Ihre WG – und justieren Ton, Verben und Konnektoren, bis es jeweils sitzt.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Formell nachfragen: ich wollte mich erkundigen, ob der Termin noch passt.", expected = listOf("ich wollte mich erkundigen ob der termin noch passt", "ich wollte mich erkundigen, ob der termin noch passt"), focus = "sich erkundigen", watch = "Formel « ich wollte mich erkundigen, ob… »."), PracticeQuestion(prompt = "Schlechte Nachricht formell: ich muss Ihnen mitteilen, dass sich der Workshop verschiebt.", expected = listOf("ich muss ihnen mitteilen dass sich der workshop verschiebt", "ich muss ihnen mitteilen, dass sich der workshop verschiebt"), focus = "mitteilen", watch = "mitteilen + dass-Satz, kein « Bescheid sagen »."), PracticeQuestion(prompt = "Höflich bitten: wäre es Ihnen möglich, die Unterlagen vorab zu schicken ?", expected = listOf("ware es ihnen moglich die unterlagen vorab zu schicken", "wäre es ihnen möglich, die unterlagen vorab zu schicken"), focus = "wäre es möglich", watch = "Konjunktiv II + « Ihnen »."), PracticeQuestion(prompt = "Umgangssprachlich zusagen: ich sage dir Bescheid, sobald ich mehr kriege.", expected = listOf("ich sage dir bescheid sobald ich mehr kriege", "ich sage dir bescheid, sobald ich mehr kriege"), focus = "bescheid sagen", watch = "kriegen statt erhalten – locker bleiben."), PracticeQuestion(prompt = "Begründen und bitten: da ich noch auf die Zusage warte, wäre ein früherer Termin hilfreich.", expected = listOf("da ich noch auf die zusage warte ware ein fruherer termin hilfreich", "da ich noch auf die zusage warte, wäre ein früherer termin hilfreich"), focus = "da + Konnektor", watch = "Kausaler Nebensatz « da » + Konjunktiv."))), exercises = listOf(Exercise(id = "de-foundations-u9-register-e1", kind = "choice", prompt = "Formell statt « kriegen »: Sie ___ die Rechnung in den nächsten Tagen.", options = listOf("erhalten", "kriegen", "abbekommen", "abstauben"), answers = listOf("erhalten"), explain = "« erhalten » ist die formelle Entsprechung von « kriegen/bekommen »."), Exercise(id = "de-foundations-u9-register-e2", kind = "gap", prompt = "Ich möchte mich ___, ob der Saal am Freitag frei ist. (höflich nachfragen)", options = listOf(), answers = listOf("erkundigen"), explain = "sich erkundigen, ob… – die formelle Variante von « nachfragen »."), Exercise(id = "de-foundations-u9-register-e3", kind = "order", prompt = "Aus Wortbausteinen: eine formelle Bitte, dass man Ihnen die Unterlagen bis Mittwoch gibt.", options = listOf(), answers = listOf("Schicken Sie mir bitte die Unterlagen bis Mittwoch zu"), explain = "Höfliche Bitte mit « Sie » und Zeitangabe."), Exercise(id = "de-foundations-u9-register-e4", kind = "written", prompt = "Schreiben Sie eine formelle Schlusszeile: Sie bedanken sich vorab für eine Antwort.", options = listOf(), answers = listOf("ich danke ihnen im voraus fur ihre ruckmeldung", "ich danke ihnen im voraus für ihre rückmeldung"), explain = "« Ich danke Ihnen im Voraus für Ihre Rückmeldung » – klassische Schlusszeile.")), skills = listOf("vocab:social-expressions", "function:talk-about-work", "writing:email", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "de-foundations-u9-nuancen", title = "Mehr oder weniger", goal = "Meinungen nuancieren: abschwächen, einräumen und mit Abstand verallgemeinern – ohne an Klarheit zu verlieren.", intro = LessonIntro(explanation = listOf("Abschwächen klingt souverän: « Das ist eher eine Vermutung als ein Fakt » – so zeigen Sie Distanz, ohne grob zu widersprechen.", "Einräumen und halten: « Zwar ist der Ansatz teuer, aber er spart Zeit » – zwar + aber balanciert zwei Seiten in einem Satz.", "Verallgemeinern mit Abstand: « Sozusagen ein Kompromiss », « Gewissermaßen ein Neuanfang » – solche Wendungen signalisieren: ich sage es mit Vorsicht."), examples = listOf(ExampleLine(text = "Das ist eher eine Vermutung als ein Fakt.", meaning = "Abschwächung: eher … als."), ExampleLine(text = "Zwar ist der Ansatz teuer, aber er spart Zeit.", meaning = "zwar + aber = Einräumung."), ExampleLine(text = "Sozusagen ein Kompromiss auf Zeit.", meaning = "sozusagen = gewissermaßen."), ExampleLine(text = "Aus meiner Sicht ist das kein Widerspruch.", meaning = "Meinung markieren, sachlich bleiben."), ExampleLine(text = "Das überzeugt mich nicht unbedingt.", meaning = "Verneinen mit Feingefühl."))), expressions = listOf(TargetExpression(text = "eher … als …", meaning = "Vergleich mit Abschwächung.", note = "eher Vermutung als Fakt."), TargetExpression(text = "zwar …, aber …", meaning = "Einräumen und halten.", note = "zwar teuer, aber effektiv."), TargetExpression(text = "sozusagen / gewissermaßen", meaning = "Bildlich, mit Abstand.", note = "sozusagen ein Neuanfang."), TargetExpression(text = "aus meiner Sicht", meaning = "Meinung markieren.", note = "sachlicher als « ich finde »."), TargetExpression(text = "nicht unbedingt / nicht gerade", meaning = "Weich verneinen.", note = "nicht unbedingt überzeugt.")), situation = "Sie bewerten in der Redaktionsschleife Vorschläge des Teams – jedes Urteil bekommt eine Feinjustierung: eher, zwar… aber, sozusagen.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Schwäche ab: das ist eher eine Vermutung als ein Fakt.", expected = listOf("das ist eher eine vermutung als ein fakt", "das ist eher eine Vermutung, als ein Fakt"), focus = "eher … als", watch = "Abschwächung vor dem Urteil."), PracticeQuestion(prompt = "Räume ein und halte dagegen: zwar ist der Ansatz teuer, aber er spart Zeit.", expected = listOf("zwar ist der ansatz teuer aber er spart zeit", "zwar ist der ansatz teuer, aber er spart zeit"), focus = "zwar …, aber", watch = "Zwar an Position 1, dann Verb."), PracticeQuestion(prompt = "Verallgemeinere mit Abstand: sozusagen ein Kompromiss auf Zeit.", expected = listOf("sozusagen ein kompromiss auf zeit", "gewissermassen ein kompromiss auf zeit", "gewissermaßen ein Kompromiss auf Zeit"), focus = "sozusagen", watch = "Alternative: gewissermaßen."), PracticeQuestion(prompt = "Markiere deine Meinung formell: aus meiner Sicht ist das kein Widerspruch.", expected = listOf("aus meiner sicht ist das kein widerspruch", "meiner meinung nach ist das kein widerspruch"), focus = "aus meiner Sicht", watch = "Formeller als « ich finde »."), PracticeQuestion(prompt = "Verneine mit Feingefühl: das überzeugt mich nicht unbedingt.", expected = listOf("das uberzeugt mich nicht unbedingt", "das überzeugt mich nicht unbedingt"), focus = "nicht unbedingt", watch = "Weicher als ein klares Nein."))), exercises = listOf(Exercise(id = "de-foundations-u9-nuancen-e1", kind = "choice", prompt = "Abschwächen: Das ist ___ eine Vermutung als ein Fakt.", options = listOf("eher", "völlig", "absolut", "gerade"), answers = listOf("eher"), explain = "« eher … als » setzt die Abschwächung ins Verhältnis."), Exercise(id = "de-foundations-u9-nuancen-e2", kind = "gap", prompt = "___ der Ansatz teuer ist, überzeugt er mich. (Einräumung mit Nebensatz)", options = listOf(), answers = listOf("obwohl", "obgleich", "obschon"), explain = "obwohl + Nebensatz: Einräumung, im Hauptsatz bleibt die Zustimmung."), Exercise(id = "de-foundations-u9-nuancen-e3", kind = "order", prompt = "Bilde eine verallgemeinernde Nuance: (Kompromiss, der nur vorübergehend gilt – mit « sozusagen »).", options = listOf(), answers = listOf("Sozusagen ein Kompromiss auf Zeit"), explain = "sozusagen + Nominalphrase: Distanz im Ton."), Exercise(id = "de-foundations-u9-nuancen-e4", kind = "written", prompt = "Bewerte abschwächend: das Konzept ist nicht schlecht, aber auch nicht neu (mit « nicht gerade »).", options = listOf(), answers = listOf("das konzept ist nicht schlecht aber auch nicht gerade neu", "das konzept ist nicht schlecht, aber auch nicht gerade neu"), explain = "« nicht gerade » schwächt die Kritik ab, ohne sie zu widerrufen.")), skills = listOf("function:express-opinion", "speaking:justify-opinion", "grammar:connectors", "vocab:collocations"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "de-foundations-u9-prasentieren", title = "Ideen präsentieren", goal = "Einen kurzen Vortrag strukturieren: zunächst das Thema, im Folgenden die Punkte, zusammenfassend der Kern.", intro = LessonIntro(explanation = listOf("Einstieg mit Fahrplan: « Zunächst gehe ich auf den Hintergrund ein, danach zeige ich zwei Optionen » – die Zuhörer wissen sofort, wohin die Reise geht.", "Im Hauptteil Rote Fäden halten: « Im Folgenden », « anschließend », « daraus folgt » – solche Konnektoren tragen, wenn man frei spricht.", "Abschluss mit Gewicht: « Zusammenfassend bleibt: … », « Zum Schluss möchte ich den Zeitplan betonen » – am Ende nur noch eine Botschaft."), examples = listOf(ExampleLine(text = "Zunächst gehe ich auf den Hintergrund ein.", meaning = "Einstieg: erstes Element."), ExampleLine(text = "Im Folgenden vergleiche ich beide Optionen.", meaning = "Überleitung zum Hauptteil."), ExampleLine(text = "Daraus folgt: Wir brauchen eine Pilotphase.", meaning = "Folgerung ziehen."), ExampleLine(text = "Zusammenfassend sprechen die Zahlen für Variante B.", meaning = "Kern komprimieren."), ExampleLine(text = "Zum Schluss betone ich noch einmal den Zeitplan.", meaning = "Schlussakzent setzen."))), expressions = listOf(TargetExpression(text = "zunächst / anfangs", meaning = "Erster Schritt.", note = "Zunächst zum Hintergrund."), TargetExpression(text = "im Folgenden / anschließend", meaning = "Überleitung.", note = "Im Folgenden vergleiche ich…"), TargetExpression(text = "daraus folgt / folglich", meaning = "Folgern.", note = "Daraus folgt eine Pilotphase."), TargetExpression(text = "zusammenfassend bleibt…", meaning = "Kern nennen.", note = "…eine klare Empfehlung."), TargetExpression(text = "zum Schluss möchte ich … betonen", meaning = "Schlussakzent.", note = "…den Zeitplan.")), situation = "Sie pitchen der Geschäftsführung in drei Minuten ein internes Tool: Fahrplan, zwei Argumente, Folgerung – und ein Schlusssatz, der hängen bleibt.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Einstieg: zunächst gehe ich auf den Hintergrund ein.", expected = listOf("zunachst gehe ich auf den hintergrund ein", "zunächst gehe ich auf den hintergrund ein"), focus = "zunächst", watch = "Strukturwort an Position 1."), PracticeQuestion(prompt = "Überleitung: im Folgenden vergleiche ich beide Optionen.", expected = listOf("im folgenden vergleiche ich beide optionen", "im folgenden stelle ich beide optionen gegenuber", "im folgenden stelle ich beide optionen gegenüber"), focus = "im Folgenden", watch = "Konnektor + Präsens der Ankündigung."), PracticeQuestion(prompt = "Folgerung: daraus folgt, dass wir eine Pilotphase brauchen.", expected = listOf("daraus folgt dass wir eine pilotphase brauchen", "daraus folgt, dass wir eine pilotphase brauchen"), focus = "daraus folgt", watch = "dass-Satz als Inhalt der Folgerung."), PracticeQuestion(prompt = "Kern: zusammenfassend sprechen die Zahlen für Variante B.", expected = listOf("zusammenfassend sprechen die zahlen fur variante b", "zusammenfassend sprechen die zahlen für variante b"), focus = "zusammenfassend", watch = "Kern in einem Satz."), PracticeQuestion(prompt = "Schluss: zum Schluss möchte ich den Zeitplan betonen.", expected = listOf("zum schluss mochte ich den zeitplan betonen", "zum schluss möchte ich den zeitplan betonen"), focus = "zum Schluss", watch = "möchte + betonen: letzter Akzent."))), exercises = listOf(Exercise(id = "de-foundations-u9-prasentieren-e1", kind = "choice", prompt = "Einstieg mit Struktur: ___ gehe ich auf den Hintergrund ein, danach zeige ich die Optionen.", options = listOf("Zunächst", "Deshalb", "Trotzdem", "Stattdessen"), answers = listOf("Zunächst"), explain = "« zunächst » kündigt den ersten Schritt des Vortrags an."), Exercise(id = "de-foundations-u9-prasentieren-e2", kind = "gap", prompt = "Die Zahlen sinken, ___ müssen wir handeln. (Folgerung ziehen)", options = listOf(), answers = listOf("folglich", "daher", "deshalb"), explain = "Folglich/daher + Hauptsatz: die Folgerung wird besiegelt."), Exercise(id = "de-foundations-u9-prasentieren-e3", kind = "order", prompt = "Abschluss des Vortrags: benenne den Kern – eine Empfehlung, die klar bleibt.", options = listOf(), answers = listOf("Zusammenfassend bleibt eine klare Empfehlung"), explain = "zusammenfassend + bleiben + Kern in einem Satz."), Exercise(id = "de-foundations-u9-prasentieren-e4", kind = "written", prompt = "Fasse in einem Schlusssatz zusammen: die Pilotphase ist die richtige Wahl (mit « zusammenfassend »).", options = listOf(), answers = listOf("zusammenfassend spricht alles fur eine pilotphase", "zusammenfassend spricht alles für eine pilotphase"), explain = "Zusammenfassend + Bewertung: die eine Botschaft.")), skills = listOf("speaking:sustained-conversation", "function:talk-about-work", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "de-foundations-u9-debattieren", title = "Einig im Uneinig", goal = "Höflich widersprechen: Zustimmung signalisieren und dann den eigenen Standpunkt setzen.", intro = LessonIntro(explanation = listOf("Der klassische konzessive Einstieg: « Ich verstehe Ihren Punkt, aber… » — erst Verständnis zeigen, dann folgt der Widerspruch.", "Variationen desselben Musters: « Da bin ich ganz bei Ihnen, dennoch… », « Das mag stimmen, allerdings… » — stets Anerkennung plus Aber.", "Schärfer, doch gewahrt: « Dem kann ich so nicht zustimmen, denn die Zahlen sagen etwas anderes. » Der denn-Satz liefert das Argument."), examples = listOf(ExampleLine(text = "Ich verstehe Ihren Punkt, aber die Datenlage ist eine andere.", meaning = "Verständnis + Widerspruch."), ExampleLine(text = "Da bin ich ganz bei Ihnen, dennoch halte ich den Vorschlag für riskant.", meaning = "dennoch: formell kontrastierend."), ExampleLine(text = "Das mag stimmen, allerdings nur für den städtischen Raum.", meaning = "Einräumen und zugleich begrenzen."), ExampleLine(text = "Dem kann ich so nicht zustimmen, denn die Zahlen sagen etwas anderes.", meaning = "Sachliche, argumentierte Ablehnung."), ExampleLine(text = "Einerseits leuchtet mir das ein, andererseits fehlt die Evaluation.", meaning = "Abwägen in der Debatte."))), expressions = listOf(TargetExpression(text = "ich verstehe Ihren Punkt, aber…", meaning = "Konzessiver Widerspruch.", note = "…aber die Datenlage ist anders."), TargetExpression(text = "da bin ich ganz bei Ihnen, dennoch…", meaning = "Einverständnis + Kontra.", note = "dennoch = trotzdem, formell."), TargetExpression(text = "das mag stimmen, allerdings…", meaning = "Einräumen + begrenzen.", note = "allerdings nur zum Teil."), TargetExpression(text = "dem kann ich so nicht zustimmen", meaning = "Sachlicher Widerspruch.", note = "…, denn …"), TargetExpression(text = "einerseits … andererseits…", meaning = "Abwägen.", note = "beide Seiten benennen.")), situation = "In der Runde lobt man den Vorschlag, Sie sehen es anders: erst würdigen Sie das Argument, dann widersprechen Sie mit Daten — freundlich, aber unmissverständlich.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Widersprechen Sie höflich: Sie verstehen den Punkt, aber die Datenlage ist anders.", expected = listOf("ich verstehe ihren punkt aber die datenlage ist eine andere", "Ich verstehe Ihren Punkt, aber die Datenlage ist eine andere."), focus = "ich verstehe ihren punkt", watch = "Erst Verständnis, dann aber."), PracticeQuestion(prompt = "Stimmen Sie zunächst zu und halten dennoch den Vorschlag für riskant.", expected = listOf("Da bin ich ganz bei Ihnen, dennoch halte ich den Vorschlag für riskant.", "da bin ich ganz bei ihnen dennoch halte ich den vorschlag fur riskant"), focus = "dennoch", watch = "Einverständnis + dennoch."), PracticeQuestion(prompt = "Räumen Sie ein und begrenzen Sie: stimmt, aber nur für den städtischen Raum.", expected = listOf("Das mag stimmen, allerdings nur für den städtischen Raum.", "das mag stimmen allerdings nur für den städtischen raum", "das mag stimmen allerdings nur fur den stadtischen raum"), focus = "das mag stimmen", watch = "Einräumen mit allerdings."), PracticeQuestion(prompt = "Widersprechen Sie sachlich und nennen Sie die Zahlen als Grund.", expected = listOf("Dem kann ich so nicht zustimmen, denn die Zahlen sagen etwas anderes.", "dem kann ich so nicht zustimmen denn die zahlen sagen etwas anderes"), focus = "dem kann ich so nicht zustimmen", watch = "denn + Argument."), PracticeQuestion(prompt = "Wägen Sie ab: einleuchtend einerseits, fehlende Evaluation andererseits.", expected = listOf("Einerseits leuchtet mir das ein, andererseits fehlt die Evaluation.", "einerseits leuchtet mir das ein andererseits fehlt die evaluation"), focus = "einerseits … andererseits", watch = "Beide Seiten benennen."))), exercises = listOf(Exercise(id = "de-foundations-u9-debattieren-e1", kind = "choice", prompt = "Widerspruch mit Verständnis: « Ich verstehe Ihren Punkt, ___ die Zahlen widersprechen Ihnen. »", options = listOf("aber", "denn", "sondern", "also"), answers = listOf("aber"), explain = "aber nach dem Verständnis: der konzessive Widerspruch."), Exercise(id = "de-foundations-u9-debattieren-e2", kind = "gap", prompt = "Da bin ich ganz bei Ihnen, ___ halte ich den Plan für riskant. (formeller Kontrast)", options = listOf(), answers = listOf("dennoch"), explain = "dennoch verbindet Zustimmung und Widerspruch formell."), Exercise(id = "de-foundations-u9-debattieren-e3", kind = "order", prompt = "Widersprechen Sie mit Verständnis: die Zahlen sprechen dagegen.", options = listOf(), answers = listOf("Ich verstehe Ihren Punkt aber die Zahlen widersprechen"), explain = "Erst Verständnis, dann Kontra mit aber."), Exercise(id = "de-foundations-u9-debattieren-e4", kind = "written", prompt = "Räumen Sie ein und begrenzen Sie: stimmt, aber nur im städtischen Raum.", options = listOf(), answers = listOf("das mag stimmen allerdings nur im stadtischen raum", "das mag stimmen allerdings nur für den städtischen raum", "das mag stimmen allerdings nur fur den stadtischen raum"), explain = "« Das mag stimmen, allerdings… » räumt ein und begrenzt zugleich.")), skills = listOf("function:express-opinion", "speaking:sustained-conversation", "grammar:connectors", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "de-foundations-u9-ton", title = "Der genaue Ton", goal = "Register und Kollokationen justieren: eine Entscheidung treffen statt machen, Lust haben auf etwas — bis jedes Wort am Platz sitzt.", intro = LessonIntro(explanation = listOf("Kollokationen sind feste Paare: eine Entscheidung treffen, eine Rolle spielen, Kritik üben — das falsche Verb (« eine Entscheidung machen ») verrät sofort den Nichtmuttersprachler.", "Die Präposition gehört dazu: Lust haben AUF etwas — « Ich habe große Lust auf dieses Projekt » (Akkusativ).", "Register justieren: « Wir werden in Kürze eine Entscheidung treffen » klingt formeller als « Wir entscheiden uns bald » — Inhalt gleich, Ton verschieden."), examples = listOf(ExampleLine(text = "Wir müssen in Kürze eine Entscheidung treffen.", meaning = "treffen, nicht machen: die Kollokation."), ExampleLine(text = "Ich habe große Lust auf dieses Projekt.", meaning = "Lust haben auf + Akkusativ."), ExampleLine(text = "Der Zeitplan spielt eine entscheidende Rolle.", meaning = "eine Rolle spielen: festes Verb."), ExampleLine(text = "Genau genommen ist das noch keine Zusage.", meaning = "genau genommen: präzise eingrenzen."), ExampleLine(text = "Im Grunde teile ich Ihre Einschätzung.", meaning = "Meinung gemäßigt einleiten."))), expressions = listOf(TargetExpression(text = "eine Entscheidung treffen", meaning = "Formell entscheiden.", note = "nicht: eine Entscheidung machen"), TargetExpression(text = "Lust haben auf + Akk.", meaning = "Interesse signalisieren.", note = "Lust auf ein zweites Gespräch ?"), TargetExpression(text = "eine Rolle spielen", meaning = "Wichtig sein.", note = "Die Fristen spielen eine große Rolle."), TargetExpression(text = "genau genommen / streng genommen", meaning = "Präzise eingrenzen.", note = "Streng genommen fehlt noch die Zusage."), TargetExpression(text = "im Grunde", meaning = "Gemäßigt zustimmen.", note = "Im Grunde stimme ich zu.")), situation = "Sie überarbeiten eine Mail an die Projektleitung: « eine Entscheidung treffen » statt « machen », « Lust auf das Projekt » — und mit « genau genommen » grenzen Sie eine Aussage präzise ein.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Korrigieren Sie die Kollokation: wir machen morgen eine Entscheidung.", expected = listOf("wir treffen morgen eine entscheidung", "wir werden morgen eine entscheidung treffen"), focus = "eine entscheidung treffen", watch = "treffen, nicht machen."), PracticeQuestion(prompt = "Sagen Sie, dass Sie Lust auf das Projekt haben.", expected = listOf("ich habe große lust auf das projekt", "ich habe grosses interesse an dem projekt", "ich habe lust auf das projekt"), focus = "lust haben auf", watch = "Lust haben auf + Akkusativ."), PracticeQuestion(prompt = "Formulieren Sie: der Zeitplan ist sehr wichtig. (eine Rolle spielen)", expected = listOf("der zeitplan spielt eine wichtige rolle", "der zeitplan spielt eine große rolle", "der zeitplan spielt eine entscheidende rolle"), focus = "eine rolle spielen", watch = "spielen, nicht machen."), PracticeQuestion(prompt = "Grenzen Sie präzise ein: es ist noch keine Zusage. (streng genommen)", expected = listOf("streng genommen ist das noch keine zusage", "streng genommen ist es noch keine zusage", "genau genommen ist das noch keine zusage"), focus = "streng genommen", watch = "streng/genau genommen + Einschränkung."), PracticeQuestion(prompt = "Stimmen Sie gemäßigt zu. (im Grunde)", expected = listOf("im grunde stimme ich zu", "im grunde teile ich ihre einschätzung"), focus = "im grunde", watch = "im Grunde: gemäßigte Zustimmung."))), exercises = listOf(Exercise(id = "de-foundations-u9-ton-e1", kind = "choice", prompt = "Formell formuliert: « Wir werden morgen eine Entscheidung ___. »", options = listOf("treffen", "machen", "geben", "setzen"), answers = listOf("treffen"), explain = "Kollokation: eine Entscheidung treffen — nicht machen."), Exercise(id = "de-foundations-u9-ton-e2", kind = "gap", prompt = "Ich habe ___ auf dieses Projekt. (Wendung: Interesse haben)", options = listOf(), answers = listOf("Lust"), explain = "Lust haben auf + Akkusativ: die feste Wendung."), Exercise(id = "de-foundations-u9-ton-e3", kind = "order", prompt = "Formell: die Fristen sind sehr wichtig. (eine Rolle spielen)", options = listOf(), answers = listOf("Die Fristen spielen eine wichtige Rolle"), explain = "eine Rolle spielen: festes Verb + Adjektiv."), Exercise(id = "de-foundations-u9-ton-e4", kind = "written", prompt = "Grenzen Sie präzise ein: es ist noch keine Zusage. (streng genommen)", options = listOf(), answers = listOf("streng genommen ist das noch keine zusage", "streng genommen ist es noch keine zusage", "genau genommen ist das noch keine zusage"), explain = "streng genommen + Einschränkung: der präzise Ton.")), skills = listOf("vocab:collocations", "function:express-opinion", "writing:argument", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors"))))
}

object DeWorkU1 {
    val unit = CourseUnit(id = "de-work-u1", title = "Der Arbeitstag", subtitle = "Besprechungen, E-Mails, Vorstellungsgespräche", level = "B1", themes = listOf(ConversationTheme("projekt-besprechung", "Die Projektbesprechung", "Meinung und Vorschläge", "person.2", "Course", "Montag um neun: Wo steht das Projekt, was fehlt — und wer schlägt was vor ? In der Besprechung zählt klare Meinung.", 0),
                ConversationTheme("bewerbungs-training", "Das Bewerbungstraining", "Erfahrung, die sitzt", "person.badge.key", "Course", "Probe fürs echte Gespräch: Erfahrung im Perfekt, Erfolge mit Zahlen — und die Frage nach dem eigenen Ziel.", 1)), lessons = listOf(    Lesson(id = "de-work-u1-besprechungen", title = "In Besprechungen", goal = "In Besprechungen Meinung sagen, vorschlagen und höflich widersprechen.", intro = LessonIntro(explanation = listOf("Position mit Struktur: « Einerseits sind wir im Zeitplan, andererseits fehlt das Budget. » — beide Seiten in einem Satz.", "Vorschläge mit schlagen vor: « Ich schlage vor, dass wir das Budget am Freitag klären. » — Verb ganz am Ende.", "Widersprechen mit Punkt: « Da bin ich anderer Meinung, denn wir verlieren sonst Zeit. » — denn macht den Einwand stark."), examples = listOf(ExampleLine(text = "Wo stehen wir mit dem Projekt ?", meaning = "Die Eröffnungsfrage."), ExampleLine(text = "Einerseits im Zeitplan, andererseits fehlt das Budget.", meaning = "Beide Seiten nennen."), ExampleLine(text = "Ich schlage vor, dass wir das Budget am Freitag klären.", meaning = "Vorschlag mit Termin."), ExampleLine(text = "Da bin ich anderer Meinung.", meaning = "Klarer, höflicher Einwand."), ExampleLine(text = "Einverstanden — machen wir so.", meaning = "Beschluss fassen."))), expressions = listOf(TargetExpression(text = "Kommen wir zum Punkt …", meaning = "Struktur geben.", note = "Kommen wir zum letzten Punkt."), TargetExpression(text = "Ich bin der Meinung, dass …", meaning = "Position klar sagen.", note = "… wir früher starten sollten."), TargetExpression(text = "Ich schlage vor, dass …", meaning = "Vorschlag + dass.", note = "… wir einen Termin setzen."), TargetExpression(text = "Da bin ich anderer Meinung.", meaning = "Widersprechen.", note = ", denn … (der Grund)"), TargetExpression(text = "Einverstanden !", meaning = "Zustimmen, kurz.", note = "Dann notiert es jemand.")), situation = "Montagsmeeting: das Projekt ist im Zeitplan, aber das Werbebudget fehlt. Ein Vorschlag mit Freitagstermin, ein Einwand mit denn — am Ende fassen alle einen Beschluss.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Eröffne den Punkt: Wo steht das Projekt ?", expected = listOf("Wo stehen wir mit dem Projekt ?", "wo stehen wir mit dem projekt", "Wo stehen wir beim Projekt ?"), focus = "wo stehen wir", watch = "Kommen wir zum Punkt … eröffnet."), PracticeQuestion(prompt = "Zeig beide Seiten: Zeitplan ja, Budget fehlt.", expected = listOf("Einerseits sind wir im Zeitplan, andererseits fehlt das Budget.", "einerseits sind wir im zeitplan andererseits fehlt das budget"), focus = "einerseits andererseits", watch = "Beide Seiten, ein Satz."), PracticeQuestion(prompt = "Schlag vor: das Budget wird am Freitag geklärt.", expected = listOf("Ich schlage vor, dass wir das Budget am Freitag klären.", "ich schlage vor dass wir das budget am freitag klären", "ich schlage vor dass wir das budget am freitag klaeren"), focus = "ich schlage vor", watch = "dass: Verb ganz am Ende."), PracticeQuestion(prompt = "Widersprich mit Grund: wir verlieren sonst Zeit. (denn)", expected = listOf("Da bin ich anderer Meinung, denn wir verlieren sonst Zeit.", "da bin ich anderer meinung denn wir verlieren sonst zeit", "Ich bin da anderer Meinung."), focus = "anderer meinung", watch = "denn + Grund macht den Einwand stark."), PracticeQuestion(prompt = "Fasse den Beschluss zusammen: so machen wir es.", expected = listOf("Einverstanden, machen wir so.", "einverstanden machen wir so"), focus = "einverstanden", watch = "Kurz zustimmen und abschließen."))), exercises = listOf(Exercise(id = "de-work-u1-besprechungen-e1", kind = "choice", prompt = "« Ich bin der ___, dass wir früher starten. »", options = listOf("Meinung", "Meine", "Meinungen", "Meinungs"), answers = listOf("Meinung"), explain = "feste Wendung: Ich bin der Meinung, dass …"), Exercise(id = "de-work-u1-besprechungen-e2", kind = "gap", prompt = "Ich schlage ___, dass wir einen Termin setzen.", options = listOf(), answers = listOf("vor"), explain = "trennbar: vorschlagen → schlage … vor."), Exercise(id = "de-work-u1-besprechungen-e3", kind = "order", prompt = "Widersprich höflich mit Grund: sonst verlieren wir Zeit. (denn)", options = listOf(), answers = listOf("Da bin ich anderer Meinung denn wir verlieren sonst Zeit"), explain = "anderer Meinung + denn + Grund."), Exercise(id = "de-work-u1-besprechungen-e4", kind = "written", prompt = "Mach einen Vorschlag fürs nächste Meeting.", options = listOf(), answers = listOf("ich schlage vor dass wir am freitag klären", "ich schlage vor dass wir am freitag klaeren", "ich schlage vor dass wir einen termin setzen", "sollen wir das am freitag besprechen"), explain = "Vorschlag mit dass oder als Frage: beides geht.")), skills = listOf("function:talk-about-work", "function:express-opinion", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "de-work-u1-emails", title = "Formelle E-Mails", goal = "Eine formelle E-Mail schreiben: Anrede, Anliegen, Bitte mit Deadline und Grußformel.", intro = LessonIntro(explanation = listOf("Gerüst: Anrede → Anliegen in Zeile eins → Bitte → Gruß. « Sehr geehrte Frau Meyer, ich schreibe Ihnen wegen des Budgets. »", "Bitten im Konjunktiv: « Könnten Sie mir bis Mittwoch die Zahlen schicken ? » — höflich, nicht bettelnd.", "Dank und Gruß: « Für eine kurze Rückmeldung wäre ich Ihnen dankbar. Mit freundlichen Grüßen »"), examples = listOf(ExampleLine(text = "Sehr geehrte Frau Meyer,", meaning = "Die formelle Anrede."), ExampleLine(text = "Ich schreibe Ihnen wegen des Budgets.", meaning = "Anliegen in Zeile eins."), ExampleLine(text = "Könnten Sie mir bis Mittwoch die Zahlen schicken ?", meaning = "Bitte + Deadline."), ExampleLine(text = "Für eine kurze Rückmeldung wäre ich Ihnen dankbar.", meaning = "Der Dank vor dem Gruß."), ExampleLine(text = "Mit freundlichen Grüßen, Daniel Weber", meaning = "Die sichere Grußformel."))), expressions = listOf(TargetExpression(text = "Sehr geehrte(r) …,", meaning = "Formelle Anrede.", note = "bei Namen: Sehr geehrte Frau Krause"), TargetExpression(text = "Ich schreibe Ihnen wegen …", meaning = "Anliegen sofort.", note = "wegen + Nomen"), TargetExpression(text = "Könnten Sie bitte … ?", meaning = "Höfliche Bitte.", note = "Könnten Sie das prüfen ?"), TargetExpression(text = "Ich wäre Ihnen dankbar, wenn …", meaning = "Formeller Dank.", note = "wenn + Verb am Ende"), TargetExpression(text = "Mit freundlichen Grüßen", meaning = "Der Standard-Schluss.", note = "in fast jeder E-Mail richtig")), situation = "Daniel braucht die Quartalszahlen: formelle Anrede, Anliegen in Zeile eins, Bitte mit Deadline — und am Schluss Dank plus Mit freundlichen Grüßen.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Beginn die formelle E-Mail an Frau Krause.", expected = listOf("Sehr geehrte Frau Krause,", "sehr geehrte frau krause", "Sehr geehrte Frau Krause"), focus = "sehr geehrte", watch = "Bei Namen: Sehr geehrte Frau/Herr …"), PracticeQuestion(prompt = "Nenn das Anliegen: du schreibst wegen des Budgets.", expected = listOf("Ich schreibe Ihnen wegen des Budgets.", "ich schreibe ihnen wegen des budgets"), focus = "ich schreibe ihnen", watch = "Anliegen in Zeile eins."), PracticeQuestion(prompt = "Bitt mit Deadline: Zahlen bis Mittwoch.", expected = listOf("Könnten Sie mir die Zahlen bis Mittwoch schicken ?", "könnten sie mir die zahlen bis mittwoch schicken", "koennten sie mir die zahlen bis mittwoch schicken"), focus = "könnten sie", watch = "Könnten Sie + Deadline."), PracticeQuestion(prompt = "Bedanke dich formell für eine Rückmeldung. (dankbar)", expected = listOf("Für eine kurze Rückmeldung wäre ich Ihnen dankbar.", "für eine kurze rückmeldung wäre ich ihnen dankbar", "Ich wäre Ihnen für eine Rückmeldung dankbar."), focus = "wäre dankbar", watch = "wäre ich Ihnen dankbar, wenn …"), PracticeQuestion(prompt = "Wähl die sichere Grußformel.", expected = listOf("Mit freundlichen Grüßen.", "mit freundlichen grüßen", "mit freundlichen gruessen", "Mit freundlichen Grüßen, Daniel"), focus = "mit freundlichen", watch = "Mit freundlichen Grüßen geht fast immer."))), exercises = listOf(Exercise(id = "de-work-u1-emails-e1", kind = "choice", prompt = "« ___ Frau Meyer, ich schreibe Ihnen wegen des Angebots. »", options = listOf("Sehr geehrte", "Hallo", "Liebe", "Hi"), answers = listOf("Sehr geehrte"), explain = "Formelle Anrede: Sehr geehrte Frau …"), Exercise(id = "de-work-u1-emails-e2", kind = "gap", prompt = "Ich schreibe ___ wegen des Budgets. (formell)", options = listOf(), answers = listOf("Ihnen"), explain = "formell: Ich schreibe Ihnen."), Exercise(id = "de-work-u1-emails-e3", kind = "order", prompt = "Schreib die Bitte mit Deadline: Zahlen, Mittwoch, schicken.", options = listOf(), answers = listOf("Könnten Sie mir die Zahlen bis Mittwoch schicken"), explain = "Könnten Sie + bitte + bis + Deadline."), Exercise(id = "de-work-u1-emails-e4", kind = "written", prompt = "Schreib eine formelle Grußformel mit Namen (Daniel).", options = listOf(), answers = listOf("mit freundlichen grüßen daniel", "mit freundlichen gruessen daniel", "mit freundlichen grüßen daniel weber", "mit freundlichen gruessen daniel weber"), explain = "Mit freundlichen Grüßen + Name.")), skills = listOf("writing:email", "function:make-requests", "vocab:work", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "de-work-u1-vorstellungsgespraeche", title = "Vorstellungsgespräche", goal = "Erfahrung und Erfolge präsentieren: Perfekt, Zahlen und ein klares Ziel.", intro = LessonIntro(explanation = listOf("Erfahrung im Perfekt: « Ich habe fünf Jahre als Projektleiterin gearbeitet. » — Zeit + Rolle + Beleg.", "Erfolge mit Zahlen: « Wir haben das Projekt zwei Wochen früher abgeschlossen. » — Zahlen bleiben im Kopf.", "Ziele zeigen: « Mein Ziel ist es, ein Team zu führen — deshalb bewerbe ich mich bei Ihnen. »"), examples = listOf(ExampleLine(text = "Ich habe fünf Jahre als Projektleiterin gearbeitet.", meaning = "Erfahrung im Perfekt."), ExampleLine(text = "Ich habe ein Team von sechs Personen organisiert.", meaning = "Konkrete Aufgabe."), ExampleLine(text = "Wir haben das Projekt zwei Wochen früher abgeschlossen.", meaning = "Erfolg mit Zahl."), ExampleLine(text = "Mein Ziel ist es, ein Team zu führen.", meaning = "Ziel mit zu + Infinitiv."), ExampleLine(text = "Deshalb habe ich mich bei Ihnen beworben.", meaning = "Der Schlusspunkt."))), expressions = listOf(TargetExpression(text = "Ich habe … als … gearbeitet.", meaning = "Erfahrung sagen.", note = "… zwei Jahre als Analyst."), TargetExpression(text = "Ich habe … organisiert/geleitet.", meaning = "Aufgaben benennen.", note = "das Team, das Projekt"), TargetExpression(text = "Wir haben … abgeschlossen.", meaning = "Erfolg + Zahl.", note = "… rechtzeitig abgeschlossen."), TargetExpression(text = "Mein Ziel ist es, … zu …", meaning = "Ziel formulieren.", note = "… ein Team zu führen."), TargetExpression(text = "deshalb", meaning = "Bewerbung begründen.", note = "Deshalb bin ich hier.")), situation = "Probespiel: Lena erzählt fünf Jahre Projektleitung, den Abschluss zwei Wochen früher — und schließt mit ihrem Ziel: ein Team führen, deshalb dieses Unternehmen.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Erzähl deine Erfahrung: fünf Jahre Projektleitung. (Perfekt)", expected = listOf("Ich habe fünf Jahre als Projektleiterin gearbeitet.", "ich habe fünf jahre als projektleiterin gearbeitet", "Ich habe fünf Jahre als Projektleiter gearbeitet."), focus = "habe gearbeitet", watch = "Perfekt: habe + Partizip."), PracticeQuestion(prompt = "Nenn deine Aufgabe: ein Team von sechs organisieren.", expected = listOf("Ich habe ein Team von sechs Personen organisiert.", "ich habe ein team von sechs personen organisiert", "Ich habe ein Team organisiert."), focus = "habe organisiert", watch = "Konkrete Aufgabe + Zahl."), PracticeQuestion(prompt = "Erzähl den Erfolg: zwei Wochen früher fertig.", expected = listOf("Wir haben das Projekt zwei Wochen früher abgeschlossen.", "wir haben das projekt zwei wochen früher abgeschlossen", "wir haben das projekt zwei wochen frueher abgeschlossen", "Wir haben das Projekt früher abgeschlossen."), focus = "abgeschlossen", watch = "Erfolg + Zahl bleibt im Kopf."), PracticeQuestion(prompt = "Nenn dein Ziel: ein Team führen.", expected = listOf("Mein Ziel ist es, ein Team zu führen.", "mein ziel ist es ein team zu führen", "mein ziel ist es ein team zu fuehren"), focus = "mein ziel", watch = "es + zu + Infinitiv am Ende."), PracticeQuestion(prompt = "Begründe die Bewerbung mit deshalb.", expected = listOf("Deshalb habe ich mich bei Ihnen beworben.", "deshalb habe ich mich bei ihnen beworben", "Deshalb bewerbe ich mich bei Ihnen."), focus = "deshalb", watch = "deshalb + Verb an Position 2."))), exercises = listOf(Exercise(id = "de-work-u1-vorstellungsgespraeche-e1", kind = "choice", prompt = "« Ich ___ drei Jahre in einer Agentur gearbeitet. »", options = listOf("habe", "bin", "war", "hatte"), answers = listOf("habe"), explain = "Perfekt mit haben: habe gearbeitet."), Exercise(id = "de-work-u1-vorstellungsgespraeche-e2", kind = "gap", prompt = "Wir haben das Projekt rechtzeitig ___. (abschließen)", options = listOf(), answers = listOf("abgeschlossen"), explain = "Partizip: haben abgeschlossen."), Exercise(id = "de-work-u1-vorstellungsgespraeche-e3", kind = "order", prompt = "Nenn dein Ziel: ein Team führen.", options = listOf(), answers = listOf("Mein Ziel ist es ein Team zu führen"), explain = "Mein Ziel ist es, … zu + Infinitiv."), Exercise(id = "de-work-u1-vorstellungsgespraeche-e4", kind = "written", prompt = "Erzähl einen Erfolg mit Zahl.", options = listOf(), answers = listOf("wir haben das projekt zwei wochen früher abgeschlossen", "wir haben das projekt zwei wochen frueher abgeschlossen", "ich habe zehn projekte geleitet", "wir haben das budget um zehn prozent gesenkt"), explain = "Erfolg + Zahl: so bleibt man im Kopf.")), skills = listOf("function:talk-about-work", "grammar:present-perfect", "vocab:work", "function:describe-goals"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-perfect"))))
}

object EnBusinessU1 {
    val unit = CourseUnit(id = "en-business-u1", title = "Clients & deals", subtitle = "Pitch, negotiate, confirm", level = "B1", themes = listOf(ConversationTheme("sales-pitch", "The sales pitch", "Ninety seconds of value", "chart.bar", "Course", "You pitch your service to a skeptical client: problem, solution, proof — then handle the first objection.", 0),
                ConversationTheme("deal-closer", "Closing the deal", "Numbers on the table", "handshake", "Course", "Final round of a negotiation: price, timeline and the sentence that closes it.", 1)), lessons = listOf(    Lesson(id = "en-business-u1-pitch", title = "The pitch", goal = "Pitch a service: problem, solution, proof, in that order.", intro = LessonIntro(explanation = listOf("The pitch skeleton: “Your team wastes hours on X. We automate X. Company A saved 20% in one quarter.”", "Lead with the client's problem, never your product: the problem is why they're listening.", "One number beats ten adjectives: “a 20% saving” does the arguing for you."), examples = listOf(ExampleLine(text = "Your team wastes hours on X.", meaning = "The problem, stated as theirs."), ExampleLine(text = "We automate exactly that.", meaning = "The solution, one line."), ExampleLine(text = "Company A saved 20% in one quarter.", meaning = "Proof with a number."), ExampleLine(text = "What would saving that time mean for you?", meaning = "Hand them the win."), ExampleLine(text = "I'd love to show you a demo.", meaning = "The soft close."))), expressions = listOf(TargetExpression(text = "The problem: your client …", meaning = "Open with their pain.", note = "Their problem, their words."), TargetExpression(text = "The solution: we + verb", meaning = "One line, no jargon.", note = "We automate exactly that."), TargetExpression(text = "Proof: client + number", meaning = "Evidence sells.", note = "Company A saved 20%."), TargetExpression(text = "What would … mean for you?", meaning = "Make it personal.", note = "Time, money, headcount."), TargetExpression(text = "I'd love to show you …", meaning = "The demo ask.", note = "Soft, specific, next step.")), situation = "You pitch to a skeptical operations manager: problem, one-line solution, one proof number — then ask the question that makes it theirs.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Open with the client's problem. (manual invoices)", expected = listOf("Your team spends hours on manual invoices."), focus = "their problem", watch = "Their pain, their words — not your product name."), PracticeQuestion(prompt = "Give the one-line solution. (automation)", expected = listOf("We automate exactly that."), focus = "one line", watch = "One sentence, no feature list."), PracticeQuestion(prompt = "Bring proof. (a client, 20% saved)", expected = listOf("Company A saved 20% in one quarter."), focus = "proof", watch = "Name + number is the strongest proof shape."), PracticeQuestion(prompt = "Make the benefit personal. (question)", expected = listOf("What would your team do with that time?"), focus = "the personal question", watch = "Hand them the win — let them say it."), PracticeQuestion(prompt = "Close softly with a demo.", expected = listOf("I'd love to show you a demo."), focus = "soft close", watch = "Love + demo: soft but specific."))), exercises = listOf(Exercise(id = "en-business-u1-pitch-e1", kind = "choice", prompt = "Your team ___ hours on manual work.", options = listOf("wastes", "waste", "wasting", "to waste"), answers = listOf("wastes"), explain = "Your team = singular: wastes."), Exercise(id = "en-business-u1-pitch-e2", kind = "gap", prompt = "We ___ exactly that. (automate)", options = listOf(), answers = listOf("automate"), explain = "We + base verb."), Exercise(id = "en-business-u1-pitch-e3", kind = "order", prompt = "Bring the proof.", options = listOf(), answers = listOf("Company A saved 20 percent in one quarter"), explain = "Client + number + period."), Exercise(id = "en-business-u1-pitch-e4", kind = "written", prompt = "Ask the personal-benefit question.", options = listOf(), answers = listOf("what would saving that time mean for you", "what would your team do with that time"), explain = "What would … mean for you?")), skills = listOf("function:talk-about-work", "grammar:present-simple", "vocab:work", "function:negotiate"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "en-business-u1-negotiation", title = "Negotiating the deal", goal = "Trade conditions politely: price, timeline, and the deal that closes.", intro = LessonIntro(explanation = listOf("Negotiation is trading, not winning: “If you can do March, we can meet your price.” Every concession has a price tag.", "Conditional offers: “We could accept that if…”, “That would work as long as…”. The if/as long as carries your condition.", "Close with a summary: “So: March delivery, half up front. Do we have a deal?” Repeat it or it didn't happen."), examples = listOf(ExampleLine(text = "If you can do March, we can meet your price.", meaning = "Condition + concession."), ExampleLine(text = "We could accept that as long as costs are covered.", meaning = "as long as = siempre que."), ExampleLine(text = "That's difficult for our timeline.", meaning = "Push back without conflict."), ExampleLine(text = "What if we split the difference?", meaning = "The middle-path move."), ExampleLine(text = "So: March delivery, half up front. Deal?", meaning = "The closing summary."), ExampleLine(text = "Half now, half on delivery — does that work?", meaning = "A structured offer."))), expressions = listOf(TargetExpression(text = "If you …, we …", meaning = "Trade a condition.", note = "If you hurry, we discount."), TargetExpression(text = "as long as …", meaning = "Your red line.", note = "as long as costs are covered."), TargetExpression(text = "That's difficult for …", meaning = "Soft pushback.", note = "…for our timeline."), TargetExpression(text = "What if we …?", meaning = "Middle path.", note = "…split the difference?"), TargetExpression(text = "So we agree on …", meaning = "Close and repeat.", note = "Numbers finish it."), TargetExpression(text = "I'd need something in writing.", meaning = "Protect the agreement.", note = "Even between friends.")), situation = "Final negotiation round: they want March at half price, you need June at full — trade conditions until the summary closes it.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ask for a faster timeline with a trade. (if / premium)", expected = listOf("If we pay the premium, can you deliver in March?"), focus = "if + trade", watch = "The if carries what you give, not just what you want."), PracticeQuestion(prompt = "State your red line. (costs covered)", expected = listOf("That works as long as our costs are covered."), focus = "as long as", watch = "as long as + present: the red line."), PracticeQuestion(prompt = "Push back softly on the timeline.", expected = listOf("That's difficult for our timeline."), focus = "soft pushback", watch = "Difficult, not impossible — the door stays open."), PracticeQuestion(prompt = "Offer the middle path.", expected = listOf("What if we split the difference?"), focus = "middle path", watch = "What if + present simple proposes it."), PracticeQuestion(prompt = "Ask for the agreement in writing.", expected = listOf("I'd need something in writing."), focus = "in writing", watch = "in writing — the phrase protects both sides."))), exercises = listOf(Exercise(id = "en-business-u1-negotiation-e1", kind = "choice", prompt = "___ you sign today, we can offer a discount.", options = listOf("If", "Unless", "Will", "Are"), answers = listOf("If"), explain = "If + present for the condition."), Exercise(id = "en-business-u1-negotiation-e2", kind = "gap", prompt = "We can travel ___ ___ as costs are covered. (2 words)", options = listOf(), answers = listOf("as long", "so long"), explain = "as long as = siempre que."), Exercise(id = "en-business-u1-negotiation-e3", kind = "order", prompt = "Offer the middle path.", options = listOf(), answers = listOf("What if we split the difference"), explain = "What if + present simple."), Exercise(id = "en-business-u1-negotiation-e4", kind = "written", prompt = "Summarise the deal: March, half up front.", options = listOf(), answers = listOf("so march delivery half up front", "so we agree march delivery half up front"), explain = "So + the numbers.")), skills = listOf("function:negotiate", "grammar:first-conditional", "grammar:connectors", "vocab:work", "speaking:negotiate"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:first-conditional")),
    Lesson(id = "en-business-u1-followup", title = "The follow-up", goal = "Confirm agreements in writing: recap, next steps and a clear ask.", intro = LessonIntro(explanation = listOf("The follow-up email exists to prove the meeting happened: “Just to confirm what we agreed…”. Recap in numbered lines.", "Next steps have owners and dates: “Ana will send the contract by Friday.” No owner, no date, no step.", "End with the ask, not a whisper: “Could you confirm by Thursday?” A closing without an ask closes nothing."), examples = listOf(ExampleLine(text = "Just to confirm what we agreed:", meaning = "The recap opener."), ExampleLine(text = "1. Price. 2. Timeline. 3. Contract.", meaning = "Numbered recap."), ExampleLine(text = "Ana will send the contract by Friday.", meaning = "Owner + date."), ExampleLine(text = "Could you confirm by Thursday?", meaning = "The dated ask."), ExampleLine(text = "Looking forward to working together.", meaning = "The warm close."))), expressions = listOf(TargetExpression(text = "Just to confirm, …", meaning = "Open the recap.", note = "…what we agreed in today's call."), TargetExpression(text = "numbered next steps", meaning = "Owner + date each.", note = "1. Contract — Ana — Friday."), TargetExpression(text = "Could you confirm by …?", meaning = "The dated ask.", note = "Thursday creates urgency."), TargetExpression(text = "I'll … by <day>", meaning = "Your own commitments.", note = "I'll send the proposal by Monday."), TargetExpression(text = "Looking forward to …", meaning = "The warm close.", note = "…-ing: working, hearing.")), situation = "After the negotiation call: write the confirmation email — recap the three agreed points, assign one task with a date and ask for confirmation by Thursday.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Open the confirmation email.", expected = listOf("Just to confirm what we agreed in today's call."), focus = "the opener", watch = "It exists to prove the meeting happened."), PracticeQuestion(prompt = "Assign a task with a deadline. (Ana / contract / Friday)", expected = listOf("Ana will send the contract by Friday."), focus = "owner + date", watch = "No owner, no date, no step."), PracticeQuestion(prompt = "Ask for confirmation with a date. (Thursday)", expected = listOf("Could you confirm by Thursday?"), focus = "the dated ask", watch = "A closing without an ask closes nothing."), PracticeQuestion(prompt = "Close warmly for a new client.", expected = listOf("Looking forward to working together."), focus = "warm close", watch = "look forward to + -ing."), PracticeQuestion(prompt = "Commit to your own task with a date. (proposal / Monday)", expected = listOf("I'll send the proposal by Monday."), focus = "I'll + by + date", watch = "Your commitments go in the same email."))), exercises = listOf(Exercise(id = "en-business-u1-followup-e1", kind = "choice", prompt = "Just to ___ what we agreed:", options = listOf("confirm", "check", "say", "remember"), answers = listOf("confirm"), explain = "Just to confirm — the recap opener."), Exercise(id = "en-business-u1-followup-e2", kind = "gap", prompt = "Could you ___ by Thursday? (confirmar)", options = listOf(), answers = listOf("confirm", "reply"), explain = "The dated ask."), Exercise(id = "en-business-u1-followup-e3", kind = "order", prompt = "Assign the task with a deadline.", options = listOf(), answers = listOf("Ana will send the contract by Friday"), explain = "Owner + will + by + date."), Exercise(id = "en-business-u1-followup-e4", kind = "written", prompt = "Close the email warmly.", options = listOf(), answers = listOf("looking forward to working together", "best regards"), explain = "Either warm close works.")), skills = listOf("writing:email", "function:make-requests", "grammar:going-to", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:going-to"))))
}

object EnFoundationsU1 {
    val unit = CourseUnit(id = "en-foundations-u1", title = "First sentences", subtitle = "Say who you are", level = "A1", themes = listOf(ConversationTheme("lang-exchange", "Language-exchange café", "Meet and greet", "person.2", "Course", "You are at a friendly language-exchange café. Meet the learner, exchange names, countries and jobs using the verb to be.", 0),
                ConversationTheme("introductions", "Nice to meet you", "Start somewhere small", "hand.wave", "Connection", "Meet the learner for the first time. Learn their interests through natural introductions.", 0)), lessons = listOf(    Lesson(id = "en-foundations-u1-to-be", title = "The verb “to be”", goal = "Introduce yourself and ask simple questions with am/is/are.", intro = LessonIntro(explanation = listOf("Every English sentence needs a subject and a verb. The most important verb is “to be”. It tells you what someone is, how someone feels, or where something is.", "One verb, three present forms. With I use am: “I am Ana.” With you, we and they use are: “You are my friend.” With he, she and it use is: “She is a doctor.”", "In everyday talk, English shortens it: I'm, you're, he's, she's, it's, we're, they're. When you chat, say “I'm Ana”, not “I am Ana”."), examples = listOf(ExampleLine(text = "I'm Ana. I'm from Spain.", meaning = "Your name and country."), ExampleLine(text = "You are my best friend.", meaning = "A close bond with someone."), ExampleLine(text = "She is a doctor.", meaning = "Someone's profession."), ExampleLine(text = "We are very happy today.", meaning = "A feeling right now."), ExampleLine(text = "The café is near the station.", meaning = "Where a place is."), ExampleLine(text = "They are at work.", meaning = "Someone's location."))), expressions = listOf(TargetExpression(text = "I'm …", meaning = "Introduce yourself.", note = "With your name, age or feeling: I'm Ana. I'm tired."), TargetExpression(text = "I'm from …", meaning = "Say where you come from.", note = "Never “I from …” — the am is obligatory."), TargetExpression(text = "Are you …?", meaning = "Ask about the other person.", note = "Are you a student? Are you tired?"), TargetExpression(text = "Yes, I am. / No, I'm not.", meaning = "Short answers to an Are-you question.", note = "Repeat the verb: never “Yes, I”."), TargetExpression(text = "He's / She's a …", meaning = "Talk about other people's jobs.", note = "He's a teacher — the a matters with professions."), TargetExpression(text = "Nice to meet you.", meaning = "The fixed phrase when you meet someone.", note = "Answer with the same phrase.")), situation = "You meet someone new at a friendly language-exchange café. Introduce yourselves and ask simple questions with the verb to be.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Hello! I'm Ana. What's your name?", expected = listOf("I'm <name>.", "My name is <name>."), focus = "I am / My name is", watch = "Answering only the name without the verb: accept it, then recast with “I'm …”."), PracticeQuestion(prompt = "Where are you from?", expected = listOf("I'm from <country>.", "I am from <country>."), focus = "are + from", watch = "“I from Spain” — recast “I am FROM Spain”, stress am."), PracticeQuestion(prompt = "Are you a student?", expected = listOf("Yes, I am.", "No, I'm not. I'm a <job>."), focus = "short answers with am", watch = "“Yes, I student” — the short answer needs am."), PracticeQuestion(prompt = "How are you today?", expected = listOf("I'm fine.", "I'm good.", "I'm tired."), focus = "I'm + feeling", watch = "“I fine” — recast “I'm fine”."), PracticeQuestion(prompt = "Is your city big or small?", expected = listOf("It's big.", "It's small.", "My city is …"), focus = "is with things and places", watch = "“My city big” — recast “My city IS big”."), PracticeQuestion(prompt = "We're friends now! Where is your family from?", expected = listOf("They're from <country>.", "My family is from <country>."), focus = "they are / a group is", watch = "“My family from …” — recast with is."))), exercises = listOf(Exercise(id = "en-foundations-u1-to-be-e1", kind = "choice", prompt = "She ___ a doctor.", options = listOf("is", "are", "am", "be"), answers = listOf("is"), explain = "With he, she and it, to be becomes is."), Exercise(id = "en-foundations-u1-to-be-e2", kind = "gap", prompt = "They ___ my friends.", options = listOf(), answers = listOf("are"), explain = "With they, to be is always are."), Exercise(id = "en-foundations-u1-to-be-e3", kind = "order", prompt = "Say where you are from.", options = listOf(), answers = listOf("I am from Spain"), explain = "Am goes with I: I am from …"), Exercise(id = "en-foundations-u1-to-be-e4", kind = "written", prompt = "Introduce yourself in one sentence: say your name.", options = listOf(), answers = listOf("I'm <name>", "My name is <name>", "I am <name>"), explain = "I'm Ana / My name is Ana — the verb is never dropped.")), skills = listOf("grammar:verb-be", "grammar:subject-pronouns", "function:introduce-yourself", "vocab:introductions", "speaking:short-answer"), canDo = listOf("introduce-yourself")),
    Lesson(id = "en-foundations-u1-questions", title = "Questions & negatives with “to be”", goal = "Ask yes/no and wh- questions, and say what is not true, with am/is/are.", intro = LessonIntro(explanation = listOf("To ask a yes/no question, put the verb first. “You are tired.” becomes “Are you tired?” “She is a teacher.” becomes “Is she a teacher?”", "To say something is not true, add not. “I am not late.” In talk we shorten: is not → isn't, are not → aren't. And I'm not is already short.", "Real questions add question words: what, where, who, how. They go before the verb: “Where are you from?” Short forms: what's = what is, where's = where is."), examples = listOf(ExampleLine(text = "Are you hungry?", meaning = "A yes/no question with are."), ExampleLine(text = "Is she your sister?", meaning = "Asking about another person."), ExampleLine(text = "I'm not tired.", meaning = "A negative with I."), ExampleLine(text = "He isn't at work today.", meaning = "is not, shortened."), ExampleLine(text = "Where are the keys?", meaning = "Question word + are."), ExampleLine(text = "What's your phone number?", meaning = "what's = what is."))), expressions = listOf(TargetExpression(text = "Are you …?", meaning = "Ask a yes/no question.", note = "Are you OK? Are you new here?"), TargetExpression(text = "I'm not …", meaning = "Say what is not true about you.", note = "I'm not from Madrid — I'm from Seville."), TargetExpression(text = "isn't / aren't", meaning = "Say what is not true about others.", note = "She isn't here. They aren't at home."), TargetExpression(text = "Where is / are …?", meaning = "Ask about a place.", note = "Where's the station? Where are my keys?"), TargetExpression(text = "What's …?", meaning = "Ask what something is.", note = "What's this? What's your number?"), TargetExpression(text = "How old are you?", meaning = "Ask about age.", note = "The answer: I'm twenty-five.")), situation = "You chat with a new neighbour in the lift. Ask simple questions and say what is and isn't true for you.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Hi! Are you new in the building?", expected = listOf("Yes, I am.", "No, I'm not. I'm on the third floor."), focus = "short answers with am", watch = "“Yes, I new” — short answers repeat am."), PracticeQuestion(prompt = "Is your flat big?", expected = listOf("Yes, it is.", "No, it isn't."), focus = "short answers with is", watch = "“No, it not big” — the negative is isn't."), PracticeQuestion(prompt = "I'm Marta, by the way. What's your name?", expected = listOf("I'm <name>.", "My name is <name>."), focus = "what's + name", watch = "“What you name?” — the question needs is: “What's your name?”."), PracticeQuestion(prompt = "Where are you from?", expected = listOf("I'm from <country>.", "I am from <country>."), focus = "where + are", watch = "“Where you from?” — don't drop are."), PracticeQuestion(prompt = "Are your neighbours friendly?", expected = listOf("Yes, they are.", "No, they aren't."), focus = "short answers with are", watch = "“Yes, they friendly” — repeat are."), PracticeQuestion(prompt = "I'm not from this city — I'm from Valencia. And you?", expected = listOf("I'm from <city>.", "I'm not from here either."), focus = "negative with I'm", watch = "“I no from …” — the negative is “I'm not from …”."))), exercises = listOf(Exercise(id = "en-foundations-u1-questions-e1", kind = "choice", prompt = "___ you tired?", options = listOf("Are", "Is", "Am", "Be"), answers = listOf("Are"), explain = "With you, the question starts with Are."), Exercise(id = "en-foundations-u1-questions-e2", kind = "gap", prompt = "___ she your sister?", options = listOf(), answers = listOf("is"), explain = "With she, questions start with Is."), Exercise(id = "en-foundations-u1-questions-e3", kind = "order", prompt = "Ask where the person is from.", options = listOf(), answers = listOf("Where are you from"), explain = "Question word + are + you."), Exercise(id = "en-foundations-u1-questions-e4", kind = "written", prompt = "Make it negative: \"I am late.\"", options = listOf(), answers = listOf("I'm not late", "I am not late"), explain = "I'm not is already short; is not → isn't, are not → aren't.")), skills = listOf("grammar:verb-be", "grammar:present-questions", "function:ask-simple-questions", "speaking:short-answer"), prerequisites = listOf("grammar:subject-pronouns")),
    Lesson(id = "en-foundations-u1-introduce", title = "Introducing yourself", goal = "Give a complete self-introduction: name, age, country, nationality and job.", intro = LessonIntro(explanation = listOf("A good introduction answers five small questions: your name, your age, your country or city, your nationality, and your job.", "In English, age and nationality use the verb to be. “I'm 30.” “I'm Mexican.” Say “I'm 30”, never “I have 30”.", "With jobs we say a/an: “I'm a nurse.” “He's an engineer.” Nationality words are adjectives: from Spain → I'm Spanish; from Mexico → I'm Mexican."), examples = listOf(ExampleLine(text = "I'm Elena. I'm twenty-eight.", meaning = "Name and age."), ExampleLine(text = "I'm from Peru.", meaning = "Country with from."), ExampleLine(text = "I'm Peruvian.", meaning = "Nationality with be."), ExampleLine(text = "I'm a nurse.", meaning = "Job with a."), ExampleLine(text = "He's an engineer.", meaning = "an before a vowel sound."), ExampleLine(text = "We're students.", meaning = "Plural with are."))), expressions = listOf(TargetExpression(text = "I'm <name>.", meaning = "Your name.", note = "The simplest way to start."), TargetExpression(text = "I'm … years old.", meaning = "Your age.", note = "I'm 25 = I'm twenty-five years old."), TargetExpression(text = "I'm from …", meaning = "Your country or city.", note = "I'm from Colombia."), TargetExpression(text = "I'm <nationality>.", meaning = "Adjective with be: Spanish, Turkish, Brazilian.", note = "From Japan → I'm Japanese."), TargetExpression(text = "I'm a/an <job>.", meaning = "Your job. Use an before a vowel sound.", note = "an artist, a teacher"), TargetExpression(text = "Nice to meet you too.", meaning = "The polite answer to “Nice to meet you”.", note = "Same smile, one extra word: too.")), situation = "First day in class: the teacher asks everyone to stand up and introduce themselves to two classmates.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Good morning! Please introduce yourself.", expected = listOf("I'm <name>.", "My name is <name>."), focus = "opening a self-introduction", watch = "One line is fine — the tutor will ask for more."), PracticeQuestion(prompt = "Lovely to meet you. How old are you?", expected = listOf("I'm <number>.", "I'm <number> years old."), focus = "age with be", watch = "“I have 25” — age uses be: “I'm 25”."), PracticeQuestion(prompt = "Where are you from?", expected = listOf("I'm from <country>.", "I'm from <city>, in <country>."), focus = "origin", watch = "“I'm Spanish from Spain” — keep it simple: “I'm from …”."), PracticeQuestion(prompt = "So you're from Italy — you're Italian, right?", expected = listOf("Yes, I'm Italian.", "That's right."), focus = "nationality adjectives", watch = "“I'm Italy” — the country is Italy, the person is Italian."), PracticeQuestion(prompt = "What's your job?", expected = listOf("I'm a <job>.", "I'm an <job>."), focus = "a/an with jobs", watch = "“I'm teacher” — jobs need a/an: “I'm a teacher”."), PracticeQuestion(prompt = "Great! Now introduce your friend: this is Carlos.", expected = listOf("He's a <job>. He's from <country>.", "This is Carlos. He's …"), focus = "talking about a third person with is", watch = "“Carlos is teacher” — add a: “a teacher”."))), exercises = listOf(Exercise(id = "en-foundations-u1-introduce-e1", kind = "choice", prompt = "I ___ from Spain.", options = listOf("am", "is", "are", "be"), answers = listOf("am"), explain = "With I, always am — even in short answers."), Exercise(id = "en-foundations-u1-introduce-e2", kind = "gap", prompt = "Nice to ___ you.", options = listOf(), answers = listOf("meet"), explain = "The fixed greeting is Nice to meet you."), Exercise(id = "en-foundations-u1-introduce-e3", kind = "order", prompt = "Say your country.", options = listOf(), answers = listOf("I'm from Spain"), explain = "Never “I from …” — the am is obligatory."), Exercise(id = "en-foundations-u1-introduce-e4", kind = "written", prompt = "Say your name and your job.", options = listOf(), answers = listOf("I'm <name> and I'm a <job>", "I'm <name>. I'm a <job>", "My name is <name> and I'm a <job>"), explain = "Use a before jobs: a teacher, a doctor.")), skills = listOf("grammar:verb-be", "function:introduce-yourself", "vocab:introductions", "vocab:work", "speaking:short-answer", "pron:word-stress"), canDo = listOf("introduce-yourself", "describe-people"))))
}

object EnFoundationsU2 {
    val unit = CourseUnit(id = "en-foundations-u2", title = "People & things", subtitle = "Name your world", level = "A1", themes = listOf(ConversationTheme("photo-album", "Family photo album", "Who's who", "photo.on.rectangle.angled", "Course", "You show the learner a family photo album. Name the people, ask about each other's families and say who has what.", 0),
                ConversationTheme("lost-jumper", "The lost jumper", "Whose is it?", "tshirt", "Course", "A jumper appeared in the classroom. Help find its owner: ask what things are, whose they are and what they look like.", 1)), lessons = listOf(    Lesson(id = "en-foundations-u2-articles", title = "a/an, the & plurals", goal = "Talk about one thing, a specific thing and many things.", intro = LessonIntro(explanation = listOf("Use a or an for one of many — any one. Use an before a vowel sound: a book, an apple, an hour.", "Use the when the listener knows exactly which one. First we introduce with a/an (“I have a cat”), then we talk about it with the (“The cat is old”).", "For more than one, most words take -s: book → books. After -s, -sh, -ch, -x we add -es: bus → buses, watch → watches. A few are special: person → people, child → children."), examples = listOf(ExampleLine(text = "I have a question.", meaning = "One of many."), ExampleLine(text = "She's an artist.", meaning = "an before a vowel sound."), ExampleLine(text = "Open the window, please.", meaning = "Both people know which one."), ExampleLine(text = "I have two brothers.", meaning = "Plural with -s."), ExampleLine(text = "The buses are slow.", meaning = "Plural + the."), ExampleLine(text = "The children are at school.", meaning = "Irregular plural: child → children."))), expressions = listOf(TargetExpression(text = "a/an + thing", meaning = "One of many; an before a vowel sound.", note = "a key, an umbrella"), TargetExpression(text = "the + thing", meaning = "The one we both know.", note = "Close the door, please."), TargetExpression(text = "two/three + plural", meaning = "Most words take -s.", note = "three books, ten days"), TargetExpression(text = "-es after s/sh/ch/x", meaning = "bus → buses, watch → watches.", note = "Listen for the extra syllable."), TargetExpression(text = "people / children", meaning = "Special plurals: person → people, child → children.", note = "Never “two persons” in everyday talk."), TargetExpression(text = "Can I have a …, please?", meaning = "Ask for one thing politely.", note = "a coffee, a minute")), situation = "You help at a small shop on market day: count things, name things and ask for one specific item.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Welcome! Can I help you?", expected = listOf("Can I have a <thing>, please?", "I want a <thing>, please."), focus = "a + first mention", watch = "The first time you name a thing: a/an, not the."), PracticeQuestion(prompt = "This one here on the shelf? The blue one?", expected = listOf("Yes, the blue one, please.", "No, the red one."), focus = "the + known thing", watch = "“Yes, blue one” — keep the: “the blue one”."), PracticeQuestion(prompt = "How many bags do you need?", expected = listOf("I need two bags.", "Three, please."), focus = "plurals", watch = "“two bag” — plural needs -s: “two bags”."), PracticeQuestion(prompt = "Do you want apples or oranges?", expected = listOf("I want two apples.", "Three oranges, please."), focus = "plural -s with food", watch = "“three orange” — add -s."), PracticeQuestion(prompt = "The watches are over there. How many do you need?", expected = listOf("One watch, please.", "Two watches."), focus = "-es spelling", watch = "“two watchs” — after ch it's “watches”."), PracticeQuestion(prompt = "Is your family big?", expected = listOf("Yes — four people at home.", "No, we are two."), focus = "people", watch = "“four persons” — say “people”."))), exercises = listOf(Exercise(id = "en-foundations-u2-articles-e1", kind = "choice", prompt = "I have ___ idea.", options = listOf("an", "a", "the", "some"), answers = listOf("an"), explain = "An before vowel sounds: an idea, an hour."), Exercise(id = "en-foundations-u2-articles-e2", kind = "gap", prompt = "Look at ___ sun. It is hot.", options = listOf(), answers = listOf("the"), explain = "There is one sun, so use the."), Exercise(id = "en-foundations-u2-articles-e3", kind = "order", prompt = "Say what they do (plural).", options = listOf(), answers = listOf("They are teachers"), explain = "Plural jobs take no article: they are teachers."), Exercise(id = "en-foundations-u2-articles-e4", kind = "written", prompt = "Complete with two things: I need a ___ and an ___.", options = listOf(), answers = listOf("a <thing> and an <thing>", "<thing> and <thing>"), explain = "a + consonant sound, an + vowel sound.")), skills = listOf("grammar:articles", "grammar:plurals", "vocab:home"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:verb-be")),
    Lesson(id = "en-foundations-u2-this-that", title = "This / that & my / your", goal = "Point at things near and far, and say who they belong to.", intro = LessonIntro(explanation = listOf("Use this for something near you, that for something far from you both. Plurals: these (near) and those (far).", "Possessive words go before the thing: my, your, his, her. “This is my bag.” “That's your coat.” “Her name is Ana.”", "To ask about the owner: “Is this your …?” or “Whose is this?” The answer repeats the owner: “It's mine.” / “No, it's his.”"), examples = listOf(ExampleLine(text = "This is my desk.", meaning = "Near me."), ExampleLine(text = "That's our teacher.", meaning = "Far from us."), ExampleLine(text = "Is this your phone?", meaning = "Asking the owner."), ExampleLine(text = "These are my keys.", meaning = "Plural, near."), ExampleLine(text = "Those are her children.", meaning = "Plural, far."), ExampleLine(text = "Whose umbrella is this?", meaning = "Asking whose it is."))), expressions = listOf(TargetExpression(text = "This is …", meaning = "Near me.", note = "This is my friend Ana."), TargetExpression(text = "That's …", meaning = "Far from us.", note = "That's the bus!"), TargetExpression(text = "Is this your …?", meaning = "Ask if it belongs to the listener.", note = "Is this your seat?"), TargetExpression(text = "my / your / his / her", meaning = "Belonging, before the noun.", note = "his car, her house"), TargetExpression(text = "these / those", meaning = "Plurals: these near, those far.", note = "These shoes, those mountains."), TargetExpression(text = "Whose is this?", meaning = "Ask about the owner.", note = "Answer: “It's mine”.")), situation = "You and the learner arrive early to class and find bags, phones and coats on the tables: identify what's near, what's far, and who owns what.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Good morning! Is this your bag on the chair?", expected = listOf("Yes, it's my bag.", "Yes, it's mine.", "No, it isn't."), focus = "this + my", watch = "“Yes, is my bag” — English needs it: “Yes, it's my bag”."), PracticeQuestion(prompt = "And this phone? Whose is it?", expected = listOf("It's mine.", "It's my phone.", "I don't know."), focus = "whose", watch = "“It's of Ana” — no of: “It's mine”."), PracticeQuestion(prompt = "Look at the board — do you see those words?", expected = listOf("Yes, I see those words.", "Which words?"), focus = "that/those for far things", watch = "“this words” for far things — use “those”."), PracticeQuestion(prompt = "I'm holding two keys. Are these your keys?", expected = listOf("Yes, they're my keys.", "No, they aren't mine."), focus = "these + plural", watch = "“this keys” — plural near is “these keys”."), PracticeQuestion(prompt = "Is that your bike outside?", expected = listOf("Yes, it's my bike.", "No, it isn't."), focus = "that + far", watch = "Far away: that, not this."), PracticeQuestion(prompt = "Whose gloves are those on the floor?", expected = listOf("They're mine!", "I don't know. They aren't mine."), focus = "those + whose", watch = "“They is mine” — plural: “they're mine”."))), exercises = listOf(Exercise(id = "en-foundations-u2-this-that-e1", kind = "choice", prompt = "___ is my bag. Here, in my hand.", options = listOf("This", "That", "Those", "It"), answers = listOf("This"), explain = "This points at something near you."), Exercise(id = "en-foundations-u2-this-that-e2", kind = "gap", prompt = "___ is your coat over there.", options = listOf(), answers = listOf("That"), explain = "That points at something far away."), Exercise(id = "en-foundations-u2-this-that-e3", kind = "order", prompt = "Ask about this phone (near you).", options = listOf(), answers = listOf("Is this your phone"), explain = "Is + this + the thing."), Exercise(id = "en-foundations-u2-this-that-e4", kind = "written", prompt = "Point at something near you and say what it is.", options = listOf(), answers = listOf("This is my <thing>", "This is a <thing>", "This is the <thing>"), explain = "This is + my/a/the + thing.")), skills = listOf("grammar:demonstratives", "grammar:possessives", "vocab:home", "pron:th"), prerequisites = listOf("grammar:subject-pronouns", "grammar:plurals")),
    Lesson(id = "en-foundations-u2-have-got", title = "“Have got”: family", goal = "Say who is in your family and what you have, with have got.", intro = LessonIntro(explanation = listOf("have got = have. Use it for family, pets and things: “I've got two sisters.” “She's got a dog.” With he/she/it use has got.", "Questions flip it: “Have you got any brothers?” Negatives add not: “I haven't got a car.” “He hasn't got time.”", "Family words: mother and father (parents), brother, sister, son, daughter, grandmother and grandfather (grandparents). In talk: mum, dad, grandma, grandpa."), examples = listOf(ExampleLine(text = "I've got one brother.", meaning = "have got with I."), ExampleLine(text = "She's got three cousins.", meaning = "has got with she."), ExampleLine(text = "Have you got any pets?", meaning = "Question with have."), ExampleLine(text = "I haven't got a sister.", meaning = "Negative with not."), ExampleLine(text = "My parents have got a small dog.", meaning = "Plural have."), ExampleLine(text = "We've got the same phone!", meaning = "Shared possession."))), expressions = listOf(TargetExpression(text = "I've got …", meaning = "I have: family, pets, things.", note = "I've got two brothers."), TargetExpression(text = "She's / He's got …", meaning = "has got with one person.", note = "He's got a beard."), TargetExpression(text = "Have you got …?", meaning = "Ask about family or things.", note = "Have you got any pets?"), TargetExpression(text = "haven't got / hasn't got", meaning = "Say what you don't have.", note = "I haven't got siblings."), TargetExpression(text = "any", meaning = "With questions and negatives.", note = "Have you got any cousins?"), TargetExpression(text = "the youngest / the oldest", meaning = "Order in the family.", note = "I'm the youngest of three.")), situation = "You swap family photos: describe your family, ask about the learner's, and compare what you both have.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Tell me about your family — have you got brothers or sisters?", expected = listOf("I've got <number> brother(s).", "I haven't got any siblings.", "I'm an only child."), focus = "have got + family", watch = "“I have two brother” — plural -s and got: “I've got two brothers”."), PracticeQuestion(prompt = "Have you got any pets?", expected = listOf("Yes, I've got a <pet>.", "No, I haven't got any pets."), focus = "any with questions", watch = "“Have you got some pets?” — questions use any."), PracticeQuestion(prompt = "Has your mum got a car?", expected = listOf("Yes, she has.", "No, she hasn't."), focus = "has short answers", watch = "“Yes, she got” — short answers repeat has."), PracticeQuestion(prompt = "Are you the oldest, the youngest or in the middle?", expected = listOf("I'm the oldest of three.", "I'm in the middle.", "I'm an only child."), focus = "family position", watch = "“I am more old” — “the oldest”."), PracticeQuestion(prompt = "Have your parents got a garden?", expected = listOf("Yes, they have. They've got flowers.", "No, they haven't."), focus = "they + have got", watch = "“They has got” — plural takes have."), PracticeQuestion(prompt = "I've got a big family — six of us! And you?", expected = listOf("We are <number>.", "There are <number> of us."), focus = "saying family size", watch = "“We is five” — “we are five”."))), exercises = listOf(Exercise(id = "en-foundations-u2-have-got-e1", kind = "choice", prompt = "She ___ got two brothers.", options = listOf("has", "have", "is", "does"), answers = listOf("has"), explain = "With he/she/it: has got."), Exercise(id = "en-foundations-u2-have-got-e2", kind = "gap", prompt = "I ___ got a big family.", options = listOf(), answers = listOf("have"), explain = "With I/you/we/they: have got."), Exercise(id = "en-foundations-u2-have-got-e3", kind = "order", prompt = "Ask about sisters.", options = listOf(), answers = listOf("Have you got any sisters"), explain = "Have + you + got + any + plural."), Exercise(id = "en-foundations-u2-have-got-e4", kind = "written", prompt = "Say how many brothers or sisters you have got.", options = listOf(), answers = listOf("I've got <number> brothers and <number> sisters", "I've got <number> brother and <number> sister", "I haven't got any brothers or sisters"), explain = "I've got + number + family word.")), skills = listOf("grammar:have-got", "vocab:family", "function:describe-people"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:articles"))))
}

object EnFoundationsU3 {
    val unit = CourseUnit(id = "en-foundations-u3", title = "Everyday actions", subtitle = "Your week, out loud", level = "A1", themes = listOf(ConversationTheme("morning-rush", "The morning rush", "Against the clock", "sunrise", "Course", "It's 7:40 and you both have somewhere to be. Describe your morning routine while the clock runs.", 0),
                ConversationTheme("evening-wind-down", "After work", "The quiet hours", "moon.stars", "Course", "It's the end of the day. Tell each other what you do in the evening and how you unwind.", 1)), lessons = listOf(    Lesson(id = "en-foundations-u3-present", title = "Present simple: I / you / we / they", goal = "Talk about routines and facts with I/you/we/they, and ask with do.", intro = LessonIntro(explanation = listOf("The present simple is for habits and facts: “I work in a bank.” “We live near the park.” With I, you, we and they the verb has no ending.", "Questions and negatives use do: “Do you like coffee?” “I don't eat meat.” The main verb goes back to its simple form.", "Short answers repeat do: “Do you speak English?” — “Yes, I do.” / “No, I don't.”"), examples = listOf(ExampleLine(text = "I work from home.", meaning = "Habit, no ending."), ExampleLine(text = "Do you live alone?", meaning = "Question with do."), ExampleLine(text = "We don't watch TV.", meaning = "Negative with don't."), ExampleLine(text = "They play football on Saturdays.", meaning = "Routine + plural."), ExampleLine(text = "Yes, I do.", meaning = "Short answer."), ExampleLine(text = "You know the answer.", meaning = "Fact with you."))), expressions = listOf(TargetExpression(text = "I work / live / study …", meaning = "Habits with no ending.", note = "I live with two friends."), TargetExpression(text = "Do you …?", meaning = "Ask about routines.", note = "Do you work nearby?"), TargetExpression(text = "I don't …", meaning = "Negative habits.", note = "I don't drink coffee."), TargetExpression(text = "Yes, I do. / No, I don't.", meaning = "Short answers with do.", note = "Repeat do, not the verb."), TargetExpression(text = "on Mondays / at weekends", meaning = "When habits happen.", note = "I play tennis on Sundays."), TargetExpression(text = "What do you do?", meaning = "Ask about someone's job.", note = "Answer: “I'm a …”.")), situation = "Two neighbours chat in the square about their week: jobs, habits and what they never do.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "So, what do you do?", expected = listOf("I'm a <job>.", "I work as a <job>.", "I'm a student."), focus = "asking about jobs", watch = "“What you do?” — questions need do."), PracticeQuestion(prompt = "Do you like your job?", expected = listOf("Yes, I do.", "No, I don't.", "It's OK."), focus = "like + do short answers", watch = "“Yes, I like” — short answer is “Yes, I do”."), PracticeQuestion(prompt = "Where do you work?", expected = listOf("I work <place>.", "I work from home.", "I don't work — I study."), focus = "where + do", watch = "“I work in home” — “from home”."), PracticeQuestion(prompt = "Do you speak any other languages?", expected = listOf("Yes, I do. I speak <language>.", "No, I don't."), focus = "do + language verbs", watch = "“I no speak” — “I don't speak”."), PracticeQuestion(prompt = "What do you and your friends do at weekends?", expected = listOf("We play …", "We go …", "We don't go out much."), focus = "we habits", watch = "“We plays” — with we there's no -s."), PracticeQuestion(prompt = "I don't watch much TV. Do you?", expected = listOf("No, I don't.", "Yes, I do. I watch …"), focus = "echo questions with do", watch = "Short answers use do, not the verb."))), exercises = listOf(Exercise(id = "en-foundations-u3-present-e1", kind = "choice", prompt = "They ___ in Madrid.", options = listOf("live", "lives", "living", "does live"), answers = listOf("live"), explain = "With they there is no -s: they live."), Exercise(id = "en-foundations-u3-present-e2", kind = "gap", prompt = "___ you work near here?", options = listOf(), answers = listOf("do"), explain = "Questions with you need Do."), Exercise(id = "en-foundations-u3-present-e3", kind = "order", prompt = "Say you do not eat meat.", options = listOf(), answers = listOf("We don't eat meat"), explain = "don't + base verb: We don't eat."), Exercise(id = "en-foundations-u3-present-e4", kind = "written", prompt = "Say one thing you do every day.", options = listOf(), answers = listOf("I <verb> every day", "Every day I <verb>"), explain = "Present simple for routines: I work, I walk, I cook.")), skills = listOf("grammar:present-simple", "grammar:present-questions", "vocab:daily-routine", "function:talk-about-routines"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:subject-pronouns")),
    Lesson(id = "en-foundations-u3-third-person", title = "He / she / it + -s & frequency", goal = "Describe another person's routines with the -s ending and say how often things happen.", intro = LessonIntro(explanation = listOf("With he, she and it the present simple verb takes -s: “She works at night.” “He likes jazz.” This -s is small but very important.", "Questions and negatives use does: “Does she live here?” “He doesn't drive.” After does the verb loses its -s: not “Does she works?”", "Frequency words say how often: always, usually, often, sometimes, never. They go before the verb: “I always walk to work.” But after be: “He is never late.”"), examples = listOf(ExampleLine(text = "She works in a hospital.", meaning = "Third person -s."), ExampleLine(text = "He watches TV after dinner.", meaning = "-es after ch."), ExampleLine(text = "Does she speak French?", meaning = "Question with does."), ExampleLine(text = "It doesn't open on Sundays.", meaning = "Negative with doesn't."), ExampleLine(text = "I never drink energy drinks.", meaning = "never + verb."), ExampleLine(text = "He's always on time.", meaning = "Frequency after be."))), expressions = listOf(TargetExpression(text = "She + verb-s", meaning = "Third person needs -s.", note = "She plays the guitar."), TargetExpression(text = "Does he …?", meaning = "Ask about another person.", note = "Does he live alone?"), TargetExpression(text = "doesn't + verb", meaning = "He/she/it negative, no -s.", note = "It doesn't matter."), TargetExpression(text = "always / usually / sometimes / never", meaning = "How often, before the verb.", note = "I usually cook at home."), TargetExpression(text = "-es after ch/sh/s", meaning = "watches, washes, misses.", note = "She watches the news."), TargetExpression(text = "How often …?", meaning = "Ask about frequency.", note = "How often do you swim?")), situation = "You catch up about a mutual friend: describe her routines, how often she does things and what she never does.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Tell me about your best friend — where does she live?", expected = listOf("She lives <place>.", "He lives <place>."), focus = "does + lives", watch = "“Where does she lives?” — after does, no -s."), PracticeQuestion(prompt = "What does he do at weekends?", expected = listOf("He plays …", "He goes …", "He watches …"), focus = "third person -s", watch = "“He play” — he needs -s: “He plays”."), PracticeQuestion(prompt = "Does she like football?", expected = listOf("Yes, she does.", "No, she doesn't."), focus = "does short answers", watch = "“Yes, she likes” — short answer: “Yes, she does”."), PracticeQuestion(prompt = "How often do you cook?", expected = listOf("Every day.", "Twice a week.", "I never cook."), focus = "frequency answers", watch = "“I cook two times week” — “twice a week”."), PracticeQuestion(prompt = "Is your brother always late?", expected = listOf("Yes, he's always late.", "No, he's never late."), focus = "always/never after be", watch = "“He always is late” — after be: “He's always late”."), PracticeQuestion(prompt = "My sister never drinks coffee — she hates it. And your family?", expected = listOf("My <relative> never …", "They always …"), focus = "frequency with family", watch = "“My mum never drink” — keep the -s after never."))), exercises = listOf(Exercise(id = "en-foundations-u3-third-person-e1", kind = "choice", prompt = "He ___ football on Sundays.", options = listOf("plays", "play", "playing", "is play"), answers = listOf("plays"), explain = "With he/she/it the verb takes -s."), Exercise(id = "en-foundations-u3-third-person-e2", kind = "gap", prompt = "She ___ English at night. (study)", options = listOf(), answers = listOf("studies"), explain = "Consonant + y → -ies: study → studies."), Exercise(id = "en-foundations-u3-third-person-e3", kind = "order", prompt = "Say where your sister works.", options = listOf(), answers = listOf("My sister works in a cafe"), explain = "Sister is she → works with -s."), Exercise(id = "en-foundations-u3-third-person-e4", kind = "written", prompt = "Presénte a Ana: ¿qué habla? (inglés)", options = listOf(), answers = listOf("Ana speaks English", "She speaks English"), explain = "Ana = she → speak + s.")), skills = listOf("grammar:third-person-s", "grammar:frequency-adverbs", "function:talk-about-routines", "pron:third-person-s"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "en-foundations-u3-time", title = "Time & daily routine", goal = "Tell the time and describe your day in order.", intro = LessonIntro(explanation = listOf("Ask with “What time is it?” Answer with o'clock for exact hours: “It's seven o'clock.” For halves say half past: “It's half past seven” (7:30).", "Use at for clock times (“at eight”), in the morning/afternoon/evening, and at night.", "Order your day with first, then, after that and finally. They make a story out of your routine."), examples = listOf(ExampleLine(text = "What time is it?", meaning = "Asking the time."), ExampleLine(text = "It's half past six.", meaning = "6:30."), ExampleLine(text = "I get up at six thirty.", meaning = "at + clock time."), ExampleLine(text = "I run in the morning.", meaning = "Part of the day."), ExampleLine(text = "First I shower, then I dress.", meaning = "Order words."), ExampleLine(text = "Finally, I go to bed at eleven.", meaning = "The last step."))), expressions = listOf(TargetExpression(text = "What time is it?", meaning = "The time question.", note = "Answer: “It's …”."), TargetExpression(text = "It's … o'clock / half past …", meaning = "Exact hours and halves.", note = "It's four o'clock."), TargetExpression(text = "at + time", meaning = "Clock times take at.", note = "The film starts at nine."), TargetExpression(text = "in the morning / at night", meaning = "Parts of the day.", note = "in the evening, at night"), TargetExpression(text = "I get up at …", meaning = "Start your day.", note = "Opposite: I go to bed at …"), TargetExpression(text = "first / then / after that / finally", meaning = "Put actions in order.", note = "First coffee, then email.")), situation = "The learner's first day at a new job: plan the morning together, minute by minute, from waking up to the first meeting.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Quick — what time is it?", expected = listOf("It's <time>.", "It's half past <hour>.", "It's <hour> o'clock."), focus = "telling the time", watch = "“Is seven o'clock” — statements need it's."), PracticeQuestion(prompt = "What time do you get up?", expected = listOf("I get up at <time>."), focus = "at + time", watch = "“I get up in seven” — clock times take at."), PracticeQuestion(prompt = "Do you have breakfast before or after your shower?", expected = listOf("Before. First I …, then I …", "After — first I …"), focus = "first/then", watch = "Answer in order: first …, then …"), PracticeQuestion(prompt = "What do you do in the evening?", expected = listOf("In the evening I …", "I usually …"), focus = "in the evening", watch = "“in the night” — evening or “at night”."), PracticeQuestion(prompt = "When do you go to bed?", expected = listOf("I go to bed at <time>.", "Around <time>."), focus = "go to bed", watch = "“I go to the bed” — no the: “go to bed”."), PracticeQuestion(prompt = "Describe your morning in order — first, then, after that.", expected = listOf("First I …, then I …, after that I …"), focus = "sequencing", watch = "Use the order words — don't list with “and, and, and”."))), exercises = listOf(Exercise(id = "en-foundations-u3-time-e1", kind = "choice", prompt = "It's 7:30. It's half ___ seven.", options = listOf("past", "to", "at", "on"), answers = listOf("past"), explain = "Half past = y media."), Exercise(id = "en-foundations-u3-time-e2", kind = "gap", prompt = "I get up ___ seven o'clock.", options = listOf(), answers = listOf("at"), explain = "Clock times take at: at seven."), Exercise(id = "en-foundations-u3-time-e3", kind = "order", prompt = "Say what comes after getting up.", options = listOf(), answers = listOf("Then I have breakfast"), explain = "Then orders your routine."), Exercise(id = "en-foundations-u3-time-e4", kind = "written", prompt = "Say what time you usually get up.", options = listOf(), answers = listOf("I get up at <time>", "I usually get up at <time>"), explain = "get up at + time.")), skills = listOf("grammar:time-expressions", "vocab:daily-routine", "function:tell-time", "listening:number-time"), canDo = listOf("tell-time"), prerequisites = listOf("grammar:present-simple"))))
}

object EnFoundationsU4 {
    val unit = CourseUnit(id = "en-foundations-u4", title = "Getting around", subtitle = "Out in the city", level = "A1", themes = listOf(ConversationTheme("neighbourhood", "A new neighbourhood", "Find your way", "map", "Course", "The learner just moved to the area. Walk the streets together and describe what there is on every corner.", 0),
                ConversationTheme("lost-in-town", "Lost in town", "Ask for help", "location", "Course", "Your phone died and you are lost. Stop people, ask for directions and follow them.", 1)), lessons = listOf(    Lesson(id = "en-foundations-u4-can", title = "Can / can't", goal = "Say what you are able to do, ask others for help and give permission.", intro = LessonIntro(explanation = listOf("can never changes: “I can swim.” “She can swim.” No -s, no to. The negative is can't (or cannot in writing).", "Questions flip it: “Can you swim?” For polite requests: “Can you help me?” For permission: “Can I sit here?”", "Short answers repeat can: “Yes, I can.” / “No, I can't.”"), examples = listOf(ExampleLine(text = "I can ride a bike.", meaning = "Ability."), ExampleLine(text = "She can speak three languages.", meaning = "No -s after she."), ExampleLine(text = "Sorry, I can't come.", meaning = "Negative."), ExampleLine(text = "Can you repeat that, please?", meaning = "Polite request."), ExampleLine(text = "Can I pay by card?", meaning = "Permission."), ExampleLine(text = "Yes, you can.", meaning = "Short answer."))), expressions = listOf(TargetExpression(text = "I can / can't …", meaning = "Ability, no changes.", note = "I can drive, but I can't park!"), TargetExpression(text = "Can you …, please?", meaning = "Polite request.", note = "Can you help me, please?"), TargetExpression(text = "Can I …?", meaning = "Ask permission.", note = "Can I open the window?"), TargetExpression(text = "Yes, of course.", meaning = "Warm yes to a request.", note = "Better than a plain yes."), TargetExpression(text = "Sorry, I can't.", meaning = "Soft no.", note = "Add a reason: I'm busy."), TargetExpression(text = "Can you say that again?", meaning = "Ask for a repeat.", note = "Add: “Slower, please”.")), situation = "You organise a small trip with the learner: who can drive, who can cook, and what you can't do without asking.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Can you drive?", expected = listOf("Yes, I can.", "No, I can't."), focus = "can short answers", watch = "“Yes, I drive” — repeat can: “Yes, I can”."), PracticeQuestion(prompt = "What can you cook?", expected = listOf("I can make <dish>.", "I can't cook at all!"), focus = "can + verb", watch = "“I can to cook” — no to after can."), PracticeQuestion(prompt = "Can your sister swim?", expected = listOf("Yes, she can.", "No, she can't."), focus = "can with he/she", watch = "“She cans swim” — can never takes -s."), PracticeQuestion(prompt = "Can I borrow your pen, please?", expected = listOf("Yes, of course.", "Sure, here you are."), focus = "permission + polite reply", watch = "Answer a request warmly: “Of course”."), PracticeQuestion(prompt = "Sorry, can you speak more slowly?", expected = listOf("No problem.", "Of course. Is this better?"), focus = "polite repeat request", watch = "Practise your “Sorry, can you …?” — it opens every repair."), PracticeQuestion(prompt = "What's one thing you can't do but want to learn?", expected = listOf("I can't <skill>, but I want to learn."), focus = "can't + wish", watch = "“I can't to play” — no to after can't."))), exercises = listOf(Exercise(id = "en-foundations-u4-can-e1", kind = "choice", prompt = "___ you help me, please?", options = listOf("Can", "Are", "Do", "Is"), answers = listOf("Can"), explain = "Requests start with Can you …?"), Exercise(id = "en-foundations-u4-can-e2", kind = "gap", prompt = "I ___ swim, but I can't dive.", options = listOf(), answers = listOf("can"), explain = "can never takes -s and stays with the verb."), Exercise(id = "en-foundations-u4-can-e3", kind = "order", prompt = "Say your mother cannot drive.", options = listOf(), answers = listOf("She can't drive"), explain = "can't + base verb: She can't drive."), Exercise(id = "en-foundations-u4-can-e4", kind = "written", prompt = "Ask permission to open the window.", options = listOf(), answers = listOf("Can I open the window", "Can I open the window, please"), explain = "Can I …? asks for permission.")), skills = listOf("grammar:can", "function:make-requests", "vocab:social-expressions"), prerequisites = listOf("grammar:subject-pronouns")),
    Lesson(id = "en-foundations-u4-there-is", title = "There is / there are", goal = "Say what exists in a place, and ask about it.", intro = LessonIntro(explanation = listOf("To say something exists, start with there: “There's a pharmacy on the corner.” Singular: there is (there's). Plural: “There are two parks.”", "Negatives: “There isn't a lift.” “There aren't any shops.” Questions: “Is there a bank near here?” “Are there any tickets left?”", "Say where with prepositions: next to, opposite, behind. “The café is next to the bank.”"), examples = listOf(ExampleLine(text = "There's a market on Saturdays.", meaning = "Singular exists."), ExampleLine(text = "There are two lifts.", meaning = "Plural exists."), ExampleLine(text = "There isn't a car park.", meaning = "Singular negative."), ExampleLine(text = "There aren't any bikes left.", meaning = "Plural negative + any."), ExampleLine(text = "Is there wifi here?", meaning = "Existence question."), ExampleLine(text = "The bank is opposite the school.", meaning = "Where exactly."))), expressions = listOf(TargetExpression(text = "There's a/n …", meaning = "One thing exists.", note = "There's a bakery downstairs."), TargetExpression(text = "There are (+ number) …", meaning = "Plural things exist.", note = "There are four rooms."), TargetExpression(text = "Is there … near here?", meaning = "Ask for a place.", note = "Is there a toilet here?"), TargetExpression(text = "There isn't / aren't any …", meaning = "What's missing.", note = "There aren't any chairs."), TargetExpression(text = "next to / opposite / behind", meaning = "Pin things to places.", note = "The bar is opposite us."), TargetExpression(text = "How many … are there?", meaning = "Ask for a number of things.", note = "How many stops are there?")), situation = "You show a visitor around the office building: what's on each floor, what's missing, and where exactly things are.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Is there a supermarket near your flat?", expected = listOf("Yes, there's one <where>.", "No, there isn't."), focus = "is there questions", watch = "“Is a supermarket?” — start with there."), PracticeQuestion(prompt = "How many rooms are there in your home?", expected = listOf("There are <number> rooms.", "There are three: …"), focus = "how many are there", watch = "“How many rooms has?” — with there: “are there”."), PracticeQuestion(prompt = "Is there a lift in the building?", expected = listOf("Yes, there is.", "No, there isn't. It's an old building."), focus = "short answers with there", watch = "“Yes, has lift” — repeat there is."), PracticeQuestion(prompt = "What's in your neighbourhood?", expected = listOf("There's a <place> and there are <things>."), focus = "mixing is/are", watch = "One thing → there's; more → there are."), PracticeQuestion(prompt = "Are there any good cafés around?", expected = listOf("Yes, there are two.", "No, there aren't any."), focus = "any in questions/negatives", watch = "“There aren't some cafés” — negatives take any."), PracticeQuestion(prompt = "Where exactly is the pharmacy?", expected = listOf("It's next to the bank.", "It's opposite the park."), focus = "location prepositions", watch = "“It's in front the bank” — “opposite” or “in front of”."))), exercises = listOf(Exercise(id = "en-foundations-u4-there-is-e1", kind = "choice", prompt = "___ a pharmacy near here?", options = listOf("Is there", "Are there", "There is", "Has"), answers = listOf("Is there"), explain = "Singular questions: Is there …?"), Exercise(id = "en-foundations-u4-there-is-e2", kind = "gap", prompt = "There ___ two parks in my neighbourhood.", options = listOf(), answers = listOf("are"), explain = "Plural things: there are."), Exercise(id = "en-foundations-u4-there-is-e3", kind = "order", prompt = "Say that a market exists on Saturdays.", options = listOf(), answers = listOf("There is a market on Saturdays"), explain = "There is + singular thing."), Exercise(id = "en-foundations-u4-there-is-e4", kind = "written", prompt = "Say what there is in your kitchen.", options = listOf(), answers = listOf("There is <thing>", "There are <things>", "There is a <thing>"), explain = "There is + one thing, there are + many.")), skills = listOf("grammar:there-is-are", "grammar:prepositions-place", "vocab:town"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:articles", "grammar:plurals")),
    Lesson(id = "en-foundations-u4-directions", title = "Directions & place", goal = "Give and follow simple directions from A to B.", intro = LessonIntro(explanation = listOf("Start with go straight on, then turn left or turn right. “Go straight on and turn left at the lights.”", "Say where the place is: on the left, on the right, on the corner, at the end of the street.", "Ask for directions with “How do I get to …?” or “Is it far?” Answers: “Five minutes on foot.”"), examples = listOf(ExampleLine(text = "How do I get to the station?", meaning = "The directions question."), ExampleLine(text = "Go straight on for two streets.", meaning = "Distance first."), ExampleLine(text = "Turn right at the bank.", meaning = "Turn + where."), ExampleLine(text = "It's on the corner.", meaning = "Corner position."), ExampleLine(text = "Is it far from here?", meaning = "Ask about distance."), ExampleLine(text = "About five minutes on foot.", meaning = "Time as distance."))), expressions = listOf(TargetExpression(text = "How do I get to …?", meaning = "Ask for directions.", note = "…to the museum?"), TargetExpression(text = "Go straight on.", meaning = "Keep walking.", note = "For two blocks."), TargetExpression(text = "Turn left / right at …", meaning = "Where to change direction.", note = "at the traffic lights"), TargetExpression(text = "on the left / on the right", meaning = "Which side it's on.", note = "The pharmacy is on your left."), TargetExpression(text = "Is it far?", meaning = "Ask about distance.", note = "Answer: “Ten minutes on foot”."), TargetExpression(text = "Excuse me, …", meaning = "Open every street question.", note = "Excuse me, where's the metro?")), situation = "The learner's phone has died at a crossroads: ask passers-by for the museum, understand the directions and repeat them back.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "You look lost — can I help?", expected = listOf("Yes, please. How do I get to <place>?", "Excuse me, where is <place>?"), focus = "opening a directions ask", watch = "Start with “Excuse me” — it buys goodwill."), PracticeQuestion(prompt = "OK: go straight on and turn left at the lights. Got it?", expected = listOf("Straight on, then left at the lights.", "Got it, thanks!"), focus = "repeating directions", watch = "Repeat the route back to check it."), PracticeQuestion(prompt = "Is the museum far from here?", expected = listOf("About <number> minutes on foot.", "No, it's very close."), focus = "distance answers", watch = "“It has five minutes” — “it's five minutes”."), PracticeQuestion(prompt = "When you leave, the pharmacy is on your right.", expected = listOf("On the right. Got it.", "Thank you very much."), focus = "on the left/right", watch = "“in the right” — sides take on."), PracticeQuestion(prompt = "Where's the nearest metro station?", expected = listOf("Go straight on and it's on the corner.", "Turn right at the bank."), focus = "giving directions", watch = "Give order words: straight, then turn."), PracticeQuestion(prompt = "Perfect. One last thing — is there a toilet in the museum?", expected = listOf("Yes, there is, on the left.", "I don't know."), focus = "combining there is + location", watch = "Tie it together: there is + place word."))), exercises = listOf(Exercise(id = "en-foundations-u4-directions-e1", kind = "choice", prompt = "Go ___ and then turn left.", options = listOf("straight on", "left", "right", "back"), answers = listOf("straight on"), explain = "Straight on = todo recto."), Exercise(id = "en-foundations-u4-directions-e2", kind = "gap", prompt = "Turn left ___ the traffic lights.", options = listOf(), answers = listOf("at"), explain = "Exact points take at: at the lights."), Exercise(id = "en-foundations-u4-directions-e3", kind = "order", prompt = "Say where the bank is (beside).", options = listOf(), answers = listOf("It's next to the bank"), explain = "next to = al lado de."), Exercise(id = "en-foundations-u4-directions-e4", kind = "written", prompt = "Ask where the station is.", options = listOf(), answers = listOf("Where is the station", "Where's the station"), explain = "Question word + is: Where is / Where's.")), skills = listOf("grammar:imperatives", "grammar:prepositions-place", "vocab:directions", "function:ask-for-directions"), canDo = listOf("ask-for-directions"), prerequisites = listOf("grammar:there-is-are"))))
}

object EnFoundationsNow {
    val unit = CourseUnit(id = "en-foundations-now", title = "Right now", subtitle = "What is happening", level = "A1", themes = listOf(ConversationTheme("rainy-window", "The rainy window", "Weather small talk", "cloud.rain", "Course", "You both watch the rain from a café window. Describe the weather and what people are doing outside.", 0),
                ConversationTheme("busy-kitchen", "The busy kitchen", "What is happening now", "fork.knife", "Course", "You are cooking together. Say what everyone is doing right now — and who is doing nothing!", 1)), lessons = listOf(    Lesson(id = "en-foundations-now-continuous", title = "What is happening now", goal = "Describe actions happening at this moment with am/is/are + -ing.", intro = LessonIntro(explanation = listOf("For actions happening right now, use am/is/are + verb-ing: “I am reading. She is cooking. They are playing.”", "The -ing never changes: I am eating, you are eating, he is eating. Only am/is/are changes.", "Spelling: make → making (drop the e), sit → sitting (double the consonant after one short vowel)."), examples = listOf(ExampleLine(text = "I am drinking coffee.", meaning = "An action happening now."), ExampleLine(text = "She is cooking dinner.", meaning = "Another person, is + -ing."), ExampleLine(text = "They are watching TV.", meaning = "Plural: are + -ing."), ExampleLine(text = "It's raining.", meaning = "Weather with it is + -ing."), ExampleLine(text = "He's making a cake.", meaning = "make → making: the e drops."), ExampleLine(text = "The dog is sleeping.", meaning = "Animals do things too."))), expressions = listOf(TargetExpression(text = "I'm …-ing", meaning = "What you are doing now.", note = "I'm reading a book."), TargetExpression(text = "He's / She's …-ing", meaning = "What another person is doing.", note = "She's working today."), TargetExpression(text = "They're …-ing", meaning = "What a group is doing.", note = "They're waiting for the bus."), TargetExpression(text = "It's raining / snowing", meaning = "Weather in progress.", note = "It is always it for weather."), TargetExpression(text = "… right now / at the moment", meaning = "Anchor the action to now.", note = "I'm cooking right now."), TargetExpression(text = "Look! / Listen!", meaning = "Point at an action in progress.", note = "Look! It's snowing!")), situation = "You look out of a busy café window with a friend: say what every person outside is doing at this moment.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Look at Tom — what is he doing? (football)", expected = listOf("He's playing football.", "He is playing football."), focus = "is + -ing", watch = "“He playing” — the is never drops: “He's playing”."), PracticeQuestion(prompt = "What are you doing right now?", expected = listOf("I'm <verb-ing>.", "I am <verb-ing>."), focus = "I'm + -ing", watch = "“I read” is a habit; right now it's “I'm reading”."), PracticeQuestion(prompt = "What's the weather like at this moment? (rain)", expected = listOf("It's raining.", "It is raining."), focus = "it + is + -ing", watch = "“Is raining” alone has no subject — weather needs it."), PracticeQuestion(prompt = "And your friends? (wait for us)", expected = listOf("They're waiting for us.", "They are waiting for us."), focus = "they're + -ing", watch = "“They waiting” — plural needs are."), PracticeQuestion(prompt = "Is Maria working today?", expected = listOf("Yes, she's working today.", "Yes, she is.", "Yes, she's."), focus = "short answer + -ing", watch = "“Yes, she working” — repeat is in the short answer."), PracticeQuestion(prompt = "Say two things you are not doing right now.", expected = listOf("I'm not <verb-ing>.", "I am not <verb-ing>."), focus = "negative -ing", watch = "“I not reading” — the negative is “I'm not reading”."))), exercises = listOf(Exercise(id = "en-foundations-now-continuous-e1", kind = "choice", prompt = "She ___ a letter right now.", options = listOf("is writing", "writes", "write", "writing"), answers = listOf("is writing"), explain = "Right now needs am/is/are + -ing: she is writing."), Exercise(id = "en-foundations-now-continuous-e2", kind = "gap", prompt = "Look! It ___ (rain).", options = listOf(), answers = listOf("is raining", "'s raining", "is raing"), explain = "It is raining — weather takes it."), Exercise(id = "en-foundations-now-continuous-e3", kind = "order", prompt = "Say what they are doing. (TV / watch)", options = listOf(), answers = listOf("They are watching TV"), explain = "They are + watching."), Exercise(id = "en-foundations-now-continuous-e4", kind = "written", prompt = "Complete the pair: make → ___; sit → ___.", options = listOf(), answers = listOf("making, sitting", "making sitting"), explain = "make drops the e; sit doubles the t.")), skills = listOf("grammar:present-continuous", "grammar:verb-be", "function:talk-about-routines"), prerequisites = listOf("grammar:verb-be")),
    Lesson(id = "en-foundations-now-questions", title = "Asking about now", goal = "Ask and answer present-continuous questions, and say what is not happening.", intro = LessonIntro(explanation = listOf("Questions flip the verb: “You are listening.” → “Are you listening?” “She is coming.” → “Is she coming?”", "Negatives add not: “I'm not working today.” “He isn't coming.” “They aren't sleeping.”", "Question words go first: “What are you doing?” “Where is she going?” “Who are you calling?”"), examples = listOf(ExampleLine(text = "Are you listening to me?", meaning = "A yes/no question about now."), ExampleLine(text = "Is the bus coming?", meaning = "Asking about another thing."), ExampleLine(text = "What are you doing?", meaning = "The classic question word question."), ExampleLine(text = "I'm not talking to you!", meaning = "A negative about now."), ExampleLine(text = "Where are they going?", meaning = "Question word + are."), ExampleLine(text = "No, he isn't. He's sleeping.", meaning = "Short answer, then the real action."))), expressions = listOf(TargetExpression(text = "Are you …-ing?", meaning = "Ask about the listener now.", note = "Are you coming with us?"), TargetExpression(text = "Is he/she/it …-ing?", meaning = "Ask about another person.", note = "Is the taxi coming?"), TargetExpression(text = "What are you doing?", meaning = "Ask about the current action.", note = "Nothing much — I'm reading."), TargetExpression(text = "I'm not …-ing", meaning = "Say what is not happening.", note = "I'm not eating meat this week."), TargetExpression(text = "Who is …-ing?", meaning = "Ask which person.", note = "Who is cooking tonight?"), TargetExpression(text = "Quiet! The baby's sleeping.", meaning = "Explain a stopped action.", note = "Why + negative, in one phrase.")), situation = "You phone a friend who is at a party: ask what is happening, who is doing what, and what people are not doing.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Your friend answers the phone. Ask what she is doing.", expected = listOf("What are you doing?"), focus = "what + are", watch = "“What you doing?” — informal speech drops are, but learn the full form."), PracticeQuestion(prompt = "Ask if Tom is coming to the cinema.", expected = listOf("Is Tom coming to the cinema?"), focus = "is + -ing question", watch = "“Tom is coming…?” needs a question mark of order: “Is Tom coming…?”"), PracticeQuestion(prompt = "Say you are not drinking coffee these days.", expected = listOf("I'm not drinking coffee.", "I am not drinking coffee."), focus = "negative -ing", watch = "“I no drinking” — English says “I'm not drinking”."), PracticeQuestion(prompt = "Ask where your guests are going now.", expected = listOf("Where are they going?", "Where are you going?"), focus = "where + are", watch = "“Where they going?” — keep are: “Where are they going?”"), PracticeQuestion(prompt = "Is the baby sleeping? (no)", expected = listOf("No, the baby isn't sleeping.", "No, he isn't.", "No, she isn't.", "No, it isn't."), focus = "short negative answer", watch = "“No, baby not sleeping” — “No, the baby isn't sleeping”."), PracticeQuestion(prompt = "Ask who is making that noise.", expected = listOf("Who is making that noise?", "Who's making that noise?"), focus = "who + is", watch = "“Who making” — who needs is: “Who is making…?”"))), exercises = listOf(Exercise(id = "en-foundations-now-questions-e1", kind = "choice", prompt = "___ you coming with us?", options = listOf("Are", "Is", "Do", "Does"), answers = listOf("Are"), explain = "With you, the present-continuous question starts with Are."), Exercise(id = "en-foundations-now-questions-e2", kind = "gap", prompt = "She ___ ___ working today. (negative, short form)", options = listOf(), answers = listOf("is not", "isn't"), explain = "is not → isn't: She isn't working today."), Exercise(id = "en-foundations-now-questions-e3", kind = "order", prompt = "Ask about their destination.", options = listOf(), answers = listOf("Where are they going"), explain = "Question word + are + they + -ing."), Exercise(id = "en-foundations-now-questions-e4", kind = "written", prompt = "Answer with a full sentence: What are you wearing today?", options = listOf(), answers = listOf("I'm wearing <clothes>", "I am wearing <clothes>", "Today I'm wearing <clothes>"), explain = "I'm wearing + clothes — wear is almost always continuous.")), skills = listOf("grammar:present-continuous", "grammar:present-questions", "function:ask-simple-questions", "speaking:short-answer"), prerequisites = listOf("grammar:present-continuous", "grammar:subject-pronouns")),
    Lesson(id = "en-foundations-now-weather", title = "The weather today", goal = "Talk about today's weather and what people are wearing.", intro = LessonIntro(explanation = listOf("Weather uses it: “It's cold. It's raining. It isn't sunny.” Ask: “What's the weather like?”", "Wear lives in the continuous: “I'm wearing a coat.” “She's wearing a hat.”", "Two present tenses, two jobs: habits use present simple (“It often rains here”), right now uses continuous (“It's raining now”)."), examples = listOf(ExampleLine(text = "What's the weather like?", meaning = "The standard weather question."), ExampleLine(text = "It's cold and windy.", meaning = "Weather with adjectives."), ExampleLine(text = "It's snowing again!", meaning = "A weather action in progress."), ExampleLine(text = "I'm wearing my new jacket.", meaning = "Clothes right now."), ExampleLine(text = "She's wearing a red scarf.", meaning = "Another person's clothes."), ExampleLine(text = "It often rains here, but today the sun is shining.", meaning = "Habit vs right now."))), expressions = listOf(TargetExpression(text = "What's the weather like?", meaning = "Ask about today's weather.", note = "Answer: It's + adjective."), TargetExpression(text = "It's sunny / cloudy / windy", meaning = "Weather adjectives.", note = "Adjectives, not -ing."), TargetExpression(text = "It's raining / snowing", meaning = "Weather actions in progress.", note = "-ing because it is happening now."), TargetExpression(text = "I'm wearing …", meaning = "Your clothes today.", note = "Almost always continuous."), TargetExpression(text = "Take an umbrella!", meaning = "Weather advice.", note = "Imperative — no you."), TargetExpression(text = "What a horrible day!", meaning = "React to the weather.", note = "What a + noun phrase!")), situation = "You are planning a walk with a neighbour: ask about the weather, describe what you are wearing and decide what to take.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "A neighbour opens the door. Ask about the weather.", expected = listOf("What's the weather like?"), focus = "the weather question", watch = "“How is the weather?” also works; “What's the weather like?” is the classic."), PracticeQuestion(prompt = "Describe a perfect beach day. (two adjectives)", expected = listOf("It's sunny and warm.", "It's hot and sunny."), focus = "it's + adjectives", watch = "“Is sunny” — weather needs it: “It's sunny”."), PracticeQuestion(prompt = "It started to rain. What do you say? (verb)", expected = listOf("It's raining.", "It is raining."), focus = "-ing weather", watch = "“It rains now” is a habit form; right now is “It's raining”."), PracticeQuestion(prompt = "Ask what your friend is wearing today.", expected = listOf("What are you wearing?"), focus = "wear + -ing", watch = "“What do you wear?” asks about a habit."), PracticeQuestion(prompt = "Say what you are wearing right now.", expected = listOf("I'm wearing <clothes>."), focus = "I'm wearing", watch = "“I wear a coat” sounds like every day — right now is “I'm wearing”."), PracticeQuestion(prompt = "Your friend has no coat and it's cold. Give advice.", expected = listOf("Take a coat!", "Wear a coat!", "Put on a coat!"), focus = "imperative advice", watch = "“You take a coat” is fine but the natural shout is “Take a coat!”"))), exercises = listOf(Exercise(id = "en-foundations-now-weather-e1", kind = "choice", prompt = "___ the weather like today?", options = listOf("What's", "How's", "What", "Which"), answers = listOf("What's"), explain = "The fixed question is What's the weather like?"), Exercise(id = "en-foundations-now-weather-e2", kind = "gap", prompt = "She ___ ___ a blue dress today. (wear)", options = listOf(), answers = listOf("is wearing", "'s wearing"), explain = "wear in the continuous: is wearing."), Exercise(id = "en-foundations-now-weather-e3", kind = "order", prompt = "Ask about the weather.", options = listOf(), answers = listOf("What's the weather like"), explain = "What is + the weather + like."), Exercise(id = "en-foundations-now-weather-e4", kind = "written", prompt = "It's 35 degrees and the sun is out. Describe the weather (one sentence).", options = listOf(), answers = listOf("it's hot and sunny", "it is hot and sunny", "it's sunny and hot", "it's very hot"), explain = "It's + weather adjectives: hot and sunny.")), skills = listOf("grammar:present-continuous", "vocab:weather", "function:talk-about-weather"), canDo = listOf("talk-about-weather"), prerequisites = listOf("grammar:present-continuous"))))
}

object EnFoundationsDays {
    val unit = CourseUnit(id = "en-foundations-days", title = "Days & feelings", subtitle = "Your week, your health", level = "A1", themes = listOf(ConversationTheme("birthday-plan", "The birthday plan", "Which day works?", "calendar", "Course", "You are planning a small birthday dinner. Compare days, fix a date and divide the tasks.", 0),
                ConversationTheme("pharmacy-stop", "At the pharmacy", "Not feeling well", "cross.case", "Course", "You have small health problems. Say how you feel, what hurts and what you need.", 1)), lessons = listOf(    Lesson(id = "en-foundations-days-calendar", title = "Days, months & dates", goal = "Say the days of the week, months and dates, and make appointments.", intro = LessonIntro(explanation = listOf("Days and months are always capital letters: Monday, May. The week starts with Monday in the UK, Sunday in the US.", "Use on with days (on Monday), in with months and years (in June, in 2026), and at with times (at three o'clock).", "Dates: “My birthday is on 5 May” — say “the fifth of May”. Ordinals: first, second, third… twenty-first."), examples = listOf(ExampleLine(text = "The meeting is on Monday.", meaning = "on + day."), ExampleLine(text = "We're on holiday in July.", meaning = "in + month."), ExampleLine(text = "My birthday is on 5 May.", meaning = "on + date."), ExampleLine(text = "The party starts at eight.", meaning = "at + time."), ExampleLine(text = "See you on Tuesday!", meaning = "Arranging a day."), ExampleLine(text = "What day is it today?", meaning = "The daily question."))), expressions = listOf(TargetExpression(text = "What day is it today?", meaning = "Ask about the day.", note = "It's Wednesday."), TargetExpression(text = "on Monday / on Fridays", meaning = "Days with on.", note = "on Fridays = every Friday."), TargetExpression(text = "in May / in winter", meaning = "Months and seasons with in.", note = "in summer 2026"), TargetExpression(text = "at three o'clock", meaning = "Clock times with at.", note = "at half past seven"), TargetExpression(text = "My birthday is on …", meaning = "Your special date.", note = "on 12 September"), TargetExpression(text = "See you on …!", meaning = "Fix the next meeting.", note = "See you on Thursday!")), situation = "You and a classmate want to study together: compare your weeks, pick a day and a time, and put it in the calendar.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Someone asks about your routine. Say one thing you do on Mondays.", expected = listOf("On Mondays I <activity>.", "I <activity> on Mondays."), focus = "on + day", watch = "“in Monday” — days take on."), PracticeQuestion(prompt = "When is your birthday?", expected = listOf("My birthday is on <date>.", "It's on <date>."), focus = "on + date", watch = "“My birthday is 5 May” — natural English adds on."), PracticeQuestion(prompt = "Which preposition: ___ June, ___ Friday, ___ six o'clock?", expected = listOf("in June, on Friday, at six o'clock"), focus = "in / on / at", watch = "Months take in, days take on, times take at."), PracticeQuestion(prompt = "Arrange to meet a friend next weekend.", expected = listOf("See you on Saturday.", "Let's meet on Sunday."), focus = "arranging a day", watch = "“See you in Saturday” — days take on."), PracticeQuestion(prompt = "What day is it today?", expected = listOf("It's <day>.", "Today is <day>."), focus = "it + day", watch = "“Is Monday” — the answer needs it: “It's Monday”."), PracticeQuestion(prompt = "Say the month after May and the month before September.", expected = listOf("June and August"), focus = "month order", watch = "Capital letters: June, August — never june."))), exercises = listOf(Exercise(id = "en-foundations-days-calendar-e1", kind = "choice", prompt = "The course starts ___ September.", options = listOf("in", "on", "at", "to"), answers = listOf("in"), explain = "Months take in: in September."), Exercise(id = "en-foundations-days-calendar-e2", kind = "gap", prompt = "We always meet ___ Fridays.", options = listOf(), answers = listOf("on"), explain = "Days take on: on Fridays (every Friday)."), Exercise(id = "en-foundations-days-calendar-e3", kind = "order", prompt = "Say when your birthday is. (5 / on / May / My birthday / is)", options = listOf(), answers = listOf("My birthday is on 5 May"), explain = "on + day + month for dates."), Exercise(id = "en-foundations-days-calendar-e4", kind = "gap", prompt = "The class is ___ Monday.", options = listOf(), answers = listOf("on monday"), explain = "Días con on: on Monday.")), skills = listOf("grammar:time-expressions", "function:tell-time", "vocab:social-expressions"), prerequisites = listOf("grammar:time-expressions")),
    Lesson(id = "en-foundations-days-free-time", title = "Free time and hobbies", goal = "Talk about hobbies with play, go and do, and say how often.", intro = LessonIntro(explanation = listOf("Three verbs own the hobbies: play for games (play football), go for -ing activities (go swimming), do for the rest (do yoga).", "Say how often with adverbs: always, usually, often, sometimes, never — they go before the main verb: “I often swim.”", "Ask back: “What do you do in your free time?” “Do you play any sports?”"), examples = listOf(ExampleLine(text = "I play chess with my uncle.", meaning = "play + game."), ExampleLine(text = "She goes swimming on Saturdays.", meaning = "go + -ing activity."), ExampleLine(text = "We do yoga in the park.", meaning = "do + exercise."), ExampleLine(text = "I never watch TV in the morning.", meaning = "never = 0% frequency."), ExampleLine(text = "He usually plays tennis after work.", meaning = "usually + third person -s."), ExampleLine(text = "What do you do in your free time?", meaning = "The standard free-time question."))), expressions = listOf(TargetExpression(text = "What do you do in your free time?", meaning = "Ask about hobbies.", note = "Answer: I play / go / do …"), TargetExpression(text = "play + game", meaning = "Football, chess, video games.", note = "play the guitar for music."), TargetExpression(text = "go + -ing", meaning = "Swimming, running, shopping.", note = "go swimming, not go swim."), TargetExpression(text = "do + yoga / sport", meaning = "General activities.", note = "do exercise three times a week."), TargetExpression(text = "always / often / sometimes / never", meaning = "How often.", note = "Before the verb: I often read."), TargetExpression(text = "That sounds fun!", meaning = "React to a hobby.", note = "Sounds + adjective, no subject.")), situation = "You meet a neighbour at the park: ask about free time, say what you do and how often, and find one thing you both enjoy.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "A neighbour asks about your weekend. Say one hobby you do in your free time.", expected = listOf("I <play/go/do> <hobby>.", "In my free time I <activity>."), focus = "play / go / do", watch = "“I go football” — ball games take play."), PracticeQuestion(prompt = "Ask your friend about their free time.", expected = listOf("What do you do in your free time?"), focus = "the free-time question", watch = "“What you do…?” — questions need do."), PracticeQuestion(prompt = "Say how often you cook. (sometimes)", expected = listOf("I sometimes cook.", "Sometimes I cook."), focus = "frequency position", watch = "“I cook sometimes” is fine too, but “I sometimes cook” is the safest order."), PracticeQuestion(prompt = "Your friend swims every Saturday. Say it. (she)", expected = listOf("She goes swimming every Saturday.", "She swims every Saturday."), focus = "go + -ing", watch = "“She go swimming” — third person needs -s: goes."), PracticeQuestion(prompt = "React positively to a new hobby you hear about.", expected = listOf("That sounds fun!", "That's cool!", "Nice!"), focus = "reacting", watch = "“That sounds funny” means “gracioso” — fun = divertido."), PracticeQuestion(prompt = "Say one thing you never do in your free time.", expected = listOf("I never <activity>."), focus = "never + verb", watch = "“I don't never” — never is already negative."))), exercises = listOf(Exercise(id = "en-foundations-days-free-time-e1", kind = "choice", prompt = "We ___ swimming every summer.", options = listOf("go", "play", "do", "make"), answers = listOf("go"), explain = "go + -ing activity: go swimming."), Exercise(id = "en-foundations-days-free-time-e2", kind = "gap", prompt = "She ___ plays tennis after work. (usual)", options = listOf(), answers = listOf("usually"), explain = "usually goes before the main verb."), Exercise(id = "en-foundations-days-free-time-e3", kind = "order", prompt = "Ask about free time.", options = listOf(), answers = listOf("What do you do in your free time"), explain = "Question word + do + you + verb."), Exercise(id = "en-foundations-days-free-time-e4", kind = "written", prompt = "Name the right verb: ___ chess, ___ yoga, ___ running.", options = listOf(), answers = listOf("play chess, do yoga, go running", "play, do, go"), explain = "play games, do exercise, go + -ing.")), skills = listOf("vocab:hobbies", "grammar:frequency-adverbs", "function:talk-about-routines", "speaking:describe-routine"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "en-foundations-days-instructions", title = "Follow the instructions", goal = "Give and follow instructions with imperatives, and politely ask people to do things.", intro = LessonIntro(explanation = listOf("The imperative is the verb alone: “Open the box. Listen carefully. Turn left.” It works for instructions, directions and recipes.", "Negatives use don't: “Don't touch it. Don't worry.”", "Soften with please and let's: “Please sit down.” “Let's start.” Let's = a suggestion for both of us."), examples = listOf(ExampleLine(text = "Open your books, please.", meaning = "A classroom instruction."), ExampleLine(text = "Turn left at the bank.", meaning = "A direction."), ExampleLine(text = "Don't touch the pan — it's hot!", meaning = "A warning."), ExampleLine(text = "Let's take a break.", meaning = "A suggestion for both."), ExampleLine(text = "Please speak slowly.", meaning = "A polite request."), ExampleLine(text = "Press this button first.", meaning = "Step-by-step help."))), expressions = listOf(TargetExpression(text = "Open / Close / Press …", meaning = "Basic instruction verbs.", note = "The verb alone is the command."), TargetExpression(text = "Don't + verb", meaning = "Stop someone politely.", note = "Don't worry."), TargetExpression(text = "Let's + verb", meaning = "Suggest doing it together.", note = "Let's go! = let us go."), TargetExpression(text = "…, please.", meaning = "The softener.", note = "Please can go first too: Please sit down."), TargetExpression(text = "First …, then …", meaning = "Order the steps.", note = "First press, then wait."), TargetExpression(text = "Careful!", meaning = "A short warning.", note = "= Be careful!")), situation = "You help a friend use a new coffee machine: give the steps in order, warn about the hot part and suggest trying it together.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "The class is noisy. What does the teacher say? (quiet)", expected = listOf("Be quiet!", "Quiet, please.", "Please be quiet."), focus = "be imperative", watch = "“You be quiet” is possible but the clean imperative is “Be quiet”."), PracticeQuestion(prompt = "Warn your friend about the hot pan.", expected = listOf("Don't touch the pan!", "Careful, it's hot!"), focus = "don't + verb", watch = "“Not touch” — the negative imperative needs don't."), PracticeQuestion(prompt = "Suggest starting the exercise together.", expected = listOf("Let's start the exercise.", "Let's begin."), focus = "let's + verb", watch = "“Let's to start” — let's takes the bare verb."), PracticeQuestion(prompt = "Give the first two steps for the machine.", expected = listOf("First press the button, then wait.", "Press this button, then wait."), focus = "first / then", watch = "Instructions follow order words: first, then, after that."), PracticeQuestion(prompt = "Ask someone to speak more slowly, politely.", expected = listOf("Please speak slowly.", "Speak slowly, please.", "Could you speak slowly?"), focus = "polite request", watch = "“Speak slow” — the adverb is slowly."), PracticeQuestion(prompt = "Tell your friend not to worry about the mistake.", expected = listOf("Don't worry!", "Don't worry about it."), focus = "don't worry", watch = "“No worry” is not English — “Don't worry”."))), exercises = listOf(Exercise(id = "en-foundations-days-instructions-e1", kind = "choice", prompt = "___ worry — it's easy!", options = listOf("Don't", "Not", "No", "Doesn't"), answers = listOf("Don't"), explain = "The negative imperative is Don't + verb."), Exercise(id = "en-foundations-days-instructions-e2", kind = "gap", prompt = "___ start with question one. (suggestion for both)", options = listOf(), answers = listOf("let's", "lets", "let us"), explain = "Let's = a suggestion for both of us."), Exercise(id = "en-foundations-days-instructions-e3", kind = "order", prompt = "Politely ask for quiet.", options = listOf(), answers = listOf("Please be quiet"), explain = "Be + adjective works in imperatives."), Exercise(id = "en-foundations-days-instructions-e4", kind = "written", prompt = "Put in order: press / first / this button / .", options = listOf(), answers = listOf("press this button first", "first press this button"), explain = "first can go before or after the instruction.")), skills = listOf("grammar:imperatives", "function:make-requests", "vocab:social-expressions", "pron:sentence-stress"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "en-foundations-days-feelings", title = "How do you feel?", goal = "Describe feelings and small health problems, and ask about other people.", intro = LessonIntro(explanation = listOf("Feelings use be: “I'm tired. She's happy. They're hungry.” Health problems use have got: “I've got a headache.”", "Ask: “How are you feeling?” “What's wrong?” Answer: “I don't feel well.” “My leg hurts.”", "Small comfort: “Get better soon!” “Take care!”"), examples = listOf(ExampleLine(text = "I'm so tired today.", meaning = "A feeling with be."), ExampleLine(text = "I've got a headache.", meaning = "A health problem with have got."), ExampleLine(text = "My back hurts.", meaning = "A body part + hurts."), ExampleLine(text = "What's wrong?", meaning = "Ask about a problem."), ExampleLine(text = "She isn't feeling well.", meaning = "Feeling ill, continuous."), ExampleLine(text = "Get better soon!", meaning = "A warm goodbye to someone ill."))), expressions = listOf(TargetExpression(text = "I'm tired / hungry / happy", meaning = "Feelings with be.", note = "Never “I have tired”."), TargetExpression(text = "I've got a headache / a cold", meaning = "Small health problems.", note = "have got + a + illness."), TargetExpression(text = "My … hurts.", meaning = "Point at the pain.", note = "My throat hurts."), TargetExpression(text = "What's wrong?", meaning = "Notice someone's problem.", note = "= What's the matter?"), TargetExpression(text = "I don't feel well.", meaning = "The general “me siento mal”.", note = "well = fine, here."), TargetExpression(text = "Get better soon! / Take care!", meaning = "Warm wishes.", note = "Fixed phrases.")), situation = "A colleague looks pale at work: ask what is wrong, they describe small problems, and you comfort them and give simple advice.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Your friend looks sad. Ask what's wrong.", expected = listOf("What's wrong?", "What's the matter?"), focus = "noticing", watch = "“What you have?” — the fixed question is “What's wrong?”"), PracticeQuestion(prompt = "Say you have a pain in your head.", expected = listOf("I've got a headache.", "I have a headache.", "My head hurts."), focus = "have got + illness", watch = "“I have headache” — the article matters: “a headache”."), PracticeQuestion(prompt = "Say how you feel today. (tired)", expected = listOf("I'm tired.", "I'm very tired today."), focus = "be + feeling", watch = "“I have tired” — feelings take be."), PracticeQuestion(prompt = "Your colleague says she doesn't feel well. Comfort her.", expected = listOf("Get better soon!", "Take care!", "Go home and rest."), focus = "comforting", watch = "Any warm fixed phrase works here."), PracticeQuestion(prompt = "Ask about your friend's back pain today.", expected = listOf("How is your back today?", "Is your back better?", "Does your back still hurt?"), focus = "asking about pain", watch = "“How is your back?” is the natural follow-up."), PracticeQuestion(prompt = "Say two things you need when you have a cold.", expected = listOf("I need water and rest.", "I need tea and tissues."), focus = "need + noun", watch = "need + noun for things, need + to + verb for actions."))), exercises = listOf(Exercise(id = "en-foundations-days-feelings-e1", kind = "choice", prompt = "I ___ so tired today.", options = listOf("'m", "have", "am having", "do"), answers = listOf("'m"), explain = "Feelings take be: I'm tired."), Exercise(id = "en-foundations-days-feelings-e2", kind = "gap", prompt = "I've ___ a terrible headache.", options = listOf(), answers = listOf("got", "get"), explain = "have got a headache — got completes the pair."), Exercise(id = "en-foundations-days-feelings-e3", kind = "order", prompt = "Ask about a problem you notice.", options = listOf(), answers = listOf("What is wrong"), explain = "The fixed question: What's wrong?"), Exercise(id = "en-foundations-days-feelings-e4", kind = "written", prompt = "Your throat hurts. Say it two ways.", options = listOf(), answers = listOf("my throat hurts", "i've got a sore throat", "i have a sore throat", "my throat is sore"), explain = "My X hurts or I've got a sore throat.")), skills = listOf("vocab:feelings", "vocab:health", "function:talk-about-health", "grammar:have-got"), prerequisites = listOf("grammar:have-got", "grammar:verb-be"))))
}

object EnFoundationsTransport {
    val unit = CourseUnit(id = "en-foundations-transport", title = "On the move", subtitle = "Buses, trains, tickets", level = "A1", themes = listOf(ConversationTheme("ticket-machine", "The ticket machine", "Which ticket?", "ticket", "Course", "You help a visitor buy the right ticket from a machine: zones, singles, day passes — one step at a time.", 0),
                ConversationTheme("wrong-bus", "The wrong bus", "Where does it go?", "bus", "Course", "You are on the wrong bus together. Ask the driver, check the map and find the way back.", 1)), lessons = listOf(    Lesson(id = "en-foundations-transport-bus-train", title = "Bus & train", goal = "Buy tickets and ask about buses and trains: times, platforms and prices.", intro = LessonIntro(explanation = listOf("At the station, four questions do everything: “Which bus goes to…?” “What time is the next train?” “How much is a ticket?” “Which platform?”", "Transport words travel in pairs: bus / bus stop, train / train station, plane / airport. Learn the pair, not the word alone.", "Prices use how much: “How much is a single ticket?” Answers: “It's two euros fifty.”"), examples = listOf(ExampleLine(text = "Which bus goes to the airport?", meaning = "The route question."), ExampleLine(text = "What time is the next train?", meaning = "The time question."), ExampleLine(text = "How much is a day ticket?", meaning = "The price question."), ExampleLine(text = "Which platform is it?", meaning = "Where to wait."), ExampleLine(text = "A single to the centre, please.", meaning = "One-way ticket."), ExampleLine(text = "Is this seat free?", meaning = "On the bus or train."))), expressions = listOf(TargetExpression(text = "Which bus/train goes to …?", meaning = "Ask for the route.", note = "The 12 goes to the centre."), TargetExpression(text = "What time is the next …?", meaning = "Ask the timetable.", note = "At ten past."), TargetExpression(text = "How much is a ticket to …?", meaning = "Ask the price.", note = "A single or a return?"), TargetExpression(text = "A single / a return, please.", meaning = "One-way or both ways.", note = "return = ida y vuelta."), TargetExpression(text = "Which platform?", meaning = "Where to get on.", note = "Platform 3."), TargetExpression(text = "Does this bus stop at …?", meaning = "Check your stop.", note = "Yes, near the park.")), situation = "You help a visitor at the station: choose the bus, buy two singles, find the platform and check the next departure.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "A visitor wants the airport. Ask the route question.", expected = listOf("Which bus goes to the airport?"), focus = "route question", watch = "“What bus for airport?” — the full question is “Which bus goes to…?”"), PracticeQuestion(prompt = "Ask about the next train to Madrid.", expected = listOf("What time is the next train to Madrid?"), focus = "time question", watch = "“When is the next train?” also works."), PracticeQuestion(prompt = "Ask the price of a ticket to the centre.", expected = listOf("How much is a ticket to the centre?"), focus = "price question", watch = "How much is / are — plural: “How much are the tickets?”"), PracticeQuestion(prompt = "Buy one ticket, one way, politely.", expected = listOf("A single to the centre, please.", "One single, please."), focus = "single", watch = "A return is both ways — check what the visitor wants."), PracticeQuestion(prompt = "Ask where to wait for the train.", expected = listOf("Which platform is it?", "What platform does it leave from?"), focus = "platform", watch = "platform = andén — not “station” again."), PracticeQuestion(prompt = "Check the bus stops near the park.", expected = listOf("Does this bus stop near the park?"), focus = "stop at", watch = "“Does this bus go in the park?” — stop at + place."))), exercises = listOf(Exercise(id = "en-foundations-transport-bus-train-e1", kind = "choice", prompt = "___ much is a day ticket?", options = listOf("How", "What", "Which", "When"), answers = listOf("How"), explain = "Prices take How much: How much is…?"), Exercise(id = "en-foundations-transport-bus-train-e2", kind = "gap", prompt = "The train to the airport leaves from ___ 3. (andén)", options = listOf(), answers = listOf("platform"), explain = "Platform 3 = andén 3."), Exercise(id = "en-foundations-transport-bus-train-e3", kind = "order", prompt = "Ask the route question.", options = listOf(), answers = listOf("Which bus goes to the airport"), explain = "Which + bus + goes to + place."), Exercise(id = "en-foundations-transport-bus-train-e4", kind = "written", prompt = "Buy a one-way ticket politely.", options = listOf(), answers = listOf("a single to <place> please", "one single please", "a single please"), explain = "A single to…, please.")), skills = listOf("vocab:transport", "grammar:time-expressions", "function:tell-time", "writing:sentence"), canDo = listOf("use-transport"), prerequisites = listOf("grammar:time-expressions")),
    Lesson(id = "en-foundations-transport-commute", title = "How do you get to work?", goal = "Describe how you travel to work or school with by + transport.", intro = LessonIntro(explanation = listOf("by + transport for the means: “by bus, by train, by car, by bike, by plane”. On foot for walking: “I go to work on foot.”", "The question: “How do you get to work?” Answers add a time: “It takes twenty minutes.”", "get to + place = arrive: “I get to the office at nine.” get home — no to: “I get home at six.”"), examples = listOf(ExampleLine(text = "I go to work by bike.", meaning = "by + transport."), ExampleLine(text = "She goes to school on foot.", meaning = "Walking = on foot."), ExampleLine(text = "How do you get to work?", meaning = "The commute question."), ExampleLine(text = "It takes twenty minutes by bus.", meaning = "Duration of the trip."), ExampleLine(text = "I get to the office at nine.", meaning = "Arrive at + place."), ExampleLine(text = "I get home at six.", meaning = "get home — no to."))), expressions = listOf(TargetExpression(text = "by bus / train / bike / car", meaning = "The means of travel.", note = "Never “with bus”."), TargetExpression(text = "on foot", meaning = "Walking.", note = "Not “by foot” in careful English."), TargetExpression(text = "How do you get to …?", meaning = "Ask about the journey.", note = "get to + place."), TargetExpression(text = "It takes + time", meaning = "Duration.", note = "It takes ten minutes on foot."), TargetExpression(text = "I get to work at …", meaning = "Arrival time.", note = "get home, get here: no to."), TargetExpression(text = "The traffic is terrible.", meaning = "Explain the delay.", note = "Traffic is uncountable.")), situation = "You compare morning routines with a colleague: how you each get to work, how long it takes and why you would never cycle uphill.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ask your colleague about their journey to work.", expected = listOf("How do you get to work?"), focus = "the commute question", watch = "“How you go to work?” — questions need do."), PracticeQuestion(prompt = "Say you travel by metro.", expected = listOf("I go to work by metro.", "I travel by metro."), focus = "by + transport", watch = "“with the metro” — transport takes by."), PracticeQuestion(prompt = "Say you walk to school.", expected = listOf("I go to school on foot.", "I walk to school."), focus = "on foot", watch = "“by foot” is heard but “on foot” is the safe form."), PracticeQuestion(prompt = "Say how long the bus takes. (20 minutes)", expected = listOf("It takes twenty minutes by bus.", "The bus takes twenty minutes."), focus = "it takes", watch = "“The bus has twenty minutes” — duration takes takes!"), PracticeQuestion(prompt = "Say when you arrive at the office. (9 o'clock)", expected = listOf("I get to the office at nine."), focus = "get to", watch = "“I arrive to the office” — arrive AT a place, or use get to."), PracticeQuestion(prompt = "Say you arrive home late on Fridays.", expected = listOf("I get home late on Fridays."), focus = "get home", watch = "get home has no to — home is special."))), exercises = listOf(Exercise(id = "en-foundations-transport-commute-e1", kind = "choice", prompt = "I go to work ___ bus.", options = listOf("by", "with", "in", "on"), answers = listOf("by"), explain = "by + transport: by bus, by train, by bike."), Exercise(id = "en-foundations-transport-commute-e2", kind = "gap", prompt = "It ___ thirty minutes by train.", options = listOf(), answers = listOf("takes"), explain = "It takes + time for duration."), Exercise(id = "en-foundations-transport-commute-e3", kind = "order", prompt = "Ask about the journey.", options = listOf(), answers = listOf("How do you get to work"), explain = "How + do + you + get to + place."), Exercise(id = "en-foundations-transport-commute-e4", kind = "written", prompt = "Fix: “I get to home at six.”", options = listOf(), answers = listOf("i get home at six"), explain = "get home — home needs no to.")), skills = listOf("vocab:transport", "grammar:present-simple", "grammar:prepositions-place", "function:talk-about-routines", "writing:sentence"), canDo = listOf("use-transport", "talk-about-routines"), prerequisites = listOf("grammar:present-simple"))))
}

object EnFoundationsOut {
    val unit = CourseUnit(id = "en-foundations-out", title = "Out and about", subtitle = "Shops, chats, help", level = "A1", themes = listOf(ConversationTheme("supermarket-run", "The supermarket run", "Food and needs", "cart", "Course", "You shop together for the weekend: find things, ask prices and check the list.", 0),
                ConversationTheme("new-in-town", "New in town", "Small talk", "sun.haze", "Course", "You chat with someone at the bus stop: the weather, the weekend, the neighbourhood.", 1)), lessons = listOf(    Lesson(id = "en-foundations-out-supermarket", title = "At the supermarket", goal = "Shop for food: name aisles, ask where things are and say what you need.", intro = LessonIntro(explanation = listOf("Supermarket words come in groups: the fruit section, the dairy section, the frozen food aisle.", "Ask for locations: “Where is the milk?” “Which aisle has the bread?” Answers: “Aisle three, next to the juice.”", "Say needs with need + noun: “We need rice, eggs and tomatoes.”"), examples = listOf(ExampleLine(text = "Where is the milk?", meaning = "The location question."), ExampleLine(text = "It's in aisle three.", meaning = "The answer."), ExampleLine(text = "We need rice and eggs.", meaning = "Say your needs."), ExampleLine(text = "Is this bread fresh?", meaning = "Check quality."), ExampleLine(text = "Do you have any fresh fish today?", meaning = "Ask about availability."))), expressions = listOf(TargetExpression(text = "Where is the …?", meaning = "Ask for a place.", note = "…the sugar?"), TargetExpression(text = "Which aisle has …?", meaning = "Ask for the section.", note = "…the pasta?"), TargetExpression(text = "We need + food", meaning = "Say what to buy.", note = "We need coffee."), TargetExpression(text = "How much is/are …?", meaning = "Price, again.", note = "How much are the eggs?"), TargetExpression(text = "Is this … fresh?", meaning = "Check the food.", note = "Is this fish fresh?"), TargetExpression(text = "Anything else?", meaning = "The cashier's question.", note = "No, that's all, thanks."), TargetExpression(text = "Is this the only …?", meaning = "Check the options.", note = "Is this the only bread?")), situation = "You shop for a weekend with friends: find six things on the list, ask where two of them are and check one price.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Say two things you need for breakfast.", expected = listOf("We need <food> and <food>."), focus = "need + food", watch = "Food words have no plural here: “We need bread”, not “breads”."), PracticeQuestion(prompt = "Ask where the sugar is.", expected = listOf("Where is the sugar?"), focus = "where is", watch = "Sugar is uncountable: “Where is”, not “Where are”."), PracticeQuestion(prompt = "Ask the price of the eggs.", expected = listOf("How much are the eggs?"), focus = "plural price", watch = "Plural things take are: How much ARE the eggs?"), PracticeQuestion(prompt = "The cashier asks “Anything else?”. Answer politely.", expected = listOf("No, that's all, thanks.", "No, that's all."), focus = "closing the shop", watch = "“That's all” is the friendly full stop."), PracticeQuestion(prompt = "Ask if the bread is fresh.", expected = listOf("Is this bread fresh?", "Is the bread fresh?"), focus = "fresh", watch = "fresh = recién hecho — bread, fish, fruit."))), exercises = listOf(Exercise(id = "en-foundations-out-supermarket-e1", kind = "choice", prompt = "Where ___ the milk?", options = listOf("is", "are", "do", "does"), answers = listOf("is"), explain = "Uncountable: the milk is."), Exercise(id = "en-foundations-out-supermarket-e2", kind = "gap", prompt = "We ___ rice and tomatoes. (necesitamos)", options = listOf(), answers = listOf("need"), explain = "need + food."), Exercise(id = "en-foundations-out-supermarket-e3", kind = "order", prompt = "Ask about the eggs. (how / are / much / the eggs)", options = listOf(), answers = listOf("How much are the eggs"), explain = "Plural price: How much are…?"), Exercise(id = "en-foundations-out-supermarket-e4", kind = "written", prompt = "Name two things on your shopping list.", options = listOf(), answers = listOf("we need <food> and <food>", "i need <food> and <food>"), explain = "We need X and Y.")), skills = listOf("vocab:food", "grammar:there-is-are", "function:go-shopping", "writing:sentence"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:there-is-are")),
    Lesson(id = "en-foundations-out-smalltalk", title = "Small talk", goal = "Chat politely with strangers: the weather, the weekend and friendly exits.", intro = LessonIntro(explanation = listOf("Small talk has safe topics: the weather, the weekend, the neighbourhood. Politics and salary are not small talk.", "The rhythm: comment + question. “Cold today, isn't it? Do you know if the bus is late?”", "Exit kindly: “Well, have a good one!” — you don't need a reason to stop."), examples = listOf(ExampleLine(text = "Cold today, isn't it?", meaning = "Weather opener."), ExampleLine(text = "Any plans for the weekend?", meaning = "The classic question."), ExampleLine(text = "Nothing much — you?", meaning = "Return the question."), ExampleLine(text = "Have a good one!", meaning = "Friendly exit."), ExampleLine(text = "The bus is always late on Mondays.", meaning = "A safe complaint."))), expressions = listOf(TargetExpression(text = "Comment + isn't it?", meaning = "Weather opener.", note = "Lovely day, isn't it?"), TargetExpression(text = "Any plans for the weekend?", meaning = "Ask about Saturday.", note = "Nothing special planned."), TargetExpression(text = "Nothing much — you?", meaning = "Answer and return.", note = "The ping-pong of chat."), TargetExpression(text = "Have a good one!", meaning = "Exit kindly.", note = "= have a good day."), TargetExpression(text = "See you around!", meaning = "Exit for strangers.", note = "You'll meet again."), TargetExpression(text = "This weather is crazy, right?", meaning = "Weather small talk 2.0.", note = "right? invites agreement.")), situation = "You wait at a bus stop next to a neighbour you half-know: open with the weather, ask about the weekend and exit kindly when the bus arrives.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Open with the weather. (cold)", expected = listOf("Cold today, isn't it?"), focus = "isn't it?", watch = "The tag asks for agreement: “Cold today, isn't it?”"), PracticeQuestion(prompt = "Ask about their weekend plans.", expected = listOf("Any plans for the weekend?", "Do you have any plans for the weekend?"), focus = "the weekend question", watch = "plans FOR the weekend."), PracticeQuestion(prompt = "Answer “not much” and return the question.", expected = listOf("Nothing much — you?", "Not much. And you?"), focus = "answer + return", watch = "Small talk is ping-pong: always send the question back."), PracticeQuestion(prompt = "The bus arrives. Exit kindly.", expected = listOf("Have a good one!", "See you around!"), focus = "friendly exit", watch = "Both are warm stranger-goodbyes."), PracticeQuestion(prompt = "Complain gently about the Monday buses.", expected = listOf("The bus is always late on Mondays."), focus = "always + present", watch = "always + present simple for habits."))), exercises = listOf(Exercise(id = "en-foundations-out-smalltalk-e1", kind = "choice", prompt = "Lovely day, ___?", options = listOf("isn't it", "is it", "doesn't it", "not"), answers = listOf("isn't it"), explain = "The tag asks for agreement."), Exercise(id = "en-foundations-out-smalltalk-e2", kind = "gap", prompt = "Any ___ for the weekend? (planes)", options = listOf(), answers = listOf("plans"), explain = "plans for the weekend."), Exercise(id = "en-foundations-out-smalltalk-e3", kind = "order", prompt = "Exit kindly. (a / have / one / good)", options = listOf(), answers = listOf("Have a good one"), explain = "The friendly stranger-exit."), Exercise(id = "en-foundations-out-smalltalk-e4", kind = "written", prompt = "Answer: “Any plans for the weekend?”", options = listOf(), answers = listOf("nothing much", "not much", "no plans"), explain = "Short and honest works.")), skills = listOf("vocab:social-expressions", "function:talk-about-weather", "grammar:present-continuous", "pron:connected-speech"), prerequisites = listOf("grammar:verb-be")),
    Lesson(id = "en-foundations-out-asking-help", title = "Asking for help", goal = "Ask strangers for help in a shop or street, and thank them properly.", intro = LessonIntro(explanation = listOf("Open with excuse me: “Excuse me, where's the lift?” It signals a request is coming.", "Requests with can: “Can you help me?” “Can I ask something?” After help, say thank you + a follow-up.", "If you don't understand, say so: “Sorry, can you repeat that?” — people are kind about it."), examples = listOf(ExampleLine(text = "Excuse me, where's the lift?", meaning = "Open + question."), ExampleLine(text = "Can you help me, please?", meaning = "The request."), ExampleLine(text = "Sorry, can you repeat that?", meaning = "Didn't hear."), ExampleLine(text = "Thank you very much!", meaning = "Close warmly."), ExampleLine(text = "Could you say that more slowly, please?", meaning = "A kind second request."))), expressions = listOf(TargetExpression(text = "Excuse me, …", meaning = "Start any request.", note = "Excuse me, is this seat free?"), TargetExpression(text = "Can you help me?", meaning = "Ask for help.", note = "help me with + thing."), TargetExpression(text = "Can I ask something?", meaning = "Softer opener.", note = "Of course!"), TargetExpression(text = "Sorry, can you repeat that?", meaning = "Didn't hear.", note = "repeat that, not “repeat” alone."), TargetExpression(text = "Thank you very much!", meaning = "Close with warmth.", note = "You're welcome comes back."), TargetExpression(text = "Is this the right way to…?", meaning = "Check direction.", note = "…the station?")), situation = "You are lost in a shopping centre: ask two strangers for help, ask one to repeat, and thank both warmly.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Start your request to a stranger politely.", expected = listOf("Excuse me, where is the <place>?"), focus = "excuse me", watch = "excuse me opens; thank you closes."), PracticeQuestion(prompt = "Ask someone to help you with a heavy bag.", expected = listOf("Can you help me with this bag, please?"), focus = "can you", watch = "can + you + base verb."), PracticeQuestion(prompt = "You didn't hear the answer. Say so.", expected = listOf("Sorry, can you repeat that?"), focus = "repeat", watch = "repeat that — “repeat?” alone is blunt."), PracticeQuestion(prompt = "Thank the person warmly.", expected = listOf("Thank you very much!", "Thanks a lot!"), focus = "closing", watch = "Warm thanks finish the exchange."), PracticeQuestion(prompt = "Ask someone to speak more slowly.", expected = listOf("Could you say that more slowly, please?", "Can you speak more slowly, please?"), focus = "could you", watch = "could you is softer than can you — use it twice and people will love you."))), exercises = listOf(Exercise(id = "en-foundations-out-asking-help-e1", kind = "choice", prompt = "___ me, where's the lift?", options = listOf("Excuse", "Sorry for", "Thank", "Hello you"), answers = listOf("Excuse"), explain = "Excuse me opens any request."), Exercise(id = "en-foundations-out-asking-help-e2", kind = "gap", prompt = "Can you ___ that again, please? (repeat)", options = listOf(), answers = listOf("repeat"), explain = "repeat that, please."), Exercise(id = "en-foundations-out-asking-help-e3", kind = "order", prompt = "Ask for help with a bag.", options = listOf(), answers = listOf("Can you help me with this bag"), explain = "can you help me with + thing."), Exercise(id = "en-foundations-out-asking-help-e4", kind = "written", prompt = "Thank someone who helped you a lot.", options = listOf(), answers = listOf("thank you very much", "thanks a lot"), explain = "Two warm closers.")), skills = listOf("function:make-requests", "grammar:can", "vocab:social-expressions", "writing:sentence"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:subject-pronouns"))))
}

object EnFoundationsTown {
    val unit = CourseUnit(id = "en-foundations-town", title = "My town", subtitle = "Places, people, corners", level = "A1", themes = listOf(ConversationTheme("town-tour", "The town tour", "What's near?", "map", "Course", "You show a visitor your town on a map: what there is, what there isn't and what's good.", 0),
                ConversationTheme("neighbour-chat", "The neighbour's chat", "Where you live", "house", "Course", "You tell a neighbour about your street and ask about theirs.", 1)), lessons = listOf(    Lesson(id = "en-foundations-town-places", title = "Places in town", goal = "Name the places in a town and say what there is near you.", intro = LessonIntro(explanation = listOf("Town places: a bank, a bakery, a chemist's, a library, a park, a school. With a/an the first time: “There's a bakery near my house.”", "there is / there are do all the work: “There's a park. There are two schools.” Negative: “There isn't a cinema.”", "Ask back: “Is there a bank near here?” — near here is the magic phrase."), examples = listOf(ExampleLine(text = "There's a bakery near my house.", meaning = "there's + a + place."), ExampleLine(text = "There are two schools.", meaning = "Plural: there are."), ExampleLine(text = "There isn't a cinema here.", meaning = "Negative."), ExampleLine(text = "Is there a bank near here?", meaning = "The classic question."), ExampleLine(text = "The park is in front of the school.", meaning = "Location phrase."))), expressions = listOf(TargetExpression(text = "There's a … near here", meaning = "One place exists.", note = "There's a park near here."), TargetExpression(text = "There are … ", meaning = "Plural places.", note = "There are two cafés."), TargetExpression(text = "There isn't a …", meaning = "What's missing.", note = "There isn't a library."), TargetExpression(text = "Is there a … near here?", meaning = "Ask about places.", note = "Is there a chemist's near here?"), TargetExpression(text = "next to / in front of", meaning = "Location words.", note = "The bank is next to the bakery."), TargetExpression(text = "My favourite place is …", meaning = "Personalise.", note = "…the park."), TargetExpression(text = "Is it far from here?", meaning = "Check distance.", note = "No, five minutes.")), situation = "You show a visitor a map of your neighbourhood: name five places, say one thing there isn't, and recommend your favourite corner.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Name two places near your home.", expected = listOf("There's a <place> and a <place> near my home."), focus = "there's", watch = "One place: There's a bakery."), PracticeQuestion(prompt = "Say a place that doesn't exist near you. (cinema)", expected = listOf("There isn't a cinema near here."), focus = "negative", watch = "there isn't + a + place."), PracticeQuestion(prompt = "Ask if there is a bank near here.", expected = listOf("Is there a bank near here?"), focus = "the question", watch = "Is there + a + place + near here?"), PracticeQuestion(prompt = "Say your favourite place in town.", expected = listOf("My favourite place is <place>."), focus = "favourite", watch = "favourite place — singular."), PracticeQuestion(prompt = "Say the park is in front of the school.", expected = listOf("The park is in front of the school."), focus = "in front of", watch = "in front of = delante de; next to = al lado."))), exercises = listOf(Exercise(id = "en-foundations-town-places-e1", kind = "choice", prompt = "There ___ two schools in my street.", options = listOf("are", "is", "be", "has"), answers = listOf("are"), explain = "Plural: there are."), Exercise(id = "en-foundations-town-places-e2", kind = "gap", prompt = "There ___ a library in my town. (negative)", options = listOf(), answers = listOf("isn't", "is not"), explain = "there isn't a…"), Exercise(id = "en-foundations-town-places-e3", kind = "order", prompt = "Ask about a bank.", options = listOf(), answers = listOf("Is there a bank near here"), explain = "Is there + a + place?"), Exercise(id = "en-foundations-town-places-e4", kind = "written", prompt = "Name one place near your home.", options = listOf(), answers = listOf("there's a <place> near my home", "there is a <place>"), explain = "There's a…")), skills = listOf("vocab:town", "grammar:there-is-are", "grammar:articles", "function:ask-simple-questions", "writing:sentence"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:articles")),
    Lesson(id = "en-foundations-town-hometown", title = "Describing your town", goal = "Say what your town is like with adjectives and because.", intro = LessonIntro(explanation = listOf("Describe with be + adjective: “My town is small and quiet.” “The streets are clean.”", "Give reasons with because: “I love it because it's near the sea.”", "Compare gently with like: “What's it like?” — the answer is an adjective, never like again: “It's busy.”"), examples = listOf(ExampleLine(text = "My town is small and quiet.", meaning = "be + adjectives."), ExampleLine(text = "I love it because it's near the sea.", meaning = "because + reason."), ExampleLine(text = "What's your town like?", meaning = "The description question."), ExampleLine(text = "It's busy in summer.", meaning = "The answer: adjective only."), ExampleLine(text = "The people are very friendly.", meaning = "Describe the people."), ExampleLine(text = "It gets crowded in August.", meaning = "Seasonal truth."), ExampleLine(text = "It's famous for its market.", meaning = "famous for + thing."))), expressions = listOf(TargetExpression(text = "… is + adjective", meaning = "Describe the town.", note = "It's old and beautiful."), TargetExpression(text = "What's … like?", meaning = "Ask for a description.", note = "What's the food like?"), TargetExpression(text = "because …", meaning = "Give the reason.", note = "…because everything is close."), TargetExpression(text = "The people are …", meaning = "Describe locals.", note = "The people are friendly."), TargetExpression(text = "It gets + adjective", meaning = "Seasonal change.", note = "It gets cold in winter."), TargetExpression(text = "I like it because …", meaning = "Personal reason.", note = "…because it's quiet."), TargetExpression(text = "The best thing is the food.", meaning = "Pick a highlight.", note = "…and the worst is the traffic.")), situation = "A friend asks about your town before visiting: describe it with three adjectives, explain why you like it and warn about one season.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Describe your town with two adjectives.", expected = listOf("My town is <adj> and <adj>."), focus = "be + adjectives", watch = "Adjectives, not nouns: “small and quiet”."), PracticeQuestion(prompt = "Say why you like it. (because)", expected = listOf("I like it because <reason>."), focus = "because", watch = "because + full reason: “because it's near the sea”."), PracticeQuestion(prompt = "Ask what your friend's town is like.", expected = listOf("What's your town like?"), focus = "the question", watch = "The answer is an adjective — never “It's like small”."), PracticeQuestion(prompt = "Warn about one season. (crowded, summer)", expected = listOf("It gets crowded in summer."), focus = "it gets", watch = "it gets + adjective = it becomes."), PracticeQuestion(prompt = "Say what your town is famous for. (market)", expected = listOf("It's famous for its market.", "My town is famous for its market."), focus = "famous for", watch = "famous FOR, never “famous by”."))), exercises = listOf(Exercise(id = "en-foundations-town-hometown-e1", kind = "choice", prompt = "What's your town ___?", options = listOf("like", "likes", "liking", "to like"), answers = listOf("like"), explain = "What's it like? asks for adjectives."), Exercise(id = "en-foundations-town-hometown-e2", kind = "gap", prompt = "I love my town ___ everything is close. (reason)", options = listOf(), answers = listOf("because"), explain = "because + reason."), Exercise(id = "en-foundations-town-hometown-e3", kind = "order", prompt = "Describe the people.", options = listOf(), answers = listOf("The people are very friendly"), explain = "the people are + adjective."), Exercise(id = "en-foundations-town-hometown-e4", kind = "written", prompt = "Describe your town with one adjective.", options = listOf(), answers = listOf("my town is <adj>", "it's <adj>"), explain = "It's + adjective.")), skills = listOf("grammar:present-simple", "grammar:connectors", "vocab:town", "function:express-opinion", "writing:sentence"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:verb-be")),
    Lesson(id = "en-foundations-town-neighbours", title = "Neighbours", goal = "Talk about your street and your neighbours with there is and they're.", intro = LessonIntro(explanation = listOf("Neighbour vocabulary: a neighbour (next door), upstairs, downstairs. “My neighbour is friendly.”", "Describe people with be: “They're quiet.” “He's very kind.” Plural neighbours: “They are…”, not “They is…”.", "Good-neighbour phrases: “If you need anything, just knock.” — offers that build friendships."), examples = listOf(ExampleLine(text = "My neighbour is very friendly.", meaning = "be + adjective."), ExampleLine(text = "They're quiet, I think.", meaning = "Plural neighbours."), ExampleLine(text = "She lives upstairs.", meaning = "Upstairs / downstairs."), ExampleLine(text = "If you need anything, just knock.", meaning = "The kind offer."), ExampleLine(text = "It's nice to have good neighbours.", meaning = "The closing thought."), ExampleLine(text = "We say hello every morning.", meaning = "A small routine."))), expressions = listOf(TargetExpression(text = "My neighbour is …", meaning = "One person next door.", note = "…really kind."), TargetExpression(text = "They're …", meaning = "A family or couple.", note = "They're quiet."), TargetExpression(text = "upstairs / downstairs", meaning = "Floors.", note = "The people upstairs are loud."), TargetExpression(text = "If you need anything, …", meaning = "Offer help.", note = "…just knock."), TargetExpression(text = "Do you know your neighbours?", meaning = "The question.", note = "Not really!"), TargetExpression(text = "It's nice to …", meaning = "Close warmly.", note = "…have good neighbours."), TargetExpression(text = "They keep to themselves.", meaning = "Neutral neighbours.", note = "= no molestan ni hablan.")), situation = "You meet a neighbour in the stairwell: describe the people in your building, offer help and close the chat warmly.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Describe one neighbour with an adjective.", expected = listOf("My neighbour is <adj>."), focus = "be + adjective", watch = "“My neighbour has friendly” — no: is friendly."), PracticeQuestion(prompt = "Say the family upstairs is quiet.", expected = listOf("The family upstairs is quiet.", "They're quiet."), focus = "they're", watch = "Family = singular in AmE, often plural in BrE — both fine."), PracticeQuestion(prompt = "Offer help kindly.", expected = listOf("If you need anything, just knock."), focus = "the offer", watch = "just makes it friendly."), PracticeQuestion(prompt = "Close the chat warmly.", expected = listOf("It's nice to have good neighbours.", "Nice talking to you!"), focus = "warm close", watch = "Any warm close works."), PracticeQuestion(prompt = "Say you and your neighbour greet each other every morning.", expected = listOf("We say hello every morning."), focus = "say hello", watch = "say hello TO someone, or just say hello."))), exercises = listOf(Exercise(id = "en-foundations-town-neighbours-e1", kind = "choice", prompt = "My neighbour ___ very kind.", options = listOf("is", "are", "has", "does"), answers = listOf("is"), explain = "One neighbour: is."), Exercise(id = "en-foundations-town-neighbours-e2", kind = "gap", prompt = "The people upstairs ___ very quiet. (they)", options = listOf(), answers = listOf("are", "'re"), explain = "Plural: are."), Exercise(id = "en-foundations-town-neighbours-e3", kind = "order", prompt = "Offer help kindly. (anything / if / need / you / just / knock)", options = listOf(), answers = listOf("If you need anything just knock"), explain = "If you need anything, just knock."), Exercise(id = "en-foundations-town-neighbours-e4", kind = "written", prompt = "Describe your neighbours with one word.", options = listOf(), answers = listOf("my neighbours are <adj>", "they're <adj>", "they are <adj>"), explain = "be + adjective.")), skills = listOf("grammar:there-is-are", "grammar:verb-be", "vocab:home", "function:describe-people"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:subject-pronouns"))))
}

object EnFoundationsFriends {
    val unit = CourseUnit(id = "en-foundations-friends", title = "Family & friends", subtitle = "The people who matter", level = "A1", themes = listOf(ConversationTheme("family-album-2", "The photo album, again", "Who's who now", "person.2", "Course", "More family photos: ages, jobs, personalities — and one mystery relative.", 0),
                ConversationTheme("friend-weekend", "A friend's visit", "Plans together", "figure.walk", "Course", "A friend visits your city for a day: decide together what to do, using what you both like.", 1)), lessons = listOf(    Lesson(id = "en-foundations-friends-family", title = "Talking about family", goal = "Describe your family: sizes, ages and one personality word per person.", intro = LessonIntro(explanation = listOf("Family words travel in pairs: mother/father, brother/sister, son/daughter, aunt/uncle, cousin for everyone else.", "Say the size: “There are four of us.” Then one detail per person: “My sister is a student. She's very funny.”", "Ages with be: “My father is sixty.” Never has: “My father has sixty” is wrong."), examples = listOf(ExampleLine(text = "There are four of us.", meaning = "Family size."), ExampleLine(text = "My sister is a student.", meaning = "One detail per person."), ExampleLine(text = "My father is sixty.", meaning = "Age with be."), ExampleLine(text = "I have two cousins.", meaning = "have + family."), ExampleLine(text = "We're a close family.", meaning = "The feeling."), ExampleLine(text = "My aunt lives in the same building.", meaning = "Family nearby."))), expressions = listOf(TargetExpression(text = "There are + number + of us", meaning = "Family size.", note = "There are five of us."), TargetExpression(text = "My … is + job/age", meaning = "One detail.", note = "My brother is nineteen."), TargetExpression(text = "He's / She's + adjective", meaning = "Personality.", note = "She's very funny."), TargetExpression(text = "I have + number + cousins", meaning = "Count the family.", note = "I have six cousins."), TargetExpression(text = "the oldest / the youngest", meaning = "Order in the family.", note = "I'm the youngest."), TargetExpression(text = "We're a close family.", meaning = "The warm line.", note = "close = unido."), TargetExpression(text = "We look alike.", meaning = "Physical similarity.", note = "alike = one word, after the verb.")), situation = "You describe your family photo wall to a new friend: size, one detail per person, ages and who is the oldest.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Say how many people there are in your family.", expected = listOf("There are <number> of us."), focus = "family size", watch = "There are four of us — not “we are four”."), PracticeQuestion(prompt = "Give one detail about your sister. (student)", expected = listOf("My sister is a student."), focus = "detail", watch = "One line per person: job, age or personality."), PracticeQuestion(prompt = "Say your father's age. (60)", expected = listOf("My father is sixty (years old)."), focus = "age with be", watch = "“My father has sixty” — age uses is."), PracticeQuestion(prompt = "Say who is the oldest in your family.", expected = listOf("My <relative> is the oldest."), focus = "the oldest", watch = "the oldest of three / in my family."), PracticeQuestion(prompt = "Say you and your sister look similar.", expected = listOf("We look alike.", "My sister and I look alike."), focus = "look alike", watch = "alike after the verb: “we look alike”, never “we look like”."))), exercises = listOf(Exercise(id = "en-foundations-friends-family-e1", kind = "choice", prompt = "My father ___ sixty years old.", options = listOf("is", "has", "are", "does"), answers = listOf("is"), explain = "Age with be: is sixty."), Exercise(id = "en-foundations-friends-family-e2", kind = "gap", prompt = "There ___ five of us in my family.", options = listOf(), answers = listOf("are", "'re"), explain = "There are five of us."), Exercise(id = "en-foundations-friends-family-e3", kind = "order", prompt = "Say your position in the family.", options = listOf(), answers = listOf("I'm the youngest in my family"), explain = "I'm the youngest."), Exercise(id = "en-foundations-friends-family-e4", kind = "written", prompt = "Describe one family member in one sentence.", options = listOf(), answers = listOf("my <relative> is <detail>", "my sister is very funny"), explain = "One detail is enough.")), skills = listOf("vocab:family", "grammar:verb-be", "grammar:have-got", "function:describe-people"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:verb-be")),
    Lesson(id = "en-foundations-friends-likes", title = "What do you like?", goal = "Talk about likes and dislikes with love, like, don't like and hate.", intro = LessonIntro(explanation = listOf("The pattern: subject + love/like/don't like/hate + noun or verb-ing: “I love music.” “She likes dancing.”", "Ask: “Do you like…?” Short answers repeat do: “Yes, I do. / No, I don't.”", "Strong words: love is 100%, like is warm, don't like is polite, hate is strong — use hate for fun, carefully."), examples = listOf(ExampleLine(text = "I love music.", meaning = "100% positive."), ExampleLine(text = "She likes dancing.", meaning = "like + -ing for activities."), ExampleLine(text = "I don't like coffee.", meaning = "Polite negative."), ExampleLine(text = "Do you like football?", meaning = "The question."), ExampleLine(text = "I hate Mondays!", meaning = "Strong — often funny."), ExampleLine(text = "I quite like her podcasts.", meaning = "quite softens like."))), expressions = listOf(TargetExpression(text = "I love / like + noun", meaning = "Positive feelings.", note = "I like your bag."), TargetExpression(text = "love / like + -ing", meaning = "Activities.", note = "I love swimming."), TargetExpression(text = "Do you like …?", meaning = "Ask.", note = "Do you like cats?"), TargetExpression(text = "Yes, I do / No, I don't", meaning = "Short answers.", note = "Repeat do."), TargetExpression(text = "I don't like …", meaning = "Polite negative.", note = "Softer than hate."), TargetExpression(text = "My favourite … is …", meaning = "The top one.", note = "My favourite food is pasta."), TargetExpression(text = "…is not really my thing.", meaning = "Polite dislike.", note = "Horror films are not my thing.")), situation = "You and a friend find common ground: ask about food, music and weekends, and discover one thing you both hate.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ask if your friend likes cats.", expected = listOf("Do you like cats?"), focus = "the question", watch = "Do + you + like: no -s with you."), PracticeQuestion(prompt = "Say you love swimming.", expected = listOf("I love swimming."), focus = "love + -ing", watch = "“I love to swim” also works — both are fine."), PracticeQuestion(prompt = "Say you don't like coffee, politely.", expected = listOf("I don't like coffee."), focus = "polite negative", watch = "“I hate coffee” is strong — don't like is softer."), PracticeQuestion(prompt = "Say your favourite food.", expected = listOf("My favourite food is <food>."), focus = "favourite", watch = "favourite food is + noun."), PracticeQuestion(prompt = "Say horror films are not for you, politely.", expected = listOf("Horror films are not really my thing.", "They're not my thing."), focus = "not my thing", watch = "The polite way to dislike something."))), exercises = listOf(Exercise(id = "en-foundations-friends-likes-e1", kind = "choice", prompt = "___ you like football?", options = listOf("Do", "Does", "Are", "Is"), answers = listOf("Do"), explain = "With you: Do you like…?"), Exercise(id = "en-foundations-friends-likes-e2", kind = "choice", prompt = "She ___ dancing.", options = listOf("likes", "like", "liking", "to like"), answers = listOf("likes"), explain = "Third person -s: she likes."), Exercise(id = "en-foundations-friends-likes-e3", kind = "order", prompt = "Say you love music.", options = listOf(), answers = listOf("I love music"), explain = "I love + noun."), Exercise(id = "en-foundations-friends-likes-e4", kind = "written", prompt = "Short answer: “Do you like cats?” (yes)", options = listOf(), answers = listOf("yes i do", "yes, i do"), explain = "Short answers repeat do.")), skills = listOf("grammar:present-simple", "grammar:present-questions", "vocab:hobbies", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "en-foundations-friends-plans", title = "Plans with friends", goal = "Arrange to meet: suggest, check free time and confirm the plan.", intro = LessonIntro(explanation = listOf("Arrange in three steps: suggest (“Do you want to…?”), check time (“Are you free on Saturday?”), confirm (“See you at eight!”).", "Do you want to + verb is the friendliest opener between equals. Let's works once you agree.", "Times and places finish the plan: “At eight, at the main square.” A plan without a place is a wish."), examples = listOf(ExampleLine(text = "Do you want to see a film?", meaning = "The friendly opener."), ExampleLine(text = "Are you free on Saturday?", meaning = "Check the time."), ExampleLine(text = "Let's meet at eight.", meaning = "Confirm the detail."), ExampleLine(text = "See you at the main square!", meaning = "Place confirmed."), ExampleLine(text = "Sorry, I can't. Sunday?", meaning = "Decline + counter-offer."), ExampleLine(text = "I'll check my diary and let you know.", meaning = "A soft maybe."))), expressions = listOf(TargetExpression(text = "Do you want to + verb?", meaning = "Open the plan.", note = "Do you want to go out?"), TargetExpression(text = "Are you free + day?", meaning = "Check the diary.", note = "Are you free on Friday?"), TargetExpression(text = "Let's + verb + time/place", meaning = "Confirm.", note = "Let's meet at seven."), TargetExpression(text = "at + time, at/in + place", meaning = "The details.", note = "At eight, at the square."), TargetExpression(text = "Sorry, I can't. …?", meaning = "Decline + retry.", note = "…How about Sunday?"), TargetExpression(text = "See you …!", meaning = "Close the plan.", note = "See you Saturday!"), TargetExpression(text = "I can't wait!", meaning = "Enthusiasm for the plan.", note = "can't wait + for/to.")), situation = "You arrange a Saturday with a friend: suggest an activity, check Saturday, hear a no, move to Sunday and confirm time and place.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Suggest seeing a film.", expected = listOf("Do you want to see a film?"), focus = "the opener", watch = "Do you want to + verb — friendliest form."), PracticeQuestion(prompt = "Check if your friend is free on Saturday.", expected = listOf("Are you free on Saturday?"), focus = "free + day", watch = "free ON Saturday."), PracticeQuestion(prompt = "Decline Saturday and offer Sunday.", expected = listOf("Sorry, I can't on Saturday. How about Sunday?"), focus = "decline + retry", watch = "Always add the counter-offer."), PracticeQuestion(prompt = "Confirm: eight, at the main square.", expected = listOf("Let's meet at eight, at the main square."), focus = "the details", watch = "A plan needs a time AND a place."), PracticeQuestion(prompt = "You're not sure yet. Answer softly.", expected = listOf("I'll check my diary and let you know.", "Maybe — let me check."), focus = "soft maybe", watch = "A soft maybe is kinder than a slow no."))), exercises = listOf(Exercise(id = "en-foundations-friends-plans-e1", kind = "choice", prompt = "Do you want ___ see a film?", options = listOf("to", "for", "see", "seeing"), answers = listOf("to"), explain = "want to + verb."), Exercise(id = "en-foundations-friends-plans-e2", kind = "choice", prompt = "Are you free ___ Saturday?", options = listOf("on", "in", "at", "to"), answers = listOf("on"), explain = "Days take on: on Saturday."), Exercise(id = "en-foundations-friends-plans-e3", kind = "order", prompt = "Confirm the meeting.", options = listOf(), answers = listOf("Let's meet at eight at the main square"), explain = "Let's + verb + details."), Exercise(id = "en-foundations-friends-plans-e4", kind = "written", prompt = "Decline tonight and offer Friday.", options = listOf(), answers = listOf("sorry i can't tonight how about friday", "i can't tonight how about friday"), explain = "Decline + counter-offer.")), skills = listOf("function:make-future-plans", "grammar:present-questions", "grammar:time-expressions", "vocab:social-expressions"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:verb-be"))))
}

object EnFoundationsFeelings {
    val unit = CourseUnit(id = "en-foundations-feelings", title = "Feelings & opinions", subtitle = "Say what you think", level = "A1", themes = listOf(ConversationTheme("mood-check", "The mood check", "How is everyone?", "face.smiling", "Course", "You and your friends check in on each other's mood and talk about what makes you feel good.", 0),
                ConversationTheme("pick-a-film", "Pick a film", "I like it / I don't", "film", "Course", "You choose a film together: say what you like, what you don't and why.", 1)), lessons = listOf(    Lesson(id = "en-foundations-feelings-mood", title = "How are you feeling?", goal = "Talk about feelings and moods with be and feel.", intro = LessonIntro(explanation = listOf("Feelings use be: “I'm happy.” “She's tired.” “They're excited.”", "feel works for health and vague states: “I feel sick.” “I feel good about it.”", "Ask: “How are you feeling?” or the simpler “How are you?” — both are always welcome."), examples = listOf(ExampleLine(text = "I'm happy today!", meaning = "Positive with be."), ExampleLine(text = "She's tired after work.", meaning = "be + adjective."), ExampleLine(text = "I feel good about the exam.", meaning = "feel + adjective."), ExampleLine(text = "They're excited about the trip.", meaning = "excited + about."), ExampleLine(text = "He's a bit sad today.", meaning = "a bit softens it."))), expressions = listOf(TargetExpression(text = "I'm / She's + feeling", meaning = "State a mood.", note = "I'm nervous."), TargetExpression(text = "I feel + adjective", meaning = "How it feels inside.", note = "I feel great."), TargetExpression(text = "How are you feeling?", meaning = "Ask about mood.", note = "Better, thanks!"), TargetExpression(text = "a bit + adjective", meaning = "Soften it.", note = "a bit tired."), TargetExpression(text = "excited / worried about …", meaning = "Feelings with about.", note = "excited about the trip."), TargetExpression(text = "That's good to hear.", meaning = "React to good news.", note = "Fixed phrase.")), situation = "You and two friends check in before class: how is everyone today, who is excited, who is a bit nervous and why.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Say how you feel today. (happy)", expected = listOf("I'm happy today."), focus = "be + adjective", watch = "Feelings use be: I'm happy."), PracticeQuestion(prompt = "Say you feel nervous about the test.", expected = listOf("I feel nervous about the test."), focus = "feel + about", watch = "feel nervous ABOUT the test."), PracticeQuestion(prompt = "Ask a friend how they feel.", expected = listOf("How are you feeling?"), focus = "the question", watch = "Present continuous: how ARE you feeling."), PracticeQuestion(prompt = "React to good news: your friend is excited.", expected = listOf("That's good to hear!", "Great! I'm excited too."), focus = "react", watch = "That's good to hear — fixed phrase."), PracticeQuestion(prompt = "Soften your answer: a bit tired.", expected = listOf("I'm a bit tired."), focus = "a bit", watch = "a bit = un poco — softens the adjective."), PracticeQuestion(prompt = "Say your friend seems excited about something.", expected = listOf("She's excited about the party."), focus = "excited about", watch = "excited ABOUT + thing."))), exercises = listOf(Exercise(id = "en-foundations-feelings-mood-e1", kind = "choice", prompt = "I ___ nervous about the exam.", options = listOf("feel", "feels", "am feel", "feeling"), answers = listOf("feel"), explain = "feel + adjective: I feel nervous."), Exercise(id = "en-foundations-feelings-mood-e2", kind = "gap", prompt = "She's ___ about the party. (excited)", options = listOf(), answers = listOf("excited"), explain = "excited about + thing."), Exercise(id = "en-foundations-feelings-mood-e3", kind = "order", prompt = "Ask about mood.", options = listOf(), answers = listOf("How are you feeling today"), explain = "How + are + you + feeling."), Exercise(id = "en-foundations-feelings-mood-e4", kind = "written", prompt = "Say how you feel with one adjective.", options = listOf(), answers = listOf("im <feeling>", "i feel <feeling>"), explain = "I'm happy / I feel good.")), skills = listOf("grammar:verb-be", "vocab:feelings", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:verb-be")),
    Lesson(id = "en-foundations-feelings-likes", title = "I like it / I don't", goal = "Say what you like and don't like, and ask about others.", intro = LessonIntro(explanation = listOf("like/love/hate + noun: “I like pizza.” “She loves music.” “They hate waiting.”", "Don't like is the polite negative: “I don't like horror films.” — softer than hate.", "Ask: “Do you like…?” Answer: “Yes, I do” / “No, I don't” — the do carries the tense."), examples = listOf(ExampleLine(text = "I like pizza a lot.", meaning = "like + noun."), ExampleLine(text = "She loves reggaeton.", meaning = "love = stronger."), ExampleLine(text = "I don't like horror films.", meaning = "Polite negative."), ExampleLine(text = "Do you like rap?", meaning = "The question."), ExampleLine(text = "He hates waiting in lines.", meaning = "hate + -ing."))), expressions = listOf(TargetExpression(text = "I like / love + noun", meaning = "Positive.", note = "I like this song."), TargetExpression(text = "I don't like + noun", meaning = "Polite negative.", note = "Not “I no like”."), TargetExpression(text = "Do you like …?", meaning = "Ask.", note = "Yes, I do / No, I don't."), TargetExpression(text = "love / like + -ing", meaning = "Activities.", note = "I like swimming."), TargetExpression(text = "My favourite … is …", meaning = "The top choice.", note = "My favourite food is sushi.")), situation = "You choose a film for movie night: ask what everyone likes, say your preferences and find something nobody hates.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ask if your friend likes comedies.", expected = listOf("Do you like comedies?"), focus = "the question", watch = "Do + you + base verb."), PracticeQuestion(prompt = "Say you love action films.", expected = listOf("I love action films."), focus = "love + noun", watch = "love is stronger than like."), PracticeQuestion(prompt = "Say you don't like horror films, politely.", expected = listOf("I don't like horror films."), focus = "polite negative", watch = "don't like, not hate — save hate for real hate."), PracticeQuestion(prompt = "Say your favourite film.", expected = listOf("My favourite film is <film>."), focus = "favourite", watch = "favourite + noun + is + answer."), PracticeQuestion(prompt = "Find common ground: you both like comedies.", expected = listOf("We both like comedies!"), focus = "both", watch = "both = los dos."))), exercises = listOf(Exercise(id = "en-foundations-feelings-likes-e1", kind = "choice", prompt = "___ she like jazz?", options = listOf("Does", "Do", "Is", "Has"), answers = listOf("Does"), explain = "Third person: Does she like…?"), Exercise(id = "en-foundations-feelings-likes-e2", kind = "gap", prompt = "I ___ like spicy food. (negative)", options = listOf(), answers = listOf("don't", "do not"), explain = "don't + base verb."), Exercise(id = "en-foundations-feelings-likes-e3", kind = "order", prompt = "Say your favourite food.", options = listOf(), answers = listOf("My favourite food is sushi"), explain = "My favourite + noun + is + answer."), Exercise(id = "en-foundations-feelings-likes-e4", kind = "written", prompt = "Say one thing you love.", options = listOf(), answers = listOf("i love <thing>", "i really love <thing>"), explain = "I love + noun or -ing.")), skills = listOf("grammar:present-simple", "grammar:present-questions", "grammar:gerunds-infinitives", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "en-foundations-feelings-opinions", title = "I think…", goal = "Give simple opinions with I think and ask What do you think?", intro = LessonIntro(explanation = listOf("I think + opinion: “I think it's great.” “I don't think it's a good idea.”", "Ask: “What do you think?” — the most useful opinion question in English.", "Agree and disagree simply: “I agree.” “I don't agree.” “Really? I think the opposite.”"), examples = listOf(ExampleLine(text = "I think it's great.", meaning = "Positive opinion."), ExampleLine(text = "I don't think it's a good idea.", meaning = "Negative opinion (softened)."), ExampleLine(text = "What do you think?", meaning = "Ask for opinions."), ExampleLine(text = "I agree.", meaning = "Same view."), ExampleLine(text = "Really? I think the opposite.", meaning = "Different view."))), expressions = listOf(TargetExpression(text = "I think + opinion", meaning = "Give a view.", note = "I think it's good."), TargetExpression(text = "I don't think …", meaning = "Negative, softened.", note = "Not “I think it isn't”."), TargetExpression(text = "What do you think?", meaning = "Ask.", note = "About this plan?"), TargetExpression(text = "I agree / I don't agree", meaning = "React.", note = "agree with + person."), TargetExpression(text = "Really? I think …", meaning = "Different opinion.", note = "Opposite view, politely.")), situation = "You and a friend rate three weekend plans: park, cinema or museum. Give opinions with I think and find the winner together.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Give an opinion about the park plan.", expected = listOf("I think the park is a good idea."), focus = "I think", watch = "I think + subject + verb."), PracticeQuestion(prompt = "Disagree softly about the cinema.", expected = listOf("I don't think the cinema is a good idea today."), focus = "soft negative", watch = "I don't think + positive — English moves the negative forward."), PracticeQuestion(prompt = "Ask your friend for their opinion.", expected = listOf("What do you think?"), focus = "the question", watch = "The most useful opinion question."), PracticeQuestion(prompt = "Agree with your friend's choice.", expected = listOf("I agree — let's go to the park."), focus = "agree", watch = "I agree + the plan."), PracticeQuestion(prompt = "Say which is your favourite and why.", expected = listOf("My favourite is the park because it's free."), focus = "favourite + because", watch = "Favourite + because + reason."))), exercises = listOf(Exercise(id = "en-foundations-feelings-opinions-e1", kind = "choice", prompt = "I ___ think it's a good idea. (negative)", options = listOf("don't", "do", "am not", "doesn't"), answers = listOf("don't"), explain = "I don't think + positive — English moves the negative."), Exercise(id = "en-foundations-feelings-opinions-e2", kind = "gap", prompt = "What ___ you think? (opinion question)", options = listOf(), answers = listOf("do"), explain = "What do you think?"), Exercise(id = "en-foundations-feelings-opinions-e3", kind = "order", prompt = "Agree with the plan.", options = listOf(), answers = listOf("I agree lets go to the park"), explain = "I agree + plan."), Exercise(id = "en-foundations-feelings-opinions-e4", kind = "written", prompt = "Give a simple opinion about music.", options = listOf(), answers = listOf("i think music is <adj>", "i think <genre> is great"), explain = "I think + noun + is + adjective.")), skills = listOf("function:express-opinion", "grammar:present-simple", "grammar:present-questions", "vocab:social-expressions"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:present-simple"))))
}

object EnFoundationsMeals {
    val unit = CourseUnit(id = "en-foundations-meals", title = "Food & meals", subtitle = "Cook, eat, order", level = "A1", themes = listOf(ConversationTheme("cooking-together", "Cooking together", "In the kitchen", "fork.knife", "Course", "You cook a simple dinner: check the fridge, follow a recipe and share the work.", 0),
                ConversationTheme("restaurant-menu", "At the restaurant", "Order and pay", "menucard", "Course", "You eat out: read the menu, order, ask for the bill and leave a tip.", 1)), lessons = listOf(    Lesson(id = "en-foundations-meals-cooking", title = "In the kitchen", goal = "Talk about cooking: ingredients, actions and kitchen tools.", intro = LessonIntro(explanation = listOf("Cooking verbs: chop, mix, cook, bake, boil. “Chop the onions. Boil the water. Bake for 30 minutes.”", "Ingredients with have got / need: “We have got eggs. We need flour.”", "Kitchen tools: a pan, a pot, a knife, a cutting board, an oven."), examples = listOf(ExampleLine(text = "Chop the onions, please.", meaning = "Chop + food."), ExampleLine(text = "Boil the water first.", meaning = "Boil + liquid."), ExampleLine(text = "We have got eggs but we need flour.", meaning = "have vs need."), ExampleLine(text = "Bake it for 30 minutes.", meaning = "bake for + duration."), ExampleLine(text = "The pan is on the stove.", meaning = "Location."))), expressions = listOf(TargetExpression(text = "Chop / mix / cook / boil / bake", meaning = "The five cooking verbs.", note = "Each has its tool."), TargetExpression(text = "We need + ingredient", meaning = "Say what's missing.", note = "We need flour."), TargetExpression(text = "We have got …", meaning = "Say what you have.", note = "We have got eggs."), TargetExpression(text = "Bake / cook for + time", meaning = "Duration.", note = "for 30 minutes."), TargetExpression(text = "in the oven / on the stove", meaning = "Where it cooks.", note = "in vs on.")), situation = "You and a friend cook pasta together: check what you have, what you need, and divide the cooking actions.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Say what you need from the shop. (flour, tomatoes)", expected = listOf("We need flour and tomatoes."), focus = "need + ingredients", watch = "need + plural or uncountable."), PracticeQuestion(prompt = "Say what you already have. (eggs)", expected = listOf("We have got eggs."), focus = "have got", watch = "have got + ingredient."), PracticeQuestion(prompt = "Give one cooking action. (chop the onions)", expected = listOf("Chop the onions."), focus = "imperative", watch = "Cooking instructions use imperatives."), PracticeQuestion(prompt = "Say how long to bake it. (30 minutes)", expected = listOf("Bake it for 30 minutes."), focus = "for + duration", watch = "bake for + time."), PracticeQuestion(prompt = "Say where the pan is. (on the stove)", expected = listOf("The pan is on the stove."), focus = "on the stove", watch = "on the stove, in the oven."))), exercises = listOf(Exercise(id = "en-foundations-meals-cooking-e1", kind = "choice", prompt = "___ the onions and ___ the water.", options = listOf("Chop … boil", "Boil … chop", "Mix … bake", "Cut … oven"), answers = listOf("Chop … boil"), explain = "Chop solid food; boil liquids."), Exercise(id = "en-foundations-meals-cooking-e2", kind = "gap", prompt = "We ___ flour. Can you buy some?", options = listOf(), answers = listOf("need"), explain = "need + ingredient."), Exercise(id = "en-foundations-meals-cooking-e3", kind = "order", prompt = "Give a cooking instruction.", options = listOf(), answers = listOf("Bake it for thirty minutes"), explain = "bake for + duration."), Exercise(id = "en-foundations-meals-cooking-e4", kind = "written", prompt = "Name two things you need to make pasta.", options = listOf(), answers = listOf("we need pasta and tomatoes", "pasta and tomatoes"), explain = "We need X and Y.")), skills = listOf("vocab:food", "grammar:imperatives", "grammar:have-got", "function:talk-about-routines", "pron:short-long-vowels"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "en-foundations-meals-restaurant", title = "At the restaurant", goal = "Order food, ask for the bill and leave a tip.", intro = LessonIntro(explanation = listOf("Order: “I'll have the pasta.” “Can I get the salad?” “For me, the soup.” — all natural.", "The waiter asks: “Are you ready to order?” “Anything to drink?” “How is everything?”", "The bill: “Could we have the bill, please?” “Is service included?” — then tip if the service was good."), examples = listOf(ExampleLine(text = "I'll have the pasta.", meaning = "The classic order."), ExampleLine(text = "Can I get the salad, please?", meaning = "Alternative order."), ExampleLine(text = "Are you ready to order?", meaning = "The waiter asks."), ExampleLine(text = "Could we have the bill, please?", meaning = "Ask to pay."), ExampleLine(text = "Is service included?", meaning = "Check before tipping."))), expressions = listOf(TargetExpression(text = "I'll have + dish", meaning = "The order.", note = "I'll have the soup."), TargetExpression(text = "Can I get + dish", meaning = "Alternative order.", note = "Can I get the salad?"), TargetExpression(text = "Are you ready to order?", meaning = "Waiter's question.", note = "Yes, I'll have…"), TargetExpression(text = "Could we have the bill?", meaning = "Ask to pay.", note = "the bill / the check (US)."), TargetExpression(text = "Is service included?", meaning = "Tip check.", note = "Then tip or don't.")), situation = "You and a friend eat out: order two dishes and two drinks, ask about a dish you don't recognise and ask for the bill.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Order your main dish.", expected = listOf("I'll have the pasta, please.", "Can I get the salad, please?"), focus = "ordering", watch = "I'll have or Can I get — both natural."), PracticeQuestion(prompt = "Order a drink.", expected = listOf("And a lemonade, please.", "Can I get a water too?"), focus = "drinks", watch = "Add please — it matters."), PracticeQuestion(prompt = "Ask about an unknown dish.", expected = listOf("What's in the paella?"), focus = "what's in", watch = "what's in + dish = qué lleva."), PracticeQuestion(prompt = "Ask for the bill.", expected = listOf("Could we have the bill, please?"), focus = "the bill", watch = "Could we have — polite."), PracticeQuestion(prompt = "Ask if service is included before tipping.", expected = listOf("Is service included?"), focus = "tip check", watch = "If yes, no tip needed."))), exercises = listOf(Exercise(id = "en-foundations-meals-restaurant-e1", kind = "choice", prompt = "I'll ___ the pasta.", options = listOf("have", "has", "having", "to have"), answers = listOf("have"), explain = "I'll have + dish — the classic order."), Exercise(id = "en-foundations-meals-restaurant-e2", kind = "gap", prompt = "Could we have the ___, please? (cuenta)", options = listOf(), answers = listOf("bill", "check"), explain = "the bill (UK) / the check (US)."), Exercise(id = "en-foundations-meals-restaurant-e3", kind = "order", prompt = "Order the soup.", options = listOf(), answers = listOf("Ill have the soup please"), explain = "I'll have + dish + please."), Exercise(id = "en-foundations-meals-restaurant-e4", kind = "written", prompt = "Pregunte qué lleva la paella.", options = listOf(), answers = listOf("whats in the paella", "what is in the paella"), explain = "What's in + dish?")), skills = listOf("function:order-food", "vocab:food", "grammar:present-questions", "function:make-requests"), canDo = listOf("order-food"), prerequisites = listOf("grammar:some-any"))))
}

object EnFoundationsShopping {
    val unit = CourseUnit(id = "en-foundations-shopping", title = "Shopping", subtitle = "Buy what you need", level = "A1", themes = listOf(ConversationTheme("clothes-shop", "The clothes shop", "Does it fit?", "tshirt", "Course", "You buy clothes: sizes, colours, trying things on and asking about price.", 0),
                ConversationTheme("food-shopping", "Food shopping", "How much / how many", "cart", "Course", "You shop for a recipe: count items, ask about quantities and pay.", 1)), lessons = listOf(    Lesson(id = "en-foundations-shopping-clothes", title = "Buying clothes", goal = "Ask about sizes, colours and prices when shopping for clothes.", intro = LessonIntro(explanation = listOf("Clothes words: shirt, trousers, dress, shoes, jacket, hat. Sizes: small (S), medium (M), large (L).", "Ask: “Do you have this in a medium?” “Can I try it on?” — try on = probarse.", "Colours go before the noun: “a blue shirt”, “red shoes”."), examples = listOf(ExampleLine(text = "Do you have this in a medium?", meaning = "Ask for a size."), ExampleLine(text = "Can I try it on?", meaning = "Ask to test."), ExampleLine(text = "How much is this jacket?", meaning = "Ask the price."), ExampleLine(text = "I'll take it!", meaning = "Decide to buy."), ExampleLine(text = "It doesn't fit. Have you got a large?", meaning = "It's the wrong size."))), expressions = listOf(TargetExpression(text = "Do you have … in a …?", meaning = "Ask for a size.", note = "Do you have this in blue?"), TargetExpression(text = "Can I try it/them on?", meaning = "Ask to test.", note = "them for plurals."), TargetExpression(text = "How much is/are …?", meaning = "Price.", note = "How much are these shoes?"), TargetExpression(text = "I'll take it/them.", meaning = "Buy.", note = "I'll take it!"), TargetExpression(text = "It doesn't fit.", meaning = "Wrong size.", note = "Have you got a bigger one?")), situation = "You buy a jacket and shoes at a clothes shop: ask for sizes, try them on, check the price and decide.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Ask for a medium size jacket.", expected = listOf("Do you have this jacket in a medium?"), focus = "size", watch = "Have you got / Do you have + size."), PracticeQuestion(prompt = "Ask to try on the shoes.", expected = listOf("Can I 