}

object ItFoundationsU3 {
    val unit = CourseUnit(id = "it-foundations-u3", title = "Il passato", subtitle = "Cosa hai fatto ?", level = "A2", themes = listOf(ConversationTheme("weekend-passato", "Il weekend passato", "Passato prossimo", "clock.arrow.circlepath", "Course", "Raccontate il weekend: cosa avete fatto, dove siete andati.", 0),
                ConversationTheme("viaggio-ricordo", "Il viaggio dell'anno scorso", "Ricordi", "airplane", "Course", "Un viaggio memorabile: dove siete stati, cosa avete visto.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u3-passato-prossimo", title = "Il passato prossimo", goal = "Raccontare azioni finite con essere/avere + participio passato.", intro = LessonIntro(explanation = listOf("Passato prossimo = ausiliare (essere o avere) + participio passato. « Ho mangiato. Sono andato. »", "La maggior parte dei verbi usa avere. I verbi di movimento (andare, venire, uscire) usano essere.", "Con essere, il participio si accorda: « Lei è andata » (femminile), « Loro sono andati » (plurale)."), examples = listOf(ExampleLine(text = "Ho mangiato una paella ieri.", meaning = "avere + mangiato."), ExampleLine(text = "Sono andato al cinema.", meaning = "essere + andato."), ExampleLine(text = "Abbiamo visto un film.", meaning = "avere + visto."), ExampleLine(text = "Lei è uscita presto.", meaning = "essere + uscita (femminile)."), ExampleLine(text = "Hai fatto i compiti ?", meaning = "avere + fatto."))), expressions = listOf(TargetExpression(text = "ho / hai / ha + participio", meaning = "Avere + participio.", note = "Ho mangiato."), TargetExpression(text = "sono / sei / è + participio", meaning = "Essere per movimento.", note = "Sono andato."), TargetExpression(text = "fatto / detto / visto / scritto", meaning = "Participi irregolari.", note = "fare → fatto."), TargetExpression(text = "accordo con essere", meaning = "e/a/i/e secondo il soggetto.", note = "lei è uscita, loro sono usciti."), TargetExpression(text = "ieri / la settimana scorsa", meaning = "Marcatori temporali.", note = "Ieri ho visto…")), situation = "Raccontate il weekend: cosa avete fatto, dove siete andati e una sorpresa.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di un'azione del weekend. (mangiare fuori)", expected = listOf("Ho mangiato fuori."), focus = "avere + pp", 