                ConversationTheme("le-depart", "Le départ", "Réserver, dernière vérification", "airplane", "Course", "Vous réservez le taxi et l'hôtel pour demain, puis vous laissez un mot au voisin pour les plantes.", 1)), lessons = listOf(    Lesson(id = "fr-foundations-u25-valise", title = "Je vais prendre mon maillot", goal = "Parler de la valise avec aller + infinitif : ce qu'on va prendre et ce qu'on ne va pas oublier.", intro = LessonIntro(explanation = listOf("Le futur proche se fait avec aller + infinitif : « Je vais prendre mon maillot. » « On va partir tôt demain. »", "Les indispensables avec ne pas oublier : « Il ne faut pas oublier les documents. » « N'oublie pas ton passeport ! »", "On organise avec d'abord… ensuite… enfin : « D'abord les papiers, ensuite les vêtements, enfin les chargeurs. »"), examples = listOf(ExampleLine(text = "Je vais prendre mon maillot.", meaning = "Le futur proche de la valise."), ExampleLine(text = "On va partir tôt demain matin.", meaning = "Le plan du départ."), ExampleLine(text = "Il ne faut pas oublier les documents.", meaning = "L'alerte des papiers."), ExampleLine(text = "N'oublie pas ton passeport !", meaning = "Le rappel entre amis."), ExampleLine(text = "D'abord les papiers, ensuite les vêtements, enfin les chargeurs.", meaning = "L'ordre du rangement."), ExampleLine(text = "Tu vas prendre ton parapluie ?", meaning = "La question du futur proche."))), expressions = listOf(TargetExpression(text = "aller + infinitif", meaning = "Le futur proche.", note = "Je vais prendre la valise."), TargetExpression(text = "ne pas oublier + nom", meaning = "L'indispensable.", note = "N'oublie pas les documents !"), TargetExpression(text = "il faut + infinitif", meaning = "Le nécessaire.", note = "Il faut vérifier les papiers."), TargetExpression(text = "faire sa valise", meaning = "L'expression du rangement.", note = "Je fais ma valise ce soir."), TargetExpression(text = "d'abord… ensuite… enfin", meaning = "L'ordre du tri.", note = 