port"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u14-horario", title = "A que horas sai ?", goal = "Dizer e perguntar as horas dos transportes: A que horas sai ? Sai às oito.", intro = LessonIntro(explanation = listOf("Dizer as horas: « às oito, às seis e meia, às nove e vinte ». « O trem sai às oito ».", "Perguntar a hora do transporte: « A que horas sai o ônibus ? ». A resposta é curta: « Sai às nove ».", "Sair e chegar: « O trem sai às oito e chega às oito e vinte ». « chega » = llega."), examples = listOf(ExampleLine(text = "A que horas sai o metrô ?", meaning = "Perguntar a hora."), ExampleLine(text = "O metrô sai às seis e meia.", meaning = "sair + às + hora."), ExampleLine(text = "O trem chega às nove.", meaning = "chegar + às + hora."), ExampleLine(text = "O ônibus sai às sete e vinte.", meaning = "e vinte = :20."), ExampleLine(text = "Sai às oito, todos os dias.", meaning = "rotina com horas."))), expressions = listOf(TargetExpression(text = "A que horas … ?", meaning = "Perguntar a hora.", note = "A que horas sai o trem ?"), TargetExpression(text = "sai às …", meaning = "Parte a una hora.", note = "Sai às sete."), TargetExpression(text = "chega às …", meaning = "Llega a una hora.", note = "Chega às oito e vinte."), TargetExpression(text = "e meia", meaning = "Hora y media (:30).", note = "Às seis e meia."), TargetExpression(text = "e vinte", meaning = "Hora y veinte (:20).", note = "Às nove e vinte.")), situation = "Na estação, a Ana pergunta a que horas sai o trem para o centro.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pergunte a hora de partida do metrô.", expected = listOf("A que horas sai o metrô ?", "a que horas sai o metro"), focus = "A que horas … ?", watch = "A que horas + sai."), PracticeQuestion(prompt = "Diga a hora de partida do trem: oito.", expected = listOf("O trem sai às oito.", "o trem sai as oito"), focus = "sai às", watch = "sai + às + hora."), PracticeQuestion(prompt = "Diga a hora de chegada do ônibus: nove e vinte.", e