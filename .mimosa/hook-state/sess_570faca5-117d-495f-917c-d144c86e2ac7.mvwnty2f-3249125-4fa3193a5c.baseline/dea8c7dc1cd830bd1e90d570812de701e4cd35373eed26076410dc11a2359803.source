object PtFoundationsU15 {
    val unit = CourseUnit(id = "pt-foundations-u15", title = "Me sinto bem", subtitle = "Saúde básica", level = "A1", themes = listOf(ConversationTheme("saude-sintomas", "Os sintomas", "Não me sinto bem", "cross.case", "Course", "A Ana não está bem: dor de cabeça e febre. Ela diz como se sente.", 0),
                ConversationTheme("saude-farmacia", "A farmácia", "Remédios e hábitos", "pills", "Course", "Na farmácia, a Ana pede um remédio; em casa, todos falam de hábitos saudáveis.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u15-sintomas", title = "Não me sinto bem", goal = "Dizer sintomas: estou com dor de cabeça, estou com febre.", intro = LessonIntro(explanation = listOf("Dizer como você está: « Não me sinto bem », « Estou doente ». « sentir-se » = sentirse.", "Sintomas com « estar com »: « Estou com dor de cabeça », « Estou com febre », « Estou com tosse ».", "Perguntar: « Como você está ? », « O que você tem ? ». A resposta: « Estou com dor de cabeça »."), examples = listOf(ExampleLine(text = "Hoje não me sinto bem.", meaning = "sentir-se mal."), ExampleLine(text = "Estou com dor de cabeça.", meaning = "dor de cabeça = dolor de cabeza."), ExampleLine(text = "Estou com febre.", meaning = "estar com + sintoma."), ExampleLine(text = "Ele está com tosse.", meaning = "tosse = tos."), ExampleLine(text = "O que você tem ?", meaning = "Perguntar o sintoma."))), expressions = listOf(TargetExpression(text = "não me sinto bem", meaning = "No me siento bien.", note = "Hoje não me sinto bem."), TargetExpression(text = "estou com dor de cabeça", meaning = "Dolor de cabeza.", note = "Estou com dor de cabeça."), TargetExpression(text = "estou com febre", meaning = "Tengo fiebre.", note = "Estou com febre alta."), TargetExpression(text = "estou com tosse", meaning = "Tengo tos.", note = "Ele está com tosse."), TargetExpression(text = "O que você tem ?", meaning = "¿Qué tienes ?", note = "O que você tem ? — Estou com febre.")), situation = "A Ana não está bem: está com dor de cabeça e febre, e o Leo pergunta como ela está.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga que hoje você não se sente bem.", expected = listOf("Hoje não me sinto bem.", "hoje nao me sinto bem"), focus = "não me sinto bem", watch = "sinto = siento."), PracticeQuestion(prompt = "Diga que você está com dor de cabeça.", expected = listOf("Estou com dor de cabeça.", "estou com dor de cabeca"), focus = "dor de cabeça", watch = "cabeça com cedilha."), PracticeQuestion(prompt = "Diga que você está com febre.", expected = listOf("Estou com febre.", "Tenho febre.", "estou com febre"), focus = "febre", watch = "estar com + sintoma."), PracticeQuestion(prompt = "Pergunte como a amiga está.", expected = listOf("Como você está ?", "como voce esta"), focus = "Como está ?", watch = "estar para o estado."), PracticeQuestion(prompt = "Pergunte o que a colega tem.", expected = listOf("O que você tem ?", "o que voce tem"), focus = "O que … tem ?", watch = "Pergunta do sintoma."))), exercises = listOf(Exercise(id = "pt-foundations-u15-sintomas-e1", kind = "choice", prompt = "A cabeça dói. A pessoa diz: « Estou com ___ ».", options = listOf("dor de cabeça", "pressa", "fome", "medo"), answers = listOf("dor de cabeça"), explain = "A cabeça dói: dor de cabeça."), Exercise(id = "pt-foundations-u15-sintomas-e2", kind = "gap", prompt = "Ela está com ___ alta: 39 graus.", options = listOf(), answers = listOf("febre"), explain = "Febre alta: a temperatura sobe."), Exercise(id = "pt-foundations-u15-sintomas-e3", kind = "order", prompt = "Pergunte o sintoma da colega.", options = listOf(), answers = listOf("O que voce tem"), explain = "O que você tem ? — pergunta do sintoma."), Exercise(id = "pt-foundations-u15-sintomas-e4", kind = "written", prompt = "Diga que você está com dor de cabeça e febre.", options = listOf(), answers = listOf("Estou com dor de cabeça e febre.", "estou com dor de cabeca e febre"), explain = "estar com + sintoma + e + sintoma.")), skills = listOf("function:talk-about-health", "vocab:health", "grammar:present-simple", "function:ask-simple-questions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u15-farmacia", title = "Na farmácia", goal = "Pedir algo para a dor na farmácia: Algo para dor de cabeça, por favor.", intro = LessonIntro(explanation = listOf("Na farmácia: « Boa tarde. Algo para dor de cabeça, por favor ». « para » indica o remédio.", "O farmacêutico pergunta e responde: « O que você tem ? » — « Estou com dor ». Ele dá o remédio: « Este aqui é bom ».", "Preço e instrução: « Quanto custa ? — Custa doze reais ». « Você toma um comprimido de manhã »."), examples = listOf(ExampleLine(text = "Algo para dor de cabeça, por favor.", meaning = "Pedido na farmácia."), ExampleLine(text = "Você tem algo para a febre ?", meaning = "Perguntar o remédio."), ExampleLine(text = "Este remédio é bom.", meaning = "este + remédio."), ExampleLine(text = "Quanto custa o comprimido ?", meaning = "Preço do remédio."), ExampleLine(text = "Você toma um comprimido de manhã.", meaning = "tomar + comprimido."))), expressions = listOf(TargetExpression(text = "algo para …", meaning = "Algo para un síntoma.", note = "Algo para a dor, por favor."), TargetExpression(text = "o farmacêutico", meaning = "El farmacéutico.", note = "O farmacêutico dá o remédio."), TargetExpression(text = "o remédio / o comprimido", meaning = "Medicina / pastilla.", note = "Tomo o remédio às oito."), TargetExpression(text = "Este aqui é bom.", meaning = "Recomendar.", note = "Este aqui é bom para a dor."), TargetExpression(text = "toma um comprimido", meaning = "Instrução do remédio.", note = "Você toma um comprimido à noite.")), situation = "Na farmácia, a Ana pede algo para a dor de cabeça e o farmacêutico dá um remédio.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Peça algo para a dor de cabeça na farmácia.", expected = listOf("Algo para dor de cabeça, por favor.", "algo para dor de cabeca por favor"), focus = "algo para", watch = "Pedido educado."), PracticeQuestion(prompt = "Pergunte se há algo para a febre.", expected = listOf("Você tem algo para a febre ?", "voce tem algo para a febre"), focus = "algo para a febre", watch = "Você tem … ?"), PracticeQuestion(prompt = "Dê a sua opinião sobre o remédio: bom.", expected = listOf("Este remédio é bom.", "este remedio e bom"), focus = "este", watch = "remédio com acento."), PracticeQuestion(prompt = "Pergunte o preço do remédio.", expected = listOf("Quanto custa o remédio ?", "quanto custa o remedio"), focus = "Quanto custa ?", watch = "o remédio."), PracticeQuestion(prompt = "Diga que você toma um comprimido de manhã.", expected = listOf("Tomo um comprimido de manhã.", "tomo um comprimido de manha"), focus = "tomo", watch = "tomar + comprimido."))), exercises = listOf(Exercise(id = "pt-foundations-u15-farmacia-e1", kind = "choice", prompt = "Na farmácia, você pede: « Algo ___ a dor, por favor ».", options = listOf("para", "com", "de", "sem"), answers = listOf("para"), explain = "Algo para a dor: « para » indica o remédio."), Exercise(id = "pt-foundations-u15-farmacia-e2", kind = "gap", prompt = "Você ___ um comprimido de manhã e um à noite.", options = listOf(), answers = listOf("toma"), explain = "Você toma: instrução do farmacêutico."), Exercise(id = "pt-foundations-u15-farmacia-e3", kind = "order", prompt = "Pergunte o preço do remédio.", options = listOf(), answers = listOf("Quanto custa o remedio"), explain = "Quanto custa o remédio ? — preço."), Exercise(id = "pt-foundations-u15-farmacia-e4", kind = "written", prompt = "Peça algo para a febre, com educação.", options = listOf(), answers = listOf("Algo para a febre, por favor.", "algo para a febre por favor"), explain = "Algo para + sintoma + por favor.")), skills = listOf("function:go-shopping", "vocab:health", "function:make-requests", "grammar:present-simple"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u15-habitos", title = "Vida saudável", goal = "Falar de hábitos com sempre e nunca: Sempre caminho, nunca como doce.", intro = LessonIntro(explanation = listOf("Frequência: « sempre » (todos os dias), « às vezes », « nunca » (nunca!). « Sempre caminho no parque ».", "Hábitos saudáveis: « bebo água », « como fruta », « durmo oito horas ». « durmo » = duermo.", "Vida saudável com « nunca »: « Nunca como doce ». O verbo fica no presente."), examples = listOf(ExampleLine(text = "Sempre caminho no parque.", meaning = "sempre = todos os dias."), ExampleLine(text = "Nunca como doce.", meaning = "nunca = jamás."), ExampleLine(text = "Às vezes bebo refrigerante.", meaning = "às vezes = a veces."), ExampleLine(text = "Durmo oito horas todas as noites.", meaning = "dormir bem."), ExampleLine(text = "Bebo muita água todo dia.", meaning = "muita + água."))), expressions = listOf(TargetExpression(text = "sempre / nunca", meaning = "Frequência: todos os dias / nunca.", note = "Sempre como fruta."), TargetExpression(text = "às vezes", meaning = "A veces.", note = "Às vezes bebo café."), TargetExpression(text = "beber água", meaning = "Hábito saudável.", note = "Bebo água todo dia."), TargetExpression(text = "dormir oito horas", meaning = "Dormir bien.", note = "Durmo oito horas."), TargetExpression(text = "vida saudável", meaning = "Vida sana.", note = "Caminhar é vida saudável.")), situation = "O grupo conversa sobre hábitos: quem caminha sempre, quem dorme bem e quem come doce às vezes.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga que você sempre caminha no parque.", expected = listOf("Sempre caminho no parque.", "Eu sempre caminho no parque.", "sempre caminho no parque"), focus = "sempre", watch = "sempre + verbo."), PracticeQuestion(prompt = "Diga que você nunca come doce.", expected = listOf("Nunca como doce.", "Eu nunca como doce.", "nunca como doce"), focus = "nunca", watch = "nunca + verbo."), PracticeQuestion(prompt = "Diga que você dorme oito horas.", expected = listOf("Durmo oito horas.", "Eu durmo oito horas.", "durmo oito horas"), focus = "durmo", watch = "durmo = duermo."), PracticeQuestion(prompt = "Diga que às vezes você bebe refrigerante.", expected = listOf("Às vezes bebo refrigerante.", "as vezes bebo refrigerante"), focus = "às vezes", watch = "às vezes com acento."), PracticeQuestion(prompt = "Diga que você bebe muita água todo dia.", expected = listOf("Bebo muita água todo dia.", "bebo muita agua todo dia"), focus = "muita água", watch = "água com acento."))), exercises = listOf(Exercise(id = "pt-foundations-u15-habitos-e1", kind = "choice", prompt = "Ela caminha todos os dias. Ela ___ caminha.", options = listOf("sempre", "nunca", "às vezes"), answers = listOf("sempre"), explain = "Todos os dias = sempre."), Exercise(id = "pt-foundations-u15-habitos-e2", kind = "gap", prompt = "Eu não como doce. ___ como doce.", options = listOf(), answers = listOf("Nunca", "nunca"), explain = "nunca = 0 %: não como doce."), Exercise(id = "pt-foundations-u15-habitos-e3", kind = "order", prompt = "Diga um hábito saudável: caminhar no parque, todos os dias.", options = listOf(), answers = listOf("Sempre caminho no parque"), explain = "sempre + caminhar: hábito."), Exercise(id = "pt-foundations-u15-habitos-e4", kind = "written", prompt = "Diga quantas horas você dorme: oito.", options = listOf(), answers = listOf("Durmo oito horas.", "Eu durmo oito horas.", "durmo oito horas"), explain = "durmo + horas.")), skills = listOf("grammar:frequency-adverbs", "function:talk-about-routines", "vocab:health", "vocab:daily-routine"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:frequency-adverbs"))))
}

object PtFoundationsU16 {
    val unit = CourseUnit(id = "pt-foundations-u16", title = "À mesa", subtitle = "Comer fora", level = "A1", themes = listOf(ConversationTheme("restaurante-pedido", "No restaurante", "Pedir comida", "fork.knife", "Course", "A Ana e o Leo almoçam num restaurante simples: escolhem à mesa e pedem ao garçom, cada um o seu prato.", 0),
                ConversationTheme("cardapio-conta", "O cardápio e a conta", "Pratos, bebidas e pagamento", "takeout.bag", "Course", "Escolhem o prato no cardápio, perguntam o que tem e, no fim, pedem a conta e deixam a gorjeta.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u16-restaurante", title = "No restaurante", goal = "Pedir comida no restaurante com eu quero e para mim.", intro = LessonIntro(explanation = listOf("Para pedir, use « eu quero » ou « para mim ». « Eu quero o frango ». « Para mim, um suco ».", "Com educação, junte « por favor » e agradeça com « obrigado/obrigada ». « Uma água, por favor ».", "O garçom pergunta: « O que vocês querem ? ». Você responde com « quero »: « Quero o prato do dia »."), examples = listOf(ExampleLine(text = "Eu quero o frango com arroz.", meaning = "Pedido simples."), ExampleLine(text = "Para mim, uma água sem gelo.", meaning = "para mim = para mí."), ExampleLine(text = "Uma pizza, por favor.", meaning = "por favor suaviza."), ExampleLine(text = "O cardápio, por favor ?", meaning = "Pedir o menu."), ExampleLine(text = "Mais alguma coisa ? — Não, obrigado.", meaning = "O garçom pergunta."))), expressions = listOf(TargetExpression(text = "Eu quero …", meaning = "Pedir comida.", note = "Eu quero o peixe."), TargetExpression(text = "Para mim, …", meaning = "Pedir para você.", note = "Para mim, um suco."), TargetExpression(text = "…, por favor", meaning = "Pedido educado.", note = "Uma água, por favor."), TargetExpression(text = "O cardápio, por favor ?", meaning = "Pedir o menu.", note = "Para escolher."), TargetExpression(text = "obrigado / obrigada", meaning = "Agradecer (homem/mulher).", note = "Obrigada, está ótimo.")), situation = "A Ana e o Leo almoçam num restaurante simples: o garçom traz o cardápio e cada um pede o seu prato.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Peça o frango com arroz.", expected = listOf("Eu quero o frango com arroz.", "Quero o frango com arroz.", "quero o frango com arroz"), focus = "eu quero", watch = "quero = quiero."), PracticeQuestion(prompt = "Peça uma água sem gelo para você. (use para mim)", expected = listOf("Para mim, uma água sem gelo.", "para mim uma agua sem gelo"), focus = "para mim", watch = "para mim = para mí."), PracticeQuestion(prompt = "Peça uma pizza com educação.", expected = listOf("Uma pizza, por favor.", "Quero uma pizza, por favor."), focus = "por favor", watch = "por favor suaviza o pedido."), PracticeQuestion(prompt = "Pergunte se tem suco de laranja.", expected = listOf("Tem suco de laranja ?", "Vocês têm suco de laranja ?"), focus = "tem … ?", watch = "pergunta com tem."), PracticeQuestion(prompt = "O garçom pergunta: mais alguma coisa ? Recuse com educação.", expected = listOf("Não, obrigado.", "Não, obrigada.", "Nada, obrigado."), focus = "recusar", watch = "obrigado (homem) / obrigada (mulher)."))), exercises = listOf(Exercise(id = "pt-foundations-u16-restaurante-e1", kind = "choice", prompt = "___ o frango com arroz. (pedido)", options = listOf("Quero", "Tenho", "Faço", "Vejo"), answers = listOf("Quero"), explain = "Eu quero + comida: pedido direto."), Exercise(id = "pt-foundations-u16-restaurante-e2", kind = "gap", prompt = "Para ___, uma água sem gelo.", options = listOf(), answers = listOf("mim"), explain = "para mim = para mí: pedido para você."), Exercise(id = "pt-foundations-u16-restaurante-e3", kind = "order", prompt = "Peça uma água ao garçom.", options = listOf(), answers = listOf("Uma água por favor"), explain = "pedido + por favor: educado."), Exercise(id = "pt-foundations-u16-restaurante-e4", kind = "written", prompt = "Peça o cardápio ao garçom.", options = listOf(), answers = listOf("O cardápio, por favor.", "o cardapio por favor", "cardapio por favor"), explain = "O cardápio, por favor: pedido do menu.")), skills = listOf("function:order-food", "vocab:food", "grammar:present-simple", "function:ask-simple-questions"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u16-cardapio", title = "O cardápio", goal = "Ler o cardápio e perguntar o que tem: pratos, bebidas e sobremesas.", intro = LessonIntro(explanation = listOf("O cardápio tem partes: « entrada », « prato principal », « sobremesa » e « bebidas ». « O suco fica em bebidas ».", "Para perguntar: « O que tem ? » ou « Tem … ? ». « Tem frango ? — Tem, com arroz ou batata ».", "Escolher com « qual ». « Qual é o prato do dia ? » — e o garçom responde: « É a moqueca »."), examples = listOf(ExampleLine(text = "O que tem no cardápio ?", meaning = "Pergunta geral."), ExampleLine(text = "Tem peixe hoje ?", meaning = "Tem + prato ?"), ExampleLine(text = "Qual é o prato do dia ?", meaning = "qual = cuál."), ExampleLine(text = "Quero o frango sem batata.", meaning = "sem = sin."), ExampleLine(text = "De sobremesa, tem pudim ?", meaning = "sobremesa = postre."))), expressions = listOf(TargetExpression(text = "O que tem ?", meaning = "Perguntar o que existe.", note = "O que tem de sobremesa ?"), TargetExpression(text = "Tem … ?", meaning = "Perguntar por um item.", note = "Tem suco de laranja ?"), TargetExpression(text = "Qual é o prato do dia ?", meaning = "Perguntar a sugestão.", note = "Hoje é a moqueca."), TargetExpression(text = "com / sem", meaning = "Com ou sem ingrediente.", note = "café sem açúcar."), TargetExpression(text = "de sobremesa", meaning = "Para o fim da refeição.", note = "De sobremesa, quero pudim.")), situation = "No balcão da padaria e na mesa do restaurante: a Ana lê o cardápio, pergunta o que tem e escolhe sem açúcar.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pergunte o que tem no cardápio.", expected = listOf("O que tem no cardápio ?", "o que tem no cardapio", "o que tem"), focus = "o que tem", watch = "o que tem = ¿qué hay ?"), PracticeQuestion(prompt = "Pergunte se tem peixe hoje.", expected = listOf("Tem peixe hoje ?", "tem peixe hoje"), focus = "tem … ?", watch = "Tem + prato ?"), PracticeQuestion(prompt = "Pergunte a sugestão do dia.", expected = listOf("Qual é o prato do dia ?", "qual e o prato do dia"), focus = "qual", watch = "qual = cuál."), PracticeQuestion(prompt = "Peça um café sem açúcar.", expected = listOf("Um café sem açúcar, por favor.", "Quero um café sem açúcar.", "um cafe sem acucar"), focus = "sem", watch = "sem = sin."), PracticeQuestion(prompt = "Pergunte a sobremesa: tem pudim ?", expected = listOf("De sobremesa, tem pudim ?", "Tem pudim de sobremesa ?"), focus = "de sobremesa", watch = "sobremesa = postre."))), exercises = listOf(Exercise(id = "pt-foundations-u16-cardapio-e1", kind = "choice", prompt = "___ é o prato do dia ?", options = listOf("Qual", "O que", "Tem", "Quanto"), answers = listOf("Qual"), explain = "Qual = cuál: perguntar entre opções."), Exercise(id = "pt-foundations-u16-cardapio-e2", kind = "gap", prompt = "Tem pudim ___ sobremesa ?", options = listOf(), answers = listOf("de"), explain = "de sobremesa = de postre."), Exercise(id = "pt-foundations-u16-cardapio-e3", kind = "order", prompt = "Pergunte o que tem.", options = listOf(), answers = listOf("O que tem no cardapio"), explain = "O que tem ? pergunta o que existe."), Exercise(id = "pt-foundations-u16-cardapio-e4", kind = "written", prompt = "Peça um café sem açúcar.", options = listOf(), answers = listOf("um café sem açúcar, por favor", "um cafe sem acucar", "quero um café sem açúcar"), explain = "sem = sin: café sem açúcar.")), skills = listOf("function:order-food", "vocab:food", "grammar:present-questions", "grammar:present-simple"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u16-conta", title = "A conta", goal = "Pedir a conta, perguntar quanto é e deixar a gorjeta.", intro = LessonIntro(explanation = listOf("No fim, chame o garçom: « A conta, por favor ». « Pode trazer a conta ? » também funciona.", "Pergunte o preço: « Quanto é ? ». Para o pagamento: « Pode ser cartão ? » ou « Podemos pagar separado ? ».", "No Brasil, a gorjeta de dez por cento costuma vir na conta: « Já está incluída a gorjeta ? »."), examples = listOf(ExampleLine(text = "A conta, por favor.", meaning = "Pedido da conta."), ExampleLine(text = "Quanto é ?", meaning = "quanto é = cuánto es."), ExampleLine(text = "Pode ser cartão ?", meaning = "cartão = tarjeta."), ExampleLine(text = "Podemos pagar separado ?", meaning = "Dividir a conta."), ExampleLine(text = "A gorjeta já está incluída ?", meaning = "gorjeta = propina."))), expressions = listOf(TargetExpression(text = "A conta, por favor", meaning = "Pedir a conta.", note = "Ao garçom, no fim."), TargetExpression(text = "Quanto é ?", meaning = "Perguntar o preço.", note = "Quanto é o jantar ?"), TargetExpression(text = "Pode ser cartão ?", meaning = "Forma de pagamento.", note = "Ou em dinheiro ?"), TargetExpression(text = "pagar separado / juntos", meaning = "Dividir ou não.", note = "Cada um paga o seu."), TargetExpression(text = "a gorjeta", meaning = "Dez por cento, no Brasil.", note = "Deixa a gorjeta na mesa.")), situation = "O jantar acaba: o Leo pede a conta, pergunta o preço, cada um paga a sua parte e deixa a gorjeta.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Peça a conta ao garçom.", expected = listOf("A conta, por favor.", "Pode trazer a conta ?"), focus = "a conta", watch = "a conta = la cuenta."), PracticeQuestion(prompt = "Pergunte o preço do jantar.", expected = listOf("Quanto é ?", "Quanto custa ?"), focus = "quanto é", watch = "quanto é = cuánto es."), PracticeQuestion(prompt = "Pergunte se pode pagar com cartão.", expected = listOf("Pode ser cartão ?", "Posso pagar com cartão ?"), focus = "cartão", watch = "cartão = tarjeta."), PracticeQuestion(prompt = "Diga que cada um paga a sua parte.", expected = listOf("Podemos pagar separado ?", "Vamos pagar separado."), focus = "separado", watch = "separado = por separado."), PracticeQuestion(prompt = "Pergunte se a gorjeta já vem na conta.", expected = listOf("A gorjeta já está incluída ?", "Já está incluída a gorjeta ?"), focus = "gorjeta", watch = "gorjeta = propina."))), exercises = listOf(Exercise(id = "pt-foundations-u16-conta-e1", kind = "choice", prompt = "Quanto ___ o almoço ?", options = listOf("é", "tem", "faz", "quer"), answers = listOf("é"), explain = "Quanto é ? pergunta o preço."), Exercise(id = "pt-foundations-u16-conta-e2", kind = "gap", prompt = "Podemos pagar ___ ? (cada um o seu)", options = listOf(), answers = listOf("separado"), explain = "pagar separado = cada um paga o seu."), Exercise(id = "pt-foundations-u16-conta-e3", kind = "order", prompt = "Pergunte o preço do jantar.", options = listOf(), answers = listOf("Quanto é o jantar"), explain = "Quanto é ? pergunta o preço."), Exercise(id = "pt-foundations-u16-conta-e4", kind = "written", prompt = "Chame o garçom no fim da refeição.", options = listOf(), answers = listOf("A conta, por favor.", "a conta por favor", "pode trazer a conta"), explain = "A conta, por favor: pedido clássico.")), skills = listOf("function:order-food", "grammar:quantities", "vocab:food", "vocab:social-expressions"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple"))))
}

object PtFoundationsU19 {
    val unit = CourseUnit(id = "pt-foundations-u19", title = "Uma visita", subtitle = "Na casa dos outros", level = "A1", themes = listOf(ConversationTheme("porta-sala", "Na porta", "Pedir permissão", "door.left.open", "Course", "A Ana chega na casa da Bia: ela pede permissão para entrar, tira os sapatos e elogia a sala.", 0),
                ConversationTheme("lembrancinha-cafe", "A lembrancinha", "Oferecer e agradecer", "gift", "Course", "O Leo chega com doces: oferece a lembrancinha, a Bia serve um café e todos agradecem com educação.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u19-visita", title = "Posso entrar ?", goal = "Pedir permissão com posso/pode: entrar, sentar, fechar a porta.", intro = LessonIntro(explanation = listOf("Para pedir permissão, use « posso » (eu) ou « pode » (você): « Posso entrar ? », « Pode fechar a porta ? ».", "Antes de pedir, suavize com « com licença »; para responder, « claro » ou « pode sim »: « Posso passar ? — Claro ! ».", "A negativa é delicada: « desculpe, não pode ». « Posso fumar aqui ? — Desculpe, não pode »."), examples = listOf(ExampleLine(text = "Com licença, posso entrar ?", meaning = "Pedido de permissão."), ExampleLine(text = "Posso tirar os sapatos ?", meaning = "posso = puedo."), ExampleLine(text = "Pode fechar a porta, por favor ?", meaning = "pode + verbo: pedir a alguém."), ExampleLine(text = "Posso sentar aqui ? — Claro !", meaning = "Permissão e resposta."), ExampleLine(text = "Desculpe, não pode abrir agora.", meaning = "A negativa com jeito."))), expressions = listOf(TargetExpression(text = "Posso + verbo ?", meaning = "Pedir permissão (eu).", note = "Posso entrar ?"), TargetExpression(text = "Pode + verbo ?", meaning = "Pedir a alguém.", note = "Pode me esperar um minuto ?"), TargetExpression(text = "Com licença", meaning = "Para entrar ou interromper.", note = "Com licença, posso passar ?"), TargetExpression(text = "Claro ! / pode sim", meaning = "Dar permissão.", note = "Posso sentar ? — Pode sim !"), TargetExpression(text = "Desculpe, não pode", meaning = "Negar com educação.", note = "Desculpe, não pode mexer no computador.")), situation = "Na porta do prédio e na sala: a Ana pede permissão para entrar, tirar os sapatos e sentar, e a Bia responde.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pergunte se você pode entrar.", expected = listOf("Posso entrar ?", "posso entrar"), focus = "posso", watch = "posso = puedo."), PracticeQuestion(prompt = "Peça à Bia para fechar a porta, com educação.", expected = listOf("Pode fechar a porta, por favor ?", "pode fechar a porta"), focus = "pode + verbo", watch = "pode = puede."), PracticeQuestion(prompt = "Pergunte se pode tirar os sapatos.", expected = listOf("Posso tirar os sapatos ?", "posso tirar os sapatos"), focus = "posso", watch = "sapatos = zapatos."), PracticeQuestion(prompt = "Dê permissão com uma palavra alegre.", expected = listOf("Claro !", "Claro.", "Pode sim !", "pode sim"), focus = "responder", watch = "claro = claro, por supuesto."), PracticeQuestion(prompt = "Peça permissão para ocupar o lugar.", expected = listOf("Posso sentar aqui ?", "posso sentar aqui"), focus = "sentar", watch = "sentar = sentarse."))), exercises = listOf(Exercise(id = "pt-foundations-u19-visita-e1", kind = "choice", prompt = "___ entrar ? (permissão)", options = listOf("Posso", "Tenho", "Sou", "Vou"), answers = listOf("Posso"), explain = "Posso + verbo: pedir permissão na primeira pessoa."), Exercise(id = "pt-foundations-u19-visita-e2", kind = "gap", prompt = "Com ___, posso passar ?", options = listOf(), answers = listOf("licença", "licenca"), explain = "Com licença: fórmula educada antes do pedido."), Exercise(id = "pt-foundations-u19-visita-e3", kind = "order", prompt = "Peça para ocupar o lugar.", options = listOf(), answers = listOf("Posso sentar aqui"), explain = "Posso + verbo + lugar: pedido de permissão."), Exercise(id = "pt-foundations-u19-visita-e4", kind = "written", prompt = "Peça à Bia para fechar a janela, com educação.", options = listOf(), answers = listOf("Pode fechar a janela, por favor ?", "pode fechar a janela", "Pode fechar a janela ?"), explain = "Pode + verbo + por favor: pedido educado a alguém.")), skills = listOf("grammar:can", "function:make-requests", "vocab:social-expressions", "grammar:present-simple"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u19-lembrancinha", title = "Trago uma lembrancinha", goal = "Oferecer algo aos anfitriões: trago…, é para você, aceita….", intro = LessonIntro(explanation = listOf("Para oferecer ao chegar, use « trago » ou « é para você »: « Trago uma lembrancinha », « É para vocês ».", "O anfitrião oferece com « aceita ? » ou « quer ? »: « Aceita um café ? », « Quer mais um pedaço ? ».", "Aceite com « obrigado/obrigada » ou recuse com jeito: « Obrigada, não consigo comer mais »."), examples = listOf(ExampleLine(text = "Trago uma lembrancinha da minha terra.", meaning = "Oferecer ao chegar."), ExampleLine(text = "É para vocês, um docinho.", meaning = "para você = para ti."), ExampleLine(text = "Aceita um café ? — Aceito, obrigada !", meaning = "Oferta e aceite."), ExampleLine(text = "Quer um pedaço de bolo ?", meaning = "O anfitrião oferece."), ExampleLine(text = "Só um pouquinho, obrigado.", meaning = "Aceitar um pouco."))), expressions = listOf(TargetExpression(text = "Trago …", meaning = "Oferecer ao chegar.", note = "Trago brigadeiro."), TargetExpression(text = "É para você", meaning = "Entregar o presente.", note = "É para você, da Bahia."), TargetExpression(text = "Aceita … ?", meaning = "O anfitrião oferece.", note = "Aceita um suco ?"), TargetExpression(text = "Aceito, obrigado(a) !", meaning = "Aceitar a oferta.", note = "Aceito, obrigado !"), TargetExpression(text = "Só um pouquinho", meaning = "Aceitar um pouco.", note = "Só um pouquinho, obrigada.")), situation = "O Leo chega com uma caixa de doces: oferece a lembrancinha, a Bia serve café e cada um aceita com educação.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga que você traz doces para os anfitriões.", expected = listOf("Trago uns doces.", "trago uns doces", "Trago doces para vocês.", "trago doces para voce"), focus = "trago", watch = "trago = traigo."), PracticeQuestion(prompt = "Entregue o presente ao anfitrião.", expected = listOf("É para você.", "é para voce", "e para voce"), focus = "é para você", watch = "para você = para ti."), PracticeQuestion(prompt = "A Bia oferece café. Responda aceitando.", expected = listOf("Aceito, obrigada !", "Aceito, obrigado !", "aceito obrigada"), focus = "aceitar", watch = "aceito = acepto."), PracticeQuestion(prompt = "Recuse mais bolo com educação.", expected = listOf("Não, obrigada.", "nao obrigada", "Obrigado, já comi bastante.", "obrigado ja comi bastante"), focus = "recusar", watch = "não, obrigado(a) suaviza."), PracticeQuestion(prompt = "Ofereça bolo ao hóspede: quer… ?", expected = listOf("Quer um pedaço de bolo ?", "quer um pedaco de bolo"), focus = "quer … ?", watch = "quer = quieres."))), exercises = listOf(Exercise(id = "pt-foundations-u19-lembrancinha-e1", kind = "choice", prompt = "___ uma lembrancinha para vocês.", options = listOf("Trago", "Traigo", "Trouxe", "Levar"), answers = listOf("Trago"), explain = "trago = eu trago para dar: oferta ao chegar; « traigo » é espanhol."), Exercise(id = "pt-foundations-u19-lembrancinha-e2", kind = "gap", prompt = "É para ___, um docinho da minha terra.", options = listOf(), answers = listOf("você", "voce"), explain = "é para você = es para ti: entregar o presente."), Exercise(id = "pt-foundations-u19-lembrancinha-e3", kind = "order", prompt = "Diga que aceita só um pouco.", options = listOf(), answers = listOf("Só um pouquinho obrigada"), explain = "só um pouquinho: aceitar um pouco, com educação."), Exercise(id = "pt-foundations-u19-lembrancinha-e4", kind = "written", prompt = "Ofereça um suco ao seu hóspede.", options = listOf(), answers = listOf("Aceita um suco ?", "aceita um suco", "Quer um suco ?", "quer um suco"), explain = "aceita … ? ou quer … ?: a oferta do anfitrião.")), skills = listOf("function:make-requests", "vocab:food", "vocab:social-expressions", "function:order-food"), canDo = listOf("order-food"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u19-ate-logo", title = "Até a próxima", goal = "Despedir-se e agradecer: até a próxima, obrigado por tudo, voltem sempre.", intro = LessonIntro(explanation = listOf("Para se despedir: « até logo », « até a próxima », « tchau ». « Até a próxima visita ! ».", "Agradeça a visita com « obrigado(a) por tudo » ou « obrigado pelo jantar »: « Foi ótimo, obrigado por tudo ».", "O anfitrião convida a voltar: « volte sempre », « voltem sempre ». « Foi um prazer, voltem sempre ! »."), examples = listOf(ExampleLine(text = "Até a próxima, pessoal !", meaning = "Despedida amigável."), ExampleLine(text = "Obrigado por tudo, Bia.", meaning = "por tudo = por todo."), ExampleLine(text = "Obrigada pelo café, estava ótimo.", meaning = "obrigada (mulher)."), ExampleLine(text = "Voltem sempre !", meaning = "O anfitrião convida a voltar."), ExampleLine(text = "Foi um prazer, até logo.", meaning = "Fecho educado da visita."))), expressions = listOf(TargetExpression(text = "Até logo / até a próxima", meaning = "Despedir-se.", note = "Até logo, até sábado !"), TargetExpression(text = "Obrigado(a) por tudo", meaning = "Agradecer a visita.", note = "Obrigado por tudo, foi ótimo."), TargetExpression(text = "Volte sempre / voltem sempre", meaning = "Convidar a voltar.", note = "Voltem sempre à nossa casa."), TargetExpression(text = "Foi um prazer", meaning = "Fecho educado.", note = "Foi um prazer, Ana."), TargetExpression(text = "Tchau, até sábado !", meaning = "Despedida informal.", note = "Tchau, tchau !")), situation = "No fim da visita: a Ana agradece o café, a Bia diz voltem sempre e todos se despedem até a próxima.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Despeça-se marcando a próxima visita.", expected = listOf("Até a próxima !", "ate a proxima", "Até a próxima visita !", "ate a proxima visita"), focus = "até a próxima", watch = "até = hasta."), PracticeQuestion(prompt = "Agradeça o jantar.", expected = listOf("Obrigado pelo jantar.", "Obrigada pelo jantar.", "obrigado pelo jantar"), focus = "obrigado pelo", watch = "obrigado (homem) / obrigada (mulher)."), PracticeQuestion(prompt = "O anfitrião convida vocês a voltar.", expected = listOf("Voltem sempre !", "Volte sempre.", "voltem sempre"), focus = "voltar", watch = "voltem = vuelvan."), PracticeQuestion(prompt = "Feche a visita com a fórmula do prazer.", expected = listOf("Foi um prazer.", "foi um prazer"), focus = "fecho", watch = "prazer = gusto."), PracticeQuestion(prompt = "Despeça-se informalmente, marcando sábado.", expected = listOf("Tchau, até sábado !", "tchau ate sabado", "Até sábado !", "ate sabado"), focus = "tchau", watch = "tchau = chao."))), exercises = listOf(Exercise(id = "pt-foundations-u19-ate-logo-e1", kind = "choice", prompt = "Obrigado ___ tudo !", options = listOf("por", "para", "com", "de"), answers = listOf("por"), explain = "obrigado por + coisa: a regência do agradecimento."), Exercise(id = "pt-foundations-u19-ate-logo-e2", kind = "gap", prompt = "Voltem ___, a porta fica aberta.", options = listOf(), answers = listOf("sempre"), explain = "voltem sempre: o convite do anfitrião."), Exercise(id = "pt-foundations-u19-ate-logo-e3", kind = "order", prompt = "Despeça-se dos amigos.", options = listOf(), answers = listOf("Até a próxima pessoal"), explain = "até a próxima: despedida que marca o reencontro."), Exercise(id = "pt-foundations-u19-ate-logo-e4", kind = "written", prompt = "Agradeça o café e diga que estava ótimo.", options = listOf(), answers = listOf("Obrigado pelo café, estava ótimo.", "obrigado pelo cafe estava otimo", "Obrigada pelo café, estava ótimo.", "obrigada pelo cafe estava otimo"), explain = "obrigado pelo café + elogio: agradecer e valorizar.")), skills = listOf("vocab:social-expressions", "grammar:present-simple", "function:ask-simple-questions", "grammar:can"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple"))))
}

object PtFoundationsU22 {
    val unit = CourseUnit(id = "pt-foundations-u22", title = "Hora de festejar", subtitle = "Convites, presentes e parabéns", level = "A1", themes = listOf(ConversationTheme("convite-festa", "O convite", "Chamar a galera", "party.popper", "Course", "A Duda liga para os amigos: convence todos para a festa da Bia no sábado, marca a casa e a hora e cada um promete levar algo.", 0),
                ConversationTheme("bolo-velas", "O bolo", "Presente e parabéns", "birthday.cake", "Course", "Na festa: o grupo escolhe o presente, canta parabéns, a Bia apaga as velas e agradece cada gesto com emoção.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u22-festa", title = "Vai ter festa !", goal = "Convidar e responder a um convite: vamos…, que tal…, pode contar comigo.", intro = LessonIntro(explanation = listOf("Para convidar, use « vamos + verbo » ou « que tal … ? »: « Vamos fazer uma festa ? », « Que tal sábado ? ».", "Marque o lugar e a hora: « na minha casa », « às oito ». « É na minha casa, às oito ».", "Aceite com alegria ou recuse com jeito: « Pode contar comigo ! », « Que pena, não posso »."), examples = listOf(ExampleLine(text = "Vamos fazer uma festa no sábado ?", meaning = "O convite direto."), ExampleLine(text = "Que tal um churrasco na minha casa ?", meaning = "que tal … ? = ¿qué tal… ?"), ExampleLine(text = "É na minha casa, às oito.", meaning = "Lugar e hora juntos."), ExampleLine(text = "Pode contar comigo, levo o bolo !", meaning = "Aceitar com vontade."), ExampleLine(text = "Que pena, no sábado não posso.", meaning = "Recusar com educação."))), expressions = listOf(TargetExpression(text = "Vamos + verbo ?", meaning = "Convidar para a ação.", note = "Vamos comemorar ?"), TargetExpression(text = "Que tal … ?", meaning = "Sugerir uma ideia.", note = "Que tal domingo então ?"), TargetExpression(text = "Na minha casa, às …", meaning = "Marcar lugar e hora.", note = "Na minha casa, às oito."), TargetExpression(text = "Pode contar comigo !", meaning = "Aceitar o convite.", note = "Pode contar comigo, levo o bolo !"), TargetExpression(text = "Que pena, não posso", meaning = "Recusar com educação.", note = "Que pena, tenho um compromisso.")), situation = "No grupo de amigos: a Duda convence o Téo e a Lu para a festa da Bia, marca a casa e a hora e cada um escolhe o que levar.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Convide os amigos para uma festa.", expected = listOf("Vamos fazer uma festa ?", "vamos fazer uma festa"), focus = "vamos + verbo", watch = "vamos = vamos (nosotros)."), PracticeQuestion(prompt = "Sugira o sábado com que tal….", expected = listOf("Que tal sábado ?", "que tal sabado"), focus = "que tal … ?", watch = "que tal = ¿qué tal ?"), PracticeQuestion(prompt = "Marque o lugar e a hora: sua casa, oito.", expected = listOf("Na minha casa, às oito.", "na minha casa as oito", "É na minha casa, às oito.", "e na minha casa as oito"), focus = "lugar e hora", watch = "às oito = a las ocho."), PracticeQuestion(prompt = "Aceite o convite com confiança.", expected = listOf("Pode contar comigo !", "pode contar comigo"), focus = "aceitar", watch = "pode contar comigo = cuenta conmigo."), PracticeQuestion(prompt = "Recuse com pena: você viaja no sábado.", expected = listOf("Que pena, não posso.", "que pena nao posso", "Que pena, viajo no sábado.", "que pena viajo no sabado"), focus = "recusar", watch = "que pena = qué pena."))), exercises = listOf(Exercise(id = "pt-foundations-u22-festa-e1", kind = "choice", prompt = "___ fazer uma festa sábado ?", options = listOf("Vamos", "Vamos a", "Vais", "Tem"), answers = listOf("Vamos"), explain = "Vamos + verbo no infinitivo: o convite direto em português."), Exercise(id = "pt-foundations-u22-festa-e2", kind = "gap", prompt = "Que ___ um churrasco domingo ?", options = listOf(), answers = listOf("tal"), explain = "Que tal … ?: sugerir uma ideia com leveza."), Exercise(id = "pt-foundations-u22-festa-e3", kind = "order", prompt = "Aceite o convite da festa.", options = listOf(), answers = listOf("Pode contar comigo"), explain = "Pode contar comigo: a aceitação que já se oferece para ajudar."), Exercise(id = "pt-foundations-u22-festa-e4", kind = "written", prompt = "Recuse o convite de sábado com pena.", options = listOf(), answers = listOf("Que pena, no sábado não posso.", "que pena no sabado nao posso", "Que pena, não posso.", "que pena nao posso"), explain = "Que pena + motivo: recusar sem fechar a porta.")), skills = listOf("vocab:social-expressions", "grammar:present-simple", "function:make-suggestions", "function:ask-simple-questions"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u22-presente", title = "O presente", goal = "Escolher o presente em grupo: o que vamos dar, quanto custa, boa ideia.", intro = LessonIntro(explanation = listOf("Pergunte ao grupo: « o que vamos dar para a Bia ? ». « Vamos » marca o plano junto.", "Preço com « custar »: « Quanto custa ? », « Custa pouco ». « O vaso custa uns quarenta reais ».", "Aprovar a ideia: « boa ideia ! », « ela gosta de … ». « Um livro é uma boa ideia, ela gosta de ler »."), examples = listOf(ExampleLine(text = "O que vamos dar para a Bia ?", meaning = "A pergunta do grupo."), ExampleLine(text = "Vamos dar um vaso para a planta dela.", meaning = "vaso = maceta."), ExampleLine(text = "Quanto custa ? — Uns quarenta reais.", meaning = "A pergunta do preço."), ExampleLine(text = "Um livro custa pouco e ela gosta de ler.", meaning = "gostar de + infinitivo."), ExampleLine(text = "Boa ideia ! Vamos comprar hoje.", meaning = "Decidir junto."))), expressions = listOf(TargetExpression(text = "O que vamos dar … ?", meaning = "Perguntar o presente.", note = "O que vamos dar para o Téo ?"), TargetExpression(text = "Quanto custa ?", meaning = "Perguntar o preço.", note = "Quanto custa esse vaso ?"), TargetExpression(text = "custa pouco / caro", meaning = "O preço em duas palavras.", note = "Custa pouco, vamos levar."), TargetExpression(text = "Boa ideia !", meaning = "Aprovar a sugestão.", note = "Boa ideia, eu topo !"), TargetExpression(text = "Ela gosta de …", meaning = "Acertar no gosto.", note = "Ela gosta de música brasileira.")), situation = "Na loja do centro: a Duda e o Téo escolhem o presente da Bia, comparam preços e fecham um livro com dedicatória.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pergunte o que o grupo vai dar para a Bia.", expected = listOf("O que vamos dar para a Bia ?", "o que vamos dar para a bia"), focus = "o que vamos dar", watch = "vamos = el plan del grupo."), PracticeQuestion(prompt = "Pergunte o preço.", expected = listOf("Quanto custa ?", "quanto custa"), focus = "quanto custa", watch = "custar = costar."), PracticeQuestion(prompt = "Diga que o preço é baixo.", expected = listOf("Custa pouco.", "custa pouco"), focus = "custar", watch = "pouco = poco."), PracticeQuestion(prompt = "Aprove a ideia do livro.", expected = listOf("Boa ideia !", "boa ideia", "É uma boa ideia !", "e uma boa ideia"), focus = "aprovar", watch = "ideia com i: idea en português."), PracticeQuestion(prompt = "Diga que a Bia gosta de ler.", expected = listOf("Ela gosta de ler.", "ela gosta de ler"), focus = "gostar de", watch = "gostar de = gustar de."))), exercises = listOf(Exercise(id = "pt-foundations-u22-presente-e1", kind = "choice", prompt = "Quanto ___ esse vaso ?", options = listOf("custa", "custo", "custam", "custando"), answers = listOf("custa"), explain = "Quanto custa + singular: a pergunta do preço."), Exercise(id = "pt-foundations-u22-presente-e2", kind = "gap", prompt = "A Bia gosta ___ ler.", options = listOf(), answers = listOf("de"), explain = "gostar de + infinitivo: a regência do gosto."), Exercise(id = "pt-foundations-u22-presente-e3", kind = "order", prompt = "Pergunte o preço do presente.", options = listOf(), answers = listOf("Quanto custa o presente"), explain = "Quanto custa + objeto: a pergunta completa do preço."), Exercise(id = "pt-foundations-u22-presente-e4", kind = "written", prompt = "Diga que o grupo vai dar um vaso para a Bia.", options = listOf(), answers = listOf("Vamos dar um vaso para a Bia.", "vamos dar um vaso para a bia", "Vamos dar um vaso pra Bia.", "vamos dar um vaso pra bia"), explain = "Vamos + infinitivo: a decisão em grupo.")), skills = listOf("function:go-shopping", "vocab:social-expressions", "grammar:present-questions", "grammar:present-simple"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u22-parabens", title = "Parabéns pra você", goal = "Parabenizar na festa: parabéns, muitos anos de vida, tudo de bom.", intro = LessonIntro(explanation = listOf("A canção começa assim: « Parabéns pra você, parabéns pra você… ». Todo mundo canta junto.", "Deseje o bem: « muitos anos de vida », « tudo de bom ». « Parabéns, muitos anos de vida ! ».", "Reaja à festa com « que … ! »: « Que bolo gostoso ! ». Quem recebe agradece: « adorei o presente »."), examples = listOf(ExampleLine(text = "Parabéns pra você, parabéns pra você !", meaning = "A canção da festa."), ExampleLine(text = "Parabéns, Bia ! Muitos anos de vida.", meaning = "O desejo clássico."), ExampleLine(text = "Tudo de bom pra você !", meaning = "tudo de bom = todo lo mejor."), ExampleLine(text = "Que bolo gostoso !", meaning = "Elogiar com que … !"), ExampleLine(text = "Obrigada pelo presente, adorei !", meaning = "A festa agradece."))), expressions = listOf(TargetExpression(text = "Parabéns (pra você) !", meaning = "Felicitare.", note = "Parabéns, Bia !"), TargetExpression(text = "Muitos anos de vida", meaning = "O desejo do aniversário.", note = "Muitos anos de vida, dona Cida !"), TargetExpression(text = "Tudo de bom", meaning = "O desejo curto.", note = "Tudo de bom pra você !"), TargetExpression(text = "Que + substantivo + gostoso/bonito", meaning = "Elogiar a festa.", note = "Que festa bonita !"), TargetExpression(text = "Adorei o presente", meaning = "Agradecer com emoção.", note = "Adorei, obrigada mesmo !")), situation = "Na hora das velas: todos cantam parabéns, a Bia faz o pedido, corta o bolo e agradece cada presente com emoção.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Cante a primeira linha da canção.", expected = listOf("Parabéns pra você.", "parabens pra voce", "Parabéns para você.", "parabens para voce"), focus = "a canção", watch = "pra = para, na fala."), PracticeQuestion(prompt = "Complete o desejo do aniversário.", expected = listOf("Muitos anos de vida !", "muitos anos de vida"), focus = "o desejo", watch = "vida = vida."), PracticeQuestion(prompt = "Diga tudo de bom para a Bia.", expected = listOf("Tudo de bom pra você.", "tudo de bom pra voce", "Tudo de bom para você.", "tudo de bom para voce"), focus = "tudo de bom", watch = "tudo de bom = todo lo mejor."), PracticeQuestion(prompt = "Elogie o bolo.", expected = listOf("Que bolo gostoso !", "que bolo gostoso"), focus = "que … !", watch = "que + substantivo: la exclamación fácil."), PracticeQuestion(prompt = "Abra o presente e reaja com emoção.", expected = listOf("Adorei o presente !", "adorei o presente", "Obrigada pelo presente, adorei !", "obrigada pelo presente adorei"), focus = "agradecer", watch = "adorar é forte: me encantó."))), exercises = listOf(Exercise(id = "pt-foundations-u22-parabens-e1", kind = "choice", prompt = "___, muitos anos de vida !", options = listOf("Parabéns", "Feliz", "Bom", "Bem-vindo"), answers = listOf("Parabéns"), explain = "Parabéns abre o desejo: a palavra da festa."), Exercise(id = "pt-foundations-u22-parabens-e2", kind = "gap", prompt = "Tudo de ___ pra você !", options = listOf(), answers = listOf("bom"), explain = "tudo de bom: o desejo curto do dia a dia."), Exercise(id = "pt-foundations-u22-parabens-e3", kind = "order", prompt = "Elogie o bolo da festa.", options = listOf(), answers = listOf("Que bolo gostoso"), explain = "Que + substantivo + adjetivo: o elogio fácil da festa."), Exercise(id = "pt-foundations-u22-parabens-e4", kind = "written", prompt = "Agradeça o presente com emoção.", options = listOf(), answers = listOf("Adorei o presente !", "adorei o presente", "Obrigada pelo presente, adorei !", "obrigada pelo presente adorei"), explain = "Adorei + o quê: emoção direta ao abrir o presente.")), skills = listOf("vocab:social-expressions", "function:make-suggestions", "grammar:present-simple", "vocab:feelings"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:present-simple"))))
}

object PtFoundationsU23 {
    val unit = CourseUnit(id = "pt-foundations-u23", title = "Roupas e tamanhos", subtitle = "Na loja de roupas", level = "A1", themes = listOf(ConversationTheme("loja-vitrine", "Na loja", "Escolher e provar", "tshirt", "Course", "A Duda entra na loja: procura uma camiseta azul, pergunta tamanho e preço e leva duas peças para o provador.", 0),
                ConversationTheme("caixa-sacola", "No caixa", "Pagar e trocar", "bag", "Course", "No caixa: a fila anda, a Duda paga no cartão, mas uma camiseta fica grande e ela volta para trocar no dia seguinte.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u23-loja", title = "Na loja", goal = "Começar a compra: procuro…, você tem…, qual é o seu tamanho.", intro = LessonIntro(explanation = listOf("Chegue dizendo o que procura: « boa tarde, procuro uma camiseta ». « Procuro » abre a compra.", "Pergunte pela peça e pelo tamanho: « você tem essa em M ? », « qual é o seu tamanho ? ».", "Diga o seu tamanho com « usar »: « eu uso M ». Para provar, « posso provar ? »."), examples = listOf(ExampleLine(text = "Boa tarde, procuro uma camiseta azul.", meaning = "A abertura da compra."), ExampleLine(text = "Você tem essa em tamanho M ?", meaning = "A pergunta do estoque."), ExampleLine(text = "Eu uso M, às vezes G.", meaning = "uso = talla."), ExampleLine(text = "Quanto custa essa aqui ?", meaning = "O preço rápido."), ExampleLine(text = "Posso provar ? — Claro, o provador fica ali.", meaning = "provar = probarse."))), expressions = listOf(TargetExpression(text = "Procuro …", meaning = "Dizer o que procura.", note = "Procuro uma calça preta."), TargetExpression(text = "Você tem … ?", meaning = "Perguntar pela peça.", note = "Você tem em outra cor ?"), TargetExpression(text = "Qual é o seu tamanho ?", meaning = "A pergunta do tamanho.", note = "Qual é o seu tamanho ?"), TargetExpression(text = "Eu uso M / G / P", meaning = "Dizer o seu tamanho.", note = "Eu uso M."), TargetExpression(text = "Posso provar ?", meaning = "Pedir o provador.", note = "Posso provar essa calça ?")), situation = "Na loja: a vendedora recebe a Duda, ela procura uma camiseta azul, confere tamanhos e preços e escolhe duas peças para provar.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga o que procura: uma camiseta azul.", expected = listOf("Procuro uma camiseta azul.", "procuro uma camiseta azul"), focus = "procuro", watch = "procuro = busco."), PracticeQuestion(prompt = "Pergunte se têm essa em tamanho M.", expected = listOf("Você tem essa em tamanho M ?", "voce tem essa em tamanho m", "Tem essa em M ?", "tem essa em m"), focus = "você tem", watch = "tem = hay/tiene."), PracticeQuestion(prompt = "Pergunte o tamanho da cliente.", expected = listOf("Qual é o seu tamanho ?", "qual e o seu tamanho"), focus = "tamanho", watch = "tamanho = talla."), PracticeQuestion(prompt = "Diga que você usa M.", expected = listOf("Eu uso M.", "eu uso m"), focus = "usar", watch = "usar + talla."), PracticeQuestion(prompt = "Peça para provar a camiseta.", expected = listOf("Posso provar ?", "posso provar", "Posso provar a camiseta ?", "posso provar a camiseta"), focus = "provar", watch = "provar = probarse."))), exercises = listOf(Exercise(id = "pt-foundations-u23-loja-e1", kind = "choice", prompt = "___ uma camiseta azul, por favor.", options = listOf("Procuro", "Procura", "Buscando", "Gostava"), answers = listOf("Procuro"), explain = "Procuro + peça: dizer o que procura assim que chega."), Exercise(id = "pt-foundations-u23-loja-e2", kind = "gap", prompt = "Eu ___ M, às vezes P.", options = listOf(), answers = listOf("uso"), explain = "usar + tamanho: qual peça serve no corpo."), Exercise(id = "pt-foundations-u23-loja-e3", kind = "order", prompt = "Pergunte se a loja tem essa camiseta em preto.", options = listOf(), answers = listOf("Você tem essa em preto"), explain = "Você tem + peça + em + cor: a pergunta do estoque."), Exercise(id = "pt-foundations-u23-loja-e4", kind = "written", prompt = "Pergunte o preço da camiseta da vitrine.", options = listOf(), answers = listOf("Quanto custa essa camiseta ?", "quanto custa essa camiseta", "Quanto custa essa ?", "quanto custa essa"), explain = "Quanto custa + essa: o preço da peça da vitrine.")), skills = listOf("function:go-shopping", "vocab:shopping", "grammar:quantities", "grammar:present-simple"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u23-provador", title = "No provador", goal = "Ajustar a peça: fica apertado/grande, pode trazer outro tamanho.", intro = LessonIntro(explanation = listOf("Opine sobre a peça com « ficar »: « fica apertado », « fica grande ». « Essa camiseta fica apertada ».", "Peça outro tamanho: « pode trazer um G ? », « um tamanho menor, por favor ».", "A vendedora atende: « um momento », « já vou ver ». « Um momento, já trago outro »."), examples = listOf(ExampleLine(text = "Essa fica apertada, tem um G ?", meaning = "apertado = ajustado."), ExampleLine(text = "Essa calça fica grande em mim.", meaning = "ficar grande = quedar grande."), ExampleLine(text = "Pode trazer um tamanho menor ?", meaning = "O pedido do provador."), ExampleLine(text = "Um momento, já vou ver.", meaning = "A vendedora atende."), ExampleLine(text = "Esse número fica melhor em você.", meaning = "melhor = mejor."))), expressions = listOf(TargetExpression(text = "Fica apertado(a) / grande", meaning = "Como a peça serve.", note = "O vestido fica apertado."), TargetExpression(text = "Pode trazer + tamanho ?", meaning = "Pedir outro número.", note = "Pode trazer um P ?"), TargetExpression(text = "Um tamanho menor / maior", meaning = "Menor ou maior.", note = "Um tamanho maior, por favor."), TargetExpression(text = "Um momento, já vejo", meaning = "Atender o cliente.", note = "Um momento, já vou ver."), TargetExpression(text = "Fica melhor em você", meaning = "A opinião da vendedora.", note = "Esse fica melhor em você.")), situation = "No provador: a camiseta fica apertada, a Duda pede um G para a vendedora e prova a calça que fica perfeita.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga como fica a peça no provador.", expected = listOf("Essa fica apertada.", "essa fica apertada", "A camiseta fica apertada.", "a camiseta fica apertada"), focus = "ficar + adjetivo", watch = "apertada concorda com a peça."), PracticeQuestion(prompt = "Peça um tamanho maior.", expected = listOf("Pode trazer um tamanho maior ?", "pode trazer um tamanho maior"), focus = "outro tamanho", watch = "maior = más grande."), PracticeQuestion(prompt = "Peça à vendedora para trazer um G.", expected = listOf("Pode trazer um G ?", "pode trazer um g"), focus = "pode trazer", watch = "pode = puede (petición)."), PracticeQuestion(prompt = "Diga que a calça fica grande em você.", expected = listOf("Essa calça fica grande em mim.", "essa calca fica grande em mim"), focus = "em mim", watch = "em mim = en mí."), PracticeQuestion(prompt = "Diga a sua opinião sobre o número G.", expected = listOf("Esse número fica melhor.", "esse numero fica melhor"), focus = "melhor", watch = "ficar melhor em você = te queda mejor."))), exercises = listOf(Exercise(id = "pt-foundations-u23-provador-e1", kind = "choice", prompt = "Essa camiseta ___ apertada.", options = listOf("fica", "está", "é", "tem"), answers = listOf("fica"), explain = "ficar + adjetivo: como a roupa serve no corpo."), Exercise(id = "pt-foundations-u23-provador-e2", kind = "gap", prompt = "Pode trazer um tamanho ___ ? (não tão grande)", options = listOf(), answers = listOf("menor"), explain = "menor/maior: o tamanho que falta."), Exercise(id = "pt-foundations-u23-provador-e3", kind = "order", prompt = "Peça outro número à vendedora.", options = listOf(), answers = listOf("Pode trazer um tamanho maior"), explain = "Pode trazer + tamanho: o pedido educado do provador."), Exercise(id = "pt-foundations-u23-provador-e4", kind = "written", prompt = "Diga que a calça fica grande e peça um tamanho menor.", options = listOf(), answers = listOf("Essa calça fica grande, pode trazer um menor ?", "essa calca fica grande pode trazer um menor", "Fica grande, pode trazer um tamanho menor ?", "fica grande pode trazer um tamanho menor"), explain = "Problema + pedido: a fórmula completa do provador.")), skills = listOf("function:make-requests", "function:go-shopping", "grammar:can", "vocab:shopping"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:can")),
    Lesson(id = "pt-foundations-u23-caixa", title = "Muito caro", goal = "No caixa: reagir ao preço, contar a quantidade, pagar e trocar.", intro = LessonIntro(explanation = listOf("Reaja ao preço: « é muito caro », « é barato ». « Nossa, é muito caro para mim ».", "Quantidade e total: « são duas camisetas », « quanto fica no total ? ».", "Pague « no cartão » ou « em dinheiro ». Se não servir: « quero trocar », « não serve »."), examples = listOf(ExampleLine(text = "Nossa, é muito caro para mim.", meaning = "A reação ao preço."), ExampleLine(text = "São duas camisetas e uma calça.", meaning = "A quantidade no caixa."), ExampleLine(text = "Quanto fica no total ?", meaning = "total = total."), ExampleLine(text = "Pode ser no cartão ? — Pode.", meaning = "cartão = tarjeta."), ExampleLine(text = "Quero trocar essa, ficou grande.", meaning = "A troca na loja."))), expressions = listOf(TargetExpression(text = "É muito caro / barato", meaning = "Reagir ao preço.", note = "Para mim, é muito caro."), TargetExpression(text = "São + número + peças", meaning = "A quantidade no caixa.", note = "São três camisetas."), TargetExpression(text = "Quanto fica no total ?", meaning = "A soma da conta.", note = "Quanto fica no total ?"), TargetExpression(text = "No cartão / em dinheiro", meaning = "A forma de pagamento.", note = "Em dinheiro, tem desconto ?"), TargetExpression(text = "Quero trocar / não serve", meaning = "A troca fácil.", note = "Não serve, quero trocar.")), situation = "No caixa: são duas camisetas e uma calça, a Duda pergunta o total, paga no cartão e volta no dia seguinte para trocar a peça grande.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Reaja ao preço da jaqueta: R\$ 800.", expected = listOf("É muito caro.", "e muito caro", "Nossa, é muito caro.", "nossa e muito caro"), focus = "preço", watch = "caro = caro."), PracticeQuestion(prompt = "Diga a quantidade: duas camisetas e uma calça.", expected = listOf("São duas camisetas e uma calça.", "sao duas camisetas e uma calca"), focus = "quantidade", watch = "são + plural."), PracticeQuestion(prompt = "Pergunte o total.", expected = listOf("Quanto fica no total ?", "quanto fica no total", "Quanto custa no total ?", "quanto custa no total"), focus = "total", watch = "ficar no total = quedar en total."), PracticeQuestion(prompt = "Diga que pode pagar no cartão.", expected = listOf("Pode ser no cartão ?", "pode ser no cartao", "Vou pagar no cartão.", "vou pagar no cartao"), focus = "pagar", watch = "no cartão = con tarjeta."), PracticeQuestion(prompt = "Diga que quer trocar porque ficou grande.", expected = listOf("Quero trocar, ficou grande.", "quero trocar ficou grande"), focus = "trocar", watch = "trocar = cambiar."))), exercises = listOf(Exercise(id = "pt-foundations-u23-caixa-e1", kind = "choice", prompt = "Essa jaqueta é muito ___; vou ver outra.", options = listOf("cara", "caro", "barata", "grande"), answers = listOf("cara"), explain = "Peça no feminino: muito cara / muito barata."), Exercise(id = "pt-foundations-u23-caixa-e2", kind = "gap", prompt = "São ___ camisetas e uma calça. (2)", options = listOf(), answers = listOf("duas"), explain = "duas + substantivo feminino: a quantidade concorda."), Exercise(id = "pt-foundations-u23-caixa-e3", kind = "order", prompt = "Diga que quer trocar a peça.", options = listOf(), answers = listOf("Quero trocar essa camiseta"), explain = "Quero trocar + peça: o pedido da troca no balcão."), Exercise(id = "pt-foundations-u23-caixa-e4", kind = "written", prompt = "No caixa, pergunte se pode pagar com cartão.", options = listOf(), answers = listOf("Pode ser no cartão ?", "pode ser no cartao", "Posso pagar no cartão ?", "posso pagar no cartao"), explain = "Pode ser + forma de pagamento: a pergunta rápida do caixa.")), skills = listOf("function:go-shopping", "grammar:quantities", "vocab:shopping", "vocab:social-expressions"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:present-simple"))))
}

object PtFoundationsU27 {
    val unit = CourseUnit(id = "pt-foundations-u27", title = "Bicho de casa", subtitle = "Um pet, muitas palavras", level = "A1", themes = listOf(ConversationTheme("bicho-chega", "O bicho chega", "Como ele é", "heart", "Course", "A Nina ganha um gatinho do tio Rafa e, pelo telefone, conta para a avó o nome, a cor, o tamanho e a idade do novo amigo.", 0),
                ConversationTheme("bicho-rotina", "A rotina do bicho", "Todo dia igual", "figure.walk", "Course", "De manhã, a Nina cuida do Biscoito: ele acorda cedo, come ração às sete e brinca com a bolinha antes do passeio.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u27-bicho", title = "O novo bicho", goal = "Apresentar o seu bicho: dizer o nome, a cor, o tamanho e a idade dele.", intro = LessonIntro(explanation = listOf("« Ter » mostra posse: « Eu tenho um gato ». Para perguntar, use « você tem… ? »: « Você tem bicho em casa ? ».", "« Ser » descreve o bicho: « Ele é pequeno e preto ». A pergunta fica « ele é como ? ».", "A idade também fica com « ter »: « O Biscoito tem três meses ». Você vê: « ter » serve para a posse e para a idade."), examples = listOf(ExampleLine(text = "Eu tenho um gatinho preto.", meaning = "ter + bicho: a posse."), ExampleLine(text = "Ele é pequeno e muito carinhoso.", meaning = "ser + adjetivo: a descrição."), ExampleLine(text = "Você tem bicho em casa ?", meaning = "a pergunta com « você tem »."), ExampleLine(text = "Ele tem três meses.", meaning = "ter + tempo: a idade."), ExampleLine(text = "O nome dele é Biscoito.", meaning = "o nome com « ser »."))), expressions = listOf(TargetExpression(text = "Eu tenho …", meaning = "A posse: o seu bicho.", note = "Eu tenho uma cachorra."), TargetExpression(text = "Você tem bicho ?", meaning = "Perguntar sobre pets.", note = "Você tem bicho em casa ?"), TargetExpression(text = "Ele/Ela é …", meaning = "Descrever o bicho.", note = "Ele é branco e preto."), TargetExpression(text = "Ele tem … meses/anos", meaning = "A idade do bicho.", note = "Ela tem dois anos."), TargetExpression(text = "O nome dele é …", meaning = "Dar o nome do bicho.", note = "O nome dele é Biscoito.")), situation = "Pelo telefone com a avó: a Nina apresenta o gatinho — o nome, a cor, o tamanho e a idade — e a avó conta que também teve um gato parecido.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga que você tem um gatinho preto.", expected = listOf("Eu tenho um gatinho preto.", "eu tenho um gatinho preto"), focus = "ter", watch = "ter = tener (a posse fica com ter)."), PracticeQuestion(prompt = "Pergunte se a amiga tem bicho em casa.", expected = listOf("Você tem bicho em casa ?", "voce tem bicho em casa"), focus = "pergunta", watch = "você tem… ? = ¿tienes…?"), PracticeQuestion(prompt = "Descreva o bicho: pequeno e carinhoso.", expected = listOf("Ele é pequeno e carinhoso.", "ele e pequeno e carinhoso", "Ele é pequeno e muito carinhoso."), focus = "ser", watch = "é = es (a descrição fica com ser)."), PracticeQuestion(prompt = "Diga a idade dele: três meses.", expected = listOf("Ele tem três meses.", "ele tem tres meses"), focus = "idade", watch = "ter + idade = tener + edad."), PracticeQuestion(prompt = "Apresente o nome do bicho, com « o nome dele… ».", expected = listOf("O nome dele é Biscoito.", "o nome dele e biscoito"), focus = "nome", watch = "o nome dele = su nombre."))), exercises = listOf(Exercise(id = "pt-foundations-u27-bicho-e1", kind = "choice", prompt = "O Biscoito ___ preto e pequeno.", options = listOf("é", "tem", "tenho", "está"), answers = listOf("é"), explain = "« ser » descreve o bicho: ele é preto e pequeno."), Exercise(id = "pt-foundations-u27-bicho-e2", kind = "gap", prompt = "Eu ___ um gatinho em casa.", options = listOf(), answers = listOf("tenho"), explain = "« ter » para a posse: eu tenho um bicho em casa."), Exercise(id = "pt-foundations-u27-bicho-e3", kind = "order", prompt = "Diga a idade dele.", options = listOf(), answers = listOf("Ele tem três meses"), explain = "ter + tempo: a idade do bicho fica com « ter »."), Exercise(id = "pt-foundations-u27-bicho-e4", kind = "written", prompt = "Apresente o bicho com o nome dele.", options = listOf(), answers = listOf("O nome dele é Biscoito.", "o nome dele e biscoito"), explain = "« O nome dele é + nome »: a apresentação completa do bicho.")), skills = listOf("grammar:have-got", "grammar:present-simple", "vocab:family", "function:describe-people"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u27-rotina", title = "A rotina do Biscoito", goal = "Contar a rotina do seu bicho: o que ele faz sempre, às vezes ou nunca.", intro = LessonIntro(explanation = listOf("A rotina fica no presente: « o Biscoito acorda cedo », « ele come ração ». Você conta o dia inteiro com o mesmo tempo.", "As palavras da frequência vêm antes do verbo: « ele sempre dorme no sofá », « ele nunca sobe na cama ».", "Para perguntar, use o presente mesmo: « Ele passeia todos os dias ? »."), examples = listOf(ExampleLine(text = "O Biscoito acorda muito cedo.", meaning = "o presente: a rotina dele."), ExampleLine(text = "Ele sempre come ração às sete.", meaning = "sempre + verbo: todo dia."), ExampleLine(text = "Às vezes ele dorme no sofá.", meaning = "às vezes: não é todo dia."), ExampleLine(text = "Ele nunca sobe na cama.", meaning = "nunca: a negativa forte."), ExampleLine(text = "Ele passeia no parque todos os dias ?", meaning = "a pergunta da rotina."))), expressions = listOf(TargetExpression(text = "acordar cedo", meaning = "Levantar bem cedo.", note = "O Biscoito acorda cedo."), TargetExpression(text = "sempre / às vezes / nunca", meaning = "A frequência antes do verbo.", note = "Ele sempre mia de manhã."), TargetExpression(text = "comer ração", meaning = "A comida do bicho.", note = "Ele come ração duas vezes por dia."), TargetExpression(text = "passear no parque", meaning = "A caminhada do cachorro.", note = "Passeamos no parque à tarde."), TargetExpression(text = "todos os dias", meaning = "A rotina completa.", note = "Ele brinca todos os dias.")), situation = "De manhã em casa: a Nina conta o dia do Biscoito — ração às sete, soneca no sofá, bolinha na sala — e o irmão pergunta se o gato sobe na cama.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Como começa o dia do gato ?", expected = listOf("O Biscoito acorda cedo.", "o biscoito acorda cedo"), focus = "presente", watch = "acordar = despertarse."), PracticeQuestion(prompt = "Diga que ele come ração às sete, todo dia.", expected = listOf("Ele sempre come ração às sete.", "ele sempre come racao as sete"), focus = "sempre", watch = "sempre = siempre (antes do verbo)."), PracticeQuestion(prompt = "Diga que a soneca no sofá não é todo dia.", expected = listOf("Às vezes ele dorme no sofá.", "as vezes ele dorme no sofa"), focus = "às vezes", watch = "às vezes = a veces."), PracticeQuestion(prompt = "Diga que a cama é proibida para o gato.", expected = listOf("Ele nunca sobe na cama.", "ele nunca sobe na cama"), focus = "nunca", watch = "nunca = nunca (a negativa vai antes do verbo)."), PracticeQuestion(prompt = "Pergunte se o passeio acontece todo dia.", expected = listOf("Ele passeia todos os dias ?", "ele passeia todos os dias"), focus = "pergunta", watch = "todos os dias = todos los días."))), exercises = listOf(Exercise(id = "pt-foundations-u27-rotina-e1", kind = "choice", prompt = "Ele ___ dorme no sofá, só quando chove.", options = listOf("às vezes", "sempre", "nunca", "todo dia"), answers = listOf("às vezes"), explain = "« só quando chove » marca frequência parcial: às vezes."), Exercise(id = "pt-foundations-u27-rotina-e2", kind = "gap", prompt = "Ele ___ mia de manhã, todos os dias.", options = listOf(), answers = listOf("sempre"), explain = "todos os dias = sempre: a frequência antes do verbo."), Exercise(id = "pt-foundations-u27-rotina-e3", kind = "order", prompt = "Qual é a regra da cama para o gato ?", options = listOf(), answers = listOf("Ele nunca sobe na cama"), explain = "nunca + verbo: a negativa forte da rotina."), Exercise(id = "pt-foundations-u27-rotina-e4", kind = "written", prompt = "Conte uma coisa que o bicho faz todo dia.", options = listOf(), answers = listOf("Ele come ração todos os dias.", "ele come racao todos os dias", "Ele passeia todos os dias.", "ele passeia todos os dias"), explain = "Presente + todos os dias: a rotina completa do bicho.")), skills = listOf("grammar:present-simple", "grammar:frequency-adverbs", "vocab:daily-routine", "function:talk-about-routines"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple"))))
}

object PtFoundationsU3 {
    val unit = CourseUnit(id = "pt-foundations-u3", title = "O passado", subtitle = "O que você fez ?", level = "A2", themes = listOf(ConversationTheme("fds-passado", "O fim de semana que passou", "Pretérito perfeito", "clock.arrow.circlepath", "Course", "Vocês contam o que fizeram no fim de semana: saídas, comidas, encontros.", 0),
                ConversationTheme("viagem-lembrada", "A viagem do ano passado", "Lembranças", "airplane", "Course", "Uma viagem inesquecível: onde foi, o que viu, com quem.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u3-pretérito", title = "O pretérito perfeito", goal = "Contar ações terminadas no passado com -ei/-ou/-amos e -i/-iu.", intro = LessonIntro(explanation = listOf("O pretérito perfeito fala de ações terminadas: « Ontem comi paella ». « Ano passado viajei para o México ».", "Regulares: -ar → ei/ou/amos/aram. -er/-ir → i/eu/iu/emos/iram.", "Irrregulares frequentes: fui/foi, fiz/fez, vi/viu, disse/disseram, estive/esteve."), examples = listOf(ExampleLine(text = "Ontem comi paella no centro.", meaning = "comer → comi."), ExampleLine(text = "Ano passado viajei para o México.", meaning = "viajar → viajei."), ExampleLine(text = "Fui ao cinema com minha irmã.", meaning = "ir → fui."), ExampleLine(text = "Fiz a reserva por telefone.", meaning = "fazer → fiz."), ExampleLine(text = "Não gostei do hotel.", meaning = "gostar → gostei."))), expressions = listOf(TargetExpression(text = "comi / comeu / comemos", meaning = "Comer no passado.", note = "-er: i/eu/iu."), TargetExpression(text = "viajei / viajou / viajaram", meaning = "-ar no passado.", note = "viajar → viajei."), TargetExpression(text = "fui / foi", meaning = "Ir e ser no passado.", note = "fui ao cinema, foi para casa."), TargetExpression(text = "fiz / fez / vi / viu", meaning = "Irrregulares frequentes.", note = "fiz a comida, vi o filme."), TargetExpression(text = "ontem / na semana passada", meaning = "Marcadores de tempo.", note = "Ontem saí.")), situation = "Vocês contam o fim de semana: um conta o que fez no sábado, o outro pergunta detalhes e conta o seu.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga uma ação que você fez ontem. (comer fora)", expected = listOf("Ontem comi fora."), focus = "comer → comi", watch = "Ontem + comi — terminado."), PracticeQuestion(prompt = "Diga onde você foi no fim de semana.", expected = listOf("Fui à praia."), focus = "ir → fui", watch = "“I went” → fui."), PracticeQuestion(prompt = "Pergunte ao seu amigo o que ele fez ontem.", expected = listOf("O que você fez ontem ?"), focus = "você fez", watch = "fazer → fez."), PracticeQuestion(prompt = "Diga que não gostou do filme.", expected = listOf("Não gostei do filme."), focus = "gostei", watch = "gostei (pretérito) para reação."), PracticeQuestion(prompt = "Diga quando viajou pela última vez.", expected = listOf("Ano passado viajei para <lugar>."), focus = "ano passado", watch = "Marcador de tempo + pretérito."))), exercises = listOf(Exercise(id = "pt-foundations-u3-pretérito-e1", kind = "choice", prompt = "Ontem ___ ao cinema com minha irmã.", options = listOf("fui", "vou", "ia", "vou ir"), answers = listOf("fui"), explain = "ir → fui (pretérito)."), Exercise(id = "pt-foundations-u3-pretérito-e2", kind = "gap", prompt = "Ontem ___ uma paella incrível. (comer)", options = listOf(), answers = listOf("comi", "comí"), explain = "comer → comi."), Exercise(id = "pt-foundations-u3-pretérito-e3", kind = "order", prompt = "Pergunte pelo fim de semana.", options = listOf(), answers = listOf("O que voce fez no fim de semana"), explain = "O que você fez no fim de semana ?"), Exercise(id = "pt-foundations-u3-pretérito-e4", kind = "written", prompt = "Diga uma ação no passado: falar com Marta.", options = listOf(), answers = listOf("falei com marta", "falei com marta ontem"), explain = "falar → falei.")), skills = listOf("grammar:past-simple-regular", "grammar:past-simple-irregular", "grammar:time-expressions", "function:describe-past-events"), canDo = listOf("describe-past-events"), prerequisites = listOf("grammar:past-simple-regular"))))
}

