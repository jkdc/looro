object DeFoundationsU1 {
    val unit = CourseUnit(id = "de-foundations-u1", title = "First sentences", subtitle = "Say who you are", level = "A1", themes = listOf(ConversationTheme("lang-exchange", "Language-exchange café", "Meet and greet", "person.2", "Course", "You are at a friendly language-exchange café in Berlin. Meet the learner, exchange names, countries and jobs using the verb sein.", 0),
                ConversationTheme("introductions", "Nice to meet you", "Start somewhere small", "hand.wave", "Connection", "Meet the learner for the first time. Learn their interests through natural introductions.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u1-sein", title = "The verb “sein”", goal = "Introduce yourself and say who people are with ich bin, du bist, er ist, wir sind, ihr seid, sie sind.", intro = LessonIntro(explanation = listOf("Every German sentence needs a subject and a verb. The verb for saying who you are is “sein”.", "Six forms, one per subject: ich bin, du bist, er/sie ist, wir sind, ihr seid, sie sind. German always states the subject: “Ich bin Ana”.", "Use sein for identity and origin: “Ich bin Ana”, “Ich bin aus Deutschland”, “Er ist Lehrer”. Origin takes aus: “Ich bin aus Berlin”."), examples = listOf(ExampleLine(text = "Ich bin Ana. Ich bin aus Deutschland.", meaning = "Your name and country."), ExampleLine(text = "Du bist mein bester Freund.", meaning = "A close bond with someone."), ExampleLine(text = "Sie ist Lehrerin.", meaning = "Someone's profession."), ExampleLine(text = "Wir sind sehr glücklich heute.", meaning = "A feeling that defines right now."), ExampleLine(text = "Das Café ist nah am Bahnhof.", meaning = "Where a place is."), ExampleLine(text = "Sie sind aus Berlin.", meaning = "Someone's origin."))), expressions = listOf(TargetExpression(text = "Ich bin …", meaning = "Introduce yourself.", note = "With your name or job: Ich bin Ana. Ich bin Lehrerin."), TargetExpression(text = "Ich bin aus …", meaning = "Say where you come from.", note = "Origin takes aus, not von: Ich bin aus Berlin."), TargetExpression(text = "Bist du … ?", meaning = "Ask about the other person.", note = "Bist du Student? Bist du von hier?"), TargetExpression(text = "Ja, bin ich. / Nein, bin ich nicht.", meaning = "Short answers to a Bist du… ? question.", note = "The verb comes first in the answer."), TargetExpression(text = "Er ist / Sie ist …", meaning = "Say what someone else is.", note = "Er ist Lehrer — no article with jobs."), TargetExpression(text = "Freut mich, dich kennenzulernen.", meaning = "The fixed phrase when you meet someone.", note = "Short and natural: Freut mich!")), situation = "You meet someone new at a friendly language-exchange café in Berlin. Introduce yourselves and ask simple questions with the verb sein.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Hallo! Ich bin Ana. Wie heißt du?", expected = listOf("Ich heiße <name>.", "Ich bin <name>.", "Mein Name ist <name>."), focus = "Ich heiße / Ich bin", watch = "Answering only the name: accept it, then recast “Ich heiße …”."), PracticeQuestion(prompt = "Woher kommst du?", expected = listOf("Ich komme aus <country>.", "Ich bin aus <country>."), focus = "kommen aus / sein aus", watch = "“Ich komme von Spanien” — recast with aus."), PracticeQuestion(prompt = "Bist du Student?", expected = listOf("Ja, bin ich.", "Nein, bin ich nicht."), focus = "short answers with sein", watch = "One-word “Ja” — recast with the verb: Ja, bin ich."), PracticeQuestion(prompt = "Wie geht es dir heute?", expected = listOf("Mir geht es gut.", "Ich bin müde.", "Ich bin glücklich."), focus = "sein for feelings", watch = "“Ich bin gut” sounds off — recast “Mir geht es gut”."), PracticeQuestion(prompt = "Ist deine Stadt groß oder klein?", expected = listOf("Sie ist groß.", "Sie ist klein.", "Meine Stadt ist …"), focus = "ist with places", watch = "“Meine Stadt groß” — recast “Meine Stadt IST groß”."), PracticeQuestion(prompt = "Jetzt sind wir Freunde! Woher ist deine Familie?", expected = listOf("Sie ist aus <country>.", "Meine Familie ist aus <country>."), focus = "ist for a group's origin", watch = "“Meine Familie aus …” — recast with ist."))), exercises = listOf(Exercise(id = "de-foundations-u1-sein-e1", kind = "choice", prompt = "Sie ___ Lehrerin.", options = listOf("ist", "bist", "bin", "sind"), answers = listOf("ist"), explain = "With er/sie, sein becomes ist."), Exercise(id = "de-foundations-u1-sein-e2", kind = "gap", prompt = "Wir ___ aus Berlin.", options = listOf(), answers = listOf("sind"), explain = "With wir, sein is immer sind."), Exercise(id = "de-foundations-u1-sein-e3", kind = "order", prompt = "Say where you are from.", options = listOf(), answers = listOf("Ich bin aus Deutschland"), explain = "Ich bin + aus + country: Ich bin aus Deutschland."), Exercise(id = "de-foundations-u1-sein-e4", kind = "written", prompt = "Introduce yourself in one sentence: say your name.", options = listOf(), answers = listOf("Ich heiße <name>", "Ich bin <name>", "Mein Name ist <name>"), explain = "Ich heiße Ana / Ich bin Ana — the subject is never dropped.")), skills = listOf("grammar:verb-be", "grammar:subject-pronouns", "function:describe-people", "speaking:short-answer"), canDo = listOf("describe-people"), prerequisites = listOf("grammar:verb-be")),
    Lesson(id = "de-foundations-u1-questions", title = "Questions & negatives", goal = "Ask yes/no questions and say what is not true, with Bist du… ? and ich bin nicht.", intro = LessonIntro(explanation = listOf("German asks yes/no questions by putting the verb first: “Bist du müde?” — statement “Du bist müde” becomes a question by swapping.", "To negate, put nicht after the verb: “Ich bin nicht Ana”, “Wir sind nicht Freunde”. Nicht usually sits at the end of the sentence.", "Question words come first: “Woher kommst du?”, “Wer ist das?” — woher asks about origin, wo about place."), examples = listOf(ExampleLine(text = "Bist du Lehrerin?", meaning = "A yes/no question with bist."), ExampleLine(text = "Ich bin nicht aus Berlin.", meaning = "A negative with bin."), ExampleLine(text = "Woher kommst du?", meaning = "Question word + kommst."), ExampleLine(text = "Er ist nicht mein Bruder.", meaning = "A negative about another person."), ExampleLine(text = "Seid ihr Nachbarn?", meaning = "Asking a group with seid."), ExampleLine(text = "Wer ist das?", meaning = "Who is that?"))), expressions = listOf(TargetExpression(text = "Bist du … ?", meaning = "Ask a yes/no question.", note = "Verb first: Bist du Lehrer?"), TargetExpression(text = "Ich bin nicht …", meaning = "Say what is not true about you.", note = "nicht after the verb: Ich bin nicht müde."), TargetExpression(text = "Woher kommst du?", meaning = "Ask where someone is from.", note = "woher = from where; wo = where."), TargetExpression(text = "Er ist nicht …", meaning = "Say what someone else is not.", note = "Er ist nicht mein Chef."), TargetExpression(text = "Stimmt's?", meaning = "Tag a statement to check it.", note = "Du bist von hier, stimmt's?"), TargetExpression(text = "Genau.", meaning = "The natural yes in talk.", note = "Also: Stimmt.")), situation = "You chat with a new neighbour in the lift in Berlin. Ask simple yes/no questions and say what is and isn't true for you.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Bist du von hier?", expected = listOf("Ja, ich bin von hier.", "Nein, ich bin nicht von hier."), focus = "short answers", watch = "One-word “Ja” — recast with the verb: Ja, bin ich."), PracticeQuestion(prompt = "Bist du Lehrer oder Student?", expected = listOf("Ich bin Lehrer.", "Ich bin Student.", "Ich bin Studentin."), focus = "choice with sein", watch = "Accept either; no article before jobs."), PracticeQuestion(prompt = "Ist deine Familie groß?", expected = listOf("Ja, sie ist groß.", "Nein, sie ist nicht groß."), focus = "ist in questions about others", watch = "“nicht groß” — nicht at the end here."), PracticeQuestion(prompt = "Woher kommst du genau?", expected = listOf("Ich komme aus <country>.", "Ich bin aus <country>."), focus = "woher + aus", watch = "“Ich komme aus” und “Ich bin aus” — both fine."), PracticeQuestion(prompt = "Sag mir, was du nicht bist.", expected = listOf("Ich bin nicht <job>.", "Ich bin nicht aus <country>."), focus = "negation with nicht", watch = "“Ich nicht bin” — recast: Ich BIN nicht …"), PracticeQuestion(prompt = "Sind wir jetzt Freunde?", expected = listOf("Ja, wir sind Freunde.", "Klar, wir sind Freunde."), focus = "sind in questions", watch = "“Wir seid” is wrong — wir takes sind."))), exercises = listOf(Exercise(id = "de-foundations-u1-questions-e1", kind = "choice", prompt = "___ du aus Hamburg?", options = listOf("Bist", "Ist", "Bin", "Sind"), answers = listOf("Bist"), explain = "With du, the question starts with Bist."), Exercise(id = "de-foundations-u1-questions-e2", kind = "gap", prompt = "Sie ist nicht ___ Schwester.", options = listOf(), answers = listOf("meine"), explain = "meine for feminine things: meine Schwester."), Exercise(id = "de-foundations-u1-questions-e3", kind = "order", prompt = "Say you are not from München.", options = listOf(), answers = listOf("Ich bin nicht aus München"), explain = "nicht goes after bin, at the end here."), Exercise(id = "de-foundations-u1-questions-e4", kind = "written", prompt = "Make it negative: \"Ich bin aus Köln.\"", options = listOf(), answers = listOf("Ich bin nicht aus Köln"), explain = "nicht before aus Köln: Ich bin nicht aus Köln.")), skills = listOf("grammar:verb-be", "grammar:present-questions", "function:ask-simple-questions", "speaking:short-answer"), prerequisites = listOf("grammar:subject-pronouns")),
    Lesson(id = "de-foundations-u1-introduce", title = "Introducing yourself", goal = "Give a complete self-introduction: name, city, nationality and job.", intro = LessonIntro(explanation = listOf("A full German introduction has four pieces: your name, your city, your nationality and your job.", "For the name: “Ich heiße Ana” or “Ich bin Ana”. For origin: “Ich komme aus Berlin”. Nationalities are adjectives without an article: “Ich bin deutsche” — wait, careful: “Ich bin Deutsche” as a noun, or “Ich bin deutsch” as an adjective.", "Jobs with sein drop the article: “Ich bin Lehrerin”. Close with “Freut mich” and bounce the question back with “Und du?”"), examples = listOf(ExampleLine(text = "Ich heiße Ana. Freut mich.", meaning = "Your name plus a polite close."), ExampleLine(text = "Ich komme aus Berlin.", meaning = "Your city."), ExampleLine(text = "Ich bin Deutsche.", meaning = "Nationality as a noun."), ExampleLine(text = "Ich bin Krankenschwester im Krankenhaus.", meaning = "Job plus workplace."), ExampleLine(text = "Ich bin fünfundzwanzig Jahre alt.", meaning = "Your age — with sein + alt."), ExampleLine(text = "Und du? Was machst du?", meaning = "Bounce the question back."))), expressions = listOf(TargetExpression(text = "Ich heiße …", meaning = "Give your name.", note = "Also: Mein Name ist … or Ich bin …"), TargetExpression(text = "Ich bin + nationality", meaning = "Say your nationality.", note = "As a noun: Ich bin Deutsche / Deutscher."), TargetExpression(text = "Ich komme aus …", meaning = "Say your city or country.", note = "Ich komme aus Berlin; Ich komme aus Deutschland."), TargetExpression(text = "Ich arbeite in …", meaning = "Say where you work.", note = "Ich arbeite im Krankenhaus / in einer Schule."), TargetExpression(text = "Freut mich.", meaning = "Polite close when you meet someone.", note = "Answer: Mich auch."), TargetExpression(text = "Und du?", meaning = "Bounce the question back.", note = "—Ich komme aus Berlin. Und du?")), situation = "Your first day at a language school in Berlin. Present yourself completely to the class: name, city, nationality and job.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Wie heißt du?", expected = listOf("Ich heiße <name>.", "Mein Name ist <name>."), focus = "name formulas", watch = "Both are fine; recast the shorter one as Ich heiße for variety."), PracticeQuestion(prompt = "Woher kommst du?", expected = listOf("Ich komme aus <country>."), focus = "origin", watch = "Never von for countries: Ich komme AUS <country>."), PracticeQuestion(prompt = "Was bist du von der Nationalität?", expected = listOf("Ich bin <nationality>."), focus = "nationality with sein", watch = "As a noun it takes -e for women: Deutsche, Französin."), PracticeQuestion(prompt = "Was arbeitest du?", expected = listOf("Ich bin <job>.", "Ich arbeite als <job>."), focus = "jobs without article", watch = "“Ich bin eine Lehrerin” — recast dropping the article."), PracticeQuestion(prompt = "Und wo wohnst du?", expected = listOf("Ich wohne in <city>."), focus = "wohne in", watch = "“Ich wohne in Berlin” — in for cities."), PracticeQuestion(prompt = "Freut mich! Und was machst du so?", expected = listOf("Ich bin <job>."), focus = "bounce back and answer", watch = "Recast with Ich bin + job."))), exercises = listOf(Exercise(id = "de-foundations-u1-introduce-e1", kind = "choice", prompt = "___ Ana. Freut mich.", options = listOf("Ich heiße", "Ich heiße aus", "Heiße", "Ich bin aus"), answers = listOf("Ich heiße"), explain = "Ich heiße + name: one piece, no aus."), Exercise(id = "de-foundations-u1-introduce-e2", kind = "gap", prompt = "Ich komme aus ___. Ich bin Italienerin.", options = listOf(), answers = listOf("Italien"), explain = "Country: Italien — nationality: Italienerin."), Exercise(id = "de-foundations-u1-introduce-e3", kind = "order", prompt = "Say your name and city.", options = listOf(), answers = listOf("Ich bin Ana und ich komme aus Berlin"), explain = "Two pieces, each with its verb."), Exercise(id = "de-foundations-u1-introduce-e4", kind = "written", prompt = "Give your complete introduction: name and country.", options = listOf(), answers = listOf("Ich heiße <name> und ich komme aus <country>", "Ich bin <name> und ich komme aus <country>"), explain = "Name + origin, each with its verb.")), skills = listOf("grammar:verb-be", "function:introduce-yourself", "vocab:introductions", "pron:word-stress"), canDo = listOf("introduce-yourself"))))
}

object DeFoundationsU2 {
    val unit = CourseUnit(id = "de-foundations-u2", title = "Mein Alltag", subtitle = "Routine und Pläne", level = "A1", themes = listOf(ConversationTheme("morgen-chaos", "Morgenchaos", "Gegen die Uhr", "sunrise", "Course", "Du erzählst deinen Morgen Minute für Minute: Uhrzeiten, Gewohnheiten, Vergessenes.", 0),
                ConversationTheme("samstag-zwei", "Samstag zu zweit", "Was machen wir?", "figure.walk", "Course", "Pläne für Samstag mit einem Freund: Markt, Uhrzeit, Treffpunkt.", 1)), lessons = listOf(    Lesson(id = "de-foundations-u2-routine", title = "Meine Routine", goal = "Deinen Tag im Präsens mit Uhrzeiten erzählen.", intro = LessonIntro(explanation = listOf("Das Präsens erzählt Gewohnheiten: „Ich stehe um sieben auf. Ich frühstücke Kaffee und Toast. Um acht gehe ich los.“", "Trennbare Verben nehmen den Präfix mit ans Ende: „aufstehen“ → „Ich stehe um sieben auf.“", "Uhrzeiten mit um: „um sieben“, „um halb acht“. Mit ab: „ab acht Uhr bin ich frei.“"), examples = listOf(ExampleLine(text = "Ich stehe um sieben auf.", meaning = "aufstehen getrennt: … auf."), ExampleLine(text = "Ich frühstücke Kaffee und Toast.", meaning = "Das Frühstück als Verb."), ExampleLine(text = "Um acht gehe ich los.", meaning = "losgehen, getrennt."), ExampleLine(text = "Abends esse ich um neun.", meaning = "Das Abendessen."), ExampleLine(text = "Samstags schlafe ich lange.", meaning = "Die Wochenendgewohnheit."))), expressions = listOf(TargetExpression(text = "Ich stehe um … auf", meaning = "Aufstehen.", note = "auf am Ende!"), TargetExpression(text = "Ich frühstücke …", meaning = "Das Frühstück.", note = "frühstücke + Essen."), TargetExpression(text = "Um … gehe ich los", meaning = "Der Start.", note = "um + Uhrzeit."), TargetExpression(text = "Samstags …", meaning = "Die Gewohnheit.", note = "samstags = jeden Samstag."), TargetExpression(text = "Ich gehe um … ins Bett", meaning = "Das Zubettgehen.", note = "ins Bett gehen.")), situation = "Du erzählst einem neuen Freund deinen Morgen: Aufstehen, Frühstück, Losgehen — und wie der Samstag anders ist.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sag, wann du unter der Woche aufstehst.", expected = listOf("Ich stehe um <Uhrzeit> auf."), focus = "aufstehen", watch = "trennbar: „…auf“ am Satzende."), PracticeQuestion(prompt = "Sag, was du frühstückst.", expected = listOf("Ich frühstücke <Essen> und <Essen>."), focus = "frühstücken", watch = "frühstücke + Essen."), PracticeQuestion(prompt = "Sag, wann du losgehst.", expected = listOf("Um <Uhrzeit> gehe ich los."), focus = "losgehen", watch = "„los“ am Satzende."), PracticeQuestion(prompt = "Sag deine Samstaggewohnheit.", expected = listOf("Samstags schlafe ich lange."), focus = "samstags", watch = "samstags = jeden Samstag."), PracticeQuestion(prompt = "Sag, wann du ins Bett gehst.", expected = listOf("Ich gehe um <Uhrzeit> ins Bett."), focus = "ins Bett", watch = "ins Bett gehen — feststehend."))), exercises = listOf(Exercise(id = "de-foundations-u2-routine-e1", kind = "choice", prompt = "Ich ___ um sieben ___.", options = listOf("stehe … auf", "auf … stehe", "stehe … aufstehen", "aufstehe … auf"), answers = listOf("stehe … auf"), explain = "aufstehen ist trennbar."), Exercise(id = "de-foundations-u2-routine-e2", kind = "gap", prompt = "Ich ___ Kaffee und Toast. (frühstücken)", options = listOf(), answers = listOf("frühstücke"), explain = "ich frühstücke."), Exercise(id = "de-foundations-u2-routine-e3", kind = "order", prompt = "Sag, wann du losgehst.", options = listOf(), answers = listOf("Um acht gehe ich los"), explain = "um + Zeit + gehe ich los."), Exercise(id = "de-foundations-u2-routine-e4", kind = "written", prompt = "Deine Samstaggewohnheit.", options = listOf(), answers = listOf("samstags schlafe ich lange", "samstags stehe ich spät auf"), explain = "samstags + Präsens.")), skills = listOf("grammar:present-simple", "grammar:time-expressions", "vocab:daily-routine", "function:talk-about-routines"), canDo = listOf("talk-about-routines"), prerequisites = listOf("grammar:present-simple")),
