                ConversationTheme("planos-viagem", "Planos de viagem", "Vamos aonde ?", "airplane", "Course", "Vocês planejam as férias com ir + infinitivo.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u4-comparando", title = "Comparando", goal = "Comparar com mais/menos… do que e o melhor/pior.", intro = LessonIntro(explanation = listOf("Comparativos: mais/menos + adjetivo + do que. « Este hotel é mais caro do que aquele ».", "Superlativos: o/a melhor/pior + de. « O melhor restaurante da cidade ».", "Bom → melhor, mau → pior. « Este é melhor do que aquele »."), examples = listOf(ExampleLine(text = "Este hotel é mais caro do que aquele.", meaning = "mais + adj + do que."), ExampleLine(text = "A praia é menos movimentada que a piscina.", meaning = "menos + adj."), ExampleLine(text = "É o melhor restaurante da cidade.", meaning = "o melhor + de."), ExampleLine(text = "Este verão é pior que o passado.", meaning = "pior = mau comparado."), ExampleLine(text = "Tão simples quanto isso.", meaning = "tão + adj + quanto = igualdade."))), expressions = listOf(TargetExpression(text = "mais … do que", meaning = "Mais do que.", note = "mais caro do que."), TargetExpression(text = "menos … do que", meaning = "Menos do que.", note = "menos frio do que."), TargetExpression(text = "o/a melhor … de", meaning = "Superlativo.", note = "o melhor da cidade."), TargetExpression(text = "melhor / pior", meaning = "Irregulares.", note = "melhor que, o pior de."), TargetExpression(text = "tão … quanto", meaning = "Igualdade.", note = "tão caro quanto antes.")), situation = "Vocês comparam dois hotéis para as férias: preço, localização, limpeza — e escolhem o melhor.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Compare o preço: hotel A 80€, hotel B 100€.", expected = listOf("O hotel A é mais barato do que o hotel B."), focus = "mais barato", watch = "barato → mais barato do que."), PracticeQuestion(prompt = "Diga qual é o melhor. (hotel A)", expected = listOf("O hotel A é o melhor."), focus = "o melhor", watch = "o melhor + de/em."), PracticeQuestion(prompt = "Diga que o hotel B é pior.", expected = listOf("O hotel B é pior que o A."), focus = "pior", watch = "pior que — irregular."), PracticeQuestion(prompt = "Compare localização: A perto, B longe.", expected = listOf("O hotel A fica mais perto do centro."), focus = "mais perto", watch = "perto → mais perto de."), PracticeQuestion(prompt = "Diga que são iguais em limpeza.", expected = listOf("São tão limpos quanto o outro."), focus = "tão quanto", watch = "tão + adj + quanto = igualdade."))), exercises = listOf(Exercise(id = "pt-foundations-u4-comparando-e1", kind = "choice", prompt = "Este hotel é ___ caro ___ aquele.", options = listOf("mais … do que", "mais … de", "tão … que", "muito … que"), answers = listOf("mais … do que"), explain = "mais + adj + do que."), Exercise(id = "pt-foundations-u4-comparando-e2", kind = "gap", prompt = "É o ___ restaurante da cidade. (bom)", options = listOf(), answers = listOf("melhor"), explain = "bom → o melhor."), Exercise(id = "pt-foundations-u4-comparando-e3", kind = "order", prompt = "Compare o preço.", options = listOf(), answers = listOf("Este e mais barato que aquele"), explain = "mais + adj + do que."), Exercise(id = "pt-foundations-u4-comparando-e4", kind = "written", prompt = "Seu restaurante favorito.", options = listOf(), answers = listOf("meu restaurante favorito e <nome>", "o melhor e <nome>"), explain = "Meu favorito é X.")), skills = listOf("grammar:comparatives", "grammar:superlatives", "grammar:connectors", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:comparatives"))))
}

object PtFoundationsU17 {
    val unit = CourseUnit(id = "pt-foundations-u17", title = "Combinar bem", subtitle = "Convites e planos", level = "A2", themes = listOf(ConversationTheme("combinar-planos", "Combinar o dia", "Propostas e respostas", "calendar.badge.clock", "Course", "Vocês combinam o fim de semana: propostas com vem/vamos, aceites e uma recusa com que pena.", 0),
                ConversationTheme("presente-perfeito", "O presente perfeito", "Planos de presente", "gift", "Course", "A turma planeja o presente de aniversário da Bia com ir + infinitivo: cada um vai levar uma coisa.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u17-propostas", title = "Vem ou prefere… ?", goal = "Fazer propostas e responder: vem com a gente, vamos…, prefere….", intro = LessonIntro(explanation = listOf("Para propor: « Vem com a gente ! » ou « Vamos + infinitivo ». « Vamos tomar um café ? ».", "Dar opções: « Prefere sábado ou domingo ? ». A resposta: « Prefiro sábado » ou « Pode ser ».", "Futuro próximo com ir: « Vou sim, vou adorar ». « Eles vão chegar às nove »."), examples = listOf(ExampleLine(text = "Vem com a gente ao cinema ?", meaning = "Convite direto."), ExampleLine(text = "Vamos almoçar juntos ?", meaning = "vamos + infinitivo."), ExampleLine(text = "Prefere sábado ou domingo ?", meaning = "prefere = prefieres."), ExampleLine(text = "Pode ser. Que horas ?", meaning = "Aceitar e perguntar."), ExampleLine(text = "Eu vou sim, vou adorar.", meaning = "Futuro: ir + infinitivo."))), expressions = listOf(TargetExpression(text = "Vem com a gente !", meaning = "Convidar.", note = "Vem com a gente à praia !"), TargetExpression(text = "Vamos + infinitivo ?", meaning = "Propor algo.", note = "Vamos tomar um café ?"), TargetExpression(text = "Prefere … ou … ?", meaning = "Dar opções.", note = "Prefere pizza ou sushi ?"), TargetExpression(text = "Pode ser.", meaning = "Aceitar.", note = "Pode ser, às oito."), TargetExpression(text = "que horas ?", meaning = "Perguntar a hora.", note = "Que horas vamos ?")), situation = "Vocês combinam o fim de semana: praia ou museu, sábado ou domingo — e cada um responde com o seu plano.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Convide seu amigo para a praia.", expected = listOf("Vem com a gente à praia ?", "Vem com a gente para a praia."), focus = "vem com a gente", watch = "convite com vem."), PracticeQuestion(prompt = "Proponha tomar um café.", expected = listOf("Vamos tomar um café ?", "vamos tomar um cafe"), focus = "vamos", watch = "vamos + infinitivo."), PracticeQuestion(prompt = "Dê as opções: sábado ou domingo.", expected = listOf("Prefere sábado ou domingo ?", "Você prefere sábado ou domingo ?"), focus = "prefere", watch = "prefere = prefieres."), PracticeQuestion(prompt = "Aceite e pergunte a hora.", expected = listOf("Pode ser. Que horas ?", "Pode ser, que horas ?"), focus = "pode ser", watch = "pode ser = puede ser."), PracticeQuestion(prompt = "Diga no futuro: você vai adorar o show.", expected = listOf("Você vai adorar o show.", "Vai adorar o show.", "voce vai adorar o show"), focus = "ir + infinitivo", watch = "vai + adorar."))), exercises = listOf(Exercise(id = "pt-foundations-u17-propostas-e1", kind = "choice", prompt = "___ com a gente ao parque ?", options = listOf("Vem", "Vai", "Prefere", "Tem"), answers = listOf("Vem"), explain = "Vem com a gente: convite."), Exercise(id = "pt-foundations-u17-propostas-e2", kind = "gap", prompt = "Vamos ___ um filme hoje ? (ver)", options = listOf(), answers = listOf("ver"), explain = "vamos + infinitivo: proposta."), Exercise(id = "pt-foundations-u17-propostas-e3", kind = "order", prompt = "Dê as opções: pizza ou sushi.", options = listOf(), answers = listOf("Prefere pizza ou sushi"), explain = "Prefere … ou … ? dá opções."), Exercise(id = "pt-foundations-u17-propostas-e4", kind = "written", prompt = "Diga no futuro: você vai dançar na festa.", options = listOf(), answers = listOf("vou dançar na festa", "eu vou dançar na festa", "vou dancar na festa"), explain = "ir + infinitivo: vou dançar.")), skills = listOf("function:make-suggestions", "grammar:going-to", "vocab:social-expressions", "grammar:present-simple"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "pt-foundations-u17-desculpa", title = "Que pena, não posso", goal = "Aceitar e recusar convites com desculpa: posso, não posso, que pena.", intro = LessonIntro(explanation = listOf("Aceitar: « Posso sim ! », « Obrigado pelo convite ». Recusar: « Não posso, desculpa ».", "A desculpa vem com porque: « Não posso, porque vou viajar ». Ou com obrigação: « Tenho que trabalhar ».", "Reagir à recusa: « Que pena ! ». E propor outra data: « Outro dia então ? »."), examples = listOf(ExampleLine(text = "Posso sim, obrigada pelo convite.", meaning = "Aceitar."), ExampleLine(text = "Que pena, não posso sábado.", meaning = "Recusar."), ExampleLine(text = "Não posso, porque vou viajar.", meaning = "porque + desculpa."), ExampleLine(text = "Tenho que trabalhar até tarde.", meaning = "ter que + infinitivo."), ExampleLine(text = "Outro dia então ?", meaning = "Repropor a data."))), expressions = listOf(TargetExpression(text = "Posso sim.", meaning = "Aceitar o convite.", note = "Posso sim, até lá."), TargetExpression(text = "Não posso, desculpa.", meaning = "Recusar.", note = "desculpa = perdón."), TargetExpression(text = "Que pena !", meaning = "Reagir à recusa.", note = "Que pena, fica para a próxima."), TargetExpression(text = "tenho que + infinitivo", meaning = "Obrigação.", note = "Tenho que estudar."), TargetExpression(text = "outro dia então ?", meaning = "Repropor a data.", note = "Outro dia então ?")), situation = "A turma combina o sábado: dois aceitam na hora, um recusa com desculpa — e o grupo marca outro dia.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Aceite o convite para o cinema.", expected = listOf("Posso sim, obrigada.", "Aceito, obrigada pelo convite.", "posso sim"), focus = "posso sim", watch = "aceitar com posso."), PracticeQuestion(prompt = "Recuse o convite de sábado.", expected = listOf("Que pena, não posso sábado.", "Não posso sábado, desculpa."), focus = "não posso", watch = "recusar com não posso."), PracticeQuestion(prompt = "Dê a desculpa: você vai viajar.", expected = listOf("Não posso, porque vou viajar.", "Vou viajar."), focus = "porque", watch = "porque + desculpa."), PracticeQuestion(prompt = "Diga a obrigação: estudar.", expected = listOf("Tenho que estudar.", "Não posso, tenho que estudar."), focus = "tenho que", watch = "ter que + infinitivo."), PracticeQuestion(prompt = "Reaja à recusa e proponha outro dia.", expected = listOf("Que pena ! Outro dia então ?", "Outro dia então ?"), focus = "outro dia", watch = "repropor com então."))), exercises = listOf(Exercise(id = "pt-foundations-u17-desculpa-e1", kind = "choice", prompt = "Que ___, não posso ir.", options = listOf("pena", "alegria", "sorte", "força"), answers = listOf("pena"), explain = "Que pena: reação a uma recusa."), Exercise(id = "pt-foundations-u17-desculpa-e2", kind = "gap", prompt = "Não posso, ___ vou visitar minha avó. (desculpa)", options = listOf(), answers = listOf("porque"), explain = "porque + desculpa: a razão."), Exercise(id = "pt-foundations-u17-desculpa-e3", kind = "order", prompt = "Diga a obrigação com estudar.", options = listOf(), answers = listOf("Tenho que estudar hoje"), explain = "ter que + infinitivo: obrigação."), Exercise(id = "pt-foundations-u17-desculpa-e4", kind = "written", prompt = "Recuse e proponha outra data.", options = listOf(), answers = listOf("Que pena, outro dia então ?", "que pena outro dia entao"), explain = "Que pena + proposta: recusa educada.")), skills = listOf("vocab:social-expressions", "function:make-suggestions", "grammar:present-simple", "grammar:connectors"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "pt-foundations-u17-presente", title = "O presente perfeito", goal = "Planejar o presente com ir + infinitivo: o que cada um vai fazer.", intro = LessonIntro(explanation = listOf("Futuro próximo: ir + infinitivo. « Eu vou comprar o bolo ». « Ela vai escolher o presente ».", "Dividir tarefas: « Quem vai levar as velas ? ». Responda: « Eu vou levar ».", "Para o presente: « Vamos embrulhar com papel de presente ». « Vai ser uma surpresa »."), examples = listOf(ExampleLine(text = "Eu vou comprar o bolo.", meaning = "vou + comprar."), ExampleLine(text = "Quem vai levar as velas ?", meaning = "Dividir tarefas."), ExampleLine(text = "Eu vou pagar a minha parte.", meaning = "parte = parte."), ExampleLine(text = "Vamos embrulhar o presente.", meaning = "vamos + embrulhar."), ExampleLine(text = "Vai ser uma surpresa.", meaning = "ser no futuro."))), expressions = listOf(TargetExpression(text = "vou + infinitivo", meaning = "O que você vai fazer.", note = "Vou comprar o bolo."), TargetExpression(text = "quem vai … ?", meaning = "Dividir tarefas.", note = "Quem vai levar as velas ?"), TargetExpression(text = "levar / trazer", meaning = "Levar para lá, trazer para cá.", note = "Vou levar o presente."), TargetExpression(text = "a parte", meaning = "Quota de cada um.", note = "Cada um paga a sua parte."), TargetExpression(text = "de surpresa", meaning = "Sem a pessoa saber.", note = "É uma festa de surpresa.")), situation = "Para o aniversário da Bia: um vai comprar o bolo, outro as bebidas — e cada um paga a sua parte.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga no futuro: você vai comprar o bolo.", expected = listOf("Eu vou comprar o bolo.", "Vou comprar o bolo."), focus = "vou", watch = "ir + infinitivo."), PracticeQuestion(prompt = "Pergunte quem vai levar as velas.", expected = listOf("Quem vai levar as velas ?", "quem vai levar as velas"), focus = "quem vai", watch = "quem vai = quién va a."), PracticeQuestion(prompt = "Diga que cada um vai pagar a sua parte.", expected = listOf("Cada um vai pagar a sua parte.", "cada um vai pagar a sua parte"), focus = "a parte", watch = "parte = parte."), PracticeQuestion(prompt = "Proponha embrulhar o presente.", expected = listOf("Vamos embrulhar o presente.", "Vamos embrulhar o presente juntos."), focus = "vamos", watch = "vamos + infinitivo."), PracticeQuestion(prompt = "Diga que vai ser uma surpresa.", expected = listOf("Vai ser uma surpresa.", "vai ser uma surpresa"), focus = "vai ser", watch = "ser no futuro."))), exercises = listOf(Exercise(id = "pt-foundations-u17-presente-e1", kind = "choice", prompt = "Eu ___ comprar o presente hoje.", options = listOf("vou", "vai", "vamos", "vão"), answers = listOf("vou"), explain = "eu + vou + infinitivo: futuro próximo."), Exercise(id = "pt-foundations-u17-presente-e2", kind = "gap", prompt = "Quem vai ___ as velas ? (levar)", options = listOf(), answers = listOf("levar"), explain = "ir + infinitivo: vai + levar."), Exercise(id = "pt-foundations-u17-presente-e3", kind = "order", prompt = "Diga no futuro: cada um paga a sua parte.", options = listOf(), answers = listOf("Cada um vai pagar a sua parte"), explain = "cada um + vai + infinitivo."), Exercise(id = "pt-foundations-u17-presente-e4", kind = "written", prompt = "Diga no futuro: você vai levar as bebidas.", options = listOf(), answers = listOf("vou levar as bebidas", "eu vou levar as bebidas"), explain = "vou + levar: futuro próximo.")), skills = listOf("grammar:going-to", "function:make-future-plans", "vocab:social-expressions", "function:go-shopping"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to"))))
}

object PtFoundationsU20 {
    val unit = CourseUnit(id = "pt-foundations-u20", title = "Problemas do dia a dia", subtitle = "Defeitos e soluções", level = "A2", themes = listOf(ConversationTheme("defeito-casa", "O defeito", "Contar e consertar", "wrench.and.screwdriver", "Course", "A torneira pinga e o liquidificador quebrou: a Ana conta o que aconteceu e o Leo propõe soluções simples.", 0),
                ConversationTheme("reclamacao-loja", "A reclamação", "Falar com a loja", "phone.badge.checkmark", "Course", "O Leo liga para a loja, explica o defeito com calma, mostra a nota e pede a troca do produto.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u20-defeito", title = "Quebrou", goal = "Contar um defeito no pretérito: quebrou, apagou, parou de funcionar.", intro = LessonIntro(explanation = listOf("Para contar o problema, use o pretérito: « quebrou », « caiu », « apagou ». « O liquidificador quebrou ontem ».", "Para o estado de agora, « está quebrado » ou « está pingando »: « A torneira está pingando ».", "Diga quando aconteceu: « ontem », « de manhã », « hoje cedo ». « De manhã a luz apagou »."), examples = listOf(ExampleLine(text = "O liquidificador quebrou ontem.", meaning = "quebrar → quebrou."), ExampleLine(text = "A torneira está pingando.", meaning = "estar + -ando: agora."), ExampleLine(text = "A luz apagou de manhã.", meaning = "apagar → apagou."), ExampleLine(text = "O controle remoto caiu e parou.", meaning = "cair → caiu."), ExampleLine(text = "O ventilador não funciona mais.", meaning = "O resultado de agora."))), expressions = listOf(TargetExpression(text = "… quebrou", meaning = "O objeto deixou de funcionar.", note = "O vidro quebrou."), TargetExpression(text = "está quebrado(a)", meaning = "Estado: precisa de conserto.", note = "A cadeira está quebrada."), TargetExpression(text = "… parou de funcionar", meaning = "Parou sozinho.", note = "O ventilador parou de funcionar."), TargetExpression(text = "ontem / de manhã / hoje cedo", meaning = "Quando aconteceu.", note = "Ontem de manhã a luz apagou."), TargetExpression(text = "não funciona mais", meaning = "O problema de agora.", note = "O liquidificador não funciona mais.")), situation = "Na cozinha, segunda-feira: a Ana conta ao Leo o que quebrou no fim de semana e o que parou de funcionar.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Conte o que aconteceu com o liquidificador.", expected = listOf("O liquidificador quebrou ontem.", "o liquidificador quebrou ontem"), focus = "quebrou", watch = "quebrou = se rompió."), PracticeQuestion(prompt = "Diga o problema de agora: a torneira pinga.", expected = listOf("A torneira está pingando.", "a torneira esta pingando"), focus = "estar + -ando", watch = "pingando = goteando."), PracticeQuestion(prompt = "Conte o problema da luz de manhã.", expected = listOf("A luz apagou de manhã.", "a luz apagou de manha"), focus = "apagou", watch = "apagar = apagarse."), PracticeQuestion(prompt = "Conte o problema do ventilador.", expected = listOf("O ventilador parou de funcionar.", "o ventilador parou de funcionar"), focus = "parou de", watch = "parou de funcionar = dejó de funcionar."), PracticeQuestion(prompt = "Como está a cadeira ?", expected = listOf("A cadeira está quebrada.", "a cadeira esta quebrada", "Está quebrada.", "esta quebrada"), focus = "estado", watch = "quebrada = rota."))), exercises = listOf(Exercise(id = "pt-foundations-u20-defeito-e1", kind = "choice", prompt = "O liquidificador ___ ontem.", options = listOf("quebrou", "quebra", "quebrar", "quebrará"), answers = listOf("quebrou"), explain = "Pretérito de quebrar: o fato já aconteceu."), Exercise(id = "pt-foundations-u20-defeito-e2", kind = "gap", prompt = "A torneira está ___.", options = listOf(), answers = listOf("pingando"), explain = "estar + -ando: ação que continua agora."), Exercise(id = "pt-foundations-u20-defeito-e3", kind = "order", prompt = "Conte o que aconteceu com a luz.", options = listOf(), answers = listOf("A luz apagou de manhã"), explain = "apagou: pretérito de apagar, com o tempo do fato."), Exercise(id = "pt-foundations-u20-defeito-e4", kind = "written", prompt = "Diga o estado da cadeira.", options = listOf(), answers = listOf("A cadeira está quebrada.", "a cadeira esta quebrada", "Está quebrada.", "esta quebrada"), explain = "estar + quebrado(a): o estado de agora.")), skills = listOf("function:solve-problems", "grammar:past-simple-regular", "grammar:past-simple-irregular", "function:describe-past-events"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "pt-foundations-u20-solucao", title = "O que eu faço ?", goal = "Pedir e dar soluções simples: o que eu faço, tente…, primeiro… depois…", intro = LessonIntro(explanation = listOf("Para pedir ajuda: « o que eu faço ? » ou « você pode me ajudar ? ». « O forno não liga — o que eu faço ? ».", "Para dar uma solução: « tente… », « por que você não… ? ». « Tente desligar e ligar de novo ».", "Ordene os passos com « primeiro » e « depois », e guarde um plano B: « se não funcionar… ». « Primeiro feche a água, depois abra o chuveiro »."), examples = listOf(ExampleLine(text = "O que eu faço com esse cabo ?", meaning = "Pedir uma solução."), ExampleLine(text = "Tente desligar e ligar de novo.", meaning = "A solução clássica."), ExampleLine(text = "Por que você não chama um técnico ?", meaning = "Sugestão suave."), ExampleLine(text = "Primeiro feche a água, depois abra o chuveiro.", meaning = "Passos em ordem."), ExampleLine(text = "Se não funcionar, eu chamo alguém.", meaning = "O plano B."))), expressions = listOf(TargetExpression(text = "O que eu faço ?", meaning = "Pedir uma solução.", note = "Perdi a chave — o que eu faço ?"), TargetExpression(text = "Tente + verbo", meaning = "Dar uma solução.", note = "Tente apertar o parafuso."), TargetExpression(text = "Por que você não + verbo ?", meaning = "Sugerir com jeito.", note = "Por que você não liga para a loja ?"), TargetExpression(text = "primeiro … depois …", meaning = "Passos em ordem.", note = "Primeiro feche, depois abra."), TargetExpression(text = "Se não funcionar, …", meaning = "O plano B.", note = "Se não funcionar, eu troco.")), situation = "O cabo do carregador não funciona: a Ana pede ajuda, o Leo dá um passo de cada vez e combina um plano B.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Peça ajuda com o forno: o que fazer ?", expected = listOf("O que eu faço com o forno ?", "o que eu faco com o forno", "O que eu faço ?", "o que eu faco"), focus = "o que eu faço", watch = "= ¿qué hago ?"), PracticeQuestion(prompt = "Sugira chamar um técnico, com jeito.", expected = listOf("Por que você não chama um técnico ?", "por que voce nao chama um tecnico"), focus = "por que você não", watch = "sugestão suave, sem imperativo."), PracticeQuestion(prompt = "Dê a solução clássica: desligar e ligar.", expected = listOf("Tente desligar e ligar de novo.", "tente desligar e ligar de novo"), focus = "tente", watch = "tente = intenta."), PracticeQuestion(prompt = "Dê dois passos: fechar e depois abrir.", expected = listOf("Primeiro feche a água, depois abra.", "primeiro feche a agua depois abra"), focus = "primeiro … depois", watch = "ordem dos passos."), PracticeQuestion(prompt = "Combine o plano B: chamar alguém.", expected = listOf("Se não funcionar, eu chamo alguém.", "se nao funcionar eu chamo alguem"), focus = "se não funcionar", watch = "o plano B com se."))), exercises = listOf(Exercise(id = "pt-foundations-u20-solucao-e1", kind = "choice", prompt = "___ desligar e ligar de novo.", options = listOf("Tente", "Tentou", "Tentar", "Tentando"), answers = listOf("Tente"), explain = "Tente + verbo: o imperativo educado da solução."), Exercise(id = "pt-foundations-u20-solucao-e2", kind = "gap", prompt = "___ não funcionar, eu chamo um técnico.", options = listOf(), answers = listOf("Se", "se"), explain = "se + não funcionar: o plano B."), Exercise(id = "pt-foundations-u20-solucao-e3", kind = "order", prompt = "Sugira ligar para a loja.", options = listOf(), answers = listOf("Por que você não liga para a loja"), explain = "por que você não + verbo: sugestão sem imperativo."), Exercise(id = "pt-foundations-u20-solucao-e4", kind = "written", prompt = "Pergunte o que fazer com a chave perdida.", options = listOf(), answers = listOf("O que eu faço ?", "o que eu faco", "O que faço ?", "o que faco"), explain = "o que eu faço ?: pedir a solução.")), skills = listOf("function:solve-problems", "function:make-requests", "grammar:connectors", "vocab:social-expressions"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "pt-foundations-u20-reclamacao", title = "Uma reclamação tranquila", goal = "Reclamar com educação: comprei…, está com defeito, posso trocar ?", intro = LessonIntro(explanation = listOf("Abra com calma: « boa tarde, comprei… ». « Boa tarde, comprei um liquidificador na semana passada ».", "Explique o defeito em uma frase: « está com defeito », « não liga ». « Ele não carrega mais ».", "Peça a solução: « posso trocar ? », « ainda tem garantia ? ». « Aqui está a nota fiscal »."), examples = listOf(ExampleLine(text = "Boa tarde, comprei este fone na loja.", meaning = "A abertura tranquila."), ExampleLine(text = "Está com defeito: não carrega.", meaning = "O defeito em uma frase."), ExampleLine(text = "Ainda tem garantia ?", meaning = "garantia = garantía."), ExampleLine(text = "Posso trocar por outro ?", meaning = "trocar = cambiar."), ExampleLine(text = "Trouxe a nota fiscal, está aqui.", meaning = "a nota = el comprobante."))), expressions = listOf(TargetExpression(text = "Comprei …", meaning = "Abrir a reclamação.", note = "Comprei na sua loja."), TargetExpression(text = "está com defeito", meaning = "O problema do produto.", note = "O aparelho está com defeito."), TargetExpression(text = "ainda tem garantia ?", meaning = "Perguntar a cobertura.", note = "Ainda tem garantia ?"), TargetExpression(text = "Posso trocar ?", meaning = "Pedir outro produto.", note = "Posso trocar por um novo ?"), TargetExpression(text = "a nota fiscal", meaning = "O comprovante da compra.", note = "Trouxe a nota fiscal.")), situation = "Na loja e por telefone: o Leo explica o defeito do fone com calma, mostra a nota e pede a troca.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Abra a reclamação: boa tarde, comprei…", expected = listOf("Boa tarde, comprei um fone na loja.", "boa tarde comprei um fone"), focus = "abrir com calma", watch = "boa tarde + o fato."), PracticeQuestion(prompt = "Diga o problema do produto.", expected = listOf("Está com defeito.", "esta com defeito", "O produto está com defeito.", "o produto esta com defeito"), focus = "estar com defeito", watch = "= tiene un defecto."), PracticeQuestion(prompt = "Pergunte pela garantia.", expected = listOf("Ainda tem garantia ?", "ainda tem garantia", "Tem garantia ?", "tem garantia"), focus = "garantia", watch = "garantia = garantía."), PracticeQuestion(prompt = "Peça a troca por outro.", expected = listOf("Posso trocar por outro ?", "posso trocar por outro", "Posso trocar ?", "posso trocar"), focus = "trocar", watch = "trocar = cambiar."), PracticeQuestion(prompt = "Diga que trouxe o comprovante.", expected = listOf("Trouxe a nota fiscal.", "trouxe a nota fiscal", "Aqui está a nota fiscal.", "aqui esta a nota fiscal"), focus = "nota fiscal", watch = "a prova da compra."))), exercises = listOf(Exercise(id = "pt-foundations-u20-reclamacao-e1", kind = "choice", prompt = "Comprei este fone, mas está ___ defeito.", options = listOf("com", "em", "de", "por"), answers = listOf("com"), explain = "estar com defeito: a fórmula fixa do problema."), Exercise(id = "pt-foundations-u20-reclamacao-e2", kind = "gap", prompt = "Posso ___ por outro, por favor ?", options = listOf(), answers = listOf("trocar"), explain = "trocar = cambiar: pedir outro produto."), Exercise(id = "pt-foundations-u20-reclamacao-e3", kind = "order", prompt = "Pergunte pela garantia do produto.", options = listOf(), answers = listOf("O produto ainda tem garantia"), explain = "ainda tem garantia ?: a pergunta da cobertura."), Exercise(id = "pt-foundations-u20-reclamacao-e4", kind = "written", prompt = "Explique o defeito do carregador.", options = listOf(), answers = listOf("Ele não carrega.", "ele nao carrega", "Não carrega mais.", "nao carrega mais"), explain = "não carrega: o defeito em uma frase.")), skills = listOf("function:solve-problems", "grammar:present-questions", "vocab:social-expressions", "grammar:connectors"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors"))))
}

object PtFoundationsU24 {
    val unit = CourseUnit(id = "pt-foundations-u24", title = "Compras grandes", subtitle = "Comparar, devolver, parcelar", level = "A2", themes = listOf(ConversationTheme("comparar-preco", "Comparar", "O melhor preço", "cart", "Course", "A Duda compara o celular novo em duas lojas: uma é mais barata, mas a outra tem melhor garantia e mais memória.", 0),
                ConversationTheme("troca-parcela", "Trocar e parcelar", "Recibo e prestação", "creditcard", "Course", "O celular apresenta defeito: a Duda volta com o recibo, resolve a troca e decide pagar a nova compra em dez parcelas.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u24-comparar", title = "O melhor preço", goal = "Comparar produtos: mais barato do que, tão bom quanto, o mais caro de todos.", intro = LessonIntro(explanation = listOf("Desigualdade com « mais … do que »: « essa loja é mais barata do que a outra ». O oposto é « menos … do que ».", "Igualdade com « tão … quanto »: « esse modelo é tão bom quanto o outro ».", "O extremo do grupo com « o/a mais … de »: « é o mais caro de todos ». Irregulares: bom → melhor, ruim → pior."), examples = listOf(ExampleLine(text = "Esse celular é mais barato do que aquele.", meaning = "mais … do que = más… que."), ExampleLine(text = "A garantia daqui é melhor do que a de lá.", meaning = "bom → melhor."), ExampleLine(text = "Esse modelo é tão bom quanto o outro.", meaning = "tão … quanto = tan… como."), ExampleLine(text = "É o mais caro de todos.", meaning = "O superlativo do grupo."), ExampleLine(text = "Prefiro a loja com mais garantia.", meaning = "preferir + comparação."))), expressions = listOf(TargetExpression(text = "mais … do que", meaning = "Comparar desigual.", note = "Mais barato do que aquele."), TargetExpression(text = "tão … quanto", meaning = "Comparar igual.", note = "Tão rápido quanto o meu."), TargetExpression(text = "o/a mais … de", meaning = "O extremo do grupo.", note = "A mais barata da loja."), TargetExpression(text = "melhor / pior", meaning = "Os irregulares.", note = "É a melhor opção."), TargetExpression(text = "Prefiro …", meaning = "Escolher comparando.", note = "Prefiro essa, custa menos.")), situation = "Duas lojas, um celular: a Duda compara preço, garantia e memória e escolhe a oferta mais equilibrada.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Compare as duas lojas de preço.", expected = listOf("Essa loja é mais barata do que a outra.", "essa loja e mais barata do que a outra", "Essa loja é mais barata que a outra.", "essa loja e mais barata que a outra"), focus = "mais … do que", watch = "do que ou que: as duas formas servem."), PracticeQuestion(prompt = "Diga o que acha da garantia daqui.", expected = listOf("A garantia daqui é melhor.", "a garantia daqui e melhor", "A garantia daqui é melhor do que a de lá.", "a garantia daqui e melhor do que a de la"), focus = "melhor", watch = "bom → melhor (irregular)."), PracticeQuestion(prompt = "Diga qual é o mais caro do grupo.", expected = listOf("Esse é o mais caro de todos.", "esse e o mais caro de todos"), focus = "superlativo", watch = "o mais + adjetivo + de todos."), PracticeQuestion(prompt = "Compare com igualdade: esse modelo e o outro, mesma qualidade.", expected = listOf("Esse modelo é tão bom quanto o outro.", "esse modelo e tao bom quanto o outro"), focus = "tão … quanto", watch = "tão … quanto = tan… como."), PracticeQuestion(prompt = "Diga que prefere a loja com mais garantia.", expected = listOf("Prefiro a loja com mais garantia.", "prefiro a loja com mais garantia"), focus = "preferir", watch = "prefiro + comparação."))), exercises = listOf(Exercise(id = "pt-foundations-u24-comparar-e1", kind = "choice", prompt = "Essa oferta é ___ barata do que a outra.", options = listOf("mais", "muito", "tanto", "melhor"), answers = listOf("mais"), explain = "mais + adjetivo + do que: a comparação de desigualdade."), Exercise(id = "pt-foundations-u24-comparar-e2", kind = "gap", prompt = "A garantia daqui é ___ do que a de lá. (bom)", options = listOf(), answers = listOf("melhor"), explain = "bom → melhor: o comparativo irregular."), Exercise(id = "pt-foundations-u24-comparar-e3", kind = "order", prompt = "Compare os dois celulares: esse é mais barato.", options = listOf(), answers = listOf("Esse celular é mais barato do que aquele"), explain = "mais barato do que aquele: compara entre dois."), Exercise(id = "pt-foundations-u24-comparar-e4", kind = "written", prompt = "Compare com igualdade: esse modelo e o outro têm a mesma qualidade.", options = listOf(), answers = listOf("Esse modelo é tão bom quanto o outro.", "esse modelo e tao bom quanto o outro"), explain = "tão + adjetivo + quanto: a igualdade comparativa.")), skills = listOf("grammar:comparatives", "function:go-shopping", "grammar:superlatives", "vocab:shopping"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:comparatives")),
    Lesson(id = "pt-foundations-u24-devolver", title = "Devolução e troca", goal = "Resolver a compra com problema: comprei…, apresentou defeito, quero a troca.", intro = LessonIntro(explanation = listOf("Explique o passado: « comprei na semana passada », « apresentou defeito ». O passado simples conta o problema.", "Traga a prova: « aqui está o recibo ». « Trouxe o recibo e a caixa ».", "Peça a solução: « quero trocar por outro igual », « prefiro o reembolso »."), examples = listOf(ExampleLine(text = "Comprei esse celular há uma semana.", meaning = "O passado simples conta a compra."), ExampleLine(text = "Ele apresentou defeito na câmera.", meaning = "defeito = defecto."), ExampleLine(text = "Aqui está o recibo da compra.", meaning = "recibo = recibo/ticket."), ExampleLine(text = "Quero trocar por outro igual, por favor.", meaning = "A troca clara."), ExampleLine(text = "Não tem outro ? Então prefiro o reembolso.", meaning = "reembolso = reembolso."))), expressions = listOf(TargetExpression(text = "Comprei … há …", meaning = "Compra passada + tempo.", note = "Comprei há uma semana."), TargetExpression(text = "Apresentou defeito", meaning = "O problema do produto.", note = "Apresentou defeito na tela."), TargetExpression(text = "Aqui está o recibo", meaning = "A prova da compra.", note = "Aqui está o recibo."), TargetExpression(text = "Quero trocar por …", meaning = "Pedir a troca.", note = "Trocar por outro igual."), TargetExpression(text = "Prefiro o reembolso", meaning = "O dinheiro de volta.", note = "Prefiro o reembolso, obrigada.")), situation = "No atendimento: a Duda explica que comprou o celular na semana passada, mostra o recibo e resolve a troca em cinco minutos.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga quando comprou: na semana passada.", expected = listOf("Comprei na semana passada.", "comprei na semana passada"), focus = "passado simples", watch = "comprei = compré."), PracticeQuestion(prompt = "Explique o problema: a câmera.", expected = listOf("Apresentou defeito na câmera.", "apresentou defeito na camera", "A câmera apresentou defeito.", "a camera apresentou defeito"), focus = "defeito", watch = "apresentar defeito = presentar defecto."), PracticeQuestion(prompt = "Mostre o recibo.", expected = listOf("Aqui está o recibo.", "aqui esta o recibo"), focus = "prova", watch = "recibo = recibo."), PracticeQuestion(prompt = "Peça a troca por outro igual.", expected = listOf("Quero trocar por outro igual.", "quero trocar por outro igual"), focus = "troca", watch = "igual = igual."), PracticeQuestion(prompt = "Diga que prefere o reembolso.", expected = listOf("Prefiro o reembolso.", "prefiro o reembolso"), focus = "reembolso", watch = "reembolso = reembolso."))), exercises = listOf(Exercise(id = "pt-foundations-u24-devolver-e1", kind = "choice", prompt = "___ esse celular há uma semana.", options = listOf("Comprei", "Compro", "Comprava", "Vou comprar"), answers = listOf("Comprei"), explain = "Comprei: passado simples, a compra terminada."), Exercise(id = "pt-foundations-u24-devolver-e2", kind = "gap", prompt = "Aqui está o ___ da compra.", options = listOf(), answers = listOf("recibo"), explain = "recibo: a prova oficial da compra."), Exercise(id = "pt-foundations-u24-devolver-e3", kind = "order", prompt = "Peça a troca por outro aparelho igual.", options = listOf(), answers = listOf("Quero trocar por outro igual"), explain = "Quero trocar por + igual: a troca mais simples."), Exercise(id = "pt-foundations-u24-devolver-e4", kind = "written", prompt = "Explique o problema no passado: a câmera.", options = listOf(), answers = listOf("Apresentou defeito na câmera.", "apresentou defeito na camera", "A câmera apresentou defeito.", "a camera apresentou defeito"), explain = "Apresentou defeito: o problema contado no passado.")), skills = listOf("function:solve-problems", "grammar:past-simple-regular", "function:make-requests", "vocab:shopping"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "pt-foundations-u24-parcelas", title = "Pagar parcelado", goal = "Falar de parcelas: em quantas vezes, sem juros, por isso…", intro = LessonIntro(explanation = listOf("Pergunte pelas parcelas: « posso parcelar em quantas vezes ? ». « parcelar » é dividir o pagamento.", "Conecte causa e decisão: « porque », « por isso », « então ». « É sem juros, por isso vou parcelar ».", "Feche a compra: « fechado ! », « vou levar ». « Então fechado, dez vezes sem juros »."), examples = listOf(ExampleLine(text = "Posso parcelar em quantas vezes ?", meaning = "parcelar = pagar en cuotas."), ExampleLine(text = "Em dez vezes sem juros.", meaning = "sem juros = sin intereses."), ExampleLine(text = "É sem juros, por isso vou parcelar.", meaning = "por isso = por eso."), ExampleLine(text = "O valor fica alto, então prefiro parcelar.", meaning = "então = entonces."), ExampleLine(text = "Fechado ! Vou levar assim mesmo.", meaning = "O sim da compra."))), expressions = listOf(TargetExpression(text = "Parcelar em … vezes", meaning = "Dividir o pagamento.", note = "Parcelar em dez vezes."), TargetExpression(text = "sem juros", meaning = "O que não aumenta.", note = "Em seis vezes sem juros."), TargetExpression(text = "por isso / então", meaning = "Conectar causa e decisão.", note = "Por isso, vou parcelar."), TargetExpression(text = "porque", meaning = "Explicar a razão.", note = "Porque o valor fica alto."), TargetExpression(text = "Fechado !", meaning = "Aceitar a oferta.", note = "Fechado, obrigado !")), situation = "No balcão: o vendedor oferece dez vezes sem juros, a Duda compara com o preço à vista e decide parcelar.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pergunte em quantas vezes pode parcelar.", expected = listOf("Posso parcelar em quantas vezes ?", "posso parcelar em quantas vezes", "Em quantas vezes posso parcelar ?", "em quantas vezes posso parcelar"), focus = "parcelar", watch = "em quantas vezes = ¿en cuántas cuotas ?"), PracticeQuestion(prompt = "Diga o parcelamento que a loja oferece.", expected = listOf("Em dez vezes sem juros.", "em dez vezes sem juros"), focus = "sem juros", watch = "sem juros = sin intereses."), PracticeQuestion(prompt = "Conecte: sem juros, por isso você parcela.", expected = listOf("É sem juros, por isso vou parcelar.", "e sem juros por isso vou parcelar"), focus = "por isso", watch = "por isso = por eso."), PracticeQuestion(prompt = "Diga que prefere parcelar porque o valor fica alto.", expected = listOf("O valor fica alto, então prefiro parcelar.", "o valor fica alto entao prefiro parcelar"), focus = "então", watch = "então = entonces."), PracticeQuestion(prompt = "Aceite a oferta com uma palavra.", expected = listOf("Fechado !", "fechado"), focus = "fechar", watch = "fechado = trato hecho."))), exercises = listOf(Exercise(id = "pt-foundations-u24-parcelas-e1", kind = "choice", prompt = "É sem juros, ___ vou parcelar em dez vezes.", options = listOf("por isso", "porque", "apesar", "embora"), answers = listOf("por isso"), explain = "por isso conecta a causa com a decisão: por eso."), Exercise(id = "pt-foundations-u24-parcelas-e2", kind = "gap", prompt = "Posso parcelar ___ quantas vezes ?", options = listOf(), answers = listOf("em"), explain = "parcelar em + número de vezes."), Exercise(id = "pt-foundations-u24-parcelas-e3", kind = "order", prompt = "Conclua a sua decisão de parcelar.", options = listOf(), answers = listOf("É sem juros por isso vou parcelar"), explain = "por isso + decisão: o conector no meio da frase."), Exercise(id = "pt-foundations-u24-parcelas-e4", kind = "written", prompt = "Pergunte ao vendedor sobre as parcelas.", options = listOf(), answers = listOf("Posso parcelar em quantas vezes ?", "posso parcelar em quantas vezes", "Em quantas vezes posso parcelar ?", "em quantas vezes posso parcelar"), explain = "Posso + verbo + em quantas vezes: a pergunta das cuotas.")), skills = listOf("function:go-shopping", "grammar:connectors", "vocab:shopping", "vocab:social-expressions"), canDo = listOf("go-shopping"), prerequisites = listOf("grammar:connectors"))))
}

object PtFoundationsU25 {
    val unit = CourseUnit(id = "pt-foundations-u25", title = "Prepare a viagem", subtitle = "Mala, reservas e véspera", level = "A2", themes = listOf(ConversationTheme("mala-documentos", "Mala e documentos", "Não esquecer nada", "suitcase", "Course", "A Duda faz a lista da viagem: a mala de mão primeiro, depois os documentos; o Téo lembra do carregador.", 0),
                ConversationTheme("reserva-vespera", "Reservar e esperar", "Do hotel ao portão", "airplane", "Course", "A Duda reserva o quarto e o voo de manhã e, na véspera, confere tudo de novo antes da despedida.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u25-mala", title = "A mala e os documentos", goal = "Falar dos planos de viagem: vou levar, não vou esquecer, primeiro… depois….", intro = LessonIntro(explanation = listOf("Planos com « ir + infinitivo »: « vou levar só uma mala ». A negativa é « não vou esquecer ».", "A lista segue uma ordem: « primeiro a mala, depois os documentos ».", "Peça ajuda para conferir: « você confere se falta algo ? »."), examples = listOf(ExampleLine(text = "Vou viajar na sexta de manhã.", meaning = "ir + infinitivo: o plano já decidido."), ExampleLine(text = "Vou levar só uma mala de mão.", meaning = "mala de mão = equipaje de mano."), ExampleLine(text = "Primeiro faço a mala, depois confiro os documentos.", meaning = "A ordem dos passos."), ExampleLine(text = "Não vou esquecer o carregador.", meaning = "A negativa do plano."), ExampleLine(text = "Você confere se falta algo ?", meaning = "O pedido de conferência."))), expressions = listOf(TargetExpression(text = "Vou + infinitivo", meaning = "O plano de viagem.", note = "Vou viajar na sexta."), TargetExpression(text = "Não vou esquecer …", meaning = "O que não pode faltar.", note = "Não vou esquecer o passaporte."), TargetExpression(text = "Primeiro …, depois …", meaning = "A ordem dos passos.", note = "Primeiro a mala, depois o resto."), TargetExpression(text = "mala de mão", meaning = "O que entra no avião.", note = "Só uma mala de mão."), TargetExpression(text = "Confere se … ?", meaning = "Pedir conferência.", note = "Confere se falta algo ?")), situation = "Em casa: a Duda monta a lista com o Téo — primeiro a mala, depois os documentos — e cada um confere o que não pode faltar.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga o que vai levar: uma mala de mão.", expected = listOf("Vou levar uma mala de mão.", "vou levar uma mala de mao"), focus = "ir + infinitivo", watch = "vou + infinitivo = voy a."), PracticeQuestion(prompt = "Diga o que não pode faltar: o passaporte.", expected = listOf("Não vou esquecer o passaporte.", "nao vou esquecer o passaporte"), focus = "negativa", watch = "não vou esquecer = no voy a olvidar."), PracticeQuestion(prompt = "Ordene: mala primeiro, documentos depois.", expected = listOf("Primeiro faço a mala, depois confiro os documentos.", "primeiro faco a mala depois confiro os documentos"), focus = "ordem", watch = "primeiro … depois … = primero… luego…."), PracticeQuestion(prompt = "Diga quando vai viajar: sexta de manhã.", expected = listOf("Vou viajar na sexta de manhã.", "vou viajar na sexta de manha"), focus = "quando", watch = "de manhã = por la mañana."), PracticeQuestion(prompt = "Peça para conferir se falta algo.", expected = listOf("Você confere se falta algo ?", "voce confere se falta algo"), focus = "conferir", watch = "conferir se = revisar si."))), exercises = listOf(Exercise(id = "pt-foundations-u25-mala-e1", kind = "choice", prompt = "Amanhã ___ conferir os documentos.", options = listOf("vou", "vai", "ir", "indo"), answers = listOf("vou"), explain = "Eu + vou + infinitivo: o plano já decidido."), Exercise(id = "pt-foundations-u25-mala-e2", kind = "gap", prompt = "Primeiro faço a mala, ___ confiro os documentos.", options = listOf(), answers = listOf("depois"), explain = "primeiro … depois …: a ordem dos passos."), Exercise(id = "pt-foundations-u25-mala-e3", kind = "order", prompt = "Diga que não vai esquecer o carregador.", options = listOf(), answers = listOf("Não vou esquecer o carregador"), explain = "não vou + infinitivo: a negativa do plano."), Exercise(id = "pt-foundations-u25-mala-e4", kind = "written", prompt = "Diga o que vai levar: só uma mala de mão.", options = listOf(), answers = listOf("Vou levar só uma mala de mão.", "vou levar so uma mala de mao", "Vou levar apenas uma mala de mão.", "vou levar apenas uma mala de mao"), explain = "Vou levar + só: a mala leve do avião.")), skills = listOf("grammar:going-to", "function:make-future-plans", "vocab:travel", "grammar:connectors"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "pt-foundations-u25-reservar", title = "Reservar hotel e voo", goal = "Reservar quarto e voo: quero reservar, ainda tem…, para duas pessoas.", intro = LessonIntro(explanation = listOf("Abra a reserva: « quero reservar um quarto ». « quero + infinitivo » é direto e educado.", "Pergunte pela vaga: « ainda tem quarto duplo ? », « tem voo de manhã ? ».", "Confirme os dados: « para duas pessoas », « com café incluído »."), examples = listOf(ExampleLine(text = "Quero reservar um quarto para duas noites.", meaning = "O pedido direto."), ExampleLine(text = "Ainda tem quarto duplo ?", meaning = "A pergunta da vaga."), ExampleLine(text = "Tem voo de manhã para Lisboa ?", meaning = "A pergunta do voo."), ExampleLine(text = "Para duas pessoas, com café incluído.", meaning = "incluído = incluido."), ExampleLine(text = "Reservado ! Chegamos sexta à noite.", meaning = "A confirmação."))), expressions = listOf(TargetExpression(text = "Quero reservar …", meaning = "Abrir a reserva.", note = "Quero reservar um quarto."), TargetExpression(text = "Ainda tem … ?", meaning = "Perguntar a vaga.", note = "Ainda tem vaga de manhã ?"), TargetExpression(text = "Para … pessoas / noites", meaning = "Os dados da reserva.", note = "Para duas pessoas."), TargetExpression(text = "Com café incluído", meaning = "O que já está no preço.", note = "Quarto com café incluído."), TargetExpression(text = "Reservado / confirmado", meaning = "A confirmação.", note = "Está confirmado !")), situation = "No telefone: a Duda reserva o quarto duplo com café e escolhe o voo da manhã; o Téo confirma tudo pelo aplicativo.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Reserve um quarto para duas noites.", expected = listOf("Quero reservar um quarto para duas noites.", "quero reservar um quarto para duas noites"), focus = "reservar", watch = "quero + infinitivo."), PracticeQuestion(prompt = "Pergunte pela vaga do quarto duplo.", expected = listOf("Ainda tem quarto duplo ?", "ainda tem quarto duplo"), focus = "vaga", watch = "ainda = todavía."), PracticeQuestion(prompt = "Pergunte por voo de manhã.", expected = listOf("Tem voo de manhã ?", "tem voo de manha", "Tem voo de manhã para Lisboa ?", "tem voo de manha para lisboa"), focus = "voo", watch = "voo = vuelo."), PracticeQuestion(prompt = "Especifique: duas pessoas, com café.", expected = listOf("Para duas pessoas, com café.", "para duas pessoas com cafe", "Para duas pessoas, com café incluído.", "para duas pessoas com cafe incluido"), focus = "dados", watch = "incluído = incluido."), PracticeQuestion(prompt = "Confirme a reserva.", expected = listOf("Reservado !", "reservado", "Confirmado !", "confirmado"), focus = "confirmação", watch = "confirmado = confirmado."))), exercises = listOf(Exercise(id = "pt-foundations-u25-reservar-e1", kind = "choice", prompt = "Quero ___ um quarto para duas noites.", options = listOf("reservar", "reservo", "reservado", "reserva"), answers = listOf("reservar"), explain = "quero + infinitivo: o pedido da reserva."), Exercise(id = "pt-foundations-u25-reservar-e2", kind = "gap", prompt = "___ tem quarto duplo ?", options = listOf(), answers = listOf("Ainda", "ainda"), explain = "ainda tem … ?: perguntar se há vaga."), Exercise(id = "pt-foundations-u25-reservar-e3", kind = "order", prompt = "Pergunte por voo de manhã.", options = listOf(), answers = listOf("Tem voo de manhã"), explain = "tem + voo + hora: a pergunta simples do voo."), Exercise(id = "pt-foundations-u25-reservar-e4", kind = "written", prompt = "Peça o quarto: duas pessoas e café.", options = listOf(), answers = listOf("Um quarto para duas pessoas, com café.", "um quarto para duas pessoas com cafe", "Quero um quarto para duas pessoas com café.", "quero um quarto para duas pessoas com cafe"), explain = "Peça + dados: quarto, pessoas e café.")), skills = listOf("function:make-requests", "grammar:going-to", "vocab:travel", "vocab:transport"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "pt-foundations-u25-vespera", title = "Na véspera", goal = "A véspera da viagem: conferir tudo e despedir-se com boa viagem.", intro = LessonIntro(explanation = listOf("Conferir item por item: « confiro se a mala está pronta ». O « se » liga o verbo à dúvida.", "O último plano: « amanhã vou sair cedo, o voo é às sete ».", "Despeça quem viaja: « boa viagem ! », « me avise quando chegar »."), examples = listOf(ExampleLine(text = "Confiro se está tudo pronto.", meaning = "conferir se = revisar si…."), ExampleLine(text = "A mala está pronta e os documentos também.", meaning = "pronto = listo."), ExampleLine(text = "Amanhã vou sair cedo, o voo é às sete.", meaning = "cedo = temprano."), ExampleLine(text = "Boa viagem ! Me avise quando chegar.", meaning = "A despedida do amigo."), ExampleLine(text = "Descansa, amanhã o dia é longo.", meaning = "A frase da véspera."))), expressions = listOf(TargetExpression(text = "Confiro se …", meaning = "Conferir cada item.", note = "Confiro se fecho a porta."), TargetExpression(text = "estar pronto(a)", meaning = "Tudo preparado.", note = "A mala já está pronta."), TargetExpression(text = "sair cedo", meaning = "Sair temprano.", note = "Amanhã vou sair cedo."), TargetExpression(text = "Boa viagem !", meaning = "Despedir quem viaja.", note = "Boa viagem, Bia !"), TargetExpression(text = "Me avise quando chegar", meaning = "Pedir notícia.", note = "Me avise quando chegar !")), situation = "Na véspera: a Duda confere a lista com o Téo, diz que vai sair cedo e recebe a despedida com boa viagem.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga que confere se está tudo pronto.", expected = listOf("Confiro se está tudo pronto.", "confiro se esta tudo pronto"), focus = "conferir se", watch = "se = si."), PracticeQuestion(prompt = "Confirme o item da mala.", expected = listOf("A mala está pronta.", "a mala esta pronta"), focus = "pronto", watch = "pronto = listo."), PracticeQuestion(prompt = "Diga que amanhã vai sair cedo.", expected = listOf("Amanhã vou sair cedo.", "amanha vou sair cedo"), focus = "cedo", watch = "cedo = temprano."), PracticeQuestion(prompt = "Despeça-se de quem viaja.", expected = listOf("Boa viagem !", "boa viagem"), focus = "despedida", watch = "boa viagem = buen viaje."), PracticeQuestion(prompt = "Peça para avisar quando chegar.", expected = listOf("Me avise quando chegar.", "me avise quando chegar"), focus = "avisar", watch = "me avise = avísame."))), exercises = listOf(Exercise(id = "pt-foundations-u25-vespera-e1", kind = "choice", prompt = "___ viagem ! Me avise quando chegar.", options = listOf("Boa", "Bom", "Boas", "Melhor"), answers = listOf("Boa"), explain = "boa viagem: a despedida fixa para quem viaja."), Exercise(id = "pt-foundations-u25-vespera-e2", kind = "gap", prompt = "Confiro ___ a mala está pronta.", options = listOf(), answers = listOf("se"), explain = "conferir se + oração: verificar si…."), Exercise(id = "pt-foundations-u25-vespera-e3", kind = "order", prompt = "Peça para avisar quando chegar.", options = listOf(), answers = listOf("Me avise quando chegar"), explain = "me avise quando + evento: o pedido da despedida."), Exercise(id = "pt-foundations-u25-vespera-e4", kind = "written", prompt = "Diga que amanhã vai sair cedo, porque o voo é às sete.", options = listOf(), answers = listOf("Amanhã vou sair cedo, o voo é às sete.", "amanha vou sair cedo o voo e as sete", "Vou sair cedo, o voo é às sete.", "vou sair cedo o voo e as sete"), explain = "Plano + motivo: a frase completa da véspera.")), skills = listOf("grammar:connectors", "grammar:going-to", "function:make-future-plans", "vocab:travel"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:going-to")),
    Lesson(id = "pt-foundations-u25-aeroporto", title = "No balcão do aeroporto", goal = "Fazer o check-in: despachar a mala, escolher assento e achar o portão de embarque.", intro = LessonIntro(explanation = listOf("No balcão, o funcionário pergunta: « despacha alguma bagagem ? ». Responda com « só esta mala » ou « duas, para despachar ».", "Escolha o assento: « janela, por favor », « prefiro corredor ». Depois, o lugar fica perto do portão de embarque.", "Confirme o portão e a hora: « de qual portão sai o voo ? », « o embarque é às nove, certo ? »."), examples = listOf(ExampleLine(text = "Bom dia, quero fazer o check-in.", meaning = "começar o atendimento."), ExampleLine(text = "Despacho esta mala, por favor.", meaning = "a mala que vai no porão."), ExampleLine(text = "Prefiro assento de janela.", meaning = "a escolha do lugar."), ExampleLine(text = "De qual portão sai o voo ?", meaning = "a pergunta do portão."), ExampleLine(text = "O embarque é às nove, certo ?", meaning = "confirmar a hora."))), expressions = listOf(TargetExpression(text = "fazer o check-in", meaning = "O registro do voo.", note = "Quero fazer o check-in."), TargetExpression(text = "despachar a bagagem", meaning = "Mandar a mala ao porão.", note = "Só uma mala para despachar."), TargetExpression(text = "assento de janela / corredor", meaning = "A escolha do lugar.", note = "Assento de corredor, por favor."), TargetExpression(text = "de qual portão… ?", meaning = "Achar o portão de embarque.", note = "De qual portão sai o voo ?"), TargetExpression(text = "cartão de embarque", meaning = "O bilhete do voo.", note = "Aqui está o seu cartão de embarque.")), situation = "No balcão do aeroporto: a Duda despacha a mala, escolhe assento de janela, recebe o cartão de embarque e confere o portão e a hora do embarque com o funcionário.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga que quer fazer o check-in.", expected = listOf("Quero fazer o check-in.", "quero fazer o check in"), focus = "check-in", watch = "check-in = el check-in (igual)."), PracticeQuestion(prompt = "Diga que despacha uma mala.", expected = listOf("Despacho uma mala, por favor.", "despacho uma mala por favor"), focus = "despachar", watch = "despachar = facturar (la maleta)."), PracticeQuestion(prompt = "Escolha o assento: janela.", expected = listOf("Prefiro assento de janela.", "prefiro assento de janela"), focus = "assento", watch = "assento = asiento; janela = ventanilla."), PracticeQuestion(prompt = "Pergunte o portão de saída do voo.", expected = listOf("De qual portão sai o voo ?", "de qual portao sai o voo"), focus = "portão", watch = "portão de embarque = puerta de embarque."), PracticeQuestion(prompt = "Confirme a hora: embarque às nove.", expected = listOf("O embarque é às nove, certo ?", "o embarque e as nove certo"), focus = "confirmação", watch = "…, certo ? = ¿verdad?"))), exercises = listOf(Exercise(id = "pt-foundations-u25-aeroporto-e1", kind = "choice", prompt = "Eu quero ___ esta mala, por favor.", options = listOf("despachar", "despacho", "despachando", "despachou"), answers = listOf("despachar"), explain = "quero + infinitivo: o pedido do check-in."), Exercise(id = "pt-foundations-u25-aeroporto-e2", kind = "gap", prompt = "Prefiro assento ___ janela.", options = listOf(), answers = listOf("de"), explain = "assento de janela = asiento de ventanilla."), Exercise(id = "pt-foundations-u25-aeroporto-e3", kind = "order", prompt = "Pergunte o portão de saída do voo.", options = listOf(), answers = listOf("De qual portão sai o voo"), explain = "de qual + substantivo: a pergunta do portão de embarque."), Exercise(id = "pt-foundations-u25-aeroporto-e4", kind = "written", prompt = "Diga o que você recebe do funcionário para embarcar.", options = listOf(), answers = listOf("O cartão de embarque.", "o cartao de embarque", "Recebo o cartão de embarque."), explain = "o cartão de embarque = la tarjeta de embarque: sem ele, não embarca.")), skills = listOf("grammar:present-questions", "function:make-requests", "vocab:transport", "grammar:quantities"), canDo = listOf("use-transport"), prerequisites = listOf("grammar:present-questions"))))
}

object PtFoundationsU28 {
    val unit = CourseUnit(id = "pt-foundations-u28", title = "Imprevistos de viagem", subtitle = "Quando o plano muda", level = "A2", themes = listOf(ConversationTheme("imprevisto-caminho", "O imprevisto", "Voo e mala", "clock.arrow.circlepath", "Course", "No aeroporto, o voo da Duda e do Téo atrasa e a mala dela não aparece na esteira; os dois resolvem um problema de cada vez, sem pressa.", 0),
                ConversationTheme("resolver-balcao", "Resolver no balcão", "Pedidos e trocas", "phone.badge.checkmark", "Course", "No balcão da companhia e por telefone com o hotel, eles registram a mala perdida e mudam a reserva de data sem estresse.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u28-atraso", title = "O voo atrasou", goal = "Entender e reagir a um atraso: perguntar o motivo, a nova hora e o que fazer agora.", intro = LessonIntro(explanation = listOf("Para o motivo, use « porque »: « o voo atrasou porque chove muito ». Para o resultado, « por isso »: « choveu, por isso o voo atrasou ».", "Pergunte a nova hora com « a que horas… ? »: « A que horas sai o novo voo ? ».", "Peça a solução com « podemos… ? »: « Podemos trocar o voo ? »."), examples = listOf(ExampleLine(text = "O voo atrasou porque chove forte.", meaning = "porque: o motivo do atraso."), ExampleLine(text = "Chove forte, por isso o voo atrasou.", meaning = "por isso: o resultado."), ExampleLine(text = "A que horas sai o novo voo ?", meaning = "a pergunta da nova hora."), ExampleLine(text = "Podemos trocar o voo de amanhã ?", meaning = "o pedido da troca."), ExampleLine(text = "Então vamos esperar no portão.", meaning = "então: a conclusão calma."))), expressions = listOf(TargetExpression(text = "O voo atrasou.", meaning = "O avião sai mais tarde.", note = "Meu voo atrasou duas horas."), TargetExpression(text = "porque … / por isso …", meaning = "O motivo e o resultado.", note = "Atrasou porque chove; por isso vou esperar."), TargetExpression(text = "A que horas … ?", meaning = "Perguntar a hora exata.", note = "A que horas sai o novo voo ?"), TargetExpression(text = "Podemos trocar … ?", meaning = "Pedir a mudança.", note = "Podemos trocar o assento ?"), TargetExpression(text = "Não tem problema.", meaning = "Acalmar: está tudo bem assim.", note = "Uma hora a mais, não tem problema.")), situation = "No portão de embarque: o telão anuncia atraso, a Duda pergunta o motivo e a nova hora, e os dois decidem esperar tranquilos no aeroporto.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Informe o tamanho do atraso: duas horas.", expected = listOf("O voo atrasou duas horas.", "o voo atrasou duas horas"), focus = "atraso", watch = "atrasar = retrasarse."), PracticeQuestion(prompt = "Diga o motivo: chove muito hoje.", expected = listOf("O voo atrasou porque chove muito hoje.", "o voo atrasou porque chove muito hoje"), focus = "porque", watch = "porque = porque (el motivo)."), PracticeQuestion(prompt = "Pergunte a hora de saída do novo voo.", expected = listOf("A que horas sai o novo voo ?", "a que horas sai o novo voo"), focus = "a que horas", watch = "a que horas = ¿a qué horas?"), PracticeQuestion(prompt = "Peça a troca do voo ao atendente.", expected = listOf("Podemos trocar o voo ?", "podemos trocar o voo"), focus = "pedido", watch = "podemos + infinitivo = pedido direto."), PracticeQuestion(prompt = "Mostre calma diante do atraso.", expected = listOf("Não tem problema.", "nao tem problema"), focus = "acalmar", watch = "não tem problema = no hay problema."))), exercises = listOf(Exercise(id = "pt-foundations-u28-atraso-e1", kind = "choice", prompt = "O voo atrasou ___ chove muito na cidade.", options = listOf("porque", "por isso", "então", "mas"), answers = listOf("porque"), explain = "« porque » apresenta o motivo do atraso."), Exercise(id = "pt-foundations-u28-atraso-e2", kind = "gap", prompt = "Chove muito, ___ o voo atrasou.", options = listOf(), answers = listOf("por isso"), explain = "por isso = por eso: o resultado do motivo."), Exercise(id = "pt-foundations-u28-atraso-e3", kind = "order", prompt = "Pergunte a hora de saída do novo voo.", options = listOf(), answers = listOf("A que horas sai o novo voo"), explain = "a que horas + verbo: a pergunta da hora exata."), Exercise(id = "pt-foundations-u28-atraso-e4", kind = "written", prompt = "Peça ao atendente a troca do voo, com « podemos… ? ».", options = listOf(), answers = listOf("Podemos trocar o voo ?", "podemos trocar o voo", "Podemos trocar o voo de amanhã ?", "podemos trocar o voo de amanha"), explain = "Podemos + infinitivo: o pedido educado no balcão.")), skills = listOf("grammar:connectors", "grammar:present-questions", "function:solve-problems", "vocab:transport"), canDo = listOf("use-transport"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "pt-foundations-u28-mala", title = "A mala não chegou", goal = "Comunicar a perda da mala e descrever ela para o registro no balcão.", intro = LessonIntro(explanation = listOf("Conte o problema no passado: « a mala não chegou », « a esteira parou ».", "Descreva a mala para acharem: « é azul, de quatro rodas, com uma fita amarela ».", "Feche com o combinado: « registram o pedido ? », « entregam no hotel quando chegar ? »."), examples = listOf(ExampleLine(text = "Minha mala não chegou na esteira.", meaning = "o problema no passado."), ExampleLine(text = "Ela é azul, média, de quatro rodas.", meaning = "a descrição da mala."), ExampleLine(text = "Tem uma fita amarela na alça.", meaning = "um detalhe que ajuda a achar."), ExampleLine(text = "Você pode registrar o pedido agora ?", meaning = "o pedido do registro."), ExampleLine(text = "Entregam no hotel quando chegar ?", meaning = "o combinado da entrega."))), expressions = listOf(TargetExpression(text = "A mala não chegou.", meaning = "A mala sumiu no voo.", note = "Minha mala não chegou."), TargetExpression(text = "É azul, de roda…", meaning = "Descrever para achar.", note = "É preta, pequena, de duas rodas."), TargetExpression(text = "Registrar o pedido", meaning = "Abrir a ocorrência.", note = "Posso registrar o pedido aqui ?"), TargetExpression(text = "quando chegar", meaning = "A condição da entrega.", note = "Liguem quando chegar, por favor."), TargetExpression(text = "entrega no hotel", meaning = "Onde receber a mala.", note = "A entrega é no hotel, está bem ?")), situation = "Na esteira de bagagens: a esteira para, a mala da Duda não aparece; no balcão ela descreve a mala, registra o pedido e combina a entrega no hotel.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga que a sua mala não chegou.", expected = listOf("Minha mala não chegou.", "minha mala nao chegou"), focus = "problema", watch = "chegar = llegar (a mala não chegou)."), PracticeQuestion(prompt = "Descreva a mala: azul e grande.", expected = listOf("Ela é azul e grande.", "ela e azul e grande", "É azul e grande, de quatro rodas."), focus = "descrição", watch = "é + cor/tamanho = la descripción."), PracticeQuestion(prompt = "Peça para registrar o pedido.", expected = listOf("Você pode registrar o pedido ?", "voce pode registrar o pedido"), focus = "registro", watch = "registrar o pedido = registrar la ocurrencia."), PracticeQuestion(prompt = "Peça para avisarem quando a mala chegar.", expected = listOf("Ligam quando chegar ?", "ligam quando chegar"), focus = "quando", watch = "quando chegar = cuando llegue."), PracticeQuestion(prompt = "Diga que quer receber a mala no hotel.", expected = listOf("Quero a entrega no hotel.", "quero a entrega no hotel"), focus = "entrega", watch = "entrega no hotel = entrega en el hotel."))), exercises = listOf(Exercise(id = "pt-foundations-u28-mala-e1", kind = "choice", prompt = "Minha mala não ___ na esteira.", options = listOf("chegou", "chega", "chegava", "chegando"), answers = listOf("chegou"), explain = "Passado do verbo chegar: a mala não chegou na esteira."), Exercise(id = "pt-foundations-u28-mala-e2", kind = "gap", prompt = "Ela é azul, ___ quatro rodas.", options = listOf(), answers = listOf("de"), explain = "de + característica: mala de quatro rodas."), Exercise(id = "pt-foundations-u28-mala-e3", kind = "order", prompt = "Peça para avisarem quando a mala chegar.", options = listOf(), answers = listOf("Ligam quando chegar, por favor"), explain = "quando + chegar: a condição do contato."), Exercise(id = "pt-foundations-u28-mala-e4", kind = "written", prompt = "Descreva a mala perdida: a cor e um detalhe.", options = listOf(), answers = listOf("Ela é azul, com fita amarela.", "ela e azul com fita amarela", "É azul e tem uma fita amarela na alça.", "e azul e tem uma fita amarela"), explain = "É + cor + com + detalhe: a descrição que ajuda a achar a mala.")), skills = listOf("grammar:past-simple-regular", "function:solve-problems", "vocab:travel", "grammar:connectors"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "pt-foundations-u28-reserva", title = "Mudar a reserva", goal = "Pedir uma mudança de reserva por telefone: data, quarto e confirmação.", intro = LessonIntro(explanation = listOf("Abra o pedido com « queria » ou « posso »: « queria mudar a reserva », « posso mudar para sexta ? ».", "Diga a mudança clara: « de quarta para sexta », « um quarto duplo, com café ».", "Confirme no fim: « então está confirmado para sexta, certo ? »."), examples = listOf(ExampleLine(text = "Queria mudar a minha reserva.", meaning = "queria: o pedido educado."), ExampleLine(text = "Posso mudar de quarta para sexta ?", meaning = "a troca de data."), ExampleLine(text = "Prefiro um quarto duplo, com café.", meaning = "a preferência clara."), ExampleLine(text = "Tem custo extra pela mudança ?", meaning = "a pergunta do preço."), ExampleLine(text = "Então está confirmado para sexta, certo ?", meaning = "a confirmação final."))), expressions = listOf(TargetExpression(text = "Queria mudar …", meaning = "O pedido educado ao telefone.", note = "Queria mudar a reserva."), TargetExpression(text = "de … para …", meaning = "A mudança de data.", note = "De quarta para sexta, por favor."), TargetExpression(text = "Tem custo extra ?", meaning = "Perguntar o preço da troca.", note = "Tem custo extra pela mudança ?"), TargetExpression(text = "Está confirmado ?", meaning = "Confirmar de novo.", note = "A nova data está confirmada ?"), TargetExpression(text = "no meu nome", meaning = "A reserva em seu nome.", note = "Está no nome de Téo Prado.")), situation = "Por telefone com o hotel: a Duda pede para mudar a reserva — de quarta para sexta, quarto duplo — pergunta pelo custo e repete os dados para confirmar.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Peça, educado, para mudar a reserva.", expected = listOf("Queria mudar a minha reserva.", "queria mudar a minha reserva"), focus = "queria", watch = "queria = quisiera (el pedido educado)."), PracticeQuestion(prompt = "Peça a troca de data: quarta vira sexta.", expected = listOf("Posso mudar de quarta para sexta ?", "posso mudar de quarta para sexta"), focus = "de… para…", watch = "de … para … = de… para (la fecha)."), PracticeQuestion(prompt = "Pergunte se a mudança custa algo.", expected = listOf("Tem custo extra ?", "tem custo extra"), focus = "custo", watch = "custo extra = costo extra."), PracticeQuestion(prompt = "Confirme a nova data com o atendente.", expected = listOf("Está confirmado para sexta, certo ?", "esta confirmado para sexta certo"), focus = "confirmar", watch = "…, certo ? = ¿verdad? (repite para garantir)."), PracticeQuestion(prompt = "Diga que a reserva está no seu nome.", expected = listOf("A reserva está no meu nome.", "a reserva esta no meu nome"), focus = "nome", watch = "no meu nome = a mi nombre."))), exercises = listOf(Exercise(id = "pt-foundations-u28-reserva-e1", kind = "choice", prompt = "___ mudar a minha reserva, por favor.", options = listOf("Queria", "Quer", "Mudar", "Mudando"), answers = listOf("Queria"), explain = "Queria + infinitivo: o pedido educado ao telefone."), Exercise(id = "pt-foundations-u28-reserva-e2", kind = "gap", prompt = "De quarta ___ sexta, por favor.", options = listOf(), answers = listOf("para"), explain = "de … para …: a mudança de data."), Exercise(id = "pt-foundations-u28-reserva-e3", kind = "order", prompt = "Pergunte se a mudança custa algo.", options = listOf(), answers = listOf("Tem custo extra pela mudança"), explain = "tem custo… ?: a pergunta do preço antes de aceitar."), Exercise(id = "pt-foundations-u28-reserva-e4", kind = "written", prompt = "Confirme a sexta, pedindo certeza ao atendente.", options = listOf(), answers = listOf("Está confirmado para sexta, certo ?", "esta confirmado para sexta certo", "Está confirmada para sexta ?"), explain = "« …, certo ? » pede um sim: a confirmação final da reserva.")), skills = listOf("grammar:can", "function:make-requests", "vocab:travel", "grammar:connectors"), canDo = listOf("make-future-plans"), prerequisites = listOf("grammar:can"))))
}

object PtFoundationsU6 {
    val unit = CourseUnit(id = "pt-foundations-u6", title = "Experiências e mudanças", subtitle = "Já ou nunca", level = "B1", themes = listOf(ConversationTheme("pt-b1-viagem", "A viagem inesquecível", "Já visto", "airplane", "Course", "Vocês falam de viagens e primeiras vezes: já foi, nunca viu, e uma história inesquecível.", 0),
                ConversationTheme("pt-b1-mudanca", "A mudança de vida", "Antes / agora", "arrow-up-forward", "Course", "Vocês comparam a vida de antes e de hoje e explicam o que mudou.", 1)), lessons = listOf(    Lesson(id = "pt-b1-experiencias", title = "Você já fez ?", goal = "Contar experiências com o pretérito perfeito e já/nunca.", intro = LessonIntro(explanation = listOf("A experiência: « Você já foi a Lisboa ? » — « Sim, fui no ano passado. »", "já = pelo menos uma vez. « Já provei essa paella ». nunca = zero vezes. « Nunca esquiei ».", "Os particípios irregulares voltam: « vi », « fiz », « fui »."), examples = listOf(ExampleLine(text = "Você já foi a Lisboa ?", meaning = "Pergunta de experiência."), ExampleLine(text = "Nunca esqueei.", meaning = "nunca = zero vezes."), ExampleLine(text = "Já provei a paella.", meaning = "já = uma vez."), ExampleLine(text = "Foi a primeira vez.", meaning = "Primeira vez."), ExampleLine(text = "O que você fez lá ?", meaning = "Aprofundar."))), expressions = listOf(TargetExpression(text = "Você já + pretérito ?", meaning = "Experiência.", note = "Você já foi a Roma ?"), TargetExpression(text = "nunca + verbo", meaning = "nunca.", note = "Nunca vi isso."), TargetExpression(text = "vi / fiz / fui", meaning = "Particípios-chave.", note = "ver→vi, fazer→fiz."), TargetExpression(text = "a primeira vez que…", meaning = "Primeira vez.", note = "Foi a primeira vez que…"), TargetExpression(text = "e você ?", meaning = "Devolver a pergunta.", note = "E você, já… ?")), situation = "Vocês falam de viagens: quem já pegou avião, quem nunca acampou, e uma primeira vez inesquecível.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pergunte se seu amigo já foi a Lisboa.", expected = listOf("Você já foi a Lisboa ?"), focus = "já + pretérito", watch = "Você já foi… ?"), PracticeQuestion(prompt = "Diga que nunca esqueeu.", expected = listOf("Nunca esqueei.", "Eu nunca esqueei."), focus = "nunca", watch = "nunca + pretérito."), PracticeQuestion(prompt = "Diga que já provou a paella.", expected = listOf("Já provei a paella."), focus = "já", watch = "Já + pretérito."), PracticeQuestion(prompt = "Diga que foi a sua primeira vez.", expected = listOf("Foi a minha primeira vez.", "Foi a primeira vez."), focus = "primeira vez", watch = "foi + primeira vez."), PracticeQuestion(prompt = "Devolva a pergunta: e você ?", expected = listOf("E você ?", "E você, já surfou ?"), focus = "e você", watch = "e você devolve."))), exercises = listOf(Exercise(id = "pt-b1-experiencias-e1", kind = "choice", prompt = "Você já ___ a Roma ?", options = listOf("foi", "vou", "ia", "vai"), answers = listOf("foi"), explain = "ir → foi (pretérito)."), Exercise(id = "pt-b1-experiencias-e2", kind = "gap", prompt = "___ esqueei. (nunca)", options = listOf(), answers = listOf("nunca"), explain = "nunca + pretérito."), Exercise(id = "pt-b1-experiencias-e3", kind = "order", prompt = "Pergunte a experiência: você já comeu caracóis ?", options = listOf(), answers = listOf("Você já comeu caracóis"), explain = "Você já + pretérito + objeto ?"), Exercise(id = "pt-b1-experiencias-e4", kind = "written", prompt = "Diga uma experiência: você já viu esse filme.", options = listOf(), answers = listOf("ja vi esse filme", "já vi esse filme"), explain = "Já + vi (ver → vi).")), skills = listOf("grammar:present-perfect", "grammar:past-simple-irregular", "function:describe-past-events"), canDo = listOf("describe-past-events"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "pt-b1-antes-ahora", title = "Antes e agora", goal = "Contrastar passado e presente com o imperfeito e conectivos.", intro = LessonIntro(explanation = listOf("O imperfeito pinta o passado habitual: « Antes eu morava na cidade ».", "O contraste: « Antes… agora… ». « Antes eu fumava, agora corro ».", "Os conectivos: « mas », « porque », « então ». « Era cansativo, então me mudei »."), examples = listOf(ExampleLine(text = "Antes eu morava na cidade.", meaning = "imperfeito do passado."), ExampleLine(text = "Agora moro no interior.", meaning = "presente em contraste."), ExampleLine(text = "Antes eu fumava, agora corro.", meaning = "Mudança de vida."), ExampleLine(text = "Era cansativo, então me mudei.", meaning = "então = consequência."), ExampleLine(text = "Prefiro a vida de agora, porque…", meaning = "porque = causa."))), expressions = listOf(TargetExpression(text = "Antes, eu …-ava/-ia", meaning = "imperfeito.", note = "morava, fazia."), TargetExpression(text = "agora, eu …", meaning = "presente.", note = "agora moro…"), TargetExpression(text = "mas / porque / então", meaning = "Conectivos.", note = "mas = contraste."), TargetExpression(text = "prefiro …", meaning = "Opinião.", note = "prefiro a vida…"), TargetExpression(text = "Era + adjetivo", meaning = "Quadro no passado.", note = "Era tranquilo.")), situation = "Vocês comparam a vida de antes e de hoje: cidade e interior, trabalho e lazer, e por que mudaram.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga que antes você morava na cidade.", expected = listOf("Antes eu morava na cidade.", "Antes, eu morava na cidade."), focus = "imperfeito", watch = "-ava: morava."), PracticeQuestion(prompt = "Diga que agora você mora no interior.", expected = listOf("Agora moro no interior."), focus = "agora", watch = "presente para agora."), PracticeQuestion(prompt = "Contraste: antes você fumava, agora corre.", expected = listOf("Antes eu fumava agora corro.", "Antes eu fumava, agora corro."), focus = "antes/agora", watch = "dois tempos opostos."), PracticeQuestion(prompt = "Dê a consequência: era cansativo, então você se mudou.", expected = listOf("Era cansativo então me mudei.", "Era cansativo, então me mudei."), focus = "então", watch = "então + consequência."), PracticeQuestion(prompt = "Diga o que prefere e por quê.", expected = listOf("Prefiro a vida de agora porque sou mais livre.", "Prefiro a vida de agora."), focus = "porque", watch = "porque + causa."))), exercises = listOf(Exercise(id = "pt-b1-antes-ahora-e1", kind = "choice", prompt = "Antes, eu ___ na cidade. (morar, imperfeito)", options = listOf("morava", "moro", "morei", "morarei"), answers = listOf("morava"), explain = "imperfeito: -ava."), Exercise(id = "pt-b1-antes-ahora-e2", kind = "gap", prompt = "Era cansativo, ___ me mudei. (consequência)", options = listOf(), answers = listOf("então"), explain = "então = consequência."), Exercise(id = "pt-b1-antes-ahora-e3", kind = "order", prompt = "Contraste: antes você fumava, agora corre.", options = listOf(), answers = listOf("Antes eu fumava agora corro"), explain = "antes + imperfeito, agora + presente."), Exercise(id = "pt-b1-antes-ahora-e4", kind = "written", prompt = "Diga o que mudou: agora você trabalha de casa.", options = listOf(), answers = listOf("agora trabalho de casa", "agora trabalho em casa"), explain = "agora + presente.")), skills = listOf("grammar:used-to", "grammar:connectors", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:used-to"))))
}

object PtFoundationsU18 {
    val unit = CourseUnit(id = "pt-foundations-u18", title = "Contar histórias", subtitle = "O passado em ação", level = "B1", themes = listOf(ConversationTheme("contar-passado", "O que aconteceu", "Fatos em ordem", "book", "Course", "Vocês contam o que aconteceu no fim de semana: primeiro, depois, no fim — com aqueles pretéritos irregulares.", 0),
                ConversationTheme("virada-surpresa", "A virada", "Surpresa e reação", "sparkles", "Course", "Uma história com virada: de repente tudo muda, e os amigos reagem — não me diga !", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u18-narrar", title = "O que aconteceu", goal = "Ligar fatos do passado: primeiro, depois, no fim.", intro = LessonIntro(explanation = listOf("Para ordenar a história: « primeiro… depois… no fim… ». « Primeiro peguei o ônibus, depois perdi a carteira, no fim cheguei atrasado ».", "Os irregulares aparecem o tempo todo: « fui », « vi », « fiz », « disse ». « Fui à praia e vi um golfinho ».", "Os regulares terminam em -ei/-ou/-amos: « falei », « morou », « chegamos ». « Chegamos cedo e conversamos muito »."), examples = listOf(ExampleLine(text = "Primeiro, tomei café da manhã.", meaning = "Ordem: primeiro."), ExampleLine(text = "Depois, fui ao trabalho.", meaning = "ir → fui."), ExampleLine(text = "No fim, dei uma volta no parque.", meaning = "dar → dei."), ExampleLine(text = "Vi uma cena estranha.", meaning = "ver → vi."), ExampleLine(text = "Fiz tudo que planejei.", meaning = "fazer → fiz."))), expressions = listOf(TargetExpression(text = "primeiro …", meaning = "O primeiro fato.", note = "Primeiro, acordei cedo."), TargetExpression(text = "depois …", meaning = "A sequência.", note = "Depois, saí de casa."), TargetExpression(text = "no fim …", meaning = "O resultado.", note = "No fim, deu tudo certo."), TargetExpression(text = "fui / vi / fiz / disse", meaning = "Irregulares-chave.", note = "Fui, vi e voltei."), TargetExpression(text = "deu tudo certo", meaning = "Resultado positivo.", note = "No fim, deu tudo certo.")), situation = "Na segunda-feira, cada um conta o fim de semana: o que fez primeiro, o que veio depois e como terminou.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Comece a história: acordei cedo. (primeiro)", expected = listOf("Primeiro, acordei cedo.", "Primeiro acordei cedo"), focus = "primeiro", watch = "primeiro abre a ordem."), PracticeQuestion(prompt = "Ligue com depois: você foi ao mercado.", expected = listOf("Depois, fui ao mercado.", "Depois fui ao mercado"), focus = "depois", watch = "depois = después."), PracticeQuestion(prompt = "Feche com no fim: deu tudo certo.", expected = listOf("No fim, deu tudo certo.", "No fim deu tudo certo"), focus = "no fim", watch = "no fim cierra la historia."), PracticeQuestion(prompt = "Diga no passado: você foi à praia e viu um golfinho.", expected = listOf("Fui à praia e vi um golfinho.", "fui a praia e vi um golfinho"), focus = "fui/vi", watch = "ir → fui, ver → vi."), PracticeQuestion(prompt = "Diga no passado: você fez tudo que planejou.", expected = listOf("Fiz tudo que planejei.", "fiz tudo que planejei"), focus = "fiz", watch = "fazer → fiz."))), exercises = listOf(Exercise(id = "pt-foundations-u18-narrar-e1", kind = "choice", prompt = "Primeiro ___ ao mercado, depois voltei para casa.", options = listOf("fui", "vou", "ia", "vai"), answers = listOf("fui"), explain = "ir → fui no pretérito."), Exercise(id = "pt-foundations-u18-narrar-e2", kind = "gap", prompt = "Depois, ___ uma cena estranha. (ver)", options = listOf(), answers = listOf("vi"), explain = "ver → vi no pretérito."), Exercise(id = "pt-foundations-u18-narrar-e3", kind = "order", prompt = "Ordene o resultado com no fim.", options = listOf(), answers = listOf("No fim deu tudo certo"), explain = "no fim + resultado."), Exercise(id = "pt-foundations-u18-narrar-e4", kind = "written", prompt = "Conte no passado: você foi ao cinema e viu um filme bom.", options = listOf(), answers = listOf("Fui ao cinema e vi um filme bom.", "fui ao cinema e vi um filme bom"), explain = "fui + vi: irregulares no passado.")), skills = listOf("function:tell-a-story", "grammar:past-simple-irregular", "grammar:connectors", "grammar:past-simple-regular"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-regular")),
    Lesson(id = "pt-foundations-u18-sorpresa", title = "A virada inesperada", goal = "Narrar com surpresa: de repente, acabou que.", intro = LessonIntro(explanation = listOf("A virada entra com « de repente ». « De repente, o carro parou ».", "O resultado fecha com « acabou que ». « Acabou que ninguém se machucou ».", "Reforce a surpresa: « não é que… ». « Não é que choveu no fim ? »."), examples = listOf(ExampleLine(text = "De repente, as luzes se apagaram.", meaning = "A virada."), ExampleLine(text = "Acabou que rimos todos.", meaning = "Resultado: acabou que."), ExampleLine(text = "Não é que ele apareceu no fim ?", meaning = "Surpresa reforçada."), ExampleLine(text = "Fiquei sem palavras.", meaning = "Reação pessoal."), ExampleLine(text = "E aí ninguém esperava.", meaning = "Surpresa coletiva."))), expressions = listOf(TargetExpression(text = "de repente", meaning = "De pronto.", note = "De repente, começou a chover."), TargetExpression(text = "acabou que …", meaning = "Resultado final.", note = "Acabou que deu certo."), TargetExpression(text = "não é que … ?", meaning = "Reforçar a surpresa.", note = "Não é que ele voltou ?"), TargetExpression(text = "ficar sem palavras", meaning = "Reação forte.", note = "Fiquei sem palavras."), TargetExpression(text = "ninguém esperava", meaning = "Surpresa coletiva.", note = "Ninguém esperava aquilo.")), situation = "O Rafa conta a viagem que deu errado — até que, de repente, tudo mudou e ninguém esperava o final.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Narre a virada: começou a chover. (de repente)", expected = listOf("De repente, começou a chover.", "de repente comecou a chover"), focus = "de repente", watch = "de repente = de pronto."), PracticeQuestion(prompt = "Dê o resultado: todos riram. (acabou que)", expected = listOf("Acabou que todos riram.", "acabou que todos riram"), focus = "acabou que", watch = "acabou que = al final."), PracticeQuestion(prompt = "Reforce a surpresa: ele voltou. (não é que)", expected = listOf("Não é que ele voltou ?", "nao e que ele voltou"), focus = "não é que", watch = "não é que reforça a surpresa."), PracticeQuestion(prompt = "Diga a reação: você ficou sem palavras.", expected = listOf("Fiquei sem palavras.", "fiquei sem palavras"), focus = "ficar sem palavras", watch = "reação forte."), PracticeQuestion(prompt = "Diga que ninguém esperava aquilo.", expected = listOf("Ninguém esperava aquilo.", "ninguem esperava aquilo"), focus = "ninguém esperava", watch = "surpresa coletiva."))), exercises = listOf(Exercise(id = "pt-foundations-u18-sorpresa-e1", kind = "choice", prompt = "___, o ônibus parou no meio da rua.", options = listOf("De repente", "No fim", "Primeiro", "Antes"), answers = listOf("De repente"), explain = "De repente: a virada da história."), Exercise(id = "pt-foundations-u18-sorpresa-e2", kind = "gap", prompt = "___ que ninguém se machucou. (resultado)", options = listOf(), answers = listOf("acabou"), explain = "acabou que + resultado."), Exercise(id = "pt-foundations-u18-sorpresa-e3", kind = "order", prompt = "Narre a surpresa: ele voltou.", options = listOf(), answers = listOf("Não é que ele voltou"), explain = "não é que… ? reforça a surpresa."), Exercise(id = "pt-foundations-u18-sorpresa-e4", kind = "written", prompt = "Dê o resultado da história: todos riram.", options = listOf(), answers = listOf("Acabou que todos riram.", "acabou que todos riram"), explain = "acabou que + resultado.")), skills = listOf("function:tell-a-story", "grammar:connectors", "grammar:past-simple-irregular", "vocab:social-expressions"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-irregular")),
    Lesson(id = "pt-foundations-u18-anedotas", title = "O episódio do verão", goal = "Contar uma anedota e reagir: não me diga, e aí ?", intro = LessonIntro(explanation = listOf("Abra a anedota situando no tempo: « No verão passado, fui… ». « No verão passado, fui ao Nordeste ».", "As reações do ouvinte puxam a história: « Não me diga ! », « Sério ? », « E aí ? ».", "Feche com o resultado avaliado: « E foi a melhor viagem da década »."), examples = listOf(ExampleLine(text = "No verão passado, fui ao Nordeste.", meaning = "Situar no tempo."), ExampleLine(text = "E aí, o que aconteceu ?", meaning = "Puxar a história."), ExampleLine(text = "Não me diga !", meaning = "Reação de surpresa."), ExampleLine(text = "Sério ? Conta mais !", meaning = "Pedir detalhes."), ExampleLine(text = "Foi a melhor viagem da década.", meaning = "Fecho com avaliação."))), expressions = listOf(TargetExpression(text = "no verão passado", meaning = "Situar no tempo.", note = "No verão passado, fui…"), TargetExpression(text = "e aí ?", meaning = "Puxar a história.", note = "E aí, o que deu ?"), TargetExpression(text = "não me diga !", meaning = "Surpresa do ouvinte.", note = "Não me diga ! Sério ?"), TargetExpression(text = "conta mais !", meaning = "Pedir detalhes.", note = "Conta mais, eu quero ouvir."), TargetExpression(text = "foi a melhor …", meaning = "Fecho com avaliação.", note = "Foi a melhor festa do ano.")), situation = "No terraço, a Nina conta o episódio do verão e os amigos reagem: sério ?, conta mais, não me diga !", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Situe a anedota: no verão passado, você foi à praia.", expected = listOf("No verão passado, fui à praia.", "no verao passado fui a praia"), focus = "no verão passado", watch = "situar no tempo."), PracticeQuestion(prompt = "Puxe a história do seu amigo.", expected = listOf("E aí ? O que aconteceu ?", "E aí, o que aconteceu ?"), focus = "e aí", watch = "e aí puxa a história."), PracticeQuestion(prompt = "Reaja com surpresa.", expected = listOf("Não me diga !", "Sério ? Não me diga !"), focus = "não me diga", watch = "reação de surpresa."), PracticeQuestion(prompt = "Peça mais detalhes.", expected = listOf("Conta mais !", "Conta mais, por favor."), focus = "conta mais", watch = "pedir detalhes."), PracticeQuestion(prompt = "Feche com avaliação: a melhor festa do ano.", expected = listOf("Foi a melhor festa do ano.", "foi a melhor festa do ano"), focus = "foi a melhor", watch = "fecho com avaliação."))), exercises = listOf(Exercise(id = "pt-foundations-u18-anedotas-e1", kind = "choice", prompt = "___, o que aconteceu na viagem ?", options = listOf("E aí", "No fim", "De repente", "Por isso"), answers = listOf("E aí"), explain = "E aí ? puxa a história."), Exercise(id = "pt-foundations-u18-anedotas-e2", kind = "gap", prompt = "Não me ___ ! (reação de surpresa)", options = listOf(), answers = listOf("diga"), explain = "não me diga: surpresa do ouvinte."), Exercise(id = "pt-foundations-u18-anedotas-e3", kind = "order", prompt = "Feche a anedota com avaliação: a melhor viagem da década.", options = listOf(), answers = listOf("Foi a melhor viagem da década"), explain = "foi a melhor + …: fecho avaliativo."), Exercise(id = "pt-foundations-u18-anedotas-e4", kind = "written", prompt = "Peça mais detalhes ao seu amigo.", options = listOf(), answers = listOf("conta mais", "conta mais, por favor."), explain = "Conta mais: pedir detalhes.")), skills = listOf("function:tell-a-story", "vocab:social-expressions", "grammar:past-simple-regular", "function:describe-past-events"), canDo = listOf("tell-a-story"), prerequisites = listOf("grammar:past-simple-regular"))))
}

object PtFoundationsU21 {
    val unit = CourseUnit(id = "pt-foundations-u21", title = "O trabalho", subtitle = "Entrevistas e metas", level = "B1", themes = listOf(ConversationTheme("entrevista-pontos", "A entrevista", "Experiência e pontos fortes", "briefcase", "Course", "A Ana ensaia a entrevista com o Leo: conta a experiência, mostra os pontos fortes e explica por que quer mudar.", 0),
                ConversationTheme("clima-metas", "Clima e metas", "Colegas e planos", "bubble.left.and.text.bubble.right", "Course", "No café da empresa, a equipe comenta o clima do time e cada um apresenta a meta profissional do ano.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u21-entrevista", title = "A entrevista", goal = "Falar de experiência e pontos fortes: já trabalhei…, há… anos, meu ponto forte é….", intro = LessonIntro(explanation = listOf("Para a experiência, o presente perfeito: « já trabalhei », « nunca gerenciei ». « Já trabalhei com vendas ».", "A duração com « há »: « Trabalho com marketing há três anos » (= desde hace tres años).", "Mostre as qualidades: « sou organizada », « aprendo rápido ». « Meu ponto forte é a organização »."), examples = listOf(ExampleLine(text = "Já trabalhei em duas agências.", meaning = "Experiência com já."), ExampleLine(text = "Nunca gerenciei uma equipe grande.", meaning = "nunca + pretérito: o que falta."), ExampleLine(text = "Trabalho com marketing há três anos.", meaning = "há = desde hace."), ExampleLine(text = "Meu ponto forte é a organização.", meaning = "ponto forte = punto fuerte."), ExampleLine(text = "Tenho experiência em atendimento e aprendo rápido.", meaning = "A área e a qualidade."))), expressions = listOf(TargetExpression(text = "Já + pretérito", meaning = "Experiência que conta.", note = "Já trabalhei no exterior."), TargetExpression(text = "Nunca + pretérito", meaning = "O que ainda não veio.", note = "Nunca apresentei para a diretoria."), TargetExpression(text = "há + tempo", meaning = "Duração até hoje.", note = "Trabalho aqui há dois anos."), TargetExpression(text = "Meu ponto forte é …", meaning = "Nomear a qualidade.", note = "Meu ponto forte é ouvir."), TargetExpression(text = "tenho experiência em …", meaning = "A área dominada.", note = "Tenho experiência em vendas.")), situation = "Na véspera da entrevista: a Ana ensaia com o Leo — o que já fez, o que nunca fez e quais pontos fortes vai mostrar.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga que já tem experiência com vendas.", expected = listOf("Já trabalhei com vendas.", "ja trabalhei com vendas"), focus = "já + pretérito", watch = "já = ya."), PracticeQuestion(prompt = "Diga o que nunca fez: gerenciar equipe grande.", expected = listOf("Nunca gerenciei uma equipe grande.", "nunca gerenciei uma equipe grande"), focus = "nunca + pretérito", watch = "nunca = nunca."), PracticeQuestion(prompt = "Diga há quanto tempo trabalha com marketing.", expected = listOf("Trabalho com marketing há três anos.", "trabalho com marketing ha tres anos"), focus = "há + tempo", watch = "há = desde hace."), PracticeQuestion(prompt = "Mostre o ponto forte: a organização.", expected = listOf("Meu ponto forte é a organização.", "meu ponto forte e a organizacao"), focus = "ponto forte", watch = "ponto forte = punto fuerte."), PracticeQuestion(prompt = "Diga a área de experiência: atendimento.", expected = listOf("Tenho experiência em atendimento.", "tenho experiencia em atendimento"), focus = "experiência em", watch = "em = en."))), exercises = listOf(Exercise(id = "pt-foundations-u21-entrevista-e1", kind = "choice", prompt = "___ trabalhei com vendas por dois anos.", options = listOf("Já", "Ainda", "Nunca", "Nem"), answers = listOf("Já"), explain = "Já + pretérito: a experiência que conta."), Exercise(id = "pt-foundations-u21-entrevista-e2", kind = "gap", prompt = "Trabalho com marketing ___ três anos.", options = listOf(), answers = listOf("há", "ha"), explain = "há + tempo = desde hace: duração até hoje."), Exercise(id = "pt-foundations-u21-entrevista-e3", kind = "order", prompt = "Mostre a qualidade principal.", options = listOf(), answers = listOf("Meu ponto forte é a organização"), explain = "meu ponto forte é …: nomear a qualidade."), Exercise(id = "pt-foundations-u21-entrevista-e4", kind = "written", prompt = "Fale da experiência no exterior.", options = listOf(), answers = listOf("Já trabalhei no exterior.", "ja trabalhei no exterior", "Trabalhei no exterior.", "trabalhei no exterior"), explain = "já trabalhei: o presente perfeito da experiência.")), skills = listOf("function:talk-about-work", "vocab:work", "grammar:present-perfect", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-perfect")),
    Lesson(id = "pt-foundations-u21-colegas", title = "Com os colegas", goal = "Descrever o clima de trabalho: a equipe é unida, a gente se ajuda, o gerente escuta.", intro = LessonIntro(explanation = listOf("O clima com ser: « a equipe é unida », « o ambiente é tranquilo ». « Aqui o ambiente é bem tranquilo ».", "O dia a dia com a gente: « a gente se ajuda », « dividimos as tarefas ». « Quando aperta, a gente se ajuda ».", "A liderança: « o gerente escuta antes de decidir », « todos dão feedback ». « O time dá feedback toda semana »."), examples = listOf(ExampleLine(text = "Aqui a equipe é bem unida.", meaning = "Clima de grupo."), ExampleLine(text = "O ambiente é tranquilo, mesmo na correria.", meaning = "ambiente = ambiente."), ExampleLine(text = "Quando aperta, a gente se ajuda.", meaning = "a gente = nós."), ExampleLine(text = "Todos dão feedback depois das reuniões.", meaning = "feedback = retroalimentación."), ExampleLine(text = "O gerente escuta antes de decidir.", meaning = "Liderança aberta."))), expressions = listOf(TargetExpression(text = "a equipe é unida", meaning = "Clima de grupo.", note = "Nossa equipe é unida."), TargetExpression(text = "o ambiente é tranquilo", meaning = "Sem tensão.", note = "O ambiente é tranquilo na sexta."), TargetExpression(text = "a gente se ajuda", meaning = "Cooperação no dia a dia.", note = "Na correria, a gente se ajuda."), TargetExpression(text = "dar feedback", meaning = "Comentar o trabalho.", note = "O time dá feedback toda semana."), TargetExpression(text = "dividir as tarefas", meaning = "Repartir o trabalho.", note = "Dividimos as tarefas do projeto.")), situation = "No café da empresa: a Ana e a Bia comparam o clima das duas equipes — quem ajuda, quem escuta e como se divide o trabalho.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Descreva o clima: sem tensão.", expected = listOf("O ambiente é tranquilo.", "o ambiente e tranquilo", "Aqui o ambiente é tranquilo.", "aqui o ambiente e tranquilo"), focus = "ambiente tranquilo", watch = "tranquilo = tranquilo."), PracticeQuestion(prompt = "Diga que o grupo é unido.", expected = listOf("A equipe é unida.", "a equipe e unida", "Nossa equipe é unida.", "nossa equipe e unida"), focus = "equipe unida", watch = "unida = unida."), PracticeQuestion(prompt = "Fale da cooperação no dia a dia.", expected = listOf("A gente se ajuda sempre.", "a gente se ajuda", "Quando aperta, a gente se ajuda.", "quando aperta a gente se ajuda"), focus = "a gente se ajuda", watch = "a gente = nosotros."), PracticeQuestion(prompt = "Descreva a escuta do gerente.", expected = listOf("O gerente escuta antes de decidir.", "o gerente escuta antes de decidir"), focus = "escutar", watch = "escuta antes de decidir."), PracticeQuestion(prompt = "Diga como repartem o trabalho.", expected = listOf("Dividimos as tarefas do projeto.", "dividimos as tarefas do projeto", "Dividimos as tarefas."), focus = "dividir", watch = "dividir las tareas."))), exercises = listOf(Exercise(id = "pt-foundations-u21-colegas-e1", kind = "choice", prompt = "Quando aperta, a gente ___ ajuda.", options = listOf("se", "nos", "lhe", "o"), answers = listOf("se"), explain = "a gente se ajuda: o reflexivo de cooperação."), Exercise(id = "pt-foundations-u21-colegas-e2", kind = "gap", prompt = "Nossa equipe é bem ___, ninguém trabalha sozinho.", options = listOf(), answers = listOf("unida"), explain = "equipe unida: o clima de grupo."), Exercise(id = "pt-foundations-u21-colegas-e3", kind = "order", prompt = "Descreva a cooperação do time.", options = listOf(), answers = listOf("A gente se ajuda sempre"), explain = "a gente se ajuda: cooperação com o reflexivo se."), Exercise(id = "pt-foundations-u21-colegas-e4", kind = "written", prompt = "Descreva a liderança do gerente.", options = listOf(), answers = listOf("O gerente escuta antes de decidir.", "o gerente escuta antes de decidir", "Nosso gerente escuta o time.", "nosso gerente escuta o time"), explain = "escuta antes de decidir: a liderança aberta.")), skills = listOf("function:talk-about-work", "vocab:work", "function:describe-people", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "pt-foundations-u21-metas", title = "Metas profissionais", goal = "Falar de metas profissionais: quero conquistar…, eu gostaria de…, até o fim do ano.", intro = LessonIntro(explanation = listOf("A meta direta com « quero »: « quero conquistar novos clientes », « quero uma promoção ».", "O sonho mais suave com « eu gostaria de »: « Eu gostaria de trabalhar no exterior » (= me gustaría).", "Meta com prazo e primeiro passo: « até o fim do ano », « primeiro, um curso ». « Até dezembro, fecho o curso »."), examples = listOf(ExampleLine(text = "Quero conquistar novos clientes este ano.", meaning = "A meta com quero."), ExampleLine(text = "Eu gostaria de liderar um time.", meaning = "gostaria = me gustaría."), ExampleLine(text = "Até o fim do ano, quero uma promoção.", meaning = "O prazo claro."), ExampleLine(text = "Primeiro, vou fazer um curso de gestão.", meaning = "O passo antes da meta."), ExampleLine(text = "Minha meta é abrir meu próprio negócio.", meaning = "meta = meta."))), expressions = listOf(TargetExpression(text = "Quero + verbo", meaning = "A meta direta.", note = "Quero mudar de área."), TargetExpression(text = "Eu gostaria de + verbo", meaning = "O sonho mais suave.", note = "Eu gostaria de morar fora."), TargetExpression(text = "até o fim do ano", meaning = "O prazo.", note = "Até o fim do ano, fecho o projeto."), TargetExpression(text = "minha meta é …", meaning = "Nomear a meta.", note = "Minha meta é liderar o time."), TargetExpression(text = "dar um passo de cada vez", meaning = "Calma no plano.", note = "Um passo de cada vez, sem pressa.")), situation = "Na reunião de planejamento: cada um apresenta a meta do ano, o prazo e o primeiro passo para chegar lá.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga a meta do ano: novos clientes.", expected = listOf("Quero conquistar novos clientes.", "quero conquistar novos clientes", "Quero conquistar novos clientes este ano.", "quero conquistar novos clientes este ano"), focus = "quero + verbo", watch = "quero = quiero."), PracticeQuestion(prompt = "Fale do sonho suave: trabalhar no exterior.", expected = listOf("Eu gostaria de trabalhar no exterior.", "eu gostaria de trabalhar no exterior"), focus = "eu gostaria de", watch = "gostaria = me gustaría."), PracticeQuestion(prompt = "Dê o prazo para a promoção.", expected = listOf("Até o fim do ano, quero uma promoção.", "ate o fim do ano quero uma promocao", "Até dezembro, quero uma promoção.", "ate dezembro quero uma promocao"), focus = "até + tempo", watch = "até = hasta."), PracticeQuestion(prompt = "Diga o primeiro passo: um curso de gestão.", expected = listOf("Primeiro, vou fazer um curso de gestão.", "primeiro vou fazer um curso de gestao"), focus = "primeiro", watch = "o passo antes da meta."), PracticeQuestion(prompt = "Nomeie a meta: liderar um time.", expected = listOf("Minha meta é liderar um time.", "minha meta e liderar um time"), focus = "minha meta é", watch = "meta = meta."))), exercises = listOf(Exercise(id = "pt-foundations-u21-metas-e1", kind = "choice", prompt = "Eu ___ de trabalhar no exterior.", options = listOf("gostaria", "gostei", "gosto", "agradeço"), answers = listOf("gostaria"), explain = "eu gostaria de + verbo: o desejo mais suave."), Exercise(id = "pt-foundations-u21-metas-e2", kind = "gap", prompt = "___ o fim do ano, quero uma promoção.", options = listOf(), answers = listOf("Até", "Ate", "até", "ate"), explain = "até + tempo: o prazo da meta."), Exercise(id = "pt-foundations-u21-metas-e3", kind = "order", prompt = "Diga a meta do ano com quero.", options = listOf(), answers = listOf("Quero conquistar novos clientes este ano"), explain = "quero + verbo + objeto: a meta direta."), Exercise(id = "pt-foundations-u21-metas-e4", kind = "written", prompt = "Fale do sonho suave: liderar um time.", options = listOf(), answers = listOf("Eu gostaria de liderar um time.", "eu gostaria de liderar um time", "Gostaria de liderar um time.", "gostaria de liderar um time"), explain = "eu gostaria de: o sonho sem pressão.")), skills = listOf("function:describe-goals", "function:talk-about-work", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors"))))
}

object PtFoundationsU26 {
    val unit = CourseUnit(id = "pt-foundations-u26", title = "A cidade que eu quero", subtitle = "Opinião, bairro e consumo", level = "B1", themes = listOf(ConversationTheme("opinioes-cidade", "Por um lado…", "Opiniões sobre a cidade", "building.2", "Course", "Na reunião do bairro, cada morador opina: por um lado o comércio local e a praça viva; por outro, o trânsito e os prédios altos.", 0),
                ConversationTheme("propostas-consumo", "Propostas", "Consumo consciente", "leaf", "Course", "A turma apresenta propostas para a vizinhança: horta comunitária, feira sem plástico e um consumo mais consciente no dia a dia.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u26-opinar", title = "Por um lado, por outro", goal = "Opinar sobre a cidade: por um lado…, por outro…, na minha opinião….", intro = LessonIntro(explanation = listOf("Pese os dois lados com o par fixo: « por um lado …, por outro lado … ». O contraste ganha equilíbrio.", "Marque a opinião: « na minha opinião », « eu acho que ». Depois justifique com « porque ».", "Concorde com limite: « concordo em parte, mas … ». Compare para argumentar: « mais útil do que »."), examples = listOf(ExampleLine(text = "Por um lado, o prédio traz moradores; por outro, tira o sol da praça.", meaning = "Os dois lados pesados."), ExampleLine(text = "Na minha opinião, a cidade precisa de menos carros.", meaning = "na minha opinião = en mi opinión."), ExampleLine(text = "Eu acho que a feira é o melhor do bairro.", meaning = "eu acho que = creo que."), ExampleLine(text = "Concordo em parte, mas falta sombra na praça.", meaning = "Concordância com limite."), ExampleLine(text = "A ciclovia é mais útil do que mais vagas de carro.", meaning = "O comparativo argumenta."))), expressions = listOf(TargetExpression(text = "Por um lado …, por outro …", meaning = "Pesar os lados.", note = "Por um lado, sim; por outro, não."), TargetExpression(text = "Na minha opinião, …", meaning = "Marcar a opinião.", note = "Na minha opinião, falta verde."), TargetExpression(text = "Eu acho que …", meaning = "Opinião direta.", note = "Eu acho que melhora o bairro."), TargetExpression(text = "Concordo em parte, mas …", meaning = "Concordar com limite.", note = "Concordo em parte, mas é caro."), TargetExpression(text = "mais útil do que", meaning = "Comparar para argumentar.", note = "É mais útil do que bonito.")), situation = "Na reunião do bairro: cada morador pesa os lados do novo prédio, opina sobre os carros e compara soluções para a praça.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pese os lados do prédio novo: moradores e sol.", expected = listOf("Por um lado, traz moradores; por outro, tira o sol.", "por um lado traz moradores por outro tira o sol"), focus = "os dois lados", watch = "o par fixo: por um lado / por outro."), PracticeQuestion(prompt = "Dê sua opinião sobre os carros na cidade.", expected = listOf("Na minha opinião, a cidade precisa de menos carros.", "na minha opiniao a cidade precisa de menos carros"), focus = "marcador", watch = "na minha opinião = en mi opinión."), PracticeQuestion(prompt = "Diga o que acha da feira.", expected = listOf("Eu acho que a feira é o melhor do bairro.", "eu acho que a feira e o melhor do bairro"), focus = "eu acho que", watch = "eu acho que = creo que."), PracticeQuestion(prompt = "Concorde em parte e aponte o que falta.", expected = listOf("Concordo em parte, mas falta sombra.", "concordo em parte mas falta sombra"), focus = "concordância", watch = "mas introduz o limite."), PracticeQuestion(prompt = "Compare a ciclovia com mais vagas de carro.", expected = listOf("A ciclovia é mais útil do que mais vagas de carro.", "a ciclovia e mais util do que mais vagas de carro"), focus = "comparativo", watch = "mais útil do que = más útil que."))), exercises = listOf(Exercise(id = "pt-foundations-u26-opinar-e1", kind = "choice", prompt = "Por um lado, traz moradores; por ___, tira o sol.", options = listOf("outro", "outra", "outros", "vez"), answers = listOf("outro"), explain = "por um lado …, por outro (lado) …: o par fixo do contraste."), Exercise(id = "pt-foundations-u26-opinar-e2", kind = "gap", prompt = "Na minha ___, a praça é o coração do bairro.", options = listOf(), answers = listOf("opinião", "opiniao"), explain = "na minha opinião: o marcador da opinião pessoal."), Exercise(id = "pt-foundations-u26-opinar-e3", kind = "order", prompt = "Compare a ciclovia com o estacionamento.", options = listOf(), answers = listOf("A ciclovia é mais útil do que o estacionamento"), explain = "mais + adjetivo + do que: comparar para argumentar."), Exercise(id = "pt-foundations-u26-opinar-e4", kind = "written", prompt = "Concorde em parte e aponte o que falta: sombra.", options = listOf(), answers = listOf("Concordo em parte, mas falta sombra.", "concordo em parte mas falta sombra"), explain = "concordo em parte + mas + falta: concordância com limite.")), skills = listOf("function:express-opinion", "grammar:connectors", "speaking:justify-opinion", "grammar:comparatives"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "pt-foundations-u26-proposta", title = "Propostas de bairro", goal = "Defender uma proposta: primeiro…, além disso…, por fim…, por isso….", intro = LessonIntro(explanation = listOf("Estruture o argumento: « primeiro …, além disso …, por fim … ». A ordem convence.", "Some força com « além disso » e « também »: « além disso, a horta une os vizinhos ».", "Conclua com a consequência: « por isso, peço o apoio de vocês »."), examples = listOf(ExampleLine(text = "Minha proposta é uma horta na praça.", meaning = "A proposta em uma frase."), ExampleLine(text = "Primeiro, ocupamos um canto vazio da praça.", meaning = "O primeiro passo."), ExampleLine(text = "Além disso, a horta une os vizinhos.", meaning = "além disso = además."), ExampleLine(text = "Por fim, comida fresca de graça para todos.", meaning = "por fim = por último."), ExampleLine(text = "Por isso, peço o apoio de vocês.", meaning = "por isso = por eso."))), expressions = listOf(TargetExpression(text = "Minha proposta é …", meaning = "Abrir a proposta.", note = "Minha proposta é simples."), TargetExpression(text = "Primeiro …, depois …, por fim …", meaning = "A estrutura do argumento.", note = "Primeiro o plano, por fim a obra."), TargetExpression(text = "Além disso, …", meaning = "Somar um argumento.", note = "Além disso, é barato."), TargetExpression(text = "Por isso, …", meaning = "Concluir com a consequência.", note = "Por isso, apoio a ideia."), TargetExpression(text = "Peço o apoio de vocês", meaning = "Fechar pedindo apoio.", note = "Peço o apoio de vocês !")), situation = "Na reunião: a Ana apresenta a proposta da horta, ordena os passos, soma argumentos e fecha pedindo o apoio dos vizinhos.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Apresente a proposta: uma horta na praça.", expected = listOf("Minha proposta é uma horta na praça.", "minha proposta e uma horta na praca"), focus = "abrir", watch = "minha proposta é + ideia."), PracticeQuestion(prompt = "Diga o primeiro passo: ocupar um canto vazio.", expected = listOf("Primeiro, ocupamos um canto vazio.", "primeiro ocupamos um canto vazio"), focus = "primeiro", watch = "primeiro = primero."), PracticeQuestion(prompt = "Some um argumento: a horta une os vizinhos.", expected = listOf("Além disso, a horta une os vizinhos.", "alem disso a horta une os vizinhos"), focus = "além disso", watch = "além disso = además."), PracticeQuestion(prompt = "Apresente o último argumento: comida fresca.", expected = listOf("Por fim, comida fresca de graça.", "por fim comida fresca de graca"), focus = "por fim", watch = "por fim = por último."), PracticeQuestion(prompt = "Conclua pedindo apoio.", expected = listOf("Por isso, peço o apoio de vocês.", "por isso peco o apoio de voces"), focus = "fecho", watch = "por isso + pedido: o fecho do argumento."))), exercises = listOf(Exercise(id = "pt-foundations-u26-proposta-e1", kind = "choice", prompt = "___ disso, a feira sem plástico reduz o lixo.", options = listOf("Além", "Por", "Depois", "Enquanto"), answers = listOf("Além"), explain = "além disso: somar um argumento ao anterior."), Exercise(id = "pt-foundations-u26-proposta-e2", kind = "gap", prompt = "Primeiro o mapeamento, ___ a coleta de assinaturas, por fim a reunião.", options = listOf(), answers = listOf("depois"), explain = "primeiro … depois …, por fim …: a sequência do plano."), Exercise(id = "pt-foundations-u26-proposta-e3", kind = "order", prompt = "Abra sua proposta sobre o transporte.", options = listOf(), answers = listOf("Minha proposta é uma ciclovia nova"), explain = "Minha proposta é + ideia: a abertura em uma frase."), Exercise(id = "pt-foundations-u26-proposta-e4", kind = "written", prompt = "Conclua a proposta pedindo apoio.", options = listOf(), answers = listOf("Por isso, peço o apoio de vocês.", "por isso peco o apoio de voces"), explain = "por isso + peço: consequência e pedido no fecho.")), skills = listOf("writing:argument", "grammar:connectors", "function:express-opinion", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "pt-foundations-u26-consumo", title = "Consumo consciente", goal = "Opinar sobre consumo: comprar menos e melhor, apesar de…, embora….", intro = LessonIntro(explanation = listOf("O princípio cabe em uma frase: « comprar menos e melhor ». Qualidade antes de quantidade.", "Conceda com « apesar de + substantivo » ou « embora + verbo »: « apesar do preço, dura mais ».", "Compare hábitos para argumentar: « reutilizar é melhor do que jogar fora »."), examples = listOf(ExampleLine(text = "Consumo consciente é comprar menos e melhor.", meaning = "O princípio do consumo."), ExampleLine(text = "Prefiro pagar mais caro por algo que dura anos.", meaning = "dura = dura."), ExampleLine(text = "Apesar do preço, sai mais barato no fim.", meaning = "apesar de = a pesar de."), ExampleLine(text = "Embora seja mais caro, a qualidade compensa.", meaning = "embora = aunque."), ExampleLine(text = "Reutilizar é melhor do que jogar fora.", meaning = "O comparativo do hábito."))), expressions = listOf(TargetExpression(text = "Comprar menos e melhor", meaning = "O lema do consumo consciente.", note = "Quero comprar menos e melhor."), TargetExpression(text = "Apesar de + substantivo", meaning = "A concessão curta.", note = "Apesar do preço, vale."), TargetExpression(text = "Embora seja …", meaning = "A concessão com verbo.", note = "Embora seja caro, compensa."), TargetExpression(text = "durar mais", meaning = "O que compensa.", note = "Um casaco que dura mais."), TargetExpression(text = "É melhor do que", meaning = "Comparar hábitos.", note = "Consertar é melhor do que jogar fora.")), situation = "Na roda de conversa: o grupo debate o lema comprar menos e melhor, concede com apesar de/embora e compara hábitos.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Resuma o princípio do consumo consciente.", expected = listOf("Comprar menos e melhor.", "comprar menos e melhor"), focus = "o lema", watch = "menos e melhor: os dois lados do lema."), PracticeQuestion(prompt = "Diga que prefere pagar mais caro por algo que dura.", expected = listOf("Prefiro pagar mais caro por algo que dura anos.", "prefiro pagar mais caro por algo que dura anos"), focus = "preferir", watch = "que dura anos = que dura años."), PracticeQuestion(prompt = "Conceda: apesar do preço, sai barato.", expected = listOf("Apesar do preço, sai mais barato no fim.", "apesar do preco sai mais barato no fim"), focus = "apesar de", watch = "apesar de + substantivo."), PracticeQuestion(prompt = "Conceda com embora: caro, mas compensa.", expected = listOf("Embora seja caro, a qualidade compensa.", "embora seja caro a qualidade compensa"), focus = "embora", watch = "embora + seja: fórmula fixa."), PracticeQuestion(prompt = "Compare: reutilizar e jogar fora.", expected = listOf("Reutilizar é melhor do que jogar fora.", "reutilizar e melhor do que jogar fora"), focus = "comparativo", watch = "melhor do que = mejor que."))), exercises = listOf(Exercise(id = "pt-foundations-u26-consumo-e1", kind = "choice", prompt = "___ do preço alto, o casaco dura dez anos.", options = listOf("Apesar", "Embora", "Por isso", "Enquanto"), answers = listOf("Apesar"), explain = "apesar de + substantivo: a concessão curta; « embora » pede verbo."), Exercise(id = "pt-foundations-u26-consumo-e2", kind = "gap", prompt = "Embora ___ mais caro, a qualidade compensa.", options = listOf(), answers = listOf("seja"), explain = "embora seja: a concessão com o verbo no subjuntivo."), Exercise(id = "pt-foundations-u26-consumo-e3", kind = "order", prompt = "Compare reutilizar com jogar fora.", options = listOf(), answers = listOf("Reutilizar é melhor do que jogar fora"), explain = "É melhor do que: o comparativo entre hábitos."), Exercise(id = "pt-foundations-u26-consumo-e4", kind = "written", prompt = "Diga o lema do consumo consciente.", options = listOf(), answers = listOf("Comprar menos e melhor.", "comprar menos e melhor"), explain = "O lema curto que resume o consumo consciente.")), skills = listOf("speaking:justify-opinion", "grammar:connectors", "function:express-opinion", "writing:argument"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors"))))
}

object PtFoundationsU7 {
    val unit = CourseUnit(id = "pt-foundations-u7", title = "Opiniões e nuances", subtitle = "Se eu tivesse…", level = "B2", themes = listOf(ConversationTheme("pt-b2-hipotese", "Planos impossíveis", "Se eu tivesse tempo", "sparkles", "Course", "Vocês debatem o que fariam com tempo infinito, depois um compromisso real.", 0),
                ConversationTheme("pt-b2-pechincha", "A pechincha", "E se combinarmos em 50 ?", "handshake", "Course", "Vocês negociam uma compra usada: oferta, condições, acordo.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u7-hipotetico", title = "Se eu tivesse tempo…", goal = "Falar do irreal: se + pretérito imperfeito do subjuntivo, depois o condicional.", intro = LessonIntro(explanation = listOf("A hipótese irreal: « Se eu tivesse mais tempo, viajaria mais ». Se + imperfeito do subjuntivo, depois condicional (-ria).", "Nunca « se + condicional »: diz-se « se eu tivesse », não « se eu teria ».", "Para aconselhar com jeito: « No seu lugar, eu tentaria », « Não é que eu não queira; é que eu não poderia »."), examples = listOf(ExampleLine(text = "Se eu tivesse mais tempo, viajaria mais.", meaning = "Irreal do presente."), ExampleLine(text = "No seu lugar, eu tentaria.", meaning = "Conselho com jeito."), ExampleLine(text = "Se eu pudesse, mudaria de emprego.", meaning = "poder → pudesse / poderia."), ExampleLine(text = "E se a gente se visse na quinta ?", meaning = "Proposta suave."), ExampleLine(text = "Não é que eu não queira; é que eu não poderia.", meaning = "Nuance querer/poder."))), expressions = listOf(TargetExpression(text = "se + imperfeito do subj., …ria", meaning = "Hipótese.", note = "Se tivesse…, viajaria."), TargetExpression(text = "ter → tivesse", meaning = "Subjuntivo-chave.", note = "Se tivesse tempo."), TargetExpression(text = "poder → pudesse", meaning = "Subjuntivo-chave.", note = "Se pudesse, faria."), TargetExpression(text = "no seu lugar, …ria", meaning = "Conselho.", note = "…eu tentaria."), TargetExpression(text = "e se + imperfeito…?", meaning = "Proposta.", note = "E se a gente tentasse ?")), situation = "Vocês debatem planos impossíveis: mais tempo, outro emprego, outra cidade — e propõem um compromisso real para este mês.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Sua hipótese: se eu tivesse mais tempo, viajaria mais.", expected = listOf("Se eu tivesse mais tempo viajaria mais", "Se eu tivesse mais tempo, viajaria mais"), focus = "se + subjuntivo", watch = "Imperfeito do subjuntivo + condicional."), PracticeQuestion(prompt = "Conselho com jeito: no seu lugar, eu tentaria.", expected = listOf("No seu lugar eu tentaria", "No seu lugar, eu tentaria"), focus = "no seu lugar", watch = "No seu lugar + condicional."), PracticeQuestion(prompt = "Diga que se pudesse, mudaria de emprego.", expected = listOf("Se pudesse mudaria de emprego", "Se pudesse, mudaria de emprego"), focus = "pudesse/poderia", watch = "Se pudesse… mudaria."), PracticeQuestion(prompt = "Proponha: e se a gente se visse na quinta ?", expected = listOf("E se a gente se visse na quinta", "E se a gente se visse na quinta ?"), focus = "e se… ?", watch = "E se + imperfeito do subjuntivo."), PracticeQuestion(prompt = "Dê o matiz: não é que eu não queira; é que eu não poderia.", expected = listOf("Nao e que eu nao queira e que eu nao poderia", "Não é que eu não queira; é que eu não poderia"), focus = "não é que", watch = "Contraste querer/poder."))), exercises = listOf(Exercise(id = "pt-foundations-u7-hipotetico-e1", kind = "choice", prompt = "Se eu ___ mais tempo, viajaria mais.", options = listOf("tivesse", "teria", "tenho", "tinha"), answers = listOf("tivesse"), explain = "Com « se » irreal: imperfeito do subjuntivo."), Exercise(id = "pt-foundations-u7-hipotetico-e2", kind = "gap", prompt = "Se pudesse, ___ de emprego. (mudar, condicional)", options = listOf(), answers = listOf("mudaria"), explain = "Se pudesse + condicional: mudaria."), Exercise(id = "pt-foundations-u7-hipotetico-e3", kind = "order", prompt = "Conselho: no seu lugar, eu tentaria.", options = listOf(), answers = listOf("No seu lugar, eu tentaria"), explain = "no seu lugar + condicional."), Exercise(id = "pt-foundations-u7-hipotetico-e4", kind = "written", prompt = "Sua hipótese com o emprego (poder + mudar).", options = listOf(), answers = listOf("se pudesse mudaria de emprego", "se pudesse, mudaria de emprego"), explain = "Se + subjuntivo + condicional.")), skills = listOf("grammar:second-conditional", "function:express-opinion", "speaking:justify-opinion", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:past-simple-irregular", "grammar:connectors")),
    Lesson(id = "pt-foundations-u7-registro", title = "Diz-se que…", goal = "Relatar o que outros afirmam: a voz passiva e o sujeito indeterminado.", intro = LessonIntro(explanation = listOf("Passiva com « ser + particípio »: « O show foi cancelado », « Os ingressos estão esgotados ». Linguagem de notícia.", "Sujeito indeterminado: « Dizem que o bairro vai mudar », « Diz-se que… ». Não importa quem fala.", "A passiva sobe o registro; o « dizem que » fica do dia a dia."), examples = listOf(ExampleLine(text = "Dizem que o bairro vai mudar.", meaning = "Indeterminado: boato."), ExampleLine(text = "O show foi cancelado por causa da chuva.", meaning = "Passiva + agente."), ExampleLine(text = "Os ingressos estão esgotados.", meaning = "Passiva de estado."), ExampleLine(text = "Todos os trens foram cancelados.", meaning = "Notícia oficial."), ExampleLine(text = "Segundo a prefeitura, a obra vai atrasar.", meaning = "Fonte + futuro."))), expressions = listOf(TargetExpression(text = "dizem que / diz-se que…", meaning = "Boato.", note = "…o bairro vai mudar."), TargetExpression(text = "foi/será + particípio", meaning = "Passiva.", note = "foi cancelado."), TargetExpression(text = "estão + particípio", meaning = "Estado.", note = "estão esgotados."), TargetExpression(text = "segundo + fonte", meaning = "Citar.", note = "segundo a prefeitura."), TargetExpression(text = "está previsto que…", meaning = "Oficial.", note = "…a obra…")), situation = "Vocês comentam as notícias do bairro: o que se diz, o que foi decidido e em qual fonte vocês menos acreditam.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Espalhe o boato: dizem que o bairro vai mudar.", expected = listOf("Dizem que o bairro vai mudar"), focus = "dizem que", watch = "Indeterminado, sem sujeito."), PracticeQuestion(prompt = "Notícia: o show foi cancelado por causa da chuva.", expected = listOf("O show foi cancelado por causa da chuva"), focus = "foi cancelado", watch = "ser + particípio."), PracticeQuestion(prompt = "Diga que os ingressos estão esgotados.", expected = listOf("Os ingressos estão esgotados"), focus = "estão esgotados", watch = "Passiva de estado."), PracticeQuestion(prompt = "Cite a fonte: segundo a prefeitura, a obra vai atrasar.", expected = listOf("Segundo a prefeitura a obra vai atrasar"), focus = "segundo", watch = "Segundo + fonte."), PracticeQuestion(prompt = "Diga que todos os trens foram cancelados.", expected = listOf("Todos os trens foram cancelados"), focus = "foram cancelados", watch = "Passiva plural."))), exercises = listOf(Exercise(id = "pt-foundations-u7-registro-e1", kind = "choice", prompt = "___ dizem que o bairro vai mudar.", options = listOf("(", "Eles", "As pessoas", "Todo mundo"), answers = listOf("("), explain = "Sujeito indeterminado: sem pronome antes — « Dizem que… »."), Exercise(id = "pt-foundations-u7-registro-e2", kind = "gap", prompt = "O show foi ___ por causa da chuva. (cancelar)", options = listOf(), answers = listOf("cancelado"), explain = "ser + particípio: cancelado."), Exercise(id = "pt-foundations-u7-registro-e3", kind = "order", prompt = "Notícia: todos os trens foram cancelados.", options = listOf(), answers = listOf("Todos os trens foram cancelados"), explain = "Passiva plural."), Exercise(id = "pt-foundations-u7-registro-e4", kind = "written", prompt = "Boato: uma feira nova vai abrir, você ouviu falar.", options = listOf(), answers = listOf("dizem que vai abrir uma feira nova"), explain = "Dizem que + futuro.")), skills = listOf("grammar:passive-intro", "grammar:present-perfect", "function:express-opinion", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:past-simple-regular", "grammar:verb-be")),
    Lesson(id = "pt-foundations-u7-negociar", title = "E se combinarmos em 50 ?", goal = "Negociar um acordo: propor com condicional, pôr condições e fechar.", intro = LessonIntro(explanation = listOf("Propor: « E se combinarmos em 50 ? », « Eu lhe daria 60 se você incluir o frete ».", "Condições: « Só se entregar hoje », « Em troca, quero a garantia ».", "Fechar: « Fechado », « De acordo, mas com uma condição »."), examples = listOf(ExampleLine(text = "E se combinarmos em 50 ?", meaning = "Proposta."), ExampleLine(text = "Eu lhe daria 60 se você incluir o frete.", meaning = "Condicional + se + presente."), ExampleLine(text = "Só se entregar hoje.", meaning = "Condição dura."), ExampleLine(text = "Em troca, quero a garantia.", meaning = "Contraproposta."), ExampleLine(text = "Fechado.", meaning = "Fechamento."))), expressions = listOf(TargetExpression(text = "e se + futuro de subjuntivo… ?", meaning = "Propor.", note = "E se combinarmos… ?"), TargetExpression(text = "…ria se + presente", meaning = "Condições.", note = "lhe daria 60 se…"), TargetExpression(text = "só se…", meaning = "Condição dura.", note = "só se for hoje."), TargetExpression(text = "em troca, …", meaning = "Contraproposta.", note = "…a garantia."), TargetExpression(text = "fechado", meaning = "Fechar.", note = "depois do acordo.")), situation = "Vocês pechincham uma mesa de segunda mão: abrem alto, oferecem com condições e fecham no meio do caminho.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Proponha: e se combinarmos em 50 ?", expected = listOf("E se combinarmos em 50", "E se combinarmos em 50 ?"), focus = "e se… ?", watch = "Proposta com futuro do subjuntivo."), PracticeQuestion(prompt = "Oferta com condição: eu lhe daria 60 se você incluir o frete.", expected = listOf("Eu lhe daria 60 se voce incluir o frete", "Eu lhe daria 60 se você incluir o frete"), focus = "daria se", watch = "Condicional + se + presente."), PracticeQuestion(prompt = "Condição dura: só se entregar hoje.", expected = listOf("So se entregar hoje", "Só se entregar hoje"), focus = "só se", watch = "Só se + futuro do subjuntivo."), PracticeQuestion(prompt = "Contraproposta: em troca, quero a garantia.", expected = listOf("Em troca quero a garantia", "Em troca, quero a garantia"), focus = "em troca", watch = "Em troca + pedido."), PracticeQuestion(prompt = "Feche o negócio.", expected = listOf("Fechado", "De acordo"), focus = "fechado", watch = "Frase fixa de fechamento."))), exercises = listOf(Exercise(id = "pt-foundations-u7-negociar-e1", kind = "choice", prompt = "E se ___ em 50 ?", options = listOf("combinarmos", "combinaremos", "combinado", "combinamos"), answers = listOf("combinarmos"), explain = "Futuro do subjuntivo: combinarmos."), Exercise(id = "pt-foundations-u7-negociar-e2", kind = "gap", prompt = "Eu lhe ___ 60 se você incluir o frete. (dar, condicional)", options = listOf(), answers = listOf("daria"), explain = "Condicional presente: daria."), Exercise(id = "pt-foundations-u7-negociar-e3", kind = "order", prompt = "Condição: só se entregar hoje.", options = listOf(), answers = listOf("Só se entregar hoje"), explain = "só se + subjuntivo."), Exercise(id = "pt-foundations-u7-negociar-e4", kind = "written", prompt = "Feche o negócio, mas com uma ressalva.", options = listOf(), answers = listOf("de acordo mas com uma condicao", "de acordo, mas com uma condição"), explain = "De acordo, mas…")), skills = listOf("function:negotiate", "grammar:second-conditional", "speaking:negotiate", "grammar:connectors"), canDo = listOf("solve-everyday-problems"), prerequisites = listOf("grammar:connectors"))))
}

object PtFoundationsU8 {
    val unit = CourseUnit(id = "pt-foundations-u8", title = "Mídia e argumento", subtitle = "A notícia que li", level = "B2", themes = listOf(ConversationTheme("pt-b2-noticias", "Semana de notícias", "O que se disse", "newspaper", "Course", "Vocês resumem a semana com relativas: quem, onde, o quê.", 0),
                ConversationTheme("pt-b2-coluna", "Sua coluna", "Por um lado… por outro…", "pencil", "Course", "Vocês escrevem uma coluna sobre peatonalizar o centro.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u7-relativas", title = "A notícia que li", goal = "Contar notícias com orações relativas: que, quem, onde, cujo.", intro = LessonIntro(explanation = listOf("A relativa explica o substantivo: « A notícia que li diz que… », « O jornalista que o entrevistou… ».", "« Onde » para lugares: « A praça onde se manifestaram ». « Cujo » para posse: « a empresa cujo diretor renunciou ».", "Em notícias, as relativas comprimem: quem, onde, o quê."), examples = listOf(ExampleLine(text = "A notícia que li diz que…", meaning = "Relativa de objeto."), ExampleLine(text = "O jornalista que o entrevistou renunciou.", meaning = "Relativa de sujeito."), ExampleLine(text = "A praça onde se manifestaram é central.", meaning = "onde + lugar."), ExampleLine(text = "A empresa cujo diretor renunciou reagiu.", meaning = "cujo = posse."), ExampleLine(text = "Tudo o que sei vem do rádio.", meaning = "tudo o que + verbo."))), expressions = listOf(TargetExpression(text = "o/a que…", meaning = "Relativa.", note = "a notícia que li."), TargetExpression(text = "quem…", meaning = "Pessoa.", note = "quem o entrevistou."), TargetExpression(text = "onde…", meaning = "Lugar.", note = "a praça onde…"), TargetExpression(text = "cujo/a…", meaning = "Posse.", note = "a empresa cujo diretor…"), TargetExpression(text = "tudo o que…", meaning = "Generalizar.", note = "tudo o que sei.")), situation = "Vocês resumem uma semana de notícias: a história que marcou, a pessoa que falou e o lugar onde aconteceu.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Resuma: a notícia que li diz que o museu amplia os horários.", expected = listOf("A noticia que li diz que o museu amplia os horarios", "A notícia que li diz que o museu amplia os horários"), focus = "que li", watch = "Relativa sobre a notícia."), PracticeQuestion(prompt = "Diga quem: o jornalista que o entrevistou renunciou.", expected = listOf("O jornalista que o entrevistou renunciou"), focus = "que o entrevistou", watch = "Relativa de sujeito."), PracticeQuestion(prompt = "Lugar: a praça onde se manifestaram é central.", expected = listOf("A praca onde se manifestaram e central", "A praça onde se manifestaram é central"), focus = "onde", watch = "onde + lugar."), PracticeQuestion(prompt = "Posse: a empresa cujo diretor renunciou reagiu.", expected = listOf("A empresa cujo diretor renunciou reagiu"), focus = "cujo", watch = "cujo + substantivo."), PracticeQuestion(prompt = "Generalize: tudo o que sei vem do rádio.", expected = listOf("Tudo o que sei vem do radio", "Tudo o que sei vem do rádio"), focus = "tudo o que", watch = "tudo o que + verbo."))), exercises = listOf(Exercise(id = "pt-foundations-u7-relativas-e1", kind = "choice", prompt = "A notícia ___ li diz que o museu amplia.", options = listOf("que", "quem", "cujo", "onde"), answers = listOf("que"), explain = "Coisa: a notícia que li."), Exercise(id = "pt-foundations-u7-relativas-e2", kind = "gap", prompt = "A praça ___ se manifestaram é central.", options = listOf(), answers = listOf("onde"), explain = "Lugar: onde."), Exercise(id = "pt-foundations-u7-relativas-e3", kind = "order", prompt = "Sujeito: o jornalista que o entrevistou renunciou.", options = listOf(), answers = listOf("O jornalista que o entrevistou renunciou"), explain = "Relativa de sujeito."), Exercise(id = "pt-foundations-u7-relativas-e4", kind = "written", prompt = "Sua notícia: uma rua vai fechar (use « a notícia que li »).", options = listOf(), answers = listOf("a notícia que li diz que fecharão a rua", "a noticia que li diz que fecharao a rua"), explain = "A notícia que + pretérito.")), skills = listOf("grammar:relative-clauses", "grammar:present-perfect", "function:express-opinion", "vocab:work"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:present-perfect")),
    Lesson(id = "pt-foundations-u7-argumentar", title = "Por um lado… por outro…", goal = "Escrever e defender uma opinião estruturada: tese, argumentos, concessão e conclusão.", intro = LessonIntro(explanation = listOf("Estrutura: tese (« Acho que deveríamos peatonalizar o centro »), argumentos (« por um lado…, por outro… »), concessão (« é verdade que…, mas… »).", "A concessão dá credibilidade: você reconhece o outro lado antes de responder.", "Conclusão com peso: « Por tudo isso, defendo a medida »."), examples = listOf(ExampleLine(text = "Acho que deveríamos peatonalizar o centro.", meaning = "Tese."), ExampleLine(text = "Por um lado, a poluição cai.", meaning = "Argumento 1."), ExampleLine(text = "Por outro, o comércio sofre.", meaning = "Argumento 2 (contrário)."), ExampleLine(text = "É verdade que é incômodo, mas os números dizem outra coisa.", meaning = "Concessão + resposta."), ExampleLine(text = "Por tudo isso, defendo a medida.", meaning = "Conclusão."))), expressions = listOf(TargetExpression(text = "acho que + deveríamos…", meaning = "Tese.", note = "…peatonalizar."), TargetExpression(text = "por um lado… por outro…", meaning = "Argumentos.", note = "as duas faces."), TargetExpression(text = "é verdade que…, mas…", meaning = "Concessão.", note = "reconhecer e responder."), TargetExpression(text = "os números dizem…", meaning = "Prova.", note = "argumento de autoridade."), TargetExpression(text = "por tudo isso, …", meaning = "Conclusão.", note = "fecho formal.")), situation = "Vocês escrevem uma coluna de opinião sobre peatonalizar o centro: tese, duas faces, concessão e fecho.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Tese: acho que deveríamos peatonalizar o centro.", expected = listOf("Acho que deveriamos peatonalizar o centro", "Acho que deveríamos peatonalizar o centro"), focus = "acho que", watch = "Acho que + deveríamos."), PracticeQuestion(prompt = "Argumento 1: por um lado, a poluição cai.", expected = listOf("Por um lado a poluicao cai", "Por um lado, a poluição cai"), focus = "por um lado", watch = "Primeiro argumento."), PracticeQuestion(prompt = "Argumento contrário: por outro, o comércio sofre.", expected = listOf("Por outro o comercio sofre", "Por outro, o comércio sofre"), focus = "por outro", watch = "Segunda face."), PracticeQuestion(prompt = "Conceda: é verdade que é incômodo, mas os números dizem outra coisa.", expected = listOf("E verdade que e incomodo mas os numeros dizem outra coisa", "É verdade que é incômodo, mas os números dizem outra coisa"), focus = "é verdade que", watch = "Concessão + mas."), PracticeQuestion(prompt = "Feche: por tudo isso, defendo a medida.", expected = listOf("Por tudo isso defendo a medida", "Por tudo isso, defendo a medida"), focus = "por tudo isso", watch = "Conclusão formal."))), exercises = listOf(Exercise(id = "pt-foundations-u7-argumentar-e1", kind = "choice", prompt = "___ um lado, a poluição cai.", options = listOf("Por", "Para", "Em", "Com"), answers = listOf("Por"), explain = "por um lado = primeiro argumento."), Exercise(id = "pt-foundations-u7-argumentar-e2", kind = "gap", prompt = "É verdade que é incômodo, ___ os números dizem outra coisa.", options = listOf(), answers = listOf("mas", "porém"), explain = "Concessão + contraste."), Exercise(id = "pt-foundations-u7-argumentar-e3", kind = "order", prompt = "Conclusão: por tudo isso, defendo a medida.", options = listOf(), answers = listOf("Por tudo isso, defendo a medida"), explain = "por tudo isso."), Exercise(id = "pt-foundations-u7-argumentar-e4", kind = "written", prompt = "Sua tese sobre ampliar o metrô.", options = listOf(), answers = listOf("acho que deveriamos ampliar o metro", "acho que deveríamos ampliar o metrô"), explain = "Acho que + deveríamos.")), skills = listOf("writing:argument", "grammar:connectors", "function:express-opinion", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors"))))
}

object PtFoundationsU9 {
    val unit = CourseUnit(id = "pt-foundations-u9", title = "Nuances e registros", subtitle = "Dizer melhor", level = "C1", themes = listOf(ConversationTheme("pt-foundations-u9-registros", "Como se diz", "Formal ou coloquial", "sparkles", "Course", "Vocês traduzem a mensagem de corredor para o e-mail da diretoria e discutem o que muda no tom.", 0),
                ConversationTheme("pt-foundations-u9-ideias", "Ideias em ordem", "Matices e estrutura", "bubble-left-and-text", "Course", "Vocês matizam opiniões num debate e depois cada um apresenta sua ideia em um minuto.", 1)), lessons = listOf(    Lesson(id = "pt-foundations-u9-registro", title = "Como se diz", goal = "Alternar entre o formal e o coloquial: a mesma mensagem em dois registros.", intro = LessonIntro(explanation = listOf("O registro sobe ou desce com o pronome e o verbo: « Poderia me enviar o relatório ? » é formal; « Me manda o relatório aí ? » é de corredor.", "No e-mail para a diretoria, abra com « Prezada Sra. Alves », peça com « Solicito que… » e feche com « Atenciosamente »; no dia a dia, basta « Oi, tudo bem ? ».", "Conectores também têm registro: « mas » vira « no entanto », « porque » vira « visto que » — « Adiei a reunião, visto que a diretoria viajou »."), examples = listOf(ExampleLine(text = "Prezada Sra. Alves, solicito que envie o relatório até sexta.", meaning = "Abertura e pedido formais."), ExampleLine(text = "Segue em anexo o contrato assinado.", meaning = "Fórmula fixa de e-mail."), ExampleLine(text = "Me manda o arquivo aí, por favor ?", meaning = "Pedido coloquial."), ExampleLine(text = "O projeto atrasou; no entanto, o prazo se mantém.", meaning = "Conector formal de contraste."), ExampleLine(text = "Tá suave, eu te dou um retorno depois.", meaning = "Coloquial: combinar depois."))), expressions = listOf(TargetExpression(text = "Prezado(a) …", meaning = "Abertura formal de carta ou e-mail.", note = "Prezada Sra. Alves,"), TargetExpression(text = "solicito que + subjuntivo", meaning = "Pedido formal por escrito.", note = "Solicito que enviem hoje."), TargetExpression(text = "segue em anexo", meaning = "E-mail: apontar o anexo.", note = "Segue em anexo o contrato."), TargetExpression(text = "atenciosamente / cordialmente", meaning = "Fecho formal.", note = "…Atenciosamente, Marina."), TargetExpression(text = "dar um retorno", meaning = "Coloquial de trabalho: responder depois.", note = "Te dou um retorno amanhã.")), situation = "Vocês traduzem a conversa de corredor para o e-mail da diretoria — e comentam o que muda no tom, do pronome ao conector.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Peça formalmente no e-mail: solicito que enviem o relatório até sexta.", expected = listOf("solicito que enviem o relatorio ate sexta", "solicito que enviem o relatório até sexta"), focus = "solicito que", watch = "Após « solicito que », subjuntivo."), PracticeQuestion(prompt = "Diga que o contrato segue em anexo.", expected = listOf("segue em anexo o contrato", "o contrato segue em anexo"), focus = "segue em anexo", watch = "Fórmula fixa de e-mail."), PracticeQuestion(prompt = "Coloquial: me manda o arquivo aí, por favor.", expected = listOf("me manda o arquivo ai por favor", "me manda o arquivo aí, por favor"), focus = "me manda", watch = "Imperativo coloquial com « aí »."), PracticeQuestion(prompt = "Formal, contraste: o projeto atrasou; no entanto, o prazo se mantém.", expected = listOf("o projeto atrasou no entanto o prazo se mantem", "o projeto atrasou; no entanto, o prazo se mantém"), focus = "no entanto", watch = "Contraste formal: no entanto."), PracticeQuestion(prompt = "Feche o e-mail formal para a diretoria.", expected = listOf("atenciosamente", "cordialmente"), focus = "fecho formal", watch = "Atenciosamente / Cordialmente."))), exercises = listOf(Exercise(id = "pt-foundations-u9-registro-e1", kind = "choice", prompt = "___ Sra. Alves, solicito que envie o contrato.", options = listOf("Prezada", "Querida", "Oi", "E aí"), answers = listOf("Prezada"), explain = "Abertura formal de e-mail: Prezada Sra. …"), Exercise(id = "pt-foundations-u9-registro-e2", kind = "gap", prompt = "Segue em ___ o relatório pedido. (palavra do anexo)", options = listOf(), answers = listOf("anexo"), explain = "Fórmula fixa de e-mail: segue em anexo."), Exercise(id = "pt-foundations-u9-registro-e3", kind = "order", prompt = "Peça o documento à equipe por escrito (verbo « solicitar »).", options = listOf(), answers = listOf("Solicito que enviem o relatório"), explain = "solicito que + subjuntivo: pedido formal."), Exercise(id = "pt-foundations-u9-registro-e4", kind = "written", prompt = "Feche um e-mail formal para a diretoria.", options = listOf(), answers = listOf("atenciosamente", "cordialmente"), explain = "Atenciosamente / Cordialmente fecham e-mails formais.")), skills = listOf("vocab:social-expressions", "function:talk-about-work", "writing:email", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "pt-foundations-u9-matices", title = "Mais ou menos", goal = "Matizar opiniões: concordar em parte, suavizar e reformular o que se pensa.", intro = LessonIntro(explanation = listOf("Para concordar em parte: « De certa forma, você tem razão », « Até certo ponto, concordo », « Em parte, sim; em parte, não ».", "Para reformular com jeito: « Por assim dizer, é um emprego estável », « Digamos que o time está em transição ».", "Para marcar a sua voz sem soar duro: « Na minha visão, a proposta ainda é arriscada » — mais recolhida que « eu acho », mais pessoal que « parece-me »."), examples = listOf(ExampleLine(text = "De certa forma, você tem razão.", meaning = "Concordância parcial."), ExampleLine(text = "Até certo ponto, o relatório convence.", meaning = "Concordo, mas não por inteiro."), ExampleLine(text = "Por assim dizer, é um emprego estável.", meaning = "Reformulação com jeito."), ExampleLine(text = "Na minha visão, a proposta é arriscada.", meaning = "Opinião pessoal matizada."), ExampleLine(text = "Não é que eu discorde; é que faltam dados.", meaning = "Defende-se sem brigar."))), expressions = listOf(TargetExpression(text = "de certa forma, …", meaning = "Concordar em parte.", note = "De certa forma, sim."), TargetExpression(text = "até certo ponto, …", meaning = "Medir o acordo.", note = "Até certo ponto, concordo."), TargetExpression(text = "por assim dizer, …", meaning = "Reformular com tato.", note = "…um emprego, por assim dizer."), TargetExpression(text = "na minha visão, …", meaning = "Opinião pessoal.", note = "Na minha visão, é arriscado."), TargetExpression(text = "não é que…; é que…", meaning = "Negar antes de explicar.", note = "Não é que eu discorde.")), situation = "Vocês avaliam a proposta de um colega com tato: concordam em parte, reformulam o que soou duro e deixam o debate aberto.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Concorde em parte: de certa forma, você tem razão.", expected = listOf("de certa forma voce tem razao", "de certa forma, você tem razão"), focus = "de certa forma", watch = "Frase fixa de concordância parcial."), PracticeQuestion(prompt = "Meça o acordo: até certo ponto, concordo com o relatório.", expected = listOf("ate certo ponto concordo com o relatorio", "até certo ponto, concordo com o relatório"), focus = "até certo ponto", watch = "Concordo, mas não por inteiro."), PracticeQuestion(prompt = "Reformule: por assim dizer, é um emprego estável.", expected = listOf("por assim dizer e um emprego estavel", "por assim dizer, é um emprego estável"), focus = "por assim dizer", watch = "Reformulação com tato."), PracticeQuestion(prompt = "Dê sua visão: na minha visão, a proposta é arriscada.", expected = listOf("na minha visao a proposta e arriscada", "na minha visão, a proposta é arriscada"), focus = "na minha visão", watch = "Opinião pessoal matizada."), PracticeQuestion(prompt = "Defenda-se: não é que eu discorde; é que faltam dados.", expected = listOf("nao e que eu discorde e que faltam dados", "não é que eu discorde; é que faltam dados"), focus = "não é que", watch = "Após « não é que », subjuntivo: discorde."))), exercises = listOf(Exercise(id = "pt-foundations-u9-matices-e1", kind = "choice", prompt = "___ certa forma, você tem razão.", options = listOf("De", "Da", "Na", "Por"), answers = listOf("De"), explain = "Frase fixa: de certa forma = concordar em parte."), Exercise(id = "pt-foundations-u9-matices-e2", kind = "gap", prompt = "Não é que eu ___; é que faltam dados. (discordar, subjuntivo)", options = listOf(), answers = listOf("discorde"), explain = "Após « não é que », subjuntivo: discorde."), Exercise(id = "pt-foundations-u9-matices-e3", kind = "order", prompt = "Dê seu juízo com tato: a ideia convence ou não ?", options = listOf(), answers = listOf("Na minha visão, a proposta é arriscada"), explain = "Na minha visão + juízo matizado."), Exercise(id = "pt-foundations-u9-matices-e4", kind = "written", prompt = "Concorde em parte com o relatório, medindo o acordo.", options = listOf(), answers = listOf("ate certo ponto concordo com o relatorio", "até certo ponto, concordo com o relatório"), explain = "Até certo ponto mede o acordo sem negar.")), skills = listOf("function:express-opinion", "speaking:justify-opinion", "grammar:connectors", "vocab:collocations"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "pt-foundations-u9-apresentar", title = "Apresentar ideias", goal = "Estruturar uma fala curta: abrir, encadear e encerrar com clareza.", intro = LessonIntro(explanation = listOf("Abra o ponto: « Para começar, … », « Em primeiro lugar, quero destacar… » — quem ouve já sabe o destino da fala.", "Encadeie sem saltos: « Dito isso, … », « Passando ao próximo ponto », « Volto ao ponto principal ».", "Encerre com fecho claro: « Resumindo, … », « Para encerrar, conto com o apoio de vocês » — fala sem conclusão parece inacabada."), examples = listOf(ExampleLine(text = "Para começar, obrigado pela presença de todos.", meaning = "Abertura."), ExampleLine(text = "Dito isso, passo ao orçamento.", meaning = "Transição."), ExampleLine(text = "Volto ao ponto principal: o prazo.", meaning = "Recentrar."), ExampleLine(text = "Resumindo, os números nos favorecem.", meaning = "Síntese."), ExampleLine(text = "Para encerrar, conto com o apoio de vocês.", meaning = "Fecho com pedido."))), expressions = listOf(TargetExpression(text = "para começar, …", meaning = "Abrir a fala.", note = "…obrigado pela presença."), TargetExpression(text = "dito isso, …", meaning = "Transição entre pontos.", note = "Dito isso, passo ao orçamento."), TargetExpression(text = "voltar ao ponto (principal)", meaning = "Recentrar o assunto.", note = "Volto ao ponto: o prazo."), TargetExpression(text = "resumindo, …", meaning = "Sintetizar.", note = "Resumindo, o ano foi bom."), TargetExpression(text = "para encerrar, …", meaning = "Fechar com pedido.", note = "…conto com o apoio de vocês.")), situation = "Cada um apresenta em um minuto a ideia que defende na reunião: abre, sustenta com um dado e encerra pedindo algo concreto ao time.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Abra a fala: para começar, obrigado pela presença de todos.", expected = listOf("para comecar obrigado pela presenca de todos", "para começar, obrigado pela presença de todos"), focus = "para começar", watch = "Abertura clara."), PracticeQuestion(prompt = "Transição: dito isso, passo ao orçamento.", expected = listOf("dito isso passo ao orcamento", "dito isso, passo ao orçamento"), focus = "dito isso", watch = "Particípio como conector."), PracticeQuestion(prompt = "Recentre: volto ao ponto principal, o prazo.", expected = listOf("volto ao ponto principal o prazo", "volto ao ponto principal, o prazo"), focus = "voltar ao ponto", watch = "Recentrar sem se perder."), PracticeQuestion(prompt = "Sintetize: resumindo, os números nos favorecem.", expected = listOf("resumindo os numeros nos favorecem", "resumindo, os números nos favorecem"), focus = "resumindo", watch = "Síntese do balanço."), PracticeQuestion(prompt = "Encerre com pedido: para encerrar, conto com o apoio de vocês.", expected = listOf("para encerrar conto com o apoio de voces", "para encerrar, conto com o apoio de vocês"), focus = "para encerrar", watch = "Fecho + pedido concreto."))), exercises = listOf(Exercise(id = "pt-foundations-u9-apresentar-e1", kind = "choice", prompt = "___ encerrar, conto com o apoio de vocês.", options = listOf("Para", "Ao", "Em", "No"), answers = listOf("Para"), explain = "Fecho de fala: para encerrar."), Exercise(id = "pt-foundations-u9-apresentar-e2", kind = "gap", prompt = "___ isso, passo ao próximo ponto. (particípio de dizer)", options = listOf(), answers = listOf("dito"), explain = "Particípio como conector: dito isso."), Exercise(id = "pt-foundations-u9-apresentar-e3", kind = "order", prompt = "Sintetize o balanço do ano para a diretoria.", options = listOf(), answers = listOf("Resumindo, os números nos favorecem"), explain = "Resumindo + conclusão."), Exercise(id = "pt-foundations-u9-apresentar-e4", kind = "written", prompt = "Abra sua fala agradecendo quem veio.", options = listOf(), answers = listOf("para comecar obrigado pela presenca de todos", "para começar, obrigado pela presença de todos"), explain = "Para começar + agradecimento.")), skills = listOf("speaking:sustained-conversation", "function:talk-about-work", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "pt-foundations-u9-debater", title = "De acordo em desacordo", goal = "Discordar com jeito: reconhecer o ponto do outro e marcar a diferença.", intro = LessonIntro(explanation = listOf("Discordar sem brigar: primeiro reconheça, depois marque. « Entendo o seu ponto, mas vejo por outro ângulo ».", "Suavize com conectores: « por um lado… por outro… », « até certo ponto ». « Até certo ponto concordo; por outro lado, o prazo não fecha ».", "Feche o desacordo com respeito: « Concordo em discordar ». « Fica registrado o meu voto contrário »."), examples = listOf(ExampleLine(text = "Entendo o seu ponto, mas discordo do tamanho.", meaning = "Reconhecer + marcar."), ExampleLine(text = "Por um lado, é mais barato; por outro, demora mais.", meaning = "Pesar os lados."), ExampleLine(text = "Até certo ponto, você tem razão.", meaning = "Concordância parcial."), ExampleLine(text = "Não é bem assim: os dados dizem outra coisa.", meaning = "Discordar com base."), ExampleLine(text = "Concordo em discordar, com carinho.", meaning = "Fechar com respeito."))), expressions = listOf(TargetExpression(text = "entendo o seu ponto, mas…", meaning = "Reconhecer antes de discordar.", note = "Entendo o seu ponto, mas…"), TargetExpression(text = "por um lado… por outro…", meaning = "Pesar os lados.", note = "Por um lado sim; por outro, não."), TargetExpression(text = "até certo ponto", meaning = "Concordância parcial.", note = "Até certo ponto, procede."), TargetExpression(text = "não é bem assim", meaning = "Discordar com base.", note = "Não é bem assim, veja os dados."), TargetExpression(text = "concordo em discordar", meaning = "Fechar o desacordo.", note = "Fica a nossa diferença.")), situation = "Num debate da empresa, vocês discordam do formato do evento: cada um reconhece o ponto do outro e defende o seu — sem desgastar a relação.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Discorde reconhecendo o ponto do outro: o projeto é bom, mas caro.", expected = listOf("Entendo o seu ponto, mas o projeto é caro.", "Entendo o seu ponto, mas discordo do preço."), focus = "entendo o seu ponto", watch = "reconhecer + mas."), PracticeQuestion(prompt = "Pese os lados: mais barato, porém demorado.", expected = listOf("Por um lado, é mais barato; por outro, é demorado.", "Por um lado é mais barato por outro é demorado"), focus = "por um lado/por outro", watch = "estrutura em dois tempos."), PracticeQuestion(prompt = "Dê uma concordância parcial.", expected = listOf("Até certo ponto, você tem razão.", "ate certo ponto voce tem razao"), focus = "até certo ponto", watch = "concordância parcial."), PracticeQuestion(prompt = "Discorde com base nos dados.", expected = listOf("Não é bem assim: os dados dizem outra coisa.", "Não é bem assim."), focus = "não é bem assim", watch = "discordar com base."), PracticeQuestion(prompt = "Feche o desacordo com respeito.", expected = listOf("Concordo em discordar.", "Concordo em discordar, com respeito."), focus = "concordo em discordar", watch = "fecho elegante."))), exercises = listOf(Exercise(id = "pt-foundations-u9-debater-e1", kind = "choice", prompt = "___ o seu ponto, mas o prazo não fecha.", options = listOf("Entendo", "Recuso", "Ignoro", "Duvido"), answers = listOf("Entendo"), explain = "Entendo o seu ponto, mas…: discordar com jeito."), Exercise(id = "pt-foundations-u9-debater-e2", kind = "gap", prompt = "Por um ___, é mais barato; por outro, demora.", options = listOf(), answers = listOf("lado"), explain = "por um lado… por outro…: pesar os lados."), Exercise(id = "pt-foundations-u9-debater-e3", kind = "order", prompt = "Discorde com jeito: reconheça e marque a diferença.", options = listOf(), answers = listOf("Entendo o seu ponto mas discordo"), explain = "reconhecer + mas: o desacordo elegante."), Exercise(id = "pt-foundations-u9-debater-e4", kind = "written", prompt = "Feche o desacordo com respeito.", options = listOf(), answers = listOf("concordo em discordar", "Concordo em discordar."), explain = "Concordo em discordar: fecho respeitoso.")), skills = listOf("function:express-opinion", "speaking:sustained-conversation", "grammar:connectors", "speaking:justify-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "pt-foundations-u9-tom", title = "O tom exato", goal = "Ajustar o tom exato: colocações precisas e o registro certo para cada leitor.", intro = LessonIntro(explanation = listOf("A colocação exata faz o tom: « tomar uma decisão » (não « fazer »), « estar com saudade de » (colocação fixa).", "Verbos precisos elevam o texto: « levantar uma hipótese », « ponderar os prós e os contras ». « Ponderei os prós e os contras antes de me posicionar ».", "Para o tema delicado, suavize e feche sem alongar: « por assim dizer », « prefiro não me alongar ». « Foi, por assim dizer, um recomeço »."), examples = listOf(ExampleLine(text = "Precisamos tomar uma decisão hoje.", meaning = "decisão: tomar, não fazer."), ExampleLine(text = "Estou com saudade do time antigo.", meaning = "estar com saudade de: colocação fixa."), ExampleLine(text = "Levanto uma hipótese: o prazo era curto.", meaning = "levantar uma hipótese."), ExampleLine(text = "Ponderei os prós e os contras.", meaning = "Ponderar: pesar com cuidado."), ExampleLine(text = "Foi, por assim dizer, um recomeço.", meaning = "A suavização do registro."))), expressions = listOf(TargetExpression(text = "tomar uma decisão", meaning = "A colocação exata (não fazer).", note = "Quem toma a decisão ?"), TargetExpression(text = "estar com saudade de", meaning = "Sentir falta: colocação fixa.", note = "Estou com saudade daquele café."), TargetExpression(text = "levantar uma hipótese", meaning = "Propor uma ideia.", note = "Levanto uma hipótese no relatório."), TargetExpression(text = "ponderar os prós e os contras", meaning = "Pesar antes de decidir.", note = "Pondere os prós e os contras."), TargetExpression(text = "por assim dizer", meaning = "Suavizar a afirmação.", note = "Foi, por assim dizer, um recomeço.")), situation = "Na revisão do ensaio: vocês trocam colocações vagas pelas exatas e calibram o tom de cada parágrafo para o leitor certo.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Corrija a colocação: fazer uma decisão.", expected = listOf("Tomar uma decisão.", "tomar uma decisao"), focus = "colocação exata", watch = "decisão se toma, não se faz."), PracticeQuestion(prompt = "Diga que sente falta da cidade, com a colocação fixa.", expected = listOf("Estou com saudade da cidade.", "estou com saudade da cidade", "Estou com saudades da cidade.", "estou com saudades da cidade"), focus = "estar com saudade de", watch = "colocação fixa: estar com, não ter."), PracticeQuestion(prompt = "Proponha uma ideia no relatório, com o verbo de hipótese.", expected = listOf("Levanto uma hipótese no relatório.", "levanto uma hipotese no relatorio"), focus = "levantar uma hipótese", watch = "levanto = propongo."), PracticeQuestion(prompt = "Diga que pesou os lados antes de decidir (verbo ponderar).", expected = listOf("Ponderei os prós e os contras antes de decidir.", "ponderei os pros e os contras antes de decidir", "Ponderei os prós e os contras.", "ponderei os pros e os contras"), focus = "ponderar", watch = "ponderar = sopesar."), PracticeQuestion(prompt = "Suavize a afirmação com a fórmula pronta.", expected = listOf("Foi, por assim dizer, um recomeço.", "foi por assim dizer um recomeco", "por assim dizer"), focus = "por assim dizer", watch = "o recuo elegante."))), exercises = listOf(Exercise(id = "pt-foundations-u9-tom-e1", kind = "choice", prompt = "Precisamos ___ uma decisão hoje.", options = listOf("tomar", "fazer", "pegar", "dar"), answers = listOf("tomar"), explain = "tomar uma decisão: a colocação exata; « fazer » soa estranho."), Exercise(id = "pt-foundations-u9-tom-e2", kind = "gap", prompt = "Estou ___ saudade daquele projeto.", options = listOf(), answers = listOf("com"), explain = "estar com saudade de: a colocação fixa."), Exercise(id = "pt-foundations-u9-tom-e3", kind = "order", prompt = "Diga que propõe uma ideia por escrito.", options = listOf(), answers = listOf("Levanto uma hipótese no relatório"), explain = "levantar uma hipótese: propor a ideia com o verbo preciso."), Exercise(id = "pt-foundations-u9-tom-e4", kind = "written", prompt = "Diga que sopesou os lados antes de decidir (use ponderar).", options = listOf(), answers = listOf("Ponderei os prós e os contras antes de decidir.", "ponderei os pros e os contras antes de decidir"), explain = "ponderar os prós e os contras: pesar antes de decidir.")), skills = listOf("vocab:collocations", "function:express-opinion", "writing:argument", "grammar:connectors"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:connectors"))))
}

object PtWorkU1 {
    val unit = CourseUnit(id = "pt-work-u1", title = "O dia profissional", subtitle = "Reuniões, e-mails e entrevistas", level = "B1", themes = listOf(ConversationTheme("reuniao-pauta", "Na reunião", "Opinar e propor", "bubble.left.and.text.bubble.right", "Course", "Na reunião de segunda: o time opina sobre o prazo, propõe caminhos e fecha a semana com acordo.", 0),
                ConversationTheme("email-entrevista", "E-mail e entrevista", "Formalidade que abre portas", "person.badge.key", "Course", "Do e-mail formal ao cliente à entrevista de emprego: registro certo, experiência e conquistas bem contadas.", 1)), lessons = listOf(    Lesson(id = "pt-work-u1-reunioes", title = "Nas reuniões", goal = "Opinar e propor em reunião: na minha opinião…, sugiro…, por isso…, de acordo.", intro = LessonIntro(explanation = listOf("Opine com marcação clara: « na minha opinião », « eu acho que ». « Na minha opinião, o prazo é curto ».", "Proponha com « sugiro » ou « que tal »: « Sugiro dividir a tarefa ». « Que tal começar pela pauta ? ».", "Pese com conectores: « por um lado …, por outro … », e conclua com « por isso ». Feche em acordo: « de acordo »."), examples = listOf(ExampleLine(text = "Na minha opinião, o prazo é curto demais.", meaning = "Marcar a opinião."), ExampleLine(text = "Sugiro dividir a tarefa em duas.", meaning = "sugiro = sugiero."), ExampleLine(text = "Por um lado ganhamos tempo; por outro, perdemos detalhes.", meaning = "Os dois lados na pauta."), ExampleLine(text = "Por isso, prefiro testar antes.", meaning = "por isso = por eso."), ExampleLine(text = "Ficou claro ? — De acordo.", meaning = "O fechamento da reunião."))), expressions = listOf(TargetExpression(text = "Na minha opinião, …", meaning = "Marcar a opinião.", note = "Na minha opinião, falta tempo."), TargetExpression(text = "Sugiro + verbo", meaning = "Propor em reunião.", note = "Sugiro começar pelo relatório."), TargetExpression(text = "Por um lado …, por outro …", meaning = "Pesar a decisão.", note = "Por um lado, sim; por outro, não."), TargetExpression(text = "Por isso, …", meaning = "Concluir.", note = "Por isso, peço prazo."), TargetExpression(text = "De acordo", meaning = "Fechar em acordo.", note = "De acordo, fechado.")), situation = "Na reunião de segunda: o time discute o prazo do cliente, a Ana sugere dividir a tarefa e todos fecham de acordo com o plano B.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Opine sobre o prazo.", expected = listOf("Na minha opinião, o prazo é curto demais.", "na minha opiniao o prazo e curto demais"), focus = "marcador", watch = "na minha opinião = en mi opinión."), PracticeQuestion(prompt = "Proponha dividir a tarefa.", expected = listOf("Sugiro dividir a tarefa em duas.", "sugiro dividir a tarefa em duas"), focus = "propor", watch = "sugiro + infinitivo."), PracticeQuestion(prompt = "Pese a decisão com os dois lados.", expected = listOf("Por um lado ganhamos tempo; por outro, perdemos detalhes.", "por um lado ganhamos tempo por outro perdemos detalhes"), focus = "os dois lados", watch = "o par fixo da reunião."), PracticeQuestion(prompt = "Conclua com por isso.", expected = listOf("Por isso, prefiro testar antes.", "por isso prefiro testar antes"), focus = "concluir", watch = "por isso = por eso."), PracticeQuestion(prompt = "Responda concordando com a decisão.", expected = listOf("De acordo.", "de acordo", "De acordo com o plano.", "de acordo com o plano"), focus = "fechar", watch = "de acordo = de acuerdo."))), exercises = listOf(Exercise(id = "pt-work-u1-reunioes-e1", kind = "choice", prompt = "___ minha opinião, a pauta está cheia.", options = listOf("Na", "Em", "No", "Para"), answers = listOf("Na"), explain = "na minha opinião: a fórmula fixa com a contração na."), Exercise(id = "pt-work-u1-reunioes-e2", kind = "gap", prompt = "Sugiro ___ a reunião para quinta. (mudar)", options = listOf(), answers = listOf("mudar"), explain = "sugiro + infinitivo: a proposta direta."), Exercise(id = "pt-work-u1-reunioes-e3", kind = "order", prompt = "Conclua a sua fala na reunião.", options = listOf(), answers = listOf("Por isso prefiro testar antes"), explain = "por isso + decisão: o conector que fecha o argumento."), Exercise(id = "pt-work-u1-reunioes-e4", kind = "written", prompt = "Responda concordando com a decisão.", options = listOf(), answers = listOf("De acordo.", "de acordo", "De acordo com o plano.", "de acordo com o plano"), explain = "De acordo: o fechamento em acordo da reunião.")), skills = listOf("function:talk-about-work", "function:express-opinion", "grammar:connectors", "vocab:work"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "pt-work-u1-emails", title = "E-mails formais", goal = "Escrever um e-mail formal: Prezado…, escrevo para…, desde já agradeço, Atenciosamente.", intro = LessonIntro(explanation = listOf("Abra com « Prezado(a) » ou « Olá, + nome »: « Prezado Sr. Alves ».", "O objetivo vem na primeira linha: « Escrevo para confirmar a reunião ». Direto, sem rodeio.", "O pedido com prazo: « Gostaria de receber o relatório até sexta ». Feche com « Atenciosamente »; « Abraços » fica para o time interno."), examples = listOf(ExampleLine(text = "Prezado Sr. Alves,", meaning = "A saudação formal."), ExampleLine(text = "Escrevo para confirmar a reunião de quinta.", meaning = "O objetivo na linha um."), ExampleLine(text = "Gostaria de receber o relatório até sexta-feira.", meaning = "gostaria de = quisiera."), ExampleLine(text = "Desde já, agradeço a atenção.", meaning = "desde já = desde ya."), ExampleLine(text = "Atenciosamente, Ana Duarte", meaning = "A despedida formal."))), expressions = listOf(TargetExpression(text = "Prezado(a) Sr.(a) …", meaning = "A saudação formal.", note = "Prezada Sra. Duarte,"), TargetExpression(text = "Escrevo para + verbo", meaning = "O objetivo na primeira linha.", note = "Escrevo para pedir um orçamento."), TargetExpression(text = "Gostaria de + verbo", meaning = "O pedido formal.", note = "Gostaria de agendar uma visita."), TargetExpression(text = "Desde já, agradeço", meaning = "Agradecer antes da resposta.", note = "Desde já, agradeço."), TargetExpression(text = "Atenciosamente", meaning = "A despedida formal.", note = "Atenciosamente, Ana")), situation = "E-mail para o cliente: a Ana confirma a reunião, pede o relatório com prazo e fecha com agradecimento e despedida formal.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Abra o e-mail formal para o Sr. Alves.", expected = listOf("Prezado Sr. Alves,", "prezado sr alves"), focus = "saudação", watch = "prezado(a) = estimado(a)."), PracticeQuestion(prompt = "Diga o objetivo: confirmar a reunião.", expected = listOf("Escrevo para confirmar a reunião.", "escrevo para confirmar a reuniao"), focus = "objetivo", watch = "escrevo para + infinitivo."), PracticeQuestion(prompt = "Peça o relatório até sexta, formal.", expected = listOf("Gostaria de receber o relatório até sexta-feira.", "gostaria de receber o relatorio ate sexta feira"), focus = "pedido formal", watch = "gostaria de = quisiera."), PracticeQuestion(prompt = "Agradeça antes da resposta.", expected = listOf("Desde já, agradeço a atenção.", "desde ja agradeco a atencao"), focus = "agradecer", watch = "desde já = desde ya."), PracticeQuestion(prompt = "Escolha a despedida formal.", expected = listOf("Atenciosamente,", "atenciosamente", "Atenciosamente, Ana", "atenciosamente ana"), focus = "despedida", watch = "abraços fica para o time interno."))), exercises = listOf(Exercise(id = "pt-work-u1-emails-e1", kind = "choice", prompt = "___ Sr. Alves,", options = listOf("Prezado", "Olá tudo", "E aí", "Valeu"), answers = listOf("Prezado"), explain = "Prezado(a): a saudação formal do e-mail; « e aí » é para amigos."), Exercise(id = "pt-work-u1-emails-e2", kind = "gap", prompt = "___ de receber o relatório até sexta.", options = listOf(), answers = listOf("Gostaria", "gostaria"), explain = "gostaria de + infinitivo: o pedido formal."), Exercise(id = "pt-work-u1-emails-e3", kind = "order", prompt = "Agradeça antes da resposta, no e-mail.", options = listOf(), answers = listOf("Desde já agradeço a atenção"), explain = "Desde já, agradeço: o agradecimento antes da resposta."), Exercise(id = "pt-work-u1-emails-e4", kind = "written", prompt = "Feche o e-mail formal.", options = listOf(), answers = listOf("Atenciosamente,", "atenciosamente", "Atenciosamente, Ana Duarte", "atenciosamente ana duarte"), explain = "Atenciosamente: a despedida formal do e-mail.")), skills = listOf("writing:email", "function:make-requests", "vocab:work", "grammar:connectors"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:connectors")),
    Lesson(id = "pt-work-u1-entrevistas", title = "Entrevistas", goal = "Falar de experiência e conquistas: já trabalhei…, nunca…, minha meta é….", intro = LessonIntro(explanation = listOf("A experiência com « já + pretérito »: « Já trabalhei com clientes grandes ». « Nunca liderei um time grande ».", "A conquista com resultado: « Aumentei as vendas em vinte por cento ». Números convencem.", "A meta com « quero »: « Minha meta é liderar um time ». « A longo prazo, quero… »."), examples = listOf(ExampleLine(text = "Já trabalhei com clientes grandes.", meaning = "A experiência que conta."), ExampleLine(text = "Nunca liderei um time, mas coordenei projetos.", meaning = "O que ainda não veio."), ExampleLine(text = "Aumentei as vendas em vinte por cento.", meaning = "A conquista com número."), ExampleLine(text = "Minha meta é liderar um time este ano.", meaning = "A meta clara."), ExampleLine(text = "A longo prazo, quero trabalhar com estratégia.", meaning = "longo prazo = largo plazo."))), expressions = listOf(TargetExpression(text = "Já + pretérito", meaning = "A experiência que conta.", note = "Já trabalhei no exterior."), TargetExpression(text = "Nunca + pretérito", meaning = "O que ainda não veio.", note = "Nunca gerenciei um time."), TargetExpression(text = "Aumentei / reduzi … em …", meaning = "A conquista medida.", note = "Reduzi custos em dez por cento."), TargetExpression(text = "Minha meta é …", meaning = "A meta declarada.", note = "Minha meta é liderar."), TargetExpression(text = "A longo prazo, …", meaning = "O horizonte maior.", note = "A longo prazo, quero crescer.")), situation = "Na entrevista: a Ana conta o que já fez, apresenta uma conquista com número e fala da meta de liderar um time.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga que já trabalhou com clientes grandes.", expected = listOf("Já trabalhei com clientes grandes.", "ja trabalhei com clientes grandes"), focus = "experiência", watch = "já = ya."), PracticeQuestion(prompt = "Diga o que nunca fez: liderar um time.", expected = listOf("Nunca liderei um time.", "nunca liderei um time"), focus = "nunca", watch = "nunca + pretérito."), PracticeQuestion(prompt = "Conte a conquista: vendas +20 %.", expected = listOf("Aumentei as vendas em vinte por cento.", "aumentei as vendas em vinte por cento"), focus = "conquista", watch = "números convencem."), PracticeQuestion(prompt = "Diga sua meta: liderar um time.", expected = listOf("Minha meta é liderar um time.", "minha meta e liderar um time"), focus = "meta", watch = "meta = meta/objetivo."), PracticeQuestion(prompt = "Fale do longo prazo: estratégia.", expected = listOf("A longo prazo, quero trabalhar com estratégia.", "a longo prazo quero trabalhar com estrategia"), focus = "longo prazo", watch = "a longo prazo = a largo plazo."))), exercises = listOf(Exercise(id = "pt-work-u1-entrevistas-e1", kind = "choice", prompt = "___ trabalhei com clientes grandes.", options = listOf("Já", "Ainda", "Talvez", "Quase"), answers = listOf("Já"), explain = "Já + pretérito: a experiência que já aconteceu."), Exercise(id = "pt-work-u1-entrevistas-e2", kind = "gap", prompt = "Minha ___ é liderar um time.", options = listOf(), answers = listOf("meta"), explain = "meta = objetivo: a palavra da entrevista."), Exercise(id = "pt-work-u1-entrevistas-e3", kind = "order", prompt = "Conte a conquista com número.", options = listOf(), answers = listOf("Aumentei as vendas em vinte por cento"), explain = "Aumentar … em + número: a conquista medida."), Exercise(id = "pt-work-u1-entrevistas-e4", kind = "written", prompt = "Fale do longo prazo: estratégia.", options = listOf(), answers = listOf("A longo prazo, quero trabalhar com estratégia.", "a longo prazo quero trabalhar com estrategia"), explain = "A longo prazo, quero…: o horizonte da carreira.")), skills = listOf("function:talk-about-work", "grammar:present-perfect", "vocab:work", "function:describe-goals"), canDo = listOf("talk-about-work"), prerequisites = listOf("grammar:present-perfect"))))
}

