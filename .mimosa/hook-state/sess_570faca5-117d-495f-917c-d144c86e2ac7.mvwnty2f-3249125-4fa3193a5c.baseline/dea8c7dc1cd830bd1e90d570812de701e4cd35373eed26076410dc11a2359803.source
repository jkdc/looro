    Lesson(id = "es-foundations-u16-habitos", title = "Vida sana", goal = "Hablar de hábitos con siempre y nunca: siempre desayuno fruta; nunca fumo.", intro = LessonIntro(explanation = listOf("Con siempre hablas de algo que haces todos los días: «Siempre desayuno fruta». Va antes del verbo.", "Con nunca hablas de algo que no haces: «Nunca fumo». «Nunca como dulces».", "También usas a veces y todos los días: «A veces camino al trabajo». «Bebo agua todos los días»."), examples = listOf(ExampleLine(text = "Siempre desayuno fruta.", meaning = "Un hábito de cada día."), ExampleLine(text = "Nunca fumo.", meaning = "Un hábito sano."), ExampleLine(text = "Bebo agua todos los días.", meaning = "Beber mucha agua."), ExampleLine(text = "A veces camino al trabajo.", meaning = "Algunos días, no todos."), ExampleLine(text = "Duermo ocho horas todas las noches.", meaning = "Dormir bien."))), expressions = listOf(TargetExpression(text = "siempre + verbo", meaning = "Todos los días.", note = "Siempre ceno temprano."), TargetExpression(text = "nunca + verbo", meaning = "Ningún día.", note = "Nunca bebo refrescos."), TargetExpression(text = "todos los días", meaning = "Cada día.", note = "Camino todos los días."), TargetExpression(text = "dormir ocho horas", meaning = "Dormir toda la noche.", note = "Duermo ocho horas."), TargetExpression(text = "hacer deporte", meaning = "Correr, nadar, bailar…", note = "Hago deporte los sábados.")), situation = "Tu vida sana: siempre desayunas fruta, caminas todos los días, duermes ocho horas y nunca bebes refrescos.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Di que desayunas fruta todos los días.", expected = listOf("Siempre desayuno fruta", "siempre desayuno fruta", "Desayuno fruta todos los días", "desayuno fruta todos los dias"), focus = "siempre", watch = "siempre va antes del verbo."), PracticeQuestion(prompt = "Di que no fumas, ningún día.", expected = listOf("Nunca fumo", "nunca fumo", "No fumo nunca"), focus = "nunca", watch = "nunca va antes del verbo: nunca fumo."), PracticeQuestion(prompt = "Di que caminas al trabajo a veces.", expected = listOf("A veces camino al trabajo", "a veces camino al trabajo", "Camino al trabajo a veces"), focus = "a veces", watch = "a veces = algunos días, no todos."), PracticeQuestion(prompt = "Di que bebes mucha agua.", expected = listOf("Bebo mucha agua", "bebo mucha agua", "Bebo agua todos los días", "bebo agua todos los dias"), focus = "bebo agua", watch = "El agua es sana: bebe mucha agua."), PracticeQuestion(prompt = "Di que duermes ocho horas.", expected = listOf("Duermo ocho horas", "duermo ocho horas", "Duermo ocho horas todas las noches"), focus = "duermo", watch = "dormir → duermo (o → ue)."))), exercises = listOf(Exercise(id = "es-foundations-u16-habitos-e1", kind = "choice", prompt = "No comes dulces, ni un día: «___ como dulces».", options = listOf("Nunca", "Siempre", "Todos los días", "Mucho"), answers = listOf("Nunca"), explain = "Cero dulces: nunca como dulces."), Exercise(id = "es-foundations-u16-habitos-e2", kind = "gap", prompt = "Es una costumbre de cada día: ___ desayuno yogur.", options = listOf(), answers = listOf("Siempre"), explain = "Cada día: siempre desayuno yogur."), Exercise(id = "es-foundations-u16-habitos-e3", kind = "order", prompt = "Habla de tu hábito con la fruta: cada mañana.", options = listOf(), answers = listOf("Siempre desayuno fruta"), explain = "Cada mañana: siempre + desayuno + fruta."), Exercise(id = "es-foundations-u16-habitos-e4", kind = "written", prompt = "Habla del agua: es tu bebida de cada día.", options = listOf(), answers = listOf("Bebo agua todos los días", "bebo agua todos los dias", "Tomo agua todos los días", "tomo agua todos los dias"), explain = "Cada día = todos los días: bebo agua todos los días.")), skills = listOf("grammar:frequency-adverbs", "function:talk-about-routines", "vocab:health", "vocab:daily-routine"), canDo = listOf("talk-about-routines"), prerequisites = listOf("