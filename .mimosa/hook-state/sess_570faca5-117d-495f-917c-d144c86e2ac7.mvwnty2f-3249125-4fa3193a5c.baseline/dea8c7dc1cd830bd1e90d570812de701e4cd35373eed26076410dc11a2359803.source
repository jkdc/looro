ozinha não tem mesa.", "na cozinha nao tem mesa"), focus = "não tem", watch = "não tem = no hay."), PracticeQuestion(prompt = "Pergunte se tem varanda.", expected = listOf("Tem varanda ?", "O apartamento tem varanda ?"), focus = "tem … ?", watch = "Tem + coisa ?"), PracticeQuestion(prompt = "Fale do tamanho do quarto.", expected = listOf("O quarto é pequeno.", "o quarto e pequeno"), focus = "ser + adjetivo", watch = "é pequeno = es pequeño."), PracticeQuestion(prompt = "Diga o que tem na sala: um sofá e uma TV.", expected = listOf("Na sala tem um sofá e uma TV.", "Na sala tem um sofa e uma TV.", "Tem um sofá e uma TV na sala."), focus = "onde + tem", watch = "Na + cômodo + tem."))), exercises = listOf(Exercise(id = "pt-foundations-u10-casa-e1", kind = "choice", prompt = "___ dois quartos no apartamento.", options = listOf("Tem", "Está", "Faz", "Vai"), answers = listOf("Tem"), explain = "« tem » fala do que existe na casa."), Exercise(id = "pt-foundations-u10-casa-e2", kind = "gap", prompt = "Na cozinha ___ uma geladeira nova.", options = listOf(), answers = listOf("tem"), explain = "tem + coisa: o que existe no cômodo."), Exercise(id = "pt-foundations-u10-casa-e3", kind = "order", prompt = "Fale do que o prédio não tem.", options = listOf(), answers = listOf("Nao tem garagem"), explain = "não tem + coisa que falta."), Exercise(id = "pt-foundations-u10-casa-e4", kind = "written", prompt = "Fale do tamanho do quarto.", options = listOf(), answers = listOf("O quarto é pequeno.", "o quarto e pequeno"), explain = "ser + adjetivo: é pequeno.")), skills = listOf("grammar:there-is-are", "grammar:present-simple", "vocab:home", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u10-lugares", title = "Onde está ?", goal = "Dizer onde as coisas estão: em cima de, embaixo de, ao lado de.", intro = LessonIntro(explanation = listOf("Perguntar o lugar: « Onde está a chave ? ». A resposta usa « está »: « Está na mesa ».", "As preposições: « em cima de » (sobre), « embaixo de » (debaixo), « ao lado de » (al lado). « A chave está em cima da mesa ».", "em + a = na, em + o = no. « O livro está na gaveta ». « A carteira está no bolso »."), examples = listOf(ExampleLine(text = "Onde está a chave ?", meaning = "Perguntar o lugar."), ExampleLine(text = "Está em cima da mesa.", meaning = "sobre la mesa."), ExampleLine(text = "Está embaixo da cama.", meaning = "debajo de la cama."), ExampleLine(text = "A cadeira está ao lado da janela.", meaning = "al lado de."), ExampleLine(text = "O celular está dentro da bolsa.", meaning = "dentro de."))), expressions = listOf(TargetExpression(text = "Onde está … ?", meaning = "Perguntar o lugar.", note = "…a chave ?"), TargetExpression(text = "em cima de", meaning = "Sobre.", note = "em cima da mesa."), TargetExpression(text = "embaixo de", meaning = "Debaixo de.", note = "embaixo da cama."), TargetExpression(text = "ao lado de", meaning = "Al lado de.", note = "ao lado da porta."), TargetExpression(text = "dentro de", meaning = "Dentro de.", note = "dentro da bolsa.")), situation = "A chave do armário não aparece: procuram no quarto e encontram embaixo da cama.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Pergunte o lugar da chave.", expected = listOf("Onde está a chave ?", "onde esta a chave"), focus = "onde está", watch = "Onde está = ¿dónde está?"), PracticeQuestion(prompt = "Diga o lugar do livro: sobre a mesa.", expected = listOf("O livro está em cima da mesa.", "o livro esta em cima da mesa"), focus = "em cima de", watch = "em cima de = sobre."), PracticeQuestion(prompt = "Diga o lugar do gato: debaixo da cama.", expected = listOf("O gato está embaixo da cama.", "o gato esta embaixo da cama"), focus = "embaixo de", watch = "embaixo de = debajo de."), PracticeQuestion(prompt = "Diga o lugar da cadeira: ao lado da janela.", expected = listOf("A cadeira está ao lado da janela.", "a cadeira esta ao lado da janela"), focus = "ao lado de", watch = "ao lado de = al lado de."), PracticeQuestion(prompt = "Diga o lugar do celular: dentro da gaveta.", expected = listOf("O celular está dentro da gaveta.", "o celular esta dentro da gaveta"), focus = "dentro de", watch = "dentro de = dentro de."))), exercises = listOf(Exercise(id = "pt-foundations-u10-lugares-e1", kind = "choice", prompt = "Onde ___ a chave ?", options = listOf("está", "é", "tem", "faz"), answers = listOf("está"), explain = "Onde está = ¿dónde está?"), Exercise(id = "pt-foundations-u10-lugares-e2", kind = "gap", prompt = "O gato dorme ___ da cama.", options = listOf(), answers = listOf("embaixo"), explain = "embaixo de = debajo de."), Exercise(id = "pt-foundations-u10-lugares-e3", kind = "order", prompt = "Diga o lugar da cadeira. (ao lado + mesa)", options = listOf(), answers = listOf("A cadeira esta ao lado da mesa"), explain = "ao lado de + lugar."), Exercise(id = "pt-foundations-u10-lugares-e4", kind = "written", prompt = "Diga onde está o celular. (dentro + bolsa)", options = listOf(), answers = listOf("O celular está dentro da bolsa.", "o celular esta dentro da bolsa"), explain = "dentro de + lugar.")), skills = listOf("grammar:prepositions-place", "grammar:there-is-are", "vocab:home", "function:ask-simple-questions"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:present-simple")),
    Lesson(id = "pt-foundations-u10-colega", title = "Meu colega de casa", goal = "Descrever o colega de casa e usar os possessivos meu, minha, seu.", intro = LessonIntro(explanation = listOf("Os possessivos: « meu » (masc), « minha » (fem). « Meu colega cozinha bem ». « Minha colega estuda à noite ».", "Para falar do outro: « seu, sua ». « Como é o seu colega ? » « A sua casa é grande ? »", "Descrever com « ser »: « Ele é alto e tranquilo ». « Ela é organizada e muito calma »."), examples = listOf(ExampleLine(text = "Meu colega de casa é do Rio.", meaning = "meu + masc."), ExampleLine(text = "Minha colega estuda medicina.", meaning = "minha + fem."), ExampleLine(text = "O seu quarto é arrumado.", meaning = "seu = su."), ExampleLine(text = "Ele cozinha muito bem.", meaning = "Descrever."), ExampleLine(text = "Ela é calma e organizada.", meaning = "ser + adjetivo."))), expressions = listOf(TargetExpression(text = "meu / minha", meaning = "Possessivo: mi, mio.", note = "meu quarto, minha casa."), TargetExpression(text = "seu / sua", meaning = "Possessivo dele/dela.", note = "seu colega, sua sala."), TargetExpression(text = "colega de casa", meaning = "Quem mora junto.", note = "Divido a casa com ele."), TargetExpression(text = "Ele/Ela é …", meaning = "Descrever pessoa.", note = "Ele é alto."), TargetExpression(text = "muito + adjetivo", meaning = "Intensidade.", note = "muito calma.")), situation = "O Rafa chega como novo colega de casa: alto, tranquilo e cozinha aos domingos.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Diga que o seu colega cozinha bem. (use meu)", expected = listOf("Meu colega cozinha bem.", "meu colega cozinha bem"), focus = "meu", watch = "meu + palavra masculina."), PracticeQuestion(prompt = "Diga que a sua casa é pequena. (use minha)", expected = listOf("Minha casa é pequena.", "minha casa e pequena"), focus = "minha", watch = "minha + palavra feminina."), PracticeQuestion(prompt = "Pergunte como é o colega de casa dele.", expected = listOf("Como é o seu colega de casa ?", "como e o seu colega de casa"), focus = "seu", watch = "seu = de você."), PracticeQuestion(prompt = "Descreva o Rafa: alto e tranquilo.", expected = listOf("O Rafa é alto e tranquilo.", "Ele é alto e tranquilo.", "o rafa e alto e tranquilo"), focus = "ser + adjetivo", watch = "adjetivo concorda com a pessoa."), PracticeQuestion(prompt = "Diga que a sala dela é organizada.", expected = listOf("A sala dela é organizada.", "a sala dela e organizada"), focus = "descrever", watch = "organizada (fem)."))), exercises = listOf(Exercise(id = "pt-foundations-u10-colega-e1", kind = "choice", prompt = "___ colega cozinha muito bem.", options = listOf("Meu", "Minha", "Meus", "Minhas"), answers = listOf("Meu"), explain = "meu + palavra masculina: o colega."), Exercise(id = "pt-foundations-u10-colega-e2", kind = "gap", prompt = "___ quarto é sempre arrumado. (do colega)", options = listOf(), answers = listOf("Seu"), explain = "seu = o quarto dele."), Exercise(id = "pt-foundations-u10-colega-e3", kind = "order", prompt = "Descreva a sua colega. (muito + calma)", options = listOf(), answers = listOf("A minha colega e muito calma"), explain = "minha + colega + adjetivo."), Exercise(id = "pt-foundations-u10-colega-e4", kind = "written", prompt = "Pergunte ao colega onde está a chave dele.", options = listOf(), answers = listOf("Onde está a sua chave ?", "onde esta a sua chave"), explain = "seu + coisa: a chave dele.")), skills = listOf("grammar:possessives", "function:describe-people", "vocab:home", "grammar:present-simple"), canDo = listOf("describe-home"), prerequisites = listOf("grammar:possessives"))))
}

