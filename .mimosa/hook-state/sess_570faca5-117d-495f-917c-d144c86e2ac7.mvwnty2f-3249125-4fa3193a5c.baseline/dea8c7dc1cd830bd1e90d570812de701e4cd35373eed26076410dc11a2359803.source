    val unit = CourseUnit(id = "it-foundations-u4", title = "Confronti e progetti", subtitle = "Più, meno, futuro", level = "A2", themes = listOf(ConversationTheme("due-appartamenti", "Due appartamenti", "Quale scegliere ?", "house", "Course", "Confrontate due appartamenti: affitto, superficie, quartiere.", 0),
                ConversationTheme("progetti-vacanze", "Progetti di vacanza", "Dove andiamo ?", "airplane", "Course", "Pianificate le vacanze con andare a + infinito.", 1)), lessons = listOf(    Lesson(id = "it-foundations-u4-confronti", title = "Confronti", goal = "Confrontare con più/meno… di e il migliore/peggiore.", intro = LessonIntro(explanation = listOf("Comparativi: più/meno + aggettivo + di. « Questo bar è più caro di quello ». « Meno freddo di ieri ».", "Superlativi: il/la più/meno + aggettivo + di. « Il miglior ristorante della città ».", "Irregolari: buono → migliore, cattivo → peggiore."), examples = listOf(ExampleLine(text = "Questo bar è più caro di quello.", meaning = "più + agg + di."), ExampleLine(text = "Il treno è meno lento del bus.", meaning = "meno + agg."), ExampleLine(text = "È il miglior ristorante della città.", meaning = "il migliore + di."), ExampleLine(text = "Quest'estate è peggiore della scorsa.", meaning = "peggiore = cattivo comparato."), ExampleLine(text = "Così caro come prima.", meaning = "così + agg + come = uguaglianza."))), expressions = listOf(TargetExpression(text = "più … di", meaning = "Più di.", note = "più caro di."), TargetExpression(text = "meno … di", meaning = "Meno di.", note = "meno freddo di."), TargetExpression(text = "il/la più … di", meaning = "Superlativo.", note = "il più alto della classe."), TargetExpression(text = "migliore / peggiore", meaning = "Irregolari.", note = "buono → migliore."), TargetExpression(text = "così … come", meaning = "Uguaglianza.", note = "così caro come prima.")), situation = "Confrontate due appartamenti: affitto, superficie, quartiere — e scegliete il migliore.", practice = LessonPractice(questions = listOf(PracticeQuestion(prompt = "Confronta il prezzo: A 800€, B 1000€.", expected = listOf("L'appartamento A è meno caro del B."), focus = "meno caro", watch = "meno + agg + di."), PracticeQuestion(prompt = "Di' quale è il migliore. (B)", expected = listOf("L'appartamento B è il migliore."), focus = "il migliore", watch = "il migliore + di."), PracticeQuestion(prompt = "Di' che B è peggiore.", expected = listOf("L'appartamento B è peggiore dell'A."), focus = "peggiore", watch = "peggiore di — irregolare."), PracticeQuestion(prompt = "Confronta la posizione: A vicino, B lontano.", expected = listOf("L'appartamento A è più vicino al centro."), focus = "più vicino", watch = "più + agg + a/di."), PracticeQuestion(prompt = "Confronta la dimensione: A 60m², B 80m².", expected = listOf("Il B è più grande dell'A."), focus = "più grande", watch = "più + agg + di."))), exercises = listOf(Exercise(id = "it-foundations-u4-confronti-e1", kind = "choice", prompt = "Questo bar è ___ caro ___ quello.", options = listOf("più … di", "più … che", "così … che", "molto … che"), answers = listOf("più … di"), explain = "più + agg + di."), Exercise(id = "it-foundations-u4-confronti-e2", kind = "gap", prompt = "È il ___ ristorante della città. (buono)", options = listOf(), answers = listOf("migliore"), explain = "buono → il migliore."), Exercise(id = "it-foundations-u4-confronti-e3", kind = "order", prompt = "Confronta il prezzo.", options = listOf(), answers = listOf("Questo e meno caro di quello"), explain = "meno + agg + di."), Exercise(id = "it-foundations-u4-confronti-e4", kind = "written", prompt = "Il tuo ristorante preferito.", options = listOf(), answers = listOf("il mio ristorante preferito e <nome>", "il migliore e <nome>"), explain = "Il mio preferito è X.")), skills = listOf("grammar:comparatives", "grammar:superlatives", "grammar:connectors", "function:express-opinion"), canDo = listOf("express-opinion"), prerequisites = listOf("grammar:comparatives"))))
}

