FROM eclipse-temurin:17-jdk-jammy@sha256:43f4431cc895d37ceb115e2e1f160545ec45caee9c1cb4246fc6bb879d58aeda

ARG ANDROID_CMDLINE_TOOLS_REVISION=15859902
ARG ANDROID_CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583
ARG ANDROID_NDK_VERSION=27.0.12077973
ARG ANDROID_CMAKE_VERSION=3.22.1
ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    JAVA_TOOL_OPTIONS=-Duser.home=/tmp/gradle-home \
    PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${PATH}

RUN mkdir -p "${ANDROID_HOME}/cmdline-tools/latest" \
    && curl --fail --location --retry 3 \
       "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_REVISION}_latest.zip" \
       -o /tmp/android-command-line-tools.zip \
    && echo "${ANDROID_CMDLINE_TOOLS_SHA256}  /tmp/android-command-line-tools.zip" | sha256sum --check - \
    && mkdir -p /tmp/android-cli \
    && cd /tmp/android-cli && jar xf /tmp/android-command-line-tools.zip \
    && mv /tmp/android-cli/cmdline-tools/* "${ANDROID_HOME}/cmdline-tools/latest/" \
    && chmod +x "${ANDROID_HOME}"/cmdline-tools/latest/bin/* \
    && rm -rf /tmp/android-cli /tmp/android-command-line-tools.zip \
    && cd / \
    && yes | sdkmanager --sdk_root="${ANDROID_HOME}" --licenses >/dev/null \
    && sdkmanager --sdk_root="${ANDROID_HOME}" --install \
       "platform-tools" "platforms;android-36" "build-tools;35.0.0" \
       "ndk;${ANDROID_NDK_VERSION}" "cmake;${ANDROID_CMAKE_VERSION}" \
    && rm -rf /root/.android

WORKDIR /workspace/apps/android
