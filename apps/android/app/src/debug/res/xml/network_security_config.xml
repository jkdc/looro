<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG builds only: allow the emulator to reach an API running in host
     Docker (http://10.0.2.2 / localhost). Release keeps usesCleartextTraffic="false". -->
<network-security-config>
    <!-- Debug builds: allow cleartext to any host so a physical phone on the
         WiFi can reach the lab API at the development machine's LAN IP.
         Release keeps usesCleartextTraffic="false". -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
