    "Your learning record is stored on this iPhone. Palique does not save raw audio. You can keep browsing your saved words and conversations without agreeing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your learning record is stored on this iPhone. Palique does not save raw audio. You can keep browsing your saved words and conversations without agreeing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu registro de aprendizaje se guarda en este iPhone. Palique no guarda el audio en bruto. Puedes seguir consultando tus palabras y conversaciones guardadas sin aceptar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton historique d'apprentissage est stocké sur cet iPhone. Palique n'enregistre pas l'audio brut. Tu peux consulter tes mots et conversations enregistrés sans accepter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Lernprotokoll wird auf diesem iPhone gespeichert. Palique speichert kein Rohaudio. Du kannst deine gespeicherten Wörter und Gespräche auch ohne Zustimmung ansehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo percorso di apprendimento è salvato su questo iPhone. Palique non salva l'audio grezzo. Puoi continuare a sfogliare le parole e le conversazioni salvate senza acconsentire."
          }
        }
      }
    },
