    "Signed out on this iPhone. We couldn’t reach Palique to revoke other sessions; they expire within 24 hours.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed out on this iPhone. We couldn’t reach Palique to revoke other sessions; they expire within 24 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión cerrada en este iPhone. No hemos podido contactar con Palique para revocar las demás sesiones; caducan en 24 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté sur cet iPhone. Impossible de joindre Palique pour révoquer les autres sessions ; elles expirent sous 24 heures."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem iPhone abgemeldet. Wir konnten Palique nicht erreichen, um andere Sitzungen zu widerrufen; sie laufen innerhalb von 24 Stunden ab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei disconnesso su questo iPhone. Non siamo riusciti a raggiungere Palique per revocare le altre sessioni; scadono entro 24 ore."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você saiu da conta neste iPhone. Não foi possível conectar ao Palique para revogar as outras sessões; elas expiram em até 24 horas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logget ut på denne iPhone-en. Vi kunne ikke nå Palique for å trekke tilbake andre økter; de utløper innen 24 timer."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你已在这台 iPhone 上退出登录。无法连接 Palique 撤销其他会话；它们将在 24 小时内过期。"
          }
        }
      }
    },
