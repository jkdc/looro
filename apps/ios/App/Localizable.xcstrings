    "Listen as many times as you need. The text stays hidden while you answer — try to understand it with your ears first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen as many times as you need. The text stays hidden while you answer — try to understand it with your ears first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escúchalo tantas veces como necesites. El texto permanece oculto mientras respondes: intenta entenderlo primero con los oídos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute autant de fois que nécessaire. Le texte reste caché pendant que tu réponds — essaie d'abord de le comprendre avec tes oreilles."
          }
        }
      }
    },
