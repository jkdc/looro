    "Token packs aren’t available right now. Please check again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Token packs aren’t available right now. Please check again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los packs de tokens no están disponibles ahora mismo. Vuelve a comprobarlo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les packs de jetons ne sont pas disponibles pour le moment. Réessaie plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token-Pakete sind gerade nicht verfügbar. Bitte prüfe später erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pacchetti di token non sono disponibili al momento. Riprova più tardi."
          }
        }
      }
    },
    "Tokens are prepaid service credit for the hosted model. They are not currency and hold no cash value. Usage is metered per call — there is no unlimited option.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens are prepaid service credit for the hosted model. They are not currency and hold no cash value. Usage is metered per call — there is no unlimited option."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tokens son saldo prepagado del servicio para el modelo hospedado. No son moneda y no tienen valor en efectivo. El uso se mide por llamada: no existe una opción ilimitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jetons sont un crédit de service prépayé pour le modèle hébergé. Ce n'est pas une monnaie et ils n'ont aucune valeur en espèces. L'usage est compté par appel — pas d'option illimitée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens sind vorausbezahltes Dienstguthaben für das gehostete Modell. Sie sind kein Zahlungsmittel und haben keinen Geldwert. Die Nutzung wird pro Anruf gemessen — es gibt keine unbegrenzte Option."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I token sono credito di servizio prepagato per il modello dell'app. Non sono valuta e non hanno valore di denaro. L'utilizzo è misurato per chiamata — non esiste un'opzione illimitata."
          }
        }
      }
    },
    "Too many requests. Please try again in a moment.": {
