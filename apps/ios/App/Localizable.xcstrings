    "Recall bars summarise repeated retrieval over time; three bars need spaced evidence across days and contexts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recall bars summarise repeated retrieval over time; three bars need spaced evidence across days and contexts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las barras de recuerdo resumen la recuperación repetida a lo largo del tiempo; tres barras requieren evidencia espaciada en días y contextos distintos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les barres de rappel résument la récupération répétée dans le temps ; trois barres exigent des preuves espacées sur plusieurs jours et contextes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abrufbalken fassen wiederholtes Abrufen über die Zeit zusammen; drei Balken brauchen verteilte Nachweise über Tage und Kontexte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le barre di richiamo riassumono i recuperi ripetuti nel tempo; tre barre richiedono prove distanziate su giorni e contesti."
          }
        }
      }
    },
    "Recall the expression for this meaning": {
      "extractionState": "manual",
