    "These attempts are saved on this device. Sign in to view account-synced exam history.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These attempts are saved on this device. Sign in to view account-synced exam history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos intentos se guardan en este dispositivo. Inicia sesión para ver el historial de exámenes sincronizado con la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces tentatives sont enregistrées sur cet appareil. Connecte-toi pour voir l'historique des examens synchronisé avec le compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Versuche sind auf diesem Gerät gespeichert. Melde dich an, um den mit dem Konto synchronisierten Prüfungsverlauf zu sehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi tentativi sono salvati su questo dispositivo. Accedi per vedere la cronologia esami sincronizzata con l'account."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas tentativas estão salvas neste dispositivo. Faça login para ver o histórico de provas sincronizado com a conta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse forsøkene er lagret på denne enheten. Logg inn for å se eksamenshistorikken synkronisert med kontoen."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这些作答保存在本设备上。登录后可查看账号同步的测验历史。"
          }
        }
      }
    },
    "They’ll grow from here.": {
      "extractionState": "manual",
