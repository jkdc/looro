    "No words are due right now. Have a conversation, and the words will come back when they are ready.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No words are due right now. Have a conversation, and the words will come back when they are ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay palabras pendientes ahora mismo. Ten una conversación y las palabras volverán cuando estén listas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun mot à réviser en ce moment. Discute un peu, et les mots reviendront quand il sera temps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Moment ist kein Wort fällig. Führe ein Gespräch, und die Wörter kommen wieder, wenn sie bereit sind."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna parola in scadenza al momento. Fai una conversazione e le parole torneranno quando saranno pronte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma palavra está pendente agora. Converse, e as palavras voltarão quando estiverem prontas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen ord er til repetisjon akkurat nå. Ha en samtale, så kommer ordene tilbake når de er klare."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "现在没有到期的词语。去聊聊天吧，词语会在合适的时候回来。"
          }
        }
      }
    },
