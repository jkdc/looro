    "Your OpenAI account pays for usage. The key stays in this iPhone’s Keychain and is sent only to OpenAI.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your OpenAI account pays for usage. The key stays in this iPhone’s Keychain and is sent only to OpenAI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta de OpenAI paga el uso. La clave se queda en el llavero de este iPhone y solo se envía a OpenAI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte OpenAI paie l'usage. La clé reste dans le Keychain de cet iPhone et n'est envoyée qu'à OpenAI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein OpenAI-Konto zahlt die Nutzung. Der Schlüssel bleibt im Keychain dieses iPhones und wird nur an OpenAI gesendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account OpenAI paga l'utilizzo. La chiave resta nel Keychain di questo iPhone e viene inviata solo a OpenAI."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta OpenAI paga pelo uso. A chave fica no Keychain deste iPhone e é enviada apenas para a OpenAI."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI-kontoen din betaler for bruken. Nøkkelen forblir i denne iPhone-ens Keychain og sendes bare til OpenAI."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "用量由你的 OpenAI 账号付费。密钥保存在这台 iPhone 的 Keychain 中，只发送给 OpenAI。"
          }
        }
      }
