    },
    "Tokens are prepaid service credit for the hosted model. They are not currency and hold no cash value. Usage is metered per call — there is no unlimited option.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens are prepaid service credit for the hosted model. They are not currency and hold no cash value. Usage is metered per call — there is no unlimited option."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tokens son saldo prepagado del servicio para el modelo hospedado. No son moneda y no tienen valor en efectivo. El uso se mide por llamada: no existe una opción ilimitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jetons sont un crédit de service prépayé pour le modèle hébergé. Ce n'est pas une monnaie et ils n'ont aucune valeur en espèces. L'usage est compté par appel — pas d'option illimitée."
          }
        }
      }
    },
