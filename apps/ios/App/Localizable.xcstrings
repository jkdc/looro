    "End this conversation to switch languages. Each language keeps its own words and progress.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End this conversation to switch languages. Each language keeps its own words and progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina esta conversación para cambiar de idioma. Cada idioma guarda sus propias palabras y su progreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine cette conversation pour changer de langue. Chaque langue garde ses propres mots et sa progression."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende dieses Gespräch, um die Sprache zu wechseln. Jede Sprache behält ihre eigenen Wörter und ihren Fortschritt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina questa conversazione per cambiare lingua. Ogni lingua conserva le sue parole e i suoi progressi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerre esta conversa para trocar de idioma. Cada idioma guarda suas próprias palavras e seu progresso."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutt denne samtalen for å bytte språk. Hvert språk beholder sine egne ord og sin fremdrift."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "结束当前对话即可切换语言。每种语言都有自己的词语和进度。"
          }
        }
      }
    },
