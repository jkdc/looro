    "Source-backed topic search isn’t available with the selected conversation engine. You can still use saved topics.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source-backed topic search isn’t available with the selected conversation engine. You can still use saved topics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda de temas con fuentes no está disponible con el motor de conversación seleccionado. Aun así puedes usar los temas guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche de thèmes avec sources n'est pas disponible avec le moteur de conversation sélectionné. Tu peux quand même utiliser les thèmes enregistrés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Themensuche mit Quellen ist mit der ausgewählten Gesprächs-Engine nicht verfügbar. Gespeicherte Themen kannst du trotzdem nutzen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca di argomenti con fonti non è disponibile con il motore di conversazione selezionato. Puoi comunque usare gli argomenti salvati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca de temas com fontes não está disponível com o motor de conversa selecionado. Você ainda pode usar os temas salvos."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kildebasert temasøk er ikke tilgjengelig med den valgte samtalemotoren. Du kan fortsatt bruke lagrede temaer."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "所选对话引擎不支持带来源的话题检索。你仍可以使用已保存的话题。"
