        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escúchalo tantas veces como necesites. El texto permanece oculto mientras respondes: intenta entenderlo primero con los oídos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute autant de fois que nécessaire. Le texte reste caché pendant que tu réponds — essaie d'abord de le comprendre avec tes oreilles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör so oft zu, wie du brauchst. Der Text bleibt verborgen, während du antwortest — versuche, ihn zuerst mit den Ohren zu verstehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta quante volte ti serve. Il testo resta nascosto mentre rispondi — prova prima a capirlo con le orecchie."
          }
        }
      }
    },
