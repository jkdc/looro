    "By signing in, you agree to the [Terms of use](https://app.example/terms/) and acknowledge the [Privacy policy](https://app.example/privacy/).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By signing in, you agree to the [Terms of use](https://app.example/terms/) and acknowledge the [Privacy policy](https://app.example/privacy/)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al iniciar sesión, aceptas las [Condiciones de uso](https://app.example/terms/) y reconoces la [Política de privacidad](https://app.example/privacy/)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En te connectant, tu acceptes les [Conditions d'utilisation](https://app.example/terms/) et tu prends connaissance de la [Politique de confidentialité](https://app.example/privacy/)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Anmeldung akzeptierst du die [Nutzungsbedingungen](https://app.example/terms/) und erkennst die [Datenschutzerklärung](https://app.example/privacy/) an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedendo, accetti le [Condizioni d'uso](https://app.example/terms/) e confermi l'[Informativa sulla privacy](https://app.example/privacy/)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao fazer login, você concorda com os [Termos de uso](https://app.example/terms/) e reconhece a [Política de privacidade](https://app.example/privacy/)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved å logge inn godtar du [bruksvilkårene](https://app.example/terms/) og bekrefter [personvernerklæringen](https://app.example/privacy/)."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "登录即表示你同意[使用条款](https://app.example/terms/)并知悉[隐私政策](https://app.example/privacy/)。"
          }
        }
      }
    },
