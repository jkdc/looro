            "value": "A guided rehearsal, then a review of your mistakes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ensayo guiado y después una revisión de tus errores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une répétition guidée, puis un retour sur tes erreurs."
          }
        },
