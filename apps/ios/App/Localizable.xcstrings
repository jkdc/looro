    "Checkout opens securely in Stripe. After paying, return to Palique and check your purchases.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkout opens securely in Stripe. After paying, return to Palique and check your purchases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se abre de forma segura en Stripe. Después de pagar, vuelve a Palique y revisa tus compras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement s'ouvre en toute sécurité dans Stripe. Après le paiement, reviens sur Palique et vérifie tes achats."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bezahlung öffnet sich sicher in Stripe. Kehre nach der Zahlung zu Palique zurück und prüfe deine Käufe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento si apre in sicurezza su Stripe. Dopo aver pagato, torna su Palique e controlla i tuoi acquisti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O checkout abre com segurança no Stripe. Depois de pagar, volte ao Palique e verifique suas compras."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kassen åpnes sikkert i Stripe. Etter betaling, gå tilbake til Palique og sjekk kjøpene dine."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "结账将在 Stripe 中安全打开。付款后请返回 Palique，查询你的购买。"
          }
        }
      }
    },
