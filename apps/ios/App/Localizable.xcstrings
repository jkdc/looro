    "Mastery is the best recent evidence per skill — it fades without practice and recovers when you practise again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mastery is the best recent evidence per skill — it fades without practice and recovers when you practise again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dominio es la mejor evidencia reciente por habilidad: se apaga sin práctica y se recupera cuando vuelves a practicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La maîtrise correspond à la meilleure preuve récente par compétence — elle s'estompe sans pratique et revient quand tu t'entraînes à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beherrschung ist der beste aktuelle Nachweis pro Fähigkeit — sie verblasst ohne Übung und erholt sich, wenn du wieder übst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La padronanza è la prova recente migliore per ogni abilità — sbiadisce senza allenamento e si recupera quando ti alleni di nuovo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O domínio é a melhor evidência recente por habilidade — ele diminui sem prática e se recupera quando você pratica de novo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mestring er det beste nylige sporet per ferdighet — den falmer uten øving og kommer tilbake når du øver igjen."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "掌握度是每项技能最近的最好表现——不练会退步，重新练习会恢复。"
          }
        }
      }
    },
    "Meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
