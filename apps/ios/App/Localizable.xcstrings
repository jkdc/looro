    "The text stays visible — read it as many times as you need and answer the questions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text stays visible — read it as many times as you need and answer the questions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto permanece visible: léelo tantas veces como necesites y responde a las preguntas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte reste visible — relis-le autant de fois que nécessaire et réponds aux questions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text bleibt sichtbar — lies ihn so oft, wie du brauchst, und beantworte die Fragen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo resta visibile — leggilo quante volte ti serve e rispondi alle domande."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto fica visível — leia quantas vezes precisar e responda às perguntas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten forblir synlig — les den så mange ganger du trenger, og svar på spørsmålene."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "文本一直可见——想读几遍就读几遍，然后回答问题。"
          }
        }
      }
    },
