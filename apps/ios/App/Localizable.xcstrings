          "stringUnit": {
            "state": "translated",
            "value": "Osservate nelle conversazioni. Sono provvisorie, non certificati formali di livello."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Observado em várias conversas. São provisórios, não certificados formais de nível."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Observert på tvers av samtaler. Dette er foreløpige, ikke formelle nivåsertifikater."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "根据多次对话观察得出。这些只是阶段性参考，并非正式等级证书。"
          }
        }
      }
    },
