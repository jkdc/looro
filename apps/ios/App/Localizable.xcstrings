    "Tap a phrase to hear it, then Check and say it out loud.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a phrase to hear it, then Check and say it out loud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una frase para escucharla, luego pulsa Comprobar y dila en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche une phrase pour l'entendre, puis touche Vérifier et dis-la à voix haute."
          }
        },
        "de": {
