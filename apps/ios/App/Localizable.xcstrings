    "Correct a misheard phrase. Learning evidence from the old wording will be removed; the original remains in your backup history.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correct a misheard phrase. Learning evidence from the old wording will be removed; the original remains in your backup history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige una frase mal entendida. La evidencia de aprendizaje de la redacción anterior se eliminará; el original permanece en tu historial de copias de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige une phrase mal comprise. Les preuves d'apprentissage de l'ancienne formulation seront supprimées ; l'original reste dans ton historique de sauvegardes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigiere eine falsch verstandene Formulierung. Die Lernnachweise der alten Formulierung werden entfernt; das Original bleibt in deinem Backup-Verlauf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Correggi una frase capita male. Le prove di apprendimento della vecchia formulazione verranno rimosse; l'originale resta nella cronologia dei tuoi backup."
          }
        }
      }
    },
