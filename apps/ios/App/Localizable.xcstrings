    "Mastery is the best recent evidence per skill — it fades without practice and recovers when you practise again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mastery is the best recent evidence per skill — it fades without practice and recovers when you practise again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dominio es la mejor evidencia reciente por habilidad: se apaga sin práctica y se recupera cuando vuelves a practicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La maîtrise correspond à la meilleure preuve récente par compétence — elle s'estompe sans pratique et revient quand tu t'entraînes à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
