    "Account deleted. Palique couldn’t clear its local secure sign-in record. Unlock this iPhone and reopen Account to clear it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account deleted. Palique couldn’t clear its local secure sign-in record. Unlock this iPhone and reopen Account to clear it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta eliminada. Palique no ha podido borrar su registro local de acceso seguro. Desbloquea este iPhone y vuelve a abrir Cuenta para borrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte supprimé. Palique n'a pas pu effacer son enregistrement local de connexion sécurisée. Déverrouille cet iPhone et rouvre Compte pour l'effacer."
          }
        }
      }
    },
    "Account deleted. Your learning history remains on this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account deleted. Your learning history remains on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta eliminada. Tu historial de aprendizaje permanece en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte supprimé. Ton historique d'apprentissage reste sur cet iPhone."
          }
        }
      }
    },
    "Accounts aren’t available in this build yet. You can keep practising with your own OpenAI API key in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts aren’t available in this build yet. You can keep practising with your own OpenAI API key in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas aún no están disponibles en esta compilación. Puedes seguir practicando con tu propia clave API de OpenAI en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes ne sont pas encore disponibles dans cette version. Tu peux continuer à t'entraîner avec ta propre clé API OpenAI dans les Réglages."
          }
        }
      }
    },
