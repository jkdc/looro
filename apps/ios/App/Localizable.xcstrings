    "The account version could not be applied. Your saved version was not changed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account version could not be applied. Your saved version was not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido aplicar la versión de la cuenta. Tu versión guardada no se ha cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'appliquer la version du compte. Ta version enregistrée n'a pas changé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konto-Version konnte nicht übernommen werden. Deine gespeicherte Version wurde nicht geändert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile applicare la versione dell'account. La versione salvata non è stata modificata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível aplicar a versão da conta. Sua versão salva não foi alterada."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoversjonen kunne ikke brukes. Den lagrede versjonen din ble ikke endret."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "账号版本未能应用。你保存的版本未改变。"
          }
        }
      }
    },
    "The bars estimate spoken recall, not permanent mastery. Using a word with visible meanings counts as supported practice.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bars estimate spoken recall, not permanent mastery. Using a word with visible meanings counts as supported practice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las barras estiman el recuerdo hablado, no el dominio permanente. Usar una palabra con significados a la vista cuenta como práctica apoyada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les barres estiment le rappel à l'oral, pas une maîtrise permanente. Utiliser un mot avec des sens visibles compte comme une pratique accompagnée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Balken schätzen das gesprochene Abrufen ab, nicht dauerhafte Beherrschung. Ein Wort mit sichtbaren Bedeutungen zu benutzen zählt als unterstützte Übung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le barre stimano il richiamo parlato, non la padronanza permanente. Usare una parola con significati visibili conta come allenamento con supporto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As barras estimam a lembrança ao falar, não o domínio permanente. Usar uma palavra com significados visíveis conta como prática com apoio."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Barene anslår muntlig hukommelse, ikke varig mestring. Å bruke et ord med synlige betydninger teller som øving med støtte."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "进度条估算的是口头回忆效果，并非永久掌握。在含义可见的情况下使用词语算作有支持的练习。"
          }
        }
      }
    },
    "The exam couldn’t be validated or saved, so it hasn’t started. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exam couldn’t be validated or saved, so it hasn’t started. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El examen no se ha podido validar ni guardar, así que no ha empezado. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'examen n'a pas pu être validé ni enregistré, il n'a donc pas commencé. Réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung konnte nicht geprüft oder gespeichert werden und hat deshalb nicht begonnen. Bitte versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'esame non è stato validato o salvato, quindi non è iniziato. Riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível validar ou salvar a prova, então ela não começou. Tente novamente."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksamenen kunne ikke valideres eller lagres, så den er ikke startet. Prøv igjen."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "本次测验未能通过校验或保存，因此尚未开始。请重试。"
          }
        }
      }
    },
