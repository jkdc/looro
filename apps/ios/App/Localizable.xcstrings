      }
    },
    "Exam history is scoped to the signed-in account. Pending attempts stay on this device until synchronization succeeds.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exam history is scoped to the signed-in account. Pending attempts stay on this device until synchronization succeeds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de exámenes corresponde a la cuenta con sesión iniciada. Los intentos pendientes se quedan en este dispositivo hasta que la sincronización funcione."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique des examens est limité au compte connecté. Les tentatives en attente restent sur cet appareil jusqu'à la réussite de la synchronisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prüfungverlauf gehört zum angemeldeten Konto. Ausstehende Versuche bleiben auf diesem Gerät, bis die Synchronisierung gelingt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia degli esami è legata all'account con cui hai effettuato l'accesso. I tentativi in sospeso restano su questo dispositivo finché la sincronizzazione non riesce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de provas é vinculado à conta com login ativo. As tentativas pendentes ficam neste dispositivo até a sincronização ser concluída."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksamenshistorikken gjelder kontoen du er logget inn på. Ventende forsøk blir på denne enheten til synkroniseringen lykkes."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "测验历史仅限于当前登录的账号。待同步的作答会保留在本设备上，直到同步成功。"
          }
        }
      }
    },
