    {
      "id": "de-listen-cafe-morning",
      "languageID": "de",
      "title": "Ein Kaffee vor der Arbeit",
      "level": "A1",
      "topic": "Alltag",
      "unitID": "de-foundations-u1",
      "text": "Jeden Morgen geht Marta zu einem kleinen Café in der Nähe ihrer Wohnung. Der Kellner kennt ihren Namen, deshalb muss sie nie bestellen. Heute sitzt sie am Fenster mit einem Kaffee und einem Croissant. Ihr Bus fährt um halb neun ab, aber sie macht sich keine Sorgen. Das Café ist zu dieser Stunde sehr ruhig. Sie trinkt ihren Kaffee langsam und sieht zu, wie die Stadt aufwacht.",
      "questions": [
        {
          "id": "de-listen-cafe-morning-q1",
          "kind": "choice",
          "prompt": "Wohin geht Marta jeden Morgen?",
          "options": [
            "In ein kleines Café",
            "In ihr Büro",
            "Zum Busbahnhof",
            "In einen Park"
          ],
          "answers": [
            "In ein kleines Café"
          ],
          "explain": "Sie geht zu einem kleinen Café in der Nähe ihrer Wohnung."
        },
        {
          "id": "de-listen-cafe-morning-q2",
          "kind": "choice",
          "prompt": "Was frühstückt sie heute?",
