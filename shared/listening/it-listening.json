        {
          "id": "it-listen-new-flatmate-q1",
          "kind": "choice",
          "prompt": "Quanti anni ha Leo?",
          "options": [
            "Ventitré",
            "Trentadue",
            "Venti",
            "Trenta"
          ],
          "answers": [
