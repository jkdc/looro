    {
      "id": "it-listen-cafe-morning",
      "languageID": "it",
      "title": "Un caffè prima del lavoro",
      "level": "A1",
      "topic": "routine",
      "unitID": "it-foundations-u1",
      "text": "Ogni mattina, Marta cammina fino a un piccolo caffè vicino a casa sua. Il cameriere conosce il suo nome, così non deve mai ordinare. Oggi si siede vicino alla finestra con un caffè e un cornetto. Il suo autobus parte alle otto e mezza, ma non è preoccupata. Il caffè è molto tranquillo a quell'ora. Beve il caffè lentamente e guarda la città che si sveglia.",
      "questions": [
        {
          "id": "it-listen-cafe-morning-q1",
          "kind": "choice",
          "prompt": "Dove va Marta ogni mattina?",
          "options": [
            "In un piccolo caffè",
            "Al suo ufficio",
            "Alla stazione degli autobus",
            "In un parco"
          ],
          "answers": [
            "In un piccolo caffè"
          ],
          "explain": "Cammina fino a un piccolo caffè vicino a casa sua."
        },
        {
          "id": "it-listen-cafe-morning-q2",
          "kind": "choice",
          "prompt": "Cosa fa colazione oggi?",
          "options": [
            "Un caffè e un cornetto",
            "Tè e toast",
            "Succo d'arancia",
            "Niente"
          ],
          "answers": [
            "Un caffè e un cornetto"
          ],
          "explain": "Si siede vicino alla finestra con un caffè e un cornetto."
        },
        {
          "id": "it-listen-cafe-morning-q3",
          "kind": "written",
          "prompt": "A che ora parte il suo autobus?",
          "answers": [
            "alle otto e mezza",
            "otto e mezza"
          ],
          "explain": "Il suo autobus parte alle otto e mezza."
        },
        {
          "id": "it-listen-cafe-morning-q4",
          "kind": "choice",
          "prompt": "Come si sente per l'orario?",
          "options": [
            "Non è preoccupata",
            "È in grandissimo ritardo",
            "È arrabbiata",
            "Ha sonno"
          ],
          "answers": [
            "Non è preoccupata"
          ],
          "explain": "Il testo dice che non è preoccupata."
        },
        {
          "id": "it-listen-cafe-morning-q5",
          "kind": "choice",
          "prompt": "Chi conosce il suo nome?",
          "options": [
            "Il cameriere",
            "L'autista dell'autobus",
            "Il suo capo",
            "Un vicino"
          ],
          "answers": [
            "Il cameriere"
          ],
          "explain": "Il cameriere conosce il suo nome, così non deve mai ordinare."
        },
        {
          "id": "it-listen-cafe-morning-q6",
          "kind": "written",
          "prompt": "Dove si siede oggi?",
          "answers": [
            "vicino alla finestra",
            "accanto alla finestra",
            "alla finestra"
          ],
          "explain": "Oggi si siede vicino alla finestra."
        }
      ]
    },
    {
      "id": "it-listen-language-class",
      "languageID": "it",
      "title": "Il corso di lingua",
      "level": "A1",
      "topic": "presentazioni",
      "unitID": "it-foundations-u1",
      "text": "Marta partecipa alla sua prima lezione di portoghese in un piccolo istituto. In classe ci sono sei persone e tutti vogliono parlare. L'insegnante chiede le presentazioni. « Mi chiamo Marta e sono della Bolivia », dice una signora. « Io sono Andrés, sono del Perù e lavoro in un ristorante », dice un ragazzo. Marta si presenta anche lei: « Sono Marta, sono argentina e sono infermiera ». L'insegnante è di Madrid e insegna con molto humour. Alla fine della lezione, gli studenti si scambiano i numeri di telefono. Non sono ancora amici, ma la prossima settimana vanno a prendere un caffè insieme per praticare.",
      "questions": [
        {
          "id": "it-listen-language-class-q1",
          "kind": "choice",
          "prompt": "Quante persone ci sono in classe?",
          "options": [
            "Sei",
            "Tre",
            "Dieci",
            "Quattordici"
          ],
          "answers": [
            "Sei"
          ],
          "explain": "In classe ci sono sei persone."
        },
        {
          "id": "it-listen-language-class-q2",
          "kind": "choice",
          "prompt": "Di dov'è Andrés?",
          "options": [
            "Del Perù",
            "Della Bolivia",
            "Dell'Argentina",
            "Del Messico"
          ],
          "answers": [
            "Del Perù"
          ],
          "explain": "Andrés è del Perù e lavora in un ristorante."
        },
        {
          "id": "it-listen-language-class-q3",
          "kind": "choice",
          "prompt": "Qual è il lavoro di Marta?",
          "options": [
            "Infermiera",
            "Insegnante",
            "Cameriera",
            "Studentessa"
          ],
          "answers": [
            "Infermiera"
          ],
          "explain": "Marta è argentina ed è infermiera."
        },
        {
          "id": "it-listen-language-class-q4",
          "kind": "written",
          "prompt": "Di che città è l'insegnante?",
          "answers": [
            "madrid",
            "di madrid",
            "è di madrid"
          ],
          "explain": "L'insegnante è di Madrid."
        },
        {
          "id": "it-listen-language-class-q5",
          "kind": "choice",
          "prompt": "Cosa fanno alla fine della lezione?",
          "options": [
            "Si scambiano i numeri di telefono",
            "Tornano a casa da soli",
            "Fanno un esame",
            "Cenano al ristorante"
          ],
          "answers": [
            "Si scambiano i numeri di telefono"
          ],
          "explain": "Gli studenti si scambiano i numeri di telefono."
        },
        {
          "id": "it-listen-language-class-q6",
          "kind": "written",
          "prompt": "Cosa fanno la prossima settimana?",
          "answers": [
            "prendere un caffè",
            "vanno a prendere un caffè",
            "prendere un caffè insieme"
          ],
          "explain": "La prossima settimana vanno a prendere un caffè insieme per praticare."
        }
      ]
    },
    {
      "id": "it-listen-little-sister",
      "languageID": "it",
      "title": "Mia sorella piccola",
      "level": "A1",
      "topic": "famiglia",
      "unitID": "it-foundations-u1",
      "text": "Mia sorella piccola si chiama Carla e ha nove anni. È molto simpatica e molto chiacchierona. Carla non è riservata: parla con tutti, con i vicini, con gli insegnanti e con i cani del parco. È bionda, come nostra madre, e ha gli occhi castani come mio padre. Non è alta per la sua età, ma è molto veloce e le piace tantissimo il calcio. La sua squadra non è molto buona, ma a lei non importa. « Non sono professionista », dice, « io sono solo felice con il pallone ». Mia sorella è piccola, ma la sua gioia è enorme.",
      "questions": [
        {
          "id": "it-listen-little-sister-q1",
          "kind": "choice",
          "prompt": "Quanti anni ha Carla?",
          "options": [
            "Nove",
            "Diciannove",
            "Sette",
            "Dieci"
          ],
          "answers": [
            "Nove"
          ],
          "explain": "Carla ha nove anni."
        },
        {
          "id": "it-listen-little-sister-q2",
          "kind": "choice",
          "prompt": "Com'è Carla?",
          "options": [
            "Simpatica e chiacchierona",
            "Timida e riservata",
            "Seria",
            "Triste"
          ],
          "answers": [
            "Simpatica e chiacchierona"
          ],
          "explain": "È molto simpatica e molto chiacchierona."
        },
        {
          "id": "it-listen-little-sister-q3",
          "kind": "written",
          "prompt": "Di che colore sono i suoi occhi?",
          "answers": [
            "castani",
            "gli occhi castani",
            "castani come suo padre"
          ],
          "explain": "Ha gli occhi castani come suo padre."
        },
        {
          "id": "it-listen-little-sister-q4",
          "kind": "choice",
          "prompt": "Che capelli ha?",
          "options": [
            "Biondi, come sua madre",
            "Scuri, come suo padre",
            "Rossi",
            "Corti e neri"
          ],
          "answers": [
            "Biondi, come sua madre"
          ],
          "explain": "È bionda, come nostra madre."
        },
        {
          "id": "it-listen-little-sister-q5",
          "kind": "choice",
          "prompt": "Che cosa le piace tantissimo?",
          "options": [
            "Il calcio",
            "Il nuoto",
            "La musica",
            "I videogiochi"
          ],
          "answers": [
            "Il calcio"
          ],
          "explain": "È molto veloce e le piace tantissimo il calcio."
        },
        {
          "id": "it-listen-little-sister-q6",
          "kind": "written",
