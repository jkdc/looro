          "colorIndex": 1
        }
      ],
      "lessons": [
        {
          "id": "es-foundations-u2-rutina",
          "title": "Mi rutina",
          "goal": "Contar tu día con verbos en presente y las horas.",
          "intro": {
            "explanation": [
              "El presente sirve para rutinas: «Me levanto a las siete. Desayuno café y tostadas. Salgo de casa a las ocho».",
              "Los reflejos van con pronombre: «me levanto, me ducho, me acuesto» — el me es parte del verbo.",
              "Las horas en punto o y media: «a las siete», «a las siete y media». Con a: «a las ocho salgo»."
            ],
            "examples": [
              {
                "text": "Me levanto a las siete.",
                "meaning": "El primer verbo del día."
              },
              {
                "text": "Desayuno café y tostadas.",
                "meaning": "El desayuno, sin pronombre."
              },
              {
                "text": "Me ducho y salgo de casa a las ocho.",
                "meaning": "Dos acciones seguidas."
              },
              {
                "text": "Ceno a las nueve y me acuesto a las once.",
                "meaning": "La rutina de noche."
              },
              {
                "text": "Los sábados me levanto tarde.",
                "meaning": "El hábito de fin de semana."
              }
            ]
          },
          "expressions": [
            {
              "text": "Me levanto a las …",
              "meaning": "El inicio.",
              "note": "…siete, o tarde los sábados."
            },
            {
              "text": "Desayuno / ceno …",
              "meaning": "Comidas como verbos.",
              "note": "Desayuno café."
            },
            {
              "text": "Me ducho / me acuesto",
              "meaning": "Reflejos del día.",
              "note": "El me es obligatorio."
            },
            {
              "text": "Salgo de casa a las …",
              "meaning": "La salida.",
              "note": "salir de + lugar."
            },
            {
              "text": "Los sábados …",
              "meaning": "El hábito de finde.",
              "note": "plural = todos los sábados."
            }
          ],
          "situation": "Cuentas tu mañana a un amigo nuevo: hora de levantarte, desayuno, ducha, salida — y cómo cambia el sábado.",
          "practice": {
            "questions": [
              {
                "prompt": "Di a qué hora te levantas entre semana.",
                "expected": [
                  "Me levanto a las <hora> entre semana."
                ],
                "focus": "me levanto",
                "watch": "El reflejo lleva me: me levanto, no levanto me."
              },
              {
                "prompt": "Di qué desayunas.",
                "expected": [
                  "Desayuno <comida> y <comida>."
                ],
                "focus": "desayunar",
                "watch": "Desayuno café — el verbo y la comida comparten raíz."
              },
              {
                "prompt": "Di a qué hora sales de casa.",
                "expected": [
                  "Salgo de casa a las <hora>."
                ],
                "focus": "salir de",
                "watch": "salir DE casa — la preposición importa."
              },
              {
                "prompt": "Di cómo cambia tu sábado.",
                "expected": [
                  "Los sábados me levanto tarde."
                ],
                "focus": "los + día",
                "watch": "Los sábados = todos los sábados."
              },
              {
                "prompt": "Di a qué hora te acuestas.",
                "expected": [
                  "Me acuesto a las <hora>."
                ],
                "focus": "me acuesto",
                "watch": "Reflejo: me acuesto, no acuesto me."
              }
            ]
          },
          "exercises": [
            {
              "id": "es-foundations-u2-rutina-e1",
              "kind": "choice",
              "prompt": "Me ___ a las siete todos los días.",
              "explain": "Me levanto: el me va delante.",
              "options": [
                "levanto",
                "levanto me",
                "levanta",
                "levantarse"
              ],
              "answers": [
                "levanto"
              ]
            },
            {
              "id": "es-foundations-u2-rutina-e2",
              "kind": "gap",
              "prompt": "___ café y tostadas. (desayunar)",
              "explain": "Primera persona: desayuno.",
              "answers": [
                "Desayuno",
                "desayuno"
              ]
            },
            {
              "id": "es-foundations-u2-rutina-e3",
              "kind": "order",
              "prompt": "Di a qué hora sales.",
              "explain": "salgo de + lugar + a las + hora.",
              "answers": [
                "Salgo de casa a las ocho"
              ]
            },
            {
              "id": "es-foundations-u2-rutina-e4",
              "kind": "written",
              "prompt": "Di tu hábito de los sábados.",
              "explain": "Los + día + presente.",
              "answers": [
                "los sábados me levanto tarde",
                "los sabados desayuno tarde"
              ]
            }
          ],
          "skills": [
