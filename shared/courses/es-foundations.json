      "lessons": [
        {
          "id": "es-foundations-u1-ser",
          "title": "The verb “ser”",
          "goal": "Introduce yourself and say who people are with soy, eres, es, somos, son.",
          "intro": {
            "explanation": [
              "Every Spanish sentence needs a subject and a verb. The most important verb for saying who you are is “ser”.",
              "One verb, five present forms: yo soy, tú eres, él/ella es, nosotros somos, ellos/ellas son. With “you” formal, use usted es.",
              "Use ser for identity and origin: “Soy Ana”, “Soy de España”, “Es profesora”. These facts do not change, so ser is the verb."
            ],
            "examples": [
              {
                "text": "Soy Ana. Soy de España.",
                "meaning": "Your name and country."
              },
              {
                "text": "Eres mi mejor amigo.",
                "meaning": "A close bond with someone."
              },
              {
                "text": "Ella es profesora.",
                "meaning": "Someone's profession."
              },
              {
                "text": "Somos muy felices hoy.",
                "meaning": "A feeling that defines right now."
              },
              {
                "text": "El café es cercano a la estación.",
                "meaning": "Where a place is."
              },
              {
                "text": "Ellos son de Madrid.",
                "meaning": "Someone's origin."
              }
            ]
          },
          "expressions": [
            {
              "text": "Soy …",
              "meaning": "Introduce yourself.",
              "note": "With your name, job or feeling: Soy Ana. Soy profesora."
            },
            {
              "text": "Soy de …",
              "meaning": "Say where you come from.",
              "note": "Never “Soy España” — the de is obligatory: Soy de España."
            },
            {
              "text": "¿Eres …?",
              "meaning": "Ask about the other person.",
              "note": "¿Eres estudiante? ¿Eres de aquí?"
            },
            {
              "text": "Sí, lo soy. / No, no lo soy.",
              "meaning": "Short answers to an ¿Eres…? question.",
              "note": "Repeat the verb through lo: never just “Sí”."
            },
            {
              "text": "Es …",
              "meaning": "Say what someone else is.",
              "note": "Es profesor — the article is often dropped with jobs: Es médico."
            },
            {
              "text": "Encantado de conocerte.",
              "meaning": "The fixed phrase when you meet someone.",
              "note": "Answer with Encantada if you are a woman, or Igualmente."
            }
          ],
          "situation": "You meet someone new at a friendly language-exchange café in Madrid. Introduce yourselves and ask simple questions with the verb ser.",
          "practice": {
            "questions": [
              {
                "prompt": "¡Hola! Soy Ana. ¿Cómo te llamas?",
                "expected": [
                  "Me llamo <name>.",
                  "Soy <name>."
                ],
                "focus": "Me llamo / Soy",
                "watch": "Answering only the name without the verb: accept it, then recast “Me llamo …”."
              },
              {
                "prompt": "¿De dónde eres?",
                "expected": [
                  "Soy de <country>."
                ],
                "focus": "ser + de",
                "watch": "“Soy España” — recast “Soy DE España”, stress de."
              },
              {
                "prompt": "¿Eres estudiante?",
                "expected": [
                  "Sí, lo soy.",
                  "No, no lo soy."
                ],
                "focus": "short answers with ser",
                "watch": "“Sí estudiante” — the short answer needs the verb."
              },
              {
                "prompt": "¿Cómo estás hoy?",
                "expected": [
                  "Estoy bien.",
                  "Estoy cansado.",
                  "Estoy feliz."
                ],
                "focus": "estar for feelings",
                "watch": "“Soy cansado” — recast “Estoy cansado”: feelings take estar."
              },
              {
                "prompt": "Tu ciudad, ¿es grande o pequeña?",
                "expected": [
                  "Es grande.",
                  "Es pequeña.",
                  "Mi ciudad es …"
                ],
                "focus": "es with things and places",
                "watch": "“Mi ciudad grande” — recast “Mi ciudad ES grande”."
              },
              {
                "prompt": "¡Ya somos amigos! ¿De dónde es tu familia?",
                "expected": [
                  "Es de <country>.",
                  "Mi familia es de <country>."
                ],
                "focus": "es for a group's origin",
                "watch": "“Mi familia de …” — recast with es."
              }
            ]
          },
          "exercises": [
            {
              "id": "es-foundations-u1-ser-e1",
              "kind": "choice",
              "prompt": "Ella ___ profesora.",
              "options": [
                "es",
                "eres",
                "soy",
                "somos"
              ],
              "answers": [
                "es"
              ],
              "explain": "With él/ella/usted, ser becomes es."
            },
            {
              "id": "es-foundations-u1-ser-e2",
              "kind": "gap",
              "prompt": "Nosotros ___ de Madrid.",
              "answers": [
                "somos"
              ],
              "explain": "With nosotros, ser is siempre somos."
            },
            {
              "id": "es-foundations-u1-ser-e3",
              "kind": "order",
              "prompt": "Say where you are from.",
              "answers": [
                "Soy de España"
              ],
              "explain": "Soy + de + country: Soy de España."
            },
            {
              "id": "es-foundations-u1-ser-e4",
              "kind": "written",
              "prompt": "Introduce yourself in one sentence: say your name.",
              "answers": [
                "Me llamo <name>",
                "Soy <name>"
              ],
              "explain": "Me llamo Ana / Soy Ana — the verb is never dropped."
            }
          ],
          "skills": [
            "grammar:verb-be",
            "grammar:subject-pronouns",
            "function:describe-people",
            "speaking:short-answer"
          ],
          "canDo": [
            "describe-people"
          ],
          "prerequisites": [
            "grammar:verb-be"
          ]
        },
        {
          "id": "es-foundations-u1-questions",
          "title": "Questions & negatives",
          "goal": "Ask yes/no questions and say what is not true, with ¿Eres…? and no soy.",
          "intro": {
            "explanation": [
              "To ask a yes/no question in Spanish, keep the word order and just add the question marks — your voice goes up at the end: “¿Eres Ana?”",
              "Question words carry an accent: ¿Qué? ¿Dónde? ¿Cómo? They go first: “¿De dónde eres?”",
              "To say something is not true, put no before the verb: “No soy Ana”, “No somos amigos”. In answers, no… twice is normal: “No, no lo soy”."
            ],
            "examples": [
              {
                "text": "¿Eres tú profesora?",
                "meaning": "A yes/no question with eres."
              },
              {
                "text": "No soy de Madrid.",
                "meaning": "A negative with soy."
              },
              {
                "text": "¿De dónde eres?",
                "meaning": "Question word + eres."
              },
              {
                "text": "Él no es mi hermano.",
                "meaning": "A negative about another person."
              },
              {
                "text": "¿Sois vosotros vecinos?",
                "meaning": "Asking a group."
              },
              {
                "text": "¿Qué es esto?",
                "meaning": "What is this?"
              }
            ]
          },
          "expressions": [
            {
              "text": "¿Eres …?",
              "meaning": "Ask a yes/no question.",
              "note": "Same order as the statement, just the marks and rising tone."
            },
            {
              "text": "No soy …",
              "meaning": "Say what is not true about you.",
              "note": "No always goes before the verb: No soy de Sevilla."
            },
            {
              "text": "¿De dónde eres?",
              "meaning": "Ask where someone is from.",
              "note": "De dónde, two words with accents."
            },
            {
              "text": "No es …",
              "meaning": "Say what someone else is not.",
              "note": "Él no es mi jefe."
            },
            {
              "text": "¿Verdad?",
              "meaning": "Tag a statement to check it.",
              "note": "Es tu casa, ¿verdad?"
            },
            {
              "text": "Claro.",
              "meaning": "The natural yes in talk.",
              "note": "Also: Por supuesto."
            }
          ],
          "situation": "You chat with a new neighbour in the lift in Madrid. Ask simple yes/no questions and say what is and isn't true for you.",
          "practice": {
            "questions": [
              {
                "prompt": "¿Eres de aquí?",
                "expected": [
                  "Sí, soy de aquí.",
                  "No, no soy de aquí."
                ],
                "focus": "short answers",
                "watch": "One-word “Sí” — recast with the verb: Sí, soy de aquí."
              },
              {
                "prompt": "¿Eres profesor o estudiante?",
                "expected": [
                  "Soy profesor.",
                  "Soy estudiante.",
                  "Soy profesora."
                ],
                "focus": "choice with ser",
                "watch": "Accept either; recast with the article dropped: Soy profesor."
              },
              {
                "prompt": "¿Tu familia es grande?",
                "expected": [
                  "Sí, es grande.",
                  "No, no es grande."
                ],
                "focus": "es in questions about others",
                "watch": "“Mi familia es grande, ¿verdad?” is also fine."
              },
              {
                "prompt": "¿De dónde eres tú?",
                "expected": [
                  "Soy de <country>."
                ],
                "focus": "de dónde + soy",
                "watch": "“Soy de” never “Soy en”."
              },
              {
                "prompt": "Dime algo que no eres.",
                "expected": [
                  "No soy <job>.",
                  "No soy de <country>."
                ],
                "focus": "negation with no soy",
                "watch": "“No soy” before the rest: never “Soy no”."
              },
              {
                "prompt": "¿Somos amigos ya?",
                "expected": [
                  "Sí, somos amigos.",
                  "Claro, somos amigos."
                ],
                "focus": "somos in questions",
                "watch": "“Sí, estamos amigos” mixes ser and estar — recast with somos."
              }
            ]
          },
          "exercises": [
            {
              "id": "es-foundations-u1-questions-e1",
              "kind": "choice",
              "prompt": "¿___ tú de Barcelona?",
              "options": [
                "Eres",
                "Es",
                "Soy",
                "Somos"
              ],
              "answers": [
                "Eres"
              ],
              "explain": "With tú, questions start with Eres."
            },
            {
              "id": "es-foundations-u1-questions-e2",
              "kind": "gap",
              "prompt": "Ella no ___ mi hermana.",
              "answers": [
                "es"
              ],
              "explain": "no + es: with ella the negative keeps es."
            },
            {
              "id": "es-foundations-u1-questions-e3",
              "kind": "order",
              "prompt": "Say you are not from Seville.",
              "answers": [
                "No soy de Sevilla"
              ],
              "explain": "No goes first: No soy de Sevilla."
            },
            {
              "id": "es-foundations-u1-questions-e4",
              "kind": "written",
              "prompt": "Make it negative: \"Soy de Valencia.\"",
              "answers": [
                "No soy de Valencia"
              ],
              "explain": "no + soy: No soy de Valencia."
            }
          ],
          "skills": [
            "grammar:verb-be",
            "grammar:present-questions",
            "function:ask-simple-questions",
            "speaking:short-answer"
          ],
          "prerequisites": [
            "grammar:subject-pronouns"
          ]
        },
        {
          "id": "es-foundations-u1-introduce",
          "title": "Introducing yourself",
          "goal": "Give a complete self-introduction: name, country, nationality and job.",
          "intro": {
            "explanation": [
              "A full Spanish introduction has four pieces: your name, your city or country, your nationality and your job.",
              "For the name: “Me llamo Ana” (I call myself Ana) or simply “Soy Ana”. For origin: “Soy de España”. Nationalities are lower-case: “soy española”.",
              "Jobs with ser drop the article: “Soy profesora”, not “Soy una profesora”. Add “Mucho gusto” at the end to close politely."
            ],
            "examples": [
              {
                "text": "Me llamo Ana. Mucho gusto.",
                "meaning": "Your name plus a polite close."
              },
              {
                "text": "Soy de Sevilla, del sur de España.",
                "meaning": "City inside country."
              },
              {
                "text": "Soy española, de Andalucía.",
                "meaning": "Nationality plus region."
              },
              {
                "text": "Soy enfermera en un hospital.",
                "meaning": "Job plus workplace."
              },
              {
                "text": "Tengo veinticinco años.",
                "meaning": "Your age — with tener, not ser."
              },
              {
                "text": "Encantada. ¿Y tú?",
                "meaning": "Close and bounce the question back."
              }
            ]
          },
          "expressions": [
            {
              "text": "Me llamo …",
              "meaning": "Give your name.",
              "note": "Literally “I call myself”. Also: Mi nombre es …"
            },
            {
              "text": "Soy + nationality",
              "meaning": "Say your nationality.",
              "note": "española, francesa, alemana — nationality is lower-case in Spanish."
            },
            {
              "text": "Soy de …",
              "meaning": "Say your city or country.",
              "note": "Soy de Sevilla; Soy de España."
            },
            {
              "text": "Trabajo en …",
              "meaning": "Say where you work.",
              "note": "Trabajo en un hospital / en una escuela."
            },
            {
              "text": "Mucho gusto.",
              "meaning": "Polite close when you meet someone.",
              "note": "Answer: Igualmente."
            },
            {
              "text": "¿Y tú?",
              "meaning": "Bounce the question back.",
              "note": "—Soy de Madrid. ¿Y tú?"
            }
          ],
          "situation": "Your first day at a language school in Madrid. Present yourself completely to the class: name, city, nationality and job.",
          "practice": {
            "questions": [
              {
                "prompt": "¿Cómo te llamas?",
                "expected": [
                  "Me llamo <name>.",
                  "Soy <name>."
                ],
                "focus": "name formulas",
                "watch": "Both are fine; recast the shorter one as Me llamo for variety."
              },
              {
                "prompt": "¿De dónde eres?",
                "expected": [
                  "Soy de <country>."
                ],
                "focus": "origin",
                "watch": "Never drop de: Soy DE <country>."
              },
              {
                "prompt": "¿Cuál es tu nacionalidad?",
                "expected": [
                  "Soy <nationality>."
                ],
                "focus": "nationality with ser",
                "watch": "Lower-case: soy española, not Española."
              },
              {
                "prompt": "¿A qué te dedicas?",
                "expected": [
                  "Soy <job>.",
                  "Trabajo en <place>."
                ],
                "focus": "jobs without article",
                "watch": "“Soy una profesora” — recast dropping the article."
              },
              {
                "prompt": "¿Y dónde vives?",
                "expected": [
                  "Vivo en <city>."
                ],
                "focus": "vivo en",
                "watch": "“Vivo a Madrid” — recast with en."
              },
              {
                "prompt": "¡Encantado! ¿Y tú, de qué trabajas?",
                "expected": [
                  "Soy <job>.",
                  "Trabajo de <job>."
                ],
                "focus": "bounce back and answer",
                "watch": "Accept Soy de <job>? No — recast: Trabajo DE/Soy <job>."
              }
            ]
          },
          "exercises": [
            {
              "id": "es-foundations-u1-introduce-e1",
              "kind": "choice",
              "prompt": "___ Ana. Mucho gusto.",
              "options": [
                "Me llamo",
                "Me llamo de",
                "Llamo",
                "Estoy"
              ],
              "answers": [
                "Me llamo"
              ],
              "explain": "Me llamo + name: one piece, no de."
            },
            {
              "id": "es-foundations-u1-introduce-e2",
              "kind": "gap",
              "prompt": "Soy ___ Italia. (nationality)",
              "answers": [
                "italiana"
              ],
              "explain": "Nationality is lower-case: italiana, italiano."
            },
            {
              "id": "es-foundations-u1-introduce-e3",
              "kind": "order",
              "prompt": "Say your name and city.",
              "answers": [
                "Soy Ana y soy de Madrid"
              ],
              "explain": "Two soy pieces, both with their verb."
            },
            {
              "id": "es-foundations-u1-introduce-e4",
              "kind": "written",
              "prompt": "Give your complete introduction: name and country.",
              "answers": [
                "Me llamo <name> y soy de <country>",
                "Soy <name> y soy de <country>",
                "Me llamo <name>, soy de <country>"
              ],
              "explain": "Name + origin, each with its verb."
            }
          ],
          "skills": [
            "grammar:verb-be",
            "function:introduce-yourself",
            "vocab:introductions",
            "pron:word-stress"
          ],
          "canDo": [
            "introduce-yourself"
          ]
        }
      ]
    },
