        {
          "id": "es-foundations-u2-barrio",
          "title": "Mi barrio",
          "goal": "Decir qué hay en tu barrio con hay y dónde está.",
          "intro": {
            "explanation": [
              "Hay sirve para todo lo que existe: «Hay una plaza, dos bares y una frutería». No cambia con plural.",
              "Para preguntar: «¿Hay una farmacia por aquí?». Para negar: «No hay cine, lo siento».",
              "Ubica con cerca de / al lado de / enfrente de: «La frutería está enfrente del parque»."
            ],
            "examples": [
              {
                "text": "Hay una plaza y dos bares.",
                "meaning": "hay no cambia con plural."
              },
              {
                "text": "¿Hay una farmacia por aquí?",
                "meaning": "La pregunta útil."
              },
              {
                "text": "No hay cine en mi barrio.",
                "meaning": "La negación."
              },
              {
                "text": "La frutería está enfrente del parque.",
                "meaning": "Ubicación exacta."
              },
              {
                "text": "Todo está cerca de mi casa.",
                "meaning": "El resumen cómodo."
              }
            ]
          },
          "expressions": [
            {
              "text": "Hay + lugar",
              "meaning": "Decir qué existe.",
              "note": "Hay una panadería."
            },
            {
              "text": "¿Hay … por aquí?",
              "meaning": "Preguntar.",
              "note": "…una farmacia?"
            },
            {
              "text": "No hay …",
              "meaning": "Lo que falta.",
              "note": "No hay metro, lo siento."
            },
            {
              "text": "está enfrente de / al lado de",
              "meaning": "Ubicación.",
              "note": "enfrente del parque."
            },
            {
              "text": "cerca de mi casa",
              "meaning": "La distancia.",
              "note": "todo está cerca."
            }
          ],
          "situation": "Un visitante pregunta qué hay en tu barrio: nombra cuatro sitios, di lo que falta y ubica tu favorito.",
          "practice": {
            "questions": [
              {
                "prompt": "Di dos sitios que hay en tu barrio.",
                "expected": [
                  "Hay <lugar> y <lugar>."
                ],
                "focus": "hay",
                "watch": "Hay no cambia: hay uno, hay dos."
              },
              {
                "prompt": "Di lo que no hay. (cine)",
                "expected": [
                  "No hay cine en mi barrio."
                ],
                "focus": "no hay",
                "watch": "No hay + lugar sin artículo."
              },
              {
                "prompt": "Pregunta si hay farmacia cerca.",
                "expected": [
                  "¿Hay una farmacia por aquí?"
                ],
                "focus": "por aquí",
                "watch": "por aquí = cerca, en esta zona."
              },
              {
                "prompt": "Ubica tu sitio favorito.",
                "expected": [
                  "<Lugar> está enfrente de <lugar>."
                ],
                "focus": "enfrente de",
                "watch": "enfrente DE + lugar."
              },
              {
                "prompt": "Di que todo está cerca de tu casa.",
                "expected": [
                  "Todo está cerca de mi casa."
                ],
                "focus": "cerca de",
                "watch": "cerca DE mi casa."
              }
            ]
          },
          "exercises": [
            {
              "id": "es-foundations-u2-barrio-e1",
              "kind": "choice",
              "prompt": "___ dos bares y una panadería.",
              "explain": "Hay para decir qué existe.",
              "options": [
                "Hay",
                "Están",
                "Es",
                "Son"
              ],
              "answers": [
                "Hay"
              ]
            },
            {
              "id": "es-foundations-u2-barrio-e2",
              "kind": "gap",
              "prompt": "No ___ metro en mi barrio. (existe)",
              "explain": "No hay + lugar.",
              "answers": [
                "hay"
              ]
            },
            {
              "id": "es-foundations-u2-barrio-e3",
              "kind": "order",
              "prompt": "Pregunta por una farmacia.",
              "explain": "¿Hay + lugar + por aquí?",
              "answers": [
                "Hay una farmacia por aqui cerca"
              ]
            },
            {
              "id": "es-foundations-u2-barrio-e4",
              "kind": "written",
              "prompt": "Di qué hay enfrente de tu casa.",
              "explain": "Hay + lugar + enfrente de.",
              "answers": [
                "hay <lugar> enfrente de mi casa",
                "esta <lugar>"
              ]
            }
          ],
          "skills": [
            "vocab:town",
            "grammar:there-is-are",
            "grammar:prepositions-place",
            "function:ask-simple-questions"
          ],
          "canDo": [
            "describe-home"
          ],
          "prerequisites": [
            "grammar:there-is-are"
          ]
