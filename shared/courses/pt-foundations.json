                "tomo"
              ]
            },
            {
              "id": "pt-foundations-u2-rotina-e3",
              "kind": "order",
              "prompt": "Diga a hora de sair.",
              "explain": "saio de + lugar + às + hora.",
              "answers": [
                "Saio de casa as oito"
              ]
            },
            {
              "id": "pt-foundations-u2-rotina-e4",
              "kind": "written",
              "prompt": "O hábito do sábado.",
              "explain": "aos + dia + presente.",
              "answers": [
                "aos sabados acordo tarde",
                "no sabado acordo tarde"
              ]
            }
          ],
          "skills": [
            "grammar:present-simple",
            "grammar:time-expressions",
            "vocab:daily-routine",
            "function:talk-about-routines"
          ],
          "canDo": [
