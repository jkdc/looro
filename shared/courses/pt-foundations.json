          "colorIndex": 1
        }
      ],
      "lessons": [
        {
          "id": "pt-foundations-u2-rotina",
          "title": "Minha rotina",
          "goal": "Contar o seu dia no presente com as horas.",
          "intro": {
            "explanation": [
              "O presente conta as rotinas: « Acordo às sete. Tomo café com pão de queijo. Saio de casa às oito. »",
              "Os dias da semana com plural = toda semana: « aos sábados acordo tarde ».",
              "As horas com às : « às oito », « às oito e meia ». Com a: « a noite eu fico em casa »."
            ],
            "examples": [
              {
                "text": "Acordo às sete.",
                "meaning": "O primeiro verbo do dia."
              },
              {
                "text": "Tomo café com pão de queijo.",
                "meaning": "O café da manhã."
              },
              {
                "text": "Saio de casa às oito.",
                "meaning": "A saída."
              },
              {
                "text": "Aos sábados acordo tarde.",
                "meaning": "O hábito do fim de semana."
              },
              {
                "text": "Vou para a cama às onze.",
                "meaning": "A hora de dormir."
              }
            ]
          },
          "expressions": [
            {
              "text": "Acordo às …",
              "meaning": "Acorde.",
              "note": "acordar às + hora."
            },
            {
              "text": "Tomo café …",
              "meaning": "O desjejum.",
              "note": "tomar café da manhã."
            },
            {
              "text": "Saio de casa às …",
              "meaning": "A saída.",
              "note": "sair DE casa."
            },
            {
              "text": "Aos sábados …",
              "meaning": "O hábito.",
              "note": "aos + dia = todos os."
            },
            {
              "text": "Vou para a cama às …",
              "meaning": "Dormir.",
              "note": "ir para a cama."
            }
          ],
          "situation": "Você conta a sua manhã para um amigo novo: hora de acordar, café, saída — e como muda no sábado.",
          "practice": {
            "questions": [
              {
                "prompt": "Diga a que hora você acorda na semana.",
                "expected": [
                  "Acordo às <hora> na semana."
                ],
                "focus": "acordar às",
                "watch": "acordar ÀS + hora."
              },
              {
                "prompt": "Diga o que você toma no café da manhã.",
                "expected": [
                  "Tomo <comida> e <comida>."
                ],
                "focus": "tomar",
                "watch": "tomar café da manhã."
              },
              {
                "prompt": "Diga a que hora sai de casa.",
                "expected": [
                  "Saio de casa às <hora>."
                ],
                "focus": "sair de",
                "watch": "sair DE casa."
              },
              {
                "prompt": "Diga o hábito do sábado.",
                "expected": [
                  "Aos sábados acordo tarde."
                ],
                "focus": "aos + dia",
                "watch": "aos sábados = todos os sábados."
              },
              {
                "prompt": "Diga a que hora vai para a cama.",
                "expected": [
                  "Vou para a cama às <hora>."
                ],
                "focus": "ir para a cama",
                "watch": "ir PARA a cama."
              }
            ]
          },
          "exercises": [
            {
              "id": "pt-foundations-u2-rotina-e1",
              "kind": "choice",
              "prompt": "___ às sete todos os dias.",
              "explain": "Eu acordo: sem pronome solto.",
              "options": [
                "Acordo",
                "Acordo me",
                "Acorda",
                "Acordar"
              ],
              "answers": [
                "Acordo"
              ]
            },
            {
              "id": "pt-foundations-u2-rotina-e2",
              "kind": "gap",
              "prompt": "___ café com pão de queijo. (tomar café)",
              "explain": "eu tomo café.",
              "answers": [
