{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looro.invalid/contracts/daily-practice/review.schema.json",
  "title": "DailyReview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "attemptId", "packageVersionId", "language", "explanationLanguage", "inputHash", "rubricVersion", "createdAt", "outcome", "sections", "strengths", "priorities", "errors", "wordCandidates"],
  "properties": {
    "schemaVersion": { "const": 1 }, "reviewId": { "type": "string", "format": "uuid" }, "attemptId": { "type": "string", "format": "uuid" }, "packageVersionId": { "type": "string", "format": "uuid" },
    "language": { "const": "en" }, "explanationLanguage": { "enum": ["en", "es"] }, "inputHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }, "rubricVersion": { "type": "string", "minLength": 1, "maxLength": 64 }, "createdAt": { "type": "integer", "minimum": 0 }, "outcome": { "enum": ["completed", "partial"] },
    "sections": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["stage", "evidence", "correct", "total", "helped", "explanation"], "properties": { "stage": { "enum": ["listening", "speaking", "practice"] }, "evidence": { "enum": ["sufficient", "limited", "not_observed"] }, "correct": { "type": ["integer", "null"], "minimum": 0 }, "total": { "type": ["integer", "null"], "minimum": 0 }, "helped": { "type": "boolean" }, "explanation": { "type": "string", "maxLength": 500 } } } },
    "strengths": { "$ref": "#/$defs/shortTexts" }, "priorities": { "$ref": "#/$defs/shortTexts" },
    "errors": { "type": "array", "maxItems": 6, "items": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "quote", "correction", "explanation", "fragmentIds", "questionId", "confidence"], "properties": { "id": { "type": "string", "format": "uuid" }, "kind": { "enum": ["grammar", "vocabulary", "comprehension", "task"] }, "quote": { "type": "string", "maxLength": 300 }, "correction": { "type": "string", "maxLength": 300 }, "explanation": { "type": "string", "maxLength": 500 }, "fragmentIds": { "type": "array", "items": { "type": "string", "format": "uuid" } }, "questionId": { "oneOf": [{ "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" }, { "type": "null" }] }, "confidence": { "enum": ["supported", "uncertain"] } } } },
    "wordCandidates": { "type": "array", "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["candidateId", "kind", "text", "meaning", "origin", "confidence", "evidenceIds"], "properties": { "candidateId": { "type": "string", "format": "uuid" }, "kind": { "enum": ["word", "expression"] }, "text": { "type": "string", "minLength": 1, "maxLength": 120 }, "meaning": { "type": "string", "maxLength": 300 }, "origin": { "enum": ["learner_mark", "review"] }, "confidence": { "const": "supported" }, "evidenceIds": { "type": "array", "items": { "type": "string", "format": "uuid" } } } } }
  },
  "$defs": { "shortTexts": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 300 } } }
}
