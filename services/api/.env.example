# Local development only. Supply real secrets through the deployment environment.
DATABASE_URL=postgresql://app:local-development-only@localhost:5432/app
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
# Learning-progress version 2 remains unavailable until explicitly enabled.
PROGRESS_SYNC_V2_ENABLED=false
GOOGLE_CLIENT_ID=
# Android uses a web client audience plus an explicit list of Android OAuth client IDs.
GOOGLE_ANDROID_SERVER_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_IDS=
APPLE_CLIENT_ID=
# Native Apple revocation requires a read-only .p8 secret file and developer credentials.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# Keep off for public deployments. Hosted access requires an explicit test-account allowlist.
HOSTED_VOICE_EXPERIMENTAL=false
HOSTED_VOICE_ACCOUNT_ALLOWLIST=
HOSTED_VOICE_LIFETIME_CAP_NANO=0
HOSTED_VOICE_BILLING_UNIT=nanoUSD
# Helpers require milliseconds billing and an explicitly reviewed provider-cost allowance.
HOSTED_HELPERS_EXPERIMENTAL=false
HOSTED_HELPER_BUDGET_PER_MINUTE_NANO=0
HOSTED_HELPER_REQUESTS_PER_MINUTE=24
HOSTED_HELPER_SEARCHES_PER_SESSION=0
OPENAI_API_KEY=
# Legacy credit sandbox; Android minute purchases use the separate configuration below.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
# Server-side Stripe Price IDs; the client never supplies a price or credit amount.
STRIPE_TEST_PRICE_10_USD=
STRIPE_TEST_PRICE_25_USD=
# Match the exact fee-inclusive sandbox Stripe Prices you create. No default fee is invented.
STRIPE_TEST_PAYMENT_FEE_10_MINOR=
STRIPE_TEST_PAYMENT_FEE_25_MINOR=
# Minute commerce has no default product, price or credential. See docs/enable-minute-commerce.md.
APP_MINUTE_COMMERCE_ENABLED=false
APP_MINUTE_SALES_ENABLED=false
APP_MINUTE_ALLOW_LIVE=false
APP_MINUTE_COMMERCE_CONFIG_FILE=
APP_MINUTE_CATALOG_FILE=
APP_MINUTE_CATALOG_APPROVED_SHA256=
APP_MINUTE_RECEIPT_KEYS_FILE=
APP_MINUTE_STRIPE_CREDENTIALS_FILE=
APP_MINUTE_PLAY_SERVICE_ACCOUNT_FILE=
APP_MINUTE_PLAY_BINDING_KEY_FILE=
# ---- Token billing proxy (docs/token-billing.md). Provider, model and API
# key come from the admin panel LLM config (llm_provider_configs); the env
# fallback is LEVELTEST_LLM_PROVIDER / LEVELTEST_LLM_API_KEY. ----
# Output-token estimate cap for admission (default 4000).
PROXY_MAX_TOKENS=
# Per-account in-flight relay cap (default 2).
PROXY_MAX_CONCURRENT=
# ---- Admin panel (docs/admin-panel.md). All or nothing; secrets must be distinct. ----
# Login is local-only: operator accounts are created with `npm run admins-admin`.
ADMIN_HMAC_KEY=
ADMIN_PROXY_TOKEN=
# Exact panel origin; anchors session cookies and CSRF Origin checks.
ADMIN_PUBLIC_ORIGIN=
# Local development only: allows loopback origins and direct (unproxied) admin access.
ADMIN_ALLOW_LOCAL_LOOPBACK=false
